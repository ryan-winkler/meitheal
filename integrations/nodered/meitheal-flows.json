[
  {
    "id": "meitheal-tab",
    "type": "tab",
    "label": "Meitheal Automations",
    "disabled": false,
    "info": "Meitheal task event automations for Home Assistant.\n\nListens for meitheal_task_* events on the HA event bus and triggers notifications, debug output, and alerts.\n\nEvents: task created, updated, completed, deleted, overdue, and board updated.",
    "env": []
  },

  {
    "id": "meitheal-task-created",
    "type": "server-events",
    "z": "meitheal-tab",
    "name": "Task Created",
    "server": "",
    "version": 5,
    "event_type": "meitheal_task_created",
    "exposeAsEntityConfig": "",
    "waitForRunning": true,
    "outputProperties": [
      { "property": "payload", "propertyType": "msg", "value": "", "valueType": "eventData" },
      { "property": "topic", "propertyType": "msg", "value": "meitheal_task_created", "valueType": "str" }
    ],
    "x": 160,
    "y": 80,
    "wires": [["meitheal-debug-created", "meitheal-notify-created"]]
  },
  {
    "id": "meitheal-debug-created",
    "type": "debug",
    "z": "meitheal-tab",
    "name": "Debug: Created",
    "active": true,
    "tosidebar": true,
    "console": false,
    "tostatus": true,
    "complete": "payload",
    "targetType": "msg",
    "statusVal": "payload.title",
    "statusType": "auto",
    "x": 420,
    "y": 60,
    "wires": []
  },
  {
    "id": "meitheal-notify-created",
    "type": "api-call-service",
    "z": "meitheal-tab",
    "name": "Notify: New Task",
    "server": "",
    "version": 7,
    "debugenabled": false,
    "domain": "persistent_notification",
    "service": "create",
    "areaId": [],
    "deviceId": [],
    "entityId": [],
    "data": "{\"title\": \"📋 New Meitheal Task\", \"message\": \"{{payload.title}}\\n\\nPriority: {{payload.priority}}\\nArea: {{payload.area_id}}\\nTicket: {{payload.ticket_key}}\"}",
    "dataType": "json",
    "mergeContext": "",
    "mustacheAltTags": false,
    "outputProperties": [],
    "queue": "none",
    "x": 420,
    "y": 100,
    "wires": [[]]
  },

