{
  "name": "@meitheal/web",
  "private": true,
  "version": "0.0.1",
  "description": "Astro SSR runtime for Meitheal, a Home Assistant-native household and homelab execution hub.",
  "homepage": "https://github.com/Coolock-Village/meitheal",
  "repository": {
    "type": "git",
    "url": "https://github.com/Coolock-Village/meitheal.git"
  },
  "bugs": {
    "url": "https://github.com/Coolock-Village/meitheal/issues"
  },
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "dev:clean": "rm -rf node_modules/.vite .astro && astro dev",
    "generate:openapi": "node ./scripts/generate-openapi.mjs",
    "generate:llms": "node ./scripts/generate-llms.mjs",
    "generate:asyncapi": "node ./scripts/generate-asyncapi.mjs",
    "prebuild": "npm run generate:openapi && npm run generate:llms && npm run generate:asyncapi",
    "build": "npm run prebuild && astro build",
    "preview": "astro preview",
    "check": "astro build",
    "db:migrate": "node ./scripts/migrate.mjs",
    "db:migrate:check": "node ./scripts/migrate.mjs --check",
    "schema:drift": "node ./scripts/schema-drift-check.mjs",
    "perf:budget": "node ./scripts/perf-budget-check.mjs"
  },
  "dependencies": {
    "@astrojs/mdx": "^5.0.4",
    "@astrojs/node": "^10.0.6",
    "@astrojs/sitemap": "^3.7.2",
    "@fontsource-variable/geist": "^5.2.8",
    "@fontsource-variable/inter": "^5.2.8",
    "@fontsource/jetbrains-mono": "^5.2.8",
    "@fontsource/outfit": "^5.2.8",
    "@libsql/client": "^0.17.0",
    "@meitheal/domain-auth": "workspace:*",
    "@meitheal/domain-observability": "workspace:*",
    "@meitheal/domain-strategy": "workspace:*",
    "@meitheal/domain-tasks": "workspace:*",
    "@meitheal/integration-core": "workspace:*",
    "astro": "^6.1.10",
    "date-fns": "^4.1.0",
    "date-fns-tz": "^3.2.0",
    "drizzle-orm": "^0.45.2",
    "home-assistant-js-websocket": "^9.6.0",
    "marked": "^17.0.4",
    "sanitize-html": "^2.17.3",
    "undici": "^7.24.3",
    "ws": "^8.20.0",
    "yaml": "^2.8.3",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.9",
    "@tailwindcss/vite": "^4.2.4",
    "@types/node": "^25.5.0",
    "@types/sanitize-html": "^2.16.1",
    "@types/ws": "^8.18.1",
    "drizzle-kit": "^0.31.9",
    "tailwindcss": "^4.2.4",
    "typescript": "^5.9.3",
    "zod-openapi": "^5.4.6"
  }
}
