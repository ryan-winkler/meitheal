{
  "name": "@meitheal/web",
  "private": true,
  "version": "0.0.1",
  "description": "Astro SSR runtime for Meitheal, a Home Assistant-native household and homelab execution hub.",
  "homepage": "https://github.com/ryan-winkler/meitheal",
  "repository": {
    "type": "git",
    "url": "https://github.com/ryan-winkler/meitheal.git"
  },
  "bugs": {
    "url": "https://github.com/ryan-winkler/meitheal/issues"
  },
  "type": "module",
  "scripts": {
    "predev": "npm run generate:openapi",
    "dev": "astro dev",
    "dev:clean": "rm -rf node_modules/.vite .astro && astro dev",
    "generate:openapi": "node ./scripts/generate-openapi.mjs",
    "generate:asyncapi": "node ./scripts/generate-asyncapi.mjs",
    "prebuild": "npm run generate:openapi && npm run generate:asyncapi",
    "build": "npm run prebuild && astro build",
    "preview": "astro preview",
    "check": "astro build",
    "db:migrate": "node ./scripts/migrate.mjs",
    "db:migrate:check": "node ./scripts/migrate.mjs --check",
    "schema:drift": "node ./scripts/schema-drift-check.mjs",
    "perf:budget": "node ./scripts/perf-budget-check.mjs"
  },
  "dependencies": {
    "@libsql/client": "^0.18.0",
    "@meitheal/domain-auth": "workspace:*",
    "@meitheal/domain-observability": "workspace:*",
    "@meitheal/domain-strategy": "workspace:*",
    "@meitheal/domain-tasks": "workspace:*",
    "@meitheal/integration-core": "workspace:*",
    "date-fns": "^4.4.0",
    "date-fns-tz": "^3.2.0",
    "dompurify": "^3.4.17",
    "drizzle-orm": "^0.45.4",
    "home-assistant-js-websocket": "^9.8.1",
    "marked": "^18.1.3",
    "sanitize-html": "^2.18.1",
    "sharp": "0.35.5",
    "undici": "^8.12.4",
    "ws": "^8.22.2",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@astrojs/node": "^11.1.11",
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@fontsource/outfit": "^5.3.0",
    "@tailwindcss/vite": "^4.3.5",
    "@types/node": "^26.6.6",
    "@types/sanitize-html": "^2.16.2",
    "@types/ws": "^8.18.2",
    "astro": "^7.4.8",
    "drizzle-kit": "^0.31.11",
    "tailwindcss": "^4.3.5",
    "typescript": "^6.0.3"
  }
}
