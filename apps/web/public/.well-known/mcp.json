{
  "name": "meitheal",
  "version": "0.3.0",
  "description": "Meitheal — Cooperative task and life management engine for Home Assistant",
  "protocol": "mcp",
  "protocolVersion": "2025-03-26",
  "endpoint": "/api/mcp",
  "capabilities": {
    "tools": {
      "listChanged": false
    }
  },
  "toolCount": 30,
  "toolCategories": [
    "tasks", "hierarchy", "habits", "calendar", "scoring", "export", "labels", "review", "briefing", "home-assistant"
  ],
  "authentication": {
    "type": "none",
    "note": "Authentication handled by Home Assistant Supervisor ingress"
  },
  "agent_protocols": {
    "a2a": {
      "agent_card": "/.well-known/agent.json"
    }
  }
}