    <script is:inline>
      (function() {
        window.__meithealUpdateMobileTabBar = function() {
          var bar = document.getElementById("mobile-tab-bar");
          if (!bar) return;
          var path = window.location.pathname;
          // Strip ingress prefix if present
          var ip = window.__ingress_path || "";
          if (ip && path.startsWith(ip)) path = path.slice(ip.length);
          // Match page name from path
          var page = path.replace(/^\//, "").split("/")[0] || "dashboard";
          if (page === "" || page === "index") page = "dashboard";
          if (page === "kanban" || page === "table" || page === "timeline" || page === "tickets") page = "tasks";
          var board = /^\/boards\/([^/]+)\/?$/.exec(path);
          var params = new URLSearchParams(window.location.search);
          var taskLink = bar.querySelector('[data-page="tasks"]');
          var calendarLink = bar.querySelector('[data-page="calendar"]');
          if (board && taskLink) {
            var target = new URL(ip + "/boards/" + board[1], window.location.origin);
            ["area", "project", "from"].forEach(function(key) { if (params.has(key)) target.searchParams.set(key, params.get(key)); });
            target.hash = "kanban";
            taskLink.href = target.href;
            if (calendarLink) {
              calendarLink.hidden = false;
              if (!calendarLink.hidden) {
                var calendarTarget = new URL(target.href);
                calendarTarget.searchParams.set("view", "calendar"); calendarTarget.hash = "calendar";
                calendarLink.href = calendarTarget.href;
              }
            }
            if (params.get("view") !== "groups") page = "tasks";
          }
          if (page === "tasks" && document.querySelector('[data-task-view="calendar"]')) page = "calendar";
          var items = bar.querySelectorAll(".mobile-tab-bar__item");
          for (var i = 0; i < items.length; i++) {
            var isActive = items[i].getAttribute("data-page") === page;
            items[i].classList.toggle("active", isActive);
            if (isActive) {
              items[i].setAttribute("aria-current", "page");
            } else {
              items[i].removeAttribute("aria-current");
            }
          }
        };
        if (!window.__meithealMobileTabBarBound) {
          window.__meithealMobileTabBarBound = true;
          window.addEventListener("hashchange", function() {
            window.__meithealUpdateMobileTabBar && window.__meithealUpdateMobileTabBar();
          });
          document.addEventListener("astro:page-load", function() {
            window.__meithealUpdateMobileTabBar && window.__meithealUpdateMobileTabBar();
          });
        }
