---
import "../styles/global.css";
import Confetti from "../components/gamification/Confetti.astro";
import PomodoroTimer from "../components/pomodoro/PomodoroTimer.astro";
import { getFeatureFlags } from "../lib/feature-flags";
import { ClientRouter } from "astro:transitions";
import { t } from "../i18n/translations";
import type { Locale } from "../lib/locale";
import Sidebar from "../components/layout/Sidebar.astro";
import SearchHub from "../components/layout/SearchHub.astro";
import TopNavigation from "../components/layout/TopNavigation.astro";
import StrategicEvaluator from "../components/tasks/StrategicEvaluator.astro";
import NewTaskModal from "../components/tasks/NewTaskModal.astro";
import AskAssistModal from "../components/ha/AskAssistModal.astro";
import PwaInstallBanner from "../components/pwa/PwaInstallBanner.astro";

import geistWoff2 from '@fontsource-variable/geist/files/geist-latin-wght-normal.woff2?url';
import outfit600Woff2 from '@fontsource/outfit/files/outfit-latin-600-normal.woff2?url';
import outfit700Woff2 from '@fontsource/outfit/files/outfit-latin-700-normal.woff2?url';

import dtEn from "../i18n/en.json";
import dtGa from "../i18n/ga.json";

// i18n: resolve locale from cookie for SSR
const cookieLocale = Astro.cookies.get("meitheal-locale")?.value;
const locale: Locale = cookieLocale === "ga" ? "ga" : "en";

// Feature flags — read from settings DB (SSR)
const featureFlags = await getFeatureFlags();
const featureFlagsJson = JSON.stringify(featureFlags);

const {
  timezone = "Europe/Dublin",
  weekStart = "monday",
  dateFormat = "relative",
  ingressPath,
  behindIngress = false,
} = Astro.locals;

export interface Props {
  title?: string;
  description?: string;
}

const {
  title = "Meitheal",
  description = "The cooperative task and life engine for your home.",
} = Astro.props;

// OA-607: Sidebar task count badges (SSR)
let taskCounts = { total: 0, active: 0, pending: 0 };
try {
  const { ensureSchema, getPersistenceClient } =
    await import("@domains/tasks/persistence/store");
  await ensureSchema();
  const client = getPersistenceClient();
  const result = await client.execute(
    "SELECT status, COUNT(*) as cnt FROM tasks GROUP BY status",
  );
  for (const row of result.rows) {
    const r = row as Record<string, unknown>;
    const s = String(r.status);
    const c = Number(r.cnt);
    taskCounts.total += c;
    if (s === "active") taskCounts.active += c;
    if (s === "pending" || s === "backlog") taskCounts.pending += c;
  }
} catch {
  /* DB not available */
}

// Security headers are set by middleware.ts — no duplicates here.
// IMPORTANT: Do NOT set Strict-Transport-Security or upgrade-insecure-requests
// in HA ingress environments — the addon serves HTTP internally.
Astro.response.headers.set("X-Content-Type-Options", "nosniff");
---

<!doctype html>
<html lang={locale} dir="ltr">
  <head>
    <!-- Scroll-lock guard: prevent external tools from locking body scroll (P0) -->
    <script is:inline>
      (function () {
        // Meitheal modals that legitimately lock scroll set data-scroll-lock="true"
        function isRealModalOpen() {
          var overlay = document.getElementById("task-detail-overlay");
          if (overlay && !overlay.classList.contains("hidden")) return true;
          var ntModal = document.getElementById("new-task-modal");
          if (ntModal && ntModal.classList.contains("active")) return true;
          var confirmOverlay = document.getElementById("confirm-dialog-overlay");
          if (confirmOverlay && !confirmOverlay.classList.contains("hidden")) return true;
          // Mobile sidebar open is legitimate
          if (document.body.classList.contains("sidebar-open") && window.innerWidth <= 768) return true;
          return false;
        }
        // MutationObserver: undo external overflow:hidden on body when no modal is open
        var observer = new MutationObserver(function (mutations) {
          for (var i = 0; i < mutations.length; i++) {
            var m = mutations[i];
            if (m.attributeName === "style" || m.attributeName === "class") {
              var body = document.body;
              var hasHidden = body.style.overflow === "hidden" || body.classList.contains("antigravity-scroll-lock");
              if (hasHidden && !isRealModalOpen()) {
                body.style.overflow = "";
                body.classList.remove("antigravity-scroll-lock");
                // P0-2: Reset position/touch-action if leaked from sidebar-open
                if (body.style.position === "fixed") body.style.position = "";
                if (body.style.touchAction === "none") body.style.touchAction = "";
              }
            }
          }
        });
        // Start observing once body exists
        if (document.body) {
          observer.observe(document.body, { attributes: true, attributeFilter: ["style", "class"] });
        } else {
          document.addEventListener("DOMContentLoaded", function () {
            observer.observe(document.body, { attributes: true, attributeFilter: ["style", "class"] });
          });
        }
      })();
    </script>
    <!-- Ingress-aware fetch: prefix /api/ paths with HA ingress path -->
    <script is:inline>
      (function () {
        var ip = window.__ingress_path;
        var _f = window.fetch;
        window.fetch = function (input, init) {
          // Ensure ingress session cookie is always sent
          if (!init) init = {};
          if (ip) {
            if (!init.credentials) init.credentials = "include";
            if (typeof input === "string" && input.startsWith("/")) {
              // Guard: don't prefix if URL already contains the ingress path
              if (!input.startsWith(ip + "/") && input !== ip) {
                input = ip + input;
              }
            } else if (input instanceof Request && input.url) {
              var u = new URL(input.url);
              if (u.pathname.startsWith("/") && u.origin === location.origin) {
                // Guard: don't prefix if path already contains the ingress path
                if (!u.pathname.startsWith(ip + "/") && u.pathname !== ip) {
                  input = new Request(ip + u.pathname + u.search, input);
                }
              }
            }
          }
          return _f.call(this, input, init).then(function (response) {
            // Stale ingress token: HA Supervisor returns 403 when the
            // addon restarted and got a new ingress token. Auto-reload
            // to fetch the new token from the server-rendered HTML.
            if (response.status === 403 && ip) {
              var reloadKey = "meitheal-ingress-reload";
              var lastReload = sessionStorage.getItem(reloadKey);
              var now = Date.now();
              // Guard: don't reload more than once per 10 seconds
              if (!lastReload || now - Number(lastReload) > 10000) {
                sessionStorage.setItem(reloadKey, String(now));
                var tc = document.querySelector(".toast-container");
                if (tc) {
                  var t = document.createElement("div");
                  t.className = "toast warning";
                  t.textContent = "🔄 Session expired. Reloading...";
                  t.setAttribute("role", "alert");
                  tc.appendChild(t);
                }
                setTimeout(function () {
                  window.location.reload();
                }, 800);
              }
            }
            // Conflict detection (Persona #14): show toast on 409
            if (response.status === 409) {
              var tc = document.querySelector(".toast-container");
              if (tc) {
                var toast = document.createElement("div");
                toast.className = "toast warning";
                toast.textContent =
                  "⚠ Task was modified by another session. Refresh to see latest.";
                toast.setAttribute("role", "alert");
                tc.appendChild(toast);
                setTimeout(function () {
                  toast.remove();
                }, 6000);
              }
              // Announce for screen readers via aria-live
              var live = document.getElementById("sync-announcer");
              if (live)
                live.textContent =
                  "Conflict detected: task was modified elsewhere.";
            }
            return response;
          });
        };
      })();
    </script>

    <!-- Ingress state persistence: restore last route after iframe recreation -->
    <!-- Runs pre-paint so the user never sees a flash of the wrong page -->
    <script is:inline>
      (function () {
        if (!window.__ingress_path) return;
        if (window.location.pathname !== "/") return;
        try {
          var raw = sessionStorage.getItem("meitheal-navigation-state");
          if (!raw) return;
          var state = JSON.parse(raw);
          if (
            typeof state.path !== "string" ||
            typeof state.timestamp !== "number"
          )
            return;
          // Only restore if saved within the last 60 seconds
          if (Date.now() - state.timestamp > 60000) {
            sessionStorage.removeItem("meitheal-navigation-state");
            return;
          }
          // Don't redirect to root (no-op)
          if (state.path === "/") return;
          // Redirect to saved path — prepend ingress path for proper routing
          var target = window.__ingress_path + state.path;
          // Save scroll position to restore after redirect
          if (state.scrollY) {
            sessionStorage.setItem(
              "meitheal-restore-scroll",
              String(state.scrollY),
            );
          }
          window.location.replace(target);
        } catch (e) {
          // sessionStorage unavailable or parse error — silently continue
        }
      })();
    </script>

    <!-- Theme init — runs before paint to prevent flash -->
    <script is:inline>
      (function () {
        var t = localStorage.getItem("meitheal-theme") || "dark";
        // Always set data-theme explicitly for all states (including dark)
        // Previous code relied on :root fallthrough for dark, which caused
        // theme inconsistency when components used [data-theme="dark"] selector
        if (t === "custom") {
          document.documentElement.setAttribute("data-theme", "dark");
          var css = localStorage.getItem("meitheal-custom-theme-css");
          if (css) {
            var s = document.createElement("style");
            s.id = "meitheal-custom-theme";
            s.textContent = css;
            document.head.appendChild(s);
          }
        } else {
          document.documentElement.setAttribute("data-theme", t);
        }
      })();
    </script>

    <!-- HA theme passthrough: bridge parent frame CSS vars into Meitheal -->
    <script is:inline>
      (function () {
        if (!window.__ingress_path) return;
        try {
          var parent = window.parent;
          if (!parent || parent === window) return;
          var parentStyles = getComputedStyle(parent.document.documentElement);
          // Map HA theme vars → Meitheal vars
          var mapping = {
            "--primary-color": "--accent",
            "--accent-color": "--accent",
            "--primary-text-color": "--text-primary",
            "--primary-background-color": "--bg-primary",
            "--secondary-background-color": "--bg-secondary",
            "--divider-color": "--border",
          };
          var root = document.documentElement.style;
          var applied = 0;
          for (var haVar in mapping) {
            var val = parentStyles.getPropertyValue(haVar).trim();
            if (val) {
              root.setProperty(mapping[haVar], val);
              applied++;
            }
          }
          if (applied > 0) {
            document.documentElement.setAttribute("data-ha-theme", "inherited");
          }
        } catch (e) {
          // Cross-origin restriction — can't read parent frame vars
        }
      })();
    </script>

    <!-- User accent color: restore from localStorage before paint -->
    <script is:inline>
      (function () {
        var accent = localStorage.getItem("meitheal-accent-color");
        if (!accent) return;
        var root = document.documentElement.style;
        root.setProperty("--accent", accent);
        // P3-3: Set fallback values first (for WebViews without color-mix support)
        root.setProperty("--accent-hover", accent);
        root.setProperty("--accent-light", accent);
        // Compute hover (darken 10%) — overrides fallback on supporting browsers
        try {
          root.setProperty(
            "--accent-hover",
            "color-mix(in srgb, " + accent + " 85%, #000)",
          );
          root.setProperty(
            "--accent-light",
            "color-mix(in srgb, " + accent + " 12%, transparent)",
          );
        } catch (e) {
          // Older WebViews — fallback values already set above
        }
        root.setProperty("--border-focus", accent);
      })();
    </script>

    <!-- Page transition loading indicator (CSS-only) -->
    <style is:inline>
      @keyframes meitheal-loading-slide {
        0% {
          transform: translateX(-100%);
        }
        50% {
          transform: translateX(0%);
        }
        100% {
          transform: translateX(100%);
        }
      }
      .meitheal-loading-bar {
        position: fixed;
        top: 0;
        left: 0;
        width: 100%;
        height: 3px;
        z-index: 9999;
        background: var(--accent, #6366f1);
        transform: translateX(-100%);
        animation: meitheal-loading-slide 1.2s ease-in-out infinite;
        pointer-events: none;
        opacity: 0;
        transition: opacity 0.2s;
      }
      html.is-loading .meitheal-loading-bar {
        opacity: 1;
      }
      @media (prefers-reduced-motion: reduce) {
        .meitheal-loading-bar {
          animation: none;
          transform: translateX(0);
          width: 100%;
        }
      }
    </style>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={Astro.url.href} />
    <link
      rel="manifest"
      href="/manifest.webmanifest"
      crossorigin="use-credentials"
    />
    <link rel="apple-touch-icon" href="/icon-192.png" />
    <meta name="theme-color" content="#0f172a" />
    <meta name="mobile-web-app-capable" content="yes" />
    <meta
      name="apple-mobile-web-app-status-bar-style"
      content="black-translucent"
    />
    
    <!-- Resource Hints: Preload critical fonts to prevent layout shift -->
    <link rel="preload" href={geistWoff2} as="font" type="font/woff2" crossorigin="anonymous" />
    <link rel="preload" href={outfit600Woff2} as="font" type="font/woff2" crossorigin="anonymous" />
    <link rel="preload" href={outfit700Woff2} as="font" type="font/woff2" crossorigin="anonymous" />
    
    <!-- Inter font self-hosted via @fontsource-variable/inter (imported in global.css) -->
    {!behindIngress && <ClientRouter fallback="swap" />}
    <!-- Inject localization and settings maps into the window for client-scripts like toast.ts -->
    <script
      is:inline
      define:vars={{ locale, dtEn, dtGa, timezone, weekStart, dateFormat }}
    >
      window.mSettings = { timezone, weekStart, dateFormat };
      window.mI18n = {
        locale,
        get: function (key) {
          const dict = locale === "ga" ? dtGa : dtEn;
          const parts = key.split(".");
          let val = dict;
          for (const p of parts) {
            if (!val || typeof val !== "object") return key;
            val = val[p];
          }
          return typeof val === "string" ? val : key;
        },
      };
    </script>
  </head>
  <body>
    <!-- Page transition loading indicator -->
    <div class="meitheal-loading-bar" aria-hidden="true" data-no-scroll-lock="true"></div>

    <!-- Wire Astro view transitions to loading bar -->
    <script is:inline>
      function showLoading() { document.documentElement.classList.add("is-loading"); }
      function hideLoading() { document.documentElement.classList.remove("is-loading"); }

      document.addEventListener("astro:before-preparation", showLoading);
      document.addEventListener("astro:after-swap", hideLoading);
      document.addEventListener("astro:page-load", hideLoading);

      // Fallback: show loading bar for standard browser navigation (like in HA ingress without ViewTransitions)
      window.addEventListener("beforeunload", showLoading);

      // Clear loading state if page is restored from bfcache
      window.addEventListener("pageshow", function(e) {
        if (e.persisted) hideLoading();
      });
    </script>

    <!-- Sidebar collapse: restore state immediately to avoid FOUC -->
    <script is:inline>
      (function () {
        // HA ingress detection
        if (window.__ingress_path && document.body) {
          document.body.classList.add("ha-ingress");
        }
        // Restore sidebar collapsed state from localStorage
        if (localStorage.getItem("meitheal_sidebar_collapsed") === "true") {
          document.body.classList.add("sidebar-collapsed");
        }
      })();
    </script>
    <!-- Ingress URL sync: DISABLED — removed to prevent potential HA panel routing interference -->

    <a href="#main-content" class="skip-to-content"
      >{t("nav.skip_to_content", locale)}</a
    >
    <div transition:persist="sidebar">
      <Sidebar locale={locale} taskCounts={taskCounts} />
    </div>

    <!-- Sidebar toggle pill (appears on hover, always visible when collapsed) -->
    <button
      type="button"
      class="sidebar-toggle"
      id="sidebar-toggle-btn"
      aria-label="Toggle sidebar (Ctrl+B)"
      title="Toggle sidebar (Ctrl+B)"
    >
      <svg
        width="10"
        height="14"
        viewBox="0 0 10 14"
        fill="none"
        aria-hidden="true"
      >
        <path
          d="M8 1L2 7L8 13"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"></path>
      </svg>
    </button>

    <div class="main-content">
      <TopNavigation locale={locale}>
        <Fragment slot="page-title"><slot name="page-title" /></Fragment>
        <Fragment slot="actions"><slot name="actions" /></Fragment>
      </TopNavigation>
      <main
        class="content"
        role="main"
        id="main-content"
        style="padding: 0 24px 24px;"
      >
        <slot />
      </main>
    </div>

    <!-- Sidebar toggle logic: click + keyboard shortcut -->
    <script is:inline>
      (function () {
        var btn = document.getElementById("sidebar-toggle-btn");
        function toggleSidebar() {
          var collapsed = document.body.classList.toggle("sidebar-collapsed");
          localStorage.setItem("meitheal_sidebar_collapsed", String(collapsed));
          // Rotate chevron: points left when expanded (to collapse), right when collapsed (to expand)
          if (btn) {
            btn.querySelector("svg").style.transform = collapsed
              ? "rotate(180deg)"
              : "";
          }
        }
        // Initialise chevron rotation on load
        if (btn && document.body.classList.contains("sidebar-collapsed")) {
          btn.querySelector("svg").style.transform = "rotate(180deg)";
        }
        // Click handler
        if (btn) btn.addEventListener("click", toggleSidebar);
        // Keyboard shortcut: Ctrl+B / Cmd+B
        document.addEventListener("keydown", function (e) {
          if ((e.ctrlKey || e.metaKey) && e.key === "b") {
            // Don't hijack Ctrl+B (bold) when user is editing text
            var tag = (e.target || {}).tagName || "";
            var editable = (e.target || {}).contentEditable === "true";
            if (["INPUT", "TEXTAREA", "SELECT"].indexOf(tag) !== -1 || editable) return;
            e.preventDefault();
            toggleSidebar();
          }
        });
      })();
    </script>

    <!-- Task Detail Centered Panel -->
    <div
      id="task-detail-overlay"
      class="modal-overlay z-[200]"
      role="dialog"
      aria-modal="true"
      aria-label="Task detail"
    >
      <div
        id="task-detail-panel"
        class="modal-content w-full max-w-[1000px] h-[90vh] max-h-[900px] bg-bg-primary border border-border shadow-2xl rounded-xl flex flex-col overflow-hidden animate-slide-in relative m-4 md:m-8"
      >
        <!-- Sticky Header Bar -->
        <header class="flex-none px-6 py-4 border-b border-border bg-bg-card flex justify-between items-center z-20 sticky top-0">
          <div class="flex items-center gap-3 w-full mr-4">
            <span id="td-priority-dot" class="td-priority-dot text-lg" title="Priority">●</span>
            <div class="flex flex-col flex-1 min-w-0">
              <a href="#" id="td-parent" class="text-xs text-text-muted hidden hover:text-accent hover:underline mb-0.5 truncate"></a>
              <div class="flex items-center gap-2 text-text-muted">
                <span id="td-type-icon" class="flex items-center justify-center shrink-0" style="width:16px;height:16px"></span>
                <span id="td-id" class="text-xs font-mono bg-accent/10 text-accent border border-accent/20 px-2 py-0.5 rounded cursor-help"></span>
                <span id="td-created" class="text-[10px] hidden md:inline"></span>
                <span class="text-border hidden md:inline">•</span>
                <span id="td-updated" class="text-[10px] hidden md:inline"></span>
              </div>
            </div>
          </div>
          <div class="flex gap-2 items-center flex-none">
            <button id="td-toggle-favorite" class="p-1.5 hover:bg-bg-hover hover:text-text-primary text-text-muted rounded transition-colors" title="Favorite">⭐</button>
            <button id="td-duplicate" class="p-1.5 hover:bg-bg-hover hover:text-text-primary text-text-muted rounded transition-colors" title="Duplicate">📋</button>
            <button id="td-ask-ai" class="p-1.5 hover:bg-bg-hover hover:text-primary text-text-muted rounded transition-colors" title="Ask AI">🤖</button>
            <button id="td-delete" class="p-1.5 hover:bg-bg-hover hover:text-red-400 text-text-muted rounded transition-colors" title="Delete Task">🗑️</button>
            <div class="w-px h-5 bg-border mx-1"></div>
            <button id="td-close" class="p-1.5 hover:bg-bg-hover hover:text-text-primary text-text-muted rounded transition-colors" aria-label="Close detail">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 6L6 18M6 6l12 12"/></svg>
            </button>
          </div>
        </header>

        <!-- Progress bar -->
        <div id="td-progress-bar-container" class="w-full h-1 bg-bg-input hidden">
          <div id="td-progress-bar-fill" class="h-full bg-accent transition-all duration-300" style="width: 0%"></div>
        </div>
        <div id="td-due-row" class="hidden">
           <!-- Hidden but kept for backwards compat with controller -->
           <span id="td-due-display"></span>
        </div>

        <div class="flex flex-1 overflow-hidden flex-col md:flex-row relative">
          
          <!-- MAIN CONTENT COLUMN -->
          <main class="flex-1 overflow-y-auto px-6 py-6 lg:px-10 space-y-8 bg-bg-primary min-w-0">
            
            <!-- Title -->
            <div class="relative group">
              <textarea
                id="td-title"
                class="w-full bg-transparent border border-transparent hover:bg-bg-hover focus:bg-bg-input focus:border-border focus:ring-1 focus:ring-accent text-3xl font-bold py-2 px-3 -ml-3 rounded-lg transition-colors leading-tight resize-none text-text-primary overflow-hidden"
                rows="1"
                placeholder="Task title"
              ></textarea>
            </div>

            <!-- Description -->
            <section class="mb-5">
              <div class="flex items-center justify-between mb-3">
                <h3 class="text-xs text-text-muted font-bold uppercase tracking-wider flex justify-between w-full pr-1">
                    <span>Description</span>
                    <div class="flex gap-2">
                      <button id="td-desc-edit-btn" class="text-xs text-accent hover:underline hidden" type="button">Edit</button>
                      <button id="td-desc-preview-btn" class="hidden text-xs text-text-muted hover:text-text-primary" type="button">Preview</button>
                    </div>
                </h3>
              </div>
              <div class="group relative">
                <div id="td-desc-preview-container" class="prose prose-sm dark:prose-invert max-w-none wrap-break-word p-3 -ml-3 rounded-lg hover:bg-bg-hover border border-transparent transition-colors cursor-text min-h-[60px] text-base group-hover:bg-bg-hover">
                  <div id="td-desc-preview" class="empty:after:content-['Add_a_description...'] empty:after:text-text-muted empty:after:italic"></div>
                </div>
                <div class="absolute top-2 right-2 opacity-0 group-hover:opacity-100 transition-opacity">
                    <button id="td-desc-edit-btn-hover" class="bg-bg-primary border border-border shadow-sm text-text-secondary hover:text-text-primary px-2 py-1 rounded text-xs" type="button">Edit</button>
                </div>
              </div>
              <div id="td-desc-edit-container" class="hidden">
                <textarea
                  id="td-description"
                  class="form-input min-h-[160px] resize-y text-sm w-full focus:ring-1 focus:ring-accent font-mono leading-relaxed"
                  placeholder="Add a detailed description (Markdown supported)..."
                ></textarea>
                <div class="flex justify-end mt-2 gap-2">
                    <button class="btn btn-primary text-xs px-3 py-1.5 shadow-sm" type="button" onclick="document.getElementById('td-desc-preview-btn').click()">Save</button>
                </div>
              </div>
            </section>

            <!-- Checklists -->
            <section>
              <div class="flex items-center justify-between mb-2">
                <h3 class="text-xs text-text-muted font-bold uppercase tracking-wider">Checklists</h3>
                <button type="button" id="td-add-checklist-item" class="text-xs text-accent hover:text-accent-hover transition-colors font-medium flex items-center gap-1">
                    <span>➕ Add Item</span>
                </button>
              </div>
              <div id="td-checklist-progress" class="text-[10px] text-text-muted mb-3 flex items-center justify-between" style="display:none;">
