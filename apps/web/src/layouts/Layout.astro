    <!-- Keyboard Shortcuts Modal (must be outside task-detail-overlay for visibility) -->
    <div id="shortcut-modal" class="shortcut-modal-overlay hidden" role="dialog" aria-modal="true" aria-label="Keyboard shortcuts">
      <div class="shortcut-modal-content" onclick="arguments[0].stopPropagation()">
        <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:16px;">
          <h3 style="margin:0;font-size:16px;color:var(--accent);">⌨ Keyboard Shortcuts</h3>
          <button id="shortcut-modal-close" style="background:none;border:none;color:var(--text-muted);cursor:pointer;font-size:18px;padding:4px 8px;" aria-label="Close shortcuts">✕</button>
        </div>
        <div style="display:grid;grid-template-columns:auto 1fr;gap:8px 16px;font-size:13px;">
          <kbd style="background:var(--bg-secondary);border:1px solid var(--border);border-radius:4px;padding:2px 8px;font-family:monospace;font-size:12px;">/</kbd><span>Focus search</span>
          <kbd style="background:var(--bg-secondary);border:1px solid var(--border);border-radius:4px;padding:2px 8px;font-family:monospace;font-size:12px;">n</kbd><span>New task</span>
          <kbd style="background:var(--bg-secondary);border:1px solid var(--border);border-radius:4px;padding:2px 8px;font-family:monospace;font-size:12px;">d</kbd><span>Dashboard</span>
          <kbd style="background:var(--bg-secondary);border:1px solid var(--border);border-radius:4px;padding:2px 8px;font-family:monospace;font-size:12px;">k</kbd><span>Kanban board</span>
          <kbd style="background:var(--bg-secondary);border:1px solid var(--border);border-radius:4px;padding:2px 8px;font-family:monospace;font-size:12px;">t</kbd><span>Table view</span>
          <kbd style="background:var(--bg-secondary);border:1px solid var(--border);border-radius:4px;padding:2px 8px;font-family:monospace;font-size:12px;">⌘K</kbd><span>Command palette</span>
          <kbd style="background:var(--bg-secondary);border:1px solid var(--border);border-radius:4px;padding:2px 8px;font-family:monospace;font-size:12px;">?</kbd><span>This help</span>
          <kbd style="background:var(--bg-secondary);border:1px solid var(--border);border-radius:4px;padding:2px 8px;font-family:monospace;font-size:12px;">Esc</kbd><span>Close modal / blur</span>
        </div>
      </div>
    </div>

    <script>
      import { createFocusTrap } from "@lib/focus-trap";
      const shortcutOverlay = document.getElementById("shortcut-modal");
      const shortcutTrap = shortcutOverlay ? createFocusTrap(shortcutOverlay) : null;
      function openShortcutModal() {
        shortcutOverlay?.classList.remove("hidden");
        shortcutTrap?.activate();
      }
      function closeShortcutModal() {
        shortcutTrap?.deactivate();
        shortcutOverlay?.classList.add("hidden");
      }
      shortcutOverlay?.addEventListener("click", (e) => {
        if (e.target === shortcutOverlay) closeShortcutModal();
      });
      document.getElementById("shortcut-modal-close")?.addEventListener("click", () => {
        closeShortcutModal();
      });
    </script>

    <!-- Graceful fallback when JavaScript is disabled -->
    <noscript>
      <div style="position:fixed;inset:0;z-index:9999;background:var(--bg-primary,#0f0f23);color:var(--text-primary,#e2e8f0);display:flex;align-items:center;justify-content:center;padding:2rem;text-align:center;">
        <div>
          <h1 style="font-size:1.5rem;margin-bottom:1rem;">JavaScript Required</h1>
          <p>Meitheal requires JavaScript to function. Please enable JavaScript in your browser settings and reload this page.</p>
        </div>
      </div>
    </noscript>
  </body>
</html>
