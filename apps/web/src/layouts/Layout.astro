      let labelCheck
      let frozen = false
      const freezeLabels = () => {
        frozen = true
        labelCheck?.abort()
        document.body.style.visibility = "hidden"
      }
      async function checkLabels() {
        labelCheck?.abort()
        const pending = new AbortController()
        labelCheck = pending
        try {
          const suffix = organizationSettings ? "?settings" : ""
          const response = await fetch("/api/organization-labels" + suffix, {
            method: "HEAD", cache: "no-store",
            signal: AbortSignal.any([pending.signal, AbortSignal.timeout(4_000)]),
          })
          if (pending.signal.aborted) return
          if (response.headers.get("x-meitheal-rendered-labels") !== organizationProof) {
            freezeLabels()
            window.location.reload()
            return
          }
          if (frozen) document.body.style.removeProperty("visibility")
          frozen = false
        } catch {
          if (!pending.signal.aborted) {
            freezeLabels()
            window.location.reload()
          }
        }
      }
      window.addEventListener("pagehide", freezeLabels)
      window.addEventListener("pageshow", event => { if (event.persisted) void checkLabels() })
      window.addEventListener("focus", () => { if (!document.hidden) void checkLabels() })
