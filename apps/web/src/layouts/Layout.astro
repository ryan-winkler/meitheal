---
import "../styles/global.css";
import Confetti from "../components/gamification/Confetti.astro";
import PomodoroTimer from "../components/pomodoro/PomodoroTimer.astro";
import { getFeatureFlags } from "../lib/feature-flags";
import { ClientRouter } from "astro:transitions";
import { alternateClientTranslationJson, clientTranslationJson, t } from "../i18n/translations";
import type { Locale } from "../lib/locale";
import Sidebar from "../components/layout/Sidebar.astro";
import SearchHub from "../components/layout/SearchHub.astro";
import TopNavigation from "../components/layout/TopNavigation.astro";

import NewTaskModal from "../components/tasks/NewTaskModal.astro";
import TaskDetailModal from "../components/tasks/TaskDetailModal.astro";
import AskAssistModal from "../components/ha/AskAssistModal.astro";
import PwaInstallBanner from "../components/pwa/PwaInstallBanner.astro";
import JsonLd from "../components/seo/JsonLd.astro";
import { APPEARANCE_PREFERENCES, APPEARANCE_STORAGE_KEY } from "../lib/appearance-preferences"
import { applyPersonalAccent } from "../lib/accent-colors"
import { canManageSystemSettings } from "../lib/settings-security"
import { TASK_VIEWS } from "../lib/task-view-route"

import geistWoff2 from '@fontsource-variable/geist/files/geist-latin-wght-normal.woff2?url';
import outfitWoff2 from '@fontsource-variable/outfit/files/outfit-latin-wght-normal.woff2?url';

// i18n: resolve locale from cookie for SSR
const cookieLocale = Astro.cookies.get("meitheal-locale")?.value;
const locale: Locale = cookieLocale === "ga" ? "ga" : "en";

// Feature flags — read from settings DB (SSR)
const featureFlags = await getFeatureFlags();
const featureFlagsJson = JSON.stringify(featureFlags);
const showConfetti = !!featureFlags.confetti;
const showPomodoro = !!featureFlags.pomodoro;

const {
  timezone = "Europe/Dublin",
  weekStart = "monday",
  dateFormat = "relative",
  ingressPath,
  behindIngress = false,
} = Astro.locals;

export interface Props {
  title?: string;
  description?: string;
  hideSearchHub?: boolean;
  hideGlobalSearch?: boolean;
  suppressTaskUrlOpen?: boolean;
  privatePageShell?: boolean;
  /** Optional JSON-LD schema for page-level structured data */
  jsonLd?: Record<string, unknown>;
}

const {
  title = "Meitheal",
  description = "The cooperative task and life engine for your home.",
  hideSearchHub = false,
  hideGlobalSearch = false,
  suppressTaskUrlOpen = false,
  privatePageShell = false,
  jsonLd,
} = Astro.props;

// OA-607: Sidebar task count badges (SSR)
let taskCounts = { total: 0, active: 0, pending: 0 };
if (!privatePageShell) try {
  const { ensureSchema, getPersistenceClient } =
    await import("@domains/tasks/persistence/store");
  await ensureSchema();
  const client = getPersistenceClient();
  const result = await client.execute(
    "SELECT status, COUNT(*) AS cnt, COUNT(*) FILTER (WHERE deferred_at IS NULL) AS open_count FROM tasks GROUP BY status",
  );
  for (const row of result.rows) {
    const r = row as Record<string, unknown>;
    const s = String(r.status);
    const c = Number(r.cnt);
    const open = Number(r.open_count)
    taskCounts.total += c;
    if (s === "active") taskCounts.active += open
    if (s === "pending" || s === "backlog") taskCounts.pending += open
  }
} catch {
  /* DB not available */
}

// Security headers are set by middleware.ts — no duplicates here.
// IMPORTANT: Do NOT set Strict-Transport-Security or upgrade-insecure-requests
// in HA ingress environments — the addon serves HTTP internally.
Astro.response.headers.set("X-Content-Type-Options", "nosniff");
---

<!doctype html>
<html lang={locale} dir="ltr" data-custom-theme-admin={canManageSystemSettings(Astro.request, Astro.locals) ? "" : undefined}>
  <head>
    <!-- Scroll-lock guard: prevent external tools from locking body scroll (P0) -->
    <script is:inline>
      (function () {
        // Meitheal modals that legitimately lock scroll set data-scroll-lock="true"
        function isRealModalOpen() {
          var overlay = document.getElementById("task-detail-overlay");
          if (overlay && !overlay.classList.contains("hidden")) return true;
          var ntModal = document.getElementById("new-task-modal");
          if (ntModal && ntModal.classList.contains("active")) return true;
          var confirmOverlay = document.getElementById("confirm-dialog-overlay");
          if (confirmOverlay && !confirmOverlay.classList.contains("hidden")) return true;
          // Mobile sidebar open is legitimate
          if (document.body.classList.contains("sidebar-open") && window.innerWidth <= 768) return true;
          return false;
        }
        // MutationObserver: undo external overflow:hidden on body when no modal is open
        var observer = new MutationObserver(function (mutations) {
          for (var i = 0; i < mutations.length; i++) {
            var m = mutations[i];
            if (m.attributeName === "style" || m.attributeName === "class") {
              var body = document.body;
              var hasHidden = body.style.overflow === "hidden" || body.classList.contains("antigravity-scroll-lock");
              if (hasHidden && !isRealModalOpen()) {
                body.style.overflow = "";
                body.classList.remove("antigravity-scroll-lock");
                // P0-2: Reset position/touch-action if leaked from sidebar-open
                if (body.style.position === "fixed") body.style.position = "";
                if (body.style.touchAction === "none") body.style.touchAction = "";
              }
            }
          }
        });
        // Start observing once body exists
        if (document.body) {
          observer.observe(document.body, { attributes: true, attributeFilter: ["style", "class"] });
        } else {
          document.addEventListener("DOMContentLoaded", function () {
            observer.observe(document.body, { attributes: true, attributeFilter: ["style", "class"] });
          });
        }
      })();
    </script>
    <!-- Ingress-aware fetch: prefix /api/ paths with HA ingress path -->
    <script is:inline>
      (function () {
        var ip = window.__ingress_path;
        var _f = window.fetch;
        window.fetch = function (input, init) {
          // Ensure ingress session cookie is always sent
          if (!init) init = {};
          if (ip) {
            if (!init.credentials) init.credentials = "include";
            if (typeof input === "string" && input.startsWith("/")) {
              // Guard: don't prefix if URL already contains the ingress path
              if (!input.startsWith(ip + "/") && input !== ip) {
                input = ip + input;
              }
            } else if (input instanceof Request && input.url) {
              var u = new URL(input.url);
              if (u.pathname.startsWith("/") && u.origin === location.origin) {
                // Guard: don't prefix if path already contains the ingress path
                if (!u.pathname.startsWith(ip + "/") && u.pathname !== ip) {
                  input = new Request(ip + u.pathname + u.search, input);
                }
              }
            }
          }
          return _f.call(this, input, init).then(function (response) {
            // Supervisor can return 403 for a stale ingress session. Keep the
            // current page and form state when Meitheal denies an operation.
            var resultUrl = response.url && new URL(response.url);
            var ingressResponse = ip && resultUrl && resultUrl.origin === location.origin
              && resultUrl.pathname.startsWith(ip + "/");
            var appResponse = response.headers.has("x-ingress-path")
              || /\bjson\b/i.test(response.headers.get("content-type") || "");
            var privateTaskResponse = ingressResponse &&
              [ip + "/api/task-pins", ip + "/api/task-drafts", ip + "/api/task-inactivity"].includes(resultUrl.pathname);
            var participantResponse = ingressResponse &&
              /^\/api\/tasks\/(?:reaction-counts|[^/]+\/(?:comments(?:\/[^/]+(?:\/reactions(?:\/[^/]+)?)?)?|reactions(?:\/[^/]+)?))$/
                .test(resultUrl.pathname.slice(ip.length));
            if (response.status === 403 && ingressResponse && !appResponse && !privateTaskResponse && !participantResponse) {
              var reloadKey = "meitheal-ingress-reload";
              var lastReload = sessionStorage.getItem(reloadKey);
              var now = Date.now();
              // Guard: don't reload more than once per 10 seconds
              if (!lastReload || now - Number(lastReload) > 10000) {
                sessionStorage.setItem(reloadKey, String(now));
                var tc = document.querySelector(".toast-container");
                if (tc) {
                  var t = document.createElement("div");
                  t.className = "toast warning";
                  t.textContent = "🔄 Session expired. Reloading...";
                  t.setAttribute("role", "alert");
                  tc.appendChild(t);
                }
                setTimeout(function () {
                  window.location.reload();
                }, 800);
              }
            }
            if (response.status === 409) {
              var headers = new Headers(init?.headers ?? (input instanceof Request ? input.headers : undefined))
              if (headers.get("X-Meitheal-Local-Conflict") !== "1") {
                response.clone().json().then(function (body) {
                  if (body?.errorCode !== "TASK_VERSION_CONFLICT") return
                  var message = window.mI18n?.get("common.task_version_conflict") ??
                    "This task changed in another session. Reload to see the latest version."
                  var container = document.querySelector(".toast-container")
                  if (container) {
                    var toast = document.createElement("div")
                    toast.className = "toast warning"
                    toast.textContent = message
                    toast.setAttribute("role", "alert")
                    container.appendChild(toast)
                    setTimeout(function () { toast.remove() }, 6000)
                  } else {
                    var live = document.getElementById("sync-announcer")
                    if (live) live.textContent = message
                  }
                }).catch(function () {})
              }
            }
            return response;
          });
        };
      })();
    </script>

    <!-- Ingress state persistence: restore last route after iframe recreation -->
    <!-- Runs pre-paint so the user never sees a flash of the wrong page -->
    <script is:inline>
      (function () {
        if (!window.__ingress_path) return;
        if (window.location.pathname !== "/") return;
        try {
          var raw = sessionStorage.getItem("meitheal-navigation-state");
          if (!raw) return;
          var state = JSON.parse(raw);
          if (
            typeof state.path !== "string" ||
            typeof state.timestamp !== "number"
          )
            return;
          // Only restore if saved within the last 60 seconds
          if (Date.now() - state.timestamp > 60000) {
            sessionStorage.removeItem("meitheal-navigation-state");
            return;
          }
          // Don't redirect to root (no-op)
          if (state.path === "/") return;
          // Redirect to saved path — prepend ingress path for proper routing
          var target = window.__ingress_path + state.path;
          // Save scroll position to restore after redirect
          if (state.scrollY) {
            sessionStorage.setItem(
              "meitheal-restore-scroll",
              String(state.scrollY),
            );
          }
          window.location.replace(target);
        } catch (e) {
          // sessionStorage unavailable or parse error — silently continue
        }
      })();
    </script>

    <!-- Restore appearance before a full load or an Astro document swap. -->
    <script is:inline set:html={`window.__meithealApplyAccent = ${applyPersonalAccent.toString()};`} />
    <script is:inline define:vars={{ APPEARANCE_PREFERENCES, APPEARANCE_STORAGE_KEY }}>
      (function () {
        function restoreAppearance(doc) {
          function stored(key) {
            try { return localStorage.getItem(key); } catch { return null; }
          }
          var theme = stored("meitheal-theme");
          var root = doc.documentElement;
          root.dataset.theme = theme === "custom" ? "dark" : ["light", "dark"].includes(theme) ? theme : "auto";
          var appearance;
          try {
            appearance = JSON.parse(stored(APPEARANCE_STORAGE_KEY) ?? "{}");
          } catch { /* Invalid browser preferences fall back to their defaults. */ }
          for (var [name, preference] of Object.entries(APPEARANCE_PREFERENCES)) {
            var value = appearance?.[name];
            root.setAttribute("data-appearance-" + name.replace(/[A-Z]/g, function (letter) { return "-" + letter.toLowerCase(); }), preference.options.includes(value) ? value : preference.defaultValue);
          }
          if (doc.body) {
            var desktopSidebar = innerWidth > 768 && root.dataset.appearanceNavigation !== "navbar";
            var sidebarMode = root.dataset.appearanceSidebar;
            var collapsed = desktopSidebar && (["folded", "hover"].includes(sidebarMode)
              || (sidebarMode === "remember" && stored("meitheal_sidebar_collapsed") === "true"));
            doc.body.classList.toggle("sidebar-collapsed", collapsed);
          }
          var accent = stored("meitheal-accent-color");
          window.__meithealApplyAccent(root, accent);
          var themeAdmin = root.hasAttribute("data-custom-theme-admin");
          if (!themeAdmin) {
            try { localStorage.removeItem("meitheal-custom-theme-css"); } catch {}
          }
          var css = themeAdmin && theme === "custom" && stored("meitheal-custom-theme-css");
          if (css) {
            var style = doc.getElementById("meitheal-custom-theme");
            if (!style) {
              style = doc.createElement("style");
              style.id = "meitheal-custom-theme";
              doc.head.appendChild(style);
            }
            style.textContent = css;
          }
        }

        restoreAppearance(document);
        window.__meithealAppearanceEvents?.abort();
        var events = new AbortController();
        window.__meithealAppearanceEvents = events;
        document.addEventListener("astro:before-swap", function (event) {
          restoreAppearance(event.newDocument);
        }, { signal: events.signal });
      })();
    </script>

    <!-- Page transition loading indicator (CSS-only) -->
    <style is:inline>
      @keyframes meitheal-loading-slide {
        0% {
          transform: translateX(-100%);
        }
        50% {
          transform: translateX(0%);
        }
        100% {
          transform: translateX(100%);
        }
      }
      .meitheal-loading-bar {
        position: fixed;
        top: 0;
        left: 0;
        width: 100%;
        height: 3px;
        z-index: 9999;
        background: var(--accent, #6366f1);
        transform: translateX(-100%);
        animation: meitheal-loading-slide 1.2s ease-in-out infinite;
        pointer-events: none;
        opacity: 0;
        transition: opacity 0.2s;
      }
      html.is-loading .meitheal-loading-bar {
        opacity: 1;
      }
      @media (prefers-reduced-motion: reduce) {
        .meitheal-loading-bar {
          animation: none;
          transform: translateX(0);
          width: 100%;
        }
      }
    </style>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    {!privatePageShell && <meta property="og:url" content={Astro.url.href} />}
    <link
      rel="manifest"
      href="/manifest.webmanifest"
      crossorigin="use-credentials"
    />
    <link rel="apple-touch-icon" href="/icon-192.png" />
    <meta name="theme-color" content="#0f172a" />
    <meta name="mobile-web-app-capable" content="yes" />
    <meta
      name="apple-mobile-web-app-status-bar-style"
      content="black-translucent"
    />
    
    <!-- Resource Hints: Preload critical fonts to prevent layout shift -->
    <link rel="preload" href={geistWoff2} as="font" type="font/woff2" crossorigin="anonymous" />
    <link rel="preload" href={outfitWoff2} as="font" type="font/woff2" crossorigin="anonymous" />
    
    <!-- Inter font self-hosted via @fontsource-variable/inter (imported in global.css) -->
    {!behindIngress && <script is:inline>
      // Register before ClientRouter: drawer history belongs to the current DOM.
      if (!window.__meithealTicketHistoryGuard) {
        window.__meithealTicketHistoryGuard = true
        const lifetime = new AbortController()
        window.addEventListener("popstate", event => {
          const session = document.getElementById("task-detail-overlay")?.dataset.ticketHistorySession
          const state = history.state
          if (session && (state?.ticketBackground === session || state?.ticketDrawer?.session === session)) {
            event.stopImmediatePropagation()
            window.dispatchEvent(new Event("meitheal:ticket-history"))
          }
        }, { signal: lifetime.signal })
      }
    </script>}
    {!behindIngress && <ClientRouter fallback="swap" />}
    {!privatePageShell && <JsonLd schema={jsonLd ?? {
      "@type": "SoftwareApplication",
      name: "Meitheal",
      description,
      applicationCategory: "ProductivityApplication",
      operatingSystem: "Home Assistant",
      url: Astro.url.href,
      potentialAction: {
        "@type": "SearchAction",
        target: `${Astro.url.origin}/api/search?q={query}`,
        "query-input": "required name=query",
      },
    }} />}
    <!-- Send only the current locale and keep client translation available during parsing. -->
    <script type="application/json" id="meitheal-client-translations" set:html={clientTranslationJson[locale]} />
    <script type="application/json" id="meitheal-alternate-translations" set:html={alternateClientTranslationJson[locale]} />
    <script
      is:inline
      define:vars={{ locale, timezone, weekStart, dateFormat }}
    >
      const dict = JSON.parse(document.getElementById("meitheal-client-translations").textContent);
      const alternate = JSON.parse(document.getElementById("meitheal-alternate-translations").textContent);
      window.mSettings = { timezone, weekStart, dateFormat };
      window.mI18n = {
        locale,
        get: function (key, language = locale) {
          if (language !== locale) return typeof alternate[key] === "string" ? alternate[key] : key;
          if (typeof dict[key] === "string") return dict[key];
          const parts = key.split(".");
          let val = dict;
          for (const p of parts) {
            if (!val || typeof val !== "object") break;
            val = val[p];
          }
          if (typeof val === "string") return val;
          const legacy = key.startsWith("settings.") ? dict[locale]?.[key] : undefined;
          return typeof legacy === "string" ? legacy : key;
        },
      };
    </script>
  </head>
  <body>
    <!-- Page transition loading indicator -->
    <div class="meitheal-loading-bar" aria-hidden="true" data-no-scroll-lock="true"></div>

    <!-- Wire Astro view transitions to loading bar -->
    <script is:inline>
      function showLoading() { document.documentElement.classList.add("is-loading"); }
      function hideLoading() { document.documentElement.classList.remove("is-loading"); }

      document.addEventListener("astro:before-preparation", showLoading);
      document.addEventListener("astro:after-swap", hideLoading);
      document.addEventListener("astro:page-load", hideLoading);

      // Fallback: show loading bar for standard browser navigation (like in HA ingress without ViewTransitions)
      window.addEventListener("beforeunload", showLoading);

      // Clear loading state if page is restored from bfcache
      window.addEventListener("pageshow", function(e) {
        if (e.persisted) hideLoading();
      });
    </script>

    <!-- Sidebar collapse: restore state immediately to avoid FOUC -->
    <script is:inline>
      (function () {
        // HA ingress detection
        if (window.__ingress_path && document.body) {
          document.body.classList.add("ha-ingress");
        }
        var appearance = document.documentElement.dataset;
        var desktopSidebar = innerWidth > 768 && appearance.appearanceNavigation !== "navbar";
        var collapsed = desktopSidebar && ["folded", "hover"].includes(appearance.appearanceSidebar);
        if (desktopSidebar && appearance.appearanceSidebar === "remember") {
          try { collapsed = localStorage.getItem("meitheal_sidebar_collapsed") === "true"; } catch {}
        }
        document.body.classList.toggle("sidebar-collapsed", collapsed);
      })();
    </script>
    <!-- Ingress URL sync: DISABLED — removed to prevent potential HA panel routing interference -->

    <a href="#main-content" class="skip-to-content"
      >{t("nav.skip_to_content", locale)}</a
    >
    {!privatePageShell && <div class="layout-navigation" transition:persist="sidebar">
      <Sidebar locale={locale} taskCounts={taskCounts} />
    </div>}

    <div class="main-content" style={privatePageShell ? "margin-inline-start: 0" : undefined}>
      {Astro.slots.has('custom-header') ? (
        <slot name="custom-header" />
      ) : !privatePageShell && (
        <TopNavigation locale={locale} hideGlobalSearch={hideGlobalSearch}>
          <Fragment slot="page-title"><slot name="page-title" /></Fragment>
          <Fragment slot="actions"><slot name="actions" /></Fragment>
        </TopNavigation>
      )}
      <main
        class="content"
        role="main"
        id="main-content"
        style="padding: 0 24px 24px;"
      >
        <slot />
      </main>
    </div>

    <!-- PRA-16: Mobile bottom tab bar — thumb-zone navigation for HA Companion App -->
    <nav class="mobile-tab-bar" id="mobile-tab-bar" aria-label="Mobile navigation">
      <a href="/" class="mobile-tab-bar__item" data-page="dashboard">
        <span class="mobile-tab-bar__icon">⌂</span>
        <span class="mobile-tab-bar__label">Home</span>
      </a>
      <a href="/today" class="mobile-tab-bar__item" data-page="today">
        <span class="mobile-tab-bar__icon">☀️</span>
        <span class="mobile-tab-bar__label">Today</span>
      </a>
      <a href="/tasks" class="mobile-tab-bar__item" data-page="tasks">
        <span class="mobile-tab-bar__icon">📋</span>
        <span class="mobile-tab-bar__label">Tasks</span>
      </a>
      <a href="/tasks?view=calendar#calendar" data-astro-prefetch="false" class="mobile-tab-bar__item" data-page="calendar">
        <span class="mobile-tab-bar__icon">📅</span>
        <span class="mobile-tab-bar__label">Calendar</span>
      </a>
      <a href="/settings" class="mobile-tab-bar__item" data-page="settings">
        <span class="mobile-tab-bar__icon">⚙️</span>
        <span class="mobile-tab-bar__label">Settings</span>
      </a>
    </nav>

    <!-- Mobile tab bar: highlight active page -->
    <script is:inline>
      (function() {
        window.__meithealUpdateMobileTabBar = function() {
          var bar = document.getElementById("mobile-tab-bar");
          if (!bar) return;
          var path = window.location.pathname;
          // Strip ingress prefix if present
          var ip = window.__ingress_path || "";
          if (ip && path.startsWith(ip)) path = path.slice(ip.length);
          // Match page name from path
          var page = path.replace(/^\//, "").split("/")[0] || "dashboard";
          if (page === "" || page === "index") page = "dashboard";
          if (page === "kanban" || page === "table" || page === "timeline" || page === "tickets") page = "tasks";
          if (page === "tasks" && document.querySelector('[data-task-view="calendar"]')) page = "calendar";
          var items = bar.querySelectorAll(".mobile-tab-bar__item");
          for (var i = 0; i < items.length; i++) {
            var isActive = items[i].getAttribute("data-page") === page;
            items[i].classList.toggle("active", isActive);
            if (isActive) {
              items[i].setAttribute("aria-current", "page");
            } else {
              items[i].removeAttribute("aria-current");
            }
          }
        };
        if (!window.__meithealMobileTabBarBound) {
          window.__meithealMobileTabBarBound = true;
          window.addEventListener("hashchange", function() {
            window.__meithealUpdateMobileTabBar && window.__meithealUpdateMobileTabBar();
          });
          document.addEventListener("astro:page-load", function() {
            window.__meithealUpdateMobileTabBar && window.__meithealUpdateMobileTabBar();
          });
        }
        window.__meithealUpdateMobileTabBar();
      })();
    </script>

    <!-- Toast notifications are handled by the shared showToast() system (see @lib/toast) -->

    <script>
      import "@lib/mobile-sidebar-controller"
    </script>
    <script>
      import "@lib/layout-controller";
      import { initHAThemeBridge } from "@lib/ha-theme-bridge";
      import { initGlobalErrorHandler } from "@lib/global-error-handler";
      initHAThemeBridge();
      initGlobalErrorHandler();
    </script>

    <script>
      import "@lib/search-hub-controller";
      import "@lib/webmcp-controller";
    </script>

    <script>
      import "@lib/layout-body-controller";
    </script>

    {!privatePageShell && <>
      <NewTaskModal />
      <TaskDetailModal suppressUrlOpen={suppressTaskUrlOpen} />
      <AskAssistModal />
    </>}
    {!hideSearchHub && <SearchHub locale={locale} />}
    <!-- Sync status announcer for screen readers (Persona #25) -->
    <div
      id="sync-announcer"
      aria-live="polite"
      aria-atomic="true"
      class="sr-only"
      role="status"
    >
    </div>
    <!-- PWA Install Banner -->
    <PwaInstallBanner />
    <!-- PWA: Service Worker Registration + Install Prompt + Update Handler -->
    <script>
      import "@lib/layout-pwa-controller";
    </script>
    {showConfetti && <Confetti />}
    {!privatePageShell && <PomodoroTimer enabled={showPomodoro} />}
    <script define:vars={{ featureFlagsJson }}>
      window.__featureFlags = JSON.parse(featureFlagsJson);
    </script>
    <!-- Keyboard Shortcuts Modal (must be outside task-detail-overlay for visibility) -->
    <div id="shortcut-modal" class="shortcut-modal-overlay hidden" role="dialog" aria-modal="true" aria-label="Keyboard shortcuts">
      <div class="shortcut-modal-content">
        <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:16px;">
          <h3 style="margin:0;font-size:16px;color:var(--accent);">⌨ Keyboard Shortcuts</h3>
          <button id="shortcut-modal-close" type="button" style="background:none;border:none;color:var(--text-muted);cursor:pointer;font-size:18px;padding:4px 8px;" aria-label="Close shortcuts">✕</button>
        </div>
        <div class="shortcut-modal-grid">
          <kbd>/</kbd><span>Focus search</span>
          <kbd>n</kbd><span>New task</span>
          <kbd>d</kbd><span>Dashboard</span>
          <kbd>k</kbd><span>Kanban board (moves up on Today and Timeline)</span>
          <kbd>t</kbd><span>Table view</span>
          <kbd>⌘K</kbd><span>Command palette</span>
          <kbd>?</kbd><span>This help</span>
          <kbd>Esc</kbd><span>Close modal / blur</span>
          <h4>{t("settings.shortcut_task_views", locale)}</h4>
          {TASK_VIEWS.map((view, index) => (
            <><kbd>{index + 1}</kbd><span>{t(`settings.shortcut_${view}`, locale)}</span></>
          ))}
        </div>
      </div>
    </div>

    <!-- Graceful fallback when JavaScript is disabled -->
    <noscript>
      <div style="position:fixed;inset:0;z-index:9999;background:var(--bg-primary,#0f0f23);color:var(--text-primary,#e2e8f0);display:flex;align-items:center;justify-content:center;padding:2rem;text-align:center;">
        <div>
          <h1 style="font-size:1.5rem;margin-bottom:1rem;">JavaScript Required</h1>
          <p>Meitheal requires JavaScript to function. Please enable JavaScript in your browser settings and reload this page.</p>
        </div>
      </div>
    </noscript>
  </body>
</html>
