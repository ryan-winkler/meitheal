      is:inline
      define:vars={{ locale, timezone, weekStart, dateFormat, calendarPushPolicy, calendarManualPushVisible }}
    >
      let dict;
      let alternate;
      function loadDict() {
        if (!dict) {
          const el = document.getElementById("meitheal-client-translations");
          dict = el && el.textContent ? JSON.parse(el.textContent) : {};
        }
        return dict;
      }
      function loadAlternate() {
        if (!alternate) {
          const el = document.getElementById("meitheal-alternate-translations");
          alternate = el && el.textContent ? JSON.parse(el.textContent) : {};
        }
        return alternate;
      }
      window.mSettings = { timezone, weekStart, dateFormat, ...calendarPushPolicy, calendarManualPushVisible };
      window.mI18n = {
        locale,
        get: function (key, language = locale) {
          if (language !== locale) {
            const alt = loadAlternate();
            return typeof alt[key] === "string" ? alt[key] : key;
          }
          const d = loadDict();
          if (typeof d[key] === "string") return d[key];
          const parts = key.split(".");
          let val = d;
          for (const p of parts) {
            if (!val || typeof val !== "object") break;
            val = val[p];
