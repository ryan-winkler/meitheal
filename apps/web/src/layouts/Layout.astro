---
import { readBoardPagePlacement } from "@lib/board-page-placement"
import { createHash } from "node:crypto"
import { getPersistenceClient, scopeBoardAccess, scopePermits, taskActionHints } from "@domains/tasks"
import { getPluginService } from "@domains/plugins"
import type { BoardScope } from "@domains/tasks"
import { resolveBoardRequestScope, verifiedBoardRequestPrincipal } from "@lib/board-request-context"
import { boardScopeAuthorityKey, retainBoardResponseScope } from "@lib/board-view"
import { boardSessionProof, currentBoardContext } from "@lib/named-board-request"
import { taskViewUrl } from "../lib/task-view-route"
import { boardNavigationLinks, readBoardNavigationContext } from "../lib/board-workspace"
import {
  readCachedAiAssistDisabled,
  readCachedCalendarPushPolicy,
  readCachedHasActivePlugins,
  readCachedSidebarAndProfile,
  readCachedTaskDetailLayout,
  readCachedWorkInstallationId,
} from "../lib/shell-settings-cache"
import { isOrganizationFeatureAvailable, organizationNeedsVerification } from "../lib/organization-request-context"
import { readRequestOrganizationLabels, renderedLabelsProof } from "@lib/organization-labels"
import { verifiedIngressUser } from "@lib/verified-ingress-user"
import { homeAssistantAreaAccess } from "../lib/home-assistant-area-access"
import "../styles/global.css";
import Confetti from "../components/gamification/Confetti.astro";
import PomodoroTimer from "../components/pomodoro/PomodoroTimer.astro";
import { getFeatureFlags } from "../lib/feature-flags";
import { ClientRouter } from "astro:transitions";
import { alternateClientTranslationJson, clientTranslationJson, t } from "../i18n/translations";
import type { Locale } from "../lib/locale";
import Sidebar from "../components/layout/Sidebar.astro";
import SearchHub from "../components/layout/SearchHub.astro";
import KeyboardShortcutList from "../components/layout/KeyboardShortcutList.astro";
import TopNavigation from "../components/layout/TopNavigation.astro";
import Icon from "../components/ui/Icon.astro";
import IconSpriteDefs from "../components/ui/IconSpriteDefs.astro";
import CachedHtmlSlot from "../components/ui/CachedHtmlSlot.astro";

import NewTaskModal from "../components/tasks/NewTaskModal.astro";
import QuickAddDialog from "../components/tasks/QuickAddDialog.astro"
import TaskDetailModal from "../components/tasks/TaskDetailModal.astro";
import CustomRecurrenceModal from "../components/ui/CustomRecurrenceModal.astro";
import AskAssistModal from "../components/ha/AskAssistModal.astro";
import PwaInstallBanner from "../components/pwa/PwaInstallBanner.astro";
import ToastRegion from "../components/ui/ToastRegion.astro";
import JsonLd from "../components/seo/JsonLd.astro";
import { APPEARANCE_PREFERENCES, APPEARANCE_STORAGE_KEY } from "../lib/appearance-preferences"
import { applyPersonalAccent } from "../lib/accent-colors"
import { applyHAThemePalette, HA_THEME_MATCH_KEY, readHAThemePalette } from "../lib/ha-theme-palette"
import { canManageSystemSettings } from "../lib/settings-security"
import { LIGHT_THEME_MODES, THEME_META_COLORS, THEME_MODES } from "../lib/theme-mode"
import { parseWorkspacePreferences, WORKSPACE_PREFERENCES_PREFIX } from "../lib/workspace-preferences"
import { readIngressPanelRoute } from "../lib/ingress-navigation"

import geistWoff2 from '@fontsource-variable/geist/files/geist-latin-wght-normal.woff2?url';

// i18n: resolve locale from cookie for SSR
const cookieLocale = Astro.cookies.get("meitheal-locale")?.value;
const locale: Locale = cookieLocale === "ga" ? "ga" : "en";

import { shouldShowManualCalendarPush } from "../lib/calendar-push-policy";

// Signal to <Icon /> that <IconSpriteDefs /> is rendered at the end of <body>.
Astro.locals.hasIconSprite = true;

// Feature flags — read from settings DB (SSR)
const persistenceDb = getPersistenceClient();
const [featureFlags, aiAssistDisabled, calendarPushPolicy, hasActivePlugins] = await Promise.all([
  getFeatureFlags(),
  Promise.resolve()
    .then(() => readCachedAiAssistDisabled(persistenceDb))
    .catch(() => false),
  Promise.resolve()
    .then(() => readCachedCalendarPushPolicy(persistenceDb))
    .catch(() => ({
      calendar_manual_push_enabled: undefined,
      calendar_sync_enabled: undefined,
      calendar_sync_mode: undefined,
      calendar_write_back: undefined,
      calendar_sync_interval_ms: undefined,
    })),
  Promise.resolve()
    .then(() => readCachedHasActivePlugins(persistenceDb, () => getPluginService().hasActivePlugins()))
    .catch(() => false),
]);
const calendarManualPushVisible = shouldShowManualCalendarPush(calendarPushPolicy);
const organizationState = await readRequestOrganizationLabels(Astro)
const organizationUser = verifiedIngressUser(Astro.locals)
const workspaceScope = organizationUser
  ? createHash("sha256").update("meitheal-workspace\0").update(organizationUser.id).digest("hex")
  : !Astro.locals.behindIngress && !Astro.locals.agentToken ? "browser" : undefined
const dashboardEntry = Astro.url.pathname === "/"
const workspaceReaderSource = parseWorkspacePreferences.toString()
const organizationSettings = Astro.url.pathname === "/settings"
const organizationProof = organizationUser && organizationState &&
  (organizationSettings || Object.keys(organizationState.forms).length > 0 || organizationNeedsVerification()) ? renderedLabelsProof(organizationUser.id, locale, organizationState, organizationSettings) : null
if (organizationProof || organizationUser) Astro.response.headers.set("Cache-Control", "private, no-store")
const featureFlagsJson = JSON.stringify(featureFlags);
const showConfetti = !!featureFlags.confetti;
const showPomodoro = !!featureFlags.pomodoro;

const {
  timezone = "Europe/Dublin",
  weekStart = "monday",
  dateFormat = "relative",
  ingressPath,
  behindIngress = false,
} = Astro.locals;

export interface Props {
  workNavigation?: {
    scope: BoardScope
    placement?: Extract<Awaited<ReturnType<typeof readBoardPagePlacement>>, { ok: true }>
    dailyStreak?: number
  }
  boardContext?: { boardId: string; session: string; boardName?: string; actorKey?: string };
  scopeGuard?: boolean;
  title?: string;
  description?: string;
  hideSearchHub?: boolean;
  hideGlobalSearch?: boolean;
  suppressTaskUrlOpen?: boolean;
  privatePageShell?: boolean;
  suppressHouseholdTaskModals?: boolean;
  /** Optional JSON-LD schema for page-level structured data */
  jsonLd?: Record<string, unknown>;
  /** Optional custom manifest path (e.g. per-task-type installable PWA shortcut) */
  manifestHref?: string;
}

const {
  title = "Meitheal",
  description = "Keep track of the work your home needs — household tasks, recurring routines, and projects inside Home Assistant.",
  hideSearchHub = false,
  hideGlobalSearch = false,
  suppressTaskUrlOpen = false,
  privatePageShell = false,
  suppressHouseholdTaskModals = false,
  jsonLd,
  manifestHref = "/manifest.webmanifest",
} = Astro.props;

const workNavigation = Astro.props.workNavigation
let boardContext = Astro.props.boardContext
let layoutAuthority: string | undefined
let layoutTaskCreate: boolean | undefined
let layoutTaskActions: ReturnType<typeof taskActionHints> | undefined
let mobilePlacement: Awaited<ReturnType<typeof readBoardPagePlacement>> | undefined
if (!privatePageShell) {
  const boardMatch = /^\/boards\/([^/]+)\/?$/.exec(Astro.url.pathname)
  const recordMatch = /^\/(areas|projects|goals|task|tickets)\/([^/]+)\/?$/.exec(Astro.url.pathname)
  const resources = { areas: "area", projects: "project", goals: "goal", task: "task", tickets: "task" } as const
  const result = workNavigation ? { ok: true as const, scope: workNavigation.scope } : await resolveBoardRequestScope(Astro, {
    operation: { resource: "task", action: "read" },
    ...(boardContext?.boardId || boardMatch ? { boardId: boardContext?.boardId ?? decodeURIComponent(boardMatch![1]!) } : {}),
    ...(recordMatch ? { record: { resource: resources[recordMatch[1] as keyof typeof resources], id: decodeURIComponent(recordMatch[2]!) } } : {}),
  }).catch(() => null)
  if (result?.ok) {
    retainBoardResponseScope(Astro.request, result.scope)
    mobilePlacement = workNavigation?.placement ?? await readBoardPagePlacement(result.scope, Astro.url)
    layoutAuthority = boardScopeAuthorityKey(result.scope)
    layoutTaskCreate = scopePermits(result.scope, { resource: "task", action: "create" })
    layoutTaskActions = taskActionHints(result.scope)
    const installationId = await readCachedWorkInstallationId(getPersistenceClient())
    const actorKey = installationId
      ? createHash("sha256").update(JSON.stringify(["offline-v1", installationId, result.scope.principal.kind, result.scope.principal.id])).digest("hex") : undefined
    boardContext = { boardId: result.scope.boardId, session: boardSessionProof(result.scope.principal.id),
      boardName: scopeBoardAccess(result.scope).name, ...(actorKey ? { actorKey } : {}),
    }
  }
}

const mobileBoardContext = boardContext && mobilePlacement?.ok
  ? { boardId: boardContext.boardId, area: mobilePlacement.area?.id, project: mobilePlacement.project?.id }
  : boardContext && !readBoardNavigationContext(Astro.url) ? { boardId: boardContext.boardId } : undefined
const mobileLinks = mobileBoardContext ? boardNavigationLinks(mobileBoardContext) : undefined
const mobileTaskHref = mobileLinks?.tasks ?? "/boards"
const mobileCalendar = taskViewUrl(new URL(mobileTaskHref, Astro.url), "calendar", true)
const mobileCalendarHref = mobileCalendar.pathname + mobileCalendar.search + mobileCalendar.hash

const protectWorkMain = Astro.props.scopeGuard !== false && Boolean(boardContext && layoutAuthority) && /^\/(?:$|boards\/|tasks|today|upcoming|planning|progress|habits|areas|projects|task\/|deferred|inactivity|triage|eisenhower|review|activity|pinned|mention-inbox|gamification)/.test(Astro.url.pathname)

const availabilityMask = (
  ["organizer", "groups", "projects", "planning", "goals", "pillars", "principles", "routines", "achievements", "home_assistant_area"] as const
).map(feature => (isOrganizationFeatureAvailable(feature) ? "1" : "0")).join("")
const orgLabelsKey = organizationState ? `${organizationState.revision}:${JSON.stringify(organizationState.forms)}` : ""
const persistenceClient = !privatePageShell ? getPersistenceClient() : null
const [hasBoardPrincipal, haAreaRev, taskDetailLayoutRaw, sidebarProfile, namedShortcuts] = await Promise.all([
  persistenceClient ? verifiedBoardRequestPrincipal(Astro).then(Boolean).catch(() => false) : Promise.resolve(false),
  persistenceClient && organizationUser ? homeAssistantAreaAccess(Astro).then(v => v ?? "").catch(() => "") : Promise.resolve(""),
  persistenceClient && !suppressHouseholdTaskModals ? readCachedTaskDetailLayout(persistenceClient).catch(() => null) : Promise.resolve(null),
  persistenceClient && workNavigation && (workNavigation.dailyStreak !== undefined || featureFlags.gamification === false)
    ? readCachedSidebarAndProfile(persistenceClient).catch(() => null)
    : Promise.resolve(null),
  persistenceClient && workNavigation && (workNavigation.dailyStreak !== undefined || featureFlags.gamification === false) && featureFlags.hierarchy !== false && featureFlags.organizer !== false
    ? currentBoardContext(Astro).then(Boolean).catch(() => false)
    : Promise.resolve(false),
])
const bottomChromeCacheKey = JSON.stringify([
  "bottom-v2",
  Astro.routePattern,
  privatePageShell,
  suppressHouseholdTaskModals,
  suppressTaskUrlOpen,
  hideSearchHub,
  locale,
  boardContext?.boardId ?? "",
  hasBoardPrincipal,
  organizationUser?.id ?? "",
  orgLabelsKey,
  featureFlagsJson,
  availabilityMask,
  haAreaRev,
  taskDetailLayoutRaw ?? "",
])
const urlNavCtx = readBoardNavigationContext(Astro.url)
const localsRecord = Astro.locals as unknown as Record<string, unknown>
const sidebarCacheKey =
  !privatePageShell &&
  workNavigation &&
  (workNavigation.dailyStreak !== undefined || featureFlags.gamification === false) &&
  sidebarProfile
    ? JSON.stringify([
        "sidebar-v1",
        Astro.url.pathname,
        urlNavCtx ?? null,
        workNavigation.scope.boardId,
        Boolean(layoutTaskCreate),
        workNavigation.dailyStreak ?? 0,
        locale,
        featureFlagsJson,
        organizationUser?.id ?? "",
        orgLabelsKey,
        availabilityMask,
        namedShortcuts,
        sidebarProfile.cacheKey,
        Astro.locals.hassUserId ?? "",
        localsRecord.hassDisplayName ?? "",
        localsRecord.hassUserName ?? "",
        Boolean(Astro.locals.hassIsAdmin),
      ])
    : null

const headCacheKey = JSON.stringify([
  "head-v2",
  title,
  description,
  behindIngress,
  locale,
  timezone,
  weekStart,
  dateFormat,
  manifestHref,
])

// Security headers are set by middleware.ts — no duplicates here.
// IMPORTANT: Do NOT set Strict-Transport-Security or upgrade-insecure-requests
// in HA ingress environments — the addon serves HTTP internally.
Astro.response.headers.set("X-Content-Type-Options", "nosniff");
---

<!doctype html>
<html lang={locale} dir="ltr" data-workspace-scope={workspaceScope} data-custom-theme-admin={canManageSystemSettings(Astro.request, Astro.locals) ? "" : undefined} data-plugins-active={hasActivePlugins ? "1" : undefined} data-ai-assist-disabled={aiAssistDisabled ? "" : undefined}>
  <head>
    {boardContext && <><meta name="meitheal-work-board" content={boardContext.boardId} /><meta name="meitheal-work-session" content={boardContext.session} /><meta name="meitheal-work-actor" content={boardContext.actorKey} /><meta name="meitheal-work-board-name" content={boardContext.boardName} />{layoutTaskCreate !== undefined && <meta name="meitheal-task-create" content={String(layoutTaskCreate)} />}{layoutTaskActions && <meta name="meitheal-task-actions" content={JSON.stringify(layoutTaskActions)} />}</>}
    <CachedHtmlSlot cacheKey={headCacheKey} asBytes={true}>
    <!-- Scroll-lock guard: prevent external tools from locking body scroll (P0) -->
    <script is:inline>
      (function () {
        // Meitheal modals that legitimately lock scroll
        function isRealModalOpen() {
          var overlay = document.getElementById("task-detail-overlay");
          if (
            overlay &&
            overlay.classList.contains("active") &&
            !document.body.classList.contains("has-docked-inspector")
          )
            return true;
          if (
            document.querySelector(
              'dialog[open], #new-task-overlay.active, #meitheal-confirm-overlay, #meitheal-prompt-overlay, #search-hub-overlay:not(.hidden), #shortcut-modal:not(.hidden), #ask-ha-overlay.active, #ask-ha-overlay:not(.modal-overlay):not(.hidden), .habit-modal-overlay:not(.hidden), [data-meitheal-tabler-modal].show',
            )
          )
            return true;
          // Mobile sidebar open is legitimate
          if (document.body.classList.contains("sidebar-open") && window.innerWidth <= 768) return true;
          return false;
        }
        // MutationObserver: undo external overflow:hidden on body when no modal is open
        var observer = new MutationObserver(function (mutations) {
          for (var i = 0; i < mutations.length; i++) {
            var m = mutations[i];
            if (m.attributeName === "style" || m.attributeName === "class") {
              var body = document.body;
              var hasHidden = body.style.overflow === "hidden" || body.classList.contains("antigravity-scroll-lock");
              if (hasHidden && !isRealModalOpen()) {
                body.style.overflow = "";
                body.classList.remove("antigravity-scroll-lock");
                // P0-2: Reset position/touch-action if leaked from sidebar-open
                if (body.style.position === "fixed") body.style.position = "";
                if (body.style.touchAction === "none") body.style.touchAction = "";
              }
            }
          }
        });
        // Start observing once body exists
        if (document.body) {
          observer.observe(document.body, { attributes: true, attributeFilter: ["style", "class"] });
        } else {
          document.addEventListener("DOMContentLoaded", function () {
            observer.observe(document.body, { attributes: true, attributeFilter: ["style", "class"] });
          });
        }
      })();
    </script>
    <!-- Ingress-aware fetch: prefix /api/ paths with HA ingress path -->
    <script is:inline>
      (function () {
        var ip = window.__ingress_path;
        var _f = window.fetch.bind(window);
        var wrappedFetch = function (input, init) {
          // Ensure ingress session cookie is always sent
          if (!init) init = {};
          if (ip) {
            if (!init.credentials) init.credentials = "include";
            if (typeof input === "string" && input.startsWith("/")) {
              // Guard: don't prefix if URL already contains the ingress path
              if (!input.startsWith(ip + "/") && input !== ip) {
                input = ip + input;
              }
            } else if (input instanceof Request && input.url) {
              var u = new URL(input.url);
              if (u.pathname.startsWith("/") && u.origin === location.origin) {
                // Guard: don't prefix if path already contains the ingress path
                if (!u.pathname.startsWith(ip + "/") && u.pathname !== ip) {
                  input = new Request(ip + u.pathname + u.search, input);
                }
              }
            }
          }
          return _f(input, init).then(function (response) {
            // Supervisor can return 403 for a stale ingress session. Keep the
            // current page and form state when Meitheal denies an operation.
            var resultUrl = response.url && new URL(response.url);
            var ingressResponse = ip && resultUrl && resultUrl.origin === location.origin
              && resultUrl.pathname.startsWith(ip + "/");
            var appResponse = response.headers.has("x-ingress-path")
              || /\bjson\b/i.test(response.headers.get("content-type") || "");
            var privateTaskResponse = ingressResponse &&
              [ip + "/api/task-pins", ip + "/api/task-drafts", ip + "/api/task-inactivity"].includes(resultUrl.pathname);
            var participantResponse = ingressResponse &&
              /^\/api\/tasks\/(?:reaction-counts|[^/]+\/(?:comments(?:\/[^/]+(?:\/reactions(?:\/[^/]+)?)?)?|reactions(?:\/[^/]+)?))$/
                .test(resultUrl.pathname.slice(ip.length));
            if ((response.status === 401 || response.status === 403) && ingressResponse && !appResponse && !privateTaskResponse && !participantResponse) {
              var reloadKey = "meitheal-ingress-reload";
              var lastReload = sessionStorage.getItem(reloadKey);
              var now = Date.now();
              var isStandalone = Boolean(
                window.matchMedia?.("(display-mode: standalone)").matches ||
                window.navigator.standalone
              );
              // Try one silent Supervisor validate_session refresh before prompting or reloading
              if (!isStandalone && (!lastReload || now - Number(lastReload) > 30000)) {
                sessionStorage.setItem(reloadKey, String(now));
                var sessionMsg = window.mI18n?.get("toast.session_expired")
                if (!sessionMsg || sessionMsg === "toast.session_expired") sessionMsg = "Home Assistant session expired. Refreshing…"
                enqueueToast({ id: "ingress-session-expired", message: sessionMsg, type: "warning", icon: "refresh", duration: 2500 })
                _f(location.origin + "/api/hassio/ingress/validate_session", { method: "POST", credentials: "include" })
                  .then(function (r) {
                    if (r.ok) window.location.reload();
                    else window.dispatchEvent(new CustomEvent("meitheal:ingress-session-expired"));
                  })
                  .catch(function () {
                    window.dispatchEvent(new CustomEvent("meitheal:ingress-session-expired"));
                  });
              } else {
                // In standalone PWA mode (or if reload already attempted), avoid dead-ending on "You don't have access"
                window.dispatchEvent(new CustomEvent("meitheal:ingress-session-expired"));
              }
            }
            if (response.status === 409) {
              var headers = new Headers(init?.headers ?? (input instanceof Request ? input.headers : undefined))
              if (headers.get("X-Meitheal-Local-Conflict") !== "1") {
                response.clone().json().then(function (body) {
                  if (body?.errorCode === "TASK_VERSION_CONFLICT") {
                    var message = window.mI18n?.get("common.task_version_conflict")
                    if (!message || message === "common.task_version_conflict") {
                      message = "This task changed in another session. Reload to see the latest version."
                    }
                    if (!enqueueToast({ id: "task-version-conflict", message: message, type: "warning", duration: 6000 })) {
                      var live = document.getElementById("sync-announcer")
                      if (live) live.textContent = message
                    }
                    return
                  }
                  var detail = typeof body?.detail === "string" ? body.detail : (typeof body?.error === "string" ? body.error : "")
                  if (/work access changed/i.test(detail)) {
                    window.dispatchEvent(new CustomEvent("meitheal:work-access-stale"))
                  }
                }).catch(function () {})
              }
            }
            return response;
          });
        };
        try {
          Object.defineProperty(window, "fetch", {
            value: wrappedFetch,
            writable: true,
            configurable: true,
            enumerable: true,
          });
        } catch (e) {
          try {
            window.fetch = wrappedFetch;
          } catch (_) {}
        }
        function enqueueToast(payload) {
          if (typeof window.__meithealToast === "function") {
            window.__meithealToast(payload)
            return true
          }
          var queue = window.__meithealToastQueue || (window.__meithealToastQueue = [])
          queue.push(payload)
          return false
        }
      })();
    </script>

    <!-- Ingress state persistence: restore last route only on initial cold/standalone boot -->
    <!-- Runs pre-paint so the user never sees a flash of the wrong page -->
    <script is:inline set:html={`window.__meithealReadPanelRoute = ${readIngressPanelRoute.toString()};`} />
    <script is:inline>
      (function () {
        if (!window.__ingress_path) return;
        var prefix = String(window.__ingress_path).replace(/\/+$/, "");
        if (!prefix || !prefix.startsWith("/") || prefix.startsWith("//") || prefix.includes("\\")) return;
        var pathname = window.location.pathname;
        var current =
          pathname === prefix
            ? "/"
            : pathname.startsWith(prefix + "/")
              ? pathname.slice(prefix.length).replace(/^\/+/, "/")
              : pathname;
        if (current !== "/" || location.search || location.hash ||
          performance.getEntriesByType("navigation").some(entry => entry.type === "back_forward")) return;
        if (window.__meithealReadPanelRoute()) return;
        var scope = document.documentElement.dataset.workspaceScope;
        if (!scope) return;
        var stateKey = "meitheal-navigation-state:" + scope;
        var scrollKey = "meitheal-restore-scroll:" + scope;
        try {
          var explicitHomeNavigation = false;
          if (document.referrer) {
            try {
              var refUrl = new URL(document.referrer);
              if (refUrl.origin === window.location.origin && refUrl.pathname.startsWith(prefix + "/")) {
                explicitHomeNavigation = true;
              }
            } catch {}
          }
          if (explicitHomeNavigation) {
            sessionStorage.setItem(
              stateKey,
              JSON.stringify({ path: "/", scrollY: 0, timestamp: Date.now() }),
            );
            return;
          }
          var raw = sessionStorage.getItem(stateKey);
          if (!raw) return;
          var state = JSON.parse(raw);
          if (
            typeof state.path !== "string" ||
            typeof state.timestamp !== "number"
          )
            return;
          // Restore saved route within 4 hours so standalone PWAs resume smoothly
          if (Date.now() - state.timestamp > 14400000) {
            sessionStorage.removeItem(stateKey);
            return;
          }
          var cleanPath =
            state.path === prefix
              ? "/"
              : state.path.startsWith(prefix + "/")
                ? state.path.slice(prefix.length) || "/"
                : state.path;
          if (!cleanPath.startsWith("/")) cleanPath = "/" + cleanPath;
          // Don't redirect to root (no-op) or unsafe/scheme-relative paths
          if (cleanPath === "/" || cleanPath.startsWith("//") || cleanPath.includes("\\")) return;
          // Redirect to saved path — prepend ingress prefix without double-prefixing
          var resolvedTarget = new URL(prefix + cleanPath, window.location.origin);
          if (resolvedTarget.origin !== window.location.origin) return;
          // Save scroll position to restore after redirect
          if (state.scrollY) {
            sessionStorage.setItem(
              scrollKey,
              String(state.scrollY),
            );
          }
          document.documentElement.dataset.workspaceRestoring = "true";
          window.location.replace(resolvedTarget.pathname + resolvedTarget.search + resolvedTarget.hash);
        } catch (e) {
          // sessionStorage unavailable or parse error — silently continue
        }
      })();
    </script>

    <meta name="theme-color" content="#10231b" />
    <!-- Restore appearance before a full load or an Astro document swap. -->
    <script is:inline set:html={`window.__meithealApplyAccent = ${applyPersonalAccent.toString()};
      window.__meithealReadHATheme = ${readHAThemePalette.toString()};
      window.__meithealApplyHATheme = ${applyHAThemePalette.toString()};`} />
    <script is:inline set:html={`window.__meithealParseWorkspace = ${workspaceReaderSource};`} />
    <script is:inline define:vars={{ APPEARANCE_PREFERENCES, APPEARANCE_STORAGE_KEY, HA_THEME_MATCH_KEY, LIGHT_THEME_MODES, THEME_META_COLORS, THEME_MODES, WORKSPACE_PREFERENCES_PREFIX }}>
      (function () {
        function restoreAppearance(doc) {
          function stored(key) {
            try { return localStorage.getItem(key); } catch { return null; }
          }
          var root = doc.documentElement;
          var scope = root.dataset.workspaceScope;
          var prefersDark = matchMedia("(prefers-color-scheme: dark)").matches;
          var autoResolved = prefersDark ? "knight-rider" : "light";
          var workspacePrefs = scope ? window.__meithealParseWorkspace(stored(WORKSPACE_PREFERENCES_PREFIX + scope)) : null;
          var preferred = workspacePrefs ? workspacePrefs.theme : null;
          if (workspacePrefs && !workspacePrefs.acknowledged) {
            var ip = window.__ingress_path || "";
            var p = location.pathname;
            if (ip && p.startsWith(ip)) p = p.slice(ip.length) || "/";
            if (p === "/" && (!location.search || location.search === "?view=dashboard") && !location.hash) {
              root.dataset.showSetupInvite = "true";
            } else {
              delete root.dataset.showSetupInvite;
            }
          } else {
            delete root.dataset.showSetupInvite;
          }
          var theme = preferred === "auto" ? autoResolved : preferred || stored("meitheal-theme");
          var resolvedAttr = theme === "custom" ? "dark" : (!theme || theme === "auto" || !THEME_MODES.includes(theme)) ? autoResolved : theme;
          var inheritsIngress = window.__ingress_path && !preferred && (!theme || theme === "auto" || !THEME_MODES.includes(theme));
          root.dataset.theme = inheritsIngress ? "auto" : resolvedAttr;
          var isLight = LIGHT_THEME_MODES.includes(resolvedAttr);
          root.classList.toggle("light", isLight);
          root.classList.toggle("dark", !isLight);
          var metaColor = THEME_META_COLORS[resolvedAttr] || (isLight ? "#f5faf7" : "#131314");
          doc.querySelector('meta[name="theme-color"]')?.setAttribute("content", metaColor);
          var appearance;
          try {
            appearance = JSON.parse(stored(APPEARANCE_STORAGE_KEY) ?? "{}");
          } catch { /* Invalid browser preferences fall back to their defaults. */ }
          for (var [name, preference] of Object.entries(APPEARANCE_PREFERENCES)) {
            var value = appearance?.[name];
            root.setAttribute("data-appearance-" + name.replace(/[A-Z]/g, function (letter) { return "-" + letter.toLowerCase(); }), preference.options.includes(value) ? value : preference.defaultValue);
          }
          var accent = stored("meitheal-accent-color");
          window.__meithealApplyAccent(root, accent);
          var sidebarW = Number.parseInt(stored("meitheal:task-sidebar-width:v1") || "", 10);
          if (Number.isFinite(sidebarW) && sidebarW >= 360) {
            var maxW = Math.max(360, Math.min(840, innerWidth - 360));
            root.style.setProperty("--task-inspector-width", Math.min(maxW, sidebarW) + "px");
          }
          if (stored("meitheal:hide-ask-ai:v1") === "1") root.setAttribute("data-hide-ask-ai", "");
          else root.removeAttribute("data-hide-ask-ai");
          var match = window.__meithealReadHATheme(stored(HA_THEME_MATCH_KEY) === "1", Boolean(window.__ingress_path));
          window.__meithealApplyHATheme(root, match, accent, window.__meithealApplyAccent);
          if (match.state === "active") {
            root.classList.toggle("dark", match.palette.scheme === "dark");
            root.classList.toggle("light", match.palette.scheme === "light");
            doc.querySelector('meta[name="theme-color"]')?.setAttribute("content", match.palette.tokens["--bg-primary"]);
          }
          if (doc.body) {
            var desktopSidebar = innerWidth > 768 && root.dataset.appearanceNavigation !== "navbar";
            var sidebarMode = root.dataset.appearanceSidebar;
            var rememberedSidebar = stored("meitheal_sidebar_collapsed");
