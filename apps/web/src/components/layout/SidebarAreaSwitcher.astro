---
import { t } from "../../i18n/translations";
import type { Locale } from "../../lib/locale";
import Icon from "../ui/Icon.astro";

export interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
---

<div
  class="area-switcher"
  id="area-switcher"
  role="region"
  aria-label="Area selector"
  data-i18n-all-areas={t("sidebar.all_areas", locale)}
  data-i18n-prompt={t("sidebar.prompt_area_name", locale)}
>
  <div class="area-switcher-label">{t("sidebar.area", locale)}</div>
  <div class="relative w-full">
    <select
      class="area-select appearance-none w-full bg-bg-primary border border-border rounded-md py-2 pl-3 pr-8 text-sm focus:outline-none focus:ring-2 focus:ring-accent"
      id="area-select"
      aria-label="Select active area"
    >
      <option value="default">📋 {t("sidebar.default_board", locale)}</option>
    </select>
    <div
      class="pointer-events-none absolute inset-y-0 right-0 flex items-center px-2 text-text-muted"
    >
      <Icon name="chevron-down" size={16} />
    </div>
  </div>
  <button
    class="area-add-btn mt-2 w-full bg-bg-primary hover:bg-bg-hover border border-border rounded-md py-1.5 text-sm font-medium transition-colors flex items-center justify-center gap-2"
    id="add-area-btn"
    title={t("sidebar.new_area", locale)}
    aria-label={t("sidebar.new_area", locale)}
  >
    <Icon name="plus" size={16} />
    {t("sidebar.new_area", locale)}
  </button>
</div>

<style>
  .area-switcher {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    padding: 0.75rem;
    background: rgba(var(--bg-primary-rgb), 0.5);
    border-radius: var(--radius-md, 10px);
    border: 1px solid rgba(var(--border-rgb), 0.5);
    margin-top: auto;
    margin-bottom: 1rem;
  }

  .area-switcher-label {
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    font-weight: 600;
    color: var(--text-muted);
  }
</style>

<script>
  // Area Switcher
  (async function initAreaSwitcher() {
    const select = document.getElementById(
      "area-select",
    ) as HTMLSelectElement | null;
    const addBtn = document.getElementById("add-area-btn");
    if (!select) return;

    // Load boards from API
    try {
      const res = await fetch((window.__ingress_path || "") + "/api/areas");
      if (res.ok) {
        const data = await res.json();
        const boards = data.boards ?? [];
        select.innerHTML = "";
        // "All Areas" option first
        const allOpt = document.createElement("option");
        allOpt.value = "all";
        const switcher = document.getElementById("area-switcher");
        const allAreasText = switcher?.dataset.i18nAllAreas || "All Areas";
        
        allOpt.textContent = `🗂 ${allAreasText}`;
        select.appendChild(allOpt);
        boards.forEach((b: { id: string; title: string; icon: string }) => {
          const opt = document.createElement("option");
          opt.value = b.id;
          opt.textContent = `${b.icon} ${b.title}`;
          select.appendChild(opt);
        });
      }
    } catch {
      /* fallback to default option */
    }

    // Restore active board from localStorage
    const saved = localStorage.getItem("meitheal_active_area") ?? "all";
    if (select.querySelector(`option[value="${saved}"]`)) {
      select.value = saved;
    }

    // Expose active board globally for page scripts
    window.__activeArea = select.value;

    // Apply board filter to visible items
    function applyAreaFilter() {
      const area = select!.value;
      window.__activeArea = area;
      // Filter task items (tasks page)
      document.querySelectorAll(".task-item[data-area]").forEach((el) => {
        const item = el as HTMLElement;
        item.style.display =
          area === "all" || item.dataset.area === area ? "" : "none";
      });
      // Filter kanban cards
      document.querySelectorAll(".kanban-card[data-area]").forEach((el) => {
        const card = el as HTMLElement;
        card.style.display =
          area === "all" || card.dataset.area === area ? "" : "none";
      });
      // Filter table rows
      document
        .querySelectorAll("#task-table tbody tr[data-area]")
        .forEach((el) => {
          const row = el as HTMLElement;
          row.style.display =
            area === "all" || row.dataset.area === area ? "" : "none";
        });
    }

    // Apply on load
    applyAreaFilter();

    // Switch board → save + filter
    select.addEventListener("change", () => {
      localStorage.setItem("meitheal_active_area", select.value);
      applyAreaFilter();
    });

    // Add new board
    addBtn?.addEventListener("click", async () => {
      const switcher = document.getElementById("area-switcher");
      const promptText = switcher?.dataset.i18nPrompt || "Area name:";
      const title = prompt(promptText);
      if (!title?.trim()) return;
      try {
        const res = await fetch((window.__ingress_path || "") + "/api/areas", {
          method: "POST",
          headers: { "content-type": "application/json" },
          body: JSON.stringify({ title: title.trim() }),
        });
        if (res.ok) {
          const area = await res.json();
          localStorage.setItem("meitheal_active_area", area.id);
          document.dispatchEvent(new CustomEvent("meitheal:navigation-changed", { detail: { action: "area-switch" } }));
        }
      } catch {
        /* ignore */
      }
    });
  })();
</script>
