---
import { t } from "../../i18n/translations";
import type { Locale } from "../../lib/locale";
import Icon from "../ui/Icon.astro";

export interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
---

<div
  class="area-switcher"
  id="area-switcher"
  role="region"
  aria-label="Area selector"
  data-i18n-all-areas={t("sidebar.all_areas", locale)}
  data-i18n-prompt={t("sidebar.prompt_area_name", locale)}
>
  <div class="area-switcher-label">{t("sidebar.area", locale)}</div>
  <div class="relative w-full">
    <select
      class="area-select appearance-none w-full bg-bg-primary border border-border rounded-md py-2 pl-3 pr-8 text-sm focus:outline-none focus:ring-2 focus:ring-accent"
      id="area-select"
      aria-label="Select active area"
    >
      <option value="default">📋 {t("sidebar.default_board", locale)}</option>
    </select>
    <div
      class="pointer-events-none absolute inset-y-0 right-0 flex items-center px-2 text-text-muted"
    >
      <Icon name="chevron-down" size={16} />
    </div>
  </div>
  <button
    class="area-add-btn mt-2 w-full bg-bg-primary hover:bg-bg-hover border border-border rounded-md py-1.5 text-sm font-medium transition-colors flex items-center justify-center gap-2"
    id="add-area-btn"
    title={t("sidebar.new_area", locale)}
    aria-label={t("sidebar.new_area", locale)}
  >
    <Icon name="plus" size={16} />
    {t("sidebar.new_area", locale)}
  </button>
  <!-- Custom New Area Dialog -->
  <dialog id="new-area-dialog" class="bg-bg-primary border border-border rounded-lg shadow-xl p-0 w-[90%] max-w-sm backdrop:bg-black/50 backdrop:backdrop-blur-sm" aria-labelledby="new-area-title">
    <form id="new-area-form" class="flex flex-col m-0">
      <div class="px-5 py-4 border-b border-border/50">
        <h3 id="new-area-title" class="text-lg font-semibold text-text-primary m-0">{t("sidebar.new_area", locale)}</h3>
      </div>
      <div class="p-5">
        <label for="new-area-input" class="block text-sm font-medium text-text-secondary mb-2">{t("sidebar.prompt_area_name", locale)}</label>
        <input 
          type="text" 
          id="new-area-input" 
          name="area_name" 
          class="w-full bg-bg-secondary border border-border rounded-md px-3 py-2 text-text-primary focus:outline-none focus:ring-2 focus:ring-accent"
          autocomplete="off"
          required
        />
      </div>
      <div class="px-5 py-3 border-t border-border/50 bg-bg-secondary/30 flex justify-end gap-3 rounded-b-lg">
        <button 
          type="button" 
          id="new-area-cancel" 
          class="px-4 py-2 text-sm font-medium text-text-secondary hover:text-text-primary transition-colors cursor-pointer"
        >
          {t("common.cancel", locale)}
        </button>
        <button 
          type="submit" 
          class="px-4 py-2 text-sm font-medium bg-accent text-white rounded-md hover:bg-accent/90 transition-colors cursor-pointer"
        >
          {t("common.save", locale)}
        </button>
      </div>
    </form>
  </dialog>
</div>

<style>
  .area-switcher {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    padding: 0.75rem;
    background: rgba(var(--bg-primary-rgb), 0.5);
    border-radius: var(--radius-md, 10px);
    border: 1px solid rgba(var(--border-rgb), 0.5);
    margin-top: auto;
    margin-bottom: 1rem;
  }

  .area-switcher-label {
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    font-weight: 600;
    color: var(--text-muted);
  }
  
  /* Reset dialog max-width and margin for centering */
  #new-area-dialog {
    margin: auto;
  }
  #new-area-dialog::backdrop {
    background: rgba(0, 0, 0, 0.5);
    backdrop-filter: blur(2px);
  }
</style>

<script>
  // Area Switcher
  (async function initAreaSwitcher() {
    const select = document.getElementById(
      "area-select",
    ) as HTMLSelectElement | null;
    const addBtn = document.getElementById("add-area-btn");
    const dialog = document.getElementById("new-area-dialog") as HTMLDialogElement | null;
    const form = document.getElementById("new-area-form") as HTMLFormElement | null;
    const input = document.getElementById("new-area-input") as HTMLInputElement | null;
    const cancelBtn = document.getElementById("new-area-cancel");

    if (!select) return;

    // Load boards from API
    try {
      const res = await fetch((window.__ingress_path || "") + "/api/areas");
      if (res.ok) {
        const data = await res.json();
        const boards = data.boards ?? [];
        select.innerHTML = "";
        // "All Areas" option first
        const allOpt = document.createElement("option");
        allOpt.value = "all";
        const switcher = document.getElementById("area-switcher");
        const allAreasText = switcher?.dataset.i18nAllAreas || "All Areas";
        
        allOpt.textContent = `🗂 ${allAreasText}`;
        select.appendChild(allOpt);
        boards.forEach((b: { id: string; title: string; icon: string }) => {
          const opt = document.createElement("option");
          opt.value = b.id;
          opt.textContent = `${b.icon} ${b.title}`;
          select.appendChild(opt);
        });
      }
    } catch {
      /* fallback to default option */
    }

    // Restore active board from localStorage
    const saved = localStorage.getItem("meitheal_active_area") ?? "all";
    if (select.querySelector(`option[value="${saved}"]`)) {
      select.value = saved;
    }

    // Expose active board globally for page scripts
    window.__activeArea = select.value;

    // Apply board filter to visible items
    function applyAreaFilter() {
      const area = select!.value;
      window.__activeArea = area;
      // Filter task items (tasks page)
      document.querySelectorAll(".task-item[data-area]").forEach((el) => {
        const item = el as HTMLElement;
        item.style.display =
          area === "all" || item.dataset.area === area ? "" : "none";
      });
      // Filter kanban cards
      document.querySelectorAll(".kanban-card[data-area]").forEach((el) => {
        const card = el as HTMLElement;
        card.style.display =
          area === "all" || card.dataset.area === area ? "" : "none";
      });
      // Filter table rows
      document
        .querySelectorAll("#task-table tbody tr[data-area]")
        .forEach((el) => {
          const row = el as HTMLElement;
          row.style.display =
            area === "all" || row.dataset.area === area ? "" : "none";
        });
    }

    // Apply on load
    applyAreaFilter();

    // Switch board → save + filter
    select.addEventListener("change", () => {
      localStorage.setItem("meitheal_active_area", select.value);
      applyAreaFilter();
    });

    // Add new board dialog handling
    addBtn?.addEventListener("click", () => {
      if (dialog && input) {
        input.value = "";
        dialog.showModal();
        // Give input focus on next frame
        setTimeout(() => input.focus(), 10);
      }
    });

    cancelBtn?.addEventListener("click", () => {
      dialog?.close();
    });

    form?.addEventListener("submit", async (e) => {
      e.preventDefault();
      if (!input || !dialog) return;

      const title = input.value.trim();
      if (!title) return;

      try {
        const res = await fetch((window.__ingress_path || "") + "/api/areas", {
          method: "POST",
          headers: { "content-type": "application/json" },
          body: JSON.stringify({ title }),
        });
        if (res.ok) {
          const area = await res.json();
          localStorage.setItem("meitheal_active_area", area.id);
          dialog.close();
          document.dispatchEvent(new CustomEvent("meitheal:navigation-changed", { detail: { action: "area-switch" } }));
        }
      } catch {
        /* ignore */
      }
    });
  })();
</script>
