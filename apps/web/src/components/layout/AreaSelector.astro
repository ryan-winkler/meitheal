---
/**
 * AreaSelector — First-class area/space context switcher for the UnifiedBar.
 *
 * Renders as a pill-style dropdown trigger showing the current area (icon + name).
 * Fires `meitheal:area-changed` events on selection, persists choice in localStorage.
 * Individual view FilterToolbar area selects are synced automatically by the controller.
 *
 * @domain cross-cutting (context scoping)
 * @see implementation_plan.md Phase 16.2
 */

export interface AreaOption {
  id: string
  name: string
  icon: string
  color: string
}

interface Props {
  areas: AreaOption[]
}

const { areas = [] } = Astro.props
---

<div class="area-selector" data-area-selector>
  <button
    type="button"
    class="area-selector__trigger"
    id="area-selector-trigger"
    aria-expanded="false"
    aria-haspopup="listbox"
    aria-label="Select area context"
  >
    <span class="area-selector__icon" data-area-icon>🗂</span>
    <span class="area-selector__label" data-area-label>All Areas</span>
    <svg class="area-selector__chevron" width="12" height="12" viewBox="0 0 12 12" fill="none" aria-hidden="true">
      <path d="M3 4.5L6 7.5L9 4.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
    </svg>
  </button>

  <div
    class="area-selector__dropdown"
    id="area-selector-dropdown"
    role="listbox"
    aria-label="Available areas"
  >
    <button
      type="button"
      class="area-selector__option is-selected"
      role="option"
      aria-selected="true"
      data-area-id=""
      data-area-name="All Areas"
      data-area-icon="🗂"
    >
      <span class="area-selector__option-icon" aria-hidden="true">🗂</span>
      <span class="area-selector__option-label">All Areas</span>
      <svg class="area-selector__check" width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true">
        <path d="M3 7L6 10L11 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
      </svg>
    </button>

    {areas.map((area) => (
      <button
        type="button"
        class="area-selector__option"
        role="option"
        aria-selected="false"
        data-area-id={area.id}
        data-area-name={area.name}
        data-area-icon={area.icon}
        data-area-color={area.color}
      >
        <span class="area-selector__option-icon" aria-hidden="true" style={`color: ${area.color}`}>{area.icon}</span>
        <span class="area-selector__option-label">{area.name}</span>
        <svg class="area-selector__check" width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true">
          <path d="M3 7L6 10L11 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
      </button>
    ))}
  </div>
</div>

<style>
  .area-selector {
    position: relative;
    flex-shrink: 0;
  }

  .area-selector__trigger {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 5px 10px;
    border: 1px solid var(--border-subtle, rgba(255, 255, 255, 0.08));
    border-radius: 8px;
    background: var(--surface-card, rgba(255, 255, 255, 0.04));
    color: var(--text-primary, #e4e4e7);
    font-size: 0.8125rem;
    font-weight: 500;
    cursor: pointer;
    transition: background 0.15s ease, border-color 0.15s ease;
    white-space: nowrap;
    line-height: 1.3;
  }

  .area-selector__trigger:hover {
    background: var(--surface-card-hover, rgba(255, 255, 255, 0.08));
    border-color: var(--border-default, rgba(255, 255, 255, 0.12));
  }

  .area-selector__trigger[aria-expanded="true"] {
    background: var(--surface-card-hover, rgba(255, 255, 255, 0.08));
    border-color: var(--accent, #818cf8);
    box-shadow: 0 0 0 1px var(--accent, #818cf8);
  }

  .area-selector__icon {
    font-size: 0.875rem;
    line-height: 1;
  }

  .area-selector__label {
    max-width: 120px;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .area-selector__chevron {
    opacity: 0.5;
    transition: transform 0.15s ease;
    flex-shrink: 0;
  }

  .area-selector__trigger[aria-expanded="true"] .area-selector__chevron {
    transform: rotate(180deg);
    opacity: 0.8;
  }

  /* Dropdown flyout */
  .area-selector__dropdown {
    display: none;
    position: absolute;
    top: calc(100% + 6px);
    left: 0;
    min-width: 200px;
    max-width: 280px;
    max-height: 300px;
    overflow-y: auto;
    background: var(--surface-elevated, #1e1e2e);
    border: 1px solid var(--border-default, rgba(255, 255, 255, 0.1));
    border-radius: 10px;
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.4), 0 2px 8px rgba(0, 0, 0, 0.2);
    padding: 4px;
    z-index: 1000;
    animation: area-dropdown-in 0.15s cubic-bezier(0.4, 0, 0.2, 1);
  }

  .area-selector__dropdown.is-open {
    display: block;
  }

  @keyframes area-dropdown-in {
    from {
      opacity: 0;
      transform: translateY(-4px) scale(0.98);
    }
    to {
      opacity: 1;
      transform: translateY(0) scale(1);
    }
  }

  .area-selector__option {
    display: flex;
    align-items: center;
    gap: 8px;
    width: 100%;
    padding: 8px 10px;
    border: none;
    border-radius: 6px;
    background: transparent;
    color: var(--text-secondary, #a1a1aa);
    font-size: 0.8125rem;
    font-weight: 400;
    cursor: pointer;
    transition: background 0.1s ease, color 0.1s ease;
    text-align: left;
    line-height: 1.3;
  }

  .area-selector__option:hover {
    background: var(--surface-card-hover, rgba(255, 255, 255, 0.06));
    color: var(--text-primary, #e4e4e7);
  }

  .area-selector__option.is-selected {
    color: var(--text-primary, #e4e4e7);
    font-weight: 500;
  }

  .area-selector__option-icon {
    font-size: 0.875rem;
    flex-shrink: 0;
    line-height: 1;
  }

  .area-selector__option-label {
    flex: 1;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .area-selector__check {
    flex-shrink: 0;
    opacity: 0;
    color: var(--accent, #818cf8);
    transition: opacity 0.1s ease;
  }

  .area-selector__option.is-selected .area-selector__check {
    opacity: 1;
  }

  /* Scrollbar */
  .area-selector__dropdown::-webkit-scrollbar {
    width: 4px;
  }

  .area-selector__dropdown::-webkit-scrollbar-thumb {
    background: rgba(255, 255, 255, 0.15);
    border-radius: 2px;
  }
</style>

