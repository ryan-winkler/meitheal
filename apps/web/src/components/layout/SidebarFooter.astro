---
import { t } from "../../i18n/translations";
import type { Locale } from "../../lib/locale";
import Icon from "../ui/Icon.astro";

export interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
---

<div
  class="sidebar-footer mt-auto pt-4 border-t border-border/50 flex flex-col gap-2"
>
  <div
    class="status-indicator text-xs text-text-muted flex items-center gap-2 px-3 pb-2"
    id="connection-status"
    role="status"
    aria-live="polite"
  >
    <span class="status-dot w-2 h-2 rounded-full bg-gray-400" aria-hidden="true"
    ></span>
    <span class="status-text">{t("status.checking", locale)}</span>
  </div>

  <a
    href="/settings"
    data-astro-prefetch="viewport"
    class="nav-link w-full"
    data-page="settings"
    data-tooltip={t("nav.settings", locale)}
    aria-label={t("nav.settings", locale)}
  >
    <span class="nav-icon">
      <Icon name="settings" />
    </span>
    <span class="nav-label">{t("nav.settings", locale)}</span>
  </a>
</div>

<script>
  // Health check is managed by layout-controller.ts (singleton 30s interval, P0-4).
  // Previously this component ran its own duplicate interval — removed in Phase 25 T5.
</script>
