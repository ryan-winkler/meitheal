---
import { t } from "../../i18n/translations";
import type { Locale } from "../../lib/locale";
import Icon from "../ui/Icon.astro";

export interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
---

<div class="sidebar-footer mt-auto">
  <a
    href="/settings"
    data-astro-prefetch="viewport"
    class="nav-link w-full"
    data-page="settings"
    data-tooltip={t("nav.settings", locale)}
    aria-label={t("nav.settings", locale)}
    aria-describedby="connection-status"
  >
    <span class="nav-icon"><Icon name="settings" /></span>
    <span class="nav-label">{t("nav.settings", locale)}</span>
  </a>
  <span
    class="status-indicator sidebar-readiness"
    id="connection-status"
    role="status"
    aria-live="polite"
    data-ready={t("status.app_ready", locale)}
    data-storage-offline={t("status.db_offline", locale)}
    data-unreachable={t("status.app_unreachable", locale)}
  >
    <span class="status-dot w-2 h-2 rounded-full bg-gray-400" aria-hidden="true"></span>
    <span class="status-text sr-only">{t("status.checking", locale)}</span>
  </span>
</div>

<style>
  .sidebar-footer {
    position: relative;
    padding-block: 0.5rem 0;
  }

  .sidebar-readiness {
    display: inline-flex;
    position: absolute;
    inset-inline-end: 12px;
    top: calc(50% + 0.25rem);
    transform: translateY(-50%);
    pointer-events: none;
    flex: none;
  }
</style>

<script>
  // Health check is managed by layout-controller.ts (singleton 30s interval, P0-4).
  // Previously this component ran its own duplicate interval — removed in Phase 25 T5.
</script>
