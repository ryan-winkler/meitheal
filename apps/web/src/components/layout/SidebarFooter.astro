---
import {
  AVATAR_COLOR_PRESETS,
  avatarContrastForeground,
  isThemeAvatarColor,
  profileInitials,
  profileSubtitle,
  type UserProfile,
} from "@domains/auth/user-profile"
import { t } from "../../i18n/translations"
import type { Locale } from "../../lib/locale"
import Icon from "../ui/Icon.astro"
import TablerModal from "../ui/TablerModal.astro"

export interface Props {
  locale: Locale
  profile: UserProfile
  settingsHref?: string
}

const { locale, profile, settingsHref = "/settings" } = Astro.props
const initials = profileInitials(profile)
const subtitle = profileSubtitle(profile)
const avatarIsTheme = isThemeAvatarColor(profile.avatarColor)
const avatarInlineStyle = avatarIsTheme
  ? undefined
  : `background-color: ${profile.avatarColor}; color: ${avatarContrastForeground(profile.avatarColor)};`
const navSettingsHref = `${settingsHref}#navigation-settings`
const lookFeelHref = `${settingsHref}#look-and-feel-settings`
---

<div id="sidebar-footer" class="sidebar-footer mt-auto" data-sidebar-user-footer data-user-profile={JSON.stringify(profile)}>
  <div class="sidebar-footer-row">
    <button
      type="button"
      id="sidebar-user-trigger"
      class="sidebar-user-card"
      aria-haspopup="dialog"
      aria-controls="sidebar-profile-modal"
      data-tooltip={`${profile.displayName} (${subtitle}) — Edit profile`}
    >
      <span
        class="sidebar-user-avatar"
        data-user-profile-avatar
        data-avatar-mode={avatarIsTheme ? "theme" : "custom"}
        style={avatarInlineStyle}
        aria-hidden="true"
      >
        {initials}
      </span>
      <span class="sidebar-user-identity">
        <span class="sidebar-user-name" data-user-profile-name>{profile.displayName}</span>
        <span class="sidebar-user-subtitle" data-user-profile-subtitle>{subtitle}</span>
      </span>
      <span class="sr-only">Edit profile</span>
    </button>

    <button
      type="button"
      id="nav-utility-trigger"
      class="nav-utility-btn"
      aria-haspopup="menu"
      aria-expanded="false"
      aria-controls="nav-utility-popover"
      data-tooltip="Navigation, shortcuts & settings"
      aria-label="Navigation, shortcuts and settings menu"
      title="Navigation, shortcuts & settings"
    >
      <Icon name="keyboard" size={18} />
    </button>
  </div>
</div>

<!-- Global Navigation, Shortcuts & Settings Utility Menu -->
<div
  id="nav-utility-popover"
  class="sidebar-user-popover nav-utility-popover"
  role="menu"
  aria-label="Navigation, shortcuts and settings"
  hidden
>
  <div class="nav-utility-popover__head">
    <span class="nav-utility-popover__title">Navigation &amp; Shortcuts</span>
    <span class="nav-utility-popover__hint">Quick tools</span>
  </div>
  <div class="sidebar-user-popover__divider" role="separator"></div>
  <div class="sidebar-user-popover__actions">
    <button type="button" class="sidebar-user-popover__item" role="menuitem" data-utility-action="edit-menu">
      <span class="sidebar-user-popover__icon" aria-hidden="true"><Icon name="pencil" size={16} /></span>
      <span>{t("sidebar.edit_menu", locale)}</span>
    </button>
    <button type="button" class="sidebar-user-popover__item" role="menuitem" data-utility-action="add-link">
      <span class="sidebar-user-popover__icon" aria-hidden="true"><Icon name="link" size={16} /></span>
      <span>Add custom link</span>
    </button>
    <button type="button" class="sidebar-user-popover__item" role="menuitem" data-utility-action="shortcuts">
      <span class="sidebar-user-popover__icon" aria-hidden="true"><Icon name="keyboard" size={16} /></span>
      <span>Keyboard shortcuts</span>
      <kbd class="nav-utility-kbd" aria-hidden="true">?</kbd>
    </button>
  </div>
  <div class="sidebar-user-popover__divider" role="separator"></div>
  <div class="sidebar-user-popover__actions">
    <a href={settingsHref} class="sidebar-user-popover__item" role="menuitem" data-utility-link>
      <span class="sidebar-user-popover__icon" aria-hidden="true"><Icon name="settings" size={16} /></span>
      <span>{t("nav.settings", locale)}</span>
    </a>
    <a href={navSettingsHref} class="sidebar-user-popover__item" role="menuitem" data-utility-link>
      <span class="sidebar-user-popover__icon" aria-hidden="true"><Icon name="layout-grid" size={16} /></span>
      <span>Manage shortcuts &amp; links</span>
    </a>
    <a href={lookFeelHref} class="sidebar-user-popover__item" role="menuitem" data-utility-link>
      <span class="sidebar-user-popover__icon" aria-hidden="true"><Icon name="palette" size={16} /></span>
      <span>Look &amp; Feel</span>
    </a>
    <button type="button" class="sidebar-user-popover__item" role="menuitem" data-utility-action="start-tour">
      <span class="sidebar-user-popover__icon" aria-hidden="true"><Icon name="sparkles" size={16} /></span>
      <span>Interactive tour</span>
    </button>
  </div>
</div>

<!-- Edit Profile Modal (official Tabler modal surface) -->
<TablerModal
  id="sidebar-profile-modal"
  title={t("sidebar.edit_profile_title", locale)}
  descriptionId="sidebar-profile-modal-desc"
  size="sm"
>
  <p id="sidebar-profile-modal-desc" class="sidebar-profile-modal__subtitle">
    {t("sidebar.edit_profile_subtitle", locale)}
  </p>

  <div class="sidebar-profile-modal__preview">
    <span
      class="sidebar-user-avatar sidebar-user-avatar--preview"
      data-profile-preview-avatar
      data-avatar-mode={avatarIsTheme ? "theme" : "custom"}
      style={avatarInlineStyle}
      aria-hidden="true"
    >
      {initials}
    </span>
    <div class="sidebar-user-identity">
      <span class="sidebar-user-name" data-profile-preview-name>{profile.displayName}</span>
      <span class="sidebar-user-subtitle" data-profile-preview-subtitle>{subtitle}</span>
    </div>
  </div>

  <form id="sidebar-profile-form" class="sidebar-profile-form" autocomplete="off" novalidate>
    <div class="sidebar-profile-field">
      <label for="profile-display-name" class="form-label">{t("sidebar.profile_display_name", locale)}</label>
      <input
        id="profile-display-name"
        name="profileDisplayName"
        type="text"
        class="form-input"
        value={profile.displayName}
        maxlength="60"
        required
        autocomplete="off"
        data-bwignore="true"
        data-1p-ignore="true"
        data-lpignore="true"
        data-form-type="other"
        data-tabler-initial-focus
      />
    </div>

    <div class="sidebar-profile-field">
      <label for="profile-handle" class="form-label">{t("sidebar.profile_username", locale)}</label>
      <input
        id="profile-handle"
        name="profileHandle"
        type="text"
        class="form-input"
        value={profile.username}
        maxlength="40"
        placeholder="winks"
        autocomplete="off"
        autocorrect="off"
        autocapitalize="off"
        spellcheck="false"
        data-bwignore="true"
        data-1p-ignore="true"
        data-lpignore="true"
        data-form-type="other"
      />
    </div>

    <div class="sidebar-profile-field">
      <label for="profile-role" class="form-label">{t("sidebar.profile_role", locale)}</label>
      <input
        id="profile-role"
        name="profileSubtitle"
        type="text"
        class="form-input"
        value={profile.role}
        maxlength="60"
        placeholder="Household Admin (optional)"
        autocomplete="off"
        data-bwignore="true"
        data-1p-ignore="true"
        data-lpignore="true"
        data-form-type="other"
      />
    </div>

    <div class="sidebar-profile-field">
      <span class="form-label">{t("sidebar.profile_avatar_color", locale)}</span>
      <input id="profile-avatar-color" name="profileAvatarColor" type="hidden" value={profile.avatarColor} />
      <div class="sidebar-profile-swatches" role="group" aria-label={t("sidebar.profile_avatar_color", locale)}>
        {AVATAR_COLOR_PRESETS.map(swatch => {
          const isTheme = isThemeAvatarColor(swatch.hex)
          const selected = swatch.hex.toLowerCase() === profile.avatarColor.toLowerCase()
          return (
            <button
              type="button"
              class={`sidebar-profile-swatch${isTheme ? " sidebar-profile-swatch--theme" : ""}${selected ? " is-selected" : ""}`}
              data-avatar-swatch={swatch.hex}
              style={isTheme ? undefined : `background-color: ${swatch.hex};`}
              title={swatch.label}
              aria-label={swatch.label}
              aria-pressed={selected ? "true" : "false"}
            >
              {isTheme && <Icon name="palette" size={14} />}
            </button>
          )
        })}
      </div>
    </div>

    <p class="sidebar-profile-error" data-profile-form-error role="alert" hidden></p>
  </form>

  <Fragment slot="footer">
    <button type="button" class="btn btn-secondary" data-profile-modal-close>Cancel</button>
    <button type="submit" form="sidebar-profile-form" class="btn btn-primary" data-profile-save-btn>
      {t("sidebar.profile_save", locale)}
    </button>
  </Fragment>
</TablerModal>

<style is:inline>
  .sidebar-footer {
    position: relative;
    z-index: 2;
    padding: 0.625rem 0 0;
    margin-top: 0.375rem;
    border-top: 1px solid var(--border);
    display: flex;
    flex-direction: column;
    flex-shrink: 0;
  }

  .sidebar-footer-row {
    display: flex;
    align-items: center;
    gap: 0.375rem;
    min-inline-size: 0;
  }

  .sidebar-user-card {
    display: flex;
    align-items: center;
    gap: 0.625rem;
    flex: 1 1 auto;
    min-inline-size: 0;
    padding: 0.4rem 0.5rem;
    border: 1px solid var(--border);
    border-radius: var(--radius-md, 10px);
    background: var(--bg-card);
    color: var(--text-primary);
    text-align: left;
    cursor: pointer;
    transition: background-color 150ms cubic-bezier(0.23, 1, 0.32, 1), border-color 150ms cubic-bezier(0.23, 1, 0.32, 1), transform 120ms cubic-bezier(0.23, 1, 0.32, 1);
  }

  .sidebar-user-card:hover,
  .sidebar-user-card:focus-visible {
    background: var(--bg-hover);
    border-color: rgb(var(--accent-rgb) / 0.45);
  }

  .sidebar-user-card:active {
    transform: scale(0.98);
  }

  .sidebar-user-card:focus-visible,
  .nav-utility-btn:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 1px;
  }

  .nav-utility-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    inline-size: 40px;
    block-size: 40px;
    flex-shrink: 0;
    border: 1px solid var(--border);
    border-radius: var(--radius-md, 10px);
    background: var(--bg-card);
    color: var(--text-secondary);
    cursor: pointer;
    transition: background-color 150ms cubic-bezier(0.23, 1, 0.32, 1), border-color 150ms cubic-bezier(0.23, 1, 0.32, 1), color 150ms ease, transform 120ms cubic-bezier(0.23, 1, 0.32, 1);
  }

  .nav-utility-btn:hover,
  .nav-utility-btn:focus-visible,
  .nav-utility-btn[aria-expanded="true"] {
    background: var(--bg-hover);
    color: var(--text-primary);
    border-color: rgb(var(--accent-rgb) / 0.45);
  }

  .nav-utility-btn:active {
    transform: scale(0.96);
  }

  .sidebar-user-avatar {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    inline-size: 32px;
    block-size: 32px;
    border-radius: var(--radius-sm, 8px);
    color: #ffffff;
    font-size: 0.8125rem;
    font-weight: 700;
    letter-spacing: 0.02em;
    flex-shrink: 0;
    user-select: none;
    transition: background-color 180ms ease, color 180ms ease, box-shadow 180ms ease;
  }

  /* Dynamic theme-matched avatar tracks active accent & adapts to dark/light/colored nav */
  .sidebar-user-avatar[data-avatar-mode="theme"] {
    background-color: var(--accent);
    color: var(--accent-fg, #ffffff);
  }

  :root[data-theme="dark"] .sidebar-user-avatar[data-avatar-mode="theme"],
  :root[data-theme="knight-rider"] .sidebar-user-avatar[data-avatar-mode="theme"] {
    background-color: color-mix(in srgb, var(--accent) 82%, #0b120e);
    color: var(--accent-fg, #07120c);
  }

  :root[data-appearance-nav-tone="accent"] #sidebar .sidebar-user-avatar[data-avatar-mode="theme"] {
    background-color: rgba(255, 255, 255, 0.22);
    color: #ffffff;
    box-shadow: inset 0 0 0 1px rgba(255, 255, 255, 0.36);
  }

  .sidebar-user-avatar--preview {
    inline-size: 44px;
    block-size: 44px;
    border-radius: var(--radius-md, 10px);
    font-size: 1rem;
  }

  .sidebar-user-identity {
    display: flex;
    flex-direction: column;
    min-inline-size: 0;
    flex: 1;
    line-height: 1.25;
  }

  .sidebar-user-name {
    font-size: 0.8125rem;
    font-weight: 600;
    color: var(--text-primary);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .sidebar-user-subtitle {
    font-size: 0.72rem;
    color: var(--text-muted);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  /* ── Floating Utility Popover ── */
  .sidebar-user-popover {
    position: fixed;
    z-index: 260;
    inline-size: 256px;
    border: 1px solid var(--border);
    border-radius: var(--radius-md, 10px);
    background: var(--bg-card);
    box-shadow: 0 12px 32px rgba(0, 0, 0, 0.26);
    overflow: hidden;
    transform-origin: top right;
    animation: popoverEnter 140ms cubic-bezier(0.23, 1, 0.32, 1);
  }

  @keyframes popoverEnter {
    from {
      opacity: 0;
      transform: scale(0.96) translateY(-4px);
    }
    to {
      opacity: 1;
      transform: scale(1) translateY(0);
    }
  }

  .sidebar-user-popover[hidden] {
    display: none;
  }

  .nav-utility-popover__head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 8px;
    padding: 0.7rem 0.875rem;
  }

  .nav-utility-popover__title {
    font-size: 0.8125rem;
    font-weight: 700;
    color: var(--text-primary);
  }

  .nav-utility-popover__hint {
    font-size: 0.72rem;
    color: var(--text-muted);
    white-space: nowrap;
  }

  .sidebar-user-popover__divider {
    block-size: 1px;
    background: var(--border);
  }

  .sidebar-user-popover__actions {
    display: flex;
    flex-direction: column;
    padding: 0.375rem;
    gap: 2px;
  }

  .sidebar-user-popover__item {
    display: flex;
    align-items: center;
    gap: 0.625rem;
    inline-size: 100%;
    padding: 0.5rem 0.625rem;
    border: 0;
    border-radius: var(--radius-sm, 7px);
    background: transparent;
    color: var(--text-primary);
    font-size: 0.84rem;
    font-weight: 500;
    text-align: left;
    text-decoration: none;
    cursor: pointer;
    transition: background-color 120ms ease;
  }

  .sidebar-user-popover__item:hover,
  .sidebar-user-popover__item:focus-visible {
    background: var(--bg-hover);
    outline: none;
  }

  .sidebar-user-popover__icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    color: var(--text-secondary);
    flex-shrink: 0;
  }

  .nav-utility-kbd {
    margin-inline-start: auto;
    padding: 1px 6px;
    border: 1px solid var(--border);
    border-radius: 5px;
    background: var(--bg-secondary);
    color: var(--text-muted);
    font-family: var(--font-mono, monospace);
    font-size: 0.72rem;
    line-height: 1.4;
  }

  /* ── Edit Profile Tabler Modal Body ── */
  #sidebar-profile-modal .modal-content {
    background: var(--bg-card);
    color: var(--text-primary);
    border: 1px solid var(--border);
    box-shadow: 0 20px 48px rgba(0, 0, 0, 0.36);
  }

  #sidebar-profile-modal .modal-header {
    border-bottom: 1px solid var(--border);
    background: var(--bg-card);
  }

  #sidebar-profile-modal .modal-footer {
    border-top: 1px solid var(--border);
    background: var(--bg-card);
  }

  .sidebar-profile-modal__subtitle {
    margin: 0 0 0.875rem;
    font-size: 0.8125rem;
    color: var(--text-muted);
  }

  .sidebar-profile-modal__preview {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0.75rem;
    margin-bottom: 1rem;
    border: 1px solid var(--border);
    border-radius: var(--radius-md, 10px);
    background: var(--bg-secondary);
  }

  .sidebar-profile-form {
    display: flex;
    flex-direction: column;
    gap: 0.875rem;
  }

  .sidebar-profile-field {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
  }

  #sidebar-profile-modal .sidebar-profile-field input.form-input {
    inline-size: 100%;
    min-block-size: 38px;
    padding: 0.45rem 0.75rem;
    border: 1px solid var(--border);
    border-radius: var(--radius-sm, 8px);
    background: var(--bg-input, var(--bg-secondary));
    color: var(--text-primary);
  }

  #sidebar-profile-modal .sidebar-profile-field input.form-input:focus {
    outline: none;
    border-color: var(--accent);
    box-shadow: 0 0 0 2px rgb(var(--accent-rgb) / 0.2);
  }

  .sidebar-profile-swatches {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    padding-top: 0.125rem;
  }

  .sidebar-profile-swatch {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    inline-size: 30px;
    block-size: 30px;
    border-radius: var(--radius-sm, 8px);
    border: 2px solid transparent;
    cursor: pointer;
    transition: transform 120ms cubic-bezier(0.23, 1, 0.32, 1), box-shadow 120ms ease;
  }

  .sidebar-profile-swatch--theme {
    background: var(--accent);
    color: var(--accent-fg, #ffffff);
  }

  .sidebar-profile-swatch:hover {
    transform: scale(1.08);
  }

  .sidebar-profile-swatch.is-selected {
    border-color: var(--text-primary);
    box-shadow: 0 0 0 2px var(--bg-card), 0 0 0 4px var(--accent);
  }

  .sidebar-profile-error {
    margin: 0;
    font-size: 0.8125rem;
    color: var(--danger, #ef4444);
  }

  /* ── Top Navigation & Collapsed Rail Adaptations ── */
  @media (min-width: 769px) {
    :root[data-appearance-navigation="navbar"] #sidebar .sidebar-footer-row {
      gap: 0.5rem;
    }

    :root[data-appearance-navigation="navbar"] #sidebar .sidebar-user-card {
      padding: 0.3rem 0.55rem 0.3rem 0.35rem;
      max-inline-size: 13.5rem;
    }

    :root:not([data-appearance-navigation="navbar"]) body.sidebar-collapsed .sidebar-footer {
      border-top-color: var(--border);
      padding-top: 0.5rem;
      align-items: center;
    }

    :root:not([data-appearance-navigation="navbar"]) body.sidebar-collapsed .sidebar-footer-row {
      flex-direction: column;
      align-items: center;
      gap: 0.375rem;
    }

    :root:not([data-appearance-navigation="navbar"]) body.sidebar-collapsed .sidebar-user-card {
      inline-size: 40px;
      block-size: 40px;
      justify-content: center;
      padding: 0;
      margin-inline: auto;
      border-color: transparent;
      background: transparent;
    }

    :root:not([data-appearance-navigation="navbar"]) body.sidebar-collapsed .sidebar-user-avatar {
      inline-size: 36px;
      block-size: 36px;
    }

    :root:not([data-appearance-navigation="navbar"]) body.sidebar-collapsed .sidebar-user-card .sidebar-user-identity {
      display: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .sidebar-user-card,
    .nav-utility-btn,
    .sidebar-user-popover,
    .sidebar-profile-swatch {
      animation: none;
      transition: none;
    }
    .sidebar-user-card:active,
    .nav-utility-btn:active {
      transform: none;
    }
  }
</style>
