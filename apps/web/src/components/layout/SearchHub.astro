---
import { t } from "../../i18n/translations"
import type { Locale } from "../../lib/locale"
import { SETTINGS_SECTIONS } from "../../lib/settings-registry"
import { getFeatureFlags } from "@lib/feature-flags"
import { defaultOrganizationLabel, newOrganizationLabel, organizationLabelsFor, visibleOrganizationTerms } from "@lib/organization-labels"
import { serializeForScript } from "../../lib/safe-html"
import Icon from "../ui/Icon.astro"

interface Props {
  locale: Locale
  boardId?: string | undefined
}

const { locale, boardId } = Astro.props
const workRoot = boardId ? `/boards/${encodeURIComponent(boardId)}` : "/boards"

const [organization, flags] = await Promise.all([organizationLabelsFor(Astro), getFeatureFlags()])
const visible = visibleOrganizationTerms(flags)
const shortcuts = [
  { term: "board", id: "boards", href: "/boards", plural: true },
  { term: "group", id: "groups", href: `${workRoot}?view=groups`, plural: true },
  { term: "project", id: "projects", href: `${workRoot}?view=groups#unfiled-projects`, plural: true },
  { term: "planning", id: "planning", href: "/planning" },
  { term: "progress", id: "progress", href: "/progress" },
  { term: "goal", id: "goals", href: "/progress#goals", plural: true },
  { term: "routine", id: "routines", href: "/habits#habits-library", plural: true },
  { term: "pillar", id: "pillars", href: "/progress#pillars", plural: true },
  { term: "principle", id: "principles", href: "/progress#pillars", plural: true },
  { term: "achievement", id: "achievements", href: "/progress#achievements", plural: true },
] as const

const staticConfig = {
  pages: [
    {
      id: "page-dashboard",
      kind: "page",
      title: t("nav.dashboard", locale),
      subtitle: "Overview and recent work",
      href: "/?view=dashboard",
    },
    {
      id: "page-today",
      kind: "page",
      title: t("nav.today", locale),
      subtitle: "Focus for today",
      href: "/today",
    },
    {
      id: "page-upcoming",
      kind: "page",
      title: t("nav.upcoming", locale),
      subtitle: "Next 7 days and scheduled events",
      href: "/upcoming",
    },
    {
      id: "page-tasks",
      kind: "page",
      title: organization("task", true, t("nav.kanban", locale)),
      subtitle: "Task board views",
      href: "/tasks",
    },
    {
      id: "page-table",
      kind: "page",
      title: t("nav.table", locale),
      subtitle: "Table and saved views",
      href: "/tasks?view=table#table",
    },
    {
      id: "page-calendar",
      kind: "page",
      title: t("nav.calendar", locale),
      subtitle: "Calendar planning",
      href: "/tasks?view=calendar#calendar",
    },
    {
      id: "page-settings",
      kind: "page",
      title: t("nav.settings", locale),
      subtitle: "Configuration and integrations",
      href: "/settings",
    },
    ...shortcuts.filter(({ term }) => visible.includes(term)).map(({ term, id, href, ...options }) => {
      const plural = "plural" in options
      return {
        id: `page-${id}`, kind: "page", title: organization(term, plural), href,
        keywords: [...new Set([
          organization(term),
          defaultOrganizationLabel(term, locale),
          defaultOrganizationLabel(term, locale, plural),
          defaultOrganizationLabel(term, "en"),
          defaultOrganizationLabel(term, "en", plural),
        ])],
      }
    }),
  ],
  actions: [
    {
      id: "action-new-task",
      kind: "action",
      title: newOrganizationLabel(organization("task"), locale),
      keywords: [t("tasks.new_task", locale)],
      subtitle: "Create a task from anywhere",
      actionId: "new-task",
    },
    {
      id: "action-ask-ha",
      kind: "action",
      title: "Ask Home Assistant",
      subtitle: "Open the Assist panel inside Meitheal",
      actionId: "ask-home-assistant",
    },
  ],
  settings: SETTINGS_SECTIONS.map((section) => ({
    id: section.id,
    label: section.label,
    subtitle: section.description,
    href: `/settings#${section.id}`,
  })),
}

const staticConfigJson = serializeForScript(staticConfig)
---

<div
  id="search-hub-overlay"
  class="search-hub-overlay hidden"
  role="dialog"
  aria-modal="true"
  aria-labelledby="search-hub-title"
>
  <div class="search-hub-shell">
    <div class="search-hub-panel">
      <div class="search-hub-header">
        <div class="search-hub-input-wrap">
          <span class="search-hub-input-icon" aria-hidden="true"><Icon name="search" size={16} sprite={true} /></span>
          <input
            id="search-hub-input"
            class="search-hub-input"
            type="search"
            role="combobox"
            aria-autocomplete="list"
            aria-controls="search-hub-results"
            aria-expanded="false"
            placeholder={t("topbar.search_placeholder", locale)}
            aria-label="Search tasks, views, settings, and actions"
            autocomplete="off"
          />
          <button
            id="search-hub-close"
            class="search-hub-close"
            type="button"
            aria-label="Close search"
          >
            Esc
          </button>
        </div>
        <div class="search-hub-heading">
          <h2 id="search-hub-title">Universal Search</h2>
          <p>Tasks, views, settings, and Home Assistant-aware actions in one place.</p>
        </div>
      </div>

      <div class="search-hub-toolbar">
        <div class="search-hub-scopes" role="tablist" aria-label="Search scope">
          <button class="search-hub-scope is-active" type="button" role="tab" aria-selected="true" data-scope="all">All</button>
          <button class="search-hub-scope" type="button" role="tab" aria-selected="false" data-scope="tasks">{organization("task", true)}</button>
          <button class="search-hub-scope" type="button" role="tab" aria-selected="false" data-scope="views">Views</button>
          <button class="search-hub-scope" type="button" role="tab" aria-selected="false" data-scope="settings">Settings</button>
          <button class="search-hub-scope" type="button" role="tab" aria-selected="false" data-scope="actions">Actions</button>
        </div>

        <div id="search-task-options" class="search-hub-task-options">
          <div class="search-hub-field-group" aria-label="Task search fields">
            <label><input type="checkbox" data-task-field="id" checked /> IDs</label>
            <label><input type="checkbox" data-task-field="title" checked /> Titles</label>
            <label><input type="checkbox" data-task-field="description" checked /> Descriptions</label>
            <label><input type="checkbox" data-task-field="labels" checked /> Labels</label>
            <label><input type="checkbox" data-task-field="custom_fields" checked /> Custom fields</label>
            <label><input type="checkbox" data-task-field="comments" checked /> Comments</label>
          </div>

          <div class="search-hub-toggle-row">
            <label><input id="search-include-completed" type="checkbox" /> Completed</label>
            <label><input id="search-include-archived" type="checkbox" /> Archived</label>
            <label class="search-hub-sort">
              Sort
              <select id="search-sort" aria-label="Sort search results">
                <option value="relevance">Relevance</option>
                <option value="updated">Recently updated</option>
              </select>
            </label>
          </div>
        </div>
      </div>

      <div id="search-hub-results" class="search-hub-results" role="listbox" aria-label="Search results"></div>
      <div id="search-hub-status"><span id="search-hub-announcement" role="status" aria-live="polite"></span><div id="search-hub-recovery"></div></div>
    </div>
  </div>
</div>

<script
  type="application/json"
  id="search-hub-static"
  is:inline
  set:html={staticConfigJson}
></script>
