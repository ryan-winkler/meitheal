---
/**
 * SidebarHierarchyTree — Area → Project sidebar navigation
 *
 * Phase 15.2: Direct area_id on projects replaces the indirect
 * goal→area grouping. Sidebar shows Areas as top-level groups
 * with nested Projects underneath.
 *
 * Features:
 * - Two-level hierarchy: Area → Project
 * - Default Area always visible (ungrouped projects merge in)
 * - "All Tasks" link at top of area section
 * - Per-area ⋯ quick-menu (Rename, Color & Icon, Delete)
 * - Per-project "+" button for task creation with kind picker
 * - Pinned projects section
 * - Collapse state per area (localStorage)
 * - Active page highlighting
 * - WAI-ARIA listbox keyboard navigation
 *
 * @domain navigation
 * @phase 15.2 — Area→Project Sidebar UX
 */
import {
  ensureSchema,
  getPersistenceClient,
} from "@domains/tasks/persistence/store"
import { HierarchyRepository } from "@domains/tasks/persistence/hierarchy-repository"
import { t } from "../../i18n/translations"
import type { Locale } from "../../lib/locale"
import Icon from "../ui/Icon.astro"

export interface Props {
  locale: Locale
}
const { locale } = Astro.props

interface AreaRow { id: string; name: string; icon: string; color: string; position: number }
interface ProjectRow { id: string; title: string; area_id: string | null; icon: string; color: string; status: string }

let areas: AreaRow[] = []
let projects: ProjectRow[] = []

try {
  await ensureSchema()
  const repo = new HierarchyRepository(getPersistenceClient())
  areas = (await repo.findAllAreas()) as unknown as AreaRow[]
  projects = (await repo.findAllProjects({})) as unknown as ProjectRow[]
} catch {
  // Schema may not exist yet — render empty
}

// Build area → projects mapping directly via area_id
const projectsByArea = new Map<string, ProjectRow[]>()
const ungroupedProjects: ProjectRow[] = []

for (const p of projects) {
  if (p.area_id) {
    const list = projectsByArea.get(String(p.area_id)) ?? []
    list.push(p)
    projectsByArea.set(String(p.area_id), list)
  } else {
    ungroupedProjects.push(p)
  }
}

// Find or ensure a "Default" area for ungrouped projects
const defaultArea = areas.find((a) => a.id === "default")
if (defaultArea && ungroupedProjects.length > 0) {
  // Merge ungrouped into default area's project list
  const existing = projectsByArea.get("default") ?? []
  projectsByArea.set("default", [...existing, ...ungroupedProjects])
}

// Current path for active state
const rawPath = Astro.url.pathname
const currentPath = rawPath.replace(/\/$/, "") || "/"

const hasContent = projects.length > 0 || areas.length > 0

// Show all areas — the Default area is always visible
const visibleAreas = areas

const areasLabel = t("sidebar.areas_header", locale) || "Areas"

// Task kinds for the per-project add dropdown (exclude routine_instance — auto-spawned)
const taskKinds = [
  { kind: "standard_action", icon: "✅", labelKey: "sidebar.task_kind_standard_action" },
  { kind: "shopping_item", icon: "🛒", labelKey: "sidebar.task_kind_shopping_item" },
  { kind: "checklist", icon: "☑️", labelKey: "sidebar.task_kind_checklist" },
  { kind: "calendar_event", icon: "📅", labelKey: "sidebar.task_kind_calendar_event" },
  { kind: "quick_capture", icon: "⚡", labelKey: "sidebar.task_kind_quick_capture" },
]
---

{hasContent && (
  <div class="project-nav" id="project-nav" role="navigation" aria-label="Area navigation">
    <div class="project-nav__header">
      <span class="project-nav__label">{areasLabel}</span>
      <a
        href="/areas"
        class="project-nav__manage-link"
        title="Manage areas & projects"
        aria-label="Manage areas & projects"
      >
        <Icon name="settings" size={12} />
      </a>
    </div>

    {/* ── Pinned projects (populated by client JS) ── */}
    <div class="project-nav__pinned" id="project-nav-pinned" hidden>
      <span class="project-nav__divider-label">📌 {t("sidebar.pinned", locale)}</span>
      <div class="project-nav__pinned-list" id="project-nav-pinned-list"></div>
    </div>

    {/* ── All Tasks link ── */}
    <a
      href="/tasks"
      class={`project-nav__all-tasks ${currentPath === "/tasks" ? "active" : ""}`}
      title={t("sidebar.all_tasks", locale)}
    >
      <span class="project-nav__all-tasks-icon">📊</span>
      <span>{t("sidebar.all_tasks", locale) || "All Tasks"}</span>
    </a>

    {/* ── Area-grouped sections ── */}
    <div class="project-nav__list" id="project-nav-list">
      {visibleAreas.map((area) => {
        const areaProjects = projectsByArea.get(String(area.id)) ?? []
        const isDefault = area.id === "default"
        return (
          <div class="project-nav__area-group" data-area-group={area.id}>
            <div class="project-nav__divider">
              <button
                type="button"
                class="project-nav__divider-toggle"
                data-area-toggle={area.id}
                aria-expanded="true"
                aria-label={`Toggle ${area.name}`}
              >
                <span class="project-nav__divider-chevron">▾</span>
              </button>
              <a
                href={`/areas/${area.id}`}
                class={`project-nav__divider-link ${currentPath === `/areas/${area.id}` ? "active" : ""}`}
                title={`View ${area.name}`}
              >
                <span class="project-nav__divider-icon" style={`color: ${area.color}`}>{area.icon}</span>
                <span class="project-nav__divider-label">{area.name}</span>
              </a>
              {/* ── Area quick-menu trigger ── */}
              {!isDefault && (
                <button
                  type="button"
                  class="project-nav__area-menu-btn"
                  data-area-menu={area.id}
                  data-area-name={area.name}
                  data-area-color={area.color}
                  data-area-icon={area.icon}
                  title="Area options"
                  aria-label={`Options for ${area.name}`}
                >⋯</button>
              )}
              <span class="project-nav__divider-count">{areaProjects.length}</span>
            </div>
            <div class="project-nav__area-projects" data-area-projects={area.id}>
              {areaProjects.map((proj) => (
                <div class="project-nav__item-row">
                  <a
                    href={`/projects/${proj.id}`}
                    class={`project-nav__item ${currentPath === `/projects/${proj.id}` ? "active" : ""}`}
                    data-project-id={proj.id}
                    data-project-name={proj.title}
                    title={proj.title}
                  >
                    <span class="project-nav__item-icon" style={`color: ${proj.color}`}>{proj.icon}</span>
                    <span class="project-nav__item-name">{proj.title}</span>
                  </a>
                  {/* ── Per-project task add trigger ── */}
                  <button
                    type="button"
                    class="project-nav__task-add-btn"
                    data-task-add-project={proj.id}
                    data-task-add-name={proj.title}
                    title={t("sidebar.add_task", locale)}
                    aria-label={`Add task to ${proj.title}`}
                  >
                    <Icon name="plus" size={10} />
                  </button>
                </div>
              ))}
              {/* Per-area inline quick-add project */}
              <button
                type="button"
                class="project-nav__area-add-btn"
                data-area-add={area.id}
                title={`New project in ${area.name}`}
                aria-label={`New project in ${area.name}`}
              >
                <Icon name="plus" size={11} />
                <span>New Project</span>
              </button>
            </div>
          </div>
        )
      })}

      {/* ── Ungrouped projects (only shown if no Default area exists) ── */}
      {!defaultArea && ungroupedProjects.length > 0 && (
        <div class="project-nav__area-group" data-area-group="ungrouped">
          <div class="project-nav__divider">
            <span class="project-nav__divider-label project-nav__divider-label--muted">{t("sidebar.ungrouped", locale)}</span>
          </div>
          <div class="project-nav__area-projects" data-area-projects="ungrouped">
            {ungroupedProjects.map((proj) => (
              <div class="project-nav__item-row">
                <a
                  href={`/projects/${proj.id}`}
                  class={`project-nav__item ${currentPath === `/projects/${proj.id}` ? "active" : ""}`}
                  data-project-id={proj.id}
                  data-project-name={proj.title}
                  title={proj.title}
                >
                  <span class="project-nav__item-icon" style={`color: ${proj.color}`}>{proj.icon}</span>
                  <span class="project-nav__item-name">{proj.title}</span>
                </a>
                <button
                  type="button"
                  class="project-nav__task-add-btn"
                  data-task-add-project={proj.id}
                  data-task-add-name={proj.title}
                  title={t("sidebar.add_task", locale)}
                  aria-label={`Add task to ${proj.title}`}
                >
                  <Icon name="plus" size={10} />
                </button>
              </div>
            ))}
          </div>
        </div>
      )}
    </div>
  </div>
)}

{/* ── Area quick-menu dropdown (shared, positioned by JS) ── */}
<div class="project-nav__dropdown" id="area-menu-dropdown" hidden>
  <button type="button" data-action="rename" class="project-nav__dropdown-item">
    <span class="project-nav__dropdown-icon">✏️</span>
    <span>{t("sidebar.rename", locale)}</span>
  </button>
  <button type="button" data-action="color-icon" class="project-nav__dropdown-item">
    <span class="project-nav__dropdown-icon">🎨</span>
    <span>{t("sidebar.color_icon", locale)}</span>
  </button>
  <hr class="project-nav__dropdown-divider" />
  <button type="button" data-action="delete" class="project-nav__dropdown-item project-nav__dropdown-item--danger">
    <span class="project-nav__dropdown-icon">🗑️</span>
    <span>{t("sidebar.delete_area", locale)}</span>
  </button>
</div>

{/* ── Task kind picker dropdown (shared, positioned by JS) ── */}
<div class="project-nav__dropdown" id="task-kind-dropdown" hidden>
  {taskKinds.map((tk) => (
    <button type="button" data-task-kind={tk.kind} class="project-nav__dropdown-item">
      <span class="project-nav__dropdown-icon">{tk.icon}</span>
      <span>{t(tk.labelKey, locale)}</span>
    </button>
  ))}
</div>

{/* ── Color picker popover (for Color & Icon action) ── */}
<div class="project-nav__color-picker" id="color-icon-popover" hidden>
  <div class="project-nav__color-picker-section">
    <label class="project-nav__color-picker-label">Icon</label>
    <input type="text" id="area-icon-input" class="project-nav__color-picker-input" maxlength="4" placeholder="📋" />
  </div>
  <div class="project-nav__color-picker-section">
    <label class="project-nav__color-picker-label">Color</label>
    <div class="project-nav__color-swatches" id="color-swatches">
      {["#6366F1", "#EF4444", "#F59E0B", "#10B981", "#3B82F6", "#8B5CF6", "#EC4899", "#14B8A6", "#F97316", "#64748B"].map((c) => (
        <button type="button" class="project-nav__color-swatch" data-swatch-color={c} style={`background: ${c}`} title={c}></button>
      ))}
    </div>
  </div>
  <button type="button" id="color-icon-save" class="project-nav__color-picker-save">Save</button>
</div>

<style>
  .project-nav {
    display: flex;
    flex-direction: column;
    gap: 2px;
    padding: 0.75rem;
    background: rgba(var(--bg-primary-rgb), 0.5);
    border-radius: var(--radius-md, 10px);
    border: 1px solid rgba(var(--border-rgb), 0.5);
    margin-bottom: 0.5rem;
  }

  /* ── Header ── */
  .project-nav__header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 4px;
  }
  .project-nav__label {
    font-size: 0.7rem;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    font-weight: 600;
    color: var(--text-muted);
  }
  .project-nav__manage-link {
    color: var(--text-muted);
    opacity: 0.6;
    transition: opacity 150ms, color 150ms;
    display: flex;
    align-items: center;
    text-decoration: none;
  }
  .project-nav__manage-link:hover {
    opacity: 1;
    color: var(--accent);
  }

  /* ── All Tasks link ── */
  .project-nav__all-tasks {
    display: flex;
    align-items: center;
    gap: 6px;
    padding: 5px 6px;
    border-radius: var(--radius-sm, 4px);
    text-decoration: none;
    color: var(--text-secondary);
    font-size: 13px;
    font-weight: 500;
    transition: background 150ms, color 150ms;
    margin-bottom: 2px;
  }
  .project-nav__all-tasks:hover {
    background: var(--bg-hover);
    color: var(--text-primary);
  }
  .project-nav__all-tasks.active {
    background: rgba(var(--accent-rgb), 0.1);
    color: var(--accent);
  }
  .project-nav__all-tasks-icon {
    font-size: 12px;
    flex-shrink: 0;
  }

  /* ── Area dividers ── */
  .project-nav__divider {
    display: flex;
    align-items: center;
    gap: 4px;
    padding: 4px 2px;
    margin-top: 4px;
  }
  .project-nav__area-group:first-child .project-nav__divider {
    margin-top: 0;
  }
  .project-nav__divider-toggle {
    background: none;
    border: none;
    cursor: pointer;
    padding: 0 2px;
    color: var(--text-muted);
    font-size: 10px;
    transition: transform 150ms, color 150ms;
    display: flex;
    align-items: center;
  }
  .project-nav__divider-toggle:hover { color: var(--text-primary); }
  .project-nav__divider-toggle[aria-expanded="false"] .project-nav__divider-chevron {
    transform: rotate(-90deg);
  }
  .project-nav__divider-link {
    display: flex;
    align-items: center;
    gap: 4px;
    text-decoration: none;
    color: var(--text-secondary);
    font-size: 12px;
    font-weight: 600;
    flex: 1;
    min-width: 0;
    transition: color 150ms;
  }
  .project-nav__divider-link:hover { color: var(--text-primary); }
  .project-nav__divider-link.active { color: var(--accent); }
  .project-nav__divider-icon {
    font-size: 11px;
    flex-shrink: 0;
  }
  .project-nav__divider-label {
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .project-nav__divider-label--muted {
    font-size: 11px;
    font-weight: 500;
    color: var(--text-muted);
    opacity: 0.7;
    padding-left: 18px;
  }
  .project-nav__divider-count {
    font-size: 10px;
    color: var(--text-muted);
    background: rgba(var(--bg-primary-rgb), 0.8);
    padding: 0 5px;
    border-radius: 9999px;
    font-weight: 600;
    flex-shrink: 0;
  }

  /* ── Area ⋯ menu button ── */
  .project-nav__area-menu-btn {
    background: none;
    border: none;
    cursor: pointer;
    padding: 0 4px;
    font-size: 12px;
    color: var(--text-muted);
    opacity: 0;
    transition: opacity 150ms, color 150ms;
    letter-spacing: 1px;
    line-height: 1;
    border-radius: var(--radius-sm, 4px);
  }
  .project-nav__area-group:hover .project-nav__area-menu-btn,
  .project-nav__area-menu-btn:focus-visible {
    opacity: 0.6;
  }
  .project-nav__area-menu-btn:hover {
    opacity: 1;
    color: var(--text-primary);
    background: var(--bg-hover);
  }

  /* ── Project item row (wraps link + add button) ── */
  .project-nav__item-row {
    display: flex;
    align-items: center;
    gap: 0;
    position: relative;
  }

  /* ── Project items ── */
  .project-nav__area-projects {
    display: flex;
    flex-direction: column;
  }
  .project-nav__area-projects[data-collapsed="true"] {
    display: none;
  }
  .project-nav__item {
    display: flex;
    align-items: center;
    gap: 6px;
    padding: 4px 4px 4px 22px;
    border-radius: var(--radius-sm, 4px);
    text-decoration: none;
    color: var(--text-secondary);
    font-size: 14px;
    transition: background 150ms, color 150ms;
    min-width: 0;
    flex: 1;
    box-sizing: border-box;
  }
  .project-nav__item:hover {
    background: var(--bg-hover);
    color: var(--text-primary);
  }
  .project-nav__item.active {
    background: rgba(var(--accent-rgb), 0.1);
    color: var(--accent);
  }
  .project-nav__item-icon {
    font-size: 13px;
    flex-shrink: 0;
  }
  .project-nav__item-name {
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  /* ── Per-project task add button ── */
  .project-nav__task-add-btn {
    background: none;
    border: none;
    cursor: pointer;
    padding: 2px 4px;
    color: var(--text-muted);
    opacity: 0;
    transition: opacity 150ms, color 150ms;
    display: flex;
    align-items: center;
    border-radius: var(--radius-sm, 4px);
    flex-shrink: 0;
  }
  .project-nav__item-row:hover .project-nav__task-add-btn,
  .project-nav__task-add-btn:focus-visible {
    opacity: 0.6;
  }
  .project-nav__task-add-btn:hover {
    opacity: 1;
    color: var(--accent);
    background: var(--bg-hover);
  }

  /* ── Pinned section ── */
  .project-nav__pinned {
    border-bottom: 1px solid rgba(var(--border-rgb), 0.3);
    padding-bottom: 6px;
    margin-bottom: 2px;
  }
  .project-nav__pinned .project-nav__divider-label {
    font-size: 10px;
    color: var(--text-muted);
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    padding: 2px 4px;
  }
  .project-nav__pinned-list .project-nav__item {
    padding-left: 8px;
  }

  /* ── Per-area add button ── */
  .project-nav__area-add-btn {
    display: flex;
    align-items: center;
    gap: 4px;
    width: 100%;
    padding: 3px 4px 3px 22px;
    margin-top: 1px;
    border: none;
    background: none;
    border-radius: var(--radius-sm, 4px);
    cursor: pointer;
    font-size: 11px;
    color: var(--text-muted);
    opacity: 0;
    transition: opacity 150ms, background 150ms, color 150ms;
  }
  .project-nav__area-group:hover .project-nav__area-add-btn,
  .project-nav__area-add-btn:focus-visible {
    opacity: 0.7;
  }
  .project-nav__area-add-btn:hover {
    opacity: 1;
    background: var(--bg-hover);
    color: var(--text-primary);
  }

  /* ── Shared dropdown menu ── */
  .project-nav__dropdown {
    position: fixed;
    z-index: 9999;
    min-width: 160px;
    background: var(--bg-surface, #1e1e2e);
    border: 1px solid rgba(var(--border-rgb), 0.6);
    border-radius: var(--radius-md, 8px);
    box-shadow: 0 8px 24px rgba(0,0,0,0.4);
    padding: 4px;
    display: flex;
    flex-direction: column;
  }
  .project-nav__dropdown[hidden] { display: none; }
  .project-nav__dropdown-item {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 6px 10px;
    border: none;
    background: none;
    border-radius: var(--radius-sm, 4px);
    cursor: pointer;
    font-size: 13px;
    color: var(--text-secondary);
    transition: background 150ms, color 150ms;
    text-align: left;
    width: 100%;
  }
  .project-nav__dropdown-item:hover {
    background: var(--bg-hover);
    color: var(--text-primary);
  }
  .project-nav__dropdown-item--danger:hover {
    background: rgba(239, 68, 68, 0.15);
    color: #EF4444;
  }
  .project-nav__dropdown-icon {
    font-size: 14px;
    flex-shrink: 0;
    width: 18px;
    text-align: center;
  }
  .project-nav__dropdown-divider {
    border: none;
    border-top: 1px solid rgba(var(--border-rgb), 0.3);
    margin: 2px 6px;
  }

  /* ── Color & Icon popover ── */
  .project-nav__color-picker {
    position: fixed;
    z-index: 10000;
    min-width: 200px;
    background: var(--bg-surface, #1e1e2e);
    border: 1px solid rgba(var(--border-rgb), 0.6);
    border-radius: var(--radius-md, 8px);
    box-shadow: 0 8px 24px rgba(0,0,0,0.4);
    padding: 12px;
    display: flex;
    flex-direction: column;
    gap: 10px;
  }
  .project-nav__color-picker[hidden] { display: none; }
  .project-nav__color-picker-section {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }
  .project-nav__color-picker-label {
    font-size: 11px;
    font-weight: 600;
    color: var(--text-muted);
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }
  .project-nav__color-picker-input {
    padding: 6px 8px;
    font-size: 20px;
    text-align: center;
    border: 1px solid rgba(var(--border-rgb), 0.5);
    border-radius: var(--radius-sm, 4px);
    background: var(--bg-primary);
    color: var(--text-primary);
    width: 60px;
  }
  .project-nav__color-swatches {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
  }
  .project-nav__color-swatch {
    width: 24px;
    height: 24px;
    border-radius: 50%;
    border: 2px solid transparent;
    cursor: pointer;
    transition: border-color 150ms, transform 150ms;
  }
  .project-nav__color-swatch:hover,
  .project-nav__color-swatch.selected {
    border-color: var(--text-primary);
    transform: scale(1.15);
  }
  .project-nav__color-picker-save {
    padding: 6px 12px;
    font-size: 12px;
    font-weight: 600;
    border: none;
    border-radius: var(--radius-sm, 4px);
    background: var(--accent);
    color: white;
    cursor: pointer;
    transition: background 150ms;
  }
  .project-nav__color-picker-save:hover {
    filter: brightness(1.1);
  }

  @media (prefers-reduced-motion: reduce) {
    .project-nav__divider-toggle,
    .project-nav__item,
    .project-nav__area-add-btn,
    .project-nav__manage-link,
    .project-nav__divider-link,
    .project-nav__area-menu-btn,
    .project-nav__task-add-btn,
    .project-nav__all-tasks {
      transition: none;
    }
  }
</style>

<script>
  // ── Project navigation: collapse/expand + pinning + menus ──
  (function initProjectNav() {
    const nav = document.getElementById("project-nav")
    if (!nav) return

    // ── Helpers ──
    function hideAllDropdowns() {
      document.querySelectorAll<HTMLElement>(".project-nav__dropdown, .project-nav__color-picker").forEach((d) => {
        d.hidden = true
      })
    }

    function positionDropdown(dropdown: HTMLElement, anchor: HTMLElement) {
      const rect = anchor.getBoundingClientRect()
      dropdown.style.top = `${rect.bottom + 4}px`
      dropdown.style.left = `${rect.left}px`
      // Ensure it doesn't go off-screen right
      requestAnimationFrame(() => {
        const dr = dropdown.getBoundingClientRect()
        if (dr.right > window.innerWidth - 8) {
          dropdown.style.left = `${window.innerWidth - dr.width - 8}px`
        }
        if (dr.bottom > window.innerHeight - 8) {
          dropdown.style.top = `${rect.top - dr.height - 4}px`
        }
      })
    }

    // Close dropdowns on outside click
    document.addEventListener("click", (e) => {
      const target = e.target as HTMLElement
      if (!target.closest(".project-nav__dropdown, .project-nav__color-picker, [data-area-menu], [data-task-add-project]")) {
        hideAllDropdowns()
      }
    })
    document.addEventListener("keydown", (e) => {
      if (e.key === "Escape") hideAllDropdowns()
    })

    // ── 1. Collapse/Expand per area ──
    const COLLAPSE_KEY = "meitheal_project_nav_collapsed"
    let collapsed: Set<string>
    try {
      const stored = localStorage.getItem(COLLAPSE_KEY)
      collapsed = new Set(stored ? JSON.parse(stored) : [])
    } catch {
      collapsed = new Set()
    }

    function saveCollapsed() {
      try { localStorage.setItem(COLLAPSE_KEY, JSON.stringify([...collapsed])) } catch { /* quota */ }
    }

    document.querySelectorAll<HTMLButtonElement>("[data-area-toggle]").forEach((btn) => {
      const areaId = btn.dataset.areaToggle
      if (!areaId) return
      const projects = document.querySelector(`[data-area-projects="${areaId}"]`) as HTMLElement | null
      if (!projects) return

      // Restore
      if (collapsed.has(areaId)) {
        projects.dataset.collapsed = "true"
        btn.setAttribute("aria-expanded", "false")
      }

      btn.addEventListener("click", () => {
        const isCollapsed = projects.dataset.collapsed === "true"
        if (isCollapsed) {
          projects.dataset.collapsed = "false"
          projects.style.display = ""
          btn.setAttribute("aria-expanded", "true")
          collapsed.delete(areaId)
        } else {
          projects.dataset.collapsed = "true"
          projects.style.display = "none"
          btn.setAttribute("aria-expanded", "false")
          collapsed.add(areaId)
        }
        saveCollapsed()
      })
    })

    // ── 2. Pinned projects ──
    const PIN_KEY = "meitheal-pinned-projects"
    let pinnedIds: Set<string>
    try {
      const stored = localStorage.getItem(PIN_KEY)
      pinnedIds = new Set(stored ? JSON.parse(stored) : [])
    } catch {
      pinnedIds = new Set()
    }

    function savePinned() {
      try { localStorage.setItem(PIN_KEY, JSON.stringify([...pinnedIds])) } catch { /* quota */ }
    }

    function renderPinned() {
      const container = document.getElementById("project-nav-pinned")
      const list = document.getElementById("project-nav-pinned-list")
      if (!container || !list) return

      if (pinnedIds.size === 0) {
        container.hidden = true
        return
      }

      container.hidden = false
      list.innerHTML = ""

      pinnedIds.forEach((id) => {
        const sourceItem = nav!.querySelector<HTMLAnchorElement>(`[data-project-id="${id}"]`)
        if (!sourceItem) return
        const clone = sourceItem.cloneNode(true) as HTMLAnchorElement
        clone.classList.add("pinned-item")
        const unpinBtn = document.createElement("button")
        unpinBtn.type = "button"
        unpinBtn.className = "project-nav__unpin-btn"
        unpinBtn.title = "Unpin"
        unpinBtn.textContent = "📌"
        unpinBtn.addEventListener("click", (e) => {
          e.preventDefault()
          e.stopPropagation()
          pinnedIds.delete(id)
          savePinned()
          renderPinned()
        })
        clone.appendChild(unpinBtn)
        list.appendChild(clone)
      })
    }

    renderPinned()

    // Context menu for pinning
    nav.addEventListener("contextmenu", (e) => {
      const item = (e.target as HTMLElement).closest<HTMLAnchorElement>("[data-project-id]")
      if (!item) return
      e.preventDefault()
      const id = item.dataset.projectId!
      if (pinnedIds.has(id)) {
        pinnedIds.delete(id)
      } else {
        pinnedIds.add(id)
      }
      savePinned()
      renderPinned()
    })

    // ── 3. Per-area quick-add project ──
    document.querySelectorAll<HTMLButtonElement>("[data-area-add]").forEach((btn) => {
      btn.addEventListener("click", async () => {
        const areaId = btn.dataset.areaAdd
        if (!areaId) return
        const title = prompt("New project title:")
        if (!title?.trim()) return
        try {
          const res = await fetch("/api/projects", {
            method: "POST",
            headers: { "content-type": "application/json" },
            body: JSON.stringify({ title: title.trim(), area_id: areaId, icon: "📋", color: "#6366F1" }),
          })
          if (res.ok) {
            window.location.reload()
          }
        } catch { /* ignore */ }
      })
    })

    // ── 4. Area quick-menu (⋯) ──
    const areaMenuDropdown = document.getElementById("area-menu-dropdown")
    const colorIconPopover = document.getElementById("color-icon-popover")
    let activeAreaId: string | null = null
    let activeAreaName: string | null = null

    document.querySelectorAll<HTMLButtonElement>("[data-area-menu]").forEach((btn) => {
      btn.addEventListener("click", (e) => {
        e.stopPropagation()
        if (!areaMenuDropdown) return
        const isVisible = !areaMenuDropdown.hidden && activeAreaId === btn.dataset.areaMenu
        hideAllDropdowns()
        if (isVisible) return

        activeAreaId = btn.dataset.areaMenu!
        activeAreaName = btn.dataset.areaName || ""
        areaMenuDropdown.hidden = false
        positionDropdown(areaMenuDropdown, btn)
      })
    })

    // Area menu actions
    areaMenuDropdown?.addEventListener("click", async (e) => {
      const btn = (e.target as HTMLElement).closest<HTMLButtonElement>("[data-action]")
      if (!btn || !activeAreaId) return
      const action = btn.dataset.action

      if (action === "rename") {
        hideAllDropdowns()
        const newName = prompt("New area name:", activeAreaName || "")
        if (!newName?.trim() || newName.trim() === activeAreaName) return
        try {
          await fetch(`/api/areas/${activeAreaId}`, {
            method: "PUT",
            headers: { "content-type": "application/json" },
            body: JSON.stringify({ name: newName.trim() }),
          })
          window.location.reload()
        } catch { /* ignore */ }
      }

      if (action === "color-icon") {
        if (!colorIconPopover) return
        areaMenuDropdown!.hidden = true
        // Pre-fill color & icon
        const iconInput = document.getElementById("area-icon-input") as HTMLInputElement | null
        if (iconInput) {
          const triggerBtn = document.querySelector<HTMLButtonElement>(`[data-area-menu="${activeAreaId}"]`)
          iconInput.value = triggerBtn?.dataset.areaIcon || "📋"
        }
        // Pre-select color swatch
        const currentColor = document.querySelector<HTMLButtonElement>(`[data-area-menu="${activeAreaId}"]`)?.dataset.areaColor || "#6366F1"
        document.querySelectorAll<HTMLButtonElement>("[data-swatch-color]").forEach((s) => {
          s.classList.toggle("selected", s.dataset.swatchColor === currentColor)
        })
        colorIconPopover.hidden = false
        const anchor = document.querySelector<HTMLButtonElement>(`[data-area-menu="${activeAreaId}"]`)
        if (anchor) positionDropdown(colorIconPopover, anchor)
      }

      if (action === "delete") {
        hideAllDropdowns()
        const confirmed = confirm(`Delete "${activeAreaName}"? Projects inside will become ungrouped.`)
        if (!confirmed) return
        try {
          await fetch(`/api/areas/${activeAreaId}`, { method: "DELETE" })
          window.location.reload()
        } catch { /* ignore */ }
      }
    })

    // Color swatch selection
    document.querySelectorAll<HTMLButtonElement>("[data-swatch-color]").forEach((swatch) => {
      swatch.addEventListener("click", () => {
        document.querySelectorAll<HTMLButtonElement>("[data-swatch-color]").forEach((s) => s.classList.remove("selected"))
        swatch.classList.add("selected")
      })
    })

    // Save color & icon
    document.getElementById("color-icon-save")?.addEventListener("click", async () => {
      if (!activeAreaId) return
      const iconInput = document.getElementById("area-icon-input") as HTMLInputElement | null
      const selectedSwatch = document.querySelector<HTMLButtonElement>("[data-swatch-color].selected")
      const icon = iconInput?.value?.trim() || "📋"
      const color = selectedSwatch?.dataset.swatchColor || "#6366F1"
      hideAllDropdowns()
      try {
        await fetch(`/api/areas/${activeAreaId}`, {
          method: "PUT",
          headers: { "content-type": "application/json" },
          body: JSON.stringify({ icon, color }),
        })
        window.location.reload()
      } catch { /* ignore */ }
    })

    // ── 5. Per-project task add (+) with kind picker ──
    const taskKindDropdown = document.getElementById("task-kind-dropdown")
    let activeProjectId: string | null = null

    document.querySelectorAll<HTMLButtonElement>("[data-task-add-project]").forEach((btn) => {
      btn.addEventListener("click", (e) => {
        e.stopPropagation()
        e.preventDefault()
        if (!taskKindDropdown) return
        const isVisible = !taskKindDropdown.hidden && activeProjectId === btn.dataset.taskAddProject
        hideAllDropdowns()
        if (isVisible) return

        activeProjectId = btn.dataset.taskAddProject!
        taskKindDropdown.hidden = false
        positionDropdown(taskKindDropdown, btn)
      })
    })

    taskKindDropdown?.addEventListener("click", async (e) => {
      const btn = (e.target as HTMLElement).closest<HTMLButtonElement>("[data-task-kind]")
      if (!btn || !activeProjectId) return
      const kind = btn.dataset.taskKind!
      hideAllDropdowns()

      const title = prompt("Task title:")
      if (!title?.trim()) return

      try {
        const res = await fetch("/api/tasks", {
          method: "POST",
          headers: { "content-type": "application/json" },
          body: JSON.stringify({
            title: title.trim(),
            project_id: activeProjectId,
            task_kind: kind,
          }),
        })
        if (res.ok) {
          window.location.reload()
        }
      } catch { /* ignore */ }
    })

    // ── 6. Keyboard navigation ──
    const focusables = () =>
      Array.from(nav.querySelectorAll<HTMLElement>(
        ".project-nav__item, .project-nav__divider-link, .project-nav__divider-toggle, .project-nav__all-tasks"
      )).filter((el) => el.offsetParent !== null)

    nav.addEventListener("keydown", (e: KeyboardEvent) => {
      const target = e.target as HTMLElement
      if (!target.matches(".project-nav__item, .project-nav__divider-link, .project-nav__divider-toggle, .project-nav__all-tasks")) return

      const items = focusables()
      const idx = items.indexOf(target)
      if (idx === -1) return

      switch (e.key) {
        case "ArrowDown":
          e.preventDefault()
          if (idx < items.length - 1) items[idx + 1]!.focus()
          break
        case "ArrowUp":
          e.preventDefault()
          if (idx > 0) items[idx - 1]!.focus()
          break
        case "Enter":
        case " ":
          if (target.matches(".project-nav__item, .project-nav__divider-link, .project-nav__all-tasks")) {
            e.preventDefault()
            ;(target as HTMLAnchorElement).click()
          }
          break
        case "Home":
          e.preventDefault()
          if (items.length > 0) items[0]!.focus()
          break
        case "End":
          e.preventDefault()
          if (items.length > 0) items[items.length - 1]!.focus()
          break
      }
    })
  })()
</script>
