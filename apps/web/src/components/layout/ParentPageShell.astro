---
import { organizationLabelsFor, type OrganizationTerm } from "@lib/organization-labels"
/**
 * ParentPageShell — Reusable shell for parent pages (Tasks, Progress & Growth, Planning)
 *
 * Wraps UnifiedBar + hash-based section routing in a single component.
 * Sections should be provided as children with `data-parent-section` attributes.
 *
 * Usage:
 *   <ParentPageShell pageId="tasks">
 *     <section data-parent-section="kanban" id="tasks-section-kanban">
 *       ...kanban content...
 *     </section>
 *     <section data-parent-section="calendar" id="tasks-section-calendar">
 *       ...calendar content...
 *     </section>
 *   </ParentPageShell>
 *
 * @domain navigation
 * @phase 15 — Hierarchy Architecture Overhaul
 */

import { isOrganizationFeatureAvailable } from "@lib/organization-request-context"
import UnifiedBar from "./UnifiedBar.astro"
import { PARENT_PAGES, type ParentPageId } from "@lib/parent-page-registry"

interface Props {
  pageId: ParentPageId
}

const { pageId } = Astro.props

const page = PARENT_PAGES.find((p) => p.id === pageId)
if (!page) throw new Error(`Unknown parent page: ${pageId}`)

const shellId = `${pageId}-shell`
const barId = `${pageId}-bar`

const organization = await organizationLabelsFor(Astro)
const pageTitle = organization(pageId === "tasks" ? "task" : pageId, true, page.label)
const subViewTerm: Partial<Record<string, OrganizationTerm>> = {
  pillars: "pillar", routines: "routine", goals: "goal", achievements: "achievement",
}
const allowedSubViews = page.subViews.filter(view =>
  !["pillars", "routines", "goals", "achievements"].includes(view.id) ||
    isOrganizationFeatureAvailable(view.id as "pillars" | "routines" | "goals" | "achievements"))
const tabs = allowedSubViews.map((sv) => {
  const term = subViewTerm[sv.id]
  return {
    id: sv.hash,
    label: sv.id === "spaces"
      ? organization("board", true)
      : term ? organization(term, true, sv.label) : sv.label,
    icon: sv.icon,
  }
})
---

<div
  class="parent-page-shell"
  id={shellId}
  data-page-id={pageId}
  data-parent-config={JSON.stringify({
    shellId,
    barId,
    sectionIds: allowedSubViews.map((sv) => sv.hash),
    defaultSectionId: allowedSubViews.some(view => view.hash === page.defaultHash) ? page.defaultHash : allowedSubViews[0]?.hash,
  })}
>
  <UnifiedBar
    title={pageTitle}
    titleIcon={page.icon}
    tabs={tabs}
    barId={barId}
    searchPlaceholder={`Search ${pageTitle.toLowerCase()}…`}
    searchScope={pageId}
  />

  <div class="parent-page-shell__content">
    <h1 class="sr-only">{pageTitle}</h1>
    <slot />
  </div>
</div>

<script>
  import { pageLifecycle } from "@lib/page-lifecycle"
  import { initParentPageController } from "@lib/parent-page-controller"

  pageLifecycle.onPageLoad(() => {
    document.querySelectorAll<HTMLElement>("[data-parent-config]").forEach((shell) => {
      if (shell.dataset.parentPageBooted === "true") return
      const raw = shell.dataset.parentConfig
      if (!raw) return
      try {
        const config = JSON.parse(raw)
        initParentPageController(config)
      } catch {
        // malformed config — skip
      }
    })
  })
</script>

<style>
  .parent-page-shell {
    display: flex;
    flex-direction: column;
    min-height: 100%;
  }

  .parent-page-shell__content {
    flex: 1 1 auto;
    position: relative;
  }

  /* Sections are toggled by the controller — hidden by default except active */
  .parent-page-shell__content :global([data-parent-section]) {
    width: 100%;
  }

  .parent-page-shell__content :global([data-parent-section][hidden]) {
    display: none !important;
  }

  .parent-page-shell__content :global([data-parent-section].is-active) {
    animation: parent-section-fade-in 200ms ease-out;
  }

  @keyframes parent-section-fade-in {
    from { opacity: 0; transform: translateY(4px); }
    to { opacity: 1; transform: translateY(0); }
  }

  @media (prefers-reduced-motion: reduce) {
    .parent-page-shell__content :global([data-parent-section].is-active) {
      animation: none;
    }
  }
</style>
