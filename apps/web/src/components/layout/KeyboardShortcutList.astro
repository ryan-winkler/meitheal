---
import { readBoardNavigationContext } from "../../lib/board-workspace"
import { t } from "../../i18n/translations"
import type { Locale } from "../../lib/locale"
import { keyboardShortcutGroups, type KeyboardShortcutScope } from "../../lib/keyboard-shortcuts"

interface Props {
  locale: Locale
  /** "dialog" is the compact `?` Help list; "settings" is the Settings card list. */
  variant: "dialog" | "settings"
  scopes?: readonly KeyboardShortcutScope[]
}

const { locale, variant, scopes } = Astro.props
const groups = keyboardShortcutGroups(scopes)
---

{variant === "dialog" ? (
  <div class="shortcut-modal-grid">
    {groups.map(group => (
      <>
        <h4>{t(group.headingKey, locale)}</h4>
        {group.shortcuts.map(shortcut => (
          <>
            <span class="shortcut-keys" data-shortcut-action={shortcut.id}>
              {shortcut.keys.map((key, index) => <>{index > 0 && " + "}<kbd>{key}</kbd></>)}
            </span>
            <span class="shortcut-label" data-shortcut-scope={group.scope}>
              {t(shortcut.labelKey, locale)}
              {shortcut.noteKey && <><span class="sr-only">. </span><span class="shortcut-note">{t(shortcut.noteKey, locale)}</span></>}
            </span>
          </>
        ))}
      </>
    ))}
  </div>
) : (
  <div class="shortcut-groups">
    {groups.map(group => (
      <section class="shortcut-group" aria-labelledby={`settings-shortcuts-${group.scope}`}>
        <h4 id={`settings-shortcuts-${group.scope}`}>{t(group.headingKey, locale)}</h4>
        <div class="shortcut-grid">
          {group.shortcuts.map(shortcut => (
            <div class="shortcut-row">
              <span class="shortcut-keys" data-shortcut-action={shortcut.id}>
                {shortcut.keys.map((key, index) => <>{index > 0 && " + "}<kbd>{key}</kbd></>)}
              </span>
              <span class="shortcut-label" data-shortcut-scope={group.scope}>
                {t(shortcut.labelKey, locale)}
                {shortcut.noteKey && <><span class="sr-only">. </span><span class="shortcut-note">{t(shortcut.noteKey, locale)}</span></>}
              </span>
            </div>
          ))}
        </div>
      </section>
    ))}
  </div>
)}

<style is:inline>
  .shortcut-keys {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    white-space: nowrap;
    color: var(--text-muted);
    font-size: 11px;
  }

  .shortcut-modal-grid h4,
  .shortcut-group h4 {
    font-family: inherit;
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--text-muted);
  }

  .shortcut-note {
    display: block;
    margin-top: 2px;
    font-size: 12px;
    line-height: 1.4;
    color: var(--text-secondary);
  }

  /* Help dialog: aligned Tabler keycaps + clean vertical rhythm */
  .shortcut-modal-grid {
    display: grid;
    grid-template-columns: auto 1fr;
    align-items: start;
    row-gap: 10px;
    column-gap: 16px;
    font-size: 13px;
    color: var(--text-primary);
  }

  .shortcut-modal-grid h4 {
    grid-column: 1 / -1;
    margin: 14px 0 4px;
    padding-bottom: 6px;
    border-bottom: 1px solid color-mix(in srgb, var(--border) 65%, transparent);
  }

  .shortcut-modal-grid h4:first-child {
    margin-top: 0;
  }

  .shortcut-modal-grid .shortcut-keys {
    justify-self: end;
    white-space: nowrap;
    padding-top: 1px;
  }

  .shortcut-modal-grid .shortcut-label {
    line-height: 1.45;
    font-weight: 500;
    padding-top: 2px;
  }

  .shortcut-modal-grid kbd,
  .shortcut-row kbd {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 26px;
    height: 24px;
    padding: 0 7px;
    font-family: var(--font-mono, "JetBrains Mono", ui-monospace, monospace);
    font-size: 11.5px;
    font-weight: 600;
    line-height: 1;
    color: var(--text-primary);
    background: color-mix(in srgb, var(--bg-hover) 72%, var(--bg-card));
    border: 1px solid color-mix(in srgb, var(--border) 95%, var(--text-muted) 18%);
    border-bottom-width: 2px;
    border-radius: 6px;
    box-shadow: inset 0 -1px 0 color-mix(in srgb, var(--border) 80%, transparent);
    white-space: nowrap;
  }

  /* Settings card */
  .shortcut-groups {
    display: grid;
    gap: 16px;
    margin-top: 14px;
  }

  .shortcut-group h4 {
    margin: 0 0 6px;
  }

  .shortcut-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 190px), 1fr));
    gap: 2px 16px;
  }

  .shortcut-row {
    display: flex;
    align-items: center;
    gap: 8px;
    min-width: 0;
    padding: 6px 0;
    font-size: 13px;
    color: var(--text-secondary);
  }

  .shortcut-row .shortcut-label {
    flex: 1 1 auto;
    min-width: 0;
  }
</style>
