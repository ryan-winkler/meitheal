---
import Icon from "../ui/Icon.astro"
import { readBoardNavigationContext } from "../../lib/board-workspace"
import { t } from "../../i18n/translations"
import { TASK_VIEW_ICONS, TASK_VIEW_LABELS, taskViewUrl, type TaskView } from "../../lib/task-view-route"
import type { SidebarSectionId } from "@domains/navigation/sidebar-menu"

const initialBoard = readBoardNavigationContext(Astro.url)

const views = (["calendar", "kanban", "timeline", "table"] as const satisfies readonly TaskView[]).map(id => {
  const href = taskViewUrl(new URL(initialBoard ? `/boards/${encodeURIComponent(initialBoard.boardId)}` : "/tasks", Astro.url), id, true)
  return { id, itemKey: `view-${id}`, href: href.pathname + href.search + href.hash, icon: TASK_VIEW_ICONS[id], label: TASK_VIEW_LABELS[id] }
})

export interface SidebarNavItemView {
  key: string
  label: string
  defaultLabel: string
  isActive: boolean
  href: string
  defaultHref?: string
  icon: string
  hidden: boolean
  removable?: boolean
  taskView?: TaskView
}

export interface SidebarSectionView {
  id: SidebarSectionId
  label: string
  defaultLabel: string
  hidden: boolean
  hasVisibleItems: boolean
  items: SidebarNavItemView[]
}

export interface Props {
  sections: SidebarSectionView[]
  pinnedTaskViews: readonly TaskView[]
}
const { sections, pinnedTaskViews } = Astro.props
const pinnedViewSet = new Set<string>(pinnedTaskViews)
const locale = Astro.cookies.get("meitheal-locale")?.value === "ga" ? "ga" : "en"

/** Check if a URL is external (absolute http/https) */
function isExternal(href: string): boolean {
  return /^https?:\/\//i.test(href)
}
---

<div class="sidebar-sections" data-sidebar-sections>
  {sections.map(section => (
    <section
      class="sidebar-section"
      data-sidebar-section={section.id}
      data-sidebar-section-hidden={section.hidden ? "true" : undefined}
      data-sidebar-section-empty={!section.hasVisibleItems ? "true" : undefined}
      aria-label={section.label}
    >
      <div class="sidebar-section__header" data-sidebar-section-header={section.id}>
        <button
          type="button"
          class="sidebar-edit-grip"
          data-sidebar-section-drag={section.id}
          draggable="true"
          aria-keyshortcuts="ArrowUp ArrowDown"
          aria-label={t("sidebar.reorder_section", locale, { label: section.label })}
          title={t("sidebar.reorder_section", locale, { label: section.label })}
        >
          <Icon name="grip-vertical" size={14} />
        </button>
        <span
          class="sidebar-section__title"
          data-sidebar-section-label={section.id}
          data-default-label={section.defaultLabel}
        >
          {section.label}
        </span>
        <div class="sidebar-edit-actions">
          <button
            type="button"
            class="sidebar-edit-btn"
            data-sidebar-section-rename={section.id}
            aria-label={t("sidebar.rename_section", locale, { label: section.label })}
            title={t("sidebar.rename_section", locale, { label: section.label })}
          >
            <Icon name="pencil" size={14} />
          </button>
          <button
            type="button"
            class="sidebar-edit-btn"
            data-sidebar-section-toggle={section.id}
            aria-pressed={section.hidden ? "true" : "false"}
            aria-label={section.hidden
              ? t("sidebar.show_section", locale, { label: section.label })
              : t("sidebar.hide_section", locale, { label: section.label })}
            title={section.hidden
              ? t("sidebar.show_section", locale, { label: section.label })
              : t("sidebar.hide_section", locale, { label: section.label })}
          >
            <span class="sidebar-eye-visible"><Icon name="eye" size={14} /></span>
            <span class="sidebar-eye-hidden"><Icon name="eye-off" size={14} /></span>
          </button>
        </div>
      </div>

      <ul
        class="nav-list nav-overflow__primary flex flex-col gap-1 list-none m-0 p-0 w-full"
        data-nav-overflow-primary
        data-sidebar-section-list={section.id}
        data-task-views-primary={section.items.some(item => item.key === "tasks") || undefined}
      >
        {section.items.map(item => {
          const external = isExternal(item.href)
          if (item.key === "tasks") {
            return (
              <li
                class="nav-item nav-item--tasks sidebar-nav-item relative"
                data-sidebar-group={item.key}
                data-sidebar-item-key={item.key}
                data-sidebar-item-hidden={item.hidden ? "true" : undefined}
              >
                <div class="nav-row flex items-center gap-1 min-w-0">
                  <button
                    type="button"
                    class="sidebar-edit-grip"
                    data-sidebar-item-drag={item.key}
                    draggable="true"
                    aria-keyshortcuts="ArrowUp ArrowDown"
                    aria-label={t("sidebar.reorder_item", locale, { label: item.label })}
                    title={t("sidebar.reorder_item", locale, { label: item.label })}
                  >
                    <Icon name="grip-vertical" size={14} />
                  </button>
                  <a
                    href={item.href}
                    class={`nav-link flex-1 min-w-0 ${item.isActive ? "active" : ""}`}
                    data-page={item.key}
                    data-board-nav-default={item.defaultHref ?? item.href}
                    title={item.label}
                    data-tooltip={item.label}
                    data-astro-prefetch="viewport"
                    aria-current={item.isActive ? "page" : undefined}
                    aria-label={item.label}
                  >
                    <span class="nav-icon">
                      <Icon name={item.icon as any} />
                    </span>
                    <span class="nav-label" data-sidebar-item-label={item.key} data-default-label={item.defaultLabel}>
                      {item.label}
                    </span>
                  </a>
                  <button
                    type="button"
                    class="task-view-disclosure"
                    id="tasks-submenu-toggle"
                    aria-expanded="false"
                    aria-controls="tasks-nav-submenu"
                    aria-label="Task views"
                    title="Task views"
                  >
                    <Icon name="chevron-down" size={13} />
                  </button>
                  <div class="sidebar-edit-actions">
                    <button
                      type="button"
                      class="sidebar-edit-btn"
                      data-sidebar-item-rename={item.key}
                      aria-label={t("sidebar.rename_item", locale, { label: item.label })}
                      title={t("sidebar.rename_item", locale, { label: item.label })}
                    >
                      <Icon name="pencil" size={14} />
                    </button>
                    <button
                      type="button"
                      class="sidebar-edit-btn"
                      data-sidebar-item-toggle={item.key}
                      aria-pressed={item.hidden ? "true" : "false"}
                      aria-label={item.hidden
                        ? t("sidebar.show_item", locale, { label: item.label })
                        : t("sidebar.hide_item", locale, { label: item.label })}
                      title={item.hidden
                        ? t("sidebar.show_item", locale, { label: item.label })
                        : t("sidebar.hide_item", locale, { label: item.label })}
                    >
                      <span class="sidebar-eye-visible"><Icon name="eye" size={14} /></span>
                      <span class="sidebar-eye-hidden"><Icon name="eye-off" size={14} /></span>
                    </button>
                  </div>
                </div>
                <ul id="tasks-nav-submenu" class="task-view-submenu" data-nav-overflow-submenu hidden>
                  {views.map(view => {
                    const isPinned = pinnedViewSet.has(view.id)
                    return (
                      <li class="task-view-subitem">
                        <a href={view.href} class="nav-link task-view-sublink" data-task-view-link={view.id} data-astro-prefetch="false">
                          <Icon name={view.icon} size={16} />
                          <span>{view.label}</span>
                        </a>
                        <button
                          type="button"
                          class="task-view-pin"
                          data-task-view-pin={view.id}
                          aria-pressed={String(isPinned)}
                          aria-label={isPinned ? `Unpin ${view.label} from sidebar` : `Pin ${view.label} to sidebar`}
                          title={isPinned ? `Unpin ${view.label}` : `Pin ${view.label}`}
                        >
                          <Icon name="pin" size={15} />
                        </button>
                      </li>
                    )
                  })}
                </ul>
              </li>
            )
          }

          return (
            <li
              class="sidebar-nav-item relative"
              data-sidebar-group={item.key}
              data-sidebar-item-key={item.key}
              data-sidebar-item-hidden={item.hidden ? "true" : undefined}
              data-sidebar-item-removable={item.removable ? "true" : undefined}
              data-sidebar-pin-presence={item.key === "system-pinned" || undefined}
              hidden={item.key === "system-pinned"}
            >
              <div class="nav-row flex items-center gap-1 min-w-0">
                <button
                  type="button"
                  class="sidebar-edit-grip"
                  data-sidebar-item-drag={item.key}
                  draggable="true"
                  aria-keyshortcuts="ArrowUp ArrowDown"
                  aria-label={t("sidebar.reorder_item", locale, { label: item.label })}
                  title={t("sidebar.reorder_item", locale, { label: item.label })}
                >
                  <Icon name="grip-vertical" size={14} />
                </button>
                <a
                  href={item.href}
                  class={`nav-link flex-1 min-w-0 ${item.isActive ? "active" : ""} ${external ? "nav-link--external" : ""}`}
                  data-page={item.key}
                  data-task-view-link={item.taskView}
                  data-board-nav-default={external || item.key === "settings" || item.taskView ? undefined : item.defaultHref ?? item.href}
                  title={item.label}
                  data-tooltip={item.label}
                  data-astro-prefetch={item.key === "system-pinned" || item.key === "activity" || item.key === "mentionInbox" || item.taskView ? "false" : external ? undefined : "viewport"}
                  aria-current={item.isActive ? "page" : undefined}
                  aria-describedby={item.key === "settings" ? "connection-status" : undefined}
                  aria-label={`${item.label}${external ? " (opens in new tab)" : ""}`}
                  {...(external
                    ? { target: "_blank", rel: "noopener noreferrer" }
                    : {})}
                >
                  <span class="nav-icon">
                    <Icon name={item.icon as any} />
                  </span>
                  <span class="nav-label" data-sidebar-item-label={item.key} data-default-label={item.defaultLabel}>
                    {item.label}
                  </span>
                  {item.key === "settings" && (
                    <span
                      class="status-indicator sidebar-settings-readiness"
                      id="connection-status"
                      role="status"
                      aria-live="polite"
                      data-ready={t("status.app_ready", locale)}
                      data-storage-offline={t("status.db_offline", locale)}
                      data-unreachable={t("status.app_unreachable", locale)}
                    >
                      <span class="status-dot w-2 h-2 rounded-full bg-gray-400" aria-hidden="true"></span>
                      <span class="status-text sr-only">{t("status.checking", locale)}</span>
                    </span>
                  )}
                  {external && (
                    <span class="nav-external-icon" aria-hidden="true">↗</span>
                  )}
                </a>
                {item.key === "boards" && (
                  <button
                    type="button"
                    class="task-view-disclosure"
                    data-sidebar-boards-toggle
                    aria-label={item.label}
                    aria-expanded="true"
                    aria-controls="sidebar-board-children"
                  >
                    <Icon name="chevron-down" size={13} />
                  </button>
                )}
                <div class="sidebar-edit-actions">
                  <button
                    type="button"
                    class="sidebar-edit-btn"
                    data-sidebar-item-rename={item.key}
                    aria-label={t("sidebar.rename_item", locale, { label: item.label })}
                    title={t("sidebar.rename_item", locale, { label: item.label })}
                  >
                    <Icon name="pencil" size={14} />
                  </button>
                  <button
                    type="button"
                    class="sidebar-edit-btn"
                    data-sidebar-item-toggle={item.key}
                    aria-pressed={item.hidden ? "true" : "false"}
                    aria-label={item.hidden
                      ? t("sidebar.show_item", locale, { label: item.label })
                      : t("sidebar.hide_item", locale, { label: item.label })}
                    title={item.hidden
                      ? t("sidebar.show_item", locale, { label: item.label })
                      : t("sidebar.hide_item", locale, { label: item.label })}
                  >
                    <span class="sidebar-eye-visible"><Icon name="eye" size={14} /></span>
                    <span class="sidebar-eye-hidden"><Icon name="eye-off" size={14} /></span>
                  </button>
                  {item.removable && (
                    <button
                      type="button"
                      class="sidebar-edit-btn sidebar-edit-btn--danger"
                      data-sidebar-item-remove={item.key}
                      aria-label={`Remove ${item.label}`}
                      title={`Remove ${item.label}`}
                    >
                      <Icon name="x" size={14} />
                    </button>
                  )}
                </div>
              </div>
              {item.key === "boards" && <slot name="boards" />}
            </li>
          )
        })}
      </ul>
    </section>
  ))}
</div>

<style>
  .nav-external-icon {
    margin-left: auto;
    font-size: 11px;
    opacity: 0.55;
    flex-shrink: 0;
    transition: opacity 150ms ease;
  }
  .nav-link--external:hover .nav-external-icon {
    opacity: 1;
  }

  .task-view-disclosure[hidden] { display: none !important; }

  .task-view-disclosure,
  .task-view-pin {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-inline-size: 28px;
    min-block-size: 28px;
    padding: 0;
    border: 1px solid transparent;
    border-radius: var(--radius-sm, 6px);
    background: transparent;
    color: var(--text-secondary);
    cursor: pointer;
    flex-shrink: 0;
  }

  .task-view-disclosure { border-color: var(--border); }

  :global(#sidebar[data-sidebar-editing]) .task-view-disclosure {
    display: none;
  }

  .task-view-pin:hover,
  .task-view-disclosure:hover,
  .task-view-disclosure[aria-expanded="true"] {
    background: var(--bg-hover);
    color: var(--text-primary);
  }

  .task-view-disclosure[aria-expanded="true"] svg { rotate: 180deg; }
  .task-view-pin[aria-pressed="true"] {
    background: rgb(var(--accent-rgb) / 0.14);
    color: var(--accent-text, var(--text-primary));
    border-color: rgb(var(--accent-rgb) / 0.45);
  }

  .task-view-submenu {
    display: flex;
    flex-direction: column;
    gap: 2px;
    list-style: none;
    margin: 4px 0 6px 14px;
    padding: 2px 0 2px 8px;
    border-inline-start: 1px solid var(--border);
  }

  .task-view-submenu[hidden] { display: none; }
  .task-view-subitem { display: flex; align-items: center; gap: 2px; }
  :global(.sidebar .task-view-sublink) {
    flex: 1;
    min-inline-size: 0;
    padding: 0.375rem 0.5rem;
    font-size: 0.8125rem;
  }
  .task-view-sublink svg { flex: none; }

  @media (pointer: coarse) {
    .task-view-pin, .task-view-disclosure { min-inline-size: 44px; min-block-size: 44px; }
    :global(.sidebar .task-view-sublink) { min-block-size: 44px; }
  }

  @media (min-width: 769px) {
    :global(body.sidebar-collapsed) .nav-item--tasks > .nav-row { flex-direction: column; gap: 0; }
    :global(body.sidebar-collapsed) .task-view-disclosure {
      inline-size: 40px;
    }
    @media (pointer: fine) {
      :global(body.sidebar-collapsed) .task-view-disclosure { min-block-size: 24px; }
    }

    :global(body.sidebar-collapsed) .task-view-submenu,
    :global(:root[data-appearance-navigation="navbar"]) .task-view-submenu {
      position: absolute;
      inset-block-start: calc(100% + 4px);
      inset-inline-start: 0;
      z-index: 45;
      inline-size: max-content;
      min-inline-size: 11rem;
      margin: 0;
      padding: 4px;
      border: 1px solid var(--border);
      border-radius: var(--radius-md, 8px);
      background: var(--bg-card);
      box-shadow: var(--shadow-md);
    }
    :global(body.sidebar-collapsed) .task-view-submenu {
      position: fixed;
      inset-block-start: var(--task-views-top, 8px);
      inset-inline-start: 72px;
      max-block-size: calc(100dvh - 16px);
      overflow: auto;
    }
    :global(:root[data-appearance-nav-style="floating"] body.sidebar-collapsed) .task-view-submenu {
      inset-inline-start: 78px;
    }
    :global(body.sidebar-collapsed .sidebar) .task-view-sublink {
      justify-content: start !important;
      gap: 8px !important;
      padding: 0.375rem 0.5rem !important;
    }
    :global(body.sidebar-collapsed .sidebar) .task-view-sublink span { display: inline; }
    :global(:root[data-appearance-navigation="navbar"] .nav-overflow__menu) .task-view-submenu {
      position: static;
      inline-size: auto;
      min-inline-size: 0;
      margin-inline-start: 12px;
      background: transparent;
      box-shadow: none;
    }
    :global(:root[data-appearance-navigation="navbar"] .nav-overflow__menu) .task-view-sublink {
      white-space: normal;
    }
  }
</style>

<script>
  import { boardNavigationLinks, readBoardNavigationContext } from "../../lib/board-workspace"
  import { currentTaskApiContext } from "../../lib/task-api"
  import { safeIngressHref } from "../../lib/ingress-navigation"
  import { pageLifecycle } from "../../lib/page-lifecycle"
  import { matchingTaskShortcutCriteria } from "../../lib/task-nav-types"
  import { TASK_VIEW_LOCATION_EVENT, taskBackgroundUrl } from "../../lib/task-page-url"
  import { parseTaskView, requestedTaskView, taskViewUrl } from "../../lib/task-view-route"
  import { SIDEBAR_TOGGLE_VIEW_PIN_EVENT } from "../../lib/sidebar-order"

  const runtime = window as typeof window & { __meithealSidebarActive?: AbortController }
  runtime.__meithealSidebarActive?.abort()
  const controller = new AbortController()
  runtime.__meithealSidebarActive = controller

  function appPath(path: string): string {
    const ingress = window.__ingress_path || ""
    if (ingress && (path === ingress || path.startsWith(ingress + "/"))) path = path.slice(ingress.length)
    return path.replace(/\/$/, "") || "/"
  }

  function refreshTaskViewLink(link: HTMLAnchorElement, background: URL) {
    const view = parseTaskView(link.dataset.taskViewLink ?? null)
    if (!view) return
    const logical = new URL(background)
    logical.pathname = appPath(background.pathname)
    const selected = currentTaskApiContext()
    const context = readBoardNavigationContext(logical) ?? (selected ? { boardId: selected.boardId,
      area: logical.searchParams.get("area") ?? logical.searchParams.get("area_id") ?? undefined,
      project: logical.searchParams.get("project") ?? logical.searchParams.get("project_id") ?? undefined } : undefined)
    const fromTasks = logical.pathname === "/tasks" || Boolean(context && /^\/boards\//.test(logical.pathname) && logical.searchParams.get("view") !== "groups" && !logical.searchParams.has("planning"))
    const tasks = fromTasks ? background : new URL(safeIngressHref(context ? boardNavigationLinks(context).tasks : "/boards"), background)
    if (context && appPath(tasks.pathname) === "/tasks") tasks.searchParams.set("board_id", context.boardId)
    const href = taskViewUrl(tasks, view, true).href
    if (link.href !== href) link.href = href
  }

  function updateActiveNavLink() {
    const background = taskBackgroundUrl()
    const logical = new URL(background)
    logical.pathname = appPath(background.pathname)
    const context = readBoardNavigationContext(logical)
    const scoped = context ? boardNavigationLinks(context) : undefined
    for (const link of document.querySelectorAll<HTMLAnchorElement>(".sidebar [data-page][data-board-nav-default]")) {
      const key = link.dataset.page
      const href = scoped && key && key in scoped ? scoped[key as keyof typeof scoped] : link.dataset.boardNavDefault
      if (href) link.href = safeIngressHref(href)
    }
    const disclosure = document.getElementById("tasks-submenu-toggle")
    if (disclosure) disclosure.hidden = false
    const taskPath = (url: URL) => {
      const path = appPath(url.pathname)
      return parseTaskView(path.slice(1)) ? "/tasks" : path
    }
    const viewFrom = (url: URL) => parseTaskView(appPath(url.pathname).slice(1)) ??
      requestedTaskView(url.searchParams, url.hash) ?? "kanban"
    const view = viewFrom(background)
    const backgroundPath = taskPath(background)
    const taskContext = backgroundPath === "/tasks" || Boolean(context && /^\/boards\//.test(logical.pathname) && !logical.searchParams.has("planning") && logical.searchParams.get("view") !== "groups")
    const isFilteredShortcut = (url: URL) => url.searchParams.has("types") ||
      (taskPath(url) === "/tasks" && url.searchParams.has("task_type"))
    const navLinks = [...document.querySelectorAll<HTMLAnchorElement>(".sidebar .nav-link:not(.nav-link--external)")]
    let typedLink: HTMLAnchorElement | undefined
    let matchedCriteria = -1
    for (const link of navLinks) {
      if (link.dataset.taskViewLink) continue
      const target = new URL(link.href)
      const href = taskPath(target)
      if (!isFilteredShortcut(target) || href !== backgroundPath ||
          (href === "/tasks" ? viewFrom(target) !== view : target.hash && target.hash !== background.hash)) continue
      const criteria = matchingTaskShortcutCriteria(target.searchParams, background.searchParams, view)
      if (criteria <= matchedCriteria) continue
      matchedCriteria = criteria
      typedLink = link
    }
    const activeViewLink = document.querySelector(`[data-sidebar-item-key="view-${view}"]:not([data-sidebar-item-hidden]) .nav-link`)
      ?? document.querySelector(`#tasks-nav-submenu:not([hidden]) [data-task-view-link="${view}"]`)
    navLinks.forEach(link => {
      const child = link.dataset.taskViewLink
      if (child) refreshTaskViewLink(link, background)
      const url = new URL(link.href)
      const href = appPath(url.pathname)
      const isTasksLink = link.dataset.page === "tasks"
      let active: boolean
      if (child) active = taskContext && child === view && !typedLink
      else if (isTasksLink) active = taskContext && !typedLink
      else if (context && link.dataset.page === "planning") active = logical.searchParams.get("view") === "groups" && !["goals", "routines", "pillars"].includes(logical.searchParams.get("section") ?? "")
      else if (context && link.dataset.page === "progress") active = logical.pathname === "/progress" || logical.pathname === "/habits" || (logical.searchParams.get("view") === "groups" && ["goals", "routines", "pillars"].includes(logical.searchParams.get("section") ?? ""))
      else if (isFilteredShortcut(url)) active = link === typedLink
      else if (context && link.closest("[data-sidebar-board-children]") && href === backgroundPath) {
        const selected = readBoardNavigationContext(new URL(href + url.search, url))
        active = Boolean(selected && selected.boardId === context.boardId &&
          (context.project ? selected.project === context.project : !selected.project && selected.area === context.area))
      }
      else active = (href === backgroundPath && (!url.hash || url.hash === background.hash)) ||
        (href !== "/" && backgroundPath.startsWith(href + "/"))
      link.classList.toggle("active", active)
      const currentPage = active && (child ? link === activeViewLink : !isTasksLink || !activeViewLink)
      if (currentPage && link.getAttribute("aria-current") !== "page") link.setAttribute("aria-current", "page")
      else if (!currentPage) link.removeAttribute("aria-current")
    })
  }

  function bindTaskViews(signal: AbortSignal) {
    const nav = document.querySelector<HTMLElement>('[data-nav-overflow="sidebar"]')
    const group = nav?.querySelector<HTMLElement>(".nav-item--tasks")
    const submenu = group?.querySelector<HTMLElement>("#tasks-nav-submenu")
    const trigger = group?.querySelector<HTMLButtonElement>("#tasks-submenu-toggle")
    if (!nav || !group || !submenu || !trigger) return

    const positionCompactMenu = () => {
      if (submenu.hidden || !document.body.classList.contains("sidebar-collapsed")) return
      const top = Math.max(8, Math.min(trigger.getBoundingClientRect().top, innerHeight - submenu.offsetHeight - 8))
      submenu.style.setProperty("--task-views-top", `${Math.round(top)}px`)
    }
    const setOpen = (open: boolean) => {
      submenu.hidden = !open
      trigger.setAttribute("aria-expanded", String(open))
      positionCompactMenu()
      updateActiveNavLink()
    }

    trigger.addEventListener("click", () => setOpen(Boolean(submenu.hidden)), { signal })
    group.addEventListener("focusout", event => {
      if (!submenu.hidden && !nav.hasAttribute("data-nav-overflow-reflowing") &&
          !group.contains(event.relatedTarget as Node | null)) setOpen(false)
    }, { signal })
    group.addEventListener("keydown", event => {
      if (event.key === "Escape" && !submenu.hidden) {
        event.preventDefault()
        setOpen(false)
        trigger.focus()
      }
    }, { signal })
    nav.addEventListener("click", event => {
      const target = event.target instanceof Element ? event.target : null
      const link = target?.closest<HTMLAnchorElement>("#tasks-nav-submenu [data-task-view-link]")
      if (link) {
        setOpen(false)
      }
      const pin = target?.closest<HTMLElement>("[data-task-view-pin]")
      const pinnedView = parseTaskView(pin?.dataset.taskViewPin ?? null)
      if (pinnedView) {
        event.preventDefault()
        event.stopPropagation()
        window.dispatchEvent(new CustomEvent(SIDEBAR_TOGGLE_VIEW_PIN_EVENT, { detail: { view: pinnedView } }))
      }
    }, { signal, capture: true })
    document.addEventListener("click", event => {
      if (!submenu.hidden && event.target instanceof Node && !group.contains(event.target)) setOpen(false)
    }, { signal })
    nav.addEventListener("scroll", positionCompactMenu, { signal, passive: true })
    window.addEventListener("resize", positionCompactMenu, { signal })
  }

  let boundSignal: AbortSignal | undefined
  pageLifecycle.onPageLoad(pageSignal => {
    if (controller.signal.aborted || boundSignal === pageSignal || !document.getElementById("sidebar")) return
    boundSignal = pageSignal
    const signal = AbortSignal.any([pageSignal, controller.signal])
    bindTaskViews(signal)
    updateActiveNavLink()
    window.addEventListener("popstate", updateActiveNavLink, { signal })
    window.addEventListener("hashchange", updateActiveNavLink, { signal })
    document.addEventListener(TASK_VIEW_LOCATION_EVENT, updateActiveNavLink, { signal })
  })
</script>
