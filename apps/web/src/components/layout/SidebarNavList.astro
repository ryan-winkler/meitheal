---
import Icon from "../ui/Icon.astro";

export interface Props {
  navItems: {
    key: string;
    label: string;
    isActive: boolean;
    href: string;
    icon: string;
    showBadge?: boolean;
  }[];
  taskCounts: {
    total: number;
    active: number;
    pending: number;
  };
}
const { navItems, taskCounts } = Astro.props;

/** Check if a URL is external (absolute http/https) */
function isExternal(href: string): boolean {
  return /^https?:\/\//i.test(href);
}
---

<ul class="nav-list flex flex-col gap-1 list-none m-0 p-0 w-full">
  {
    navItems.map((item) => {
      const external = isExternal(item.href);
      return (
        <li>
          <a
            href={item.href}
            class={`nav-link ${item.isActive ? "active" : ""} ${external ? "nav-link--external" : ""}`}
            data-page={item.key}
            title={item.label}
            data-tooltip={item.label}
            data-astro-prefetch={item.key === "system-pinned" ? "false" : external ? undefined : "viewport"}
            aria-current={item.isActive ? "page" : undefined}
            aria-label={`${item.label}${external ? " (opens in new tab)" : ""}`}
            {...(external
              ? { target: "_blank", rel: "noopener noreferrer" }
              : {})}
          >
            <span class="nav-icon">
              <Icon name={item.icon as any} />
            </span>
            <span class="nav-label">{item.label}</span>
            {external && (
              <span
                class="nav-external-icon"
                aria-hidden="true"
                title="Opens in new tab"
              >
                ↗
              </span>
            )}
            {item.showBadge && (
              <span
                class="nav-badge"
                id={`nav-count-${item.key}`}
                aria-hidden="true"
              >
                {taskCounts.active}
              </span>
            )}
          </a>
        </li>
      );
    })
  }
</ul>

<style>
  .nav-external-icon {
    margin-left: auto;
    font-size: 11px;
    opacity: 0.5;
    transition: opacity 150ms ease;
  }
  .nav-link--external:hover .nav-external-icon {
    opacity: 1;
  }
</style>

<script>
  // Active nav link — reusable for View Transitions
  function updateActiveNavLink() {
    const rawPath = window.location.pathname;
    const ip = window.__ingress_path || "";
    const currentPath =
      ip && rawPath.startsWith(ip) ? rawPath.slice(ip.length) || "/" : rawPath;
    document.querySelectorAll(".sidebar .nav-link").forEach((link) => {
      // Skip external links — they never get "active" state
      if (link.classList.contains("nav-link--external")) return;
      link.classList.remove("active");
      link.removeAttribute("aria-current");
      const rawHref = link.getAttribute("href") || "";
      const href = ip && rawHref.startsWith(ip + "/") ? rawHref.slice(ip.length) : rawHref;
      if (
        href === currentPath ||
        (href !== "/" && currentPath.startsWith(href + "/")) ||
        (currentPath === "/" && link.getAttribute("data-page") === "dashboard")
      ) {
        link.classList.add("active");
        link.setAttribute("aria-current", "page");
      }
    });
  }
  updateActiveNavLink();

  // Re-run after View Transitions swap
  document.addEventListener("astro:after-swap", updateActiveNavLink);
</script>
