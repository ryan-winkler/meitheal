---
import { t } from "../../i18n/translations";
import type { Locale } from "../../lib/locale";
import Icon from "../ui/Icon.astro";
import SidebarNavList from "./SidebarNavList.astro";
import SidebarHierarchyTree from "./SidebarHierarchyTree.astro";
import SidebarFooter from "./SidebarFooter.astro";
import StreakBadge from "../gamification/StreakBadge.astro";
import {
  ensureSchema,
  getPersistenceClient,
} from "@domains/tasks/persistence/store";
import { getStats as getGamificationStats } from "@domains/gamification";
import { getFeatureFlags } from "../../lib/feature-flags";

const currentPath = Astro.url.pathname;
export interface Props {
  locale?: Locale;
  taskCounts?: { total: number; active: number; pending: number };
}
const {
  locale = Astro.cookies.get("meitheal-locale")?.value === "ga" ? "ga" : "en",
  taskCounts = { total: 0, active: 0, pending: 0 },
} = Astro.props;

/** Default nav item definitions */
interface NavItemDef {
  href: string;
  i18nKey: string;
  icon: string;
  matchExact?: boolean;
  showBadge?: boolean;
}

const NAV_ITEMS: Record<string, NavItemDef> = {
  dashboard: {
    href: "/",
    i18nKey: "nav.dashboard",
    icon: "dashboard",
    matchExact: true,
  },
  today: { href: "/today", i18nKey: "nav.today", icon: "today" },
  upcoming: { href: "/upcoming", i18nKey: "nav.upcoming", icon: "upcoming" },
  tasks: {
    href: "/tasks",
    i18nKey: "nav.tasks",
    icon: "kanban",
  },
  activity: { href: "/activity", i18nKey: "recent_activity.title", icon: "today", matchExact: true },
  progress: {
    href: "/progress",
    i18nKey: "nav.progress",
    icon: "trophy",
  },
  planning: {
    href: "/planning",
    i18nKey: "nav.planning",
    icon: "eisenhower",
  },
};

type NavKey = string;
const DEFAULT_ORDER: NavKey[] = [
  "dashboard",
  "today",
  "upcoming",
  "tasks",
  "activity",
  "progress",
  "planning",
];

interface CustomNavItem {
  id: string;
  href: string;
  icon: string;
  label: string;
}

/** Sidebar configuration from settings DB */
interface SidebarConfig {
  /** Visibility toggles (legacy format preserved) */
  [key: string]: unknown;
  /** Display order — array of nav keys */
  order?: string[];
  /** Custom labels per nav key */
  labels?: Record<string, string>;
  /** Custom dynamically added nav items */
  customItems?: CustomNavItem[];
}

let sidebarConfig: SidebarConfig = {
  dashboard: true,
  today: true,
  upcoming: true,
  tasks: true,
  progress: true,
  planning: true,
};

/** Feature flags — hide gamification/habits if disabled */
const ff = await getFeatureFlags();
const gamificationEnabled = ff.gamification !== false;
const habitsEnabled = ff.habits !== false;
const hierarchyEnabled = ff.hierarchy !== false;

/** Fetch streak data for sidebar badge */
let currentStreak = 0;
if (gamificationEnabled) {
  try {
    const stats = await getGamificationStats();
    currentStreak = stats.currentStreak;
  } catch {
    /* gamification schema may not exist yet */
  }
}

try {
  await ensureSchema();
  const c = getPersistenceClient();
  const res = await c.execute(
    "SELECT value FROM settings WHERE key = 'sidebar_config'",
  );
  if (res.rows.length > 0) {
    let parsed = JSON.parse(String(res.rows[0]?.value));
    // Handle double-encoded JSON (API stores JSON.stringify'd values)
    if (typeof parsed === "string") {
      try {
        parsed = JSON.parse(parsed);
      } catch {
        /* not double-encoded */
      }
    }
    if (parsed && typeof parsed === "object") {
      sidebarConfig = { ...sidebarConfig, ...parsed };
    }
  }
} catch (e) {
  const { logApiError } = await import("@lib/api-logger");
  logApiError("sidebar", "load_sidebar_config", e);
  // DB fallback — use defaults
}

/** Inject custom items into NAV_ITEMS before processing */
if (Array.isArray(sidebarConfig.customItems)) {
  sidebarConfig.customItems.forEach((c) => {
    if (c.id && c.id !== "system-pinned" && c.href) {
      NAV_ITEMS[c.id] = {
        href: c.href,
        i18nKey: "",
        icon: c.icon || "link",
        matchExact: false, // Default matching
      };
      if (!sidebarConfig.labels) sidebarConfig.labels = {};
      sidebarConfig.labels[c.id] = c.label || c.id;
    }
  });
}

/** Build ordered, filtered nav item list */
const rawOrder: NavKey[] =
  Array.isArray(sidebarConfig.order) && sidebarConfig.order.length > 0
    ? (sidebarConfig.order as string[]).filter((k: string) => k in NAV_ITEMS)
    : [];
// Fall back to defaults if saved order is empty / invalid, then append any missing defaults
const order: NavKey[] = rawOrder.length > 0 ? rawOrder : [...DEFAULT_ORDER];
DEFAULT_ORDER.forEach((k) => {
  if (!order.includes(k)) order.push(k);
});
// Append custom items that were injected into NAV_ITEMS but aren't in the order yet
Object.keys(NAV_ITEMS).forEach((k) => {
  if (!order.includes(k)) order.push(k);
});

const labels: Record<string, string> =
  (sidebarConfig.labels as Record<string, string>) ?? {};

const navItems = order
  .filter((key) => {
    if (sidebarConfig[key] === false) return false
    if (!(key in NAV_ITEMS)) return false
    // Feature flag: hide progress parent page when all sub-features disabled
    if (key === "progress" && !gamificationEnabled && !habitsEnabled) return false
    if (key === "tasks" && !hierarchyEnabled) return false
    if (key === "activity" && !Astro.locals.hassUserId) return false
    return true
  })
  .map((key) => {
    const def = NAV_ITEMS[key]!;
    const label = labels[key] || t(def.i18nKey, locale);
    const isActive = def.matchExact
      ? currentPath === def.href
      : currentPath.startsWith(def.href);
    return { key, label, isActive, ...def };
  });
const tasksIndex = navItems.findIndex(item => item.key === "tasks")
const pinIndex = tasksIndex >= 0 ? tasksIndex + 1 : navItems.findIndex(item => item.key === "today") + 1
navItems.splice(pinIndex, 0, {
  key: "system-pinned", href: "/pinned", label: t("pins.title", locale), i18nKey: "pins.title",
  icon: "pin", isActive: currentPath === "/pinned", matchExact: true,
})
---

<nav
  class="sidebar hidden md:flex"
  id="sidebar"
  role="navigation"
  aria-label="Main Navigation"
>
  <div class="sidebar-header flex items-center gap-2 pb-4 mb-0 px-2">
    <button
      type="button"
      class="sidebar-toggle-top flex items-center justify-center p-1.5 rounded-md text-text-muted hover:text-text-primary hover:bg-bg-hover transition-colors shrink-0 relative w-8 h-8"
      id="sidebar-toggle-btn"
      aria-label="Toggle sidebar (Ctrl+B)"
      title="Toggle sidebar (Ctrl+B)"
    >
      <Icon name="menu-open" class="sidebar-icon-expanded w-5 h-5 shrink-0 absolute" />
      <Icon name="menu" class="sidebar-icon-collapsed w-5 h-5 shrink-0 absolute hidden" />
    </button>
    <div class="sidebar-brand-group flex flex-col min-w-0">
      <a
        href="/"
        data-astro-prefetch="viewport"
        class="sidebar-brand text-xl font-bold tracking-tight text-text-primary hover:text-accent transition-colors flex items-center gap-2 no-underline overflow-hidden shrink min-w-0"
        aria-label="Meitheal Home"
        title="Ag Obair le Chéile — Working Together"
      >
        <svg
          xmlns="http://www.w3.org/2000/svg"
          viewBox="0 0 100 100"
          width="24"
          height="24"
          aria-hidden="true"
          class="sidebar-logo-svg shrink-0"
        >
          <rect width="100" height="100" rx="22" fill="var(--bg-primary, #0F172A)"
          ></rect>
          <path
            d="M25 65 L50 30 L75 65"
            fill="none"
            stroke="var(--accent, #6366F1)"
            stroke-width="6"
            stroke-linecap="round"
            stroke-linejoin="round"></path>
          <path
            d="M35 65 L65 65"
            fill="none"
            stroke="var(--border, #334155)"
            stroke-width="4"
            stroke-dasharray="4 4"
            stroke-linecap="round"></path>
          <path
            d="M50 35 L50 65"
            fill="none"
            stroke="var(--border, #334155)"
            stroke-width="4"
            stroke-dasharray="4 4"
            stroke-linecap="round"></path>
          <circle cx="50" cy="30" r="7" fill="#F59E0B"></circle>
          <circle cx="25" cy="65" r="7" fill="var(--accent, #6366F1)"></circle>
          <circle cx="75" cy="65" r="7" fill="var(--accent, #6366F1)"></circle>
        </svg>
        <span class="sidebar-brand-text truncate">Meitheal</span>
      </a>
      <span class="sidebar-ipa font-medium" aria-hidden="true">/ˈmʲɛhəlˠ/</span>
    </div>
  </div>

  <div class="sidebar-scroll">
    <SidebarNavList navItems={navItems} taskCounts={taskCounts} />
    {hierarchyEnabled && <SidebarHierarchyTree locale={locale} />}
  </div>

  {gamificationEnabled && (
    <div class="sidebar-gamification-wrapper">
      <StreakBadge streak={currentStreak} compact />
    </div>
  )}

  <SidebarFooter locale={locale} />


</nav>

<style>
  .sidebar {
    display: flex;
    flex-direction: column;
    height: 100%;
    background: rgba(var(--bg-secondary-rgb), 0.9);
    backdrop-filter: blur(12px);
    border-right: 1px solid var(--border);
    transition: transform 300ms ease;
    width: 240px;
    position: fixed;
    z-index: 40;
    padding: 1rem;
    overflow: hidden;
  }

  .sidebar-scroll {
    flex: 1;
    overflow-y: auto;
    overflow-x: hidden;
    overscroll-behavior: contain;
    min-height: 0;
    padding-top: 8px;
    scrollbar-width: none; /* Hide scrollbar Firefox */
    -webkit-overflow-scrolling: touch;
    overscroll-behavior: contain;
  }

  /* Hide scrollbar WebKit */
  .sidebar-scroll::-webkit-scrollbar {
    display: none;
  }

  .sidebar-header {
    margin-bottom: 1.5rem;
    padding: 0 0.5rem;
    position: relative;
  }

  .sidebar-ipa {
    display: block;
    font-size: 10px;
    font-style: italic;
    color: var(--text-secondary);
    letter-spacing: 0.3px;
    padding-inline-start: 2rem;
    margin-top: 1px;
    line-height: 1;
    user-select: none;
    font-family: "Noto Sans", system-ui, sans-serif;
  }

  .sidebar-tooltip {
    display: none;
    position: absolute;
    left: 0.5rem;
    top: calc(100% + 2px);
    /* Prevent overflow clipping — constrain width to sidebar */
    max-width: calc(100% - 1rem);
    white-space: normal;
    overflow-wrap: break-word;
    font-size: 10px;
    font-weight: 400;
    font-style: italic;
    color: var(--text-muted);
    background: var(--bg-card);
    border: 1px solid var(--border);
    border-radius: 6px;
    padding: 3px 8px;
    pointer-events: none;
    z-index: 50;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.15);
  }

  :global(body:not(.sidebar-collapsed)) .sidebar-header:hover .sidebar-tooltip {
    display: block !important;
    animation: tooltip-fade-in 200ms ease forwards;
  }

  @keyframes tooltip-fade-in {
    from {
      opacity: 0;
      transform: translateY(-2px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  /* Subtle amber pulse on the logo apex node when hovering the brand link */
  .sidebar-brand:hover .sidebar-logo-svg circle[fill="#F59E0B"] {
    animation: amber-pulse 1.5s ease-in-out infinite;
  }

  @keyframes amber-pulse {
    0%,
    100% {
      filter: drop-shadow(0 0 0 transparent);
    }
    50% {
      filter: drop-shadow(0 0 6px rgba(245, 158, 11, 0.5));
    }
  }

  /* Expose these styles globally for the sub-components to use cleanly without duplicate scopes */
  :global(.sidebar .nav-links) {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    list-style: none;
    padding: 0;
    margin: 0 0 1.5rem 0;
  }

  :global(.sidebar .nav-link) {
    display: flex;
    align-items: center;
    justify-content: flex-start;
    padding: 0.5rem 0.75rem;
    border-radius: var(--radius-sm, 6px);
    font-size: 0.875rem;
    font-weight: 500;
    color: var(--text-secondary);
    transition: background 200ms ease, color 200ms ease, border-color 200ms ease, opacity 200ms ease, transform 200ms ease;
    text-decoration: none;
  }

  :global(.sidebar .nav-link:hover) {
    background: var(--bg-hover);
    color: var(--text-primary);
    transform: translateX(0.25rem);
  }

  :global(.sidebar .nav-link.active) {
    background: rgba(var(--accent-rgb), 0.1);
    color: var(--accent-text);
  }

  :global(.sidebar .nav-link.active .nav-icon) {
    color: var(--accent-text);
  }

  :global(.sidebar .nav-icon) {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 1.5rem;
    height: 1.5rem;
    margin-right: 0.75rem;
    color: var(--text-muted);
    transition: color 200ms ease;
  }

  :global(.sidebar .nav-badge) {
    margin-left: auto;
    background: var(--bg-primary);
    color: var(--text-muted);
    font-size: 10px;
    font-weight: 700;
    padding: 0.125rem 0.5rem;
    border-radius: 9999px;
    border: 1px solid rgba(var(--border-rgb), 0.5);
    min-width: 20px;
    text-align: center;
  }

  /* --- Mobile sidebar --- */
  @media (max-width: 768px) {
    .sidebar {
      display: flex !important;
      transform: translateX(-100%);
      transition: transform 250ms ease;
    }

    .sidebar.open {
      transform: translateX(0);
      z-index: 200;
      box-shadow: 4px 0 24px rgba(0, 0, 0, 0.4);
    }

  }

  .sidebar-gamification-wrapper {
    padding: 0.5rem 0.75rem;
    border-top: 1px solid var(--border, #334155);
  }
</style>
