---
import { newOrganizationLabel, organizationLabelsFor, type OrganizationTerm } from "@lib/organization-labels"
import rawSidebarReorderCss from "../../styles/_sidebar-reorder.css?raw"
import { minifyInlineCss } from "../../lib/minify-inline-css"
const sidebarReorderCss = minifyInlineCss(rawSidebarReorderCss)
import { t } from "../../i18n/translations"
import type { Locale } from "../../lib/locale"
import Icon from "../ui/Icon.astro"
import SidebarHierarchyActions from "./SidebarHierarchyActions.astro"
import SidebarNavList, { type SidebarNavItemView, type SidebarSectionView } from "./SidebarNavList.astro"
import { currentBoardContext } from "@lib/named-board-request"
import { resolveBoardPageScope } from "@lib/board-http"
import { scopePermits, type BoardScope } from "@domains/tasks"
import TaskCreationMenu from "./TaskCreationMenu.astro"
import NavOverflowMore from "./NavOverflowMore.astro"
import SidebarFooter from "./SidebarFooter.astro"
import StreakBadge from "../gamification/StreakBadge.astro"
import {
  ensureSchema,
  getPersistenceClient,
} from "@domains/tasks/persistence/store"
import { getDailyProgress } from "@domains/gamification"
import { boardNavigationLinks, readBoardNavigationContext } from "@lib/board-workspace"
import { readCachedSidebarAndProfile } from "@lib/shell-settings-cache"
import { getFeatureFlags } from "../../lib/feature-flags"
import { TASK_VIEW_ICONS, TASK_VIEW_LABELS, taskViewUrl, type TaskView } from "../../lib/task-view-route"
import {
  CUSTOM_LINK_ICONS,
  DEFAULT_SIDEBAR_SECTIONS,
  TASK_VIEW_ITEM_KEYS,
  flattenSidebarOrder,
  isBuiltinSidebarSectionId,
  isItemHidden,
  isStoredItemHidden,
  isSectionHidden,
  normalizeSidebarConfig,
  serializeSidebarConfig,
} from "@domains/navigation/sidebar-menu"
import { normalizeUserProfile, type UserProfile } from "@domains/auth/user-profile"
import { getCachedHAUserName, isRawHAUserId, resolveCachedHAUserDisplayName } from "@domains/ha"

const currentPath = Astro.url.pathname
const workNavigation = Astro.props.workNavigation
const selectedScope = workNavigation ? { ok: true as const, scope: workNavigation.scope } : await resolveBoardPageScope(Astro).catch(() => null)
const captureDenied = selectedScope?.ok === true && !scopePermits(selectedScope.scope, { resource: "task", action: "create" })
const boardContext = readBoardNavigationContext(Astro.url) ?? (selectedScope?.ok ? { boardId: selectedScope.scope.boardId } : undefined)
const boardLinks = boardContext ? boardNavigationLinks(boardContext) : undefined
const settingsHref = boardContext?.boardId ? `/settings?board_id=${encodeURIComponent(boardContext.boardId)}` : "/settings"

export interface Props {
  workNavigation?: { scope: BoardScope, dailyStreak?: number } | undefined
  locale?: Locale
}
const {
  locale = Astro.cookies.get("meitheal-locale")?.value === "ga" ? "ga" : "en",
} = Astro.props

/** Default nav item definitions */
interface NavItemDef {
  href: string
  i18nKey: string
  icon: string
  matchExact?: boolean
  taskView?: TaskView
  defaultLabel?: string
}

const taskViewBaseUrl = new URL(boardContext ? `/boards/${encodeURIComponent(boardContext.boardId)}` : "/tasks", Astro.url)
const taskViewHref = (view: TaskView) => {
  const url = taskViewUrl(taskViewBaseUrl, view, true)
  return url.pathname + url.search + url.hash
}

const NAV_ITEMS: Record<string, NavItemDef> = {
  dashboard: {
    href: "/?view=dashboard",
    i18nKey: "nav.dashboard",
    icon: "dashboard",
    matchExact: true,
  },
  today: { href: "/today", i18nKey: "nav.today", icon: "today" },
  upcoming: { href: "/upcoming", i18nKey: "nav.upcoming", icon: "upcoming" },
  tasks: {
    href: "/tasks",
    i18nKey: "nav.tasks",
    icon: "kanban",
  },
  "view-calendar": {
    href: taskViewHref("calendar"),
    i18nKey: "",
    defaultLabel: TASK_VIEW_LABELS.calendar,
    icon: TASK_VIEW_ICONS.calendar,
    taskView: "calendar",
  },
  "view-kanban": {
    href: taskViewHref("kanban"),
    i18nKey: "",
    defaultLabel: TASK_VIEW_LABELS.kanban,
    icon: TASK_VIEW_ICONS.kanban,
    taskView: "kanban",
  },
  "view-timeline": {
    href: taskViewHref("timeline"),
    i18nKey: "",
    defaultLabel: TASK_VIEW_LABELS.timeline,
    icon: TASK_VIEW_ICONS.timeline,
    taskView: "timeline",
  },
  "view-table": {
    href: taskViewHref("table"),
    i18nKey: "",
    defaultLabel: TASK_VIEW_LABELS.table,
    icon: TASK_VIEW_ICONS.table,
    taskView: "table",
  },
  "system-pinned": {
    href: "/pinned",
    i18nKey: "pins.title",
    icon: "pin",
    matchExact: true,
  },
  mentionInbox: { href: "/mention-inbox", i18nKey: "mention_inbox.title", icon: "inbox", matchExact: true },
  activity: { href: "/activity", i18nKey: "recent_activity.title", icon: "bolt", matchExact: true },
  progress: {
    href: "/progress",
    i18nKey: "nav.progress",
    icon: "trophy",
  },
  boards: { href: "/boards", i18nKey: "Boards", icon: "kanban" },
  planning: {
    href: "/planning",
    i18nKey: "nav.planning",
    icon: "eisenhower",
  },
  settings: {
    href: settingsHref,
    i18nKey: "nav.settings",
    icon: "settings",
  },
}

let showNamedBoardShortcuts = false
let rawSidebarConfig: unknown = null
let rawUserProfile: unknown = null

/** Feature flags — hide gamification/habits if disabled */
const ff = await getFeatureFlags()
const gamificationEnabled = ff.gamification !== false
const hierarchyEnabled = ff.hierarchy !== false && ff.organizer !== false

/** Fetch streak data for sidebar badge */
let currentStreak = 0
if (gamificationEnabled && selectedScope?.ok) {
  try {
    currentStreak = workNavigation?.dailyStreak ?? (await getDailyProgress(selectedScope.scope)).currentStreak
  } catch {
    /* gamification schema may not exist yet */
  }
}

try {
  await ensureSchema()
  const c = getPersistenceClient()
  showNamedBoardShortcuts = hierarchyEnabled && Boolean(await currentBoardContext(Astro))
  ;({ rawSidebarConfig, rawUserProfile } = await readCachedSidebarAndProfile(c))
} catch (e) {
  const { logApiError } = await import("@lib/api-logger")
  logApiError("sidebar", "load_sidebar_config", e)
}

const eligibleBuiltInKeys = Object.keys(NAV_ITEMS).filter(key => {
  if (key === "planning" && ff.planning === false) return false
  if (key === "progress" && ff.pillars === false && ff.goals === false && ff.habits === false && ff.gamification === false) return false
  if (key === "boards" && !hierarchyEnabled) return false
  if ((key === "activity" || key === "mentionInbox") && !Astro.locals.hassUserId) return false
  return true
})

const sidebarMenuConfig = normalizeSidebarConfig(rawSidebarConfig, eligibleBuiltInKeys)
const customItemIds = new Set(sidebarMenuConfig.customItems.map(item => item.id))

for (const custom of sidebarMenuConfig.customItems) {
  NAV_ITEMS[custom.id] = {
    href: custom.href,
    i18nKey: "",
    defaultLabel: custom.label,
    icon: custom.icon || "link",
    matchExact: false,
  }
}

const resolveLabel = await organizationLabelsFor(Astro)
const quickCreate = newOrganizationLabel(resolveLabel("task", false, locale === "en" ? "task" : undefined), locale)
const terminology: Partial<Record<string, OrganizationTerm>> = {
  boards: "board", tasks: "task", planning: "planning", progress: "progress",
}

const sectionMetaMap = new Map<string, (typeof DEFAULT_SIDEBAR_SECTIONS)[number]>(DEFAULT_SIDEBAR_SECTIONS.map(section => [section.id, section]))

const sections: SidebarSectionView[] = sidebarMenuConfig.sectionOrder.map(sectionId => {
  const spec = sectionMetaMap.get(sectionId)
  const defaultLabel = spec ? t(spec.i18nKey, locale) : sectionId
  const label = sidebarMenuConfig.sectionLabels[sectionId] || defaultLabel
  const hidden = isSectionHidden(sidebarMenuConfig, sectionId)
  const keys = sidebarMenuConfig.sectionItems[sectionId] ?? []

  const items: SidebarNavItemView[] = keys
    .filter(key => key in NAV_ITEMS)
    .map(key => {
      const def = NAV_ITEMS[key]!
      const term = terminology[key]
      const customEntry = sidebarMenuConfig.customItems.find(entry => entry.id === key)
      const baseLabel = customEntry?.label
        || def.defaultLabel
        || (key === "boards" ? (locale === "ga" ? "Cláir" : "Boards") : t(def.i18nKey, locale))
      const defaultItemLabel = term ? resolveLabel(term, true, baseLabel) : baseLabel
      const itemLabel = sidebarMenuConfig.itemLabels[key] || defaultItemLabel
      const resolvedHref = key === "settings"
        ? settingsHref
        : key === "system-pinned"
          ? (boardLinks?.pinned ?? "/pinned")
          : def.taskView
            ? def.href
            : (boardLinks && key in boardLinks ? boardLinks[key as keyof typeof boardLinks] : def.href)
      const comparePath = def.href.split("?", 1)[0] ?? def.href
      const isActive = def.taskView
        ? false
        : def.matchExact
          ? currentPath === comparePath
          : currentPath === comparePath || currentPath.startsWith(comparePath + "/")

      return {
        key,
        label: itemLabel,
        defaultLabel: defaultItemLabel,
        isActive,
        href: resolvedHref,
        defaultHref: def.href,
        icon: def.icon,
        hidden: isItemHidden(sidebarMenuConfig, key),
        removable: customItemIds.has(key),
        taskView: def.taskView,
      }
    })

  const hasVisibleItems = items.some(item => !item.hidden && item.key !== "system-pinned")
  return {
    id: sectionId,
    label,
    defaultLabel,
    hidden,
    hasVisibleItems,
    removable: !isBuiltinSidebarSectionId(sectionId),
    items,
  }
})

const pinnedTaskViews: TaskView[] = TASK_VIEW_ITEM_KEYS
  .filter(key => !isItemHidden(sidebarMenuConfig, key))
  .map(key => key.slice("view-".length) as TaskView)

const sidebarDefaultOrder = flattenSidebarOrder(sidebarMenuConfig)
const serializedSidebarConfig = serializeSidebarConfig(sidebarMenuConfig)

const hassUserId = Astro.locals.hassUserId
const cachedHaIdentity = hassUserId ? await resolveCachedHAUserDisplayName(hassUserId).catch(() => null) : null
const cachedHaRosterName = hassUserId ? getCachedHAUserName(hassUserId) : undefined
const rawHaDisplayName = Astro.locals.hassDisplayName || cachedHaIdentity?.displayName || cachedHaRosterName || Astro.locals.hassUserName
const haDisplayName = typeof rawHaDisplayName === "string" && rawHaDisplayName.trim() && !isRawHAUserId(rawHaDisplayName)
  ? rawHaDisplayName.trim()
  : undefined
const rawHaUsername = Astro.locals.hassUserName || cachedHaIdentity?.username
const haUsername = typeof rawHaUsername === "string" && rawHaUsername.trim() && !isRawHAUserId(rawHaUsername)
  ? rawHaUsername.trim()
  : undefined
const userProfile: UserProfile = normalizeUserProfile(rawUserProfile, {
  displayName: haDisplayName ?? "Household Member",
  username: haUsername ?? (haDisplayName ? haDisplayName.toLowerCase().replace(/[^a-z0-9]+/g, "").slice(0, 24) : "local"),
  role: Astro.locals.hassIsAdmin ? "Admin" : "",
})

const areasVisible = !isItemHidden(sidebarMenuConfig, "areas") && !isStoredItemHidden(rawSidebarConfig, "areas")
---

<nav
  class="sidebar hidden md:flex"
  id="sidebar"
  role="navigation"
  aria-label="Main Navigation"
  data-sidebar-config={JSON.stringify(serializedSidebarConfig)}
  data-sidebar-server-config={JSON.stringify(serializedSidebarConfig)}
  data-storage-error={t("sidebar.reorder_storage_error", locale)}
>
  <button
    type="button"
    class="sidebar-edge-toggle"
    id="sidebar-edge-toggle"
    aria-label="Collapse sidebar (Ctrl+B)"
    aria-expanded="true"
    aria-controls="sidebar"
    title="Collapse sidebar (Ctrl+B)"
  >
    <span class="sidebar-edge-toggle__circle" aria-hidden="true">
      <span class="sidebar-edge-toggle__icon">
        <Icon name="chevron-down" size={14} sprite={true} />
      </span>
    </span>
  </button>

  <div class="sidebar-header flex items-center gap-2 pb-3 mb-0">
    <div class="sidebar-brand-group flex flex-col flex-1 min-w-0">
      <a
        href="/?view=dashboard"
        data-astro-prefetch="hover"
        class="sidebar-brand text-xl font-medium tracking-[-0.05em] text-text-primary hover:text-accent transition-colors flex items-center gap-2 no-underline overflow-hidden shrink min-w-0"
        aria-label="meitheal. Home"
        title="meitheal. — Keep track of the work your home needs"
      >
        <svg
          xmlns="http://www.w3.org/2000/svg"
          viewBox="0 0 64 64"
          width="26"
          height="26"
          aria-hidden="true"
          class="sidebar-logo-svg shrink-0"
        >
          <rect width="64" height="64" rx="13" fill="#10231b"></rect>
          <path
            d="M15 41V25m0 6c0-5 3-8 7-8s7 3 7 8v10m0-10c0-5 3-8 7-8s7 3 7 8v10"
            fill="none"
            stroke="#edf5ef"
            stroke-linecap="round"
            stroke-width="5"></path>
          <circle cx="52" cy="40" r="3.8" fill="var(--accent, #75e9be)"></circle>
        </svg>
        <span class="sidebar-brand-stack">
          <span class="sidebar-brand-text truncate">meitheal.</span>
          <span class="sidebar-ipa" aria-hidden="true">/meh·hal/</span>
        </span>
      </a>
    </div>
    <button
      type="button"
      class="sidebar-toggle-top ml-auto flex items-center justify-center rounded-md text-text-muted hover:text-text-primary hover:bg-bg-hover transition-colors shrink-0 w-11 h-11"
      id="sidebar-toggle-btn"
      aria-controls="sidebar"
      aria-label={t("topbar.close_menu", locale)}
      title={t("topbar.close_menu", locale)}
    >
      <Icon name="x" size={20} sprite={true} />
    </button>
  </div>

  <div class="sidebar-main">
    <div class="sidebar-cta-wrap">
      <TaskCreationMenu id="sidebar-task-types" variant="sidebar">
        <button
          type="button"
          id="sidebar-rail-new-task"
          disabled={captureDenied}
          class="sidebar-rail-cta"
          data-tooltip={quickCreate}
          aria-label={quickCreate}
        >
          <span class="sidebar-rail-cta__icon" aria-hidden="true">
            <Icon name="plus" size={18} sprite={true} />
          </span>
          <span class="sidebar-rail-cta__label">{quickCreate}</span>
        </button>
      </TaskCreationMenu>
    </div>

    <div class="sidebar-scroll" data-nav-overflow="sidebar" data-sidebar-default-order={JSON.stringify(sidebarDefaultOrder)}>
      <SidebarNavList sections={sections} pinnedTaskViews={pinnedTaskViews}>
        <ul slot="boards" id="sidebar-board-children" class="sidebar-board-children" data-sidebar-board-children
          data-sidebar-boards={showNamedBoardShortcuts ? "" : undefined} data-board-group-label={resolveLabel("group", true, sidebarMenuConfig.itemLabels.areas || undefined)}
          data-board-project-label={resolveLabel("project", true)} data-projects-enabled={String(ff.projects !== false)}
          data-areas-enabled={String(ff.groups !== false && areasVisible)} aria-label={resolveLabel("board", true)}>
        </ul>
      </SidebarNavList>
      <NavOverflowMore id="sidebar-more-destinations" list locale={locale} />
      <SidebarHierarchyActions />
    </div>
  </div>

  <!-- Edit Mode Actions: Per-User Scope, Add Section, Add Custom Link + Icon Picker, Leave Edit Mode -->
  <div class="sidebar-edit-footer" data-sidebar-leave-edit hidden>
    <div class="sidebar-edit-scope" role="note">
      <span class="sidebar-edit-scope__badge">
        <Icon name="user" size={12} sprite={true} />
        <span>Per-user menu</span>
      </span>
      <button
        type="button"
        class="sidebar-edit-scope__reset"
        data-sidebar-reset-personal
        hidden
      >
        Reset to server default
      </button>
    </div>

    <div class="sidebar-edit-moves" data-sidebar-edit-moves hidden>
      <button
        type="button"
        data-sidebar-step="-1"
        aria-label={t("sidebar.reorder_up", locale)}
        title={t("sidebar.reorder_up", locale)}
      >
        <Icon name="chevron-down" size={16} class="rotate-180" />
      </button>
      <button
        type="button"
        data-sidebar-step="1"
        aria-label={t("sidebar.reorder_down", locale)}
        title={t("sidebar.reorder_down", locale)}
      >
        <Icon name="chevron-down" size={16} />
      </button>
    </div>

    <div class="sidebar-edit-quick-actions">
      <button
        type="button"
        id="sidebar-add-section-btn"
        class="sidebar-add-link-trigger"
        data-sidebar-add-section-trigger
        aria-expanded="false"
        aria-controls="sidebar-add-section-form"
      >
        <Icon name="folder" size={14} sprite={true} />
        <span>Add section</span>
      </button>

      <button
        type="button"
        id="sidebar-add-link-btn"
        class="sidebar-add-link-trigger"
        data-sidebar-add-link-trigger
        aria-expanded="false"
        aria-controls="sidebar-add-link-form"
      >
        <Icon name="link" size={14} sprite={true} />
        <span>Add custom link</span>
      </button>
    </div>

    <form id="sidebar-add-section-form" class="sidebar-add-link-form" data-sidebar-add-section-form hidden novalidate>
      <input
        type="text"
        name="sectionLabel"
        class="form-input"
        placeholder="Section name (e.g. Smart Home)"
        maxlength="64"
        required
        aria-label="New section name"
      />
      <p class="sidebar-add-link-error" data-sidebar-add-section-error role="alert" hidden></p>
      <div class="sidebar-add-link-actions">
        <button type="button" class="btn btn-ghost" data-sidebar-add-section-cancel>Cancel</button>
        <button type="submit" class="btn btn-primary">Add section</button>
      </div>
    </form>

    <form id="sidebar-add-link-form" class="sidebar-add-link-form" data-sidebar-add-link-form hidden novalidate>
      <input
        type="text"
        name="label"
        class="form-input"
        placeholder="Label (e.g. Home Assistant)"
        maxlength="64"
        required
        aria-label="Custom link label"
      />
      <input
        type="text"
        name="href"
        class="form-input"
        placeholder="URL (https://… or /path)"
        required
        aria-label="Custom link URL"
      />
      <select name="section" class="form-select" aria-label="Section">
        {sections.map(sec => (
          <option value={sec.id}>{sec.label}</option>
        ))}
      </select>
      <div class="sidebar-icon-picker-wrap">
        <span class="sidebar-icon-picker__label">Icon</span>
        <input type="hidden" name="icon" value="link" />
        <div class="sidebar-icon-picker" role="group" aria-label="Choose link icon" data-link-icon-picker>
          {CUSTOM_LINK_ICONS.map(iconName => (
            <button
              type="button"
              class={`sidebar-icon-choice${iconName === "link" ? " is-selected" : ""}`}
              data-link-icon-choice={iconName}
              aria-pressed={iconName === "link" ? "true" : "false"}
              aria-label={`Icon: ${iconName.replace(/-/g, " ")}`}
              title={iconName.replace(/-/g, " ")}
            >
              <Icon name={iconName} size={15} sprite={true} />
            </button>
          ))}
        </div>
      </div>
      <p class="sidebar-add-link-error" data-sidebar-add-link-error role="alert" hidden></p>
      <div class="sidebar-add-link-actions">
        <button type="button" class="btn btn-ghost" data-sidebar-add-link-cancel>Cancel</button>
        <button type="submit" class="btn btn-primary">Pin link</button>
      </div>
    </form>

    <button type="button" id="sidebar-leave-edit" class="sidebar-leave-edit__btn" data-sidebar-leave-edit-btn>
      <Icon name="check" size={16} sprite={true} />
      <span>{t("sidebar.leave_edit_mode", locale)}</span>
    </button>
  </div>
  <span role="status" aria-live="polite" class="sr-only" data-sidebar-reorder-status></span>

  {gamificationEnabled && currentStreak > 0 && (
    <div class="sidebar-gamification-wrapper">
      <StreakBadge
        streak={currentStreak}
        compact
        href={boardLinks?.progress ? `${boardLinks.progress.replace(/#.*$/, "")}#achievements-streaks` : "/progress#achievements-streaks"}
      />
    </div>
  )}

  <SidebarFooter locale={locale} profile={userProfile} settingsHref={settingsHref} />
</nav>

<script>
  import { pageLifecycle } from "@lib/page-lifecycle"
  import { bindSidebarBoards } from "@lib/sidebar-boards"
  import { bindSidebarReorder } from "@lib/sidebar-order"
  import { bindSidebarPinPresence } from "@lib/sidebar-pin-presence"
  import { bindSidebarUserMenu } from "@lib/sidebar-user-menu"

  const runtime = window as Window & { __meithealSidebarController?: AbortController }
  runtime.__meithealSidebarController?.abort()
  const controller = new AbortController()
  runtime.__meithealSidebarController = controller
  let boundSignal: AbortSignal | undefined
  pageLifecycle.onPageLoad(pageSignal => {
    if (controller.signal.aborted || boundSignal === pageSignal) return
    boundSignal = pageSignal
    const signal = AbortSignal.any([pageSignal, controller.signal])
    bindSidebarBoards(signal)
    const sidebar = document.getElementById("sidebar")
    const capture = sidebar?.querySelector<HTMLButtonElement>("#sidebar-rail-new-task")
    const capturePermission = document.querySelector<HTMLMetaElement>('meta[name="meitheal-task-create"]')
    if (capture && capturePermission) capture.disabled = capturePermission.content !== "true"
    if (capture) {
      document.addEventListener("meitheal:board-revoked", event => {
        const boardId = (event as CustomEvent<{ boardId?: string }>).detail?.boardId
        if (boardId && boardId === document.querySelector<HTMLMetaElement>('meta[name="meitheal-work-board"]')?.content) capture.disabled = true
      }, { signal })
    }
    if (sidebar) {
      // Recent activity restores through guarded browser history.
      bindSidebarPinPresence(sidebar, signal, Boolean(document.querySelector("[data-recent-activity]")))
      bindSidebarReorder(sidebar, signal)
      bindSidebarUserMenu(sidebar, signal)
    }
  })
</script>

<style>
  .sidebar {
    display: flex;
    flex-direction: column;
    height: 100%;
    background: var(--bg-secondary);
    border-right: 1px solid var(--border);
    transition:
      width 220ms cubic-bezier(0.23, 1, 0.32, 1),
      box-shadow 220ms cubic-bezier(0.23, 1, 0.32, 1),
      transform 220ms cubic-bezier(0.23, 1, 0.32, 1);
    width: var(--sidebar-width, 240px);
    position: fixed;
    z-index: 75;
    padding: 0.875rem 0.75rem;
    overflow: visible;
  }

  :global(body.sidebar-collapsed) .sidebar {
    width: 64px;
    padding-inline: 0.5rem;
  }

  @media (min-width: 769px) {
    .sidebar-toggle-top {
      display: none !important;
    }
  }

  .sidebar-main { display: contents; }

  .sidebar-scroll {
    flex: 1;
    overflow-y: auto;
    overflow-x: hidden;
    overscroll-behavior: contain;
    min-height: 0;
    padding-top: 4px;
    scrollbar-width: none;
    -webkit-overflow-scrolling: touch;
  }

  @media (max-width: 768px) {
    .sidebar-main {
      display: block;
      flex: 1;
      min-height: 0;
      overflow-y: auto;
      overscroll-behavior: contain;
    }
    .sidebar-scroll { overflow: visible; }
  }

  .sidebar-scroll::-webkit-scrollbar {
    display: none;
  }

  .sidebar-header {
    margin-bottom: 0.625rem;
    padding: 0.125rem 0.25rem 0.625rem;
    position: relative;
  }

  .sidebar-brand-stack {
    display: flex;
    flex-direction: column;
    justify-content: center;
    min-width: 0;
    min-height: 36px;
    gap: 2px;
  }

  .sidebar-brand-text {
    line-height: 22px;
    height: 22px;
  }

  .sidebar-ipa {
    display: block;
    font-size: 10px;
    font-style: normal;
    color: var(--text-secondary);
    letter-spacing: 0.06em;
    line-height: 12px;
    height: 12px;
    overflow: hidden;
    user-select: none;
    font-family: "JetBrains Mono", ui-monospace, monospace;
  }

  @media (hover: hover) and (pointer: fine) {
    .sidebar-brand:hover .sidebar-logo-svg circle {
      filter: drop-shadow(0 0 5px rgb(var(--accent-rgb) / 0.55));
    }
  }

  :global(.sidebar .nav-links) {
    display: flex;
