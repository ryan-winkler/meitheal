---
import { newOrganizationLabel, organizationLabelsFor, type OrganizationTerm } from "@lib/organization-labels"
import "../../styles/_sidebar-reorder.css"
import { t } from "../../i18n/translations";
import type { Locale } from "../../lib/locale";
import Icon from "../ui/Icon.astro";
import SidebarHierarchyTree from "./SidebarHierarchyTree.astro"
import SidebarNavList from "./SidebarNavList.astro";
import { householdBoardIsActive } from "@domains/tasks/persistence/named-board-repository"
import TaskCreationMenu from "./TaskCreationMenu.astro";
import NavOverflowMore from "./NavOverflowMore.astro";
import SidebarFooter from "./SidebarFooter.astro";
import StreakBadge from "../gamification/StreakBadge.astro";
import {
  ensureSchema,
  getPersistenceClient,
} from "@domains/tasks/persistence/store";
import { getDailyProgress } from "@domains/gamification";
import { verifiedIngressUser } from "../../lib/verified-ingress-user"
import { getFeatureFlags } from "../../lib/feature-flags";

const currentPath = Astro.url.pathname;
export interface Props {
  locale?: Locale;
}
const {
  locale = Astro.cookies.get("meitheal-locale")?.value === "ga" ? "ga" : "en",
} = Astro.props;

/** Default nav item definitions */
interface NavItemDef {
  href: string;
  i18nKey: string;
  icon: string;
  matchExact?: boolean;
}

const NAV_ITEMS: Record<string, NavItemDef> = {
  dashboard: {
    href: "/?view=dashboard",
    i18nKey: "nav.dashboard",
    icon: "dashboard",
    matchExact: true,
  },
  today: { href: "/today", i18nKey: "nav.today", icon: "today" },
  upcoming: { href: "/upcoming", i18nKey: "nav.upcoming", icon: "upcoming" },
  tasks: {
    href: "/tasks",
    i18nKey: "nav.tasks",
    icon: "kanban",
  },
  mentionInbox: { href: "/mention-inbox", i18nKey: "mention_inbox.title", icon: "inbox", matchExact: true },
  activity: { href: "/activity", i18nKey: "recent_activity.title", icon: "bolt", matchExact: true },
  progress: {
    href: "/progress",
    i18nKey: "nav.progress",
    icon: "trophy",
  },
  boards: { href: "/boards", i18nKey: "Boards", icon: "kanban" },
  areas: {
    href: "/planning#spaces",
    i18nKey: "sidebar.areas_header",
    icon: "folder",
  },
  planning: {
    href: "/planning",
    i18nKey: "nav.planning",
    icon: "eisenhower",
  },
};

type NavKey = string;
const DEFAULT_ORDER: NavKey[] = [
  "dashboard",
  "today",
  "upcoming",
  "tasks",
  "activity",
  "mentionInbox",
  "progress",
  "planning",
  "boards",
  "areas",
];

interface CustomNavItem {
  id: string;
  href: string;
  icon: string;
  label: string;
}

/** Sidebar configuration from settings DB */
interface SidebarConfig {
  /** Visibility toggles (legacy format preserved) */
  [key: string]: unknown;
  /** Display order — array of nav keys */
  order?: string[];
  /** Custom labels per nav key */
  labels?: Record<string, string>;
  /** Custom dynamically added nav items */
  customItems?: CustomNavItem[];
}


let showNamedBoardShortcuts = false
let householdActive = true
let sidebarConfig: SidebarConfig = {
  dashboard: true,
  today: true,
  upcoming: true,
  tasks: true,
  progress: true,
  planning: true,
  areas: true,
};

/** Feature flags — hide gamification/habits if disabled */
const ff = await getFeatureFlags();
const gamificationEnabled = ff.gamification !== false;
const habitsEnabled = ff.habits !== false;
const hierarchyEnabled = ff.hierarchy !== false && ff.organizer !== false;

/** Fetch streak data for sidebar badge */
let currentStreak = 0;
if (gamificationEnabled) {
  try {
    const stats = await getDailyProgress(Astro.locals);
    currentStreak = stats.currentStreak;
  } catch {
    /* gamification schema may not exist yet */
  }
}

try {
  await ensureSchema();
  const c = getPersistenceClient();
  householdActive = await householdBoardIsActive(c)
  if (hierarchyEnabled && verifiedIngressUser(Astro.locals)) {
    const epoch = await c.execute("SELECT 1 FROM board_access_epoch LIMIT 1")
    showNamedBoardShortcuts = epoch.rows.length > 0
  }
  const res = await c.execute(
    "SELECT value FROM settings WHERE key = 'sidebar_config'",
  );
  if (res.rows.length > 0) {
    let parsed = JSON.parse(String(res.rows[0]?.value));
    // Handle double-encoded JSON (API stores JSON.stringify'd values)
    if (typeof parsed === "string") {
      try {
        parsed = JSON.parse(parsed);
      } catch {
        /* not double-encoded */
      }
    }
    if (parsed && typeof parsed === "object") {
      sidebarConfig = { ...sidebarConfig, ...parsed };
    }
  }
} catch (e) {
  const { logApiError } = await import("@lib/api-logger");
  logApiError("sidebar", "load_sidebar_config", e);
  // DB fallback — use defaults
}

/** Inject custom items into NAV_ITEMS before processing */
if (Array.isArray(sidebarConfig.customItems)) {
  sidebarConfig.customItems.forEach((c) => {
    if (c.id && c.id !== "system-pinned" && c.href) {
      NAV_ITEMS[c.id] = {
        href: c.href,
        i18nKey: "",
        icon: c.icon || "link",
        matchExact: false, // Default matching
      };
      if (!sidebarConfig.labels) sidebarConfig.labels = {};
      sidebarConfig.labels[c.id] = c.label || c.id;
    }
  });
}

/** Build ordered, filtered nav item list */
const rawOrder: NavKey[] =
  Array.isArray(sidebarConfig.order) && sidebarConfig.order.length > 0
    ? (sidebarConfig.order as string[]).filter((k: string) => k in NAV_ITEMS)
    : [];
// Fall back to defaults if saved order is empty / invalid, then append any missing defaults
const order: NavKey[] = rawOrder.length > 0
  ? [...new Set(rawOrder.map(key => key === "areas" && !rawOrder.includes("boards") ? "boards" : key))]
  : [...DEFAULT_ORDER];
DEFAULT_ORDER.forEach((k) => {
  if (!order.includes(k)) order.push(k);
});
// Append custom items that were injected into NAV_ITEMS but aren't in the order yet
Object.keys(NAV_ITEMS).forEach((k) => {
  if (!order.includes(k)) order.push(k);
});

const labels: Record<string, string> =
  (sidebarConfig.labels as Record<string, string>) ?? {};

const resolveLabel = await organizationLabelsFor(Astro)
const quickCreate = newOrganizationLabel(resolveLabel("task", false, locale === "en" ? "task" : undefined), locale)
const terminology: Partial<Record<string, OrganizationTerm>> = {
  boards: "board", tasks: "task", planning: "planning", progress: "progress",
}
const navItems = order
  .filter((key) => {
    if (sidebarConfig[key] === false) return false
    if (!(key in NAV_ITEMS)) return false
    // Feature flag: hide progress parent page when all sub-features disabled
    if (key === "areas") return false
    if (key === "planning" && ff.planning === false) return false
    if (key === "progress" && ff.pillars === false && ff.goals === false && ff.habits === false && ff.gamification === false) return false
    if (key === "boards" && !hierarchyEnabled) return false
    if ((key === "activity" || key === "mentionInbox") && !Astro.locals.hassUserId) return false
    return true
  })
  .map((key) => {
    const def = NAV_ITEMS[key]!;
    const term = terminology[key];
    const defaultLabel = labels[key] || (key === "boards" ? (locale === "ga" ? "Cláir" : "Boards") : t(def.i18nKey, locale));
    const label = term ? resolveLabel(term, true, defaultLabel) : defaultLabel;
    const isActive = def.matchExact
      ? currentPath === def.href.split("?", 1)[0]
      : currentPath.startsWith(def.href);
    return { key, label, isActive, ...def };
  });
const tasksIndex = navItems.findIndex(item => item.key === "tasks")
const pinIndex = tasksIndex >= 0 ? tasksIndex + 1 : navItems.findIndex(item => item.key === "today") + 1
navItems.splice(pinIndex, 0, {
  key: "system-pinned", href: "/pinned", label: t("pins.title", locale), i18nKey: "pins.title",
  icon: "pin", isActive: currentPath === "/pinned", matchExact: true,
})

const householdGroups = householdActive && hierarchyEnabled && sidebarConfig.areas !== false && ff.groups !== false
const householdGroupLabel = resolveLabel("group", true, labels.areas)
const sidebarDefaultOrder = navItems.map(item => item.key)

---

<nav
  class="sidebar hidden md:flex"
  id="sidebar"
  role="navigation"
  aria-label="Main Navigation"
>
  <button
    type="button"
    class="sidebar-edge-toggle"
    id="sidebar-edge-toggle"
    aria-label="Collapse sidebar (Ctrl+B)"
    aria-expanded="true"
    aria-controls="sidebar"
    title="Collapse sidebar (Ctrl+B)"
  >
    <span class="sidebar-edge-toggle__circle" aria-hidden="true">
      <span class="sidebar-edge-toggle__icon">
        <Icon name="chevron-down" size={14} />
      </span>
    </span>
  </button>

  <div class="sidebar-header flex items-center gap-2 pb-4 mb-0 px-2">
    <div class="sidebar-brand-group flex flex-col flex-1 min-w-0">
      <a
        href="/?view=dashboard"
        data-astro-prefetch="viewport"
        class="sidebar-brand text-xl font-medium tracking-[-0.05em] text-text-primary hover:text-accent transition-colors flex items-center gap-2 no-underline overflow-hidden shrink min-w-0"
        aria-label="Meitheal Home"
        title="meitheal. — Keep track of the work your home needs"
      >
        <svg
          xmlns="http://www.w3.org/2000/svg"
          viewBox="0 0 64 64"
          width="26"
          height="26"
          aria-hidden="true"
          class="sidebar-logo-svg shrink-0"
        >
          <rect width="64" height="64" rx="13" fill="#10231b"></rect>
          <path
            d="M15 41V25m0 6c0-5 3-8 7-8s7 3 7 8v10m0-10c0-5 3-8 7-8s7 3 7 8v10"
            fill="none"
            stroke="#edf5ef"
            stroke-linecap="round"
            stroke-width="5"></path>
          <circle cx="52" cy="40" r="3.8" fill="var(--accent, #75e9be)"></circle>
        </svg>
        <span class="sidebar-brand-text truncate">meitheal.</span>
      </a>
      <span class="sidebar-ipa" aria-hidden="true">/meh·hal/</span>
    </div>
    <button
      type="button"
      class="sidebar-toggle-top ml-auto flex items-center justify-center rounded-md text-text-muted hover:text-text-primary hover:bg-bg-hover transition-colors shrink-0 w-11 h-11"
      id="sidebar-toggle-btn"
      aria-controls="sidebar"
      aria-label={t("topbar.close_menu", locale)}
      title={t("topbar.close_menu", locale)}
    >
      <Icon name="x" size={20} />
    </button>
  </div>

  <div class="sidebar-main">
    <div class="sidebar-cta-wrap">
      <TaskCreationMenu id="sidebar-task-types" variant="sidebar">
        <button
          type="button"
          id="sidebar-rail-new-task"
          class="sidebar-rail-cta"
          data-tooltip={quickCreate}
          aria-label={quickCreate}
        >
          <span class="sidebar-rail-cta__icon" aria-hidden="true">
            <Icon name="plus" size={18} />
          </span>
          <span class="sidebar-rail-cta__label">{quickCreate}</span>
        </button>
      </TaskCreationMenu>
    </div>

    <div class="sidebar-scroll" data-nav-overflow="sidebar" data-sidebar-default-order={JSON.stringify(sidebarDefaultOrder)}>
      <SidebarNavList navItems={navItems}>
        <ul slot="boards" id="sidebar-board-children" class="sidebar-board-children" data-sidebar-board-children
          data-sidebar-boards={showNamedBoardShortcuts ? "" : undefined} data-board-group-label={resolveLabel("group", true)}
          data-board-project-label={resolveLabel("project", true)} data-projects-enabled={String(ff.projects !== false)}
          data-areas-enabled={String(ff.groups !== false)} aria-label={resolveLabel("board", true)}>
          {householdActive && <li class="sidebar-household" data-sidebar-household>
            <a class="nav-link sidebar-household-link" href="/boards/household" aria-current={currentPath === "/boards/household" ? "page" : undefined}>Household</a>
            {householdGroups && <div id="sidebar-hierarchy-panel"><SidebarHierarchyTree locale={locale} label={householdGroupLabel} /></div>}
          </li>}

        </ul>
      </SidebarNavList>
      <NavOverflowMore id="sidebar-more-destinations" list locale={locale} />
    </div>
  </div>

  <div class="sidebar-reorder-tools" data-sidebar-reorder-tools hidden
    data-moved={t("sidebar.reordered", locale)} data-storage-error={t("sidebar.reorder_storage_error", locale)}>
    <button type="button" class="sidebar-reorder-button" aria-pressed="false" data-sidebar-reorder-toggle
      data-start-label={t("sidebar.reorder", locale)} data-done-label={t("sidebar.reorder_done", locale)}>
      <Icon name="adjustments-horizontal" size={16} />
      <span>{t("sidebar.reorder", locale)}</span>
    </button>
    <div class="sidebar-reorder-moves" data-sidebar-reorder-moves hidden>
      <button type="button" class="sidebar-reorder-button" data-sidebar-move="-1"
        aria-label={t("sidebar.reorder_up", locale)} title={t("sidebar.reorder_up", locale)} disabled>
        <Icon name="chevron-down" size={16} class="rotate-180" />
      </button>
      <button type="button" class="sidebar-reorder-button" data-sidebar-move="1"
        aria-label={t("sidebar.reorder_down", locale)} title={t("sidebar.reorder_down", locale)} disabled>
        <Icon name="chevron-down" size={16} />
      </button>
    </div>
    <span role="status" class="sr-only" data-sidebar-reorder-status></span>
  </div>

  {gamificationEnabled && (
    <div class="sidebar-gamification-wrapper">
      <StreakBadge streak={currentStreak} compact />
    </div>
  )}

  <SidebarFooter locale={locale} />


</nav>

<script>
  import { pageLifecycle } from "@lib/page-lifecycle"
  import { bindSidebarBoards } from "@lib/sidebar-boards"
  import { bindSidebarReorder } from "@lib/sidebar-order"
  import { bindSidebarPinPresence } from "@lib/sidebar-pin-presence"

  const runtime = window as Window & { __meithealSidebarController?: AbortController }
  runtime.__meithealSidebarController?.abort()
  const controller = new AbortController()
  runtime.__meithealSidebarController = controller
  let boundSignal: AbortSignal | undefined
  pageLifecycle.onPageLoad(pageSignal => {
    if (controller.signal.aborted || boundSignal === pageSignal) return
    boundSignal = pageSignal
    const signal = AbortSignal.any([pageSignal, controller.signal])
    bindSidebarBoards(signal)
    const sidebar = document.getElementById("sidebar")
    if (sidebar) {
      // Recent activity restores through guarded browser history.
      bindSidebarPinPresence(sidebar, signal, Boolean(document.querySelector("[data-recent-activity]")))
      bindSidebarReorder(sidebar, signal)
    }
  })
</script>

<style>
  .sidebar-board-children { list-style: none; margin: 0; padding-inline-start: 1rem; }
  .sidebar-board-children[hidden] { display: none; }
  .sidebar-household { margin-inline-start: 0; }
  :global(:root[data-appearance-navigation="navbar"]) .sidebar-household { margin-inline-start: 0; }
  :global(body.sidebar-collapsed) .sidebar-board-children { display: none; }
  .sidebar-board-children :global([data-named-board-shortcut] a) { display: block; padding: 0.3rem 0; overflow-wrap: anywhere; }
  .sidebar-board-children :global(.sidebar-board-row) { display: flex; align-items: center; }
  .sidebar-board-children :global(.sidebar-board-row .nav-link) { flex: 1; min-width: 0; }
  .sidebar-board-children :global(.sidebar-board-toggle[aria-expanded="true"]) { transform: rotate(90deg); }
  .sidebar-board-children :global([data-board-groups]), .sidebar-board-children :global([data-board-projects]) { list-style: none; padding-left: 1rem; }
  .sidebar-household[hidden] { display: none; }

  .sidebar {
    display: flex;
    flex-direction: column;
    height: 100%;
    background: var(--bg-secondary);
    border-right: 1px solid var(--border);
    transition:
      width 220ms cubic-bezier(0.23, 1, 0.32, 1),
      box-shadow 220ms cubic-bezier(0.23, 1, 0.32, 1),
      transform 220ms cubic-bezier(0.23, 1, 0.32, 1);
    width: var(--sidebar-width, 240px);
    position: fixed;
    z-index: 40;
    padding: 0.875rem 0.75rem;
    overflow: visible;
  }

  .sidebar-edge-toggle {
    position: absolute;
    top: 56px;
    right: -16px;
    width: 32px;
    height: 32px;
    padding: 0;
    border: 0;
    background: transparent;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    z-index: 50;
    color: var(--text-secondary);
    transition: transform 160ms cubic-bezier(0.23, 1, 0.32, 1);
  }

  .sidebar-edge-toggle__circle {
    width: 28px;
    height: 28px;
    border-radius: 9999px;
    background: var(--bg-card);
    border: 1px solid var(--border);
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.16);
    display: inline-flex;
    align-items: center;
    justify-content: center;
    transition:
      background-color 180ms cubic-bezier(0.23, 1, 0.32, 1),
      border-color 180ms cubic-bezier(0.23, 1, 0.32, 1),
      color 180ms cubic-bezier(0.23, 1, 0.32, 1),
      transform 160ms cubic-bezier(0.23, 1, 0.32, 1);
  }

  .sidebar-edge-toggle:hover .sidebar-edge-toggle__circle,
  .sidebar-edge-toggle:focus-visible .sidebar-edge-toggle__circle {
    background: var(--bg-hover);
    border-color: var(--accent);
    color: var(--text-primary);
  }

  .sidebar-edge-toggle:active .sidebar-edge-toggle__circle {
    transform: scale(0.94);
  }

  .sidebar-edge-toggle__icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    transition: transform 200ms cubic-bezier(0.23, 1, 0.32, 1);
    transform: rotate(90deg);
  }

  :global(body.sidebar-collapsed) .sidebar-edge-toggle__icon {
    transform: rotate(-90deg);
  }

  @media (min-width: 769px) {
    .sidebar-toggle-top {
      display: none !important;
    }
  }

  .sidebar-main { display: contents; }

  .sidebar-cta-wrap {
    padding: 0 0.25rem 0.625rem;
    flex-shrink: 0;
  }

  .sidebar-rail-cta {
    width: 100%;
    min-height: 38px;
    padding: 0 0.75rem;
    border-radius: 10px;
    border: 1px solid rgb(var(--accent-rgb) / 0.38);
    background: rgb(var(--accent-rgb) / 0.14);
    color: var(--text-primary);
    display: flex;
    align-items: center;
    justify-content: flex-start;
    gap: 0.625rem;
    font-size: 0.875rem;
    font-weight: 600;
    cursor: pointer;
    transition:
      background-color 180ms cubic-bezier(0.23, 1, 0.32, 1),
      border-color 180ms cubic-bezier(0.23, 1, 0.32, 1),
      transform 140ms cubic-bezier(0.23, 1, 0.32, 1);
  }

  .sidebar-rail-cta:hover,
  .sidebar-rail-cta:focus-visible {
    background: rgb(var(--accent-rgb) / 0.22);
    border-color: var(--accent);
  }

  .sidebar-rail-cta:active {
    transform: scale(0.97);
  }

  .sidebar-rail-cta__icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  .sidebar-rail-cta__label {
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  @media (max-width: 768px) {
    .sidebar-edge-toggle {
      display: none !important;
    }
  }

  /* Scope through .sidebar so this outranks the global .nav-link display. */
  .sidebar .sidebar-compact-areas {
    display: none;
  }

  @media (min-width: 769px) {
    :global(body.sidebar-collapsed) .sidebar .sidebar-compact-areas {
      display: flex;
    }

    :global(body.sidebar-collapsed) #sidebar-hierarchy-panel :global(#project-nav) {
      display: none;
    }
  }

  .sidebar-scroll {
    flex: 1;
    overflow-y: auto;
    overflow-x: hidden;
    overscroll-behavior: contain;
    min-height: 0;
    padding-top: 8px;
    scrollbar-width: none; /* Hide scrollbar Firefox */
    -webkit-overflow-scrolling: touch;
    overscroll-behavior: contain;
  }

  @media (max-width: 768px) {
    .sidebar-main {
      display: block;
      flex: 1;
      min-height: 0;
      overflow-y: auto;
      overscroll-behavior: contain;
    }
    .sidebar-scroll { overflow: visible; }
  }

  /* Hide scrollbar WebKit */
  .sidebar-scroll::-webkit-scrollbar {
    display: none;
  }

  .sidebar-header {
    margin-bottom: 0.625rem;
    padding: 0 0.25rem;
    position: relative;
  }

  .sidebar-ipa {
    display: block;
    font-size: 9.5px;
    font-style: normal;
    color: var(--text-muted);
    letter-spacing: 0.09em;
    padding-inline-start: 2.125rem;
    margin-top: 2px;
    line-height: 1;
    user-select: none;
    font-family: "JetBrains Mono", ui-monospace, monospace;
  }

  .sidebar-tooltip {
    display: none;
    position: absolute;
    left: 0.5rem;
    top: calc(100% + 2px);
    /* Prevent overflow clipping — constrain width to sidebar */
    max-width: calc(100% - 1rem);
    white-space: normal;
    overflow-wrap: break-word;
    font-size: 10px;
    font-weight: 400;
    font-style: italic;
    color: var(--text-muted);
    background: var(--bg-card);
    border: 1px solid var(--border);
    border-radius: 6px;
    padding: 3px 8px;
    pointer-events: none;
    z-index: 50;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.15);
  }

  :global(body:not(.sidebar-collapsed)) .sidebar-header:hover .sidebar-tooltip {
    display: block !important;
    animation: tooltip-fade-in 200ms ease forwards;
  }

  @keyframes tooltip-fade-in {
    from {
      opacity: 0;
      transform: translateY(-2px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  /* Subtle mint glow on the brand completion dot when hovering the brand link */
  @media (hover: hover) and (pointer: fine) {
    .sidebar-brand:hover .sidebar-logo-svg circle {
      filter: drop-shadow(0 0 5px rgb(var(--accent-rgb) / 0.55));
    }
  }

  /* Expose these styles globally for the sub-components to use cleanly without duplicate scopes */
  :global(.sidebar .nav-links) {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    list-style: none;
    padding: 0;
    margin: 0 0 1.5rem 0;
  }

  :global(.sidebar .nav-link) {
    display: flex;
    align-items: center;
    justify-content: flex-start;
    gap: 0.625rem;
    padding: 0.5rem 0.625rem;
    border-radius: var(--radius-sm, 6px);
    font-size: 0.875rem;
    font-weight: 500;
    color: var(--text-secondary);
    transition: background 160ms var(--ease-out, ease), color 160ms var(--ease-out, ease), border-color 160ms var(--ease-out, ease), opacity 160ms var(--ease-out, ease), transform 160ms var(--ease-out, ease);
    text-decoration: none;
  }

  :global(.sidebar .nav-link:active) {
    transform: scale(0.97);
  }

  @media (hover: hover) and (pointer: fine) {
    :global(.sidebar .nav-link:hover) {
      background: var(--bg-hover);
      color: var(--text-primary);
      transform: translateX(2px);
    }
  }

  :global(.sidebar .nav-link.active) {
    background: rgb(var(--accent-rgb) / 0.1);
    color: var(--accent-text);
  }

  :global(.sidebar .nav-link.active .nav-icon) {
    color: var(--accent-text);
  }

  :global(.sidebar .nav-icon) {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 1.5rem;
    height: 1.5rem;
    margin-right: 0.75rem;
