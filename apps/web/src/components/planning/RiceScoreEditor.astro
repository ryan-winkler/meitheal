---
import type { TaskRow } from "@domains/tasks/persistence/task-repository"
import { frameworkPayloadObject, readRiceAssessment, RICE_FIELDS } from "@lib/rice-lens"
import { clampSliderTrackValue, getScoringSliderConfig } from "@lib/rice-slider-config"
import { formatTicketKey } from "@lib/ticket-key"
import type { Locale } from "@lib/locale"
import { t } from "../../i18n/translations"
import Icon from "../ui/Icon.astro"

interface Props {
  task: TaskRow
  closeHref: string
  savedHref: string
  locale: Locale
}

const { task, closeHref, savedHref, locale } = Astro.props
let payload: Record<string, unknown> = {}
try {
  payload = frameworkPayloadObject(JSON.parse(task.framework_payload))
} catch {
  // Older imports may lack a framework payload.
}
const nested = frameworkPayloadObject(payload.rice)
const assessment = readRiceAssessment(payload)
const legacyAmbiguous = assessment.status === "legacy_ambiguous" ? assessment : null
const values = assessment.status !== "unscored" ? assessment.inputs : { ...payload, ...nested }
const score = assessment.status === "scored" ? assessment.score : null
---

<form
  class="rice-editor card"
  aria-labelledby="rice-editor-heading"
  data-rice-editor={task.id}
  data-rice-version={task.task_version}
  data-rice-payload={JSON.stringify(payload)}
  data-invalid={t("planning_rice.invalid", locale)}
  data-conflict={t("planning_rice.conflict", locale)}
  data-error={t("planning_rice.error", locale)}
  data-saved={t("planning_rice.saved", locale)}
>
  <div class="card-header rice-editor__header">
    <div class="rice-editor__title-row">
      <Icon name="calculator" size={18} sprite class="rice-editor__icon" />
      <h3 id="rice-editor-heading" tabindex="-1">
        {t("planning_rice.edit", locale)}
        <span class="rice-editor__task-label">
          <code class="rice-editor__key">{formatTicketKey(task.ticket_number ?? 0)}</code>
          {task.title}
        </span>
      </h3>
    </div>
    <a class="btn btn-outline btn-sm" href={closeHref} data-astro-prefetch="false" aria-label={t("planning_rice.close", locale)}>
      <Icon name="x" size={14} sprite />
    </a>
  </div>
  <div class="card-body rice-editor__body">
    {legacyAmbiguous && (
      <div class="alert alert-warning mb-3" role="note" data-rice-legacy-banner>
        <div>
          This score uses a legacy Confidence value ({legacyAmbiguous.legacyConfidence}). Confirm whether it means {legacyAmbiguous.suggestedPercent}% or {legacyAmbiguous.legacyConfidence}% before saving:
        </div>
        <div class="d-flex gap-2 mt-2">
          <button type="button" class="btn btn-sm btn-warning" data-rice-legacy-convert={String(legacyAmbiguous.suggestedPercent)}>
            Convert to {legacyAmbiguous.suggestedPercent}%
          </button>
          <button type="button" class="btn btn-sm btn-outline" data-rice-legacy-keep={String(legacyAmbiguous.legacyConfidence)}>
            Keep as {legacyAmbiguous.legacyConfidence}%
          </button>
        </div>
      </div>
    )}
    <div class="rice-fields">
      {RICE_FIELDS.map(field => {
        const slider = getScoringSliderConfig("rice", field)
        const rawValue = values[field] ?? ""
        const sliderValue = slider ? clampSliderTrackValue(typeof rawValue === "number" || typeof rawValue === "string" ? rawValue : "", slider.min, slider.max) : 0
        return (
          <div class="rice-field" data-rice-slider-group={field}>
            <div class="rice-field__head">
              <label class="rice-field__label" for={`rice-num-${field}`}>{t(`planning_rice.${field}`, locale)}</label>
              <div class="rice-field__num-wrap">
                <input
                  id={`rice-num-${field}`}
                  class="form-input rice-field__number"
                  type="number"
                  name={field}
                  value={String(rawValue)}
                  min="0"
                  max={field === "confidence" ? 100 : undefined}
                  step="any"
                  inputmode="decimal"
                  required
                />
                {slider?.suffix && <span class="rice-field__suffix" aria-hidden="true">{slider.suffix}</span>}
              </div>
            </div>
            {slider && (
              <div class="rice-field__range-wrap">
                <input
                  type="range"
                  class="form-range rice-field__range"
                  data-rice-range={field}
                  min={String(slider.min)}
                  max={String(slider.max)}
                  step={String(slider.step)}
                  value={String(sliderValue)}
                  aria-label={`${t(`planning_rice.${field}`, locale)} slider`}
                />
                {slider.ticks && (
                  <div class="rice-field__ticks" aria-hidden="true">
                    <span>{slider.ticks[0]}</span>
                    <span>{slider.ticks[1]}</span>
                  </div>
                )}
              </div>
            )}
          </div>
        )
      })}
    </div>
    <div class="rice-preview-bar">
      <span class="rice-preview-label">{t("planning_rice.preview", locale)}</span>
      <output class="rice-preview-output">{score ?? "—"}</output>
      <small class="text-muted rice-preview-breakdown" data-rice-breakdown></small>
    </div>
    <p class="rice-editor__message" role="status" aria-atomic="true" data-rice-message></p>
  </div>
  <div class="card-footer rice-editor-actions">
    <button class="btn btn-primary" type="submit" disabled>{t("planning_rice.save", locale)}</button>
    <a class="btn btn-outline" href={closeHref} data-astro-prefetch="false">{t("planning_rice.close", locale)}</a>
    <a class="btn btn-outline" href={savedHref} data-rice-saved-href hidden tabindex="-1"></a>
    <button class="btn btn-outline" type="button" data-rice-reload hidden>{t("planning_rice.reload", locale)}</button>
  </div>
</form>

<script>
  import { pageLifecycle } from "@lib/page-lifecycle"
  import { formatRiceFormulaBreakdown, frameworkPayloadObject, parseRiceInputs, riceLensScore } from "@lib/rice-lens"

  pageLifecycle.onPageLoad(signal => {
    const form = document.querySelector<HTMLFormElement>("[data-rice-editor]")
    const output = form?.querySelector("output")
    const message = form?.querySelector<HTMLElement>("[data-rice-message]")
    const save = form?.querySelector<HTMLButtonElement>("[type=submit]")
    const reload = form?.querySelector<HTMLButtonElement>("[data-rice-reload]")
    const saved = form?.querySelector<HTMLAnchorElement>("[data-rice-saved-href]")
    const id = form?.dataset.riceEditor
    if (!form || !output || !message || !save || !reload || !saved || !id || form.dataset.ready) return

    const payload = frameworkPayloadObject(JSON.parse(form.dataset.ricePayload ?? "{}"))
    const legacyBanner = form?.querySelector<HTMLElement>("[data-rice-legacy-banner]")
    const breakdown = form?.querySelector<HTMLElement>("[data-rice-breakdown]")
    const confidenceInput = form?.querySelector<HTMLInputElement>('input[name="confidence"]')
    const inputs = () => parseRiceInputs(Object.fromEntries(new FormData(form)))
    const updatePreview = () => {
      const estimate = inputs()
      const currentScore = estimate && estimate.confidence <= 100 ? riceLensScore(estimate) : null
      output.value = String(currentScore ?? "—")
      if (breakdown) {
        breakdown.textContent = estimate && currentScore !== null
          ? `(${formatRiceFormulaBreakdown(estimate)})`
          : ""
      }
    }
    const active = () => !signal.aborted && form.isConnected
    const version = Number(form.dataset.riceVersion)
    if (!Number.isSafeInteger(version) || version < 0) return
    let stale = false

    form.dataset.ready = "true"
    save.disabled = false
    updatePreview()
    if (location.hash === "#rice") requestAnimationFrame(() => {
      if (active() && location.hash === "#rice") form.querySelector<HTMLElement>("h3")?.focus()
    })

    form.querySelector<HTMLButtonElement>("[data-rice-legacy-convert]")?.addEventListener("click", event => {
      const pct = (event.currentTarget as HTMLButtonElement).dataset.riceLegacyConvert
      if (pct && confidenceInput) {
        confidenceInput.value = pct
        const confRange = form.querySelector<HTMLInputElement>('input[data-rice-range="confidence"]')
        if (confRange) confRange.value = pct
        legacyBanner?.remove()
        updatePreview()
      }
    }, { signal })

    form.querySelector<HTMLButtonElement>("[data-rice-legacy-keep]")?.addEventListener("click", () => {
      legacyBanner?.remove()
      updatePreview()
    }, { signal })

    // Keep paired Tabler range sliders and editable number inputs synchronized
    form.querySelectorAll<HTMLInputElement>("input[data-rice-range]").forEach(range => {
      const field = range.dataset.riceRange
      const num = field ? form.querySelector<HTMLInputElement>(`input[name="${field}"]`) : null
      if (!num) return
      const min = Number(range.min)
      const max = Number(range.max)
      range.addEventListener("input", () => {
        num.value = range.value
        updatePreview()
      }, { signal })
      num.addEventListener("input", () => {
        const parsed = Number(num.value)
        if (Number.isFinite(parsed)) {
          range.value = String(Math.min(max, Math.max(min, parsed)))
        }
        updatePreview()
      }, { signal })
    })

    form.addEventListener("input", updatePreview, { signal })

    reload.addEventListener("click", () => location.reload(), { signal })
    form.addEventListener("submit", async event => {
      event.preventDefault()
      if (save.disabled) return
      const estimates = inputs()
      const score = estimates && estimates.confidence <= 100 ? riceLensScore(estimates) : null
      if (!estimates || score === null) {
        message.textContent = form.dataset.invalid ?? ""
        return
      }

      save.disabled = true
      form.setAttribute("aria-busy", "true")
      message.textContent = ""
      const frameworkPayload = JSON.stringify({
        ...payload,
        rice: { ...frameworkPayloadObject(payload.rice), ...estimates, confidence_unit: "percent", score, _evaluatedAt: new Date().toISOString() },
      })
      try {
        const result = await fetch(`/api/tasks/${encodeURIComponent(id)}`, {
          method: "PATCH",
          headers: { "content-type": "application/json", "X-Meitheal-Local-Conflict": "1" },
          body: JSON.stringify({ updated_at: version, framework_payload: frameworkPayload }),
          signal: AbortSignal.any([signal, AbortSignal.timeout(8000)]),
        })
        if (!active()) return
        if (result.status === 409) {
          stale = true
          message.textContent = form.dataset.conflict ?? ""
          reload.hidden = false
          reload.focus()
          return
        }
        if (!result.ok) throw new Error("Score write failed")
        const confirmed = await result.json()
        if (confirmed?.id !== id || confirmed.framework_payload !== frameworkPayload) throw new Error("Score write unconfirmed")
        if (!active()) return
        stale = true
        if (location.hash === "#rice") location.replace(saved.href)
        else {
          message.textContent = form.dataset.saved ?? ""
          reload.hidden = false
        }
      } catch {
        if (active()) {
          message.textContent = form.dataset.error ?? ""
          reload.hidden = false
        }
      } finally {
        if (active()) {
          form.removeAttribute("aria-busy")
          save.disabled = stale
        }
      }
    }, { signal })
  })
</script>

<style is:inline>
  .rice-editor {
    padding: 0;
    background: var(--bg-card);
    border: 1px solid color-mix(in srgb, var(--accent) 35%, var(--border));
    border-radius: var(--radius-lg, 12px);
    overflow: hidden;
    box-shadow: 0 4px 16px rgba(0, 0, 0, 0.08);
  }

  .rice-editor__header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    padding: 0.875rem 1.25rem;
    border-bottom: 1px solid var(--border);
    background: color-mix(in srgb, var(--accent) 8%, var(--bg-card));
  }

  .rice-editor__title-row {
    display: flex;
    align-items: flex-start;
    gap: 0.625rem;
    min-width: 0;
  }

  .rice-editor__icon {
    color: var(--accent-text, var(--accent));
    flex-shrink: 0;
    margin-top: 0.15rem;
  }

  .rice-editor h3 {
    margin: 0;
    font-size: 0.9375rem;
    font-weight: 700;
    color: var(--text-primary);
    overflow-wrap: anywhere;
  }

  .rice-editor__task-label {
    display: flex;
    align-items: center;
    gap: 0.45rem;
    flex-wrap: wrap;
    margin-top: 0.2rem;
    font-size: 0.8125rem;
    font-weight: 500;
    color: var(--text-secondary);
  }

  .rice-editor__key {
    font-family: var(--font-mono, monospace);
    font-size: 0.72rem;
    padding: 0.1rem 0.4rem;
    border-radius: var(--radius-sm, 4px);
    background: var(--bg-hover);
    color: var(--text-secondary);
  }

  .rice-editor__body {
    padding: 1.25rem;
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .rice-fields {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(13.5rem, 100%), 1fr));
    gap: 1rem;
  }

  .rice-field {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    min-width: 0;
    padding: 0.75rem 0.875rem;
    border: 1px solid var(--border);
    border-radius: var(--radius-md, 8px);
    background: color-mix(in srgb, var(--bg-input) 70%, var(--bg-card));
  }

  .rice-field__head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem;
  }

  .rice-field__label {
    font-size: 0.8125rem;
    font-weight: 600;
    color: var(--text-primary);
  }

  .rice-field__num-wrap {
    display: inline-flex;
    align-items: center;
    gap: 0.25rem;
  }

  .rice-field__number {
    width: 5.25rem;
    min-height: 2rem;
    padding: 0.25rem 0.5rem;
    text-align: right;
    font-size: 0.875rem;
    font-weight: 600;
    font-variant-numeric: tabular-nums;
  }

  .rice-field__suffix {
    font-size: 0.75rem;
    font-weight: 600;
    color: var(--text-muted);
  }

  .rice-field__range-wrap {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }

  .rice-field__range {
    width: 100%;
    height: 1.25rem;
    accent-color: var(--accent);
    cursor: pointer;
  }

  .rice-field__ticks {
    display: flex;
    justify-content: space-between;
    font-size: 0.6875rem;
    color: var(--text-muted);
    font-variant-numeric: tabular-nums;
  }

  .rice-preview-bar {
    display: flex;
    align-items: center;
    gap: 0.625rem;
    flex-wrap: wrap;
    padding: 0.75rem 1rem;
    border-radius: var(--radius-md, 8px);
    background: var(--bg-surface);
    border: 1px solid var(--border);
  }

  .rice-preview-label {
    font-size: 0.8125rem;
    font-weight: 600;
    color: var(--text-secondary);
  }

  .rice-preview-output {
    font-size: 1.125rem;
    font-weight: 700;
    font-variant-numeric: tabular-nums;
    color: var(--accent-text, var(--accent));
  }

  .rice-preview-breakdown {
    font-variant-numeric: tabular-nums;
    font-size: 0.78rem;
  }

  .rice-editor__message {
    margin: 0;
    font-size: 0.8125rem;
    color: var(--warning);
  }

  [data-rice-message]:empty {
    display: none;
  }

  .rice-editor-actions {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.5rem;
    padding: 0.875rem 1.25rem;
    border-top: 1px solid var(--border);
    background: color-mix(in srgb, var(--bg-surface) 50%, var(--bg-card));
  }

  .rice-editor-actions > :not([hidden]) {
    min-height: 2.35rem;
    transition: transform 140ms cubic-bezier(0.23, 1, 0.32, 1);
  }

  .rice-editor-actions > :not([hidden]):active {
    transform: scale(0.97);
  }

  .rice-editor-actions > [hidden] {
    display: none;
  }

  @media (prefers-reduced-motion: reduce) {
    .rice-editor-actions > :not([hidden]),
    .rice-editor-actions > :not([hidden]):active {
      transition: none;
      transform: none;
    }
  }
</style>
