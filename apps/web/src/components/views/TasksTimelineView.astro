---
/**
 * TasksTimelineView — Native SVG GANTT chart view.
 *
 * Renders an interactive SVG-based GANTT chart with zero external dependencies.
 * Fully Astro-native and HA-native, using Meitheal CSS variables for theming.
 *
 * @domain Task Visualization
 * @phase 16.2 — Native GANTT rebuild (persona loop iteration 02)
 *
 * Architecture:
 * - SSR: Fetch task data, serialize as JSON blob
 * - Client: Native SVG renderer initializes lazily on first view display
 * - Events: drag/resize → PATCH /api/tasks/{id}
 * - Cleanup: AbortSignal-based lifecycle via pageLifecycle
 */
import SignalBar from "../layout/SignalBar.astro";
import {
  ensureSchema,
  getPersistenceClient,
} from "@domains/tasks/persistence/store";
import { TaskRepository } from "@domains/tasks/persistence/task-repository";

interface TaskRecord {
  id: string;
  title: string;
  status: string;
  priority: number;
  due_date: string | null;
  start_date: string | null;
  end_date: string | null;
  color: string | null;
  task_type: string | null;
  task_kind: string | null;
  progress: number | null;
  ticket_number: number | null;
  parent_id: string | null;
  blocked_by: string | null;
  effort_minutes: number | null;
  labels: string | null;
  area_id: string | null;
  [key: string]: any;
}

let tasks: TaskRecord[] = [];
let fetchError = false;
try {
  await ensureSchema();
  const repo = new TaskRepository(getPersistenceClient());
  tasks = (await repo.getTimelineTasks()) as unknown as TaskRecord[];
} catch (e) {
  fetchError = true;
}

const datedTasks = tasks.filter(t => t.start_date || t.due_date);
const taskCount = datedTasks.length;
const totalTasks = tasks.length;
---

<div id="tasks-view-timeline" class="tasks-view-container" style="display:none" aria-hidden="true">
  <!-- Signal bar with zoom controls -->
  <SignalBar>
    {taskCount > 0 ? (
      <span><strong>{taskCount}</strong> of {totalTasks} tasks on timeline</span>
    ) : (
      <span>Timeline view — add dates to tasks to see them here</span>
    )}

    <!-- Zoom controls (T1/T7/M8) -->
    <div class="timeline-toolbar">
      <select id="timeline-zoom" class="timeline-zoom-select" aria-label="Zoom level">
        <option value="Day">Day</option>
        <option value="Week" selected>Week</option>
        <option value="Month">Month</option>
      </select>

      <!-- T7: Priority Legend -->
      <details class="timeline-legend">
        <summary class="timeline-legend-trigger" title="Colour legend">
          <svg width="14" height="14" viewBox="0 0 14 14" fill="none">
            <circle cx="4" cy="7" r="3" fill="#EF4444"/>
            <circle cx="10" cy="7" r="3" fill="#3B82F6"/>
          </svg>
          Legend
        </summary>
        <div class="timeline-legend-panel">
          <div class="legend-section">
            <div class="legend-title">Priority</div>
            <div class="legend-item"><span class="legend-dot" style="background:#EF4444"></span> Critical (P1)</div>
            <div class="legend-item"><span class="legend-dot" style="background:#F97316"></span> High (P2)</div>
            <div class="legend-item"><span class="legend-dot" style="background:#3B82F6"></span> Medium (P3)</div>
            <div class="legend-item"><span class="legend-dot" style="background:#9CA3AF"></span> Low (P4)</div>
          </div>
          <div class="legend-section">
            <div class="legend-title">Type</div>
            <div class="legend-item"><span class="legend-dot" style="background:#6366F1;border-radius:2px"></span> Epic (bold top)</div>
            <div class="legend-item"><span class="legend-dot" style="background:#6366F1"></span> Story / Task</div>
            <div class="legend-item"><span class="legend-diamond">◆</span> Milestone</div>
          </div>
          <div class="legend-section">
            <div class="legend-title">State</div>
            <div class="legend-item"><span class="legend-dot" style="background:#EF4444;box-shadow:0 0 4px rgba(239,68,68,0.6)"></span> Overdue</div>
            <div class="legend-item"><span class="legend-dot" style="background:#9CA3AF;opacity:0.4"></span> Completed</div>
          </div>
        </div>
      </details>

      <!-- M8: Export as PNG -->
      <button id="timeline-export-btn" class="timeline-export-btn" title="Export as PNG" aria-label="Export timeline as PNG">
        <svg width="14" height="14" viewBox="0 0 14 14" fill="none">
          <path d="M7 1v8M7 9L4 6M7 9l3-3" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
          <path d="M2 11h10" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
        </svg>
        Export
      </button>
    </div>
  </SignalBar>

  <!-- SSR data blob for client-side GANTT initialization -->
  <script type="application/json" id="timeline-data" set:html={JSON.stringify(tasks)} />

  <!-- Loading skeleton -->
  <div id="timeline-skeleton" class="timeline-skeleton">
    <div class="skel-row"><div class="skel-label"></div><div class="skel-bar"></div></div>
    <div class="skel-row"><div class="skel-label"></div><div class="skel-bar" style="width:60%"></div></div>
    <div class="skel-row"><div class="skel-label"></div><div class="skel-bar" style="width:80%"></div></div>
    <div class="skel-row"><div class="skel-label"></div><div class="skel-bar" style="width:45%"></div></div>
    <div class="skel-row"><div class="skel-label"></div><div class="skel-bar" style="width:70%"></div></div>
    <div class="skel-row"><div class="skel-label"></div><div class="skel-bar" style="width:55%"></div></div>
  </div>

  <!-- Empty state -->
  <div id="timeline-empty" class="timeline-empty-state" style="display:none">
    <div class="empty-icon">📊</div>
    <div class="empty-title">No tasks on the timeline yet</div>
    <div class="empty-desc">
      Add <strong>start dates</strong> and <strong>due dates</strong> to your tasks
      to see them here as interactive GANTT bars. You can drag to reschedule and
      resize to adjust duration.
    </div>
  </div>

  <!-- GANTT chart container (native SVG rendered here) -->
  <div id="gantt-chart" class="gantt-chart-wrapper" style="display:none"></div>

  <!-- Error state -->
  {fetchError && (
    <div class="timeline-empty-state">
      <div class="empty-icon">⚠️</div>
      <div class="empty-title">Could not load tasks</div>
      <div class="empty-desc">
        The database may not be available. Try reloading the page.
      </div>
    </div>
  )}
</div>

<style is:global>
  @import "../../styles/timeline-gantt.css";
</style>

<style>
  .gantt-chart-wrapper {
    min-height: 300px;
    max-height: calc(100vh - 180px);
    background: var(--bg-card);
    border: 1px solid var(--border);
    border-radius: var(--radius-md);
    box-shadow: var(--shadow-sm);
    position: relative;
    overflow: auto;
  }
</style>

<script>
  import { pageLifecycle } from "../../lib/page-lifecycle"
  import { initTimelineController } from "../../lib/timeline-controller"

  pageLifecycle.onPageLoad((signal) => {
    const handler = (e: Event) => {
      const detail = (e as CustomEvent).detail
      if (detail?.view === "timeline" && detail?.firstInit) {
        initTimelineController(signal)
      }
    }

    window.addEventListener("meitheal:view-changed", handler, { signal })

    const hash = window.location.hash.replace("#", "")
    if (hash === "timeline") {
      initTimelineController(signal)
    }
  })
</script>
