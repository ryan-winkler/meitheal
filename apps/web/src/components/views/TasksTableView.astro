---

import SignalBar from "../layout/SignalBar.astro";
import EmptyState from "../ui/EmptyState.astro";
import TaskTypeIcon from "../ui/TaskTypeIcon.astro";
import FrameworkBadge from "../ui/FrameworkBadge.astro";
import LabelBadges from "../ui/LabelBadges.astro";
import FilterToolbar from "../ui/FilterToolbar.astro";
import ColumnCustomizer from "../ui/ColumnCustomizer.astro"
import SavedFilterPresets from "../ui/SavedFilterPresets.astro";
import { t } from "../../i18n/translations";
import type { Locale } from "../../lib/locale";
import { formatRegionalDate } from "../../lib/date";
import { formatTicketKey } from "../../lib/ticket-key";
import { buildTaskPath } from "../../lib/task-detail-handoff"
import type { TaskViewItem } from "../../lib/task-queries"
import { CANONICAL_STATUSES, STATUS_CONFIG } from "../../lib/status-config";
import { readTableFilterParams } from "../../lib/filter-state"
import { getTablePage, type TableWorkflowColumn } from "../../lib/table-page"

interface Props {
  tasks: TaskViewItem[]
  creationTimezone?: string | undefined
  tableReadFailed: boolean
  workflowColumns: TableWorkflowColumn[]
  workflowColumnsUnavailable: boolean
}
const { tasks, creationTimezone, tableReadFailed, workflowColumns, workflowColumnsUnavailable } = Astro.props

// i18n: resolve locale from cookie
const cookieLocale = Astro.cookies.get("meitheal-locale")?.value;
const locale: Locale = cookieLocale === "ga" ? "ga" : "en";

const { timezone, dateFormat } = Astro.locals;

const params = new URLSearchParams(Astro.url.search)
const filters = readTableFilterParams(params)
const laneSelectionUnapplied = workflowColumnsUnavailable && Boolean(filters.laneIds?.length)
const resultsUnavailable = tableReadFailed || laneSelectionUnapplied
const { rows, page, pageCount, offset, stats, active, overdue } = getTablePage(
  tableReadFailed ? [] : tasks, filters, params.get("tp"), workflowColumns, creationTimezone,
)

function tableLink(next: number, open?: string) {
  const query = new URLSearchParams(params)
  for (const key of ["tableRefresh", "open", "comment", "tp"]) query.delete(key)
  query.set("view", "table")
  if (next > 1) query.set("tp", String(next))
  if (open) query.set("open", open)
  return `/tasks?${query}#table`
}

const priorityClasses: Record<number, string> = {
  1: "priority-critical",
  2: "priority-high",
  3: "priority-medium",
  4: "priority-low",
  5: "priority-minimal",
};

---

<div id="tasks-view-table" class="tasks-view-container" data-task-view="table">
  <div id="table-shell" class="page-shell" data-table-filters={JSON.stringify(filters)}>
    <!-- Signal bar -->
    <SignalBar>
      <span id="task-summary" hidden={resultsUnavailable}>
        <strong>{stats.total.count}</strong> tasks · <strong>{active}</strong> active
        {overdue > 0 && (
          <Fragment>
            · <span class="summary-overdue">{overdue} overdue</span>
          </Fragment>
        )}
      </span>
    </SignalBar>

    <div class="table-filter-bar">
      <FilterToolbar view="table" showSearch showGroupBy {workflowColumns} {workflowColumnsUnavailable} />
      <div class="table-filter-actions">
        <SavedFilterPresets />
        <ColumnCustomizer />
      </div>
    </div>

    <p id="table-workflow-notice" class="table-refresh-status" role="status" hidden={!workflowColumnsUnavailable || resultsUnavailable}>
      {t("table.filter_columns_load_failed", locale)}
    </p>

    <nav id="table-pagination" class="table-pagination" aria-label={t("table.task_pages", locale)} hidden={pageCount === 1}>
      <span id="table-page-range">{offset + 1}–{offset + rows.length} {t("table.matching_tasks_of", locale)} {stats.total.count} {t("table.matching_tasks", locale)}</span>
      <div class="table-pagination__links">
        {page > 1 && <a class="btn" data-table-page-link aria-describedby="table-page-range" href={tableLink(page - 1)} rel="prev">{t("table.previous_page", locale)}</a>}
        {page < pageCount && <a class="btn" data-table-page-link aria-describedby="table-page-range" href={tableLink(page + 1)} rel="next">{t("table.next_page", locale)}</a>}
      </div>
    </nav>

    <div id="table-empty" hidden={resultsUnavailable || tasks.length > 0}>
      <EmptyState
        title={t("table.no_tasks", locale)}
        description={t("table.no_tasks", locale)}
        actionText={t("tasks.new_task", locale)}
        actionEvent="meitheal:new-task"
      />
    </div>

    <div class="table-container" role="region" aria-label={t("table.title", locale)} tabindex="0" hidden={resultsUnavailable || tasks.length === 0}>
          <table class="data-table" id="task-table" data-table-page={page} data-table-stats={JSON.stringify(stats)}>
            <thead>
              <tr>
                <th scope="col" class="col-checkbox">
                  <input
                    type="checkbox"
                    id="select-all"
                    aria-label="Select all visible tasks on this page"
                  />
                </th>
                <th scope="col" class="sortable col-key" data-col="key">
                  <button type="button" class="table-sort-control">
                    {t("table.col_key", locale)}
                    <span class="sort-indicator" />
                  </button>
                </th>
                <th id="table-title-header" scope="col" class="sortable col-title" data-col="title">
                  <button type="button" class="table-sort-control">
                    {t("table.col_title", locale)}
                    <span class="sort-indicator" />
                  </button>
                </th>
                <th scope="col" class="sortable col-type" data-col="type">
                  <button type="button" class="table-sort-control">
                    {t("table.col_type", locale)}
                    <span class="sort-indicator" />
                  </button>
                </th>
                <th scope="col" class="sortable col-status" data-col="status">
                  <button type="button" class="table-sort-control">
                    {t("table.col_status", locale)}
                    <span class="sort-indicator" />
                  </button>
                </th>
                <th
                  scope="col"
                  class="sortable col-priority"
                  data-col="priority"
                  data-numeric="true"
                >
                  <button type="button" class="table-sort-control">
                    {t("table.col_priority", locale)}
                    <span class="sort-indicator" />
                  </button>
                </th>
                <th
                  scope="col"
                  class="sortable col-due-date"
                  data-col="due_date"
                >
                  <button type="button" class="table-sort-control">
                    {t("table.col_due_date", locale)}
                    <span class="sort-indicator" />
                  </button>
                </th>
                <th
                  scope="col"
                  class="sortable col-rice"
                  data-col="rice"
                  data-numeric="true"
                >
                  <button type="button" class="table-sort-control">
                    {t("table.col_rice", locale)}
                    <span class="sort-indicator" />
                  </button>
                </th>
                <th
                  scope="col"
                  class="col-calendar"
                  title={t("table.col_calendar", locale)}
                >
                  📅
                </th>
                <th scope="col" class="col-custom-fields">
                  {t("table.col_custom_fields", locale)}
                </th>
                <th scope="col" class="col-assigned" title="Assigned To">
                  👤
                </th>
                <th scope="col" class="col-labels">
                  {t("table.col_labels", locale)}
                </th>
                <th scope="col" class="col-actions">
                  {t("table.col_actions", locale)}
                </th>
              </tr>
            </thead>
            <tbody>
              {rows.map(({ task, depth, parentId, hasChildren, parentOutsidePage }) => {
                const cfEntries = Object.entries(task.custom_fields).filter(
                  ([, v]) => v !== null && v !== undefined && v !== "",
                );
                const ticketKey = formatTicketKey(task.ticket_number ?? 0) ?? `#${task.id.slice(0, 8)}`
                return (
                  <tr
                    data-id={task.id}
                    data-rice={task.rice !== null ? String(task.rice) : ""}
                    data-area={task.area_id}
                    data-project-id={task.project_id ?? ""}
                    data-status={task.status}
                    data-due-date={task.due_date ?? ""}
                    data-priority={String(task.priority)}
                    data-assigned={String(task.assigned_to ?? "")}
                    data-labels={JSON.stringify(task.labels ?? [])}
                    data-title={task.title.toLowerCase()}
                    data-task-type={task.task_type}
                    data-task-kind={task.task_kind ?? "standard_action"}
                    data-depth={String(depth)}
                    data-parent-id={parentId ?? ""}
                    data-has-children={hasChildren ? "true" : ""}
                    data-overdue={task.is_overdue ? "true" : "false"}
                    class={`table-row ${task.is_done ? "row-done" : ""} ${depth > 0 ? "subtask-row" : ""}`}
                    style={depth > 0 ? `--subtask-depth: ${depth}` : undefined}
                  >
                    <td class="col-checkbox">
                      <input
                        type="checkbox"
                        class="row-check"
                        data-id={task.id}
                        aria-label={`Select task: ${task.title}`}
                      />
                    </td>
                    <td class="col-key">
                      <a
                        href={buildTaskPath(task.id)}
                        data-task-detail-link={task.id}
                        class="ticket-key-badge"
                        data-open-table-task
                        aria-label={`${ticketKey} — ${task.title}`}
                      >
                        {ticketKey}
                      </a>
                    </td>
                    <td class="col-title">
                      <div class="task-title-cell" style={depth > 0 ? `padding-left: ${depth * 20}px` : undefined}>
                        {hasChildren && (
                          <button
                            type="button"
                            class="subtree-toggle"
                            data-parent-id={task.id}
                            title="Toggle subtasks"
                            aria-expanded="true"
                          >▾</button>
                        )}
                        {depth > 0 && !hasChildren && (
                          <span class="subtree-indent-marker">↳</span>
                        )}
                        <span
                          class="editable-cell"
                          contenteditable="true"
                          spellcheck="false"
                          role="textbox"
                          aria-label={t("table.col_title", locale)}
                          data-field="title"
                          data-id={task.id}
                          data-original={task.title}
                        >
                          {task.title}
                        </span>
                        {task.deferred_at !== null && <span class="table-deferred-badge" data-table-deferred>{t("deferral.title", locale)}</span>}
                      </div>
                      {parentOutsidePage && (
                        <a class="table-parent-link" href={tableLink(page, parentOutsidePage.id)} data-open-table-parent={parentOutsidePage.id}>
                          {t("table.subtask_of", locale)} {parentOutsidePage.title}
                        </a>
                      )}
                      {task.description && (
                        <div class="cell-description" style={depth > 0 ? `margin-left: ${depth * 20}px` : undefined}>
                          {task.description.slice(0, 60)}
                        </div>
                      )}
                    </td>
                    <td class="col-type cell-center">
                      <TaskTypeIcon type={task.task_type} role="img" />
                    </td>
                    <td class="col-status">
                      <select
                        class="inline-select"
                        data-field="status"
                        data-id={task.id}
                        aria-label={`Status for ${task.title}`}
                      >
                        {!CANONICAL_STATUSES.includes(task.status) && <option value={task.status} selected>{task.status}</option>}
                        {STATUS_CONFIG.map((s) => (
                          <option
                            value={s.canonical}
                            selected={task.status === s.canonical}
                          >
                            {t(s.i18nKey as any, locale)}
                          </option>
                        ))}
                      </select>
                    </td>
                    <td class="col-priority">
                      <select
                        class={`inline-select ${priorityClasses[task.priority] ?? ""}`}
                        data-field="priority"
                        data-id={task.id}
                        aria-label={`Priority for ${task.title}`}
                      >
                        <option
                          value="1"
                          selected={task.priority === 1}
                          class="priority-critical"
                        >
                          {t("priority.critical", locale)}
                        </option>
                        <option
                          value="2"
                          selected={task.priority === 2}
                          class="priority-high"
                        >
                          {t("priority.high", locale)}
                        </option>
                        <option
                          value="3"
                          selected={task.priority === 3}
                          class="priority-medium"
                        >
                          {t("priority.medium", locale)}
                        </option>
                        <option
                          value="4"
                          selected={task.priority === 4}
                          class="priority-low"
                        >
                          {t("priority.low", locale)}
                        </option>
                        <option
                          value="5"
                          selected={task.priority === 5}
                          class="priority-minimal"
                        >
                          {t("priority.minimal", locale)}
                        </option>
                      </select>
                    </td>
                    <td
                      class={`col-due-date text-sm td-due ${task.is_overdue ? "overdue-date" : ""}`}
                    >
                      {task.due_date
                        ? formatRegionalDate(task.due_date, {
                            format: dateFormat,
                            timezone,
                          })
                        : "—"}
                      {task.is_overdue && (
                        <span class="overdue-tag">
                          {t("tasks.overdue", locale)}
                        </span>
                      )}
                    </td>
                    <td class="col-rice cell-center">
                      {task.rice !== null ? (
                        <FrameworkBadge score={task.rice} framework="RICE" />
                      ) : (
                        <span class="text-muted">—</span>
                      )}
                    </td>
                    <td class="cell-center col-calendar">
                      {task.calendar_sync_state === "confirmed" ? (
                        <span title="Calendar synced" class="text-accent">
                          ✅
                        </span>
                      ) : task.calendar_sync_state === "pending" ? (
                        <span title="Sync pending" class="text-warning">
                          ⏳
                        </span>
                      ) : (
                        <span title="Not synced" class="text-muted">
                          —
                        </span>
                      )}
                    </td>
                    <td class="col-custom-fields cell-cf">
                      {cfEntries.length > 0
                        ? cfEntries.map(([k, v]) => `${k}: ${v}`).join(", ")
                        : "—"}
                    </td>
                    <td class="cell-center col-assigned">
                      {task.assigned_to ? (
                        <span
                          class="table-assignee-badge"
                          title={`Assigned: ${String(task.assigned_to).replace(/^(ha_|custom_)/, "")}`}
                          aria-label={`Assigned to ${String(task.assigned_to).replace(/^(ha_|custom_)/, "")}`}
                        >
                          {String(task.assigned_to)
                            .replace(/^(ha_|custom_)/, "")
                            .slice(0, 2)
                            .toUpperCase()}
                        </span>
                      ) : (
                        <span class="text-muted">—</span>
                      )}
                    </td>
                    <td class="col-labels">
                      <LabelBadges labels={task.labels as unknown as string} compact max={3} />
                    </td>
                    <td class="col-actions cell-center">
                      <button
                        type="button"
                        class="task-action-btn danger delete-row"
                        data-id={task.id}
                        title={t("tasks.delete", locale)}
                        aria-label={`Delete ${task.title}`}
                      >
                        🗑
                      </button>
                    </td>
                  </tr>
                );
              })}
              <tr class="no-results-row" hidden={rows.length !== 0}>
                <td colspan="13" class="cell-center text-muted" style="padding: 40px 20px; font-size: 14px;">
                  {t("table.no_results", locale)}
                </td>
              </tr>
            </tbody>
          </table>
    </div>

    <div id="table-refresh-status" class="table-refresh-status" role="status" hidden={!resultsUnavailable}
      data-table-updated={t("table.matching_tasks", locale)}
      data-table-failure={t("table.refresh_failed", locale)}>
      <span data-table-refresh-message>{tableReadFailed ? t("table.refresh_failed", locale) : laneSelectionUnapplied ? t("table.filter_columns_load_failed", locale) : ""}</span>
      <button type="button" class="btn" data-table-retry hidden={!resultsUnavailable}>{t("table.retry_page", locale)}</button>
    </div>
  </div>

  <div class="bulk-bar" id="bulk-bar">
    <span id="selected-count">0 selected</span>
    <span class="bulk-divider">|</span>
    <select class="form-select bulk-select" id="bulk-status">
      <option value="">{t("table.change_status", locale)}</option>
      {STATUS_CONFIG.map((s) => (
        <option value={s.canonical}>{t(s.i18nKey as any, locale)}</option>
      ))}
    </select>
    <select class="form-select bulk-select" id="bulk-priority">
      <option value="">Priority</option>
      <option value="1">{t("priority.critical", locale)}</option>
      <option value="2">{t("priority.high", locale)}</option>
      <option value="3">{t("priority.medium", locale)}</option>
      <option value="4">{t("priority.low", locale)}</option>
      <option value="5">{t("priority.minimal", locale)}</option>
    </select>
    <select class="form-select bulk-select" id="bulk-area">
      <option value="">Area</option>
    </select>
    <button
      type="button"
      class="btn bulk-delete-btn"
      id="bulk-delete">🗑 {t("table.delete_selected", locale)}</button
    >
    <button type="button" class="btn bulk-close-btn" id="bulk-close" aria-label="Close bulk actions">✕</button>
  </div>

  <div
    id="toast-container"
    class="toast-container"
    aria-live="polite"
    role="status"
    data-no-scroll-lock="true"
  >
  </div>

  <script>
    import "../../lib/table-controller"
  </script>

</div>

<style>
  .table-pagination, .table-pagination__links, .table-refresh-status {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: var(--space-2, 8px);
  }

  .table-pagination, .table-refresh-status {
    padding-block: var(--space-2, 8px);
  }

  .table-pagination a {
    color: var(--accent-text);
  }

  .table-pagination a:focus-visible {
    outline: 2px solid var(--accent-text);
    outline-offset: 2px;
  }

  .table-pagination[hidden], .table-refresh-status[hidden], .table-container[hidden], tr[hidden] {
    display: none;
  }

  .table-parent-link {
    display: block;
    width: fit-content;
    font-size: var(--text-xs, 0.75rem);
  }


  .table-deferred-badge {
    color: var(--text-secondary);
    font-size: .75rem;
    flex: 0 0 auto;
  }
  /* Signal bar CSS now in SignalBar.astro */
  .table-filter-bar {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 8px;
    margin-bottom: 12px;
    background: var(--bg-secondary);
    border: 1px solid var(--border);
    border-radius: var(--radius-md);
    padding: 8px 12px;
  }
  #task-table.hide-col-key .col-key,
  #task-table.hide-col-type .col-type,
  #task-table.hide-col-status .col-status,
  #task-table.hide-col-priority .col-priority,
  #task-table.hide-col-due-date .col-due-date,
  #task-table.hide-col-rice .col-rice,
  #task-table.hide-col-calendar .col-calendar,
  #task-table.hide-col-custom-fields .col-custom-fields,
  #task-table.hide-col-assigned .col-assigned,
  #task-table.hide-col-labels .col-labels {
    display: none;
  }

  .table-filter-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-2, 8px);
  }


  /* Subtask hierarchy styles (Phase 1: SUB-01) */
  .task-title-cell {
    display: flex;
    align-items: center;
    gap: 4px;
    position: relative;
  }
  .subtask-row .task-title-cell::before {
    content: '';
    position: absolute;
    left: calc(var(--subtask-depth, 1) * 20px - 14px);
    top: 50%;
    width: 10px;
    height: 1px;
    background: var(--border);
  }
  .subtree-toggle {
    background: none;
    border: none;
    color: var(--text-muted);
    cursor: pointer;
    font-size: 12px;
    width: 16px;
    height: 16px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    padding: 0;
    border-radius: var(--radius-sm);
    transition: background 0.15s, color 0.15s;
    position: relative;
    z-index: 1;
  }
  .subtree-toggle:hover {
    background: var(--bg-input);
    color: var(--text-primary);
  }
  .subtree-indent-marker {
    color: var(--text-muted);
    font-size: 11px;
    width: 16px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    opacity: 0.5;
    position: relative;
    z-index: 1;
  }
  .subtask-row {
    border-left: 2px solid var(--accent);
  }

  .filter-bar {
    display: flex;
    gap: 10px;
    margin-bottom: 16px;
    flex-wrap: wrap;
    align-items: center;
  }
  .filter-search {
    max-width: 200px;
    flex: 1;
    min-width: 150px;
  }
  .filter-select {
    max-width: 150px;
  }
  .page-actions {
    display: flex;
    gap: 8px;
    align-items: center;
  }
  .table-row {
    cursor: pointer;
  }
  .table-row:hover td {
    background: var(--bg-hover);
  }
  .delete-row {
    visibility: hidden !important;
    opacity: 0 !important;
    transition: opacity 0.2s ease, visibility 0.2s ease, color 0.15s;
  }
  tr:hover .delete-row,
  .delete-row:focus-visible {
    visibility: visible !important;
    opacity: 0.6 !important;
  }
  tr .delete-row:hover {
    visibility: visible !important;
    opacity: 1 !important;
    color: var(--danger) !important;
  }
  .cell-center {
    text-align: center;
    vertical-align: middle;
  }
  .cell-description {
    font-size: 11px;
    color: var(--text-muted);
    margin-top: 2px;
  }
  .cell-cf {
    font-size: 11px;
    color: var(--text-muted);
  }
  .text-muted {
    color: var(--text-muted);
  }
  .text-accent {
    color: var(--accent);
  }
  .text-warning {
    color: var(--warning);
  }
  .col-checkbox {
    width: 40px;
  }
  .col-key {
    width: 90px;
  }
  .col-type {
    width: 70px;
    text-align: center;
  }
  .col-status {
    width: 100px;
  }
  .col-priority {
    width: 100px;
  }
  .col-due-date {
    width: 120px;
  }
  .col-rice {
    width: 80px;
    text-align: center;
  }
  .col-calendar {
    width: 70px;
    text-align: center;
  }
  .col-custom-fields {
    width: 100px;
  }
  .col-actions {
    width: 80px;
    text-align: center;
  }
  .bulk-bar {
    position: fixed;
    bottom: 20px;
    left: 50%;
    transform: translateX(-50%);
    background: var(--bg-secondary);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    padding: 12px 20px;
    display: none;
    gap: 12px;
    align-items: center;
    box-shadow: var(--shadow-lg);
    z-index: 50;
  }
  .bulk-select {
    max-width: 140px;
  }
  .bulk-delete-btn {
    padding: 4px 10px;
    font-size: 12px;
    background: transparent;
    color: var(--danger);
    border: 1px solid var(--danger);
    opacity: 0.75;
    transition: opacity 0.15s, background 0.15s;
  }
  .bulk-delete-btn:hover {
    opacity: 1;
    background: rgba(239, 68, 68, 0.1);
  }
  .ticket-key-badge {
    display: inline-block;
    min-height: 24px;
    padding: 2px 8px;
    border-radius: 4px;
    font-size: 11px;
    font-weight: 600;
    font-family: "JetBrains Mono", monospace;
    color: var(--accent-text, var(--text-primary));
    background: var(--bg-secondary);
    text-decoration: underline;
    white-space: nowrap;
    cursor: pointer;
  }
  .ticket-key-badge:focus-visible {
