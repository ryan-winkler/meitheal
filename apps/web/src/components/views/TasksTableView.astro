---

import { findAllRules } from "@domains/strategy/rule-repository"
import { resolveTaskEpics } from "@domains/tasks"
import { getPersistenceClient } from "@domains/tasks/persistence/store"
import { taskRecordVersion } from "../../lib/task-api-client"
import { effectiveTaskScheduledDate } from "@meitheal/domain-tasks"
import SignalBar from "../layout/SignalBar.astro";
import EmptyState from "../ui/EmptyState.astro";
import Icon from "../ui/Icon.astro"
import TaskTypeIcon from "../ui/TaskTypeIcon.astro";
import FrameworkBadge from "../ui/FrameworkBadge.astro";
import LabelBadges from "../ui/LabelBadges.astro";
import FilterToolbar from "../ui/FilterToolbar.astro";
import ColumnCustomizer from "../ui/ColumnCustomizer.astro"
import SavedFilterPresets from "../ui/SavedFilterPresets.astro";
import { t } from "../../i18n/translations";
import type { Locale } from "../../lib/locale";
import { formatRegionalDate } from "../../lib/regional-date";
import { formatTicketKey } from "../../lib/ticket-key";
import { taskDetailPath } from "../../lib/task-page-url"
import { taskDescriptionPreview } from "../../lib/task-description-preview"
import type { TaskViewItem } from "../../lib/task-queries"
import { CANONICAL_STATUSES, STATUS_CONFIG } from "../../lib/status-config";
import { formatCardCustomFieldValue } from "../../lib/custom-field-defs";
import { readTableFilterParams, tableNeedsWorkflowColumns } from "../../lib/filter-state"
import { getTablePage, getTableWorkflowColumns, type TableWorkflowColumn } from "../../lib/table-page"
import { getTriageFrameworkDef } from "../../lib/scoring-triage"
import {
  formatEffortMinutes,
  formatEisenhowerShort,
  formatTaskFrameworkScore,
  readTaskStoryPoints,
  resolveActiveScoringFrameworks,
  resolvePrimaryScoringFramework,
} from "../../lib/active-scoring"
import { getDefaultVisibleTableColumns, TABLE_COLUMNS } from "../../lib/table-registry"
import tableCss from "../../styles/_table.css?raw"

interface Props {
  tasks: TaskViewItem[]
  creationTimezone?: string | undefined
  tableReadFailed: boolean
  workflowColumns: TableWorkflowColumn[]
  workflowColumnsUnavailable: boolean
  canEdit?: boolean
  canCreate?: boolean
  canComplete?: boolean
  canDelete?: boolean
}
const {
  tasks,
  creationTimezone,
  tableReadFailed,
  workflowColumns,
  workflowColumnsUnavailable,
  canEdit = true,
  canCreate = true,
  canComplete = true,
  canDelete = true,
} = Astro.props

// i18n: resolve locale from cookie
const cookieLocale = Astro.cookies.get("meitheal-locale")?.value;
const locale: Locale = cookieLocale === "ga" ? "ga" : "en";

const { timezone, dateFormat } = Astro.locals;

const params = new URLSearchParams(Astro.url.search)
const filters = readTableFilterParams(params)
const workflowResultsUnavailable = workflowColumnsUnavailable && tableNeedsWorkflowColumns(filters)
const resultsUnavailable = tableReadFailed || workflowResultsUnavailable
const groupByWorkflow = filters.groupBy === "workflow" || filters.subGroupBy === "workflow"
const noWorkflowLabel = t("table.group_no_workflow", locale)
const displayedWorkflowColumns = getTableWorkflowColumns(workflowColumns, noWorkflowLabel)
const workflowLabels = new Map(displayedWorkflowColumns.map(column => [column.id, column.label]))
const hasTaskCriteria = Boolean(filters.search || filters.area || filters.user || filters.status ||
  filters.priority || filters.rice || filters.task_type || filters.types?.length || filters.labels?.length ||
  filters.laneIds?.length || filters.advancedFilter?.conditions.length || filters.createdFrom || filters.createdThrough)
let activeScoringFramework: ReturnType<typeof resolvePrimaryScoringFramework> = "rice"
try {
  const rules = await findAllRules()
  activeScoringFramework = resolvePrimaryScoringFramework(resolveActiveScoringFrameworks(rules))
} catch {
  activeScoringFramework = "rice"
}
const activeFrameworkLabel = activeScoringFramework ? getTriageFrameworkDef(activeScoringFramework).shortLabel : ""

// Safely resolve Area & Project display names for Planning columns
const areaNames = new Map<string, string>()
const projectNames = new Map<string, string>()
try {
  const db = getPersistenceClient()
  const [areaRes, projectRes] = await Promise.all([
    db.execute("SELECT id, name FROM areas"),
    db.execute("SELECT id, name FROM projects"),
  ])
  for (const r of areaRes.rows) {
    if (typeof r.id === "string" && typeof r.name === "string") areaNames.set(r.id, r.name)
  }
  for (const r of projectRes.rows) {
    if (typeof r.id === "string" && typeof r.name === "string") projectNames.set(r.id, r.name)
  }
} catch { /* fallback to IDs if tables unavailable */ }

const epicsByTask = resolveTaskEpics(resultsUnavailable ? [] : tasks)
const { rows, page, pageCount, offset, stats, active, overdue } = getTablePage(
  resultsUnavailable ? [] : tasks, filters, params.get("tp"), workflowColumns, creationTimezone, activeScoringFramework,
)
const initialVisibleCols = new Set(filters.columns ?? getDefaultVisibleTableColumns())
const initialTableClasses = [
  "data-table",
  ...TABLE_COLUMNS
    .filter(col => (col.id === "rice" && !activeScoringFramework) || !initialVisibleCols.has(col.id))
    .map(col => `hide-col-${col.id}`),
].join(" ")

function tableLink(next: number, open?: string) {
  const query = new URLSearchParams(params)
  for (const key of ["boardRefresh", "tableRefresh", "open", "comment", "tp"]) query.delete(key)
  query.set("view", "table")
  if (next > 1) query.set("tp", String(next))
  if (open) query.set("open", open)
  return `${/^\/boards\/[^/]+\/?$/.test(Astro.url.pathname) ? Astro.url.pathname : "/tasks"}?${query}#table`
}

const priorityClasses: Record<number, string> = {
  1: "priority-critical",
  2: "priority-high",
  3: "priority-medium",
  4: "priority-low",
  5: "priority-minimal",
};

---

<style is:inline set:html={tableCss} />
<div id="tasks-view-table" class="tasks-view-container" data-task-view="table">
  <div id="table-shell" class="page-shell" data-table-filters={JSON.stringify(filters)}>
    <!-- Signal bar -->
    <SignalBar>
      <span id="task-summary" hidden={resultsUnavailable}>
        <strong>{stats.total.count}</strong> tasks · <strong>{active}</strong> active
        {overdue > 0 && (
          <Fragment>
            · <span class="summary-overdue">{overdue} overdue</span>
          </Fragment>
        )}
      </span>
    </SignalBar>

    <div class="table-filter-bar">
      <FilterToolbar view="table" showSearch showGroupBy workflowColumns={displayedWorkflowColumns} {workflowColumnsUnavailable} />
      <div class="table-filter-actions">
        <button
          type="button"
          id="table-manual-order-btn"
          class="btn btn-outline btn-sm aria-pressed:border-accent aria-pressed:bg-accent/15 aria-pressed:text-accent"
          aria-pressed={filters.sort === "manual-asc" ? "true" : "false"}
        >Manual order</button>
        <SavedFilterPresets />
        <ColumnCustomizer />
      </div>
    </div>

    <p id="table-workflow-notice" class="table-refresh-status" role="status" hidden={!workflowColumnsUnavailable || resultsUnavailable}>
      {t("table.filter_columns_load_failed", locale)}
    </p>

    <nav id="table-pagination" class="table-pagination" aria-label={t("table.task_pages", locale)} hidden={pageCount === 1}>
      <span id="table-page-range">{offset + 1}–{offset + rows.length} {t("table.matching_tasks_of", locale)} {stats.total.count} {t("table.matching_tasks", locale)}</span>
      <div class="table-pagination__links">
        {page > 1 && <a class="btn" data-table-page-link aria-describedby="table-page-range" href={tableLink(page - 1)} rel="prev">{t("table.previous_page", locale)}</a>}
        {page < pageCount && <a class="btn" data-table-page-link aria-describedby="table-page-range" href={tableLink(page + 1)} rel="next">{t("table.next_page", locale)}</a>}
      </div>
    </nav>

    <div id="table-empty" hidden={resultsUnavailable || tasks.length > 0}>
      <EmptyState
        title={t(hasTaskCriteria ? "table.no_filter_matches" : "table.no_tasks", locale)}
        actionText={hasTaskCriteria ? t("tasks.clear_filters", locale) : (canCreate ? t("tasks.new_task", locale) : undefined)}
        actionEvent={hasTaskCriteria ? "meitheal:table-clear-filters" : (canCreate ? "meitheal:new-task" : undefined)}
      />
    </div>

    <div class="table-container" role="region" aria-label={t("table.title", locale)} tabindex="0" hidden={resultsUnavailable || tasks.length === 0}>
          <table class={initialTableClasses} id="task-table" data-table-page={page} data-table-stats={JSON.stringify(stats)}
            data-active-framework={activeScoringFramework ?? "none"}
            data-active-framework-label={activeFrameworkLabel}
            data-can-create={String(canCreate)} data-can-edit={String(canEdit)} data-can-complete={String(canComplete)} data-can-delete={String(canDelete)}>
            <thead>
              <tr>
                <th scope="col" class="col-checkbox">
                  <div class="table-check-cell">
                    {canEdit && <span class="table-drag-spacer" aria-hidden="true"></span>}
                    <input
                      type="checkbox"
                      id="select-all"
                      class="row-check"
                      aria-label="Select all visible tasks on this page"
                      disabled={!canEdit && !canDelete}
                    />
                  </div>
                </th>
                <th scope="col" class="sortable col-key" data-col="key">
                  <button type="button" class="table-sort-control">
                    {t("table.col_key", locale)}
                    <span class="sort-indicator" />
                  </button>
                </th>
                <th id="table-title-header" scope="col" class="sortable col-title" data-col="title">
                  <button type="button" class="table-sort-control">
                    {t("table.col_title", locale)}
                    <span class="sort-indicator" />
                  </button>
                </th>
                <th scope="col" class="sortable col-type" data-col="type">
                  <button type="button" class="table-sort-control">
                    {t("table.col_type", locale)}
                    <span class="sort-indicator" />
                  </button>
                </th>
                <th scope="col" class="sortable col-status" data-col="status">
                  <button type="button" class="table-sort-control">
                    {t("table.col_status", locale)}
                    <span class="sort-indicator" />
                  </button>
                </th>
                <th
                  scope="col"
                  class="sortable col-priority"
                  data-col="priority"
                  data-numeric="true"
                >
                  <button type="button" class="table-sort-control">
                    {t("table.col_priority", locale)}
                    <span class="sort-indicator" />
                  </button>
                </th>
                <th
                  scope="col"
                  class="sortable col-due-date"
                  data-col="due_date"
                >
                  <button type="button" class="table-sort-control">
                    {t("table.col_due_date", locale)}
                    <span class="sort-indicator" />
                  </button>
                </th>
                <th
                  scope="col"
                  class="sortable col-rice"
                  data-col="rice"
                  data-numeric="true"
                >
                  <button type="button" class="table-sort-control">
                    {activeFrameworkLabel || t("table.col_rice", locale)}
                    <span class="sort-indicator" />
                  </button>
                </th>
                <th
                  scope="col"
                  class="col-calendar"
                  title={t("table.col_calendar", locale)}
                  aria-label={t("table.col_calendar", locale)}
                >
                  <Icon name="calendar-event" size={16} />
                </th>
                <th scope="col" class="col-custom-fields">
                  {t("table.col_custom_fields", locale)}
                </th>
                <th scope="col" class="col-assigned"
                  title={t("task_modal.assignee_label", locale)} aria-label={t("task_modal.assignee_label", locale)}>
                  <Icon name="user" size={16} />
                </th>
                <th scope="col" class="col-labels">
                  {t("table.col_labels", locale)}
                </th>
                <th scope="col" class="sortable col-start-date" data-col="start_date">
                  <button type="button" class="table-sort-control">
                    Start Date
                    <span class="sort-indicator" />
                  </button>
                </th>
                <th scope="col" class="sortable col-effort" data-col="effort" data-numeric="true">
                  <button type="button" class="table-sort-control">
                    Effort
                    <span class="sort-indicator" />
                  </button>
                </th>
                <th scope="col" class="sortable col-story-points" data-col="story_points" data-numeric="true">
                  <button type="button" class="table-sort-control">
                    Points
                    <span class="sort-indicator" />
                  </button>
                </th>
                <th scope="col" class="sortable col-eisenhower" data-col="eisenhower">
                  <button type="button" class="table-sort-control">
                    Eisenhower
                    <span class="sort-indicator" />
                  </button>
                </th>
                <th scope="col" class="sortable col-progress" data-col="progress" data-numeric="true">
                  <button type="button" class="table-sort-control">
                    Progress
                    <span class="sort-indicator" />
                  </button>
                </th>
                <th scope="col" class="col-area">Area</th>
                <th scope="col" class="col-project">Project</th>
                <th scope="col" class="col-epic">Epic</th>
                <th scope="col" class="sortable col-created" data-col="created">
                  <button type="button" class="table-sort-control">
                    Created
                    <span class="sort-indicator" />
                  </button>
                </th>
                <th scope="col" class="col-actions">
                  {t("table.col_actions", locale)}
                </th>
              </tr>
            </thead>
            <tbody>
              {rows.map(({ task, depth, parentId, hasChildren, parentOutsidePage, workflowColumnId, epicGroup }) => {
                const scheduledDate = effectiveTaskScheduledDate(task);
                const cfEntries = Object.entries(task.custom_fields)
                  .map(([k, v]) => [k, formatCardCustomFieldValue(v)] as const)
                  .filter((entry): entry is readonly [string, string] => entry[1] !== null);
                const ticketKey = task.ticket_key ?? formatTicketKey(task.ticket_number ?? 0) ?? `#${task.id.slice(0, 8)}`
                const description = taskDescriptionPreview(task.description)
                const scoreInfo = activeScoringFramework ? formatTaskFrameworkScore(task, activeScoringFramework) : null
                const storyPoints = readTaskStoryPoints(task)
                const eisenhowerInfo = formatEisenhowerShort(task)
                const effortLabel = formatEffortMinutes(task.effort_minutes)
                const areaLabel = task.area_id ? (areaNames.get(task.area_id) ?? (task.area_id === "default" ? "Default" : task.area_id)) : ""
                const projectLabel = task.project_id ? (projectNames.get(task.project_id) ?? task.project_id) : ""
                const epicTask = epicsByTask.get(task.id)
                const epicLabel = epicTask ? `${epicTask.ticket_key ?? ""} ${epicTask.title}`.trim() : ""
                const progressPct = Math.max(0, Math.min(100, Math.round(task.progress ?? 0)))
                return (
                  <tr
                    data-id={task.id}
                    data-task-version={taskRecordVersion({ ...(task.task_version !== undefined ? { task_version: task.task_version } : {}), updated_at: task.updated_at }) ?? undefined}
                    data-rice={task.rice !== null ? String(task.rice) : ""}
                    data-area={task.area_id}
                    data-project-id={task.project_id ?? ""}
                    data-status={task.status}
                    data-due-date={scheduledDate ?? ""}
                    data-priority={String(task.priority)}
                    data-assigned={String(task.assigned_to ?? "")}
                    data-labels={JSON.stringify(task.labels ?? [])}
                    data-title={task.title.toLowerCase()}
                    data-task-type={task.task_type}
                    data-workflow-column-id={groupByWorkflow ? workflowColumnId || undefined : undefined}
                    data-workflow-label={groupByWorkflow ? workflowLabels.get(workflowColumnId) ?? noWorkflowLabel : undefined}
                    data-epic-group={epicGroup}
                    data-task-kind={task.task_kind ?? "standard_action"}
                    data-depth={String(depth)}
                    data-parent-id={parentId ?? ""}
                    data-has-children={hasChildren ? "true" : ""}
                    data-overdue={task.is_overdue ? "true" : "false"}
                    class={`table-row ${task.is_done ? "row-done" : ""} ${depth > 0 ? "subtask-row" : ""}`}
                    style={depth > 0 ? `--subtask-depth: ${depth}` : undefined}
                  >
                    <td class="col-checkbox">
                      <div class="table-check-cell">
                        {canEdit && (
                          <button
                            type="button"
                            class="table-row-drag-handle btn-icon"
                            data-id={task.id}
                            aria-label={`Reorder row: ${task.title}`}
                            title="Drag to reorder or move between groups (Alt+Up/Down)"
                          ><Icon name="grip-vertical" size={14} sprite /></button>
                        )}
                        <input
                          type="checkbox"
                          class="row-check"
                          data-id={task.id}
                          aria-label={`Select task: ${task.title}`}
                          disabled={!canEdit && !canDelete}
                        />
                      </div>
                    </td>
                    <td class="col-key">
                      <a
                        href={taskDetailPath(task)}
                        data-task-detail-link={task.id}
                        class="ticket-key-badge"
                        data-open-table-task
                        aria-label={`${ticketKey} — ${task.title}`}
                      >
                        {ticketKey}
                      </a>
                    </td>
                    <td class="col-title">
                      <div class="task-title-cell" style={depth > 0 ? `padding-left: ${depth * 20}px` : undefined}>
                        {hasChildren && (
                          <button
                            type="button"
                            class="subtree-toggle"
                            data-parent-id={task.id}
                            title="Toggle subtasks"
                            aria-expanded="true"
                          >▾</button>
                        )}
                        {depth > 0 && !hasChildren && (
                          <span class="subtree-indent-marker">↳</span>
                        )}
                        <span
                          class={canEdit ? "editable-cell" : "table-title-readonly"}
                          contenteditable={canEdit ? "true" : undefined}
                          spellcheck="false"
                          role={canEdit ? "textbox" : undefined}
                          aria-label={canEdit ? t("table.col_title", locale) : undefined}
                          data-field="title"
                          data-id={task.id}
                          data-original={task.title}
                        >
                          {task.title}
                        </span>
                        {task.deferred_at !== null && <span class="table-deferred-badge" data-table-deferred>{t("deferral.title", locale)}</span>}
                      </div>
                      {parentOutsidePage && (
                        <a class="table-parent-link" href={tableLink(page, parentOutsidePage.id)} data-open-table-parent={parentOutsidePage.id}>
                          {t("table.subtask_of", locale)} {parentOutsidePage.title}
                        </a>
                      )}
                      {description && (
                        <div class="cell-description" style={depth > 0 ? `margin-left: ${depth * 20}px` : undefined}>
                          {description.slice(0, 60)}
                        </div>
                      )}
                    </td>
                    <td class="col-type cell-center">
                      <TaskTypeIcon type={task.task_type} kind={task.task_kind} role="img" />
                    </td>
                    <td class="col-status">
                      <select
                        class="inline-select"
                        data-field="status"
                        data-id={task.id}
                        aria-label={`Status for ${task.title}`}
                        disabled={!canEdit || (task.is_done && !canComplete)}
                      >
                        {!CANONICAL_STATUSES.includes(task.status) && <option value={task.status} selected>{task.status}</option>}
                        {STATUS_CONFIG.map((s) => (
                          <option
                            value={s.canonical}
                            selected={task.status === s.canonical}
                            disabled={(s.canonical === "complete" && !canComplete) || (s.canonical === "archived" && !canDelete)}
                          >
                            {t(s.i18nKey as any, locale)}
                          </option>
                        ))}
                      </select>
                    </td>
                    <td class="col-priority">
                      <select
                        class={`inline-select ${priorityClasses[task.priority] ?? ""}`}
                        data-field="priority"
                        data-id={task.id}
                        aria-label={`Priority for ${task.title}`}
                        disabled={!canEdit}
                      >
                        <option
                          value="1"
                          selected={task.priority === 1}
                          class="priority-critical"
                        >
                          {t("priority.critical", locale)}
                        </option>
                        <option
                          value="2"
                          selected={task.priority === 2}
                          class="priority-high"
                        >
                          {t("priority.high", locale)}
                        </option>
                        <option
                          value="3"
                          selected={task.priority === 3}
                          class="priority-medium"
                        >
                          {t("priority.medium", locale)}
                        </option>
                        <option
                          value="4"
                          selected={task.priority === 4}
                          class="priority-low"
                        >
                          {t("priority.low", locale)}
                        </option>
                        <option
                          value="5"
                          selected={task.priority === 5}
                          class="priority-minimal"
                        >
                          {t("priority.minimal", locale)}
                        </option>
                      </select>
                    </td>
                    <td
                      class={`col-due-date text-sm td-due ${task.is_overdue ? "overdue-date" : ""}`}
                    >
                      {scheduledDate
                        ? formatRegionalDate(scheduledDate, {
                            format: dateFormat,
                            timezone,
                          })
                        : "—"}
                      {task.is_overdue && (
                        <span class="overdue-tag">
                          {t("tasks.overdue", locale)}
                        </span>
                      )}
                    </td>
                    <td class="col-rice cell-center">
                      {scoreInfo && scoreInfo.scored ? (
                        (activeScoringFramework === "rice" || activeScoringFramework === "drice" || activeScoringFramework === "ice" || activeScoringFramework === "wsjf") && scoreInfo.numeric !== null ? (
                          <FrameworkBadge score={scoreInfo.numeric} framework={scoreInfo.frameworkLabel} />
                        ) : (
                          <span class={`table-plan-badge table-plan-badge--${scoreInfo.tone}`} title={`${scoreInfo.frameworkLabel}: ${scoreInfo.display}`}>
                            {scoreInfo.display}
                          </span>
                        )
                      ) : (
                        <span class="text-muted">—</span>
                      )}
                    </td>
                    <td class="cell-center col-calendar">
                      {task.calendar_sync_state === "confirmed" ? (
                        <span title="Calendar synced" class="text-accent" role="img" aria-label="Calendar synced">
                          <Icon name="check" size={16} sprite />
                        </span>
                      ) : task.calendar_sync_state === "pending" ? (
                        <span title="Sync pending" class="text-warning" role="img" aria-label="Sync pending">
                          <Icon name="clock" size={16} sprite />
                        </span>
                      ) : (
                        <span title="Not synced" class="text-muted">
                          —
                        </span>
                      )}
                    </td>
                    <td class="col-custom-fields cell-cf">
                      {cfEntries.length > 0
                        ? cfEntries.map(([k, v]) => `${k}: ${v}`).join(", ")
                        : "—"}
                    </td>
                    <td class="cell-center col-assigned">
                      {task.assigned_to ? (
                        <span class="table-assignee-badge" title="Loading assignee">
                          <span dir="auto" data-task-assignee={task.assigned_to}>Loading assignee…</span>
                        </span>
                      ) : (
                        <span class="text-muted">—</span>
                      )}
                    </td>
                    <td class="col-labels">
                      <LabelBadges labels={task.labels as unknown as string} compact max={3} />
                    </td>
                    <td class="col-start-date text-sm">
                      {task.start_date
                        ? formatRegionalDate(task.start_date, { format: dateFormat, timezone })
                        : <span class="text-muted">—</span>}
                    </td>
                    <td class="col-effort cell-center text-sm">
                      {effortLabel !== "—" ? (
                        <span class="table-plan-mono">{effortLabel}</span>
                      ) : (
                        <span class="text-muted">—</span>
                      )}
                    </td>
                    <td class="col-story-points cell-center">
                      {storyPoints !== null ? (
                        <span class="table-plan-badge table-plan-badge--info" title={`${storyPoints} story points`}>
                          {storyPoints} pts
                        </span>
                      ) : (
                        <span class="text-muted">—</span>
                      )}
                    </td>
                    <td class="col-eisenhower cell-center">
                      {eisenhowerInfo.rank > 0 ? (
                        <span class={`table-plan-badge table-plan-badge--${eisenhowerInfo.tone}`}>
                          {eisenhowerInfo.label}
                        </span>
                      ) : (
                        <span class="text-muted">—</span>
                      )}
                    </td>
                    <td class="col-progress">
                      <div class="table-progress-cell" title={`${progressPct}% complete`}>
                        <div class="table-progress-track" aria-hidden="true">
                          <div class="table-progress-fill" style={`width: ${progressPct}%`} />
                        </div>
                        <span class="table-plan-mono">{progressPct}%</span>
                      </div>
                    </td>
                    <td class="col-area text-sm">
                      {areaLabel ? <span class="table-plan-truncate" title={areaLabel}>{areaLabel}</span> : <span class="text-muted">—</span>}
                    </td>
                    <td class="col-project text-sm">
                      {projectLabel ? <span class="table-plan-truncate" title={projectLabel}>{projectLabel}</span> : <span class="text-muted">—</span>}
                    </td>
                    <td class="col-epic text-sm">
                      {epicLabel ? <span class="table-plan-truncate" title={epicLabel}>{epicLabel}</span> : <span class="text-muted">—</span>}
                    </td>
                    <td class="col-created text-sm">
                      {task.created_at
                        ? formatRegionalDate(task.created_at, { format: dateFormat, timezone })
                        : <span class="text-muted">—</span>}
                    </td>
                    <td class="col-actions cell-center">
                      {canDelete && (
                        <button
                          type="button"
                          class="task-action-btn danger delete-row"
                          data-id={task.id}
                          title={t("tasks.delete", locale)}
                          aria-label={`Delete ${task.title}`}
                        >
                          <Icon name="trash" size={16} sprite />
                        </button>
                      )}
                    </td>
                  </tr>
                );
              })}
              <tr class="no-results-row" hidden={rows.length !== 0}>
                <td colspan="22" class="cell-center text-muted" style="padding: 40px 20px; font-size: 14px;">
                  <div class="inline-flex flex-wrap items-center justify-center gap-2">
                    <span>{t("table.no_filter_matches", locale)}</span>
                    {hasTaskCriteria && <button type="button" class="btn btn-outline btn-sm" data-empty-action="meitheal:table-clear-filters">
                      {t("tasks.clear_filters", locale)}
                    </button>}
                  </div>
                </td>
              </tr>
            </tbody>
          </table>
    </div>

    <div id="table-refresh-status" class="table-refresh-status" role="status" hidden={!resultsUnavailable}
      data-table-updated={t("table.matching_tasks", locale)}
      data-table-failure={t("table.refresh_failed", locale)}
      data-table-selection-pending={t("table.refresh_selection_pending", locale)}>
      <span data-table-refresh-message>{tableReadFailed ? t("table.refresh_failed", locale) : workflowResultsUnavailable ? t("table.filter_columns_load_failed", locale) : ""}</span>
      <button type="button" class="btn" data-table-retry hidden={!resultsUnavailable}>{t("table.retry_page", locale)}</button>
    </div>
  </div>

  <div class="bulk-bar" id="bulk-bar" hidden={!canEdit && !canDelete}>
    <span id="selected-count" class="bulk-count">0 selected</span>
    <span class="bulk-divider" aria-hidden="true"></span>
    <select class="form-select bulk-select" id="bulk-status" aria-label={t("table.change_status", locale)} disabled={!canEdit}>
      <option value="">{t("table.change_status", locale)}</option>
      {STATUS_CONFIG.map((s) => (
        <option
          value={s.canonical}
          disabled={(s.canonical === "complete" && !canComplete) || (s.canonical === "archived" && !canDelete)}
        >{t(s.i18nKey as any, locale)}</option>
      ))}
    </select>
    <select class="form-select bulk-select" id="bulk-priority" aria-label="Change priority" disabled={!canEdit}>
      <option value="">Priority</option>
      <option value="1">{t("priority.critical", locale)}</option>
      <option value="2">{t("priority.high", locale)}</option>
      <option value="3">{t("priority.medium", locale)}</option>
      <option value="4">{t("priority.low", locale)}</option>
      <option value="5">{t("priority.minimal", locale)}</option>
    </select>
    <select class="form-select bulk-select" id="bulk-area" aria-label="Change area" disabled={!canEdit}>
      <option value="">Area</option>
    </select>
    <button
      type="button"
      class="btn bulk-delete-btn"
      id="bulk-delete"
      hidden={!canDelete}
      disabled={!canDelete}><Icon name="trash" size={15} sprite /><span>{t("table.delete_selected", locale)}</span></button>
    <button type="button" class="btn bulk-close-btn" id="bulk-close" aria-label="Close bulk actions">
      <Icon name="x" size={15} sprite />
    </button>
  </div>

  <script>
    import "../../lib/table-controller"
  </script>

</div>

