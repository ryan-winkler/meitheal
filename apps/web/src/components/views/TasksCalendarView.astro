---
import type { BoardScope } from "@domains/tasks/board-scope"
const scope: BoardScope = Astro.props.scope

import { ensureSchema, getPersistenceClient } from "@domains/tasks/persistence/store"
import { TaskRepository, type CalendarDayInfo } from "@domains/tasks/persistence/task-repository"
import { createCalendarTaskFilter } from "../../lib/calendar-task-filter"
import {
  buildYearMonths,
  daysInUtcMonth,
  isColumnWeekend,
  normalizeWeekStart,
  resolveCalendarViewState,
  weekStartIndex,
  type CalendarNavTarget,
  type CalendarViewMode,
} from "../../lib/calendar-view-range"
import { calendarOccurrenceStartKey, calendarToday, householdDayRanges } from "../../lib/date"
import { sanitizeCssColor } from "../../lib/safe-html"
import { taskViewUrl } from "../../lib/task-view-route"
import SignalBar from "../layout/SignalBar.astro"
import FilterToolbar from "../ui/FilterToolbar.astro"
import Icon from "../ui/Icon.astro"

const { weekStart = "monday", timezone = "Europe/Dublin" } = Astro.locals
const tz = timezone || "Europe/Dublin"
const todayStr = calendarToday(tz)
const normalizedWeekStart = normalizeWeekStart(weekStart)

const url = new URL(Astro.request.url)
const cal = resolveCalendarViewState({
  viewParam: url.searchParams.get("calView"),
  dateParam: url.searchParams.get("date"),
  yearParam: url.searchParams.get("year"),
  monthParam: url.searchParams.get("month"),
  todayStr,
  weekStart: normalizedWeekStart,
})

function calendarHref(targetSpec?: Partial<CalendarNavTarget>) {
  const target = taskViewUrl(url, "calendar")
  target.pathname = `/boards/${encodeURIComponent(scope.boardId)}`
  target.searchParams.delete("calendarRefresh")
  target.searchParams.delete("open")
  target.searchParams.delete("comment")

  const nextView = targetSpec?.view ?? cal.view
  if (nextView === "month") target.searchParams.delete("calView")
  else target.searchParams.set("calView", nextView)

  if (targetSpec?.year === undefined && targetSpec?.month === undefined && targetSpec?.date === undefined) {
    target.searchParams.delete("year")
    target.searchParams.delete("month")
    target.searchParams.delete("date")
  } else {
    if (targetSpec.year !== undefined) target.searchParams.set("year", String(targetSpec.year))
    if (targetSpec.month !== undefined) target.searchParams.set("month", String(targetSpec.month))
    if (nextView === "day" || nextView === "week") {
      if (targetSpec.date) target.searchParams.set("date", targetSpec.date)
    } else {
      target.searchParams.delete("date")
    }
  }
  return target.pathname + target.search + target.hash
}

const filter = createCalendarTaskFilter(url.searchParams, tz)
let calendarAvailable = true
if (url.searchParams.has("calendarRefresh")) Astro.response.headers.set("Cache-Control", "no-store")

const tasksByDay: Record<string, Pick<CalendarDayInfo, "count" | "colors" | "haEvents" | "scheduledEvents">> = {}
let rangeTotal = 0
let rangeHAEvents = 0

try {
  await ensureSchema()
  const repo = new TaskRepository(getPersistenceClient(), scope)

  const calendarData = await repo.getCalendarTaskCounts(cal.rangeStart, cal.rangeEnd, tz, {
    matches: filter.matches,
    includeCompleted: filter.includeCompletedInCounts,
  })
  for (const [dateStr, info] of Object.entries(calendarData)) {
    tasksByDay[dateStr] = info
    rangeTotal += info.count
  }

  const haData = filter.showConnectedEvents ? await repo.getLinkedCalendarEvents(cal.rangeStart, cal.rangeEnd, tz) : {}
  const syncedOccurrences = new Set<string>()
  for (const [dateStr, events] of Object.entries(haData)) {
    if (!events?.length) continue
    for (const event of events) syncedOccurrences.add(event.id + "/" + calendarOccurrenceStartKey(event.start, tz))
    if (tasksByDay[dateStr]) {
      tasksByDay[dateStr].haEvents = events.length
    } else {
      tasksByDay[dateStr] = { count: 0, colors: [], haEvents: events.length, scheduledEvents: 0 }
    }
  }
  rangeHAEvents = syncedOccurrences.size
} catch {
  calendarAvailable = false
  Astro.response.headers.set("Cache-Control", "no-store")
}

// Month grid (only built when in month view)
interface CalDay {
  day: number
  dateStr: string
  isCurrentMonth: boolean
  isToday: boolean
  isWeekend: boolean
  taskCount: number
  calendarEventCount: number
  colors: string[]
}

const monthPrefix = `${String(cal.year).padStart(4, "0")}-${String(cal.month + 1).padStart(2, "0")}`
const monthGrid: CalDay[][] = []
if (cal.view === "month") {
  const firstDow = new Date(Date.UTC(cal.year, cal.month, 1)).getUTCDay()
  const startDayOfWeek = (firstDow - weekStartIndex(normalizedWeekStart) + 7) % 7
  const totalDays = daysInUtcMonth(cal.year, cal.month)
  let currentDay = 1 - startDayOfWeek

  for (let week = 0; week < 6; week++) {
    const row: CalDay[] = []
    for (let dow = 0; dow < 7; dow++) {
      const d = currentDay
      const isCurrentMonth = d >= 1 && d <= totalDays
      const dateStr = isCurrentMonth ? `${monthPrefix}-${String(d).padStart(2, "0")}` : ""
      const dayData = tasksByDay[dateStr]
      const scheduledEvents = dayData?.scheduledEvents ?? 0
      const calendarEventCount = scheduledEvents + (dayData?.haEvents ?? 0)
      row.push({
        day: d,
        dateStr,
        isCurrentMonth,
        isToday: dateStr === todayStr,
        isWeekend: isColumnWeekend(dow, normalizedWeekStart),
        taskCount: (dayData?.count ?? 0) - scheduledEvents,
        calendarEventCount,
        colors: dayData?.colors ?? [],
      })
      currentDay++
    }
    if (row.every(d => !d.isCurrentMonth) && week > 0) break
    monthGrid.push(row)
  }
}

const yearMonths = cal.view === "year" ? buildYearMonths(cal.year, todayStr, normalizedWeekStart) : []

const scheduledDayCount = Object.values(tasksByDay).filter(day => day.count > 0).length
const itemWord = rangeTotal === 1 ? "item" : "items"
const dayWord = scheduledDayCount === 1 ? "day" : "days"
const haEventWord = rangeHAEvents === 1 ? "synced event" : "synced events"
const periodLabel = cal.view === "day" ? "day" : cal.view === "week" ? "week" : cal.view === "year" ? "year" : "month"
const agendaNote = filter.matches && !Object.values(tasksByDay).some(day => day.count)
  ? `No tasks match these filters this ${periodLabel}.`
  : cal.view === "day"
    ? "Use D, W, M, or Y to switch views quickly."
    : cal.view === "year"
      ? "Select any month or day to zoom in."
      : "Open a day to see its full agenda."

const viewModes: Array<{ id: CalendarViewMode; label: string; key: string }> = [
  { id: "day", label: "Day", key: "D" },
  { id: "week", label: "Week", key: "W" },
  { id: "month", label: "Month", key: "M" },
  { id: "year", label: "Year", key: "Y" },
]
const dayViewData = tasksByDay[cal.anchorDate]
const dayViewRanges = cal.view === "day" && filter.showConnectedEvents ? householdDayRanges(cal.anchorDate, tz) : undefined
const anchorDateObj = new Date(`${cal.anchorDate}T00:00:00Z`)
const anchorDayNum = anchorDateObj.getUTCDate()
const anchorWeekdayShort = anchorDateObj.toLocaleDateString("en-US", { weekday: "short", timeZone: "UTC" })
const todayDayNum = Number(todayStr.slice(8, 10)) || new Date().getDate()
const hourlySlots = Array.from({ length: 17 }, (_, i) => {
  const hour = i + 6 // 6 AM to 10 PM
  const suffix = hour >= 12 ? "PM" : "AM"
  const h12 = hour % 12 === 0 ? 12 : hour % 12
  return { hour, label: `${h12} ${suffix}` }
})
---

<div id="tasks-view-calendar" class="tasks-view-container" data-task-view="calendar">

  <div id="calendar-shell" class="page-shell" data-timezone={tz}>
    <div id="cal-filter-island" class="card calendar-filter-island">
      <FilterToolbar view="calendar" showSearch showGroupBy={false} showSortBy={false} />
    </div>
    <div class="calendar-refresh-status" data-calendar-status role="status" hidden={calendarAvailable}>
      {!calendarAvailable && "Calendar data could not load."}
    </div>
    <button class="btn btn-outline" type="button" data-calendar-retry hidden={calendarAvailable}>Retry calendar</button>
    <div
      class="calendar-month"
      data-calendar-month
      data-calendar-mode={cal.view}
      data-calendar-anchor={cal.anchorDate}
      data-calendar-available={String(calendarAvailable)}
      data-calendar-events={String(filter.showConnectedEvents)}
    >
      {calendarAvailable && <SignalBar>
        <span id="calendar-signal-summary">
          <strong>{rangeTotal}</strong> {itemWord} across <strong>{scheduledDayCount}</strong> {dayWord}
          {filter.showConnectedEvents && <> · <strong>{rangeHAEvents}</strong> {haEventWord}</>}
        </span>
      </SignalBar>}

      <section class="card calendar-card" aria-labelledby="calendar-month-heading">
        <div class="card-header calendar-controls">
          <div class="calendar-heading-group">
            <h2 class="card-title" id="calendar-month-heading">
              <span class="cal-heading__full">{cal.heading}</span>
              <span class="cal-heading__short">{cal.shortHeading}</span>
            </h2>
            {cal.view === "month" && (
              <button
                type="button"
                id="cal-mobile-month-toggle"
                class="cal-mobile-month-toggle"
                aria-expanded="true"
                aria-controls="cal-month-grid"
                title="Show or hide month grid"
              >
                <span>{cal.heading}</span>
                <Icon name="chevron-down" size={16} />
              </button>
            )}
          </div>
          <div class="calendar-toolbar-actions">
            <nav class="btn-group cal-view-switcher" aria-label="Calendar view range">
              {viewModes.map(mode => (
                <a
                  href={calendarHref({ view: mode.id, year: cal.year, month: cal.month, date: cal.anchorDate })}
                  class={`btn cal-view-btn${cal.view === mode.id ? " is-active" : ""}`}
                  data-calendar-nav={`view-${mode.id}`}
                  data-calendar-shortcut={mode.key.toLowerCase()}
                  aria-current={cal.view === mode.id ? "page" : undefined}
                  title={`${mode.label} view (${mode.key})`}
                >
                  <span>{mode.label}</span>
                  <kbd class="cal-view-kbd" aria-hidden="true">{mode.key}</kbd>
                </a>
              ))}
            </nav>
            <div class="btn-list calendar-navigation" aria-label={`Change ${periodLabel}`}>
              <button
                type="button"
                id="cal-mobile-filter-toggle"
                class="btn cal-nav-btn cal-mobile-filter-toggle"
                aria-expanded="false"
                aria-controls="cal-filter-island"
                aria-label={filter.hasFilters ? "Filters Active" : "Filters"}
                data-filters-active={String(filter.hasFilters)}
                title="Filters"
              >
                <Icon name="adjustments-horizontal" size={16} />
              </button>
              <button
                type="button"
                class="btn cal-nav-btn cal-share-btn"
                data-calendar-share-day
                aria-label="Share calendar view"
                title="Share calendar view"
              >
                <Icon name="external-link" size={15} />
              </button>
              <a href={calendarHref({ view: cal.view })} class="btn cal-today-btn" data-calendar-nav="today" title="Jump to today (T)">
                <span class="cal-today-btn__desktop">Today</span>
                <span class="cal-today-btn__mobile" aria-hidden="true">{todayDayNum}</span>
              </a>
              <div class="btn-group">
                <a href={calendarHref(cal.prev)} class="btn cal-nav-btn" data-calendar-nav="previous" aria-label={`Previous ${periodLabel}`}>
                  <Icon name="chevron-down" class="cal-prev-icon" size={16} />
                </a>
                <a href={calendarHref(cal.next)} class="btn cal-nav-btn" data-calendar-nav="next" aria-label={`Next ${periodLabel}`}>
                  <Icon name="chevron-down" class="cal-next-icon" size={16} />
                </a>
              </div>
            </div>
          </div>
        </div>

        {/* ───────── DAY VIEW ───────── */}
        {cal.view === "day" && (
          <div
            class="cal-day-view"
            data-cal-day-view={cal.anchorDate}
            data-day-ranges={dayViewRanges?.length === 1 ? undefined : JSON.stringify(dayViewRanges)}
          >
            <div class="cal-day-view__bar">
              <div class="cal-day-view__summary">
                <span class={`cal-day-view__pill${cal.anchorDate === todayStr ? " is-today" : ""}`}>
                  <Icon name="calendar" size={14} />
                  <span>{cal.anchorDate === todayStr ? "Today" : cal.shortHeading}</span>
                </span>
                <span class="cal-day-view__count">
                  {dayViewData?.count ?? 0} scheduled {(dayViewData?.count ?? 0) === 1 ? "item" : "items"}
                </span>
              </div>
              <div class="cal-day-view__actions">
                <button type="button" class="btn btn-outline" data-day-view-add="event" data-date={cal.anchorDate}>
                  <Icon name="calendar-event" size={15} />
                  <span>Add Event</span>
                </button>
                <button type="button" class="btn btn-primary" data-day-view-add="task" data-date={cal.anchorDate}>
                  <Icon name="plus" size={15} />
                  <span>Add Task</span>
                </button>
              </div>
            </div>

            {/* Google Calendar-inspired Hourly Day Timeline */}
            <div class="cal-hourly-shell" data-cal-hourly={cal.anchorDate} data-is-today={String(cal.anchorDate === todayStr)}>
              <div class="cal-hourly-header">
                <div class={`cal-hourly-date-badge${cal.anchorDate === todayStr ? " is-today" : ""}`}>
                  <span class="cal-hourly-date-badge__num">{anchorDayNum}</span>
                  <span class="cal-hourly-date-badge__dow">{anchorWeekdayShort}</span>
                </div>
                <div id="cal-day-allday-strip" class="cal-hourly-allday" aria-label="All-day tasks and events"></div>
              </div>
              <div class="cal-hourly-grid-wrap">
                <div class="cal-hourly-gutter" aria-hidden="true">
                  {hourlySlots.map(slot => (
                    <div class="cal-hourly-gutter__label">{slot.label}</div>
                  ))}
                </div>
                <div class="cal-hourly-track" id="cal-day-hourly-track">
                  {hourlySlots.map(slot => (
                    <div class="cal-hourly-slot" data-hour={slot.hour}></div>
                  ))}
                  <div id="cal-day-hourly-blocks" class="cal-hourly-blocks"></div>
                  <div id="cal-day-now-line" class="cal-now-line" hidden>
                    <span class="cal-now-line__dot" aria-hidden="true"></span>
                  </div>
                </div>
              </div>
            </div>

            <div class="cal-day-view__columns">
              <section class="cal-day-view__panel" aria-labelledby="cal-day-tasks-heading">
                <h3 id="cal-day-tasks-heading" class="day-drawer-section-title flex items-center gap-1.5">
                  <Icon name="clipboard-list" size={14} />
                  <span>Scheduled Tasks &amp; Local Events</span>
                </h3>
                <div id="cal-day-view-tasks" class="day-drawer-list" aria-busy="true">
                  <div class="cal-skeleton-row" aria-hidden="true"></div>
                  <div class="cal-skeleton-row" aria-hidden="true"></div>
                  <div class="cal-skeleton-row cal-skeleton-row--short" aria-hidden="true"></div>
                </div>
                <div id="cal-day-view-task-status" class="day-drawer-read-status" role="status"></div>
              </section>

              {filter.showConnectedEvents && (
                <section class="cal-day-view__panel" aria-labelledby="cal-day-events-heading">
                  <h3 id="cal-day-events-heading" class="day-drawer-section-title flex items-center gap-1.5">
                    <Icon name="calendar-event" size={14} />
                    <span>Connected Calendar Events</span>
                  </h3>
                  <div id="cal-day-view-events" class="day-drawer-list" aria-busy="true">
                    <div class="cal-skeleton-row" aria-hidden="true"></div>
                    <div class="cal-skeleton-row cal-skeleton-row--short" aria-hidden="true"></div>
                  </div>
                  <div id="cal-day-view-event-status" class="day-drawer-read-status" role="status"></div>
                </section>
              )}
            </div>
          </div>
        )}

        {/* ───────── WEEK VIEW ───────── */}
        {cal.view === "week" && (
          <div class="cal-week-grid">
            {cal.weekDays.map((dayInfo) => {
              const dayData = tasksByDay[dayInfo.dateStr]
              const scheduledEvents = dayData?.scheduledEvents ?? 0
              const taskCount = (dayData?.count ?? 0) - scheduledEvents
              const calendarEventCount = scheduledEvents + (dayData?.haEvents ?? 0)
              const colors = dayData?.colors ?? []
              const ranges = filter.showConnectedEvents ? householdDayRanges(dayInfo.dateStr, tz) : undefined
              return (
                <div
                  id={`calendar-day-${dayInfo.dateStr}`}
                  class={`cal-cell cal-week-cell${dayInfo.isToday ? " cal-today" : ""}${dayInfo.isWeekend ? " cal-weekend" : ""}${taskCount > 0 ? " cal-has-tasks" : ""}`}
                  data-date={dayInfo.dateStr}
                  data-day-ranges={ranges?.length === 1 ? undefined : JSON.stringify(ranges)}
                  role="button"
                  tabindex="0"
                  aria-current={dayInfo.isToday ? "date" : undefined}
                >
                  <div class="cal-week-cell__head">
                    <span class="cal-week-cell__dow">{dayInfo.weekdayShort}</span>
                    <a
                      href={calendarHref({ view: "day", year: dayInfo.year, month: dayInfo.month, date: dayInfo.dateStr })}
                      class={`cal-day-num cal-week-day-link${dayInfo.isToday ? " cal-day-today" : ""}`}
                      data-calendar-nav={`day-${dayInfo.dateStr}`}
                      title={`Open ${dayInfo.weekdayShort} ${dayInfo.monthShort} ${dayInfo.day} in Day view`}
                    >
                      {dayInfo.day}
                    </a>
                  </div>
                  {(taskCount > 0 || calendarEventCount > 0) ? (
                    <div class="cal-task-indicator">
                      {taskCount > 0 && (
                        <span class="cal-task-badge">
                          {taskCount}<span class="sr-only">{taskCount === 1 ? " task" : " tasks"}</span>
                        </span>
                      )}
                      {calendarEventCount > 0 && (
                        <span class="cal-event-badge">
                          <Icon name="calendar-event" size={12} />
                          <span>{calendarEventCount}<span class="sr-only">{calendarEventCount === 1 ? " calendar event" : " calendar events"}</span></span>
                        </span>
                      )}
                      {colors.length > 0 && (
                        <div class="cal-color-dots">
                          {colors.map((c) => (
                            <span class="cal-color-dot" style={`background: ${sanitizeCssColor(c)};`} />
                          ))}
                        </div>
                      )}
                    </div>
                  ) : (
                    <p class="cal-week-empty-hint">Open</p>
                  )}
                  {filter.showConnectedEvents && <div class="cal-inline-events" data-inline-date={dayInfo.dateStr}></div>}
                </div>
              )
            })}
          </div>
        )}

        {/* ───────── MONTH VIEW ───────── */}
        {cal.view === "month" && (
          <>
          <div id="cal-month-grid" class="calendar-grid">
            {cal.weekLabels.map((d, i) => (
              <div class={`cal-header ${isColumnWeekend(i, normalizedWeekStart) ? "cal-header-weekend" : ""}`}>
                <span class="cal-header__full">{d}</span>
                <span class="cal-header__short" aria-hidden="true">{d.slice(0, 1)}</span>
              </div>
            ))}
            {monthGrid.flat().map((cell) => {
              const ranges = cell.isCurrentMonth && filter.showConnectedEvents ? householdDayRanges(cell.dateStr, tz) : undefined
              const isSelected = cell.isCurrentMonth && cell.dateStr === cal.anchorDate
              return (
                <div
                  id={cell.isCurrentMonth ? `calendar-day-${cell.dateStr}` : undefined}
                  class={`cal-cell ${cell.isToday ? "cal-today" : ""} ${isSelected ? "cal-selected" : ""} ${!cell.isCurrentMonth ? "cal-other" : ""} ${cell.isWeekend && cell.isCurrentMonth ? "cal-weekend" : ""} ${cell.taskCount > 0 ? "cal-has-tasks" : ""}`}
                  data-date={cell.dateStr}
                  data-day-ranges={ranges?.length === 1 ? undefined : JSON.stringify(ranges)}
                  role={cell.isCurrentMonth ? "button" : undefined}
                  tabindex={cell.isCurrentMonth ? "0" : undefined}
                  aria-current={cell.isToday ? "date" : undefined}
                >
                  {cell.isCurrentMonth && (
                    <div class="cal-cell__inner">
                      <span class={`cal-day-num ${cell.isToday ? "cal-day-today" : ""}`}>
                        {cell.day}<span class="sr-only">{` ${cal.heading}`}</span>
                      </span>
                      {(cell.taskCount > 0 || cell.calendarEventCount > 0) && (
                        <div class="cal-task-indicator">
                          {cell.taskCount > 0 && (
                            <span class="cal-task-badge">
                              {cell.taskCount}<span class="sr-only">{cell.taskCount === 1 ? " task" : " tasks"}</span>
                            </span>
                          )}
                          {cell.calendarEventCount > 0 && (
                            <span class="cal-event-badge">
                              <Icon name="calendar-event" size={12} />
                              <span>{cell.calendarEventCount}<span class="sr-only">{cell.calendarEventCount === 1 ? " calendar event" : " calendar events"}</span></span>
                            </span>
                          )}
                          {cell.colors.length > 0 && (
                            <div class="cal-color-dots">
                              {cell.colors.slice(0, 3).map((c) => (
                                <span class="cal-color-dot" style={`background: ${sanitizeCssColor(c)};`} />
                              ))}
                            </div>
                          )}
                          {cell.colors.length === 0 && (
                            <div class="cal-color-dots cal-color-dots--fallback">
                              <span class="cal-color-dot" style="background: var(--accent);" />
                            </div>
                          )}
                        </div>
                      )}
                      {filter.showConnectedEvents && <div class="cal-inline-events" data-inline-date={cell.dateStr}></div>}
                    </div>
                  )}
                </div>
              )
            })}
          </div>

          {/* Mobile Google Calendar-style Split Agenda below compact mini-month */}
          <section
            id="cal-mobile-agenda"
            class="cal-mobile-agenda"
            data-mobile-agenda-date={cal.anchorDate}
            data-today-str={todayStr}
            aria-label="Selected day agenda"
          >
            <div class="cal-mobile-agenda__head">
              <div class={`cal-mobile-agenda__date-col${cal.anchorDate === todayStr ? " is-today" : ""}`} id="cal-mobile-agenda-gutter">
                <span class="cal-mobile-agenda__daynum" id="cal-mobile-agenda-daynum">{anchorDayNum}</span>
                <span class="cal-mobile-agenda__dow" id="cal-mobile-agenda-dow">{anchorWeekdayShort}</span>
              </div>
              <div class="cal-mobile-agenda__stream" id="cal-mobile-agenda-items">
                <div class="cal-skeleton-row" aria-hidden="true"></div>
                <div class="cal-skeleton-row cal-skeleton-row--short" aria-hidden="true"></div>
              </div>
            </div>
          </section>
          </>
        )}

        {/* ───────── YEAR VIEW ───────── */}
        {cal.view === "year" && (
          <div class="cal-year-grid">
            {yearMonths.map((ym) => {
              const monthTaskTotal = ym.cells.reduce((sum, c) => sum + (c.isCurrentMonth ? (tasksByDay[c.dateStr]?.count ?? 0) : 0), 0)
              return (
                <section class="cal-year-month" aria-label={`${ym.label} ${ym.year}`}>
                  <div class="cal-year-month__head">
                    <a
                      href={calendarHref({ view: "month", year: ym.year, month: ym.month })}
                      class="cal-year-month__title"
                      data-calendar-nav={`month-${ym.year}-${ym.month}`}
                    >
                      {ym.label}
                    </a>
                    {monthTaskTotal > 0 && (
                      <span class="cal-year-month__count" title={`${monthTaskTotal} scheduled ${monthTaskTotal === 1 ? "item" : "items"}`}>
                        {monthTaskTotal}
                      </span>
                    )}
                  </div>
                  <div class="cal-year-month__grid">
                    {cal.weekLabels.map((dow) => (
                      <span class="cal-year-dow" aria-hidden="true">{dow.slice(0, 1)}</span>
                    ))}
                    {ym.cells.map((cell) => {
                      if (!cell.isCurrentMonth) return <span class="cal-year-day cal-year-day--empty" aria-hidden="true"></span>
                      const info = tasksByDay[cell.dateStr]
                      const total = (info?.count ?? 0) + (info?.haEvents ?? 0)
                      const busyLevel = total >= 4 ? "high" : total >= 2 ? "med" : total >= 1 ? "low" : ""
                      return (
                        <a
                          href={calendarHref({ view: "day", year: ym.year, month: ym.month, date: cell.dateStr })}
                          class={`cal-year-day${cell.isToday ? " cal-year-day--today" : ""}${busyLevel ? ` cal-year-day--${busyLevel}` : ""}`}
                          data-calendar-nav={`day-${cell.dateStr}`}
                          aria-current={cell.isToday ? "date" : undefined}
                          title={total > 0 ? `${ym.shortLabel} ${cell.day}: ${total} scheduled` : `${ym.shortLabel} ${cell.day}`}
                        >
                          <span>{cell.day}</span>
                          {total > 0 && <span class="cal-year-day__dot" aria-hidden="true"></span>}
                        </a>
                      )
                    })}
                  </div>
                </section>
              )
            })}
          </div>
