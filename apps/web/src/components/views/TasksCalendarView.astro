---

import { ensureSchema, getPersistenceClient } from "@domains/tasks/persistence/store"
import { TaskRepository, type CalendarDayInfo } from "@domains/tasks/persistence/task-repository"
import { createCalendarTaskFilter } from "../../lib/calendar-task-filter"
import { calendarOccurrenceStartKey, calendarToday, householdDayRanges } from "../../lib/date"
import { sanitizeCssColor } from "../../lib/safe-html"
import { taskViewUrl } from "../../lib/task-view-route"
import SignalBar from "../layout/SignalBar.astro"
import FilterToolbar from "../ui/FilterToolbar.astro"
import Icon from "../ui/Icon.astro"

const { weekStart = "monday", timezone = "Europe/Dublin" } = Astro.locals;
const tz = timezone || "Europe/Dublin";
const todayStr = calendarToday(tz);
const [todayYear, todayMonth] = todayStr.split("-").map(Number);

// Get current month from query param or default to today in household timezone
const url = new URL(Astro.request.url);
const yearParam = url.searchParams.get("year");
const monthParam = url.searchParams.get("month");

const parsedYear = yearParam ? parseInt(yearParam, 10) : NaN;
const parsedMonth = monthParam ? parseInt(monthParam, 10) : NaN;
const year = Number.isInteger(parsedYear) && parsedYear >= 100 && parsedYear <= 9999 ? parsedYear : todayYear!;
const month = Number.isInteger(parsedMonth) && parsedMonth >= 0 && parsedMonth <= 11 ? parsedMonth : (todayMonth! - 1); // 0-indexed

const firstDay = new Date(Date.UTC(year, month, 1));
const lastDay = new Date(Date.UTC(year, month + 1, 0));

let startDayOfWeek = firstDay.getUTCDay(); // 0=Sun
let weekLabels = ["Sun", "Mon", "Tue", "Wed", "Thu", "Fri", "Sat"];
let isWeekendFn: (dow: number) => boolean = (dow: number) =>
  dow === 0 || dow === 6;

if (weekStart === "monday") {
  startDayOfWeek = (startDayOfWeek + 6) % 7;
  weekLabels = ["Mon", "Tue", "Wed", "Thu", "Fri", "Sat", "Sun"];
  isWeekendFn = (dow: number) => dow === 5 || dow === 6;
} else if (weekStart === "saturday") {
  startDayOfWeek = (startDayOfWeek + 1) % 7;
  weekLabels = ["Sat", "Sun", "Mon", "Tue", "Wed", "Thu", "Fri"];
  isWeekendFn = (dow: number) => dow === 0 || dow === 1;
}

const daysInMonth = lastDay.getUTCDate();

const monthName = firstDay.toLocaleDateString("en-US", {
  month: "long",
  year: "numeric",
  timeZone: "UTC",
});

// Prev/next month links
const prevMonth = month === 0 ? 11 : month - 1;
const prevYear = month === 0 ? year - 1 : year;
const nextMonth = month === 11 ? 0 : month + 1;
const nextYear = month === 11 ? year + 1 : year;

function monthHref(nextYear?: number, nextMonth?: number) {
  const target = taskViewUrl(url, "calendar")
  target.pathname = Astro.url.pathname.startsWith("/boards/household") ? "/boards/household" : "/tasks"
  target.searchParams.delete("calendarRefresh")
  target.searchParams.delete("open")
  target.searchParams.delete("comment")
  if (nextYear === undefined || nextMonth === undefined) {
    target.searchParams.delete("year")
    target.searchParams.delete("month")
  } else {
    target.searchParams.set("year", String(nextYear))
    target.searchParams.set("month", String(nextMonth))
  }
  return target.pathname + target.search + target.hash
}

const filter = createCalendarTaskFilter(url.searchParams, tz)
let calendarAvailable = true
if (url.searchParams.has("calendarRefresh")) Astro.response.headers.set("Cache-Control", "no-store")

// Query task counts per day for this month
const monthPrefix = `${String(year).padStart(4, "0")}-${String(month + 1).padStart(2, "0")}`
const tasksByDay: Record<string, Pick<CalendarDayInfo, "count" | "colors" | "haEvents" | "scheduledEvents">> = {};
let monthTotal = 0;
let monthHAEvents = 0;

try {
  await ensureSchema();
  const repo = new TaskRepository(getPersistenceClient());
  const monthStart = `${monthPrefix}-01`;
  const monthEnd = `${monthPrefix}-${String(daysInMonth).padStart(2, "0")}`;

  const calendarData = await repo.getCalendarTaskCounts(monthStart, monthEnd, tz, {
    matches: filter.matches,
    includeCompleted: filter.includeCompletedInCounts,
  })
  for (const [dateStr, info] of Object.entries(calendarData)) {
    tasksByDay[dateStr] = info;
    monthTotal += info.count;
  }

  const haData = filter.showConnectedEvents ? await repo.getLinkedCalendarEvents(monthStart, monthEnd, tz) : {}
  const syncedOccurrences = new Set<string>()
  for (const [dateStr, events] of Object.entries(haData)) {
    if (!events?.length) continue
    for (const event of events) syncedOccurrences.add(event.id + "/" + calendarOccurrenceStartKey(event.start, tz))
    if (tasksByDay[dateStr]) {
      tasksByDay[dateStr].haEvents = events.length
    } else {
      tasksByDay[dateStr] = { count: 0, colors: [], haEvents: events.length, scheduledEvents: 0 }
    }
  }
  monthHAEvents = syncedOccurrences.size
} catch {
  calendarAvailable = false
  Astro.response.headers.set("Cache-Control", "no-store")
}

// Build calendar grid (6 rows × 7 cols)
interface CalDay {
  day: number;
  dateStr: string;
  isCurrentMonth: boolean;
  isToday: boolean;
  isWeekend: boolean;
  taskCount: number;
  calendarEventCount: number;
  colors: string[];
}

const grid: CalDay[][] = [];
let currentDay = 1 - startDayOfWeek;

for (let week = 0; week < 6; week++) {
  const row: CalDay[] = [];
  for (let dow = 0; dow < 7; dow++) {
    const d = currentDay;
    const isCurrentMonth = d >= 1 && d <= daysInMonth;
    const dateStr = isCurrentMonth
      ? `${monthPrefix}-${String(d).padStart(2, "0")}`
      : "";
    const dayData = tasksByDay[dateStr];
    const scheduledEvents = dayData?.scheduledEvents ?? 0;
    const calendarEventCount = scheduledEvents + (dayData?.haEvents ?? 0);

    row.push({
      day: d,
      dateStr,
      isCurrentMonth,
      isToday: dateStr === todayStr,
      isWeekend: isWeekendFn(dow),
      taskCount: (dayData?.count ?? 0) - scheduledEvents,
      calendarEventCount,
      colors: dayData?.colors ?? [],
    });
    currentDay++;
  }
  // Skip empty trailing weeks
  if (row.every((d) => !d.isCurrentMonth) && week > 0) break;
  grid.push(row);
}

const scheduledDayCount = Object.values(tasksByDay).filter(day => day.count > 0).length
const itemWord = monthTotal === 1 ? "item" : "items"
const dayWord = scheduledDayCount === 1 ? "day" : "days"
const haEventWord = monthHAEvents === 1 ? "synced event" : "synced events"
const agendaNote = filter.matches && !Object.values(tasksByDay).some(day => day.count)
  ? "No tasks match these filters this month."
  : "Open a day to see its agenda."
---

<div id="tasks-view-calendar" class="tasks-view-container" data-task-view="calendar">

  <div id="calendar-shell" class="page-shell" data-timezone={tz}>
    <div class="card calendar-filter-island">
      <FilterToolbar view="calendar" showSearch showGroupBy={false} showSortBy={false} />
    </div>
    <div class="calendar-refresh-status" data-calendar-status role="status" hidden={calendarAvailable}>
      {!calendarAvailable && "Calendar data could not load."}
    </div>
    <button class="btn btn-outline" type="button" data-calendar-retry hidden={calendarAvailable}>Retry calendar</button>
    <div class="calendar-month" data-calendar-month data-calendar-available={String(calendarAvailable)}
      data-calendar-events={String(filter.showConnectedEvents)}>
      {calendarAvailable && <SignalBar>
        <span id="calendar-signal-summary">
          <strong>{monthTotal}</strong> {itemWord} across <strong>{scheduledDayCount}</strong> {dayWord}
          {filter.showConnectedEvents && <> · <strong>{monthHAEvents}</strong> {haEventWord}</>}
        </span>
      </SignalBar>}

      <section class="card calendar-card" aria-labelledby="calendar-month-heading">
        <div class="card-header calendar-controls">
          <h2 class="card-title" id="calendar-month-heading">{monthName}</h2>
          <div class="btn-list calendar-navigation" aria-label="Change month">
            <a href={monthHref()} class="btn cal-today-btn" data-calendar-nav="today">Today</a>
            <div class="btn-group">
              <a href={monthHref(prevYear, prevMonth)} class="btn cal-nav-btn" data-calendar-nav="previous" aria-label="Previous month">
                <Icon name="chevron-down" class="cal-prev-icon" size={16} />
              </a>
              <a href={monthHref(nextYear, nextMonth)} class="btn cal-nav-btn" data-calendar-nav="next" aria-label="Next month">
                <Icon name="chevron-down" class="cal-next-icon" size={16} />
              </a>
            </div>
          </div>
        </div>
      <div class="calendar-grid">
        {
          weekLabels.map((d, i) => (
            <div class={`cal-header ${isWeekendFn(i) ? "cal-header-weekend" : ""}`}>
              {d}
            </div>
          ))
        }
        {
          grid.flat().map((cell) => {
            const ranges = cell.isCurrentMonth && filter.showConnectedEvents ? householdDayRanges(cell.dateStr, tz) : undefined
            return <div
              id={cell.isCurrentMonth ? `calendar-day-${cell.dateStr}` : undefined}
              class={`cal-cell ${cell.isToday ? "cal-today" : ""} ${!cell.isCurrentMonth ? "cal-other" : ""} ${cell.isWeekend && cell.isCurrentMonth ? "cal-weekend" : ""} ${cell.taskCount > 0 ? "cal-has-tasks" : ""}`}
              data-date={cell.dateStr}
              data-day-ranges={ranges?.length === 1 ? undefined : JSON.stringify(ranges)}
              role={cell.isCurrentMonth ? "button" : undefined}
              tabindex={cell.isCurrentMonth ? "0" : undefined}
              aria-current={cell.isToday ? "date" : undefined}
            >
              {cell.isCurrentMonth && (
                <div>
                  <span
                    class={`cal-day-num ${cell.isToday ? "cal-day-today" : ""}`}
                  >
                    {cell.day}<span class="sr-only">{` ${monthName}`}</span>
                  </span>
                  {(cell.taskCount > 0 || cell.calendarEventCount > 0) && (
                    <div class="cal-task-indicator">
                      {cell.taskCount > 0 && <span class="cal-task-badge">
                        {cell.taskCount}<span class="sr-only">{cell.taskCount === 1 ? " task" : " tasks"}</span>
                      </span>}
                      {cell.calendarEventCount > 0 && (
                        <span class="cal-event-badge">
                          <Icon name="calendar-event" size={12} />
                          <span>{cell.calendarEventCount}<span class="sr-only">{cell.calendarEventCount === 1 ? " calendar event" : " calendar events"}</span></span>
                        </span>
                      )}
                      {cell.colors.length > 0 && (
                        <div class="cal-color-dots">
                          {cell.colors.map((c) => (
                            <span
                              class="cal-color-dot"
                              style={`background: ${sanitizeCssColor(c)};`}
                            />
                          ))}
                        </div>
                      )}
                    </div>
                  )}
                  {filter.showConnectedEvents && <div class="cal-inline-events" data-inline-date={cell.dateStr}></div>}
                </div>
              )}
            </div>
          })
        }
      </div>

        <p class="card-footer calendar-agenda-note">
          {calendarAvailable ? agendaNote : "Calendar counts are temporarily unavailable."}
        </p>
      </section>
    </div>

    <div class="day-drawer" id="day-drawer" aria-hidden="true">
      <div class="day-drawer-backdrop" id="day-drawer-backdrop"></div>
      <div class="day-drawer-panel" role="dialog" aria-modal="true" aria-labelledby="day-drawer-title">
        <div class="day-drawer-header">
          <h3 class="day-drawer-title" id="day-drawer-title"></h3>
          <button type="button" class="btn btn-icon day-drawer-close" id="day-drawer-close" aria-label="Close"><Icon name="x" size={18} /></button>
        </div>
        <div class="day-drawer-content">
          <div class="day-drawer-section" data-calendar-events-section>
            <h4 class="day-drawer-section-title flex items-center gap-1.5">
              <Icon name="calendar-event" size={14} />
              Connected Calendar Events
            </h4>
            <div id="day-drawer-events">
              <div id="day-drawer-event-items" class="day-drawer-list"></div>
              <div id="day-drawer-event-status" class="day-drawer-read-status" role="status"></div>
            </div>
          </div>
          <div class="day-drawer-section">
            <h4 class="day-drawer-section-title flex items-center gap-1.5">
              <Icon name="clipboard-list" size={14} />
              Scheduled items
            </h4>
            <div id="day-drawer-tasks">
              <div id="day-drawer-task-items" class="day-drawer-list"></div>
              <div id="day-drawer-task-status" class="day-drawer-read-status" role="status"></div>
            </div>
            <button type="button" class="btn btn-outline day-drawer-more" id="day-drawer-more-tasks" hidden>Load more items</button>
          </div>
          <div class="day-drawer-actions">
            <button type="button" class="btn day-drawer-add" id="day-drawer-add-event"><Icon name="plus" size={14} /> Add Event</button>
            <button type="button" class="btn btn-primary day-drawer-add" id="day-drawer-add-task"><Icon name="plus" size={14} /> Add Task</button>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<style>
  #calendar-shell, .calendar-month {
    display: grid;
    gap: 12px;
    min-width: 0;
  }
  .calendar-filter-island {
    position: relative;
    overflow: visible;
    z-index: 2;
    margin-block-start: 12px;
    padding: 10px 12px;
  }
  .calendar-refresh-status {
    color: var(--text-muted);
    padding-inline: 4px;
  }
  [data-calendar-retry]:not([hidden]) {
    justify-self: start;
  }
  [data-calendar-retry][aria-disabled="true"] {
    opacity: .65;
    cursor: wait;
  }
  .calendar-card {
    overflow: hidden;
    min-width: 0;
  }
  .calendar-controls {
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 8px 16px;
    padding: 12px 16px;
  }
  .calendar-controls h2 {
    font-size: 16px;
    margin: 0;
  }
  .calendar-navigation, .calendar-navigation .btn-group {
    display: inline-flex;
    align-items: center;
  }
  .calendar-navigation { gap: 8px; }
  .calendar-navigation .btn-group > .btn:first-child { border-start-end-radius: 0; border-end-end-radius: 0; }
  .calendar-navigation .btn-group > .btn:last-child { border-start-start-radius: 0; border-end-start-radius: 0; }
  .calendar-navigation .btn-group > .btn + .btn { margin-inline-start: -1px; }
  .cal-nav-btn { min-width: 36px; }
  .cal-nav-btn > :global(.cal-prev-icon) { transform: rotate(90deg); }
  .cal-nav-btn > :global(.cal-next-icon) { transform: rotate(-90deg); }
  .calendar-agenda-note {
    margin: 0;
    padding: 9px 16px;
    color: var(--text-muted);
    font-size: 13px;
  }

  .calendar-grid {
    display: grid;
    grid-template-columns: repeat(7, minmax(0, 1fr));
    gap: 1px;
    background: var(--border);
    border-block: 1px solid var(--border);
  }

  @media (pointer: coarse) {
    .calendar-grid {
      grid-template-columns: repeat(7, minmax(44px, 1fr));
      overflow-x: auto;
      touch-action: pan-x pan-y;
    }
  }
  @media (pointer: coarse) and (max-width: 380px) {
    .calendar-card {
      max-width: none;
      margin-inline: -10px;
      padding-inline: 0;
    }
  }

  .cal-header {
    padding: 8px;
    text-align: center;
    font-size: 11px;
    font-weight: 600;
    color: var(--text-muted);
    background: var(--bg-secondary);
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }
  .cal-header-weekend {
    background: color-mix(in srgb, var(--bg-secondary) 70%, var(--border));
  }

  .cal-cell {
    padding: 8px;
    min-height: 80px;
    background: var(--bg-card);
    cursor: default;
    position: relative;
    transition: background 0.15s;
  }
  .cal-cell[role="button"] {
    cursor: pointer;
  }
  .cal-cell[role="button"]:hover {
    background: var(--bg-hover);
  }
  .cal-cell:focus-visible {
    outline: 2px solid var(--border-focus);
    outline-offset: -2px;
    z-index: 1;
  }

  .cal-today {
    background: var(--bg-hover) !important;
  }
  .cal-other {
    background: var(--bg-secondary);
  }
  .cal-weekend {
    background: color-mix(in srgb, var(--bg-card) 90%, var(--bg-secondary) 10%);
  }

  .cal-day-num {
    font-size: 13px;
    font-weight: 400;
    color: var(--text-primary);
  }
  .cal-day-today {
    font-weight: 700;
    width: 24px;
    height: 24px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border-radius: 50%;
    font-size: 12px;
  }

  .cal-task-indicator {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 3px;
    margin-top: 4px;
  }
  .cal-task-badge {
    font-size: 10px;
    padding: 1px 5px;
    border-radius: 8px;
    font-weight: 600;
  }
  .cal-day-today,
  .cal-task-badge {
    color: var(--personal-accent-foreground, var(--palette-on-accent, #07140f));
    background: var(--personal-accent, var(--palette-accent-hover));
  }
  .cal-color-dots {
    display: flex;
    gap: 2px;
    margin-top: 3px;
  }
  .cal-color-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    box-shadow: 0 0 0 1px rgba(0, 0, 0, 0.2);
  }
  .cal-event-badge {
    display: inline-flex;
    align-items: center;
    gap: 2px;
    max-width: 100%;
    color: var(--text-secondary);
    font-size: 10px;
    font-weight: 600;
    font-variant-numeric: tabular-nums;
    overflow-wrap: anywhere;
  }
  .cal-event-badge svg { flex-shrink: 0; }

  @media (max-width: 640px) {
    .calendar-navigation .btn { min-height: 44px; }
    .cal-cell {
      min-height: 48px;
      padding: 4px;
    }
    .cal-header { padding-inline: 2px; }
    .cal-day-num {
      font-size: 11px;
    }
  }

  /* Inline event previews */
  .cal-inline-events {
    margin-top: 2px;
    display: flex;
    flex-direction: column;
    gap: 1px;
  }
  :global(.cal-inline-event) {
    font-size: 11px;
    color: var(--text-secondary);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    padding: 1px 3px;
    border-radius: 3px;
    background: var(--accent-bg, rgba(99, 102, 241, 0.08));
    line-height: 1.3;
  }
  :global(.cal-inline-event.cal-inline-ha) {
    background: var(--accent-bg);
    color: var(--accent-text);
  }
  :global(.cal-inline-more) {
    font-size: 9px;
    color: var(--text-muted);
    padding: 0 3px;
  }

  /* Day Detail Drawer */
  .day-drawer {
    position: fixed;
    inset: 0;
    z-index: 200;
    pointer-events: none;
    visibility: hidden;
  }
  .day-drawer[aria-hidden="false"] {
    pointer-events: auto;
    visibility: visible;
  }
  .day-drawer-backdrop {
    position: fixed;
    inset: 0;
    background: rgba(0, 0, 0, 0.4);
    opacity: 0;
    transition: opacity 0.2s;
  }
  .day-drawer[aria-hidden="false"] .day-drawer-backdrop {
    opacity: 1;
  }
  .day-drawer-panel {
    position: fixed;
    top: 0;
    right: 0;
    bottom: 0;
    width: min(400px, 90vw);
    background: var(--bg-card);
    border-left: 1px solid var(--border);
    transform: translateX(100%);
    transition: transform 0.25s ease;
    display: flex;
    flex-direction: column;
    overflow-y: auto;
  }
  .day-drawer[aria-hidden="false"] .day-drawer-panel {
    transform: translateX(0);
  }
  .day-drawer-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 16px 20px;
    border-bottom: 1px solid var(--border);
    position: sticky;
    top: 0;
    background: var(--bg-card);
    z-index: 1;
  }
  .day-drawer-title {
    margin: 0;
    font-size: 16px;
    font-weight: 600;
    color: var(--text-primary);
  }
  .day-drawer-close {
    min-inline-size: 44px;
    min-block-size: 44px;
  }
  .day-drawer-content {
    padding: 16px 20px;
    flex: 1;
  }
  .day-drawer-section {
    margin-bottom: 20px;
  }
  .day-drawer-section-title {
    margin: 0 0 10px;
    font-size: 13px;
    font-weight: 600;
    color: var(--text-secondary);
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }
  .day-drawer-list {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }
  :global(.day-drawer-item) {
    padding: 8px 12px;
    background: var(--bg-secondary);
    border-radius: 8px;
    display: flex;
    align-items: center;
    gap: 10px;
    transition: background 0.15s;
    border: 1px solid transparent;
    text-align: start;
  }
  :global(button.day-drawer-item) { cursor: pointer; min-block-size: 44px; }
  :global(.day-drawer-item:hover) {
    background: var(--bg-hover);
  }
  :global(.day-drawer-item-icon) {
    font-size: 16px;
    flex-shrink: 0;
  }
  :global(.day-drawer-item-content) {
    display: grid;
    gap: 2px;
    flex: 1;
    min-width: 0;
  }
  :global(.day-drawer-item-title) {
    font-size: 13px;
    font-weight: 500;
    color: var(--text-primary);
    overflow-wrap: anywhere;
  }
  :global(.day-drawer-item-meta) {
    font-size: 11px;
    color: var(--text-muted);
  }
  .day-drawer-read-status:not(:empty) {
    padding-block: 8px 0;
    color: var(--text-muted);
    font-size: 12px;
    white-space: pre-line;
  }
  .day-drawer-more:not([hidden]) {
    margin-block-start: 8px;
    min-height: 44px;
    white-space: normal;
  }
  .day-drawer-actions {
    display: flex;
    gap: 8px;
    padding-top: 12px;
    border-top: 1px solid var(--border);
  }
  .day-drawer-add {
    flex: 1;
    font-size: 12px;
  }

  @media (prefers-reduced-motion: reduce) {
    .day-drawer-backdrop, .day-drawer-panel { transition: none; }
  }
</style>

<script>
  import { initCalendarPage } from "../../lib/calendar-controller"
  import { pageLifecycle } from "../../lib/page-lifecycle"

  pageLifecycle.onPageLoad(initCalendarPage)
</script>
