          </div>
          <div class="day-drawer-actions">
            <button type="button" class="btn day-drawer-add" id="day-drawer-add-event"><Icon name="plus" size={14} /> Add Event</button>
            <button type="button" class="btn btn-primary day-drawer-add" id="day-drawer-add-task"><Icon name="plus" size={14} /> Add Task</button>
