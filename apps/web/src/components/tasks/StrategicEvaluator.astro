---
import { getCollection } from "astro:content"
import Icon from "../ui/Icon.astro"
interface Props { embedded?: boolean }
const { embedded = false } = Astro.props
const Heading = embedded ? "span" : "h3"
const frameworks = await getCollection("frameworks")
---

<section id="strategic-evaluator-inline" class:list={["ticket-scoring", { "ticket-scoring--embedded": embedded }]} data-frameworks={JSON.stringify(frameworks)} aria-labelledby="se-title">
  <Heading id="se-title" class:list={{ "sr-only": embedded }}>Scoring & frameworks</Heading>
  <p class="settings-hint">Choose a framework, enter your estimates, and save the evaluation.</p>
  <label for="se-framework">Scoring framework</label>
  <select id="se-framework" class="form-select" disabled>
    {frameworks.map((framework: { id: string; data: { name: string } }) => <option value={framework.id}>{framework.data.name}</option>)}
  </select>
  <form id="se-form">
    <div id="se-legacy-banner" class="alert alert-warning mb-2" role="note" hidden></div>
    <fieldset id="se-fields" disabled>
      <div id="se-content" class="ticket-scoring__fields"></div>
      <small id="se-formula-preview" class="settings-hint d-block mt-2"></small>
      <div class="ticket-scoring__actions">
        <output id="se-live-result" aria-live="off"></output>
        <button type="submit" id="se-save" class="btn btn-primary">Save score</button>
        <button type="button" id="se-ask-ai" class="btn btn-secondary"><Icon name="sparkles" size={14} sprite={true} /> Auto-score with Assist</button>
      </div>
    </fieldset>
  </form>
  <p id="se-status" role="status" class="settings-hint">Loading scoring frameworks…</p>
</section>

<script>
  import "@lib/strategic-evaluator-controller"
</script>

<style>
  .ticket-scoring { display: grid; gap: .75rem; min-width: 0; border: 1px solid var(--border); border-radius: var(--radius-md); padding: 1rem; background: var(--bg-card); }
  .ticket-scoring--embedded { padding: 0; border: 0; background: transparent; }
  .ticket-scoring h3 { margin: 0; font-size: 1rem; }
  .ticket-scoring fieldset { min-width: 0; border: 0; padding: 0; margin: 0; }
  .ticket-scoring__fields { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 220px), 1fr)); gap: 0.875rem; }
  .ticket-scoring__fields :global(.se-field--slider) {
    display: flex;
    flex-direction: column;
    gap: 0.45rem;
    padding: 0.7rem 0.8rem;
    border: 1px solid var(--border);
    border-radius: var(--radius-md, 8px);
    background: color-mix(in srgb, var(--bg-input) 65%, var(--bg-card));
  }
  .ticket-scoring__fields :global(.se-field__head) {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem;
  }
  .ticket-scoring__fields :global(.se-field__head label) {
    margin-bottom: 0;
    font-size: 0.8125rem;
    font-weight: 600;
    color: var(--text-primary);
  }
  .ticket-scoring__fields :global(.se-field__num-wrap) {
    display: inline-flex;
    align-items: center;
    gap: 0.25rem;
  }
  .ticket-scoring__fields :global(.se-number-input) {
    width: 4.85rem;
    min-height: 1.9rem;
    padding: 0.2rem 0.45rem;
    text-align: right;
    font-size: 0.8125rem;
    font-weight: 600;
    font-variant-numeric: tabular-nums;
  }
  .ticket-scoring__fields :global(.se-field__suffix) {
    font-size: 0.75rem;
    font-weight: 600;
    color: var(--text-muted);
  }
  .ticket-scoring__fields :global(.se-range) {
    width: 100%;
    height: 1.25rem;
    accent-color: var(--accent);
    cursor: pointer;
  }
  .ticket-scoring__fields :global(.se-field__ticks) {
    display: flex;
    justify-content: space-between;
    font-size: 0.6875rem;
    color: var(--text-muted);
    font-variant-numeric: tabular-nums;
  }
  .ticket-scoring__fields :global(label) { display: block; font-weight: 500; margin-bottom: .375rem; }
  .ticket-scoring__fields :global(small) { display: block; color: var(--text-secondary); margin-top: .25rem; font-size: 0.72rem; overflow-wrap: anywhere; }
  .ticket-scoring__actions { display: flex; flex-wrap: wrap; align-items: center; gap: .75rem; margin-top: 1rem; }
  .ticket-scoring__actions output { flex: 1; min-width: 140px; color: var(--text-primary); font-variant-numeric: tabular-nums; }
</style>
