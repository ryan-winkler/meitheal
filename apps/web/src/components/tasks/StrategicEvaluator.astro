---
import { getCollection } from "astro:content"
const frameworks = await getCollection("frameworks")
---

<section id="strategic-evaluator-inline" class="ticket-scoring" data-frameworks={JSON.stringify(frameworks)} aria-labelledby="se-title">
  <h3 id="se-title">Scoring & frameworks</h3>
  <p class="settings-hint">Choose a framework, enter your estimates, and save the evaluation.</p>
  <label for="se-framework">Scoring framework</label>
  <select id="se-framework" class="form-select" disabled>
    {frameworks.map((framework: { id: string; data: { name: string } }) => <option value={framework.id}>{framework.data.name}</option>)}
  </select>
  <form id="se-form">
    <fieldset id="se-fields" disabled>
      <div id="se-content" class="ticket-scoring__fields"></div>
      <div class="ticket-scoring__actions">
        <output id="se-live-result" aria-live="off"></output>
        <button type="submit" id="se-save" class="btn btn-primary">Save score</button>
        <button type="button" id="se-ask-ai" class="btn btn-secondary">Auto-score with Assist</button>
      </div>
    </fieldset>
  </form>
  <p id="se-status" role="status" class="settings-hint">Loading scoring frameworks…</p>
</section>

<script>
  import "@lib/strategic-evaluator-controller"
</script>

<style>
  .ticket-scoring { display: grid; gap: .75rem; min-width: 0; border: 1px solid var(--border); border-radius: var(--radius-md); padding: 1rem; background: var(--bg-card); }
  .ticket-scoring h3 { margin: 0; font-size: 1rem; }
  .ticket-scoring fieldset { min-width: 0; border: 0; padding: 0; margin: 0; }
  .ticket-scoring__fields { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 220px), 1fr)); gap: 1rem; }
  .ticket-scoring__fields :global(label) { display: block; font-weight: 500; margin-bottom: .375rem; }
  .ticket-scoring__fields :global(small) { display: block; color: var(--text-secondary); margin-top: .375rem; overflow-wrap: anywhere; }
  .ticket-scoring__actions { display: flex; flex-wrap: wrap; align-items: center; gap: .75rem; margin-top: 1rem; }
  .ticket-scoring__actions output { flex: 1; min-width: 140px; color: var(--text-primary); }
</style>
