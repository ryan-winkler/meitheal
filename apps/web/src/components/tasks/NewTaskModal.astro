  @import "../../styles/inline-date-picker.css";
  #nt-status-pills :global(.filter-toolbar__type-btn:not(.active)) { opacity: 1; }
  .nt-due-picker { min-height: 44px; }
  .nt-due-picker :global(.idp-trigger) { min-width: 44px; min-height: 44px; color: var(--text-primary); opacity: 1; white-space: normal; }
  .nt-due-picker :global(.idp-date-text) { white-space: normal; overflow-wrap: anywhere; }
  .nt-due-picker :global(.idp-clear-btn) { display: inline; min-width: 44px; min-height: 44px; }
  :global(.nt-due-date-panel) { width: min(420px, calc(100vw - 16px)); min-width: 0; max-height: calc(100dvh - 16px); overflow: auto; }
  @media (max-width: 440px) {
    :global(.nt-due-date-panel) { flex-direction: column; }
    :global(.nt-due-date-panel .idp-quick-options) { flex-basis: auto; max-height: 140px; border-right: 0; border-bottom: 1px solid var(--border); }
    :global(.nt-due-date-panel .idp-calendar) { min-width: 0; }
  }
  .nt-draft-panel [hidden], .nt-footer [hidden] { display: none !important; }
</style>
