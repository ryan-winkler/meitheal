    border-top: 1px solid var(--border-dim);
    padding: 0.625rem clamp(0.75rem, 4vw, 1.5rem);
    font-size: 0.875rem;
    overflow-wrap: anywhere;
  }
  .nt-draft-panel [hidden], .nt-footer [hidden] { display: none !important; }
  .nt-draft-actions, .nt-draft-confirm {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.25rem 0.5rem;
  }
  .nt-draft-confirm p { width: 100%; }
  .nt-draft-panel .btn { min-height: 2.75rem; }
  #nt-capture-validation { color: var(--text-primary); }
  .nt-kind-pill {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    padding: 0.375rem 0.75rem;
    font-size: 0.75rem;
    font-weight: 500;
    border-radius: 9999px;
    border: 1px solid var(--border-dim);
    background: transparent;
    color: var(--text-muted);
    cursor: pointer;
    transition: background 0.15s ease, color 0.15s ease, border-color 0.15s ease;
    white-space: nowrap;
  }
  .nt-kind-pill:hover {
    background: color-mix(in srgb, var(--border-dim) 20%, transparent);
    color: var(--text-primary);
  }
  .nt-kind-pill.active {
    background: color-mix(in srgb, var(--accent) 16%, transparent);
    border-color: color-mix(in srgb, var(--accent) 30%, transparent);
    color: var(--accent-text);
    font-weight: 600;
  }
  #nt-status-pills :global(.filter-toolbar__type-btn:not(.active)) {
    opacity: 1;
  }
  #nt-add-custom-field-btn {
    color: var(--accent-text);
  }
