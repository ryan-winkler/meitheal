---
import { t } from "../../i18n/translations";
import type { Locale } from "../../lib/locale";
import Icon from "../ui/Icon.astro";
import LabelPicker from "../ui/LabelPicker.astro";

const cookieLocale = Astro.cookies.get("meitheal-locale")?.value;
const locale: Locale = cookieLocale === "ga" ? "ga" : "en";
---

<div id="new-task-overlay" class="modal-overlay" role="dialog" aria-modal="true" aria-labelledby="new-task-title">
  <div class="modal-content nt-modal">
    <header class="nt-header">
      <h2 id="new-task-title">{t("tasks.new_task_modal", locale)}</h2>
      <button type="button" class="btn btn-ghost nt-icon-button" id="close-new-task-modal" aria-label="Close">
        <Icon name="x" size={18} sprite={true} />
      </button>
    </header>
    <form id="new-task-form" class="nt-form"
      data-toast-created={t("task_modal.toast_created", locale)}
      data-toast-error={t("task_modal.toast_error", locale)}
      data-toast-unexpected={t("task_modal.toast_unexpected", locale)}
      data-save-failed={t("task_modal.form_save_failed", locale)}
    >
      <input type="hidden" name="task_kind" id="new-task-kind" value="standard_action" />
      <fieldset class="nt-group">
        <legend>{t("task_modal.type_label", locale)}</legend>
        <div class="nt-kind-grid" id="nt-kind-tabs">
          <button type="button" class="nt-kind-pill active" data-kind="standard_action" aria-pressed="true">{t("task_modal.kind_task", locale)}</button>
          <button type="button" class="nt-kind-pill" data-kind="shopping_item" aria-pressed="false">{t("task_modal.kind_shopping_list", locale)}</button>
          <button type="button" class="nt-kind-pill" data-kind="checklist" aria-pressed="false">{t("task_modal.kind_checklist", locale)}</button>
          <button type="button" class="nt-kind-pill" data-kind="calendar_event" aria-pressed="false">{t("task_modal.kind_event", locale)}</button>
        </div>
      </fieldset>
      <div class="nt-field">
        <label for="new-task-title-input">{t("tasks.title_label", locale)} <span class="nt-hint">({t("task_modal.required_label", locale)})</span></label>
        <textarea rows="1" class="form-input" id="new-task-title-input" name="title" maxlength="500" required autofocus
          placeholder={t("task_modal.title_placeholder", locale)}
          data-placeholder-task={t("task_modal.title_placeholder", locale)}
          data-placeholder-shopping={t("task_modal.title_placeholder_shopping", locale)}
          data-placeholder-checklist={t("task_modal.title_placeholder_checklist", locale)}
          data-placeholder-event={t("task_modal.title_placeholder_event", locale)}></textarea>
      </div>
      <div class="nt-field">
        <label for="new-task-desc-input">{t("tasks.description", locale)}</label>
        <textarea class="form-input" id="new-task-desc-input" name="description" rows="2" maxlength="10000"
          placeholder={t("task_modal.description_placeholder", locale)}></textarea>
      </div>
      <div id="nt-contextual-fields" class="nt-context hidden">
        <fieldset id="nt-contextual-checklist" class="nt-group hidden">
          <legend>{t("task_modal.checklist_items", locale)}</legend>
          <div class="nt-field">
            <label for="nt-checklist-builder-input">{t("task_modal.checklist_input", locale)}</label>
            <div class="nt-entry-group">
              <textarea id="nt-checklist-builder-input" rows="2" class="form-input" aria-describedby="nt-checklist-hint"></textarea>
              <button type="button" class="btn btn-secondary" id="nt-add-sub-item-btn">{t("task_modal.add_sub_item", locale)}</button>
            </div>
            <p class="nt-hint" id="nt-checklist-hint">{t("task_modal.checklist_input_hint", locale)}</p>
          </div>
          <ol id="nt-checklist-items-container" class="ticket-item-list" role="list"></ol>
          <p id="nt-checklist-count" class="sr-only" role="status" data-count-label={t("task_modal.items_count", locale)}></p>
        </fieldset>
        <fieldset id="nt-contextual-shopping" class="nt-group hidden">
          <legend>{t("task_modal.shopping_items", locale)}</legend>
          <div class="nt-form-grid">
            <div class="nt-field">
              <label for="nt-shopping-qty">{t("task_modal.quantity_field", locale)}</label>
              <input type="number" id="nt-shopping-qty" value="1" min="1" max="999" class="form-input" />
            </div>
            <div class="nt-field">
              <label for="nt-shopping-category">{t("task_modal.category_field", locale)}</label>
              <select id="nt-shopping-category" class="form-select">
                <option value="">{t("task_modal.category_uncategorized", locale)}</option>
                <option value="produce">{t("task_modal.category_produce", locale)}</option>
                <option value="dairy">{t("task_modal.category_dairy", locale)}</option>
                <option value="meat">{t("task_modal.category_meat", locale)}</option>
                <option value="pantry">{t("task_modal.category_pantry", locale)}</option>
                <option value="frozen">{t("task_modal.category_frozen", locale)}</option>
                <option value="beverages">{t("task_modal.category_beverages", locale)}</option>
                <option value="household">{t("task_modal.category_household", locale)}</option>
                <option value="other">{t("task_modal.category_other", locale)}</option>
              </select>
            </div>
          </div>
          <div class="nt-field">
            <label for="nt-shopping-item-input">{t("task_modal.shopping_input", locale)}</label>
            <div class="nt-entry-group">
              <input type="text" id="nt-shopping-item-input" class="form-input" />
              <button type="button" id="nt-add-shopping-item" class="btn btn-secondary">{t("task_modal.add_item", locale)}</button>
            </div>
          </div>
          <ol id="nt-shopping-items-list" class="ticket-item-list" role="list"></ol>
        </fieldset>
        <fieldset id="nt-contextual-event" class="nt-group hidden">
          <legend>{t("task_modal.event_schedule", locale)}</legend>
          <div class="nt-form-grid">
            <div class="nt-field">
              <label for="nt-event-start">{t("task_modal.start_field", locale)}</label>
              <input type="datetime-local" id="nt-event-start" name="start_date" step="any" class="form-input" />
            </div>
            <div class="nt-field">
              <label for="nt-event-end">{t("task_modal.end_field", locale)}</label>
              <input type="datetime-local" id="nt-event-end" name="end_date" step="any" class="form-input" aria-describedby="nt-date-error" />
              <p id="nt-date-error" class="nt-error" hidden>{t("task_modal.event_end_error", locale)}</p>
            </div>
          </div>
        </fieldset>
      </div>
      <fieldset class="nt-group">
        <legend>{t("task_modal.details_group", locale)}</legend>
        <div class="nt-field">
          <input type="hidden" id="new-task-status" name="status" value="pending" />
          <div id="nt-status-pills" class="filter-toolbar__type-toggles" role="radiogroup" aria-label="Task status">
            <button type="button" class="filter-toolbar__type-btn active" data-status="pending" role="radio" aria-checked="true">{t("task_modal.status_todo", locale)}</button>
          </div>
        </div>
        <div class="nt-form-grid">
          <div class="nt-field">
            <label for="new-task-priority">{t("tasks.priority_label", locale)}</label>
            <select id="new-task-priority" name="priority" class="form-select">
              <option value="1">{t("task_modal.priority_urgent", locale)}</option>
              <option value="2">{t("task_modal.priority_high", locale)}</option>
              <option value="3" selected>{t("task_modal.priority_normal", locale)}</option>
              <option value="4">{t("task_modal.priority_low", locale)}</option>
              <option value="5">{t("tasks.priority_label", locale)} 5</option>
            </select>
          </div>
          <div id="nt-ctx-due-row" class="nt-field">
            <label id="nt-due-label">{t("tasks.due_date", locale)}</label>
            <input type="hidden" id="nt-contextual-due" name="due_date" />
            <div id="nt-due-date-picker" class="nt-due-picker" role="group" aria-labelledby="nt-due-label"></div>
          </div>
          <div class="nt-field" id="nt-assignee-field">
            <label for="new-task-assigned-to">{t("task_modal.assignee_label", locale)}</label>
            <select id="new-task-assigned-to" name="assigned_to" class="form-select">
              <option value="">{t("task_modal.unassigned", locale)}</option>
            </select>
          </div>
        </div>
      </fieldset>
      <details class="nt-options" id="nt-options">
        <summary>{t("task_modal.more_options", locale)}</summary>
        <div class="nt-options-content">
          <div class="nt-form-grid">
            <div class="nt-field">
              <label for="new-task-goal">{t("task_modal.goal_label", locale)}</label>
              <select id="new-task-goal" name="goal_id" class="form-select"><option value="">{t("task_modal.goal_none", locale)}</option></select>
            </div>
            <div class="nt-field">
              <label for="new-task-recurrence">{t("task_modal.repeat_label", locale)}</label>
              <select id="new-task-recurrence" name="recurrence_rule" class="form-select">
                <option value="">{t("task_modal.recurrence_none", locale)}</option>
                <option value="FREQ=DAILY">{t("task_modal.recurrence_daily", locale)}</option>
                <option value="FREQ=WEEKLY">{t("task_modal.recurrence_weekly", locale)}</option>
                <option value="FREQ=WEEKLY;BYDAY=MO,TU,WE,TH,FR">{t("task_modal.recurrence_weekday", locale)}</option>
                <option value="FREQ=MONTHLY">{t("task_modal.recurrence_monthly", locale)}</option>
                <option value="FREQ=YEARLY">{t("task_modal.recurrence_yearly", locale)}</option>
              </select>
            </div>
          </div>
          <div class="nt-field">
            <label for="new-task-label-picker-input">{t("task_modal.tags_label", locale)}</label>
            <LabelPicker deferCreate id="new-task-label-picker" name="labels" />
          </div>
      <!-- Custom Fields (collapsible) -->
      <div id="nt-custom-fields" class="nt-options-section">
        <div class="flex items-center justify-between p-2">
          <button type="button" id="nt-custom-fields-toggle" aria-controls="nt-custom-fields-container" aria-expanded="false" class="flex items-center gap-1.5 text-xs font-semibold text-text-muted uppercase tracking-wider hover:text-text-primary transition-colors">
            <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M6 9l6 6 6-6"></path></svg>
            {t("task_modal.custom_fields_label", locale)}
          </button>
          <button type="button" id="nt-add-custom-field-btn" aria-controls="nt-add-field-dropdown" aria-expanded="false" class="text-xs font-medium flex items-center gap-1">
            <svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="12" y1="5" x2="12" y2="19"></line><line x1="5" y1="12" x2="19" y2="12"></line></svg>
            {t("task_modal.custom_field_add", locale)}
          </button>
        </div>
        <div id="nt-custom-fields-container" class="hidden space-y-2 mt-2 p-3 nt-feature-card">
          <div id="nt-custom-fields-list" class="space-y-2"></div>
          <div id="nt-add-field-dropdown" class="hidden flex-wrap gap-1.5 pt-2 border-t border-border-dim/30">
            <button type="button" class="nt-add-field-type text-xs px-2.5 py-1 bg-bg-input/50 border border-border-dim rounded-lg hover:bg-border-dim/30 transition-colors flex items-center gap-1" data-field-type="url"><Icon name="link" size={14} sprite={true} /> {t("task_modal.custom_field_url", locale)}</button>
            <button type="button" class="nt-add-field-type text-xs px-2.5 py-1 bg-bg-input/50 border border-border-dim rounded-lg hover:bg-border-dim/30 transition-colors flex items-center gap-1" data-field-type="text"><Icon name="file-text" size={14} sprite={true} /> {t("task_modal.custom_field_text", locale)}</button>
            <button type="button" class="nt-add-field-type text-xs px-2.5 py-1 bg-bg-input/50 border border-border-dim rounded-lg hover:bg-border-dim/30 transition-colors flex items-center gap-1" data-field-type="number"><Icon name="hash" size={14} sprite={true} /> {t("task_modal.custom_field_number", locale)}</button>
            <button type="button" class="nt-add-field-type text-xs px-2.5 py-1 bg-bg-input/50 border border-border-dim rounded-lg hover:bg-border-dim/30 transition-colors flex items-center gap-1" data-field-type="date"><Icon name="calendar" size={14} sprite={true} /> {t("task_modal.custom_field_date", locale)}</button>
            <button type="button" class="nt-add-field-type text-xs px-2.5 py-1 bg-bg-input/50 border border-border-dim rounded-lg hover:bg-border-dim/30 transition-colors flex items-center gap-1" data-field-type="checkbox"><Icon name="checkbox" size={14} sprite={true} /> {t("task_modal.custom_field_checkbox", locale)}</button>
          </div>
        </div>
      </div>

          <p class="nt-hint">{t("task_modal.images_after_create", locale)}</p>
          <p class="nt-hint">{t("task_modal.routine_hint", locale)} <a href="/habits">{t("nav.habits", locale)}</a></p>
        </div>
      </details>
      <p id="nt-capture-validation" class="nt-error" role="alert" hidden></p>
    </form>
    <div id="nt-draft-panel" class="nt-draft-panel" hidden>
      <p id="nt-draft-status" role="status" aria-live="polite"></p>
      <div class="nt-draft-actions">
        <button type="button" id="nt-draft-save" class="btn btn-ghost" hidden>{t("task_draft.save", locale)}</button>
        <button type="button" id="nt-draft-resume" class="btn btn-ghost" hidden>{t("task_draft.resume", locale)}</button>
        <button type="button" id="nt-draft-discard" class="btn btn-ghost" hidden>{t("task_draft.discard", locale)}</button>
        <button type="button" id="nt-draft-recover" class="btn btn-ghost" hidden>{t("task_draft.check", locale)}</button>
        <button type="button" id="nt-draft-retry" class="btn btn-ghost" hidden>{t("task_draft.retry", locale)}</button>
        <button type="button" id="nt-draft-abandon" class="btn btn-ghost" hidden>{t("task_draft.keep", locale)}</button>
        <button type="button" id="nt-draft-clear" class="btn btn-ghost" hidden>{t("task_draft.new_task", locale)}</button>
        <button type="button" id="nt-draft-update" class="btn btn-ghost" hidden>{t("task_draft.activate", locale)}</button>
        <button type="button" id="nt-draft-open-task" class="btn btn-ghost" hidden>{t("task_draft.open_task", locale)}</button>
      </div>
      <div id="nt-draft-confirm" class="nt-draft-confirm" hidden>
        <p id="nt-draft-confirm-message"></p>
        <button type="button" id="nt-draft-confirm-no" class="btn btn-ghost">{t("task_draft.keep_editing", locale)}</button>
        <button type="button" id="nt-draft-confirm-yes" class="btn btn-ghost">{t("task_draft.confirm", locale)}</button>
      </div>
    </div>

    <!-- Pinned footer — outside scrollable form -->
    <div
      class="modal-actions nt-footer"
    >
      <button type="button" class="btn btn-ghost text-text-muted hover:text-text-primary text-sm font-semibold px-1 rounded-lg" id="cancel-new-task">{t("task_modal.btn_cancel", locale)}</button>

      <div class="nt-footer-actions">
        <button type="button" id="nt-draft-toggle" class="btn btn-ghost text-sm"
          aria-controls="nt-draft-panel" aria-expanded="false" hidden>{t("task_draft.draft", locale)}</button>
        <button
          type="submit"
          form="new-task-form"
          class="btn btn-primary"
          id="submit-new-task-btn"
          data-label-task={t("task_modal.btn_create_task", locale)}
          data-label-shopping={t("task_modal.btn_create_shopping_list", locale)}
          data-label-checklist={t("task_modal.btn_create_checklist", locale)}
          data-label-event={t("task_modal.btn_create_event", locale)}
          data-label-creating={t("task_modal.btn_creating", locale)}
        >{t("task_modal.btn_create_task", locale)}</button>
      </div>
    </div>
  </div>
</div>
<script>
  import { showToast } from "@lib/toast";
  import { renderIconSvg, type IconName } from "../../generated/icon-registry";
  import { InlineDatePicker } from "../shared/InlineDatePicker"
  import { checklistLines, createChecklistItem } from "@lib/checklist-items"
  import { createClientLogger } from "@lib/client-logger";
  import { pageLifecycle } from "@lib/page-lifecycle";
  import { createFocusTrap } from "@lib/focus-trap"
  import { privateIngressScope } from "@lib/network-only-worker"
  import { taskDraftText } from "@lib/task-draft-copy"
  import type { connectTaskDrafts } from "@lib/task-draft-controller"
  import { getLegacyTaskId } from "@lib/task-detail-handoff"
  import type { TaskDraftSnapshot, TaskDraftPublication } from "@lib/task-draft-state"

  const log = createClientLogger("tasks", "new-task-modal");

  // Handle smart task extraction mapping
  const nextWeekday = (day: number) => {
    const d = new Date();
    const diff = (day - d.getDay() + 7) % 7 || 7;
    d.setDate(d.getDate() + diff);
    return d;
  };

  pageLifecycle.onPageLoad((signal) => {
    const overlay = document.getElementById("new-task-overlay");
    if (!overlay || overlay.dataset.newTaskController === "ready") return
    overlay.dataset.newTaskController = "ready"
    const focusTrap = createFocusTrap(overlay)
    signal.addEventListener("abort", () => {
      focusTrap.deactivate(false)
      delete overlay.dataset.newTaskController
    }, { once: true })

    const closeBtn = document.getElementById("close-new-task-modal");
    const cancelBtn = document.getElementById("cancel-new-task");
    const form = document.getElementById("new-task-form") as HTMLFormElement | null;

    // ── Cached DOM refs (avoid per-click lookups) ──
    const contextualDiv = document.getElementById("nt-contextual-fields");
    const checklistDiv = document.getElementById("nt-contextual-checklist");
    const shoppingDiv = document.getElementById("nt-contextual-shopping");
    const eventDiv = document.getElementById("nt-contextual-event");
    const dueRow = document.getElementById("nt-ctx-due-row");
    const titleInput = document.getElementById("new-task-title-input") as HTMLTextAreaElement | null;
    const descInput = document.getElementById("new-task-desc-input") as HTMLTextAreaElement | null;
    const submitBtn = document.getElementById("submit-new-task-btn") as HTMLButtonElement | null;
    const pillsContainer = document.getElementById("nt-status-pills")
    const statusInput = document.querySelector<HTMLInputElement>("#new-task-status")
    const goalSelect = document.querySelector<HTMLSelectElement>("#new-task-goal")
    let captureOptionsRequest: AbortController | undefined
    let lanesLoaded = false
    let goalsLoaded = false
    let submitting = false
    let captureSession = 0
    let preserveAssignee = false
    let isHydrating = false
    let draftPublicationNeedsRefresh = false
    let drafts: ReturnType<typeof connectTaskDrafts> | undefined
    let draftLoading = false
    let editedWhileLoading = false
    let retainedRoutine = false
    let retainedEventDetails = { location: "", allDay: false, calendar: "" }

    function resizeTitle() {
      if (!titleInput) return
      titleInput.style.height = "auto"
      titleInput.style.height = `${Math.min(titleInput.scrollHeight + 2, 120)}px`
    }
    titleInput?.addEventListener("input", resizeTitle, { signal })

    pillsContainer?.addEventListener("click", event => {
      const pill = (event.target as Element).closest<HTMLElement>("[data-status]")
      if (pill?.dataset.status && !pill.hasAttribute("disabled")) { selectStatus(pill.dataset.status); markEdited() }
    }, { signal })

    function selectStatus(status: string) {
      if (!statusInput) return
      statusInput.value = status
      pillsContainer?.querySelector("[data-unavailable]")?.remove()
      if (pillsContainer && ![...pillsContainer.querySelectorAll<HTMLElement>("[data-status]")].some(pill => pill.dataset.status === status)) {
        const missing = document.createElement("button")
        missing.type = "button"
        missing.disabled = true
        missing.dataset.status = status
        missing.dataset.unavailable = ""
        missing.setAttribute("role", "radio")
        missing.textContent = taskDraftText("lane_missing")
        pillsContainer.append(missing)
      }
      pillsContainer?.querySelectorAll<HTMLElement>("[data-status]").forEach(pill => {
        const selected = pill.dataset.status === status
        pill.classList.toggle("active", selected)
        pill.setAttribute("aria-checked", String(selected))
      })
    }

    // Task Kind Tab Switching
    const kindTabs = document.querySelectorAll("#nt-kind-tabs button");
    const kindInput = document.getElementById("new-task-kind") as HTMLInputElement | null;

    function createButtonLabel(kind = kindInput?.value) {
      const labels = submitBtn?.dataset
      if (kind === "shopping_item") return labels?.labelShopping || "Create Shopping List"
      if (kind === "checklist") return labels?.labelChecklist || "Create Checklist"
      if (kind === "calendar_event") return labels?.labelEvent || "Create Event"
      return labels?.labelTask || "Create Task"
    }

    function selectKind(kind: string) {
      if (kindInput) kindInput.value = kind
      kindTabs.forEach(tab => {
        const selected = (tab as HTMLElement).dataset.kind === kind
        tab.classList.toggle("active", selected)
        tab.setAttribute("aria-pressed", String(selected))
      })
      const shopping = kind === "shopping_item"
      const checklist = kind === "checklist"
      const event = kind === "calendar_event"
      contextualDiv?.classList.toggle("hidden", !shopping && !checklist && !event)
      checklistDiv?.classList.toggle("hidden", !checklist)
      shoppingDiv?.classList.toggle("hidden", !shopping)
      eventDiv?.classList.toggle("hidden", !event)
      dueRow?.classList.toggle("hidden", event)
      if (titleInput) {
        const labels = titleInput.dataset
        titleInput.placeholder = (shopping ? labels.placeholderShopping : checklist ? labels.placeholderChecklist
          : event ? labels.placeholderEvent : labels.placeholderTask) || "Task name"
      }
    }

    kindTabs.forEach(tab => tab.addEventListener("click", () => {
      selectKind((tab as HTMLElement).dataset.kind || "standard_action")
      markEdited()
      renderCaptureSubmit()
      titleInput?.focus()
    }, { signal }))

    const builderInput = document.querySelector<HTMLTextAreaElement>("#nt-checklist-builder-input")
    const itemsContainer = document.getElementById("nt-checklist-items-container")
    type CaptureChecklistItem = TaskDraftSnapshot["checklist"]["items"][number]
    const checklistItems = new Map<HTMLElement, CaptureChecklistItem>()
    let draft: { value: string; items: ReturnType<typeof createChecklistItem>[] } | undefined

    function currentChecklistDraft() {
      const value = builderInput?.value ?? ""
      if (!draft || value !== draft.value) {
        draft = { value, items: checklistLines(value).map(createChecklistItem) }
      }
      return draft.items
    }

    function updateChecklistCount() {
      const count = document.getElementById("nt-checklist-count")
      if (count) count.textContent = (count.dataset.countLabel || "{count} items").replace("{count}", String(checklistItems.size))
    }

    function appendChecklistItem(item: CaptureChecklistItem) {
      const row = document.createElement("li")
      row.className = "ticket-item-row"
      const label = document.createElement("span")
      label.className = "flex-1 min-w-0 break-words"
      label.textContent = item.text
      const remove = document.createElement("button")
      remove.type = "button"
      remove.className = "btn btn-ghost inline-flex items-center justify-center"
      remove.innerHTML = renderIconSvg("x", { size: 14 })
      remove.setAttribute("aria-label", `Remove ${item.text}`)
      remove.addEventListener("click", () => {
        checklistItems.delete(row)
        row.remove()
        updateChecklistCount()
        markEdited()
        builderInput?.focus()
      }, { signal })
      row.append(label, remove)
      checklistItems.set(row, item)
      itemsContainer?.append(row)
      updateChecklistCount()
    }

    function stageChecklistItems() {
      if (!builderInput || !itemsContainer) return
      const staged = currentChecklistDraft()
      if (staged.length === 0) return
      staged.forEach(appendChecklistItem)
      builderInput.value = ""
      draft = undefined
      markEdited()
      builderInput.focus()
    }

    document.getElementById("nt-add-sub-item-btn")?.addEventListener("click", stageChecklistItems, { signal })
    builderInput?.addEventListener("keydown", event => {
      if (event.key !== "Enter" || event.shiftKey || event.ctrlKey || event.metaKey || event.altKey || event.isComposing) return
      event.preventDefault()
      stageChecklistItems()
    }, { signal })

    const qtyEl = document.getElementById("nt-shopping-qty") as HTMLInputElement;

    const shoppingItemInput = document.querySelector<HTMLInputElement>("#nt-shopping-item-input")
    const shoppingItemsList = document.getElementById("nt-shopping-items-list")
    const shoppingCategory = document.querySelector<HTMLSelectElement>("#nt-shopping-category")
    type ShoppingItem = TaskDraftSnapshot["shopping"]["items"][number]
    const shoppingListItems: ShoppingItem[] = []

    function shoppingQuantity(): number | null {
      const raw = qtyEl?.value ?? "1"
      const qty = Number(raw)
      return raw && Number.isInteger(qty) && qty >= 1 && qty <= 999 ? qty : null
    }

    function appendShoppingItem(item: ShoppingItem) {
      const { name, qty, category } = item
      shoppingListItems.push(item)
      const pill = document.createElement("li")
      pill.className = "ticket-item-row"
      const label = document.createElement("span")
      label.className = "flex-1 min-w-0 break-words"
      const categoryLabel = Array.from(shoppingCategory?.options ?? []).find(option => option.value === category)?.textContent
      const suffix = category ? ` · ${categoryLabel || category}` : ""
      label.textContent = qty > 1 ? `${qty}× ${name}${suffix}` : `${name}${suffix}`

      const remove = document.createElement("button")
      remove.type = "button"
      remove.className = "btn btn-ghost text-text-muted inline-flex items-center justify-center"
      remove.innerHTML = renderIconSvg("x", { size: 14 })
      remove.setAttribute("aria-label", `Remove ${name}${suffix}`)
      remove.addEventListener("click", () => {
        shoppingListItems.splice(shoppingListItems.indexOf(item), 1)
        pill.remove()
        markEdited()
        shoppingItemInput?.focus()
      }, { signal })
      pill.append(label, remove)
      shoppingItemsList?.append(pill)
    }

    function addShoppingItem() {
      const name = shoppingItemInput?.value.trim()
      if (!shoppingItemInput || !name) return
      const qty = shoppingQuantity()
      if (qty === null) { qtyEl?.reportValidity(); return }
      appendShoppingItem({ name, qty, category: (shoppingCategory?.value ?? "") as ShoppingItem["category"] })
      shoppingItemInput.value = ""
      markEdited()
      shoppingItemInput.focus()
    }

    document.getElementById("nt-add-shopping-item")?.addEventListener("click", addShoppingItem, { signal })
    shoppingItemInput?.addEventListener("keydown", event => {
      if (event.key !== "Enter" || event.shiftKey || event.ctrlKey || event.metaKey || event.altKey || event.isComposing) return
      event.preventDefault()
      addShoppingItem()
    }, { signal })

    // Custom Fields toggle
    const cfToggle = document.getElementById("nt-custom-fields-toggle");
    const cfContainer = document.getElementById("nt-custom-fields-container");
    cfToggle?.addEventListener("click", () => {
      cfContainer?.classList.toggle("hidden");
      cfToggle?.setAttribute("aria-expanded", String(!cfContainer?.classList.contains("hidden")))
    }, { signal });

    // Add custom field btn → show dropdown
    const cfAddBtn = document.getElementById("nt-add-custom-field-btn");
    const cfDropdown = document.getElementById("nt-add-field-dropdown");
    cfAddBtn?.addEventListener("click", event => {
      event.stopPropagation()
      if (!cfDropdown) return
      const wasClosed = cfDropdown.classList.contains("hidden") || cfContainer?.classList.contains("hidden")
      cfContainer?.classList.remove("hidden")
      cfDropdown.classList.toggle("hidden", !wasClosed)
      cfDropdown.style.display = wasClosed ? "flex" : ""
      cfToggle?.setAttribute("aria-expanded", "true")
      cfAddBtn?.setAttribute("aria-expanded", String(wasClosed))
    }, { signal })

    // Add field type buttons
    function createCustomFieldEntry(type: string): HTMLDivElement {
      const entry = document.createElement("div")
      entry.className = "nt-custom-field-entry flex items-center gap-2"
      entry.dataset.fieldType = type

      const fieldLabel = form?.querySelector<HTMLElement>(`[data-field-type="${type}"].nt-add-field-type`)?.textContent?.trim() || type
      const iconMap: Record<string, IconName> = { url: "link", number: "hash", date: "calendar", attachment: "paperclip", text: "file-text" }

      if (type === "checkbox") {
        const cb = document.createElement("input")
        cb.type = "checkbox"
        cb.setAttribute("aria-label", fieldLabel)
        cb.className = "rounded border-border-dim bg-bg-input/50 focus:ring-accent"
        entry.appendChild(cb)
      } else {
        const icon = document.createElement("span")
        icon.className = "text-xs text-text-muted inline-flex items-center"
        icon.innerHTML = renderIconSvg(iconMap[type] ?? "file-text", { size: 14 })
        entry.appendChild(icon)
      }

      const input = document.createElement("input")
      const inputTypeMap: Record<string, string> = { url: "url", number: "number", date: "date", attachment: "file", checkbox: "text" }
      const placeholderMap: Record<string, string> = { url: "https://", number: "0", text: "Enter text...", checkbox: "Label" }
      input.type = inputTypeMap[type] || "text"
      input.setAttribute("aria-label", fieldLabel)
      input.className = "form-input flex-1 bg-bg-input/50 border-border-dim rounded-lg text-sm px-3 py-1"
      if (placeholderMap[type]) input.placeholder = placeholderMap[type]
      entry.appendChild(input)

      const removeBtn = document.createElement("button")
      removeBtn.type = "button"
      removeBtn.className = "text-text-muted hover:text-red-400 text-xs inline-flex items-center justify-center"
      removeBtn.innerHTML = renderIconSvg("x", { size: 14 })
      removeBtn.addEventListener("click", () => { entry.remove(); markEdited() }, { signal })
      removeBtn.setAttribute("aria-label", `Remove ${type} field`)
      entry.appendChild(removeBtn)

      return entry
    }

    document.querySelectorAll(".nt-add-field-type").forEach(btn => {
      btn.addEventListener("click", () => {
        const type = (btn as HTMLElement).dataset.fieldType || "text";
        const cfList = document.getElementById("nt-custom-fields-list");
        if (!cfList) return;
        cfList.appendChild(createCustomFieldEntry(type));
        markEdited()
        cfDropdown?.classList.add("hidden")
        if (cfDropdown) cfDropdown.style.display = ""
        cfContainer?.classList.remove("hidden")
        cfToggle?.setAttribute("aria-expanded", "true")
        cfAddBtn?.setAttribute("aria-expanded", "false")
      }, { signal });
    });
    function closeNewTaskModal() {
      if (!overlay?.classList.contains("active") || overlay.classList.contains("closing")) return
      captureOptionsRequest?.abort()
      captureSession++
      drafts?.close()
      draftLoading = false
      const reducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches
      let finished = false
      const finishClose = () => {
        if (finished || signal.aborted) return
        finished = true
        overlay.classList.remove("active", "closing")
        focusTrap.deactivate()
        clearCapture()
        if (draftPublicationNeedsRefresh) {
          draftPublicationNeedsRefresh = false
          document.dispatchEvent(new CustomEvent("meitheal:tasks-changed", { detail: { action: "created" } }))
        }
      }
      if (reducedMotion) { finishClose(); return; }
      overlay.classList.add("closing");
      const content = overlay.querySelector(".modal-content");
      if (content) {
        const onEnd = () => { content.removeEventListener("animationend", onEnd); finishClose(); };
        content.addEventListener("animationend", onEnd, { once: true, signal });
        window.setTimeout(() => { content.removeEventListener("animationend", onEnd); finishClose(); }, 300);
      } else {
        finishClose();
      }
    }

    if (closeBtn) closeBtn.addEventListener("click", closeNewTaskModal, { signal });
    if (cancelBtn) cancelBtn.addEventListener("click", closeNewTaskModal, { signal });
    if (overlay) overlay.addEventListener("click", (e) => {
      if (e.target === overlay) closeNewTaskModal();
    }, { signal });

    document.addEventListener("keydown", (e) => {
      if (overlay?.classList.contains("active") && !e.defaultPrevented && !e.isComposing) {
        if (e.key === "Escape") {
          e.preventDefault();
          if (!drafts?.dismissConfirmation()) closeNewTaskModal();
        } else if (e.key === "Enter" && (e.metaKey || e.ctrlKey)) {
          e.preventDefault();
          if (canSubmitCapture() && !submitting) form?.requestSubmit(submitBtn ?? undefined);
        }
      }
    }, { signal });

    // Expose global open method
    window.openNewTaskModal = () => {
      if (signal.aborted || overlay.classList.contains("active")) return
      // If the detail panel is open, close it to avoid dual modal
      document.getElementById("task-detail-panel")?.classList.remove("open");
      document.getElementById("task-detail-overlay")?.classList.remove("active");
      document.body.classList.remove("has-docked-inspector");

      clearCapture()
      const contextualDate = window.__prefillTaskDate
      delete window.__prefillTaskDate
      if (contextualDate) restoreDue(contextualDate)
      preserveAssignee = false
      captureSession++
      overlay.classList.add("active")

      captureOptionsRequest = new AbortController()
      const requestSignal = AbortSignal.any([signal, captureOptionsRequest.signal, AbortSignal.timeout(10_000)])
      void loadAssigneeDropdown(requestSignal)
      if (!lanesLoaded) void loadStatusPills(requestSignal)
      if (!goalsLoaded) void loadGoals(requestSignal)
      void loadDraftEditor(captureSession)
      focusTrap.activate()
    };

    // Fetch users and populate the Assign To dropdown
    async function loadAssigneeDropdown(requestSignal: AbortSignal) {
      const select = document.querySelector<HTMLSelectElement>("#new-task-assigned-to")
      const hint = document.getElementById("new-task-assignee-hint")
      if (!select) return

      try {
        const res = await fetch("/api/users", { signal: requestSignal })
        if (!res.ok) return
        const data = await res.json()
        if (requestSignal.aborted) return
        const users = data.users || []
        const selected = select.value
        const unassigned = select.options[0] ?? new Option("Unassigned", "")
        select.replaceChildren(unassigned, ...users.map((user: { id: string; name: string; source: string }) =>
          new Option(user.name + (user.source === "home_assistant" ? " (HA)" : ""), user.id)))
        // Only the assignee field can hide; goals stay independently available.
        if (select.parentElement) select.parentElement.style.display = users.length || selected ? "" : "none"
        hint?.classList.toggle("hidden", users.length < 2)
        const fallback = data.default_assignee || (users.length === 1 ? users[0].id : "")
        if (preserveAssignee) selectSavedOption(select, selected, taskDraftText("assignee_missing"))
        else select.value = fallback

        // Used only by the existing @mention parser.
        ;(window as any).__meitheal_users = users
      } catch {
        // Standalone/offline — keep the current options.
      }
    }

    // Swimlanes Loader → Status Pills
    async function loadStatusPills(requestSignal: AbortSignal) {
      if (!pillsContainer || !statusInput) return

      try {
        const [lanesRes, modeRes] = await Promise.all([
          fetch("/api/lanes", { signal: requestSignal }),
          fetch("/api/settings?key=backlog_mode", { signal: requestSignal }),
        ])
        if (!lanesRes.ok) return
        const { lanes } = await lanesRes.json()
        const mode = modeRes.ok ? await modeRes.json().catch(() => null) : null
        if (requestSignal.aborted || !Array.isArray(lanes)) return

        const hideBacklog = mode?.value === "disabled" || mode?.value === "hidden"
        const selected = statusInput.value
        const focused = document.activeElement
        const focusedStatus = focused instanceof HTMLElement && pillsContainer.contains(focused) ? focused.dataset.status : undefined
        const options = document.createDocumentFragment()
        let nextFocus: HTMLButtonElement | undefined
        for (const lane of lanes) {
          if (hideBacklog && lane.key === "backlog") continue
          const pill = document.createElement("button")
          pill.type = "button"
          pill.className = "filter-toolbar__type-btn"
          pill.dataset.status = lane.key
          pill.setAttribute("role", "radio")
          const icon = document.createElement("span")
          icon.className = "nt-status-pill-icon"
          icon.textContent = lane.icon
          const label = document.createElement("span")
          label.textContent = lane.label
          pill.append(icon, label)
          options.appendChild(pill)
          if (lane.key === focusedStatus) nextFocus = pill
        }
        if (!options.childElementCount) return
        pillsContainer.replaceChildren(options)
        selectStatus(selected)
        nextFocus?.focus({ preventScroll: true })
        lanesLoaded = mode !== null
      } catch {
        // Keep the current options and retry on the next open.
      }
    }

    const dueInput = document.querySelector<HTMLInputElement>("#nt-contextual-due")
    const dueMount = document.querySelector<HTMLElement>("#nt-due-date-picker")
    const dueLabel = document.getElementById("nt-due-label")?.textContent ?? "Due date"
    let duePicker: InlineDatePicker | undefined
    const dateOnly = /^\d{4}-\d{2}-\d{2}$/

    function displayedDate(raw: string): Date | null {
      const date = raw ? new Date(dateOnly.test(raw) ? `${raw}T00:00:00` : raw) : null
      return date && Number.isFinite(date.valueOf()) ? date : null
    }

    function syncDueControls(focus = false) {
      const trigger = dueMount?.querySelector<HTMLElement>(".idp-trigger")
      if (!trigger) return
      const clear = trigger.querySelector<HTMLButtonElement>(".idp-clear-btn")
      if (clear) dueMount?.append(clear)
      dueMount?.querySelectorAll<HTMLButtonElement>("button").forEach(button => { button.type = "button" })
      if (!(trigger instanceof HTMLButtonElement)) {
        trigger.tabIndex = 0
        trigger.setAttribute("role", "button")
      }
      trigger.setAttribute("aria-label", dueInput?.value ? `${dueLabel}: ${dueInput.value}` : dueLabel)
      trigger.setAttribute("aria-haspopup", "dialog")
      if (focus) trigger.focus({ preventScroll: true })
    }

    function restoreDue(raw: string) {
      if (dueInput) dueInput.value = raw
      duePicker?.setValue(displayedDate(raw))
      syncDueControls()
    }

    if (dueMount && dueInput) {
      duePicker = new InlineDatePicker(dueMount, {
        value: null,
        formatFn: date => dateOnly.test(dueInput.value) ? date.toLocaleDateString() : date.toLocaleString(),
        onChange(date) {
          dueInput.value = date.toISOString()
          markEdited()
          queueMicrotask(() => syncDueControls(true))
        },
        onClear() {
          dueInput.value = ""
          markEdited()
          queueMicrotask(() => syncDueControls(true))
        },
        signal,
      })
      syncDueControls()
      // The shared picker portals to body. Keep this instance inside the modal's focus scope.
      dueMount.addEventListener("click", () => {
        const prior = new Set(document.querySelectorAll(".idp-panel"))
        requestAnimationFrame(() => {
          const panel = [...document.querySelectorAll<HTMLElement>(".idp-panel")].find(item => !prior.has(item))
          if (!panel || signal.aborted) return
          panel.classList.add("nt-due-date-panel")
          panel.setAttribute("role", "dialog")
          panel.setAttribute("aria-label", dueLabel)
          overlay.append(panel)
          const bounds = panel.getBoundingClientRect()
          panel.style.left = `${Math.max(8, Math.min(bounds.left, innerWidth - bounds.width - 8))}px`
          panel.style.top = `${Math.max(8, Math.min(bounds.top, innerHeight - bounds.height - 8))}px`
          panel.style.bottom = ""
          panel.addEventListener("keydown", event => {
            if (event.key !== "Escape") return
            event.preventDefault()
            event.stopPropagation()
            duePicker?.setValue(displayedDate(dueInput.value))
            syncDueControls(true)
          }, { signal })
          panel.querySelector<HTMLButtonElement>("button")?.focus({ preventScroll: true })
        })
      }, { capture: true, signal })
      dueMount.addEventListener("keydown", event => {
        const target = event.target as HTMLElement
        if (target.matches(".idp-trigger:not(button)") && ["Enter", " "].includes(event.key)) {
          event.preventDefault()
          target.click()
        }
      }, { signal })
      signal.addEventListener("abort", () => duePicker?.destroy(), { once: true })
    }

    // Preserve saved ISO offsets and precision while native event controls show local wall time.
    const eventDates = new Map<string, { raw: string; display: string }>()
    function restoreEventDate(id: string, raw: string) {
      const control = document.getElementById(id) as HTMLInputElement | null
      if (!control) return
      const date = displayedDate(raw)
      control.value = date ? new Date(date.valueOf() - date.getTimezoneOffset() * 60_000).toISOString().slice(0, -1) : ""
      eventDates.set(id, { raw, display: control.value })
    }
    function eventDateValue(id: string): string {
      const control = document.getElementById(id) as HTMLInputElement | null
      const saved = eventDates.get(id)
      if (saved && control?.value === saved.display) return saved.raw
      return control?.value ? new Date(control.value).toISOString() : ""
    }
    function publicationDate(raw: string): string {
      return dateOnly.test(raw) ? new Date(raw).toISOString() : raw
    }

    // Goals Loader
    async function loadGoals(requestSignal: AbortSignal) {
      if (!goalSelect) return
      try {
        const res = await fetch("/api/goals", { signal: requestSignal })
        if (!res.ok) return
        const data = await res.json()
        const goals = data?.goals ?? data
        if (requestSignal.aborted || !Array.isArray(goals)) return

        const selected = goalSelect.value
        const noGoal = goalSelect.options[0]
        if (!noGoal) return
        goalSelect.replaceChildren(noGoal, ...goals.map(goal => {
          const option = document.createElement("option")
          option.value = goal.id
          option.textContent = `🎯 ${goal.title || goal.name}`
          return option
        }))
        selectSavedOption(goalSelect, selected, taskDraftText("goal_missing"))
        goalsLoaded = true
      } catch (error) {
        if (!requestSignal.aborted) log.warn("goals-fetch error", error)
      }
    }

    type CaptureField = TaskDraftSnapshot["fields"][number]
    type CaptureControl = HTMLInputElement | HTMLSelectElement | HTMLTextAreaElement

    const input = (id: string) => overlay.querySelector<CaptureControl>("#" + id)
    const value = (id: string) => input(id)?.value ?? ""
    const checked = (id: string) => Boolean((input(id) as HTMLInputElement | null)?.checked)
    const labelPicker = overlay.querySelector<HTMLElement>("#new-task-label-picker")
    const labelValue = input("new-task-label-picker-value")
    const customList = overlay.querySelector<HTMLElement>("#nt-custom-fields-list")
    const assignee = overlay.querySelector<HTMLSelectElement>("#new-task-assigned-to")
    const fieldError = overlay.querySelector<HTMLElement>("#nt-capture-validation")

    function showFieldError(message = "") {
      if (!fieldError) return
      fieldError.textContent = message
      fieldError.hidden = !message
    }

    function selectSavedOption(select: HTMLSelectElement | null, desired: string, unavailableLabel: string) {
      if (!select) return
      select.querySelector("[data-unavailable]")?.remove()
      if (desired && !Array.from(select.options).some(option => option.value === desired)) {
        const unavailable = new Option(unavailableLabel, desired)
        unavailable.dataset.unavailable = ""
        select.append(unavailable)
        if (select.parentElement) select.parentElement.style.display = ""
      }
      select.value = desired
    }

    function captureFields(): CaptureField[] {
      const fields: CaptureField[] = []
      customList?.querySelectorAll<HTMLElement>(".nt-custom-field-entry").forEach(entry => {
        const type = entry.dataset.fieldType
        const field = entry.querySelector<HTMLInputElement>("input:not([type=checkbox])")
        if (!field) return
        if (type === "checkbox") fields.push({ type, label: field.value, checked: Boolean(entry.querySelector<HTMLInputElement>("input[type=checkbox]")?.checked) })
        else if (type === "url" || type === "text" || type === "number" || type === "date") fields.push({ type, value: field.value })
      })
      return fields
    }

    function captureSnapshot(): TaskDraftSnapshot {
      return {
        version: 1,
        title: titleInput?.value ?? "",
        description: descInput?.value ?? "",
        taskKind: (kindInput?.value || "standard_action") as TaskDraftSnapshot["taskKind"],
        status: statusInput?.value || "pending",
        priority: Number(value("new-task-priority")),
        due: value("nt-contextual-due"),
        labels: JSON.parse(labelValue?.value || "[]"),
        newLabels: JSON.parse(labelValue?.dataset.newLabels || "[]"),
        assignedTo: assignee?.value ?? "",
        goal: goalSelect?.value ?? "",
        recurrence: value("new-task-recurrence"),
        isRoutine: retainedRoutine,
        checklist: { items: [...checklistItems.values()], input: builderInput?.value ?? "" },
        shopping: { items: [...shoppingListItems], input: shoppingItemInput?.value ?? "", quantity: qtyEl?.value ?? "1",
          category: (shoppingCategory?.value ?? "") as ShoppingItem["category"] },
        event: { start: eventDateValue("nt-event-start"), end: eventDateValue("nt-event-end"), ...retainedEventDetails },
        fields: captureFields(),
      }
    }

    function restoreCapture(snapshot: TaskDraftSnapshot) {
      isHydrating = true
      try {
        form?.reset()
        selectKind(snapshot.taskKind)
        selectStatus(snapshot.status)
        if (titleInput) {
          titleInput.value = snapshot.title
          resizeTitle()
        }
        if (descInput) {
          descInput.value = snapshot.description
        }

        const priority = input("new-task-priority")
        const recurrence = overlay?.querySelector<HTMLSelectElement>("#new-task-recurrence")
        if (priority) priority.value = String(snapshot.priority)
        recurrence?.querySelector("[data-saved-recurrence]")?.remove()
        if (recurrence) {
          if (snapshot.recurrence && ![...recurrence.options].some(option => option.value === snapshot.recurrence)) {
            const saved = new Option(snapshot.recurrence, snapshot.recurrence)
            saved.dataset.savedRecurrence = ""
            recurrence.append(saved)
          }
          recurrence.value = snapshot.recurrence
        }
        selectSavedOption(assignee, snapshot.assignedTo, taskDraftText("assignee_missing"))
        selectSavedOption(goalSelect, snapshot.goal, taskDraftText("goal_missing"))
        preserveAssignee = true
        labelPicker?.dispatchEvent(new CustomEvent("meitheal:set-draft-labels", {
          detail: { labels: snapshot.labels, newLabels: snapshot.newLabels },
        }))

        restoreDue(snapshot.due)
        restoreEventDate("nt-event-start", snapshot.event.start)
        restoreEventDate("nt-event-end", snapshot.event.end)
        // Preserve older private draft metadata without advertising unsupported creation controls.
        retainedRoutine = snapshot.isRoutine
        retainedEventDetails = { location: snapshot.event.location, allDay: snapshot.event.allDay, calendar: snapshot.event.calendar }
        const location = input("nt-event-location")
        if (location) location.value = snapshot.event.location
        const calendar = input("nt-event-calendar")
        if (calendar) calendar.value = snapshot.event.calendar
        const allDay = input("nt-event-all-day") as HTMLInputElement | null
        if (allDay) allDay.checked = snapshot.event.allDay

        checklistItems.clear()
        itemsContainer?.replaceChildren()
        draft = undefined
        snapshot.checklist.items.forEach(appendChecklistItem)
        updateChecklistCount()
        if (builderInput) builderInput.value = snapshot.checklist.input
        shoppingListItems.length = 0
        shoppingItemsList?.replaceChildren()
        snapshot.shopping.items.forEach(appendShoppingItem)
        if (shoppingItemInput) shoppingItemInput.value = snapshot.shopping.input
        if (qtyEl) qtyEl.value = snapshot.shopping.quantity
        if (shoppingCategory) shoppingCategory.value = snapshot.shopping.category

        customList?.replaceChildren()
        cfContainer?.classList.toggle("hidden", snapshot.fields.length === 0)
        cfToggle?.setAttribute("aria-expanded", String(snapshot.fields.length > 0))
        cfAddBtn?.setAttribute("aria-expanded", "false")
        const options = overlay?.querySelector<HTMLDetailsElement>("#nt-options")
        if (options) options.open = !!(snapshot.goal || snapshot.recurrence || snapshot.labels.length || snapshot.newLabels.length || snapshot.fields.length)
        cfDropdown?.classList.add("hidden")
        if (cfDropdown) cfDropdown.style.display = ""
        for (const field of snapshot.fields) {
          const entry = createCustomFieldEntry(field.type)
          const control = entry.querySelector<HTMLInputElement>("input:not([type=checkbox])")
          if (control) control.value = field.type === "checkbox" ? field.label : field.value
          const checkbox = entry.querySelector<HTMLInputElement>("input[type=checkbox]")
          if (checkbox && field.type === "checkbox") checkbox.checked = field.checked
          customList?.append(entry)
        }
        showFieldError()
      } finally {
        isHydrating = false
      }
    }

    function clearCapture() {
      restoreCapture({
        version: 1, title: "", description: "", taskKind: "standard_action", status: "pending", priority: 3,
        due: "", labels: [], newLabels: [], assignedTo: "", goal: "", recurrence: "", isRoutine: false,
        checklist: { items: [], input: "" }, shopping: { items: [], input: "", quantity: "1", category: "" },
        event: { start: "", end: "", location: "", allDay: false, calendar: "" }, fields: [],
      })
    }

    function hasSelectedFiles() {
      return [...(form?.querySelectorAll<HTMLInputElement>("input[type=file]") ?? [])].some(file => file.files?.length)
    }

    function showSubmit(bound: boolean, disabled: boolean) {
      if (!submitBtn) return
      submitBtn.disabled = disabled
      submitBtn.formNoValidate = bound
      submitBtn.textContent = bound ? taskDraftText("publish") : submitting ? submitBtn.dataset.labelCreating || "Creating…" : createButtonLabel()
    }

    function canSubmitCapture() {
      return !draftLoading && (!drafts || drafts.canSubmit())
    }

    function renderCaptureSubmit() {
      if (drafts) drafts.render()
      else showSubmit(false, draftLoading || submitting)
    }

    const draftEditor = {
      snapshot: captureSnapshot,
      restore: restoreCapture,
      clear: clearCapture,
      selectedFiles: hasSelectedFiles,
      ordinarySubmitting: () => submitting,
      focusTitle: () => titleInput?.focus(),
      stateChanged(bound, disabled, withdrawn) {
        if (form) form.inert = withdrawn
        const kindBar = overlay.querySelector<HTMLElement>("#nt-kind-tabs")
        if (kindBar) kindBar.inert = withdrawn
        showSubmit(bound, disabled)
      },
      taskPublished() {
        draftPublicationNeedsRefresh = true
      },
      openTask(receipt) {
        const nextLocation = new URL(window.location.href)
        nextLocation.searchParams.set("open", receipt.taskId)
        nextLocation.searchParams.delete("comment")
        if (getLegacyTaskId(nextLocation.hash) !== null) nextLocation.hash = ""
        history.replaceState(history.state, "", nextLocation)
        draftPublicationNeedsRefresh = true
        closeNewTaskModal()
      },
    } satisfies Parameters<typeof connectTaskDrafts>[1]

    async function loadDraftEditor(session: number) {
      editedWhileLoading = false
      if (!privateIngressScope()) { renderCaptureSubmit(); return }
      if (drafts) { drafts.open(); return }

      draftLoading = true
      let blocked = false
      renderCaptureSubmit()
      try {
        const { connectTaskDrafts } = await import("@lib/task-draft-controller")
        if (!overlay || signal.aborted || session !== captureSession) return
        drafts = connectTaskDrafts(overlay, draftEditor, signal)
        drafts.open()
        if (editedWhileLoading) drafts.edited()
      } catch {
        // An older offline shell may not have this optional editor chunk yet.
        try {
          blocked = Boolean(sessionStorage.getItem("meitheal-draft-operation"))
        } catch { /* Ordinary capture works without session storage. */ }
      } finally {
        if (session === captureSession && !signal.aborted) {
          draftLoading = blocked
          if (blocked) showFieldError(taskDraftText("reconnect"))
          renderCaptureSubmit()
        }
      }
    }

    function markEdited() {
      if (!isHydrating) {
        showFieldError()
        const dateError = document.getElementById("nt-date-error")
        if (dateError) dateError.hidden = true
        if (drafts) drafts.edited()
        else editedWhileLoading = true
      }
    }

    form?.addEventListener("input", event => {
      if (event.target === assignee) preserveAssignee = true
      if (!(event.target as HTMLElement).matches(".label-picker__input")) markEdited()
    }, { signal })
    form?.addEventListener("change", event => {
      const target = event.target as HTMLElement
      if (target.matches("input[type=hidden]")) markEdited()
    }, { signal })
    form?.addEventListener("invalid", event => {
      if (event.target === qtyEl && kindInput?.value === "shopping_item") showFieldError(taskDraftText("quantity"))
    }, { signal, capture: true })

    // Use event delegation on document.body to catch all create-task-btn clicks
    // without cloning DOM nodes (which breaks other scripts' references).
    document.body.addEventListener("click", (e) => {
      const target = (e.target as HTMLElement).closest("#create-task-btn");
      if (target) {
        e.preventDefault();
        window.openNewTaskModal?.();
      }
    }, { signal });

    // Preserve the form so its child controls keep their lifecycle-bound handlers.
    if (form) {
      form.addEventListener("submit", async (e) => {
        e.preventDefault()
        if (submitting || !canSubmitCapture() || !titleInput) return
        const bound = drafts?.isBound() ?? false
        let title = titleInput.value.trim()
        if (!title) { showFieldError(taskDraftText("title_required")); titleInput.focus(); return }
        if (bound && hasSelectedFiles()) {
          showFieldError(taskDraftText("file_publish"))
          return
        }
        if (bound && (pillsContainer?.querySelector("[data-unavailable].active") ||
            assignee?.selectedOptions[0]?.hasAttribute("data-unavailable") ||
            goalSelect?.selectedOptions[0]?.hasAttribute("data-unavailable"))) {
          showFieldError(taskDraftText("reference_required"))
          return
        }
        const start = eventDateValue("nt-event-start")
        const end = eventDateValue("nt-event-end")
        const invalidDates = kindInput?.value === "calendar_event" && !!start && !!end && new Date(end) <= new Date(start)
        const dateError = document.getElementById("nt-date-error")
        if (dateError) dateError.hidden = !invalidDates
        if (invalidDates) {
          document.getElementById("nt-event-end")?.focus()
          return
        }
        if (kindInput?.value === "shopping_item" && shoppingQuantity() === null) {
          showFieldError(taskDraftText("quantity"))
          qtyEl?.focus()
          return
        }
        const session = captureSession

        try {
          const extractedLabels: string[] = [];
          let extractedDue: string | null = null;

          // Extract #tags
          title = title
            .replace(/#(\w+)/g, (_match, label) => {
              extractedLabels.push(label);
              return "";
            })
            .trim();

          // Extract date semantics
          const dateKeywords: Record<string, () => Date> = {
            today: () => new Date(),
            tomorrow: () => {
              const d = new Date();
              d.setDate(d.getDate() + 1);
              return d;
            },
            "next week": () => {
              const d = new Date();
              d.setDate(d.getDate() + 7);
              return d;
            },
            monday: () => nextWeekday(1),
            tuesday: () => nextWeekday(2),
            wednesday: () => nextWeekday(3),
            thursday: () => nextWeekday(4),
            friday: () => nextWeekday(5),
          };

          for (const [kw, getDate] of Object.entries(dateKeywords)) {
            const regex = new RegExp(`\\b${kw}\\b`, "i");
            if (regex.test(title)) {
              extractedDue = getDate().toISOString().slice(0, 16);
              title = title.replace(regex, "").trim();
              break;
            }
          }

          const labelPickerValue = labelValue
          let manualLabels: string[] = [];
          if (labelPickerValue && labelPickerValue.value) {
            try {
              manualLabels = JSON.parse(labelPickerValue.value);
            } catch {
              // Ignore invalid JSON
            }
          }

          const allLabels = [...new Set([...manualLabels, ...extractedLabels])];
          const newLabels: string[] = JSON.parse(labelValue?.dataset.newLabels || "[]")
          let finalTitle = title || titleInput.value.trim();

          // Extract @mentions for assignment
          const assignedToSelect = document.getElementById("new-task-assigned-to") as HTMLSelectElement | null;
          let assignedTo = assignedToSelect?.value || "";
          
          const users = (window as any).__meitheal_users || [];
          finalTitle = finalTitle
            .replace(/@(\w+)/g, (_match: string, mention: string) => {
              if (!assignedTo) {
                const found = users.find((u: any) =>
                  u.name.toLowerCase().startsWith(mention.toLowerCase()),
                );
                if (found) assignedTo = found.id;
              }
              return "";
            })
            .trim();
            
          if (!finalTitle) finalTitle = titleInput.value.trim();

          const explicitDue = (document.getElementById("nt-contextual-due") as HTMLInputElement)?.value;
          const finalDue = explicitDue ? publicationDate(explicitDue) : extractedDue;

          const kindInputEl = document.getElementById("new-task-kind") as HTMLInputElement | null;
          const descInputEl = document.getElementById("new-task-desc-input") as HTMLTextAreaElement | null;
          const prioritySelectEl = document.getElementById("new-task-priority") as HTMLSelectElement | null;
          const statusSelectEl = document.getElementById("new-task-status") as HTMLInputElement | null;
          const goalSelectEl = document.getElementById("new-task-goal") as HTMLSelectElement | null;
          const recurrenceSelectEl = document.getElementById("new-task-recurrence") as HTMLSelectElement | null;

          const body: Record<string, unknown> = {
            title: finalTitle,
            description: descInputEl?.value.trim() || "",
            task_kind: kindInputEl?.value || "standard_action",
            priority: Number(prioritySelectEl?.value),
            status: statusSelectEl?.value || "pending",
            labels: JSON.stringify(allLabels),
            due_date: finalDue,
            assigned_to: assignedTo || null,
            goal_id: goalSelectEl?.value || null,
          };

          const recurrenceVal = recurrenceSelectEl?.value;
          if (recurrenceVal) body.recurrence_rule = recurrenceVal;

          if (body.task_kind === "checklist") {
            body.checklists = JSON.stringify([...checklistItems.values(), ...currentChecklistDraft()])
          }

          // Shopping list fields
          if (body.task_kind === "shopping_item") {
            const qty = shoppingQuantity() ?? 1
            const cat = shoppingCategory?.value ?? ""
            const items = [...shoppingListItems]
            const queued = shoppingItemInput?.value.trim()
            if (bound && queued) items.push({ name: queued, qty, category: cat as ShoppingItem["category"] })
            body.custom_fields = JSON.stringify({
              quantity: qty,
              category: cat || "",
              items: items.length > 0 ? items : []
            });
            // Also store as checklists for display in detail view
            if (items.length > 0) {
              body.checklists = JSON.stringify(items.map((i: { name: string }) => createChecklistItem(i.name)));
            }
          }

          // Event fields
          if (body.task_kind === "calendar_event") {
            const start = eventDateValue("nt-event-start")
            const end = eventDateValue("nt-event-end")
            if (start) body.start_date = publicationDate(start)
            if (end) body.end_date = publicationDate(end)
          }

          // Custom fields
          const cfItems = document.querySelectorAll("#nt-custom-fields-list .nt-custom-field-entry");
          if (!bound && cfItems.length > 0) {
            const cfData: Record<string, unknown>[] = [];
            cfItems.forEach(item => {
              const type = (item as HTMLElement).dataset.fieldType || "text";
              const input = item.querySelector("input, textarea") as HTMLInputElement;
              if (input?.value) cfData.push({ type, value: input.value });
            });
            if (cfData.length > 0) {
              const existing = body.custom_fields ? JSON.parse(body.custom_fields as string) : {};
              body.custom_fields = JSON.stringify({ ...existing, fields: cfData });
            }
          }

          if (bound) {
            const fields = captureFields().filter(field => field.type === "checkbox" ? field.label || field.checked : field.value)
            const custom = body.custom_fields ? JSON.parse(String(body.custom_fields)) : undefined
            drafts?.publish({
              ...body,
              labels: allLabels,
              newLabels,
              catalogLabels: manualLabels.filter(name => !newLabels.includes(name)),
              ...(body.checklists ? { checklists: JSON.parse(String(body.checklists)) } : {}),
              ...(custom || fields.length ? { custom_fields: { ...custom, ...(fields.length ? { fields } : {}) } } : {}),
            } as TaskDraftPublication)
            return
          }

          if (newLabels.length) body.new_labels = newLabels
          submitting = true
          renderCaptureSubmit()
          const res = await fetch("/api/tasks", {
            method: "POST",
            headers: { "content-type": "application/json" },
            body: JSON.stringify(body),
            signal
          });

          if (session !== captureSession || signal.aborted) return
          if (res.ok) {
            // Parse created task for toast and auto-open
            let created: { id?: string; ticket_key?: string; task_kind?: string } = {};
            try { created = await res.json(); } catch { /* non-JSON response — use empty obj */ }
            if (session !== captureSession || signal.aborted) return

            // Rich toast with clickable ticket key
            const { showTaskCreatedToast } = await import("../../lib/toast");
            showTaskCreatedToast(
              created.ticket_key ?? null,
              created.id ?? "",
              title,
            );

            closeNewTaskModal();
            if (created.id && created.task_kind !== "quick") {
              const nextLocation = new URL(window.location.href)
              nextLocation.searchParams.set("open", created.id)
              nextLocation.searchParams.delete("comment")
              if (getLegacyTaskId(nextLocation.hash) !== null) nextLocation.hash = ""
              history.replaceState(history.state, "", nextLocation)
            }
            document.dispatchEvent(new CustomEvent("meitheal:tasks-changed", {
              detail: { action: "created" }
            }));

          } else {
            const err = await res.text();
            showFieldError(form.dataset.saveFailed || "Could not create this task. Your entries are still here. Try again.")
            showToast(form.dataset.toastError || "Failed to create task", "error");
            log.error("Create task failed:", err);
          }
        } catch (e) {
          if (session !== captureSession || signal.aborted) return
          if (bound) showFieldError(taskDraftText("invalid_values"))
          else {
            log.error("Form submission error", e)
            showFieldError(form.dataset.saveFailed || "Could not create this task. Your entries are still here. Try again.")
            showToast(form.dataset.toastUnexpected || "Unexpected error creating task", "error")
          }
        } finally {
          if (!bound) { submitting = false; renderCaptureSubmit() }
        }
      }, { signal });
    }

    // ── Memory cleanup on signal abort (page navigation) ──
    signal.addEventListener('abort', () => {
      delete (window as any).__meitheal_users;
      delete (window as any).openNewTaskModal;
    });
  });
</script>

