---
import { t } from "../../i18n/translations";
import type { Locale } from "../../lib/locale";
import LabelPicker from "../ui/LabelPicker.astro";

const cookieLocale = Astro.cookies.get("meitheal-locale")?.value;
const locale: Locale = cookieLocale === "ga" ? "ga" : "en";
---

<div
  id="new-task-overlay"
  class="modal-overlay z-200"
  role="dialog"
  aria-modal="true"
  aria-labelledby="new-task-title"
>
  <div class="modal-content max-w-2xl w-full p-6 bg-bg-primary/95 backdrop-blur-xl shadow-2xl border border-border-dim/50 rounded-2xl">
    <div
      class="modal-header flex items-center justify-between mb-4 border-b border-border"
    >
      <div class="flex gap-2" id="nt-kind-tabs">
        <button type="button" class="px-3 py-3 text-sm font-medium border-b-2 border-accent text-text-primary transition-colors" data-kind="standard_action">{t("task_modal.kind_task", locale)}</button>
        <button type="button" class="px-3 py-3 text-sm font-medium border-b-2 border-transparent text-text-muted hover:text-text-primary transition-colors" data-kind="shopping_item">{t("task_modal.kind_shopping_list", locale)}</button>
        <button type="button" class="px-3 py-3 text-sm font-medium border-b-2 border-transparent text-text-muted hover:text-text-primary transition-colors" data-kind="checklist">{t("task_modal.kind_checklist", locale)}</button>
        <button type="button" class="px-3 py-3 text-sm font-medium border-b-2 border-transparent text-text-muted hover:text-text-primary transition-colors" data-kind="calendar_event">{t("task_modal.kind_event", locale)}</button>
      </div>
      <button
        type="button"
        class="btn-icon text-xl text-text-muted hover:text-text-primary pb-2"
        id="close-new-task-modal"
        aria-label="Close">✕</button
      >
    </div>

    <form id="new-task-form" class="space-y-4"
      data-toast-created={t("task_modal.toast_created", locale)}
      data-toast-error={t("task_modal.toast_error", locale)}
      data-toast-unexpected={t("task_modal.toast_unexpected", locale)}
    >
      <input type="hidden" name="task_kind" id="new-task-kind" value="standard_action" />
      
      <div class="form-group mb-2">
        <textarea
          class="bg-transparent border-none outline-none focus:ring-0 text-2xl font-bold p-0 mb-2 placeholder:text-text-muted/50 w-full resize-none overflow-hidden leading-tight"
          id="new-task-title-input"
          name="title"
          placeholder={t("task_modal.title_placeholder", locale)}
          data-placeholder-task={t("task_modal.title_placeholder", locale)}
          data-placeholder-shopping={t("task_modal.title_placeholder_shopping", locale)}
          data-placeholder-checklist={t("task_modal.title_placeholder_checklist", locale)}
          data-placeholder-event={t("task_modal.title_placeholder_event", locale)}
          required
          autofocus
          rows="1"
          style="height: 2.25em; max-height: 120px; field-sizing: content;"
          oninput="this.style.height = '2.25em'; this.style.height = Math.min(this.scrollHeight, 120) + 'px'"
        ></textarea>
      </div>

      <div class="form-group mb-6">
        <textarea
          class="form-input bg-transparent border border-transparent focus:border-border-dim hover:border-border-dim/50 rounded-lg text-sm w-full p-2 resize-none overflow-hidden placeholder:text-text-muted/50 transition-colors"
          id="new-task-desc-input"
          name="description"
          rows="2"
          placeholder={t("task_modal.description_placeholder", locale)}
          oninput="this.style.height = ''; this.style.height = this.scrollHeight + 'px'"
        ></textarea>
      </div>

      <div class="flex flex-wrap items-center gap-2 pb-4">
        <!-- Status Pills -->
        <input type="hidden" id="new-task-status" name="status" value="pending" />
        <div id="nt-status-pills" class="flex items-center gap-1.5" role="radiogroup" aria-label="Task status">
          <button type="button" class="nt-status-pill active" data-status="pending" role="radio" aria-checked="true">
            <svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" class="shrink-0"><circle cx="12" cy="12" r="10"/></svg>
            <span>{t("task_modal.status_todo", locale)}</span>
          </button>
        </div>

        <!-- Assignee -->
        <div class="relative group">
          <select class="form-select appearance-none bg-transparent hover:bg-border-dim/20 border border-border-dim rounded-lg text-xs py-1.5 pl-8 pr-8 shadow-sm transition-colors cursor-pointer" id="new-task-assigned-to">
            <option value="">{t("task_modal.unassigned", locale)}</option>
          </select>
          <div class="pointer-events-none absolute inset-y-0 left-0 flex items-center pl-2.5 text-text-muted">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path><circle cx="12" cy="7" r="4"></circle></svg>
          </div>
          <div class="pointer-events-none absolute inset-y-0 right-0 flex items-center px-2 text-text-muted">
             <svg width="12" height="12" viewBox="0 0 20 20" fill="currentColor"><path fill-rule="evenodd" d="M5.293 7.293a1 1 0 011.414 0L10 10.586l3.293-3.293a1 1 0 111.414 1.414l-4 4a1 1 0 01-1.414 0l-4-4a1 1 0 010-1.414z" clip-rule="evenodd" /></svg>
          </div>
        </div>

        <!-- Priority -->
        <div class="relative group">
          <select class="form-select appearance-none bg-transparent hover:bg-border-dim/20 border border-border-dim rounded-lg text-xs py-1.5 pl-7 pr-8 shadow-sm transition-colors cursor-pointer" id="new-task-priority">
            <option value="1">{t("task_modal.priority_urgent", locale)}</option>
            <option value="2">{t("task_modal.priority_high", locale)}</option>
            <option value="3" selected>{t("task_modal.priority_normal", locale)}</option>
            <option value="4">{t("task_modal.priority_low", locale)}</option>
          </select>
          <div class="pointer-events-none absolute inset-y-0 left-0 flex items-center pl-2.5 text-text-muted">
            <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 15s1-1 4-1 5 2 8 2 4-1 4-1V3s-1 1-4 1-5-2-8-2-4 1-4 1z"></path><line x1="4" y1="22" x2="4" y2="15"></line></svg>
          </div>
          <div class="pointer-events-none absolute inset-y-0 right-0 flex items-center px-2 text-text-muted">
             <svg width="12" height="12" viewBox="0 0 20 20" fill="currentColor"><path fill-rule="evenodd" d="M5.293 7.293a1 1 0 011.414 0L10 10.586l3.293-3.293a1 1 0 111.414 1.414l-4 4a1 1 0 01-1.414 0l-4-4a1 1 0 010-1.414z" clip-rule="evenodd" /></svg>
          </div>
        </div>
        
        <!-- Tags / Labels -->
        <div class="relative group">
          <button type="button" class="form-select appearance-none bg-transparent hover:bg-border-dim/20 border border-border-dim rounded-lg text-xs py-1.5 pl-7 pr-8 shadow-sm transition-colors cursor-pointer w-full text-left" onclick="document.getElementById('new-task-labels-panel').classList.toggle('hidden')">
            {t("task_modal.tags_label", locale)}
          </button>
          <div class="pointer-events-none absolute inset-y-0 left-0 flex items-center pl-2.5 text-text-muted">
            <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20.59 13.41l-7.17 7.17a2 2 0 0 1-2.83 0L2 12V2h10l8.59 8.59a2 2 0 0 1 0 2.82z"></path><line x1="7" y1="7" x2="7.01" y2="7"></line></svg>
          </div>
          <div class="pointer-events-none absolute inset-y-0 right-0 flex items-center px-2 text-text-muted">
             <svg width="12" height="12" viewBox="0 0 20 20" fill="currentColor"><path fill-rule="evenodd" d="M5.293 7.293a1 1 0 011.414 0L10 10.586l3.293-3.293a1 1 0 111.414 1.414l-4 4a1 1 0 01-1.414 0l-4-4a1 1 0 010-1.414z" clip-rule="evenodd" /></svg>
          </div>
        </div>
        
        <!-- Goal -->
        <div class="relative group">
          <select class="form-select appearance-none bg-transparent hover:bg-border-dim/20 border border-border-dim rounded-lg text-xs py-1.5 pl-7 pr-8 shadow-sm transition-colors cursor-pointer" id="new-task-goal" name="goal_id">
            <option value="">{t("task_modal.goal_none", locale)}</option>
          </select>
          <div class="pointer-events-none absolute inset-y-0 left-0 flex items-center pl-2 text-text-muted">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" class="text-accent" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"></circle><circle cx="12" cy="12" r="6"></circle><circle cx="12" cy="12" r="2"></circle></svg>
          </div>
          <div class="pointer-events-none absolute inset-y-0 right-0 flex items-center px-2 text-text-muted">
             <svg width="12" height="12" viewBox="0 0 20 20" fill="currentColor"><path fill-rule="evenodd" d="M5.293 7.293a1 1 0 011.414 0L10 10.586l3.293-3.293a1 1 0 111.414 1.414l-4 4a1 1 0 01-1.414 0l-4-4a1 1 0 010-1.414z" clip-rule="evenodd" /></svg>
          </div>
        </div>
        <!-- Recurrence -->
        <div class="relative group">
          <select class="form-select appearance-none bg-transparent hover:bg-border-dim/20 border border-border-dim rounded-lg text-xs py-1.5 pl-7 pr-8 shadow-sm transition-colors cursor-pointer" id="new-task-recurrence" name="recurrence_rule">
            <option value="">{t("task_modal.recurrence_none", locale)}</option>
            <option value="FREQ=DAILY">{t("task_modal.recurrence_daily", locale)}</option>
            <option value="FREQ=WEEKLY">{t("task_modal.recurrence_weekly", locale)}</option>
            <option value="FREQ=WEEKLY;BYDAY=MO,TU,WE,TH,FR">{t("task_modal.recurrence_weekday", locale)}</option>
            <option value="FREQ=MONTHLY">{t("task_modal.recurrence_monthly", locale)}</option>
            <option value="FREQ=YEARLY">{t("task_modal.recurrence_yearly", locale)}</option>
          </select>
          <div class="pointer-events-none absolute inset-y-0 left-0 flex items-center pl-2.5 text-text-muted">
            <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M17 1l4 4-4 4"></path><path d="M3 11V9a4 4 0 0 1 4-4h14"></path><path d="M7 23l-4-4 4-4"></path><path d="M21 13v2a4 4 0 0 1-4 4H3"></path></svg>
          </div>
          <div class="pointer-events-none absolute inset-y-0 right-0 flex items-center px-2 text-text-muted">
             <svg width="12" height="12" viewBox="0 0 20 20" fill="currentColor"><path fill-rule="evenodd" d="M5.293 7.293a1 1 0 011.414 0L10 10.586l3.293-3.293a1 1 0 111.414 1.414l-4 4a1 1 0 01-1.414 0l-4-4a1 1 0 010-1.414z" clip-rule="evenodd" /></svg>
          </div>
        </div>
      </div>

      <!-- Contextual UI per Kind -->
      <div id="nt-contextual-fields" class="hidden mb-4 p-3 bg-bg-input/20 border border-border-dim/50 rounded-xl space-y-3">
        <!-- Due Date (Checklist / Task) -->
        <div id="nt-ctx-due-row" class="form-group flex items-center gap-3">
           <label class="text-xs font-semibold text-text-muted uppercase tracking-wider w-20">{t("task_modal.due_date_label", locale)}</label>
           <input type="datetime-local" id="nt-contextual-due" class="form-input flex-1 bg-bg-input/50 border-border-dim rounded-lg text-sm px-3 py-1.5 focus:ring-accent focus:border-accent" />
        </div>

        <!-- Sub-items (Checklist) -->
        <div id="nt-contextual-checklist" class="hidden">
           <div class="form-group flex flex-col gap-2">
             <div class="flex items-center justify-between">
               <label class="text-xs font-semibold text-text-muted uppercase tracking-wider">{t("task_modal.sub_items_label", locale)}</label>
               <button type="button" class="text-xs text-accent hover:text-accent/80 font-medium" id="nt-add-sub-item-btn">+ {t("task_modal.add_sub_item", locale)}</button>
             </div>
             <div id="nt-checklist-items-container" class="space-y-1"></div>
             <input type="text" id="nt-checklist-builder-input" class="form-input bg-transparent border-none border-b border-border-dim rounded-none px-0 py-1 text-sm focus:ring-0 focus:border-accent w-full placeholder:text-text-muted/50" placeholder={t("task_modal.sub_item_placeholder", locale)} />
           </div>
        </div>

        <!-- Shopping List Fields -->
        <div id="nt-contextual-shopping" class="hidden space-y-3">
          <div class="flex items-center gap-4">
            <div class="flex flex-col gap-1">
              <label class="text-xs font-semibold text-text-muted uppercase tracking-wider">{t("task_modal.quantity_label", locale)}</label>
              <div class="flex items-center gap-1">
                <button type="button" class="w-8 h-8 flex items-center justify-center bg-bg-input/50 border border-border-dim rounded-lg text-text-primary hover:bg-border-dim/30 transition-colors" id="nt-qty-minus">−</button>
                <input type="number" id="nt-shopping-qty" value="1" min="1" max="999" class="w-12 text-center bg-bg-input/50 border border-border-dim rounded-lg text-sm py-1.5 focus:ring-accent" />
                <button type="button" class="w-8 h-8 flex items-center justify-center bg-bg-input/50 border border-border-dim rounded-lg text-text-primary hover:bg-border-dim/30 transition-colors" id="nt-qty-plus">+</button>
              </div>
            </div>
            <div class="flex flex-col gap-1 flex-1">
              <label class="text-xs font-semibold text-text-muted uppercase tracking-wider">{t("task_modal.category_label", locale)}</label>
              <select id="nt-shopping-category" class="form-select bg-bg-input/50 border border-border-dim rounded-lg text-sm py-1.5 px-3">
                <option value="">{t("task_modal.category_uncategorized", locale)}</option>
                <option value="produce">{t("task_modal.category_produce", locale)}</option>
                <option value="dairy">{t("task_modal.category_dairy", locale)}</option>
                <option value="meat">{t("task_modal.category_meat", locale)}</option>
                <option value="pantry">{t("task_modal.category_pantry", locale)}</option>
                <option value="frozen">{t("task_modal.category_frozen", locale)}</option>
                <option value="beverages">{t("task_modal.category_beverages", locale)}</option>
                <option value="household">{t("task_modal.category_household", locale)}</option>
                <option value="other">{t("task_modal.category_other", locale)}</option>
              </select>
            </div>
          </div>
          <button type="button" id="nt-add-shopping-item" class="w-full py-2 text-sm font-medium text-accent border border-accent/30 rounded-lg hover:bg-accent/10 transition-colors flex items-center justify-center gap-2">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M6 2L3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z"></path><line x1="3" y1="6" x2="21" y2="6"></line><path d="M16 10a4 4 0 0 1-8 0"></path></svg>
            {t("task_modal.add_item", locale)}
          </button>
          <div id="nt-shopping-list-container" class="hidden space-y-1">
            <label class="text-xs font-semibold text-text-muted uppercase tracking-wider">{t("task_modal.current_list", locale)}</label>
            <div id="nt-shopping-items" class="space-y-1"></div>
          </div>
        </div>

        <!-- Event Fields -->
        <div id="nt-contextual-event" class="hidden space-y-3">
          <div class="grid grid-cols-2 gap-3">
            <div class="flex flex-col gap-1">
              <label class="text-xs font-semibold text-text-muted uppercase tracking-wider">{t("task_modal.event_start", locale)}</label>
              <input type="datetime-local" id="nt-event-start" class="form-input bg-bg-input/50 border-border-dim rounded-lg text-sm px-3 py-1.5 focus:ring-accent" />
            </div>
            <div class="flex flex-col gap-1">
              <label class="text-xs font-semibold text-text-muted uppercase tracking-wider">{t("task_modal.event_end", locale)}</label>
              <input type="datetime-local" id="nt-event-end" class="form-input bg-bg-input/50 border-border-dim rounded-lg text-sm px-3 py-1.5 focus:ring-accent" />
            </div>
          </div>
          <div class="flex items-center justify-between">
            <div class="flex items-center gap-2">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="text-text-muted"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect><line x1="16" y1="2" x2="16" y2="6"></line><line x1="8" y1="2" x2="8" y2="6"></line><line x1="3" y1="10" x2="21" y2="10"></line></svg>
              <span class="text-sm text-text-primary">{t("task_modal.event_all_day", locale)}</span>
            </div>
            <label class="relative inline-flex items-center cursor-pointer">
              <input type="checkbox" id="nt-event-all-day" class="sr-only peer" />
              <div class="w-9 h-5 bg-bg-input/50 peer-checked:bg-accent rounded-full peer-focus:ring-2 peer-focus:ring-accent/30 transition-colors after:content-[''] after:absolute after:top-0.5 after:left-0.5 after:bg-white after:rounded-full after:h-4 after:w-4 after:transition-all peer-checked:after:translate-x-4"></div>
            </label>
          </div>
          <div class="flex flex-col gap-1">
            <label class="text-xs font-semibold text-text-muted uppercase tracking-wider">{t("task_modal.event_location_label", locale)}</label>
            <div class="relative">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="absolute left-3 top-1/2 -translate-y-1/2 text-text-muted"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path><circle cx="12" cy="10" r="3"></circle></svg>
              <input type="text" id="nt-event-location" class="form-input bg-bg-input/50 border-border-dim rounded-lg text-sm pl-9 pr-3 py-1.5 w-full" placeholder={t("task_modal.event_location", locale)} />
            </div>
          </div>
          <div class="flex flex-col gap-1">
            <label class="text-xs font-semibold text-text-muted uppercase tracking-wider">{t("task_modal.event_calendar", locale)}</label>
            <select id="nt-event-calendar" class="form-select bg-bg-input/50 border border-border-dim rounded-lg text-sm py-1.5 px-3">
              <option value="">{t("task_modal.event_calendar_default", locale)}</option>
            </select>
          </div>
        </div>
      </div>

      <!-- Mark as Routine -->
      <div id="nt-routine-toggle" class="flex items-center justify-between p-3 bg-bg-input/20 border border-border-dim/50 rounded-xl mb-4">
        <div class="flex items-center gap-3">
          <div class="w-8 h-8 rounded-lg bg-accent/20 flex items-center justify-center">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="text-accent"><path d="M17 1l4 4-4 4"></path><path d="M3 11V9a4 4 0 0 1 4-4h14"></path><path d="M7 23l-4-4 4-4"></path><path d="M21 13v2a4 4 0 0 1-4 4H3"></path></svg>
          </div>
          <div>
            <span class="text-sm font-medium text-text-primary">{t("task_modal.mark_as_routine", locale)}</span>
            <p class="text-xs text-text-muted">{t("task_modal.routine_description", locale)}</p>
          </div>
        </div>
        <label class="relative inline-flex items-center cursor-pointer">
          <input type="checkbox" id="nt-is-routine" class="sr-only peer" />
          <div class="w-9 h-5 bg-bg-input/50 peer-checked:bg-accent rounded-full peer-focus:ring-2 peer-focus:ring-accent/30 transition-colors after:content-[''] after:absolute after:top-0.5 after:left-0.5 after:bg-white after:rounded-full after:h-4 after:w-4 after:transition-all peer-checked:after:translate-x-4"></div>
        </label>
      </div>

      <!-- Custom Fields (collapsible) -->
      <div id="nt-custom-fields" class="mb-4">
        <button type="button" id="nt-custom-fields-toggle" class="flex items-center justify-between w-full p-2 text-xs font-semibold text-text-muted uppercase tracking-wider hover:text-text-primary transition-colors">
          <span class="flex items-center gap-1.5">
            <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M6 9l6 6 6-6"></path></svg>
            {t("task_modal.custom_fields_label", locale)}
          </span>
          <button type="button" id="nt-add-custom-field-btn" class="text-accent hover:text-accent/80 text-xs font-medium flex items-center gap-1">
            <svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="12" y1="5" x2="12" y2="19"></line><line x1="5" y1="12" x2="19" y2="12"></line></svg>
            {t("task_modal.custom_field_add", locale)}
          </button>
        </button>
        <div id="nt-custom-fields-container" class="hidden space-y-2 mt-2 p-3 bg-bg-input/20 border border-border-dim/50 rounded-xl">
          <div id="nt-custom-fields-list" class="space-y-2"></div>
          <div id="nt-add-field-dropdown" class="hidden flex-wrap gap-1.5 pt-2 border-t border-border-dim/30">
            <button type="button" class="nt-add-field-type text-xs px-2.5 py-1 bg-bg-input/50 border border-border-dim rounded-lg hover:bg-border-dim/30 transition-colors flex items-center gap-1" data-field-type="attachment">📎 {t("task_modal.custom_field_attachment", locale)}</button>
            <button type="button" class="nt-add-field-type text-xs px-2.5 py-1 bg-bg-input/50 border border-border-dim rounded-lg hover:bg-border-dim/30 transition-colors flex items-center gap-1" data-field-type="url">🔗 {t("task_modal.custom_field_url", locale)}</button>
            <button type="button" class="nt-add-field-type text-xs px-2.5 py-1 bg-bg-input/50 border border-border-dim rounded-lg hover:bg-border-dim/30 transition-colors flex items-center gap-1" data-field-type="text">📝 {t("task_modal.custom_field_text", locale)}</button>
            <button type="button" class="nt-add-field-type text-xs px-2.5 py-1 bg-bg-input/50 border border-border-dim rounded-lg hover:bg-border-dim/30 transition-colors flex items-center gap-1" data-field-type="number">🔢 {t("task_modal.custom_field_number", locale)}</button>
            <button type="button" class="nt-add-field-type text-xs px-2.5 py-1 bg-bg-input/50 border border-border-dim rounded-lg hover:bg-border-dim/30 transition-colors flex items-center gap-1" data-field-type="date">📅 {t("task_modal.custom_field_date", locale)}</button>
            <button type="button" class="nt-add-field-type text-xs px-2.5 py-1 bg-bg-input/50 border border-border-dim rounded-lg hover:bg-border-dim/30 transition-colors flex items-center gap-1" data-field-type="checkbox">☑️ {t("task_modal.custom_field_checkbox", locale)}</button>
          </div>
        </div>
      </div>

      <!-- AI Assist -->
      <div id="nt-ai-assist" class="flex items-center justify-between p-3 bg-bg-input/20 border border-border-dim/50 rounded-xl mb-4">
        <div class="flex items-center gap-3">
          <div class="w-8 h-8 rounded-lg bg-accent/20 flex items-center justify-center">
            <span class="text-sm">🤖</span>
          </div>
          <div>
            <span class="text-sm font-medium text-text-primary">{t("task_modal.ai_assign_to_agent", locale)}</span>
            <p class="text-xs text-text-muted" id="nt-ai-description"
              data-desc-task={t("task_modal.ai_task_description", locale)}
              data-desc-shopping={t("task_modal.ai_shopping_description", locale)}
              data-desc-checklist={t("task_modal.ai_checklist_description", locale)}
              data-desc-event={t("task_modal.ai_event_description", locale)}
            >{t("task_modal.ai_task_description", locale)}</p>
          </div>
        </div>
        <label class="relative inline-flex items-center cursor-pointer">
          <input type="checkbox" id="nt-ai-handoff" class="sr-only peer" />
          <div class="w-9 h-5 bg-bg-input/50 peer-checked:bg-accent rounded-full peer-focus:ring-2 peer-focus:ring-accent/30 transition-colors after:content-[''] after:absolute after:top-0.5 after:left-0.5 after:bg-white after:rounded-full after:h-4 after:w-4 after:transition-all peer-checked:after:translate-x-4"></div>
        </label>
      </div>

      <div id="new-task-labels-panel" class="hidden form-group bg-bg-input/30 p-3 rounded-lg border border-border-dim/50">
        <label for="new-task-labels" class="form-label text-xs">{t("task_modal.select_tags", locale)}</label>
        <LabelPicker id="new-task-label-picker" name="labels" />
      </div>

      <div
        class="modal-actions pt-4 border-t border-border-dim/30 flex items-center justify-end gap-3 mt-4"
      >
        <button type="button" class="btn btn-ghost text-text-muted hover:text-text-primary text-sm px-3 rounded-lg" id="cancel-new-task">{t("task_modal.btn_cancel", locale)}</button>

        <button
          type="submit"
          class="bg-linear-to-r from-accent to-accent/80 hover:from-accent/90 hover:to-accent/70 text-white font-semibold rounded-lg px-5 py-2 shadow-lg shadow-accent/20 transition-all text-sm"
          id="submit-new-task-btn"
          data-label-task={t("task_modal.btn_create_task", locale)}
          data-label-shopping={t("task_modal.btn_create_shopping_list", locale)}
          data-label-checklist={t("task_modal.btn_create_checklist", locale)}
          data-label-event={t("task_modal.btn_create_event", locale)}
          data-label-creating={t("task_modal.btn_creating", locale)}
        >{t("task_modal.btn_create_task", locale)}</button>
      </div>
    </form>
  </div>
</div>

<script>
  import { showToast } from "@lib/toast";
  import { createClientLogger } from "@lib/client-logger";
  import { pageLifecycle } from "@lib/page-lifecycle";

  const log = createClientLogger("tasks", "new-task-modal");

  // Handle smart task extraction mapping
  const nextWeekday = (day: number) => {
    const d = new Date();
    const diff = (day - d.getDay() + 7) % 7 || 7;
    d.setDate(d.getDate() + diff);
    return d;
  };

  pageLifecycle.onPageLoad((signal) => {
    const overlay = document.getElementById("new-task-overlay");
    const closeBtn = document.getElementById("close-new-task-modal");
    const cancelBtn = document.getElementById("cancel-new-task");
    const form = document.getElementById("new-task-form") as HTMLFormElement | null;

    // Task Kind Tab Switching
    const kindTabs = document.querySelectorAll("#nt-kind-tabs button");
    const kindInput = document.getElementById("new-task-kind") as HTMLInputElement | null;

    kindTabs.forEach(tab => {
      tab.addEventListener("click", () => {
        // Deactivate all
        kindTabs.forEach(t => {
          t.classList.remove("border-accent", "text-text-primary");
          t.classList.add("border-transparent", "text-text-muted");
        });
        // Activate clicked
        tab.classList.remove("border-transparent", "text-text-muted");
        tab.classList.add("border-accent", "text-text-primary");
        
        if (kindInput) kindInput.value = (tab as HTMLElement).dataset.kind || "standard_action";
        
        const contextualDiv = document.getElementById("nt-contextual-fields");
        const checklistDiv = document.getElementById("nt-contextual-checklist");
        const shoppingDiv = document.getElementById("nt-contextual-shopping");
        const eventDiv = document.getElementById("nt-contextual-event");
        const dueRow = document.getElementById("nt-ctx-due-row");
        const titleInput = document.getElementById("new-task-title-input") as HTMLTextAreaElement | null;
        const submitBtn = document.getElementById("submit-new-task-btn");
        const aiDesc = document.getElementById("nt-ai-description");
        
        const kind = kindInput?.value || "standard_action";
        
        // Hide all contextual sub-sections first
        checklistDiv?.classList.add("hidden");
        shoppingDiv?.classList.add("hidden");
        eventDiv?.classList.add("hidden");
        dueRow?.classList.add("hidden");
        
        if (kind === "shopping_item") {
          contextualDiv?.classList.remove("hidden");
          shoppingDiv?.classList.remove("hidden");
          if (titleInput) titleInput.placeholder = titleInput.dataset.placeholderShopping || "Item name";
          if (submitBtn) submitBtn.textContent = submitBtn.dataset.labelShopping || "Create Shopping List";
          if (aiDesc) aiDesc.textContent = aiDesc.dataset.descShopping || "";
        } else if (kind === "checklist") {
          contextualDiv?.classList.remove("hidden");
          checklistDiv?.classList.remove("hidden");
          dueRow?.classList.remove("hidden");
          if (titleInput) titleInput.placeholder = titleInput.dataset.placeholderChecklist || "Checklist name";
          if (submitBtn) submitBtn.textContent = submitBtn.dataset.labelChecklist || "Create Checklist";
          if (aiDesc) aiDesc.textContent = aiDesc.dataset.descChecklist || "";
        } else if (kind === "calendar_event") {
          contextualDiv?.classList.remove("hidden");
          eventDiv?.classList.remove("hidden");
          if (titleInput) titleInput.placeholder = titleInput.dataset.placeholderEvent || "Event name";
          if (submitBtn) submitBtn.textContent = submitBtn.dataset.labelEvent || "Create Event";
          if (aiDesc) aiDesc.textContent = aiDesc.dataset.descEvent || "";
        } else {
          contextualDiv?.classList.add("hidden");
          if (titleInput) titleInput.placeholder = titleInput.dataset.placeholderTask || "Task name";
          if (submitBtn) submitBtn.textContent = submitBtn.dataset.labelTask || "Create Task";
          if (aiDesc) aiDesc.textContent = aiDesc.dataset.descTask || "";
        }
        
        // Focus title input right away
        titleInput?.focus();
      }, { signal });
    });

    // Checklist Item Builder
    const builderInput = document.getElementById("nt-checklist-builder-input") as HTMLInputElement | null;
    const itemsContainer = document.getElementById("nt-checklist-items-container");
    const extractedChecklistItems: string[] = [];

    (window as any)._removeNTCItem = (val: string) => {
       const idx = extractedChecklistItems.indexOf(val);
       if (idx > -1) extractedChecklistItems.splice(idx, 1);
    };

    if (builderInput) {
      builderInput.addEventListener("keydown", (e) => {
        if (e.key === "Enter") {
          e.preventDefault(); // stop form submit
          const val = builderInput.value.trim();
          if (val) {
            extractedChecklistItems.push(val);
            const pill = document.createElement("div");
            pill.className = "flex items-center gap-2 text-sm bg-bg-input/30 py-1 px-2 rounded group";
            pill.innerHTML = `
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="text-text-muted"><circle cx="12" cy="12" r="10"></circle></svg>
              <span class="flex-1">${val}</span>
              <button type="button" class="text-text-muted hover:text-red-400 opacity-0 group-hover:opacity-100 transition-opacity" onclick="this.parentElement.remove(); window._removeNTCItem('${val.replace(/'/g, "\\'")}')">✕</button>
            `;
            itemsContainer?.appendChild(pill);
            builderInput.value = "";
          }
        }
      }, { signal });
    }

    // Shopping Qty +/- buttons
    const qtyMinus = document.getElementById("nt-qty-minus");
    const qtyPlus = document.getElementById("nt-qty-plus");
    const qtyEl = document.getElementById("nt-shopping-qty") as HTMLInputElement;
    qtyMinus?.addEventListener("click", () => {
      if (qtyEl && parseInt(qtyEl.value) > 1) qtyEl.value = String(parseInt(qtyEl.value) - 1);
    }, { signal });
    qtyPlus?.addEventListener("click", () => {
      if (qtyEl) qtyEl.value = String(parseInt(qtyEl.value) + 1);
    }, { signal });

    // Custom Fields toggle
    const cfToggle = document.getElementById("nt-custom-fields-toggle");
    const cfContainer = document.getElementById("nt-custom-fields-container");
    cfToggle?.addEventListener("click", () => {
      cfContainer?.classList.toggle("hidden");
    }, { signal });

    // Add custom field btn → show dropdown
    const cfAddBtn = document.getElementById("nt-add-custom-field-btn");
    const cfDropdown = document.getElementById("nt-add-field-dropdown");
    cfAddBtn?.addEventListener("click", (e) => {
      e.stopPropagation();
      if (cfDropdown) {
        cfDropdown.classList.toggle("hidden");
        if (!cfDropdown.classList.contains("hidden")) {
          cfDropdown.style.display = "flex";
        } else {
          cfDropdown.style.display = "";
        }
      }
    }, { signal });

    // Add field type buttons
    document.querySelectorAll(".nt-add-field-type").forEach(btn => {
      btn.addEventListener("click", () => {
        const type = (btn as HTMLElement).dataset.fieldType || "text";
        const cfList = document.getElementById("nt-custom-fields-list");
        if (!cfList) return;
        const entry = document.createElement("div");
        entry.className = "nt-custom-field-entry flex items-center gap-2";
        entry.dataset.fieldType = type;

        if (type === "checkbox") {
          entry.innerHTML = `<input type="checkbox" class="rounded border-border-dim bg-bg-input/50 focus:ring-accent" /><input type="text" class="form-input flex-1 bg-bg-input/50 border-border-dim rounded-lg text-sm px-3 py-1" placeholder="Label" /><button type="button" class="text-text-muted hover:text-red-400 text-xs" onclick="this.parentElement.remove()">✕</button>`;
        } else if (type === "url") {
          entry.innerHTML = `<span class="text-xs text-text-muted">🔗</span><input type="url" class="form-input flex-1 bg-bg-input/50 border-border-dim rounded-lg text-sm px-3 py-1" placeholder="https://" /><button type="button" class="text-text-muted hover:text-red-400 text-xs" onclick="this.parentElement.remove()">✕</button>`;
        } else if (type === "number") {
          entry.innerHTML = `<span class="text-xs text-text-muted">🔢</span><input type="number" class="form-input flex-1 bg-bg-input/50 border-border-dim rounded-lg text-sm px-3 py-1" placeholder="0" /><button type="button" class="text-text-muted hover:text-red-400 text-xs" onclick="this.parentElement.remove()">✕</button>`;
        } else if (type === "date") {
          entry.innerHTML = `<span class="text-xs text-text-muted">📅</span><input type="date" class="form-input flex-1 bg-bg-input/50 border-border-dim rounded-lg text-sm px-3 py-1" /><button type="button" class="text-text-muted hover:text-red-400 text-xs" onclick="this.parentElement.remove()">✕</button>`;
        } else if (type === "attachment") {
          entry.innerHTML = `<span class="text-xs text-text-muted">📎</span><input type="file" class="form-input flex-1 bg-bg-input/50 border-border-dim rounded-lg text-sm px-3 py-1" /><button type="button" class="text-text-muted hover:text-red-400 text-xs" onclick="this.parentElement.remove()">✕</button>`;
        } else {
          entry.innerHTML = `<span class="text-xs text-text-muted">📝</span><input type="text" class="form-input flex-1 bg-bg-input/50 border-border-dim rounded-lg text-sm px-3 py-1" placeholder="Enter text..." /><button type="button" class="text-text-muted hover:text-red-400 text-xs" onclick="this.parentElement.remove()">✕</button>`;
        }
        cfList.appendChild(entry);
        // Auto-show container
        cfContainer?.classList.remove("hidden");
      }, { signal });
    });
    function closeNewTaskModal() {
      if (!overlay || !overlay.classList.contains("active")) return;
      const reducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
      const finishClose = () => {
        overlay.classList.remove("active", "closing");
        form?.reset();
        
        // Reset tabs
        kindTabs.forEach(t => {
          t.classList.remove("border-accent", "text-text-primary");
          t.classList.add("border-transparent", "text-text-muted");
        });
        if (kindTabs.length > 0) {
          kindTabs[0]?.classList.add("border-accent", "text-text-primary");
          kindTabs[0]?.classList.remove("border-transparent", "text-text-muted");
        }
        if (kindInput) kindInput.value = "standard_action";

        // Reset new contextual sections
        document.getElementById("nt-contextual-shopping")?.classList.add("hidden");
        document.getElementById("nt-contextual-event")?.classList.add("hidden");
        document.getElementById("nt-ctx-due-row")?.classList.add("hidden");
        const shoppingItems = document.getElementById("nt-shopping-items");
        if (shoppingItems) shoppingItems.innerHTML = "";
        document.getElementById("nt-shopping-list-container")?.classList.add("hidden");
        const qtyInput = document.getElementById("nt-shopping-qty") as HTMLInputElement;
        if (qtyInput) qtyInput.value = "1";
        (document.getElementById("nt-shopping-category") as HTMLSelectElement).value = "";
        (document.getElementById("nt-is-routine") as HTMLInputElement).checked = false;
        (document.getElementById("nt-ai-handoff") as HTMLInputElement).checked = false;
        document.getElementById("nt-custom-fields-container")?.classList.add("hidden");
        const cfList = document.getElementById("nt-custom-fields-list");
        if (cfList) cfList.innerHTML = "";

        // Reset CTA and placeholder
        const titleEl2 = document.getElementById("new-task-title-input") as HTMLTextAreaElement;
        if (titleEl2) titleEl2.placeholder = titleEl2.dataset.placeholderTask || "Task name";
        const submitBtn2 = document.getElementById("submit-new-task-btn");
        if (submitBtn2) submitBtn2.textContent = submitBtn2.dataset.labelTask || "Create Task";

        // Reset contextual fields
        extractedChecklistItems.length = 0;
        if (itemsContainer) itemsContainer.innerHTML = "";
        document.getElementById("nt-contextual-fields")?.classList.add("hidden");
        const contextualDue = document.getElementById("nt-contextual-due") as HTMLInputElement;
        if (contextualDue) contextualDue.value = "";
      };
      if (reducedMotion) { finishClose(); return; }
      overlay.classList.add("closing");
      const content = overlay.querySelector(".modal-content");
      if (content) {
        const onEnd = () => { content.removeEventListener("animationend", onEnd); finishClose(); };
        content.addEventListener("animationend", onEnd, { once: true });
        setTimeout(() => { content.removeEventListener("animationend", onEnd); finishClose(); }, 300);
      } else {
        finishClose();
      }
    }

    if (closeBtn) closeBtn.addEventListener("click", closeNewTaskModal, { signal });
    if (cancelBtn) cancelBtn.addEventListener("click", closeNewTaskModal, { signal });
    if (overlay) overlay.addEventListener("click", (e) => {
      if (e.target === overlay) closeNewTaskModal();
    }, { signal });

    document.addEventListener("keydown", (e) => {
      if (overlay?.classList.contains("active")) {
        if (e.key === "Escape") {
          e.preventDefault();
          closeNewTaskModal();
        } else if (e.key === "Enter" && (e.metaKey || e.ctrlKey)) {
          e.preventDefault();
          form?.requestSubmit();
        }
      }
    }, { signal });

    // Expose global open method
    window.openNewTaskModal = () => {
      // If the detail panel is open, close it to avoid dual modal
      document.getElementById("task-detail-panel")?.classList.remove("open");
      document.getElementById("task-detail-overlay")?.classList.remove("active");

      form?.reset();
      overlay?.classList.add("active");

      // Reset title textarea height after form.reset()
      const titleEl = document.getElementById("new-task-title-input") as HTMLTextAreaElement | null;
      if (titleEl) titleEl.style.height = "2.25em";

      // Reset status pills to "pending" (To Do)
      const statusInput = document.getElementById("new-task-status") as HTMLInputElement | null;
      if (statusInput) statusInput.value = "pending";
      document.querySelectorAll(".nt-status-pill").forEach((p) => {
        const isPending = (p as HTMLElement).dataset.status === "pending";
        p.classList.toggle("active", isPending);
        p.setAttribute("aria-checked", isPending ? "true" : "false");
      });
      
      // Load user list for assignment dropdown
      loadAssigneeDropdown();
      setTimeout(() => {
        titleEl?.focus();
      }, 50);
    };

    // Fetch users and populate the Assign To dropdown
    async function loadAssigneeDropdown() {
      const select = document.getElementById("new-task-assigned-to") as HTMLSelectElement | null;
      const hint = document.getElementById("new-task-assignee-hint");
      if (!select) return;

      // Reset to just "Unassigned"
      const unassignedLabel = select.options[0]?.textContent || "Unassigned";
      select.innerHTML = `<option value="">${unassignedLabel}</option>`;

      try {
        const res = await fetch((window.__ingress_path || "") + "/api/users", { signal });
        if (!res.ok) return;
        const data = await res.json();
        const users = data.users || [];

        if (users.length === 0) {
          // No users discovered — hide dropdown, show link to settings
          if (select.parentElement) select.parentElement.style.display = "none";
          return;
        }

        if (select.parentElement) select.parentElement.style.display = "";
        if (hint) {
          if (users.length > 1) hint.classList.remove("hidden")
          else hint.classList.add("hidden")
        }

        for (const user of users) {
          const opt = document.createElement("option");
          opt.value = user.id;
          opt.textContent =
            user.name + (user.source === "home_assistant" ? " (HA)" : "");
          select.appendChild(opt);
        }

        // Auto-select default assignee if set
        if (data.default_assignee) {
          select.value = data.default_assignee;
        }

        // Single-user auto-select
        if (users.length === 1 && !data.default_assignee) {
          select.value = users[0].id;
        }

        // Store users for @mention matching
        (window as any).__meitheal_users = users;
      } catch {
        // Standalone/offline — leave just "Unassigned"
      }
    }

    // Swimlanes Loader → Status Pills
    (async function loadStatusPills() {
      const pillsContainer = document.getElementById("nt-status-pills");
      const statusHiddenInput = document.getElementById("new-task-status") as HTMLInputElement | null;
      if (!pillsContainer || !statusHiddenInput) return;

      function activatePill(pill: HTMLElement) {
        pillsContainer!.querySelectorAll(".nt-status-pill").forEach((p) => {
          p.classList.remove("active");
          p.setAttribute("aria-checked", "false");
        });
        pill.classList.add("active");
        pill.setAttribute("aria-checked", "true");
        statusHiddenInput!.value = pill.dataset.status || "pending";
      }

      try {
        const [lanesRes, modeRes] = await Promise.all([
          fetch((window.__ingress_path || "") + "/api/lanes", { signal }),
          fetch((window.__ingress_path || "") + "/api/settings?key=backlog_mode", { signal })
        ]);
        
        let backlogMode = "visible";
        if (modeRes.ok) {
           try {
             const md = await modeRes.json();
             backlogMode = md.value;
           } catch {} // ignore
        }
        
        if (lanesRes.ok) {
          const data = await lanesRes.json();
          let lanes = data.lanes || [];
          if (backlogMode === "disabled" || backlogMode === "hidden") {
             lanes = lanes.filter((l: any) => l.key !== "backlog");
          }
          pillsContainer.innerHTML = "";
          for (const lane of lanes) {
            const pill = document.createElement("button");
            pill.type = "button";
            pill.className = `nt-status-pill${lane.key === "pending" ? " active" : ""}`;
            pill.dataset.status = lane.key;
            pill.setAttribute("role", "radio");
            pill.setAttribute("aria-checked", lane.key === "pending" ? "true" : "false");
            pill.innerHTML = `<span class="nt-status-pill-icon">${lane.icon}</span><span>${lane.label}</span>`;
            pill.addEventListener("click", () => activatePill(pill), { signal });
            pillsContainer.appendChild(pill);
          }
        }
      } catch {
        // offline — keep the single fallback pill
        pillsContainer.querySelector(".nt-status-pill")?.addEventListener("click", (e) => {
          activatePill(e.currentTarget as HTMLElement);
        }, { signal });
      }
    })();

    // Goals Loader
    (async function loadGoals() {
      const goalSelect = document.getElementById("new-task-goal") as HTMLSelectElement | null;
      if (!goalSelect) return;

      try {
        const res = await fetch((window.__ingress_path || "") + "/api/goals", { signal });
        if (res.ok) {
          const data = await res.json();
          const goals = data.goals || data || [];
          const noGoalLabel = goalSelect.options[0]?.textContent || "No goal";
          goalSelect.innerHTML = `<option value="">${noGoalLabel}</option>`;
          goals.forEach((g: any) => {
            const opt = document.createElement("option");
            opt.value = g.id;
            opt.textContent = `🎯 ${g.title || g.name}`;
            goalSelect.appendChild(opt);
          });
        }
      } catch {}
    })();

    // Use event delegation on document.body to catch all create-task-btn clicks
    // without cloning DOM nodes (which breaks other scripts' references).
    document.body.addEventListener("click", (e) => {
      const target = (e.target as HTMLElement).closest("#create-task-btn");
      if (target) {
        e.preventDefault();
        window.openNewTaskModal?.();
      }
    }, { signal });

    // Form Submission
    if (form) {
      form.addEventListener("submit", async (e) => {
        e.preventDefault();
        const titleInput = document.getElementById("new-task-title-input") as HTMLInputElement | null;
        if (!titleInput) return;
        
        let title = titleInput.value.trim();
        if (!title) return;

        const submitBtn = document.getElementById("submit-new-task-btn") as HTMLButtonElement | null;
        const originalText = submitBtn?.textContent || "Create Task";
        if (submitBtn) {
          submitBtn.disabled = true;
          submitBtn.textContent = submitBtn.dataset.labelCreating || "Creating...";
        }

        try {
          const extractedLabels: string[] = [];
          let extractedDue: string | null = null;

          // Extract #tags
          title = title
            .replace(/#(\w+)/g, (_match, label) => {
              extractedLabels.push(label);
              return "";
            })
            .trim();

          // Extract date semantics
          const dateKeywords: Record<string, () => Date> = {
            today: () => new Date(),
            tomorrow: () => {
              const d = new Date();
              d.setDate(d.getDate() + 1);
              return d;
            },
            "next week": () => {
              const d = new Date();
              d.setDate(d.getDate() + 7);
              return d;
            },
            monday: () => nextWeekday(1),
            tuesday: () => nextWeekday(2),
            wednesday: () => nextWeekday(3),
            thursday: () => nextWeekday(4),
            friday: () => nextWeekday(5),
          };

          for (const [kw, getDate] of Object.entries(dateKeywords)) {
            const regex = new RegExp(`\\b${kw}\\b`, "i");
            if (regex.test(title)) {
              extractedDue = getDate().toISOString().slice(0, 16);
              title = title.replace(regex, "").trim();
              break;
            }
          }

          const labelPickerValue = document.getElementById("new-task-label-picker-value") as HTMLInputElement | null;
          let manualLabels: string[] = [];
          if (labelPickerValue && labelPickerValue.value) {
            try {
              manualLabels = JSON.parse(labelPickerValue.value);
            } catch {
              // Ignore invalid JSON
            }
          }

          const allLabels = [...new Set([...manualLabels, ...extractedLabels])];
          let finalTitle = title || titleInput.value.trim();

          // Extract @mentions for assignment
          const assignedToSelect = document.getElementById("new-task-assigned-to") as HTMLSelectElement | null;
          let assignedTo = assignedToSelect?.value || "";
          
          const users = (window as any).__meitheal_users || [];
          finalTitle = finalTitle
            .replace(/@(\w+)/g, (_match: string, mention: string) => {
              if (!assignedTo) {
                const found = users.find((u: any) =>
                  u.name.toLowerCase().startsWith(mention.toLowerCase()),
                );
                if (found) assignedTo = found.id;
              }
              return "";
            })
            .trim();
            
          if (!finalTitle) finalTitle = titleInput.value.trim();

          const explicitDue = (document.getElementById("nt-contextual-due") as HTMLInputElement)?.value;
          const finalDue = explicitDue ? new Date(explicitDue).toISOString() : extractedDue;

          const contextualChecklists = extractedChecklistItems.length > 0 ? JSON.stringify(extractedChecklistItems) : undefined;

          const kindInputEl = document.getElementById("new-task-kind") as HTMLInputElement | null;
          const descInputEl = document.getElementById("new-task-desc-input") as HTMLTextAreaElement | null;
          const prioritySelectEl = document.getElementById("new-task-priority") as HTMLSelectElement | null;
          const statusSelectEl = document.getElementById("new-task-status") as HTMLInputElement | null;
          const goalSelectEl = document.getElementById("new-task-goal") as HTMLSelectElement | null;
          const recurrenceSelectEl = document.getElementById("new-task-recurrence") as HTMLSelectElement | null;

          const body: Record<string, unknown> = {
            title: finalTitle,
            description: descInputEl?.value.trim() || "",
            task_kind: kindInputEl?.value || "standard_action",
            priority: parseInt(prioritySelectEl?.value || "3", 10),
            status: statusSelectEl?.value || "pending",
            labels: JSON.stringify(allLabels),
            due_date: finalDue,
            assigned_to: assignedTo || null,
            goal_id: goalSelectEl?.value || null,
          };

          const recurrenceVal = recurrenceSelectEl?.value;
          if (recurrenceVal) body.recurrence_rule = recurrenceVal;

          if (contextualChecklists) {
            body.checklists = contextualChecklists;
          }

          // Routine flag
          const routineCheck = document.getElementById("nt-is-routine") as HTMLInputElement;
          if (routineCheck?.checked) body.is_routine = true;

          // AI Handoff
          const aiCheck = document.getElementById("nt-ai-handoff") as HTMLInputElement;
          if (aiCheck?.checked) body.handoff_state = "pending_agent";

          // Shopping list fields
          if (body.task_kind === "shopping_item") {
            const qty = (document.getElementById("nt-shopping-qty") as HTMLInputElement)?.value;
            const cat = (document.getElementById("nt-shopping-category") as HTMLSelectElement)?.value;
            if (qty) body.custom_fields = JSON.stringify({ quantity: parseInt(qty, 10), category: cat || "" });
          }

          // Event fields
          if (body.task_kind === "calendar_event") {
            const startEl = document.getElementById("nt-event-start") as HTMLInputElement;
            const endEl = document.getElementById("nt-event-end") as HTMLInputElement;
            const locEl = document.getElementById("nt-event-location") as HTMLInputElement;
            const allDay = (document.getElementById("nt-event-all-day") as HTMLInputElement)?.checked;
            if (startEl?.value) body.start_date = new Date(startEl.value).toISOString();
            if (endEl?.value) body.end_date = new Date(endEl.value).toISOString();
            if (locEl?.value) body.location = locEl.value;
            if (allDay) body.all_day = true;
          }

          // Custom fields
          const cfItems = document.querySelectorAll("#nt-custom-fields-list .nt-custom-field-entry");
          if (cfItems.length > 0) {
            const cfData: Record<string, unknown>[] = [];
            cfItems.forEach(item => {
              const type = (item as HTMLElement).dataset.fieldType || "text";
              const input = item.querySelector("input, textarea") as HTMLInputElement;
              if (input?.value) cfData.push({ type, value: input.value });
            });
            if (cfData.length > 0) {
              const existing = body.custom_fields ? JSON.parse(body.custom_fields as string) : {};
              body.custom_fields = JSON.stringify({ ...existing, fields: cfData });
            }
          }

          const res = await fetch((window.__ingress_path || "") + "/api/tasks", {
            method: "POST",
            headers: { "content-type": "application/json" },
            body: JSON.stringify(body),
            signal
          });

          if (res.ok) {
            showToast(form.dataset.toastCreated || "Task created successfully", "success");
            closeNewTaskModal();
            document.dispatchEvent(new CustomEvent("meitheal:tasks-changed", {
              detail: { action: "created" }
            }));
            
            // Auto-open detail modal immediately
            try {
              const created = await res.json();
              if (created.task?.id && created.task?.task_kind !== "quick") {
                setTimeout(() => window.openTaskDetail?.(created.task.id), 250);
              }
            } catch {}
            
          } else {
            const err = await res.text();
            showToast(form.dataset.toastError || "Failed to create task", "error");
            log.error("Create task failed:", err);
            if (submitBtn) {
              submitBtn.disabled = false;
              submitBtn.textContent = originalText;
            }
          }
        } catch (e) {
          log.error("Form submission error", e);
          showToast(form.dataset.toastUnexpected || "Unexpected error creating task", "error");
          if (submitBtn) {
            submitBtn.disabled = false;
            submitBtn.textContent = originalText;
          }
        }
      }, { signal });
    }
  });
</script>
