              <button id="td-activity-retry" type="button" class="btn btn-secondary" hidden>{t("task_layout.retry", locale)}</button>
              <div id="td-activity" class="space-y-3 text-xs text-text-secondary"></div>
            </TaskDetailSection>
            </div>
            <div id="td-task-reference-picker" class="absolute inset-x-0 bottom-full z-30 mb-1 rounded-md border border-border bg-bg-card p-1 shadow-md"
              data-person-context={mentionUser ? mentionInboxContext(mentionUser.id) : undefined}
              data-task-results={t("task_modal.reference_results", locale)}
              data-person-results={t("mention_inbox.person_results", locale)}
              data-person-loading={t("mention_inbox.person_loading", locale)}
              data-person-choose={t("mention_inbox.person_choose", locale)}
              data-person-empty={t("mention_inbox.person_empty", locale)}
              data-person-failed={t("mention_inbox.person_failed", locale)}
              data-loading={t("task_modal.reference_loading", locale)}
              data-choose={t("task_modal.reference_choose", locale)}
              data-empty={t("task_modal.reference_empty", locale)}
              data-failed={t("task_modal.reference_failed", locale)}
              data-update={t("task_modal.reference_update", locale)}
              data-too-long={t("task_modal.reference_too_long", locale)}
              data-task-label={t("task_modal.kind_task", locale)} hidden>
              <p role="status" class="px-3 py-2 text-xs text-text-muted"></p>
              <ul id="td-task-reference-results" role="listbox"
                aria-label={t("task_modal.reference_results", locale)} hidden></ul>
            </div>

          </div>
        </div>
        </>}
      </div>
    </div>

<script>
  import "@lib/task-detail-lazy-loader"
</script>

<style is:inline>
  .td-event-schedule {
    display: flex;
    flex-direction: column;
    gap: 8px;
    margin-top: 8px;
    padding-top: 8px;
    border-top: 1px solid var(--border);
  }
  .td-event-row {
    display: grid;
    grid-template-columns: 100px minmax(0, 1fr);
    align-items: center;
    gap: 8px;
  }
  .td-cl-row {
    flex-wrap: wrap;
    min-height: 44px;
    padding: 4px 0;
  }
  .td-shop-qty { width: 56px; text-align: center; padding: 4px; }
  .td-shop-cat { width: 112px; padding: 4px; }
  .td-cl-del {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 36px;
    min-height: 36px;
    opacity: 0;
    transition: opacity 120ms ease;
  }
  .td-cl-row:hover .td-cl-del,
  .td-cl-row:focus-within .td-cl-del {
    opacity: 1;
  }
  @media (hover: none), (pointer: coarse) {
    .td-cl-del { opacity: 1; }
  }
  .td-save-status {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    padding: 3px 9px;
    border-radius: var(--radius-sm, 6px);
    font-size: 11.5px;
    font-weight: 600;
    line-height: 1.3;
    opacity: 0;
    transform: translateY(-2px) scale(0.96);
    pointer-events: none;
    transition: opacity 180ms cubic-bezier(0.23, 1, 0.32, 1), transform 180ms cubic-bezier(0.23, 1, 0.32, 1);
  }
  .td-save-status[data-state="saving"] {
    opacity: 1;
    transform: translateY(0) scale(1);
    color: var(--text-secondary);
    background: var(--bg-secondary);
    border: 1px solid var(--border);
  }
  .td-save-status[data-state="saving"] .td-save-status__icon {
    display: none;
  }
  .td-save-status[data-state="saved"] {
    opacity: 1;
    transform: translateY(0) scale(1);
    color: var(--success-text, #10b981);
    background: color-mix(in srgb, var(--success, #10b981) 14%, var(--bg-card));
    border: 1px solid color-mix(in srgb, var(--success, #10b981) 42%, var(--border));
  }
  @keyframes tdFieldSavedPulse {
    0% {
      box-shadow: 0 0 0 2px color-mix(in srgb, var(--success, #10b981) 55%, transparent);
      border-color: var(--success, #10b981);
    }
    100% {
      box-shadow: 0 0 0 0 transparent;
    }
  }
  .td-field--saved {
    animation: tdFieldSavedPulse 850ms cubic-bezier(0.23, 1, 0.32, 1);
  }
  @media (prefers-reduced-motion: reduce) {
    .td-save-status,
    .td-field--saved {
      transition: none;
      animation: none;
    }
  }
</style>
