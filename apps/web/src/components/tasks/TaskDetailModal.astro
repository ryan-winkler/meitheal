                        <button type="button" id="td-add-subtask-cancel" aria-label="Cancel child item" class="btn bg-bg-input border border-border hover:bg-bg-hover text-text-primary text-xs px-2 py-1.5"><Icon name="x" size={14} sprite={true} /></button>
                      </div>
                    </div>
                  </div>
                </div>

                <div class="h-px bg-border w-full"></div>
                
                <!-- Related Links -->
                <div>
                  <span class="text-xs text-text-muted font-bold uppercase tracking-wider mb-2 block">
                    <span>Related Links <span id="td-link-count" class="text-text-muted opacity-70 ml-1"></span></span>
                  </span>
                  <div id="td-related-links" class="space-y-1.5 mb-3">
                    <div id="td-links-empty" class="text-xs text-text-muted italic py-1">No related links. Use the search to link tasks.</div>
                  </div>
                  <div id="td-link-live" aria-live="polite" class="sr-only"></div>
                  <div class="flex flex-col gap-2">
                    <select id="td-link-type-select" aria-label={t("task_layout.relationship_type", locale)} class="form-select text-sm py-1.5 bg-bg-input w-full shrink-0">
                      <option value="related_to">Related to</option>
                      <option value="blocked_by">Blocked by</option>
                      <option value="blocks">Blocks</option>
                      <option value="duplicates">Duplicates</option>
                      <option value="duplicated_by">Duplicated by</option>
                    </select>
                    <div class="relative w-full">
                      <input id="td-link-search" aria-label="Search task to link" class="form-input text-sm py-1.5 w-full bg-bg-input hover:border-border transition-colors" placeholder="Search task to link…"/>
                      <div id="td-link-search-results" class="absolute z-50 left-0 top-full mt-1 right-0 bg-bg-card border border-border rounded-md shadow-lg max-h-40 overflow-y-auto" style="display:none;"></div>
                    </div>
                  </div>
                </div>
              </div>
            </TaskDetailSection>

            <TaskDetailSection name="comments">
              <div class="td-chat-card">
                <div class="td-chat-header">
                  <div class="td-chat-header__title">
                    <Icon name="message-circle" size={14} sprite />
                    <span>Discussion &amp; Reactions</span>
                  </div>
                  <div id="td-task-reactions" class="td-chat-reactions"></div>
                </div>
                <div class="td-chat-body">
                  <p id="td-comment-link-status" tabindex="-1" role="status"
                    class="text-sm text-text-primary [&:not(:empty)]:mb-3 focus:outline-2 focus:outline-accent"
                    data-unavailable={t("task_modal.comment_link_unavailable", locale)}
                    data-load-failed={t("task_modal.comment_link_load_failed", locale)}></p>
                  <div class="chat">
                    <div id="td-comments" data-link-label={t("task_modal.comment_link", locale)} data-task-label={t("task_modal.kind_task", locale)}
                      class="chat-bubbles"></div>
                  </div>
                </div>
                <template id="td-reaction-controls"
                  data-task-label={t("reactions.task", locale)}
                  data-comment-label={t("reactions.comment", locale)}
                  data-loading={t("reactions.loading", locale)}
                  data-saving={t("reactions.saving", locale)}
                  data-empty={t("reactions.empty", locale)}
                  data-unavailable={t("reactions.unavailable", locale)}
                  data-load-failed={t("reactions.load_failed", locale)}
                  data-save-failed={t("reactions.save_failed", locale)}
                  data-remove-failed={t("reactions.remove_failed", locale)}
                  data-participant-required={t("task_modal.participant_required", locale)}
                  data-invalid={t("reactions.invalid", locale)}
                  data-saved={t("reactions.saved", locale)}
                  data-removed={t("reactions.removed", locale)}
                  data-remove-label={t("reactions.remove", locale)}
                  data-remove-description={t("reactions.remove_description", locale)}>
                  <div class="td-reaction-popover">
                    <form data-reaction-form class="td-reaction-form" hidden>
                      <div class="td-emoji-quick-row" role="group" aria-label="Quick reactions">
                        {["👍", "❤️", "🎉", "👀", "🔥", "✅"].map(emoji => (
                          <button type="button" data-reaction-emoji={emoji} class="td-emoji-quick-btn" aria-pressed="false">{emoji}</button>
                        ))}
                      </div>
                      <div class="td-reaction-input-row">
                        <input type="text" class="form-input td-reaction-input" aria-label={t("reactions.input", locale)} placeholder={t("reactions.input", locale)} maxlength="128" autocomplete="off" dir="auto" required />
                        <button type="submit" class="btn btn-primary btn-sm">{t("reactions.add", locale)}</button>
                      </div>
                      <p class="td-reaction-policy-hint">One reaction per person — picking another switches yours.</p>
                    </form>
                    <p data-reaction-status role="status" class="td-reaction-status"></p>
                    <p data-reaction-error role="alert" class="td-reaction-error"></p>
                    <button type="button" data-reaction-retry class="btn btn-ghost btn-sm" hidden>{t("reactions.retry", locale)}</button>
                    <ul data-reaction-list class="td-reaction-list" role="list" hidden></ul>
                    <div class="td-reaction-pager">
                      <button type="button" data-reaction-newest class="btn btn-ghost btn-sm" hidden>{t("reactions.newest", locale)}</button>
                      <button type="button" data-reaction-older class="btn btn-ghost btn-sm" hidden>{t("reactions.older", locale)}</button>
                    </div>
                  </div>
                </template>
                <template id="td-comment-management"
                  data-delete-prompt={t("task_modal.comment_delete_prompt", locale)}
                  data-participant-required={t("task_modal.participant_required", locale)}
                  data-mention-failed={t("mention_inbox.write_error", locale)}
                  data-mention-context-changed={t("mention_inbox.context_changed", locale)}
                  data-edit-failed={t("task_modal.comment_edit_failed", locale)}
                  data-delete-failed={t("task_modal.comment_delete_failed", locale)}>
                  <div data-comment-actions class="td-chat-bubble-actions">
                    <button data-comment-edit type="button" class="td-chat-action-link">{t("task_modal.comment_edit", locale)}</button>
                    <button data-comment-delete type="button" class="td-chat-action-link td-chat-action-link--danger">{t("task_modal.comment_delete", locale)}</button>
                  </div>
                  <form data-comment-editor class="mt-2" hidden>
                    <div class="relative">
                      <textarea class="form-input w-full resize-y text-sm" aria-label={t("task_modal.comment_edit", locale)} aria-autocomplete="list" data-task-reference data-comment-mention={mentionUser ? "" : undefined} maxlength="5000" required></textarea>
                    </div>
                    <p data-reference-hint class="text-xs text-text-muted mt-1">{t(mentionUser ? "mention_inbox.editor_hint" : "task_modal.reference_hint", locale)}</p>
                    <div class="flex flex-wrap gap-2 mt-2">
                      <button type="submit" class="btn btn-primary btn-sm">{t("task_modal.comment_save", locale)}</button>
                      <button data-comment-cancel type="button" class="btn btn-ghost btn-sm">{t("common.cancel", locale)}</button>
                    </div>
                  </form>
                  <p role="alert" class="text-xs text-danger [&:not(:empty)]:mt-2"></p>
                </template>
                <div class="td-chat-footer">
                  <div class="td-chat-composer-wrap">
                    <div class="input-group input-group-flat td-chat-input-group">
                      <textarea id="td-comment-input" rows="1" class="form-control td-chat-textarea" aria-label={t("task_modal.comment_label", locale)} aria-describedby="td-comment-error td-comment-reference-hint" aria-autocomplete="list" data-task-reference data-comment-mention={mentionUser ? "" : undefined} maxlength="5000" placeholder={t("task_modal.comment_placeholder", locale)}></textarea>
                      <span class="input-group-text td-chat-input-addons">
                        <button type="button" id="td-chat-emoji-btn" class="td-chat-tool-btn" title="React or insert emoji" aria-label="Toggle task reactions">
                          <Icon name="mood-smile" size={17} sprite={true} />
                        </button>
                        <button type="button" id="td-chat-attach-btn" class="td-chat-tool-btn" title="Attach image" aria-label="Attach image">
                          <Icon name="paperclip" size={18} sprite={true} />
                        </button>
                      </span>
                    </div>
                    <button type="button" id="td-comment-submit" class="btn btn-primary td-chat-send-btn" title="Post comment (Ctrl/Cmd+Enter)">
                      <Icon name="send" size={16} sprite={true} />
                      <span>Send</span>
                    </button>
                  </div>
                  <div class="td-chat-composer-meta">
                    <p id="td-comment-reference-hint" class="text-xs text-text-muted m-0">{t(mentionUser ? "mention_inbox.editor_hint" : "task_modal.reference_hint", locale)}</p>
                    <span class="text-[10px] text-text-muted hidden @md/task-inspector:flex items-center gap-1"><kbd class="px-1 py-0.5 rounded bg-bg-input border border-border text-[10px] font-mono">⌘</kbd><kbd class="px-1 py-0.5 rounded bg-bg-input border border-border text-[10px] font-mono">↵</kbd></span>
                  </div>
                  <p id="td-comment-error" class="text-xs text-danger mt-2 mb-0" role="alert" hidden
                    data-mention-failed={t("mention_inbox.write_error", locale)}
                    data-mention-context-changed={t("mention_inbox.context_changed", locale)}
                    data-failed={t("task_modal.comment_failed", locale)}
                    data-participant-required={t("task_modal.participant_required", locale)}></p>
                </div>
              </div>
            </TaskDetailSection>

            <TaskDetailSection name="activity">
              <p id="td-activity-status" role="status" class="text-sm text-text-secondary"
                data-loading={t("task_layout.activity_loading", locale)}
