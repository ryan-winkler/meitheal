                    <button id="td-desc-save-btn" class="btn btn-primary text-xs px-3 py-1.5 shadow-sm" type="button">Save</button>
                </div>
              </div>
            </section>

            <div id="td-task-reactions" class="mb-5"></div>

            <!-- Checklists -->
            <section>
              <div class="flex items-center justify-between mb-2">
                <h3 class="text-xs text-text-muted font-bold uppercase tracking-wider">Checklists</h3>
                <button type="button" id="td-add-checklist-item" class="text-xs text-accent hover:text-accent-hover transition-colors font-medium flex items-center gap-1">
                    <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"><line x1="12" y1="5" x2="12" y2="19"></line><line x1="5" y1="12" x2="19" y2="12"></line></svg>
                    <span>Add Item</span>
                </button>
              </div>
              <div id="td-checklist-progress" class="text-[10px] text-text-muted mb-3 flex items-center justify-between" style="display:none;">
                  <div class="w-full mr-3 h-1.5 bg-bg-card rounded-full overflow-hidden border border-border">
                    <div id="td-checklist-progress-bar" class="h-full bg-accent transition-[width] duration-300" style="width:0%"></div>
                  </div>
                  <span class="whitespace-nowrap"><span id="td-checklist-done">0</span>/<span id="td-checklist-total">0</span></span>
              </div>
              <div id="td-checklists" class="space-y-1"></div>
              <p id="td-checklist-message" role="status" class="text-sm text-text-primary mt-2"></p>
              <button type="button" id="td-checklist-recover" class="btn text-xs px-3 py-1.5 mt-2" hidden></button>
              <details id="td-checklist-draft" class="text-sm text-text-primary mt-2" hidden>
                <summary>Your unsaved checklist draft</summary>
                <ol class="list-decimal pl-5 wrap-break-word"></ol>
              </details>
            </section>

            <!-- Attachments -->
            <section>
              <div class="flex items-center justify-between mb-2">
                <h3 class="text-xs text-text-muted font-bold uppercase tracking-wider">Attachments</h3>
                <label class="text-xs text-accent hover:text-accent-hover cursor-pointer m-0 font-medium flex items-center gap-1">
                  <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
                  Add Image
                  <input type="file" id="td-attachment-input" accept="image/*" class="hidden" />
                </label>
              </div>
              <div id="td-attachments" class="flex flex-wrap gap-3 mt-2"></div>
            </section>

            <!-- Linking & Subtasks -->
            <section class="border border-border rounded-xl p-5 bg-bg-card/50">
              <h3 class="text-sm font-semibold text-text-primary mb-4 flex items-center gap-2">
                  <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="text-text-muted"><path d="M13.828 10.172a4 4 0 00-5.656 0l-4 4a4 4 0 105.656 5.656l1.102-1.101m-.758-4.899a4 4 0 005.656 0l4-4a4 4 0 00-5.656-5.656l-1.1 1.1"/></svg>
                  Relationships
              </h3>
              <div class="space-y-5">
                <div class="grid grid-cols-1 xl:grid-cols-2 gap-6">
                  <!-- Parent -->
                  <div>
                    <span class="text-xs text-text-muted font-bold uppercase tracking-wider mb-2 block">Parent Epic/Story</span>
                    <div id="td-link-parent-display" class="flex items-center gap-1 mb-2">
                      <span class="text-xs text-text-muted italic">None</span>
                    </div>
                    <div class="relative">
                      <input id="td-link-parent-search" class="form-input text-sm py-1.5 w-full bg-bg-input hover:border-border transition-colors" placeholder="Search for parent..."/>
                      <div id="td-link-parent-results" class="absolute z-10 left-0 right-0 top-full mt-1 bg-bg-card border border-border rounded-md shadow-lg max-h-40 overflow-y-auto" style="display:none;"></div>
                    </div>
                  </div>
                  <!-- Children -->
                  <div>
                    <span class="text-xs text-text-muted font-bold uppercase tracking-wider mb-2 block">Child Subtasks</span>
                    <div id="td-link-children" class="space-y-1.5 mb-2"></div>
                    <div id="td-subtask-progress" class="hidden mb-3">
                      <div class="flex items-center justify-between text-[10px] text-text-muted mb-1">
                        <span id="td-subtask-progress-label">0/0</span>
                      </div>
                      <div class="w-full h-1.5 bg-bg-input rounded-full overflow-hidden border border-border/50">
                        <div id="td-subtask-progress-bar" class="h-full bg-accent transition-[width] duration-300 rounded-full" style="width:0%"></div>
                      </div>
                    </div>
                    <div id="td-add-subtask">
                      <button type="button" id="td-add-subtask-btn" class="text-xs text-accent hover:text-accent-hover flex items-center gap-1 font-medium transition-colors">
                        <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
                        Add subtask
                      </button>
                      <div id="td-add-subtask-form" class="hidden mt-2 gap-2">
                        <input id="td-add-subtask-input" class="form-input text-sm py-1.5 flex-1 bg-bg-input" placeholder="Subtask title..." autocomplete="off"/>
                        <button type="button" id="td-add-subtask-submit" class="btn btn-primary text-xs px-3 py-1.5 shadow-sm">Add</button>
                        <button type="button" id="td-add-subtask-cancel" class="btn bg-bg-input border border-border hover:bg-bg-hover text-text-primary text-xs px-2 py-1.5">✕</button>
                      </div>
                    </div>
                  </div>
                </div>

                <div class="h-px bg-border w-full"></div>
                
                <!-- Related Links -->
                <div>
                  <span class="text-xs text-text-muted font-bold uppercase tracking-wider mb-2 block">
                    <span>Related Links <span id="td-link-count" class="text-text-muted opacity-70 ml-1"></span></span>
                  </span>
                  <div id="td-related-links" class="space-y-1.5 mb-3">
                    <div id="td-links-empty" class="text-xs text-text-muted italic py-1">No related links. Use the search to link tasks.</div>
                  </div>
                  <div id="td-link-live" aria-live="polite" class="sr-only"></div>
                  <div class="flex flex-col gap-2">
                    <select id="td-link-type-select" class="form-select text-sm py-1.5 bg-bg-input w-full shrink-0">
                      <option value="related_to">Related to</option>
                      <option value="blocked_by">Blocked by</option>
                      <option value="blocks">Blocks</option>
                      <option value="duplicates">Duplicates</option>
                      <option value="duplicated_by">Duplicated by</option>
                    </select>
                    <div class="relative w-full">
                      <input id="td-link-search" class="form-input text-sm py-1.5 w-full bg-bg-input hover:border-border transition-colors" placeholder="Search task to link…"/>
                      <div id="td-link-search-results" class="absolute z-50 left-0 top-full mt-1 right-0 bg-bg-card border border-border rounded-md shadow-lg max-h-40 overflow-y-auto" style="display:none;"></div>
                    </div>
                  </div>
                </div>
              </div>
            </section>



          </div>

          <!-- SIDEBAR (PROPERTIES) COLUMN -->
          <aside class="w-full md:w-[320px] bg-bg-card/30 backdrop-blur-md border-t md:border-t-0 md:border-l border-white/5 px-6 py-6 flex-none flex flex-col gap-6">
            
            <button id="td-toggle-done" class="btn btn-primary w-full shadow-lg shadow-accent/20 py-2.5 font-bold text-sm transition-[background,transform] flex items-center justify-center gap-2 hover:-translate-y-0.5 td-done-btn">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"></polyline></svg>
                Mark as Done
            </button>

            <!-- Mobile sidebar toggle (hidden on desktop) -->
            <button id="td-sidebar-toggle" class="md:hidden w-full flex items-center justify-between py-2.5 px-3 text-sm font-semibold text-text-primary bg-bg-input rounded-lg border border-border hover:bg-bg-hover transition-colors" type="button" aria-expanded="false" aria-controls="td-sidebar-props">
              <span class="flex items-center gap-2">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="text-text-muted"><path d="M12 3v18M19 6l-7-3-7 3M19 18l-7 3-7-3"/></svg>
                Details
              </span>
              <svg id="td-sidebar-chevron" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" class="transition-transform duration-200 text-text-muted"><polyline points="6 9 12 15 18 9"></polyline></svg>
            </button>

            <!-- Collapsible content (always visible on desktop, toggled on mobile) -->
            <noscript></noscript>
            <div id="td-sidebar-props" class="td-sidebar-props flex flex-col gap-6">

            <!-- Comments -->
            <section class="border-t border-border pt-8 mt-8">
              <h3 class="text-xs text-text-muted font-bold uppercase tracking-wider mb-5 flex items-center gap-2">
                 <svg width="16" height="16" viewBox="0 0 24 24" fill="none" class="text-text-muted" stroke="currentColor" stroke-width="2"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2v10z"></path></svg>
                 Comments
              </h3>
              <p id="td-comment-link-status" tabindex="-1" role="status"
                class="text-sm text-text-primary [&:not(:empty)]:mb-3 focus:outline-2 focus:outline-accent"
                data-unavailable={t("task_modal.comment_link_unavailable", locale)}
                data-load-failed={t("task_modal.comment_link_load_failed", locale)}></p>
              <div id="td-comments" data-link-label={t("task_modal.comment_link", locale)} data-task-label={t("task_modal.kind_task", locale)}
                class="space-y-5 mb-5 pl-2 relative before:absolute before:inset-y-0 before:left-[19px] before:w-px before:bg-border/50"></div>
              <template id="td-reaction-controls"
                data-task-label={t("reactions.task", locale)}
                data-comment-label={t("reactions.comment", locale)}
                data-loading={t("reactions.loading", locale)}
                data-saving={t("reactions.saving", locale)}
                data-empty={t("reactions.empty", locale)}
                data-unavailable={t("reactions.unavailable", locale)}
                data-load-failed={t("reactions.load_failed", locale)}
                data-save-failed={t("reactions.save_failed", locale)}
                data-remove-failed={t("reactions.remove_failed", locale)}
                data-participant-required={t("task_modal.participant_required", locale)}
                data-invalid={t("reactions.invalid", locale)}
                data-saved={t("reactions.saved", locale)}
                data-removed={t("reactions.removed", locale)}
                data-remove-label={t("reactions.remove", locale)}
                data-remove-description={t("reactions.remove_description", locale)}>
                <p data-reaction-status role="status" class="text-sm text-text-secondary [&:not(:empty)]:my-2"></p>
                <p data-reaction-error role="alert" class="text-sm text-text-primary [&:not(:empty)]:my-2"></p>
                <button type="button" data-reaction-retry class="btn btn-ghost min-h-11" hidden>{t("reactions.retry", locale)}</button>
                <ul data-reaction-list class="space-y-1" role="list"></ul>
                <div class="flex flex-wrap gap-2">
                  <button type="button" data-reaction-newest class="btn btn-ghost min-h-11" hidden>{t("reactions.newest", locale)}</button>
                  <button type="button" data-reaction-older class="btn btn-ghost min-h-11" hidden>{t("reactions.older", locale)}</button>
                </div>
                <form data-reaction-form class="mt-2 space-y-2" hidden>
                  <label class="block text-sm text-text-secondary">
                    {t("reactions.input", locale)}
                    <input type="text" class="form-input mt-1 w-full min-h-11" maxlength="128" autocomplete="off" dir="auto" required />
                  </label>
                  <div class="flex flex-wrap items-center gap-1">
                    {["👍", "❤️", "🎉", "👀"].map(emoji => (
                      <button type="button" data-reaction-emoji={emoji} class="btn btn-ghost min-h-11 min-w-11">{emoji}</button>
                    ))}
                  </div>
                  <button type="submit" class="btn btn-primary min-h-11">{t("reactions.add", locale)}</button>
                </form>
              </template>
              <template id="td-comment-management"
                data-delete-prompt={t("task_modal.comment_delete_prompt", locale)}
                data-participant-required={t("task_modal.participant_required", locale)}
                data-mention-failed={t("mention_inbox.write_error", locale)}
                data-mention-context-changed={t("mention_inbox.context_changed", locale)}
                data-edit-failed={t("task_modal.comment_edit_failed", locale)}
                data-delete-failed={t("task_modal.comment_delete_failed", locale)}>
                <div data-comment-actions class="flex flex-wrap gap-2">
                  <button data-comment-edit type="button" class="btn btn-ghost min-h-11">{t("task_modal.comment_edit", locale)}</button>
                  <button data-comment-delete type="button" class="btn btn-ghost min-h-11">{t("task_modal.comment_delete", locale)}</button>
                </div>
                <form data-comment-editor class="mt-2" hidden>
                  <div class="relative">
                    <textarea class="form-input w-full resize-y" aria-label={t("task_modal.comment_edit", locale)} aria-autocomplete="list" data-task-reference data-comment-mention={mentionUser ? "" : undefined} maxlength="5000" required></textarea>
                  </div>
                  <p data-reference-hint class="text-xs text-text-muted">{t(mentionUser ? "mention_inbox.editor_hint" : "task_modal.reference_hint", locale)}</p>
                  <div class="flex flex-wrap gap-2">
                    <button type="submit" class="btn btn-primary min-h-11">{t("task_modal.comment_save", locale)}</button>
                    <button data-comment-cancel type="button" class="btn btn-ghost min-h-11">{t("common.cancel", locale)}</button>
                  </div>
                </form>
                <p role="alert" class="text-sm text-text-primary [&:not(:empty)]:mt-2"></p>
              </template>
              <div class="flex gap-3 items-start relative mt-6">
                <div class="w-9 h-9 rounded-full bg-bg-input flex items-center justify-center shrink-0 border border-border text-xs text-text-muted uppercase font-bold shadow-sm z-10">ME</div>
                <div class="min-w-0 flex-1">
                  <div class="relative">
                    <textarea id="td-comment-input" class="form-input w-full bg-bg-input text-sm py-2 px-3 resize-y min-h-[44px] focus:ring-1 focus:ring-accent transition-colors" aria-label={t("task_modal.comment_label", locale)} aria-describedby="td-comment-error td-comment-reference-hint" aria-autocomplete="list" data-task-reference data-comment-mention={mentionUser ? "" : undefined} maxlength="5000" placeholder={t("task_modal.comment_placeholder", locale)}></textarea>
                  </div>
                    <p id="td-comment-reference-hint" class="text-xs text-text-muted">{t(mentionUser ? "mention_inbox.editor_hint" : "task_modal.reference_hint", locale)}</p>
                    <p id="td-comment-error" class="text-sm text-text-primary mt-2" role="alert" hidden
                      data-mention-failed={t("mention_inbox.write_error", locale)}
                      data-mention-context-changed={t("mention_inbox.context_changed", locale)}
                      data-failed={t("task_modal.comment_failed", locale)}
                      data-participant-required={t("task_modal.participant_required", locale)}></p>
                    <div class="flex justify-end items-center gap-3 mt-2">
                      <span class="text-[10px] text-text-muted hidden md:flex items-center gap-1"><kbd class="px-1 py-0.5 rounded bg-bg-input border border-border text-[10px] font-mono">⌘</kbd><kbd class="px-1 py-0.5 rounded bg-bg-input border border-border text-[10px] font-mono">↵</kbd></span>
                      <button type="button" id="td-comment-submit" class="btn btn-primary text-xs px-4 py-1.5 shadow-sm font-medium">Post Comment</button>
                    </div>
                </div>
              </div>
            </section>

            <div id="td-task-reference-picker" class="absolute inset-x-0 bottom-full z-30 mb-1 rounded-md border border-border bg-bg-card p-1 shadow-md"
              data-person-context={mentionUser ? mentionInboxContext(mentionUser.id) : undefined}
              data-task-results={t("task_modal.reference_results", locale)}
              data-person-results={t("mention_inbox.person_results", locale)}
              data-person-loading={t("mention_inbox.person_loading", locale)}
              data-person-choose={t("mention_inbox.person_choose", locale)}
              data-person-empty={t("mention_inbox.person_empty", locale)}
              data-person-failed={t("mention_inbox.person_failed", locale)}
              data-loading={t("task_modal.reference_loading", locale)}
              data-choose={t("task_modal.reference_choose", locale)}
              data-empty={t("task_modal.reference_empty", locale)}
              data-failed={t("task_modal.reference_failed", locale)}
              data-update={t("task_modal.reference_update", locale)}
              data-too-long={t("task_modal.reference_too_long", locale)}
              data-task-label={t("task_modal.kind_task", locale)} hidden>
              <p role="status" class="px-3 py-2 text-xs text-text-muted"></p>
              <ul id="td-task-reference-results" role="listbox"
                aria-label={t("task_modal.reference_results", locale)} hidden></ul>
            </div>

            <!-- Activity Log -->
            <details class="group border-t border-border pt-6 mt-6 pb-8">
              <summary class="text-xs text-text-muted font-bold uppercase tracking-wider cursor-pointer hover:text-text-primary transition-colors flex items-center outline-none">
                <svg class="w-4 h-4 mr-1 transition-transform group-open:rotate-90" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" /></svg>
                Activity Log
              </summary>
              <div id="td-activity" class="space-y-3 mt-5 ml-5 relative before:absolute before:inset-y-0 before:left-[-11px] before:w-px before:bg-border/50 text-xs text-text-secondary"></div>
            </details>

            </div> <!-- /td-sidebar-props -->

          </aside>

        </div>
      </div>
    </div>

<script>
  import "@lib/task-modal-controller";
</script>
