---
import { isOrganizationFeatureAvailable as available } from "@lib/organization-request-context"
import HomeAssistantAreaField from "./HomeAssistantAreaField.astro"
import { organizationLabelsFor } from "@lib/organization-labels"
import { mentionInboxContext } from "@lib/mention-inbox-context"
import { verifiedIngressUser } from "@lib/verified-ingress-user"
// Task Detail Modal Component
import TaskDetailSection from "./TaskDetailSection.astro"
import TaskDetailLayoutEditor from "./TaskDetailLayoutEditor.astro"
import StrategicEvaluator from "./StrategicEvaluator.astro";
import Icon from "../ui/Icon.astro";
import { t } from "../../i18n/translations"

interface Props { suppressUrlOpen?: boolean }
const { suppressUrlOpen = false } = Astro.props

const organization = await organizationLabelsFor(Astro)
const locale = Astro.cookies.get("meitheal-locale")?.value === "ga" ? "ga" : "en"
const mentionUser = verifiedIngressUser(Astro.locals)
---
    <!-- Task Detail Centered Panel -->
    <div
      id="task-detail-overlay"
      data-suppress-url-open={suppressUrlOpen ? "true" : undefined}
      class="modal-overlay z-200"
      role="presentation"
      aria-label="Task detail"
    >
      <div
        id="task-detail-panel"
        role="dialog"
        aria-modal="true"
        aria-label="Task detail"
        class="modal-content w-full max-w-[1000px] h-[90vh] max-h-[900px] bg-bg-card border border-border shadow-2xl rounded-2xl flex flex-col overflow-hidden relative m-4 md:m-8"
      >
        <!-- Sticky Header Bar -->
        <div class="td-toolbar flex-none bg-bg-card z-20">
          <div class="td-toolbar__top">
          <div id="td-task-heading" class="invisible flex min-w-0 items-center gap-3">
            <span id="td-priority-dot" class="td-priority-dot text-lg" title="Priority">●</span>
            <div class="flex flex-col flex-1 min-w-0">
              <a href="#" id="td-parent" class="text-xs text-text-secondary hidden hover:text-accent hover:underline mb-0.5 truncate"></a>
              <div class="flex items-center gap-2 text-text-secondary">
                <span id="td-type-icon" class="flex items-center justify-center shrink-0" style="width:16px;height:16px"></span>
                <span id="td-id" class="text-xs font-mono bg-accent/10 text-accent border border-accent/20 px-2 py-0.5 rounded cursor-help"></span>
                <span id="td-created" class="text-[10px] hidden @md/task-inspector:inline"></span>
                <span class="text-border hidden @md/task-inspector:inline">•</span>
                <span id="td-updated" class="text-[10px] hidden @md/task-inspector:inline"></span>
              </div>
            </div>
          </div>
          <div class="flex gap-1.5 items-center flex-none">
            <div id="td-task-actions" hidden class="flex gap-1.5 items-center">
              <button id="td-toggle-favorite" type="button" class="p-1.5 hover:bg-bg-hover hover:text-text-primary text-text-secondary rounded transition-colors" title="Favorite" aria-label="Favorite">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 17.75l-6.172 3.245l1.179 -6.873l-5 -4.867l6.9 -1l3.086 -6.253l3.086 6.253l6.9 1l-5 4.867l1.179 6.873z" /></svg>
              </button>
              <button id="td-copy-link" type="button" class="p-1.5 hover:bg-bg-hover hover:text-text-primary text-text-secondary rounded transition-colors" title={t("task_modal.copy_link", locale)} aria-label={t("task_modal.copy_link", locale)}>
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 15l6 -6" /><path d="M11 6l.463 -.536a5 5 0 0 1 7.071 7.072l-.534 .464" /><path d="M13 18l-.397 .534a5.068 5.068 0 0 1 -7.127 0a4.972 4.972 0 0 1 0 -7.071l.524 -.463" /></svg>
              </button>
              <button id="td-duplicate" type="button" class="p-1.5 hover:bg-bg-hover hover:text-text-primary text-text-secondary rounded transition-colors" title="Duplicate" aria-label="Duplicate">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M7 7m0 2.667a2.667 2.667 0 0 1 2.667 -2.667h8.666a2.667 2.667 0 0 1 2.667 2.667v8.666a2.667 2.667 0 0 1 -2.667 2.667h-8.666a2.667 2.667 0 0 1 -2.667 -2.667z" /><path d="M4.012 16.737a2.005 2.005 0 0 1 -1.012 -1.737v-10c0 -1.1 .9 -2 2 -2h10c.75 0 1.158 .385 1.5 1" /></svg>
              </button>
              <button id="td-ask-ai" type="button" class="p-1.5 hover:bg-bg-hover hover:text-accent text-text-secondary rounded transition-colors" title="Ask AI" aria-label="Ask AI">
                <Icon name="message-chatbot" size={20} sprite={true} />
              </button>
              <button id="td-delete" type="button" class="p-1.5 hover:bg-bg-hover hover:text-red-400 text-text-secondary rounded transition-colors" title="Delete Task" aria-label="Delete Task">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 7l16 0" /><path d="M10 11l0 6" /><path d="M14 11l0 6" /><path d="M5 7l1 12a2 2 0 0 0 2 2h8a2 2 0 0 0 2 -2l1 -12" /><path d="M9 7v-3a1 1 0 0 1 1 -1h4a1 1 0 0 1 1 1v3" /></svg>
              </button>
              <div class="w-px h-5 bg-border mx-1"></div>
            </div>
            <button id="td-close" type="button" class="p-1.5 hover:bg-bg-hover hover:text-text-primary text-text-secondary rounded transition-colors" aria-label="Close detail" title="Close">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M18 6l-12 12" /><path d="M6 6l12 12" /></svg>
            </button>
          </div>
          </div>
          <div class="td-toolbar__controls" data-td-loaded-actions hidden>
            <div class="td-toolbar__view">
              <button id="td-toggle-focus" type="button" class="btn btn-secondary"
                data-enter-label={t("task_layout.focus", locale)} data-exit-label={t("task_layout.exit_focus", locale)}>
                <Icon name="arrows-maximize" size={16} class="td-focus-enter-icon" />
                <Icon name="arrows-minimize" size={16} class="td-focus-exit-icon" />
                <span>{t("task_layout.focus", locale)}</span>
              </button>
              <button id="td-toggle-layout" type="button" class="td-layout-icon-btn" aria-expanded="false"
                aria-controls="td-layout-panel" aria-label={t("task_layout.layout", locale)} title={t("task_layout.layout", locale)}>
                <Icon name="adjustments-horizontal" size={19} />
              </button>
            </div>
            <button id="td-toggle-done" type="button" class="btn btn-primary td-done-btn">Mark as Done</button>
          </div>
        </div>

        <!-- Progress bar -->
        <div id="td-progress-bar-container" class="w-full h-1 bg-bg-input hidden">
          <div id="td-progress-bar-fill" class="h-full bg-accent transition-[width] duration-300" style="width: 0%"></div>
        </div>

        <div id="td-skeleton" class="td-reading-column w-full space-y-5" aria-hidden="true">
          <div class="td-skeleton-line h-9 w-3/4 rounded-lg"></div>
          <div class="td-skeleton-line h-4 w-5/6 rounded"></div>
          <div class="td-skeleton-line h-4 w-2/3 rounded"></div>
          <div class="td-skeleton-line h-24 w-full rounded-lg"></div>
          <div class="td-skeleton-line h-14 w-full rounded-lg"></div>
        </div>

        <p
          id="td-load-error"
          hidden
          role="alert"
          data-unavailable={t("task_modal.link_unavailable", locale)}
          data-failed={t("task_modal.link_load_failed", locale)}
          class="px-6 py-6 text-text-primary"
        ></p>

        <div id="td-loaded-content" class="td-scroller hidden">
          <div class="td-reading-column">
            <div id="td-layout-panel" hidden>
              <h2 class="td-layout-title">{t("task_layout.layout", locale)}</h2>
              <TaskDetailLayoutEditor locale={locale} />
            </div>
            <div class="td-task-actions flex flex-wrap items-center gap-2">
              <button id="td-pin-action" type="button" aria-pressed="false"
                class="inline-flex items-center gap-2 min-h-11 rounded border border-border bg-bg-card px-3 text-sm font-medium text-text-primary hover:bg-bg-hover aria-pressed:border-accent aria-pressed:bg-accent/10 aria-pressed:text-accent" hidden>
                <Icon name="pin" size={16} />
                <span>{t("pins.pin", locale)}</span>
              </button>
              <button id="td-pin-refresh" type="button" class="min-h-11 rounded border border-border bg-bg-card px-3 text-sm font-medium text-text-primary hover:bg-bg-hover" hidden>
                {t("pins.refresh", locale)}
              </button>
              <p id="td-pin-status" role="status" aria-atomic="true" class="text-sm text-text-secondary" hidden></p>
              <span id="td-deferred-badge" class="rounded bg-accent/10 px-2 py-1 text-sm text-accent" hidden>{t("deferral.title", locale)}</span>
              <button id="td-deferral-action" type="button" class="min-h-11 rounded border border-border bg-bg-card px-3 text-sm font-medium text-text-primary hover:bg-bg-hover"
                data-defer-label={t("deferral.defer", locale)} data-resume-label={t("deferral.resume", locale)} hidden></button>
              <button id="td-deferral-refresh" type="button" class="min-h-11 rounded border border-border bg-bg-card px-3 text-sm font-medium text-text-primary hover:bg-bg-hover" hidden>
                {t("deferral.refresh_task", locale)}
              </button>
              <p id="td-deferral-status" role="status" aria-atomic="true" class="text-sm text-text-secondary" hidden></p>
              <label id="td-copy-link-fallback" hidden class="w-full space-y-2 text-sm text-text-primary">
                <span class="block">{t("task_modal.copy_link_manually", locale)}</span>
                <input type="url" id="td-copy-link-value" class="form-input w-full" readonly />
              </label>
              <div id="td-task-reactions"></div>
            </div>
            <!-- Title -->
            <div class="td-title-row">
              <textarea
                id="td-title"
                aria-label={t("tasks.title_label", locale)}
                class="w-full bg-transparent border border-transparent hover:bg-bg-hover focus:bg-bg-input focus:border-border focus:ring-1 focus:ring-accent td-title font-bold py-2 px-2 rounded-lg transition-colors leading-tight resize-none text-text-primary overflow-hidden min-h-[56px]"
                rows="1"
                placeholder="Task title"
              ></textarea>
            </div>

            <div id="td-sections" data-layout-order="sections">
            <TaskDetailSection name="description">
              <div class="td-description-view">
                <div class="td-description-view__actions">
                  <button id="td-desc-edit-btn-hover" class="btn btn-secondary" type="button">
                    <Icon name="pencil" size={15} />
                    {t("task_layout.edit_description", locale)}
                  </button>
                  <span id="td-desc-saved" class="text-accent text-xs" style="display:none;" role="status">Saved</span>
                </div>
                <div id="td-desc-preview-container" class="prose prose-sm dark:prose-invert max-w-none wrap-break-word p-2 rounded-lg hover:bg-bg-hover border border-transparent transition-colors cursor-text min-h-[60px] text-base">
                  <div id="td-desc-preview"></div>
                </div>
              </div>
              <div id="td-desc-edit-container" class="hidden">
                <div class="relative">
                  <textarea
                    id="td-description"
                    class="form-input min-h-[160px] resize-y text-sm w-full focus:ring-1 focus:ring-accent font-mono leading-relaxed"
                    placeholder="Add a detailed description (Markdown supported)..."
                    aria-label={t("tasks.description", locale)}
                    aria-describedby="td-desc-reference-hint"
                    aria-autocomplete="list"
                    data-task-reference
                    maxlength="10000"
                  ></textarea>
                </div>
                <p id="td-desc-reference-hint" class="text-xs text-text-muted">{t("task_modal.reference_hint", locale)}</p>
                <div class="flex justify-end mt-2 gap-2">
                    <button id="td-desc-cancel-btn" class="btn text-xs px-3 py-1.5 border border-border text-text-secondary hover:text-text-primary hover:bg-bg-hover transition-colors" type="button">Cancel</button>
                    <button id="td-desc-save-btn" class="btn btn-primary text-xs px-3 py-1.5 shadow-sm" type="button"
                      data-save={t("settings.save", locale)} data-saving={t("task_layout.saving", locale)}>{t("settings.save", locale)}</button>
                </div>
              </div>
            </TaskDetailSection>

            <TaskDetailSection name="properties">
                <div class="td-fields" data-layout-order="properties">

                  <div class="grid grid-cols-[100px_minmax(0,1fr)] items-center gap-2 min-w-0" data-layout-item="status">
                    <label for="td-status" class="text-xs text-text-secondary font-medium truncate">Status</label>
                    <select id="td-status" class="form-select py-1.5 px-2 bg-bg-card hover:bg-bg-hover border border-border cursor-pointer transition-colors focus:ring-1 focus:ring-accent font-medium text-text-primary w-full min-w-0">
                      <option value="backlog">Backlog</option>
                      <option value="pending">Pending</option>
                      <option value="active">Active</option>
                      <option value="complete">Complete</option>
                    </select>
                  </div>

                  <div class="grid grid-cols-[100px_minmax(0,1fr)] items-center gap-2 min-w-0" data-layout-item="type">
                    <label for="td-task-type" class="text-xs text-text-secondary font-medium truncate">Type</label>
                    <select id="td-task-type" class="form-select py-1.5 px-2 bg-bg-card hover:bg-bg-hover border border-border cursor-pointer transition-colors focus:ring-1 focus:ring-accent font-medium text-text-primary w-full min-w-0">
                      <option value="task">Task</option>
                      <option value="story">Story</option>
                      <option value="epic">Epic</option>
                    </select>
                  </div>

                  <div class="grid grid-cols-[100px_minmax(0,1fr)] items-center gap-2 min-w-0" data-layout-item="priority">
                    <label for="td-priority" class="text-xs text-text-secondary font-medium truncate">Priority</label>
                    <select id="td-priority" class="form-select py-1.5 px-2 bg-bg-card hover:bg-bg-hover border border-border cursor-pointer transition-colors focus:ring-1 focus:ring-accent font-medium text-text-primary w-full min-w-0">
                      <option value="1">Urgent</option>
                      <option value="2">High</option>
                      <option value="3">Medium</option>
                      <option value="4">Low</option>
                      <option value="5">Minimal</option>
                    </select>
                  </div>

                  <div class="grid grid-cols-[100px_minmax(0,1fr)] items-center gap-2 min-w-0" data-layout-item="urgency">
                    <label for="td-urgency" class="text-xs text-text-secondary font-medium flex items-center gap-1.5 truncate" title="Eisenhower Matrix dimension">
                      <Icon name="bolt" size={13} sprite={true} />
                      Urgency
                    </label>
                    <select id="td-urgency" class="form-select py-1.5 px-2 bg-bg-card hover:bg-bg-hover border border-border cursor-pointer transition-colors focus:ring-1 focus:ring-accent font-medium text-text-primary w-full min-w-0">
                      <option value="0">0 — Unset</option>
                      <option value="1">1 — Low</option>
                      <option value="2">2</option>
                      <option value="3">3 — Medium</option>
                      <option value="4">4</option>
                      <option value="5">5 — Critical</option>
                    </select>
                  </div>

                  <div class="grid grid-cols-[100px_minmax(0,1fr)] items-center gap-2 min-w-0" data-layout-item="importance">
                    <label for="td-importance" class="text-xs text-text-secondary font-medium flex items-center gap-1.5 truncate" title="Eisenhower Matrix dimension">
                      <Icon name="star" size={13} sprite={true} />
                      Importance
                    </label>
                    <select id="td-importance" class="form-select py-1.5 px-2 bg-bg-card hover:bg-bg-hover border border-border cursor-pointer transition-colors focus:ring-1 focus:ring-accent font-medium text-text-primary w-full min-w-0">
                      <option value="0">0 — Unset</option>
                      <option value="1">1 — Low</option>
                      <option value="2">2</option>
                      <option value="3">3 — Medium</option>
                      <option value="4">4</option>
                      <option value="5">5 — Critical</option>
                    </select>
                  </div>

                  <div class="grid grid-cols-[100px_minmax(0,1fr)] items-center gap-2 min-w-0" data-layout-item="assignee">
                    <label for="td-assigned-to" class="text-xs text-text-secondary font-medium truncate">Assignee</label>
                    <select id="td-assigned-to" class="form-select py-1.5 px-2 bg-bg-card hover:bg-bg-hover border border-border cursor-pointer transition-colors focus:ring-1 focus:ring-accent font-medium text-text-primary w-full min-w-0">
                      <option value="">Unassigned</option>
                    </select>
                  </div>

                  {available("groups") && <div class="grid grid-cols-[100px_minmax(0,1fr)] items-center gap-2 min-w-0" data-layout-item="area">
                    <label for="td-area" class="text-xs text-text-secondary font-medium truncate">{organization("group")}</label>
                    <select id="td-area" disabled class="form-select py-1.5 px-2 bg-bg-card hover:bg-bg-hover border border-border cursor-pointer transition-colors focus:ring-1 focus:ring-accent font-medium text-text-primary w-full min-w-0"></select>
                  </div>}

                  <HomeAssistantAreaField mode="edit" layoutItem="home-assistant-area" />

                  {available("projects") && <div class="grid grid-cols-[100px_minmax(0,1fr)] items-center gap-2 min-w-0" data-layout-item="project">
                    <label for="td-project" class="text-xs text-text-secondary font-medium truncate">{organization("project")}</label>
                    <select id="td-project" disabled class="form-select py-1.5 px-2 bg-bg-card hover:bg-bg-hover border border-border cursor-pointer transition-colors focus:ring-1 focus:ring-accent font-medium text-text-primary w-full min-w-0">
                      <option value="">No project</option>
                    </select>
                  </div>}

                  {available("pillars") && <div class="grid grid-cols-[100px_minmax(0,1fr)] items-center gap-2 min-w-0" data-layout-item="pillar">
                    <label for="td-pillar" class="text-xs text-text-secondary font-medium flex items-center gap-1.5 truncate" title="Pillar">
                      <Icon name="target" size={13} sprite={true} />
                      {organization("pillar")}
                    </label>
                    <select id="td-pillar" class="form-select py-1.5 px-2 bg-bg-card hover:bg-bg-hover border border-border cursor-pointer transition-colors focus:ring-1 focus:ring-accent font-medium text-text-primary w-full min-w-0">
                      <option value="">No pillar</option>
                    </select>
                  </div>}

                  {available("principles") && <div class="grid grid-cols-[100px_minmax(0,1fr)] items-center gap-2 min-w-0" data-layout-item="principle">
                    <label for="td-principle" class="text-xs text-text-secondary font-medium flex items-center gap-1.5 truncate" title="Principle">
                      <Icon name="book" size={13} sprite={true} />
                      {organization("principle")}
                    </label>
                    <select id="td-principle" class="form-select py-1.5 px-2 bg-bg-card hover:bg-bg-hover border border-border cursor-pointer transition-colors focus:ring-1 focus:ring-accent font-medium text-text-primary w-full min-w-0">
                      <option value="">No principle</option>
                    </select>
                  </div>}

                </div>
              </TaskDetailSection>

            <TaskDetailSection name="scheduling">
                <div class="td-fields" data-layout-order="scheduling">

                    <div class="grid grid-cols-[100px_minmax(0,1fr)] items-center gap-2 min-w-0" data-layout-item="due">
                      <label for="td-due-date" class="text-xs text-text-secondary">Due</label>
                      <input id="td-due-date" aria-describedby="td-routine-date-hint" type="date" class="form-input text-xs py-1.5 bg-bg-card hover:bg-bg-hover border border-border transition-colors w-full min-w-0 cursor-pointer" />
                    </div>


                    <div class="grid grid-cols-[100px_minmax(0,1fr)] items-center gap-2 min-w-0" data-layout-item="progress">
                      <label for="td-progress" class="text-xs text-text-secondary">Progress</label>
                      <div class="flex items-center gap-2 px-2 h-8 bg-bg-card rounded border border-border min-w-0">
                        <input id="td-progress" type="range" min="0" max="100" class="flex-1 accent-accent h-1.5 bg-bg-input rounded-lg cursor-pointer appearance-none" />
                        <span id="td-progress-value" class="text-xs font-mono text-text-primary w-8 text-right font-medium">0%</span>
                      </div>
                    </div>

                    <div class="grid grid-cols-[100px_minmax(0,1fr)] items-center gap-2 min-w-0" data-layout-item="tracked">
                      <label for="td-time-tracked" class="text-xs text-text-secondary">Tracked (min)</label>
                      <input id="td-time-tracked" type="number" min="0" step="1" class="form-input text-xs py-1.5 bg-bg-card hover:bg-bg-hover border border-border transition-colors w-full min-w-0 font-mono placeholder-text-muted" placeholder="0" />
                    </div>
                  <div class="grid grid-cols-[100px_minmax(0,1fr)] items-center gap-2 min-w-0" data-layout-item="recurrence">
                    <label for="td-recurrence" class="text-xs text-text-secondary font-medium">Recurrence Pattern</label>
                    <select id="td-recurrence" class="form-select text-xs py-1.5 px-2 bg-bg-card hover:border-border-focus border border-border transition-colors w-full min-w-0 cursor-pointer font-medium">
                      <option value="">None (One-time)</option>
                      <option value="FREQ=DAILY">Every day</option>
                      <option value="FREQ=WEEKLY">Every week</option>
                      <option value="FREQ=WEEKLY;BYDAY=MO,TU,WE,TH,FR">Every weekday</option>
                      <option value="FREQ=MONTHLY">Every month</option>
                      <option value="FREQ=YEARLY">Every year</option>
                    </select>
                    <span id="td-recurrence-desc" class="col-start-2 text-xs text-text-secondary hidden"></span>
                  </div>

                  <div class="grid grid-cols-[100px_minmax(0,1fr)] items-center gap-2 min-w-0" data-layout-item="reminder">
                    <label for="td-reminder" class="text-xs text-text-secondary font-medium">Reminder Time</label>
                    <input id="td-reminder" type="datetime-local" class="form-input text-xs py-1.5 bg-bg-card hover:border-border-focus border border-border transition-colors w-full min-w-0 cursor-pointer" />
                  </div>
                </div>

                    <p id="td-routine-date-hint" class="text-xs text-text-secondary" hidden>A generated Routine task keeps its original date.</p>
                    <!-- Hidden structural compat -->
                    <input id="td-start-date" type="date" class="hidden" />
                    <input id="td-end-date" type="date" class="hidden" />
              </TaskDetailSection>

            <TaskDetailSection name="metadata">
                <div class="td-fields td-fields--grouped" data-layout-order="metadata">

                  <div class="min-w-0" data-layout-item="labels">
                    <div class="flex items-center justify-between mb-2">
                      <label for="td-label-input" class="text-xs text-text-secondary font-medium">Labels</label>
                    </div>
                    <div id="td-labels" class="flex flex-wrap gap-1.5 mb-2 min-h-[24px]"></div>
                    <input id="td-label-input" class="form-input text-xs py-1.5 bg-bg-card border border-border hover:border-border-focus w-full transition-colors" placeholder="Add label (press enter)..." autocomplete="off" />
                  </div>

                  <div class="min-w-0" data-layout-item="color">
                    <label for="td-color" class="text-xs text-text-secondary font-medium mb-2 block">Task Color</label>
                    <input id="td-color" type="color" class="w-11 h-9 rounded cursor-pointer border border-border bg-transparent p-1" />
                  </div>

                  <div class="min-w-0" data-layout-item="custom-fields">
                    <span class="text-xs text-text-secondary font-medium mb-2 block">Custom Fields</span>
                    <div id="td-custom-fields" class="space-y-2 mb-2"></div>
                    <div class="relative">
                      <button id="td-add-cf" type="button" class="text-xs text-text-secondary px-3 py-1.5 rounded bg-bg-card hover:bg-bg-hover border border-border transition-colors w-full text-left flex items-center gap-2">
                        <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><line x1="12" y1="5" x2="12" y2="19"></line><line x1="5" y1="12" x2="19" y2="12"></line></svg>
                        Add Field
                      </button>
                      <div id="td-add-cf-dropdown" class="absolute z-10 w-full mt-1 bg-bg-card border border-border rounded-md shadow-lg py-1" style="display:none;">
                        <div class="px-2 py-1">
                          <input id="td-add-cf-search" class="form-input text-xs py-1.5 w-full bg-bg-input" placeholder="Search fields..." autocomplete="off" />
                        </div>
                        <div id="td-add-cf-options" class="max-h-32 overflow-y-auto mt-1"></div>
                      </div>
                    </div>
                  </div>
                </div>
              </TaskDetailSection>

            <TaskDetailSection name="scoring"><StrategicEvaluator embedded /></TaskDetailSection>

            <TaskDetailSection name="checklists">
              <div class="flex items-center justify-between mb-2">
                <button type="button" id="td-add-checklist-item" class="text-xs text-accent hover:text-accent-hover transition-colors font-medium flex items-center gap-1">
                    <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"><line x1="12" y1="5" x2="12" y2="19"></line><line x1="5" y1="12" x2="19" y2="12"></line></svg>
                    <span>Add Item</span>
                </button>
              </div>
              <div id="td-checklist-progress" class="text-[10px] text-text-muted mb-3 flex items-center justify-between" style="display:none;">
                  <div class="w-full mr-3 h-1.5 bg-bg-card rounded-full overflow-hidden border border-border">
                    <div id="td-checklist-progress-bar" class="h-full bg-accent transition-[width] duration-300" style="width:0%"></div>
                  </div>
                  <span class="whitespace-nowrap"><span id="td-checklist-done">0</span>/<span id="td-checklist-total">0</span></span>
              </div>
              <div id="td-checklists" class="space-y-1"></div>
              <p id="td-checklist-message" role="status" class="text-sm text-text-primary mt-2"></p>
              <button type="button" id="td-checklist-recover" class="btn text-xs px-3 py-1.5 mt-2" hidden></button>
              <details id="td-checklist-draft" class="text-sm text-text-primary mt-2" hidden>
                <summary>Your unsaved checklist draft</summary>
                <ol class="list-decimal pl-5 wrap-break-word"></ol>
              </details>
            </TaskDetailSection>

            <TaskDetailSection name="attachments">
              <div class="flex items-center justify-between mb-2">
                <label class="text-xs text-accent hover:text-accent-hover cursor-pointer m-0 font-medium flex items-center gap-1">
                  <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
                  Add Image
                  <input type="file" id="td-attachment-input" accept="image/*" class="hidden" />
                </label>
              </div>
              <div id="td-attachments" class="flex flex-wrap gap-3 mt-2"></div>
            </TaskDetailSection>

            <TaskDetailSection name="relationships">
              <div class="space-y-5">
                <div class="grid grid-cols-1 @3xl/task-inspector:grid-cols-2 gap-6">
                  <!-- Parent -->
                  <div>
                    <span class="text-xs text-text-muted font-bold uppercase tracking-wider mb-2 block">Parent Epic/Story</span>
                    <div id="td-link-parent-display" class="flex items-center gap-1 mb-2">
                      <span class="text-xs text-text-muted italic">None</span>
                    </div>
                    <div class="relative">
                      <input id="td-link-parent-search" class="form-input text-sm py-1.5 w-full bg-bg-input hover:border-border transition-colors" placeholder="Search for parent..."/>
                      <div id="td-link-parent-results" class="absolute z-10 left-0 right-0 top-full mt-1 bg-bg-card border border-border rounded-md shadow-lg max-h-40 overflow-y-auto" style="display:none;"></div>
                    </div>
                  </div>
                  <!-- Children -->
                  <div>
                    <span class="text-xs text-text-muted font-bold uppercase tracking-wider mb-2 block">Child Subtasks</span>
                    <div id="td-link-children" class="space-y-1.5 mb-2"></div>
                    <div id="td-subtask-progress" class="hidden mb-3">
                      <div class="flex items-center justify-between text-xs text-text-secondary mb-1">
                        <span id="td-subtask-progress-label">0/0</span>
                      </div>
                      <div class="w-full h-1.5 bg-bg-input rounded-full overflow-hidden border border-border/50">
                        <div id="td-subtask-progress-bar" class="h-full bg-accent transition-[width] duration-300 rounded-full" style="width:0%"></div>
                      </div>
                    </div>
                    <div id="td-add-subtask">
                      <button type="button" id="td-add-subtask-btn" class="text-xs text-accent hover:text-accent-hover flex items-center gap-1 font-medium transition-colors">
                        <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
                        Add subtask
                      </button>
                      <div id="td-add-subtask-form" class="hidden mt-2 gap-2">
                        <input id="td-add-subtask-input" class="form-input text-sm py-1.5 flex-1 bg-bg-input" placeholder="Subtask title..." autocomplete="off"/>
                        <button type="button" id="td-add-subtask-submit" class="btn btn-primary text-xs px-3 py-1.5 shadow-sm">Add</button>
                        <button type="button" id="td-add-subtask-cancel" aria-label="Cancel subtask" class="btn bg-bg-input border border-border hover:bg-bg-hover text-text-primary text-xs px-2 py-1.5"><Icon name="x" size={14} sprite={true} /></button>
                      </div>
                    </div>
                  </div>
                </div>

                <div class="h-px bg-border w-full"></div>
                
                <!-- Related Links -->
                <div>
                  <span class="text-xs text-text-muted font-bold uppercase tracking-wider mb-2 block">
                    <span>Related Links <span id="td-link-count" class="text-text-muted opacity-70 ml-1"></span></span>
                  </span>
                  <div id="td-related-links" class="space-y-1.5 mb-3">
                    <div id="td-links-empty" class="text-xs text-text-muted italic py-1">No related links. Use the search to link tasks.</div>
                  </div>
                  <div id="td-link-live" aria-live="polite" class="sr-only"></div>
                  <div class="flex flex-col gap-2">
                    <select id="td-link-type-select" aria-label={t("task_layout.relationship_type", locale)} class="form-select text-sm py-1.5 bg-bg-input w-full shrink-0">
                      <option value="related_to">Related to</option>
                      <option value="blocked_by">Blocked by</option>
                      <option value="blocks">Blocks</option>
                      <option value="duplicates">Duplicates</option>
                      <option value="duplicated_by">Duplicated by</option>
                    </select>
                    <div class="relative w-full">
                      <input id="td-link-search" class="form-input text-sm py-1.5 w-full bg-bg-input hover:border-border transition-colors" placeholder="Search task to link…"/>
                      <div id="td-link-search-results" class="absolute z-50 left-0 top-full mt-1 right-0 bg-bg-card border border-border rounded-md shadow-lg max-h-40 overflow-y-auto" style="display:none;"></div>
                    </div>
                  </div>
                </div>
              </div>
            </TaskDetailSection>

            <TaskDetailSection name="comments">
              <p id="td-comment-link-status" tabindex="-1" role="status"
                class="text-sm text-text-primary [&:not(:empty)]:mb-3 focus:outline-2 focus:outline-accent"
