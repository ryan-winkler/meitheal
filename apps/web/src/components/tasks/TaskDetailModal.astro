                    </div>
                    <div class="relative">
                      <input id="td-link-parent-search" aria-label="Search for parent task" class="form-input text-sm py-1.5 w-full bg-bg-input hover:border-border transition-colors" placeholder="Search for parent..."/>
                      <div id="td-link-parent-results" class="absolute z-10 left-0 right-0 top-full mt-1 bg-bg-card border border-border rounded-md shadow-lg max-h-40 overflow-y-auto" style="display:none;"></div>
                    </div>
                  </div>
                  <!-- Children -->
