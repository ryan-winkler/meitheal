---
/**
 * AchievementsTab — Inline Gamification/Achievements for Progress & Growth shell
 *
 * Extracted from gamification.astro for embedding inside progress.astro.
 * Self-contained: fetches its own data via SSR.
 *
 * @domain gamification
 * @phase 18 — Progress & Growth Unification
 */
import GamificationWidget from "../gamification/GamificationWidget.astro"
import {
  getStats,
  getWeeklyData,
  getLevel,
  getProgressToNextLevel,
  getXpToNextLevel,
  getXpForLevel,
  getAllAchievements,
  getYearlyHeatmapData,
  ensureGamificationSchema,
} from "@domains/gamification"
import { isFeatureEnabled } from "../../lib/feature-flags"

const gamificationEnabled = await isFeatureEnabled("gamification")

// Ensure schema exists
try {
  if (gamificationEnabled) await ensureGamificationSchema()
} catch { /* DB not available */ }

// Fetch all data
let stats = {
  currentStreak: 0,
  longestStreak: 0,
  todayCompleted: 0,
  totalCompleted: 0,
  totalPoints: 0,
}
let weekly: Awaited<ReturnType<typeof getWeeklyData>> = []
let achievementData = { achievements: [] as any[], total: 0, unlocked: 0 }
let heatmapData: { date: string; count: number }[] = []

try {
  if (gamificationEnabled) {
    [stats, weekly, achievementData] = await Promise.all([
      getStats(),
      getWeeklyData(),
      getAllAchievements(),
    ])
    heatmapData = await getYearlyHeatmapData()
  }
} catch { /* graceful fallback */ }

const level = getLevel(stats.totalPoints)
const progress = getProgressToNextLevel(stats.totalPoints)
const xpToNext = getXpToNextLevel(stats.totalPoints)
const currentXp = stats.totalPoints - getXpForLevel(level)
const nextLevelXp = getXpForLevel(level + 1) - getXpForLevel(level)
const circumference = 2 * Math.PI * 54
const dashOffset = circumference * (1 - progress)

// Heatmap helpers
const today = new Date()
const currentYear = today.getFullYear()
const maxCount = Math.max(...heatmapData.map((d) => d.count), 1)

function heatmapColor(count: number): string {
  if (count === 0) return "var(--bg-hover, #1e293b)"
  const intensity = Math.min(count / maxCount, 1)
  if (intensity < 0.25) return "hsl(250 60% 30%)"
  if (intensity < 0.5) return "hsl(250 70% 40%)"
  if (intensity < 0.75) return "hsl(250 80% 50%)"
  return "hsl(250 90% 60%)"
}

const categories = [
  { key: "milestone", label: "Milestones", icon: "🎯" },
  { key: "streak", label: "Streaks", icon: "🔥" },
  { key: "xp", label: "XP Earned", icon: "⭐" },
  { key: "special", label: "Special", icon: "✨" },
] as const
---

{!gamificationEnabled ? (
  <div class="achievements-tab__disabled">
    <div class="achievements-tab__disabled-icon">🏆</div>
    <h2>Gamification is disabled</h2>
    <p>Enable the gamification feature flag in Settings to track achievements, XP, and streaks.</p>
  </div>
) : (
  <div class="achievements-tab" id="achievements-tab-root">
    <!-- Level Card -->
    <section class="achievements-tab__level-card">
      <div class="achievements-tab__level-ring-wrapper">
        <svg viewBox="0 0 120 120" class="achievements-tab__level-ring" aria-hidden="true">
          <circle cx="60" cy="60" r="54" class="achievements-tab__ring-bg" />
          <circle
            cx="60" cy="60" r="54"
            class="achievements-tab__ring-fill"
            style={`stroke-dasharray: ${circumference}; stroke-dashoffset: ${dashOffset};`}
          />
        </svg>
        <div class="achievements-tab__ring-content">
          <span class="achievements-tab__level-number">{level}</span>
          <span class="achievements-tab__level-label">Level</span>
        </div>
      </div>
      <div class="achievements-tab__level-info">
        <div class="achievements-tab__xp-bar">
          <div class="achievements-tab__xp-bar-fill" style={`width: ${progress * 100}%;`}></div>
        </div>
        <div class="achievements-tab__xp-text">
          <span>{currentXp} / {nextLevelXp} XP</span>
          <span style="color: var(--text-muted);">{xpToNext} to Level {level + 1}</span>
        </div>
      </div>
    </section>

    <!-- Stats Grid -->
    <section class="achievements-tab__stats-grid">
      <div class="achievements-tab__stat-card">
        <span class="achievements-tab__stat-icon">⭐</span>
        <span class="achievements-tab__stat-value">{stats.totalPoints.toLocaleString()}</span>
        <span class="achievements-tab__stat-label">Total XP</span>
      </div>
      <div class="achievements-tab__stat-card">
        <span class="achievements-tab__stat-icon">✅</span>
        <span class="achievements-tab__stat-value">{stats.totalCompleted.toLocaleString()}</span>
        <span class="achievements-tab__stat-label">Tasks Completed</span>
      </div>
      <div class="achievements-tab__stat-card">
        <span class="achievements-tab__stat-icon">🔥</span>
        <span class="achievements-tab__stat-value">{stats.currentStreak}</span>
        <span class="achievements-tab__stat-label">Current Streak</span>
      </div>
      <div class="achievements-tab__stat-card">
        <span class="achievements-tab__stat-icon">🏆</span>
        <span class="achievements-tab__stat-value">{stats.longestStreak}</span>
        <span class="achievements-tab__stat-label">Best Streak</span>
      </div>
      <div class="achievements-tab__stat-card">
        <span class="achievements-tab__stat-icon">🎖️</span>
        <span class="achievements-tab__stat-value">{achievementData.unlocked} / {achievementData.total}</span>
        <span class="achievements-tab__stat-label">Achievements</span>
      </div>
      <div class="achievements-tab__stat-card">
        <span class="achievements-tab__stat-icon">📅</span>
        <span class="achievements-tab__stat-value">{stats.todayCompleted}</span>
        <span class="achievements-tab__stat-label">Today</span>
      </div>
    </section>

    <!-- Weekly Progress -->
    <section class="achievements-tab__section">
      <GamificationWidget stats={stats} weekly={weekly} />
    </section>

    <!-- Activity Heatmap -->
    {heatmapData.length > 0 && (
      <section class="achievements-tab__section">
        <h2 class="achievements-tab__section-title">📊 Activity Heatmap — {currentYear}</h2>
        <div class="achievements-tab__heatmap-container">
          <div class="achievements-tab__heatmap">
            {heatmapData.map((day) => (
              <div
                class="achievements-tab__heatmap-cell"
                style={`background: ${heatmapColor(day.count)};`}
                title={`${day.date}: ${day.count} task${day.count !== 1 ? "s" : ""}`}
              />
            ))}
          </div>
          <div class="achievements-tab__heatmap-legend">
            <span style="font-size: 0.75rem; color: var(--text-muted);">Less</span>
            <div class="achievements-tab__heatmap-cell" style="background: var(--bg-hover, #1e293b);" />
            <div class="achievements-tab__heatmap-cell" style="background: hsl(250 60% 30%);" />
            <div class="achievements-tab__heatmap-cell" style="background: hsl(250 70% 40%);" />
            <div class="achievements-tab__heatmap-cell" style="background: hsl(250 80% 50%);" />
            <div class="achievements-tab__heatmap-cell" style="background: hsl(250 90% 60%);" />
            <span style="font-size: 0.75rem; color: var(--text-muted);">More</span>
          </div>
        </div>
      </section>
    )}

    <!-- Achievement Gallery -->
    <section class="achievements-tab__section">
      <h2 class="achievements-tab__section-title">
        🏅 Achievements
        <span class="achievements-tab__section-count">{achievementData.unlocked} / {achievementData.total}</span>
      </h2>
      {categories.map(({ key, label, icon }) => {
        const categoryAchievements = achievementData.achievements.filter(
          (a: any) => a.category === key
        )
        if (categoryAchievements.length === 0) return null
        return (
          <div class="achievements-tab__category">
            <h3 class="achievements-tab__category-title">{icon} {label}</h3>
            <div class="achievements-tab__achievement-grid">
              {categoryAchievements.map((a: any) => (
                <div class={`achievements-tab__achievement-card ${a.unlockedAt ? "achievements-tab__achievement-card--unlocked" : ""}`}>
                  <span class="achievements-tab__achievement-icon">{a.icon}</span>
                  <div class="achievements-tab__achievement-info">
                    <span class="achievements-tab__achievement-name">{a.name}</span>
                    <span class="achievements-tab__achievement-desc">{a.description}</span>
                    {a.unlockedAt && (
                      <span class="achievements-tab__achievement-date">
                        ✓ {new Date(a.unlockedAt).toLocaleDateString("en", { month: "short", day: "numeric", year: "numeric" })}
                      </span>
                    )}
                  </div>
                </div>
              ))}
            </div>
          </div>
        )
      })}
    </section>
  </div>
)}

<style>
  @reference "../../styles/global.css";

  .achievements-tab {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
    padding: 0.5rem 0;
    max-width: 1000px;
  }

  .achievements-tab__disabled {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding: 4rem 2rem;
    text-align: center;
    border: 2px dashed var(--border);
    border-radius: var(--radius-lg, 12px);
    color: var(--text-muted);
  }
  .achievements-tab__disabled-icon { font-size: 48px; margin-bottom: 1rem; opacity: 0.6; }

  /* Level Card */
  .achievements-tab__level-card {
    display: flex;
    align-items: center;
    gap: 2rem;
    padding: 1.5rem 2rem;
    background: linear-gradient(135deg, var(--bg-card, #1a1a2e) 0%, hsl(250 30% 15%) 100%);
    border-radius: 16px;
    border: 1px solid var(--border, #334155);
  }
  .achievements-tab__level-ring-wrapper {
    position: relative;
    width: 120px;
    height: 120px;
    flex-shrink: 0;
  }
  .achievements-tab__level-ring {
    width: 100%;
    height: 100%;
    transform: rotate(-90deg);
  }
  .achievements-tab__ring-bg {
    fill: none;
    stroke: var(--border, #334155);
    stroke-width: 6;
  }
  .achievements-tab__ring-fill {
    fill: none;
    stroke: var(--accent, #6366f1);
    stroke-width: 6;
    stroke-linecap: round;
    transition: stroke-dashoffset 0.8s ease;
    filter: drop-shadow(0 0 6px var(--accent, #6366f1));
  }
  .achievements-tab__ring-content {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    text-align: center;
    line-height: 1;
  }
  .achievements-tab__level-number {
    font-size: 2.5rem;
    font-weight: 800;
    color: var(--text-primary, #e0e0e0);
    font-variant-numeric: tabular-nums;
    display: block;
  }
  .achievements-tab__level-label {
    font-size: 0.75rem;
    color: var(--text-muted, #888);
    text-transform: uppercase;
    letter-spacing: 0.1em;
    margin-top: 0.125rem;
  }
  .achievements-tab__level-info {
    flex: 1;
    min-width: 0;
  }
  .achievements-tab__xp-bar {
    height: 8px;
    background: var(--bg-hover, #1e293b);
    border-radius: 4px;
    overflow: hidden;
    margin-bottom: 0.5rem;
  }
  .achievements-tab__xp-bar-fill {
    height: 100%;
    background: linear-gradient(90deg, var(--accent, #6366f1), hsl(250 80% 70%));
    border-radius: 4px;
    transition: width 0.6s ease;
    min-width: 2px;
  }
  .achievements-tab__xp-text {
    display: flex;
    justify-content: space-between;
    font-size: 0.8125rem;
    color: var(--text-secondary, #a0a0a0);
  }

  /* Stats Grid */
  .achievements-tab__stats-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(140px, 1fr));
    gap: 0.75rem;
  }
  .achievements-tab__stat-card {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.25rem;
    padding: 1rem;
    background: var(--bg-card, #1a1a2e);
    border-radius: 12px;
    border: 1px solid var(--border, #334155);
    text-align: center;
    transition: transform 0.15s, border-color 0.15s;
  }
  .achievements-tab__stat-card:hover {
    transform: translateY(-2px);
    border-color: var(--accent, #6366f1);
  }
  .achievements-tab__stat-icon { font-size: 1.25rem; }
  .achievements-tab__stat-value {
    font-size: 1.5rem;
    font-weight: 700;
    color: var(--text-primary, #e0e0e0);
    font-variant-numeric: tabular-nums;
  }
  .achievements-tab__stat-label {
    font-size: 0.6875rem;
    color: var(--text-muted, #888);
    text-transform: uppercase;
    letter-spacing: 0.03em;
  }

  /* Sections */
  .achievements-tab__section {
    padding: 1.25rem;
    background: var(--bg-card, #1a1a2e);
    border-radius: 12px;
    border: 1px solid var(--border, #334155);
  }
  .achievements-tab__section-title {
    font-size: 1rem;
    font-weight: 600;
    color: var(--text-primary, #e0e0e0);
    margin: 0 0 1rem 0;
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }
  .achievements-tab__section-count {
    font-size: 0.75rem;
    font-weight: 400;
    color: var(--text-muted, #888);
    margin-left: auto;
  }

  /* Heatmap */
  .achievements-tab__heatmap-container { overflow-x: auto; }
  .achievements-tab__heatmap {
    display: grid;
    grid-template-rows: repeat(7, 1fr);
    grid-auto-flow: column;
    grid-auto-columns: 14px;
    gap: 2px;
    min-width: fit-content;
  }
  .achievements-tab__heatmap-cell {
    width: 12px;
    height: 12px;
    border-radius: 2px;
    transition: transform 0.1s;
  }
  .achievements-tab__heatmap-cell:hover {
    transform: scale(1.3);
    outline: 1px solid var(--accent, #6366f1);
  }
  .achievements-tab__heatmap-legend {
    display: flex;
    align-items: center;
    gap: 4px;
    margin-top: 0.75rem;
    justify-content: flex-end;
  }

  /* Achievement Cards */
  .achievements-tab__category { margin-bottom: 1.25rem; }
  .achievements-tab__category:last-child { margin-bottom: 0; }
  .achievements-tab__category-title {
    font-size: 0.8125rem;
    font-weight: 600;
    color: var(--text-secondary, #a0a0a0);
    margin: 0 0 0.75rem 0;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }
  .achievements-tab__achievement-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));
    gap: 0.75rem;
  }
  .achievements-tab__achievement-card {
    display: flex;
    align-items: flex-start;
    gap: 0.75rem;
    padding: 0.875rem;
    background: var(--bg-hover, #1e293b);
    border-radius: 10px;
    border: 1px solid transparent;
    opacity: 0.45;
    filter: grayscale(0.8);
    transition: opacity 0.2s, filter 0.2s, border-color 0.2s, transform 0.15s;
  }
  .achievements-tab__achievement-card--unlocked {
    opacity: 1;
    filter: none;
    border-color: var(--border, #334155);
  }
  .achievements-tab__achievement-card--unlocked:hover {
    border-color: var(--accent, #6366f1);
    transform: translateY(-1px);
  }
  .achievements-tab__achievement-icon {
    font-size: 1.5rem;
    flex-shrink: 0;
    line-height: 1;
  }
  .achievements-tab__achievement-info {
    display: flex;
    flex-direction: column;
    gap: 0.125rem;
    min-width: 0;
  }
  .achievements-tab__achievement-name {
    font-size: 0.8125rem;
    font-weight: 600;
    color: var(--text-primary, #e0e0e0);
  }
  .achievements-tab__achievement-desc {
    font-size: 0.6875rem;
    color: var(--text-muted, #888);
    line-height: 1.3;
  }
  .achievements-tab__achievement-date {
    font-size: 0.625rem;
    color: var(--accent, #6366f1);
    margin-top: 0.125rem;
  }

  /* Responsive */
  @media (max-width: 600px) {
    .achievements-tab__level-card {
      flex-direction: column;
      text-align: center;
      gap: 1rem;
      padding: 1.25rem;
    }
    .achievements-tab__level-ring-wrapper { width: 100px; height: 100px; }
    .achievements-tab__level-number { font-size: 2rem; }
    .achievements-tab__stats-grid { grid-template-columns: repeat(2, 1fr); }
    .achievements-tab__achievement-grid { grid-template-columns: 1fr; }
  }
</style>
