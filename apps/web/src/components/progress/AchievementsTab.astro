---
/**
 * AchievementsTab — Inline Gamification/Achievements for Progress & Growth shell
 *
 * Extracted from gamification.astro for embedding inside progress.astro.
 * Self-contained: fetches its own data via SSR.
 *
 * @domain gamification
 * @phase 18 — Progress & Growth Unification
 */
import GamificationWidget from "../gamification/GamificationWidget.astro"
import Icon from "../ui/Icon.astro"
import { type IconName } from "../../generated/icon-registry"
import { resolveAchievementTablerIcon } from "../../lib/tabler-svg"
import {
  getStats,
  getWeeklyData,
  getLevel,
  getProgressToNextLevel,
  getXpToNextLevel,
  getXpForLevel,
  getAllAchievements,
  getYearlyHeatmapData,
  ensureGamificationSchema,
} from "@domains/gamification"
import { isFeatureEnabled } from "../../lib/feature-flags"

const gamificationEnabled = await isFeatureEnabled("gamification")

// Ensure schema exists
try {
  if (gamificationEnabled) await ensureGamificationSchema()
} catch { /* DB not available */ }

// Fetch all data
let stats = {
  currentStreak: 0,
  longestStreak: 0,
  todayCompleted: 0,
  totalCompleted: 0,
  totalPoints: 0,
}
let weekly: Awaited<ReturnType<typeof getWeeklyData>> = []
let achievementData = { achievements: [] as any[], total: 0, unlocked: 0 }
let heatmapData: { date: string; count: number }[] = []

try {
  if (gamificationEnabled) {
    [stats, weekly, achievementData] = await Promise.all([
      getStats(),
      getWeeklyData(),
      getAllAchievements(),
    ])
    heatmapData = await getYearlyHeatmapData()
  }
} catch { /* graceful fallback */ }

const level = getLevel(stats.totalPoints)
const progress = getProgressToNextLevel(stats.totalPoints)
const xpToNext = getXpToNextLevel(stats.totalPoints)
const currentXp = stats.totalPoints - getXpForLevel(level)
const nextLevelXp = getXpForLevel(level + 1) - getXpForLevel(level)
const circumference = 2 * Math.PI * 54
const dashOffset = circumference * (1 - progress)

// Heatmap helpers
const today = new Date()
const currentYear = today.getFullYear()
const maxCount = Math.max(...heatmapData.map((d) => d.count), 1)

function heatmapColor(count: number): string {
  if (count === 0) return "var(--bg-secondary)"
  const intensity = Math.min(count / maxCount, 1)
  if (intensity < 0.25) return "color-mix(in srgb, var(--accent) 28%, var(--bg-secondary))"
  if (intensity < 0.5) return "color-mix(in srgb, var(--accent) 48%, var(--bg-secondary))"
  if (intensity < 0.75) return "color-mix(in srgb, var(--accent) 72%, var(--bg-secondary))"
  return "var(--accent)"
}

function getAchievementProgress(id: string): string {
  const milestoneTargets: Record<string, number> = {
    first_task: 1,
    tasks_10: 10,
    tasks_25: 25,
    tasks_50: 50,
    tasks_100: 100,
    tasks_250: 250,
    tasks_500: 500,
  }
  const milestoneTarget = milestoneTargets[id]
  if (milestoneTarget !== undefined) {
    return `${Math.min(stats.totalCompleted, milestoneTarget)}/${milestoneTarget} tasks`
  }

  const streakTargets: Record<string, number> = {
    streak_3: 3,
    streak_7: 7,
    streak_14: 14,
    streak_30: 30,
    streak_60: 60,
    streak_100: 100,
  }
  const streakTarget = streakTargets[id]
  if (streakTarget !== undefined) {
    return `${Math.min(stats.longestStreak, streakTarget)}/${streakTarget} day streak`
  }

  const xpTargets: Record<string, number> = {
    xp_100: 100,
    xp_500: 500,
    xp_1000: 1000,
    xp_2500: 2500,
    xp_5000: 5000,
    xp_10000: 10000,
  }
  const xpTarget = xpTargets[id]
  if (xpTarget !== undefined) {
    return `${Math.min(stats.totalPoints, xpTarget).toLocaleString()}/${xpTarget.toLocaleString()} XP`
  }

  const levelTargets: Record<string, number> = {
    level_5: 5,
    level_10: 10,
    level_20: 20,
  }
  const levelTarget = levelTargets[id]
  if (levelTarget !== undefined) {
    return `Level ${Math.min(level, levelTarget)}/${levelTarget}`
  }

  if (id === "daily_goal") return `${Math.min(stats.todayCompleted, 5)}/5 today`
  if (id === "five_in_day") return `${Math.min(stats.todayCompleted, 5)}/5 today`
  if (id === "ten_in_day") return `${Math.min(stats.todayCompleted, 10)}/10 today`
  return "Locked"
}

function getAchievementTooltip(a: { id: string; name: string; description: string; unlockedAt: string | null }): string {
  if (a.unlockedAt) {
    const dateLabel = new Date(a.unlockedAt).toLocaleDateString("en", { month: "short", day: "numeric", year: "numeric" })
    return `${a.name} — ${a.description} · Unlocked ${dateLabel}`
  }
  return `${a.name} — ${a.description} · Locked (${getAchievementProgress(a.id)})`
}

const categories: readonly { key: string; label: string; icon: IconName }[] = [
  { key: "milestone", label: "Milestones", icon: "target" },
  { key: "streak", label: "Streaks", icon: "flame" },
  { key: "xp", label: "XP Earned", icon: "star" },
  { key: "special", label: "Special", icon: "sparkles" },
]
---

{!gamificationEnabled ? (
  <div class="achievements-tab__disabled">
    <div class="achievements-tab__disabled-icon"><Icon name="trophy" size={48} sprite={true} /></div>
    <h2>Gamification is disabled</h2>
    <p>Enable the gamification feature flag in Settings to track achievements, XP, and streaks.</p>
  </div>
) : (
  <div class="achievements-tab" id="achievements-tab-root">
    <!-- Level Card -->
    <section class="achievements-tab__level-card">
      <div class="achievements-tab__level-ring-wrapper">
        <svg viewBox="0 0 120 120" class="achievements-tab__level-ring" aria-hidden="true">
          <circle cx="60" cy="60" r="54" class="achievements-tab__ring-bg" />
          <circle
            cx="60" cy="60" r="54"
            class="achievements-tab__ring-fill"
            style={`stroke-dasharray: ${circumference}; stroke-dashoffset: ${dashOffset};`}
          />
        </svg>
        <div class="achievements-tab__ring-content">
          <span class="achievements-tab__level-number">{level}</span>
          <span class="achievements-tab__level-label">Level</span>
        </div>
      </div>
      <div class="achievements-tab__level-info">
        <div class="achievements-tab__xp-bar">
          <div class="achievements-tab__xp-bar-fill" style={`width: ${progress * 100}%;`}></div>
        </div>
        <div class="achievements-tab__xp-text">
          <span>{currentXp} / {nextLevelXp} XP</span>
          <span style="color: var(--text-muted);">{xpToNext} to Level {level + 1}</span>
        </div>
      </div>
    </section>

    <!-- Stats Grid -->
    <section class="achievements-tab__stats-grid">
      <div class="achievements-tab__stat-card">
        <span class="achievements-tab__stat-icon"><Icon name="star" size={20} sprite={true} /></span>
        <span class="achievements-tab__stat-value">{stats.totalPoints.toLocaleString()}</span>
        <span class="achievements-tab__stat-label">Total XP</span>
      </div>
      <div class="achievements-tab__stat-card">
        <span class="achievements-tab__stat-icon"><Icon name="checkbox" size={20} sprite={true} /></span>
        <span class="achievements-tab__stat-value">{stats.totalCompleted.toLocaleString()}</span>
        <span class="achievements-tab__stat-label">Tasks Completed</span>
      </div>
      <div class="achievements-tab__stat-card">
        <span class="achievements-tab__stat-icon"><Icon name="flame" size={20} sprite={true} /></span>
        <span class="achievements-tab__stat-value">{stats.currentStreak}</span>
        <span class="achievements-tab__stat-label">Current Streak</span>
      </div>
      <div class="achievements-tab__stat-card">
        <span class="achievements-tab__stat-icon"><Icon name="trophy" size={20} sprite={true} /></span>
        <span class="achievements-tab__stat-value">{stats.longestStreak}</span>
        <span class="achievements-tab__stat-label">Best Streak</span>
      </div>
      <div class="achievements-tab__stat-card">
        <span class="achievements-tab__stat-icon"><Icon name="star" size={20} sprite={true} /></span>
        <span class="achievements-tab__stat-value">{achievementData.unlocked} / {achievementData.total}</span>
        <span class="achievements-tab__stat-label">Achievements</span>
      </div>
      <div class="achievements-tab__stat-card">
        <span class="achievements-tab__stat-icon"><Icon name="calendar" size={20} sprite={true} /></span>
        <span class="achievements-tab__stat-value">{stats.todayCompleted}</span>
        <span class="achievements-tab__stat-label">Today</span>
      </div>
    </section>

    <!-- Weekly Progress -->
    <section class="achievements-tab__section">
      <GamificationWidget stats={stats} weekly={weekly} achievements={achievementData.achievements} />
    </section>

    <!-- Activity Heatmap -->
    {heatmapData.length > 0 && (
      <section class="achievements-tab__section">
        <h2 class="achievements-tab__section-title"><Icon name="chart-bar" size={18} sprite={true} /> Activity Heatmap — {currentYear}</h2>
        <div class="achievements-tab__heatmap-container">
          <div class="achievements-tab__heatmap">
            {heatmapData.map((day) => (
              <div
                class="achievements-tab__heatmap-cell"
                style={`background: ${heatmapColor(day.count)};`}
                title={`${day.date}: ${day.count} task${day.count !== 1 ? "s" : ""}`}
              />
            ))}
          </div>
          <div class="achievements-tab__heatmap-legend">
            <span style="font-size: 0.75rem; color: var(--text-muted);">Less</span>
            <div class="achievements-tab__heatmap-cell" style="background: var(--bg-hover, #1d211f);" />
            <div class="achievements-tab__heatmap-cell" style="background: color-mix(in srgb, var(--accent) 28%, var(--bg-card));" />
            <div class="achievements-tab__heatmap-cell" style="background: color-mix(in srgb, var(--accent) 50%, var(--bg-card));" />
            <div class="achievements-tab__heatmap-cell" style="background: color-mix(in srgb, var(--accent) 75%, var(--bg-card));" />
            <div class="achievements-tab__heatmap-cell" style="background: var(--accent);" />
            <span style="font-size: 0.75rem; color: var(--text-muted);">More</span>
          </div>
        </div>
      </section>
    )}

    <!-- Achievement Gallery -->
    <section class="achievements-tab__section">
      <h2 class="achievements-tab__section-title">
        <Icon name="trophy" size={18} sprite={true} /> Achievements
        <span class="achievements-tab__section-count">{achievementData.unlocked} / {achievementData.total}</span>
      </h2>
      {categories.map(({ key, label, icon }) => {
        const categoryAchievements = achievementData.achievements.filter(
          (a: any) => a.category === key
        )
        if (categoryAchievements.length === 0) return null
        return (
          <div class="achievements-tab__category">
            <h3 class="achievements-tab__category-title"><Icon name={icon} size={14} sprite={true} /> {label}</h3>
            <div class="achievements-tab__achievement-grid">
              {categoryAchievements.map((a: any) => {
                const tooltip = getAchievementTooltip(a)
                return (
                  <div
                    class={`achievements-tab__achievement-card ${a.unlockedAt ? "achievements-tab__achievement-card--unlocked" : ""}`}
                    title={tooltip}
                  >
                    <span class="achievements-tab__achievement-icon inline-flex items-center justify-center" aria-hidden="true">
                      <Icon name={resolveAchievementTablerIcon(a.id || a.icon)} size={20} sprite={true} />
                    </span>
                    <div class="achievements-tab__achievement-info">
                      <span class="achievements-tab__achievement-name">{a.name}</span>
                      <span class="achievements-tab__achievement-desc">{a.description}</span>
                      {a.unlockedAt ? (
                        <span class="achievements-tab__achievement-date">
                          <Icon name="check" size={12} sprite={true} /> {new Date(a.unlockedAt).toLocaleDateString("en", { month: "short", day: "numeric", year: "numeric" })}
                        </span>
                      ) : (
                        <span class="achievements-tab__achievement-progress">
                          {getAchievementProgress(a.id)}
                        </span>
                      )}
                    </div>
                  </div>
                )
              })}
            </div>
          </div>
        )
      })}
    </section>
  </div>
)}

<style>
  @reference "../../styles/global.css";

  .achievements-tab {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
    padding: 0.5rem 0;
    max-width: 1000px;
  }

  .achievements-tab__disabled {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding: 4rem 2rem;
    text-align: center;
    border: 2px dashed var(--border);
    border-radius: var(--radius-lg, 12px);
    color: var(--text-muted);
  }
  .achievements-tab__disabled-icon { margin-bottom: 1rem; opacity: 0.6; }

  /* Level Card */
  .achievements-tab__level-card {
    display: flex;
    align-items: center;
    gap: 2rem;
    padding: 1.5rem 2rem;
    background: color-mix(in srgb, var(--accent) 8%, var(--bg-card));
    border-radius: 16px;
    border: 1px solid var(--border);
  }
  .achievements-tab__level-ring-wrapper {
    position: relative;
    width: 120px;
    height: 120px;
    flex-shrink: 0;
  }
  .achievements-tab__level-ring {
    width: 100%;
    height: 100%;
    transform: rotate(-90deg);
  }
  .achievements-tab__ring-bg {
    fill: none;
    stroke: var(--border);
    stroke-width: 6;
  }
  .achievements-tab__ring-fill {
    fill: none;
    stroke: var(--accent);
    stroke-width: 6;
    stroke-linecap: round;
    transition: stroke-dashoffset 0.8s ease;
  }
  .achievements-tab__ring-content {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    text-align: center;
    line-height: 1;
  }
  .achievements-tab__level-number {
    font-size: 2.5rem;
    font-weight: 800;
    color: var(--text-primary);
    font-variant-numeric: tabular-nums;
    display: block;
  }
  .achievements-tab__level-label {
    font-size: 0.75rem;
    color: var(--text-muted);
    text-transform: uppercase;
    letter-spacing: 0.1em;
    margin-top: 0.125rem;
  }
  .achievements-tab__level-info {
    flex: 1;
    min-width: 0;
  }
  .achievements-tab__xp-bar {
    height: 8px;
    background: var(--bg-hover);
    border-radius: 4px;
    overflow: hidden;
    margin-bottom: 0.5rem;
  }
  .achievements-tab__xp-bar-fill {
    height: 100%;
    background: var(--accent);
    border-radius: 4px;
    transition: width 0.6s ease;
    min-width: 2px;
  }
  .achievements-tab__xp-text {
    display: flex;
    justify-content: space-between;
    font-size: 0.8125rem;
    color: var(--text-secondary);
  }

  /* Stats Grid */
  .achievements-tab__stats-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(140px, 1fr));
    gap: 0.75rem;
  }
  .achievements-tab__stat-card {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.25rem;
    padding: 1rem;
    background: var(--bg-card);
    border-radius: 12px;
    border: 1px solid var(--border);
    text-align: center;
    transition: transform 0.15s, border-color 0.15s;
  }
  .achievements-tab__stat-card:hover {
    transform: translateY(-2px);
    border-color: var(--accent);
  }
  .achievements-tab__stat-icon { display: inline-flex; color: var(--accent); }
  .achievements-tab__stat-value {
    font-size: 1.5rem;
    font-weight: 700;
    color: var(--text-primary);
    font-variant-numeric: tabular-nums;
  }
  .achievements-tab__stat-label {
    font-size: 0.6875rem;
    color: var(--text-muted);
    text-transform: uppercase;
    letter-spacing: 0.03em;
  }

  /* Sections */
  .achievements-tab__section {
    padding: 1.25rem;
    background: var(--bg-card);
    border-radius: 12px;
    border: 1px solid var(--border);
  }
  .achievements-tab__section-title {
    font-size: 1rem;
    font-weight: 600;
    color: var(--text-primary);
    margin: 0 0 1rem 0;
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }
  .achievements-tab__section-count {
    font-size: 0.75rem;
    font-weight: 400;
    color: var(--text-muted);
    margin-left: auto;
  }

  /* Heatmap */
  .achievements-tab__heatmap-container { overflow-x: auto; }
  .achievements-tab__heatmap {
    display: grid;
    grid-template-rows: repeat(7, 1fr);
    grid-auto-flow: column;
    grid-auto-columns: 14px;
    gap: 2px;
    min-width: fit-content;
  }
  .achievements-tab__heatmap-cell {
    width: 12px;
    height: 12px;
    border-radius: 2px;
    transition: transform 0.1s;
  }
  .achievements-tab__heatmap-cell:hover {
    transform: scale(1.3);
    outline: 1px solid var(--accent);
  }
  .achievements-tab__heatmap-legend {
    display: flex;
    align-items: center;
    gap: 4px;
    margin-top: 0.75rem;
    justify-content: flex-end;
  }

  /* Achievement Cards */
  .achievements-tab__category { margin-bottom: 1.25rem; }
  .achievements-tab__category:last-child { margin-bottom: 0; }
  .achievements-tab__category-title {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    font-size: 0.8125rem;
    font-weight: 600;
    color: var(--text-secondary);
    margin: 0 0 0.75rem 0;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }
  .achievements-tab__achievement-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));
    gap: 0.75rem;
  }
  .achievements-tab__achievement-card {
    display: flex;
    align-items: flex-start;
    gap: 0.75rem;
    padding: 0.875rem;
    background: var(--bg-secondary);
    border-radius: 10px;
    border: 1px dashed var(--border);
    opacity: 0.82;
    filter: grayscale(0.45);
    transition: opacity 0.2s, filter 0.2s, border-color 0.2s, transform 0.15s;
  }
  .achievements-tab__achievement-card:hover,
  .achievements-tab__achievement-card:focus-visible {
    opacity: 1;
    border-color: var(--accent);
    outline: none;
  }
  .achievements-tab__achievement-card--unlocked {
    opacity: 1;
    filter: none;
    background: var(--bg-card);
    border-style: solid;
    border-color: color-mix(in srgb, var(--accent) 40%, var(--border));
  }
  .achievements-tab__achievement-card--unlocked:hover {
    border-color: var(--accent);
    transform: translateY(-1px);
  }
  .achievements-tab__achievement-icon {
    font-size: 1.5rem;
    flex-shrink: 0;
    line-height: 1;
  }
  .achievements-tab__achievement-info {
    display: flex;
    flex-direction: column;
    gap: 0.125rem;
    min-width: 0;
  }
  .achievements-tab__achievement-name {
    font-size: 0.8125rem;
    font-weight: 600;
    color: var(--text-primary);
  }
  .achievements-tab__achievement-desc {
    font-size: 0.75rem;
    color: var(--text-secondary);
    line-height: 1.35;
  }
  .achievements-tab__achievement-date {
    display: inline-flex;
    align-items: center;
    gap: 0.25rem;
    font-size: 0.6875rem;
    font-weight: 500;
    color: var(--accent-text, var(--accent));
    margin-top: 0.125rem;
  }
  .achievements-tab__achievement-progress {
    font-size: 0.6875rem;
    color: var(--text-secondary);
    margin-top: 0.125rem;
  }

  /* Responsive */
  @media (max-width: 600px) {
    .achievements-tab__level-card {
      flex-direction: column;
      text-align: center;
      gap: 1rem;
      padding: 1.25rem;
    }
    .achievements-tab__level-ring-wrapper { width: 100px; height: 100px; }
    .achievements-tab__level-number { font-size: 2rem; }
    .achievements-tab__stats-grid { grid-template-columns: repeat(2, 1fr); }
    .achievements-tab__achievement-grid { grid-template-columns: 1fr; }
  }
</style>
