---
import { readBoardPagePlacement } from "@lib/board-page-placement"
import { boardContextHref } from "@lib/board-workspace"
import { resolveBoardPageScope } from "@lib/board-http"
import { organizationLabelsFor } from "@lib/organization-labels"
/**
 * AchievementsTab — Unified Tabler Gamification & Achievements dashboard
 *
 * Shared by `/progress#achievements` and `/gamification` (DRY).
 * Respects all Look & Feel settings (theme, accent, radius, typography, fluid width).
 *
 * @domain gamification
 */
import GamificationWidget from "../gamification/GamificationWidget.astro"
import Icon from "../ui/Icon.astro"
import { type IconName } from "../../generated/icon-registry"
import { resolveAchievementTablerIcon } from "../../lib/tabler-svg"
import {
  getStats,
  getWeeklyData,
  getLevel,
  getProgressToNextLevel,
  getXpToNextLevel,
  getXpForLevel,
  getAllAchievements,
  getYearlyHeatmapData,
  ensureGamificationSchema,
} from "@domains/gamification"
import { isFeatureEnabled } from "../../lib/feature-flags"

const organization = await organizationLabelsFor(Astro)
const scoped = await resolveBoardPageScope(Astro)
const workScope = scoped.ok ? scoped.scope : null
const pagePlacement = workScope ? await readBoardPagePlacement(workScope, Astro.url) : null
const achievementsHref = workScope && pagePlacement?.ok
  ? boardContextHref(
      { boardId: workScope.boardId, area: pagePlacement.area?.id, project: pagePlacement.project?.id },
      "/progress#achievements",
    )
  : undefined

const gamificationEnabled = await isFeatureEnabled("gamification")

try {
  if (gamificationEnabled) await ensureGamificationSchema()
} catch { /* DB not available */ }

let stats = {
  currentStreak: 0,
  longestStreak: 0,
  todayCompleted: 0,
  totalCompleted: 0,
  totalPoints: 0,
}
let dataUnavailable = false
let weekly: Awaited<ReturnType<typeof getWeeklyData>> = []
let achievementData = { achievements: [] as any[], total: 0, unlocked: 0 }
let heatmapData: { date: string; count: number }[] = []

try {
  if (workScope && gamificationEnabled) {
    ;[stats, weekly, achievementData] = await Promise.all([
      getStats(workScope),
      getWeeklyData(workScope),
      getAllAchievements(workScope),
    ])
    heatmapData = await getYearlyHeatmapData(workScope)
  }
} catch {
  dataUnavailable = true
}

const level = getLevel(stats.totalPoints)
const progress = getProgressToNextLevel(stats.totalPoints)
const progressPct = Math.round(progress * 100)
const xpToNext = getXpToNextLevel(stats.totalPoints)
const currentXp = stats.totalPoints - getXpForLevel(level)
const nextLevelXp = getXpForLevel(level + 1) - getXpForLevel(level)
const circumference = 2 * Math.PI * 52
const dashOffset = circumference * (1 - progress)

const today = new Date()
const currentYear = today.getFullYear()
const maxCount = Math.max(...heatmapData.map((d) => d.count), 1)

function heatmapColor(count: number): string {
  if (count === 0) return "var(--bg-secondary)"
  const intensity = Math.min(count / maxCount, 1)
  if (intensity < 0.25) return "color-mix(in srgb, var(--accent) 26%, var(--bg-secondary))"
  if (intensity < 0.5) return "color-mix(in srgb, var(--accent) 48%, var(--bg-secondary))"
  if (intensity < 0.75) return "color-mix(in srgb, var(--accent) 74%, var(--bg-secondary))"
  return "var(--accent)"
}

function getAchievementProgress(id: string): string {
  const milestoneTargets: Record<string, number> = {
    first_task: 1,
    tasks_10: 10,
    tasks_25: 25,
    tasks_50: 50,
    tasks_100: 100,
    tasks_250: 250,
    tasks_500: 500,
  }
  const milestoneTarget = milestoneTargets[id]
  if (milestoneTarget !== undefined) {
    return `${Math.min(stats.totalCompleted, milestoneTarget)}/${milestoneTarget} tasks`
  }

  const streakTargets: Record<string, number> = {
    streak_3: 3,
    streak_7: 7,
    streak_14: 14,
    streak_30: 30,
    streak_60: 60,
    streak_100: 100,
  }
  const streakTarget = streakTargets[id]
  if (streakTarget !== undefined) {
    return `${Math.min(stats.longestStreak, streakTarget)}/${streakTarget} day streak`
  }

  const xpTargets: Record<string, number> = {
    xp_100: 100,
    xp_500: 500,
    xp_1000: 1000,
    xp_2500: 2500,
    xp_5000: 5000,
    xp_10000: 10000,
  }
  const xpTarget = xpTargets[id]
  if (xpTarget !== undefined) {
    return `${Math.min(stats.totalPoints, xpTarget).toLocaleString()}/${xpTarget.toLocaleString()} XP`
  }

  const levelTargets: Record<string, number> = {
    level_5: 5,
    level_10: 10,
    level_20: 20,
  }
  const levelTarget = levelTargets[id]
  if (levelTarget !== undefined) {
    return `Level ${Math.min(level, levelTarget)}/${levelTarget}`
  }

  if (id === "daily_goal" || id === "five_in_day") return `${Math.min(stats.todayCompleted, 5)}/5 today`
  if (id === "ten_in_day") return `${Math.min(stats.todayCompleted, 10)}/10 today`
  return "Locked"
}

function getAchievementTooltip(a: { id: string; name: string; description: string; unlockedAt: string | null }): string {
  if (a.unlockedAt) {
    const dateLabel = new Date(a.unlockedAt).toLocaleDateString("en", { month: "short", day: "numeric", year: "numeric" })
    return `${a.name} — ${a.description} · Unlocked ${dateLabel}`
  }
  return `${a.name} — ${a.description} · Locked (${getAchievementProgress(a.id)})`
}

const categories: readonly { key: string; label: string; icon: IconName }[] = [
  { key: "milestone", label: "Milestones", icon: "target" },
  { key: "streak", label: "Streaks", icon: "flame" },
  { key: "xp", label: "XP Earned", icon: "star" },
  { key: "special", label: "Special", icon: "sparkles" },
]

const unlockedPercent = achievementData.total > 0
  ? Math.round((achievementData.unlocked / achievementData.total) * 100)
  : 0
---

{!workScope || !achievementsHref || dataUnavailable ? (
  <div class="card achievements-tab__state-card" role="status">
    <div class="card-body achievements-tab__empty">
      <svg class="achievements-tab__illustration" viewBox="0 0 180 120" fill="none" aria-hidden="true">
        <rect x="28" y="22" width="124" height="76" rx="12" fill="var(--bg-secondary)" stroke="var(--border)" stroke-width="2" />
        <circle cx="90" cy="56" r="20" fill="color-mix(in srgb, var(--accent) 16%, var(--bg-card))" stroke="var(--accent)" stroke-width="2" />
        <path d="M90 46v12M90 64h.01" stroke="var(--accent)" stroke-width="2.5" stroke-linecap="round" />
        <rect x="54" y="84" width="72" height="6" rx="3" fill="var(--border)" />
      </svg>
      <h2 class="achievements-tab__empty-title">Achievements are unavailable</h2>
      <p class="achievements-tab__empty-desc">Reload the page to retry loading your progress and achievements.</p>
    </div>
  </div>
) : !gamificationEnabled ? (
  <div class="card achievements-tab__state-card">
    <div class="card-body achievements-tab__empty">
      <svg class="achievements-tab__illustration" viewBox="0 0 180 120" fill="none" aria-hidden="true">
        <circle cx="90" cy="60" r="44" fill="color-mix(in srgb, var(--accent) 10%, var(--bg-secondary))" stroke="var(--border)" stroke-width="1.5" stroke-dasharray="4 4" />
        <path d="M72 40h36v16c0 10-8 18-18 18s-18-8-18-18V40Z" fill="var(--bg-card)" stroke="var(--accent)" stroke-width="2" stroke-linejoin="round" />
        <path d="M72 46h-8c0 9 3 14 8 15M108 46h8c0 9-3 14-8 15" stroke="var(--accent)" stroke-width="2" stroke-linecap="round" />
        <path d="M90 74v10M76 84h28" stroke="var(--accent)" stroke-width="2" stroke-linecap="round" />
        <circle cx="48" cy="36" r="3" fill="var(--accent)" opacity="0.5" />
        <circle cx="136" cy="40" r="4" fill="var(--accent)" opacity="0.35" />
        <circle cx="132" cy="84" r="2.5" fill="var(--accent)" opacity="0.5" />
      </svg>
      <h2 class="achievements-tab__empty-title">Gamification is disabled</h2>
      <p class="achievements-tab__empty-desc">
        Enable Gamification in Settings to track XP points, daily streaks, levels, and household achievements.
      </p>
      <a href="/settings#tasks-boards-settings" class="btn btn-primary btn-sm">
        <Icon name="settings" size={15} sprite={true} />
        <span>Open Optional Features</span>
      </a>
    </div>
  </div>
) : (
  <div class="achievements-tab" id="achievements-tab-root">
    <!-- Hero Level Card (Tabler Card + Theme-Reactive Illustration) -->
    <section class="card achievements-tab__hero achievements-tab__anchor" id="achievements-level">
      <div class="card-body achievements-tab__hero-body">
        <div class="achievements-tab__level-ring-wrapper">
          <svg viewBox="0 0 120 120" class="achievements-tab__level-ring" aria-hidden="true">
            <circle cx="60" cy="60" r="52" class="achievements-tab__ring-bg" />
            <circle
              cx="60" cy="60" r="52"
              class="achievements-tab__ring-fill"
              style={`stroke-dasharray: ${circumference}; stroke-dashoffset: ${dashOffset};`}
            />
          </svg>
          <div class="achievements-tab__ring-content">
            <span class="achievements-tab__level-number">{level}</span>
            <span class="achievements-tab__level-label">Level</span>
          </div>
        </div>

        <div class="achievements-tab__level-info">
          <div class="achievements-tab__hero-heading">
            <div>
              <div class="subheader">Household Momentum</div>
              <h2 class="achievements-tab__hero-title">
                Level {level} · {stats.totalPoints.toLocaleString()} XP
              </h2>
            </div>
            <span class="achievements-tab__pill">
              <Icon name="trophy" size={14} sprite={true} />
              <span>{achievementData.unlocked} / {achievementData.total} unlocked ({unlockedPercent}%)</span>
            </span>
          </div>

          <div class="progress achievements-tab__progress" role="progressbar" aria-label="Progress to next level" aria-valuenow={progressPct} aria-valuemin="0" aria-valuemax="100">
            <div class="progress-bar achievements-tab__progress-bar" style={`width: ${Math.max(progressPct, 2)}%;`}></div>
          </div>

          <div class="achievements-tab__xp-text">
            <span><strong>{currentXp.toLocaleString()}</strong> / {nextLevelXp.toLocaleString()} XP this level</span>
            <span class="achievements-tab__xp-muted">{xpToNext.toLocaleString()} XP to Level {level + 1}</span>
          </div>
          <p class="achievements-tab__explain">Levels rise automatically as you earn XP from completed tasks, routines, and daily goals.</p>
        </div>

        <div class="achievements-tab__hero-art" aria-hidden="true">
          <svg viewBox="0 0 160 112" fill="none" class="achievements-tab__hero-svg">
            <ellipse cx="80" cy="96" rx="58" ry="8" fill="color-mix(in srgb, var(--accent) 14%, transparent)" />
            <rect x="44" y="78" width="72" height="14" rx="4" fill="var(--bg-secondary)" stroke="var(--border)" stroke-width="1.5" />
            <rect x="56" y="68" width="48" height="12" rx="3" fill="var(--bg-card)" stroke="var(--border)" stroke-width="1.5" />
            <path d="M58 24h44v20c0 12.15-9.85 22-22 22s-22-9.85-22-22V24Z" fill="color-mix(in srgb, var(--accent) 18%, var(--bg-card))" stroke="var(--accent)" stroke-width="2" stroke-linejoin="round" />
            <path d="M58 30H46c0 11 4.5 17 12 19M102 30h12c0 11-4.5 17-12 19" stroke="var(--accent)" stroke-width="2" stroke-linecap="round" />
            <path d="M80 34l2.7 5.5 6 .9-4.35 4.25 1.03 6L80 47.8l-5.38 2.85 1.03-6L71.3 40.4l6-.9L80 34Z" fill="var(--accent)" />
            <path d="M26 28l2-4 2 4 4 2-4 2-2 4-2-4-4-2 4-2Z" fill="var(--accent)" opacity="0.6" />
            <circle cx="134" cy="24" r="3.5" fill="var(--accent)" opacity="0.45" />
            <circle cx="140" cy="64" r="2.5" fill="var(--accent)" opacity="0.65" />
            <circle cx="24" cy="68" r="2.5" fill="var(--accent)" opacity="0.4" />
          </svg>
        </div>
      </div>
    </section>

    <!-- Tabler KPI Stats Grid -->
    <section class="achievements-tab__stats-grid" aria-label="Progress statistics">
      <div class="card achievements-tab__stat-card achievements-tab__anchor" id="achievements-xp">
        <div class="card-body achievements-tab__stat-body">
          <div class="achievements-tab__stat-top">
            <span class="subheader">Total XP</span>
            <span class="achievements-tab__stat-avatar"><Icon name="star" size={18} sprite={true} /></span>
          </div>
          <div class="achievements-tab__stat-value">{stats.totalPoints.toLocaleString()}</div>
          <p class="achievements-tab__stat-caption">Earned on every completed task; higher priority awards more XP.</p>
        </div>
      </div>

      <div class="card achievements-tab__stat-card">
        <div class="card-body achievements-tab__stat-body">
          <div class="achievements-tab__stat-top">
            <span class="subheader">Completed</span>
            <span class="achievements-tab__stat-avatar"><Icon name="checkbox" size={18} sprite={true} /></span>
          </div>
          <div class="achievements-tab__stat-value">{stats.totalCompleted.toLocaleString()}</div>
          <p class="achievements-tab__stat-caption">All-time finished tasks counted toward milestone badges.</p>
        </div>
      </div>

      <div class="card achievements-tab__stat-card achievements-tab__anchor" id="achievements-streaks">
        <div class="card-body achievements-tab__stat-body">
          <div class="achievements-tab__stat-top">
            <span class="subheader">Current Streak</span>
            <span class="achievements-tab__stat-avatar"><Icon name="flame" size={18} sprite={true} /></span>
          </div>
          <div class="achievements-tab__stat-value">{stats.currentStreak} {stats.currentStreak === 1 ? "day" : "days"}</div>
          <p class="achievements-tab__stat-caption">Consecutive days with at least one completed task or routine.</p>
        </div>
      </div>

      <div class="card achievements-tab__stat-card">
        <div class="card-body achievements-tab__stat-body">
          <div class="achievements-tab__stat-top">
            <span class="subheader">Best Streak</span>
            <span class="achievements-tab__stat-avatar"><Icon name="trophy" size={18} sprite={true} /></span>
          </div>
          <div class="achievements-tab__stat-value">{stats.longestStreak} {stats.longestStreak === 1 ? "day" : "days"}</div>
          <p class="achievements-tab__stat-caption">Your longest unbroken run of daily completions.</p>
        </div>
      </div>

      <div class="card achievements-tab__stat-card">
        <div class="card-body achievements-tab__stat-body">
          <div class="achievements-tab__stat-top">
            <span class="subheader">{organization("achievement", true)}</span>
            <span class="achievements-tab__stat-avatar"><Icon name="sparkles" size={18} sprite={true} /></span>
          </div>
          <div class="achievements-tab__stat-value">{achievementData.unlocked} / {achievementData.total}</div>
          <p class="achievements-tab__stat-caption">Badges unlocked across milestones, streaks, and XP tiers.</p>
        </div>
      </div>

      <div class="card achievements-tab__stat-card achievements-tab__anchor" id="achievements-today">
        <div class="card-body achievements-tab__stat-body">
          <div class="achievements-tab__stat-top">
            <span class="subheader">Today</span>
            <span class="achievements-tab__stat-avatar"><Icon name="calendar" size={18} sprite={true} /></span>
          </div>
          <div class="achievements-tab__stat-value">{stats.todayCompleted}</div>
          <p class="achievements-tab__stat-caption">Tasks finished today toward your daily ring and streak.</p>
        </div>
      </div>
    </section>

    <!-- Weekly Progress + Activity Heatmap Split Grid -->
    <div class="achievements-tab__insights-grid">
      <section class="achievements-tab__widget-wrap">
        <GamificationWidget
          achievementsHref={achievementsHref}
          stats={stats}
          weekly={weekly}
          level={level}
          progressToNext={progress}
          achievements={achievementData.achievements}
        />
      </section>

      {heatmapData.length > 0 && (
        <section class="card achievements-tab__heatmap-card">
          <div class="card-header achievements-tab__card-header">
            <h2 class="card-title achievements-tab__section-title">
              <Icon name="chart-bar" size={18} sprite={true} />
              <span>Activity Heatmap — {currentYear}</span>
            </h2>
            <span class="achievements-tab__section-count">
              {stats.totalCompleted.toLocaleString()} completions
            </span>
          </div>
          <div class="card-body achievements-tab__heatmap-body">
            <div class="achievements-tab__heatmap-container">
              <div class="achievements-tab__heatmap">
                {heatmapData.map((day) => (
                  <div
                    class="achievements-tab__heatmap-cell"
                    style={`background: ${heatmapColor(day.count)};`}
                    title={`${day.date}: ${day.count} task${day.count !== 1 ? "s" : ""}`}
                  />
                ))}
              </div>
            </div>
            <div class="achievements-tab__heatmap-legend">
              <span class="achievements-tab__legend-label">Less</span>
              <div class="achievements-tab__heatmap-cell" style="background: var(--bg-secondary);" />
              <div class="achievements-tab__heatmap-cell" style="background: color-mix(in srgb, var(--accent) 26%, var(--bg-secondary));" />
              <div class="achievements-tab__heatmap-cell" style="background: color-mix(in srgb, var(--accent) 48%, var(--bg-secondary));" />
              <div class="achievements-tab__heatmap-cell" style="background: color-mix(in srgb, var(--accent) 74%, var(--bg-secondary));" />
              <div class="achievements-tab__heatmap-cell" style="background: var(--accent);" />
              <span class="achievements-tab__legend-label">More</span>
            </div>
          </div>
        </section>
      )}
    </div>

    <!-- Achievement Gallery -->
    <section class="card achievements-tab__gallery-card achievements-tab__anchor" id="achievements-gallery">
      <div class="card-header achievements-tab__card-header">
        <h2 class="card-title achievements-tab__section-title">
          <Icon name="trophy" size={18} sprite={true} />
          <span>{organization("achievement", true)}</span>
        </h2>
        <span class="achievements-tab__pill">
          {achievementData.unlocked} / {achievementData.total} unlocked
        </span>
      </div>
      <div class="card-body achievements-tab__gallery-body">
        {categories.map(({ key, label, icon }) => {
          const categoryAchievements = achievementData.achievements.filter((a: any) => a.category === key)
          if (categoryAchievements.length === 0) return null
          const catUnlocked = categoryAchievements.filter((a: any) => Boolean(a.unlockedAt)).length
          return (
            <div class="achievements-tab__category">
              <div class="achievements-tab__category-header">
                <h3 class="subheader achievements-tab__category-title">
                  <Icon name={icon} size={14} sprite={true} />
                  <span>{label}</span>
                </h3>
                <span class="achievements-tab__category-count">
                  {catUnlocked} / {categoryAchievements.length}
                </span>
              </div>
              <div class="achievements-tab__achievement-grid">
                {categoryAchievements.map((a: any) => {
                  const tooltip = getAchievementTooltip(a)
                  const unlocked = Boolean(a.unlockedAt)
                  return (
                    <div
                      class={`achievements-tab__achievement-card ${unlocked ? "achievements-tab__achievement-card--unlocked" : ""}`}
                      title={tooltip}
                    >
                      <span class="achievements-tab__achievement-icon" aria-hidden="true">
                        <Icon name={resolveAchievementTablerIcon(a.id || a.icon)} size={20} sprite={true} />
                      </span>
                      <div class="achievements-tab__achievement-info">
                        <span class="achievements-tab__achievement-name">{a.name}</span>
                        <span class="achievements-tab__achievement-desc">{a.description}</span>
                        {unlocked ? (
                          <span class="achievements-tab__achievement-date">
                            <Icon name="check" size={12} sprite={true} />
                            <span>{new Date(a.unlockedAt).toLocaleDateString("en", { month: "short", day: "numeric", year: "numeric" })}</span>
                          </span>
                        ) : (
                          <span class="achievements-tab__achievement-progress">
                            {getAchievementProgress(a.id)}
                          </span>
                        )}
                      </div>
                    </div>
                  )
                })}
              </div>
            </div>
          )
        })}
      </div>
    </section>
  </div>
)}

<style is:inline>
  @reference "../../styles/global.css";

  .achievements-tab {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
    padding: 0.25rem 0 1.5rem;
    width: 100%;
    max-width: 1200px;
  }

  :root[data-appearance-width="fluid"] .achievements-tab {
    max-width: none;
  }

  .achievements-tab__state-card {
    padding: 0;
    background: var(--bg-card);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg, 12px);
    max-width: 720px;
    margin: 1rem auto;
  }

  .achievements-tab__empty {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: 0.75rem;
    padding: 3rem 1.5rem;
  }

  .achievements-tab__illustration {
    width: 168px;
    height: 112px;
    margin-bottom: 0.25rem;
  }

  .achievements-tab__empty-title {
    margin: 0;
    font-size: 1.125rem;
    font-weight: 600;
    color: var(--text-primary);
  }

  .achievements-tab__empty-desc {
    margin: 0;
    max-width: 440px;
    font-size: 0.875rem;
    color: var(--text-secondary);
    line-height: 1.5;
  }

  /* Hero Level Card */
  .achievements-tab__hero {
    padding: 0;
    background: linear-gradient(
      135deg,
      color-mix(in srgb, var(--accent) 8%, var(--bg-card)),
      var(--bg-card) 62%
    );
    border: 1px solid var(--border);
    border-radius: var(--radius-lg, 12px);
  }

  .achievements-tab__hero-body {
    display: flex;
    align-items: center;
    gap: 1.75rem;
    padding: 1.5rem 1.75rem;
  }

  .achievements-tab__level-ring-wrapper {
    position: relative;
    width: 112px;
    height: 112px;
    flex-shrink: 0;
  }

  .achievements-tab__level-ring {
    width: 100%;
    height: 100%;
    transform: rotate(-90deg);
  }

  .achievements-tab__ring-bg {
    fill: none;
    stroke: var(--border);
    stroke-width: 7;
  }

  .achievements-tab__ring-fill {
    fill: none;
    stroke: var(--accent);
    stroke-width: 7;
    stroke-linecap: round;
    transition: stroke-dashoffset 0.7s cubic-bezier(0.23, 1, 0.32, 1);
  }

  .achievements-tab__ring-content {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    line-height: 1;
  }

  .achievements-tab__level-number {
    font-size: 2.25rem;
    font-weight: 800;
    color: var(--text-primary);
    font-variant-numeric: tabular-nums;
  }

  .achievements-tab__level-label {
    font-size: 0.6875rem;
    font-weight: 600;
