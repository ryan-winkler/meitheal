---
/**
 * GoalsTab — Inline Goals content for the Progress & Growth shell
 *
 * Extracted from goals/index.astro for embedding inside progress.astro.
 * Self-contained: fetches its own data via SSR.
 *
 * @domain navigation + hierarchy
 * @phase 18 — Progress & Growth Unification
 */
import ProgressRing from "../ui/ProgressRing.astro"
import { ensureSchema, getPersistenceClient } from "@domains/tasks/persistence/store"
import { HierarchyRepository } from "@domains/tasks/persistence/hierarchy-repository"

interface Props { areaId?: string }

const embeddedArea = Astro.props.areaId
const areaId = embeddedArea ?? (Astro.url.searchParams.get("area_id") || undefined)
const projectId = embeddedArea ? undefined : Astro.url.searchParams.get("project_id") || undefined
let scopedAreaName: string | undefined
let scopedProjectName: string | undefined

let goals: Array<{
  id: string
  title: string
  description: string | null
  status: string
  target_date: string | null
  area_id: string | null
  areaName: string | null
  areaIcon: string | null
  projectCount: number
  completedProjectCount: number
}> = []

try {
  await ensureSchema()
  const db = getPersistenceClient()
  const repo = new HierarchyRepository(db)
  const rawGoals = await repo.findAllGoals({
    ...(areaId ? { area_id: areaId } : {}),
    ...(projectId ? { project_id: projectId } : {}),
  })
  const areas = await repo.findAllAreas()
  const selectedProject = projectId ? await repo.findProjectById(projectId) : null
  const projects = projectId
    ? selectedProject ? [selectedProject] : []
    : await repo.findAllProjects(areaId ? { area_id: areaId } : {})

  const areaMap = new Map(areas.map((a) => [a.id, a]))
  scopedAreaName = areaId ? areaMap.get(areaId)?.name : undefined
  scopedProjectName = selectedProject?.title

  for (const g of rawGoals) {
    const area = g.area_id ? areaMap.get(g.area_id as string) : null
    const goalProjects = projects.filter((p) => String(p.goal_id) === String(g.id))
    const projectCount = goalProjects.length
    const completedProjectCount = goalProjects.filter((p) => String(p.status) === "completed").length

    goals.push({
      id: g.id as string,
      title: g.title as string,
      description: (g.description as string | null) ?? null,
      status: (g.status as string) || "active",
      target_date: (g.target_date as string | null) ?? null,
      area_id: (g.area_id as string | null) ?? null,
      areaName: area ? String(area.name) : null,
      areaIcon: area ? String(area.icon ?? "📁") : null,
      projectCount,
      completedProjectCount,
    })
  }
} catch {
  // Goals will be empty on error
}

const scopeName = scopedProjectName ?? scopedAreaName
const canCreate = !projectId && (!areaId || scopedAreaName)
const statusLabels: Record<string, string> = {
  active: "Active",
  completed: "Completed",
  archived: "Archived",
}
---

<div class="goals-tab" id="goals-tab-root" data-area-id={scopedAreaName ? areaId : undefined}>
  <header class="goals-tab__header">
    <div class="goals-tab__header-left">
      <span class="goals-tab__count">{goals.length} goal{goals.length !== 1 ? "s" : ""}{scopeName && ` · ${scopeName}`}</span>
      {(areaId || projectId) && <a href="/progress#goals">All Goals</a>}
    </div>
    {canCreate && <button type="button" class="btn btn-primary" id="goals-tab-new-btn">+ New Goal</button>}
  </header>

  {canCreate && (
    <form class="goals-tab__create-form" id="goals-tab-create-inline" hidden>
      <input type="text" id="goals-tab-create-input" aria-label="New goal title" placeholder="Goal title…" maxlength="200" autocomplete="off" required />
      <button type="submit" class="btn btn-primary">Create</button>
      <button type="button" class="btn btn-ghost" id="goals-tab-create-cancel">Cancel</button>
      <p role="status" id="goals-tab-create-error"></p>
    </form>
  )}

  {goals.length === 0 ? (
    <div class="goals-tab__empty">
      <div class="goals-tab__empty-icon">🎯</div>
      <h2 class="goals-tab__empty-title">No goals yet</h2>
      {canCreate && <p class="goals-tab__empty-desc">Create a goal to define an outcome for your work.</p>}
      {canCreate && <button type="button" class="btn btn-primary" id="goals-tab-empty-btn">
        Create Goal
      </button>}
      {scopedProjectName && projectId && (
        <a href={`/projects/${encodeURIComponent(projectId)}#settings`}>Choose a Goal in Project settings</a>
      )}
    </div>
  ) : (
    <div class="goals-tab__list">
      {goals.map((goal) => (
        <div class="goals-tab__card" data-goal-id={goal.id} data-goal-status={goal.status}>
          <div class="goals-tab__card-header">
            <h3 class="goals-tab__card-title">{goal.title}</h3>
            <div class="goals-tab__card-actions">
              <span class={`goals-tab__status-badge status-${goal.status}`}>
                {statusLabels[goal.status] ?? goal.status}
              </span>
              <div class="goals-tab__actions-row">
                {goal.status === "active" && (
                  <button type="button" class="goals-tab__action-btn goals-tab__complete-btn" data-goal-id={goal.id} title="Mark completed" aria-label="Mark goal completed">✓</button>
                )}
                {goal.status === "completed" && (
                  <button type="button" class="goals-tab__action-btn goals-tab__reactivate-btn" data-goal-id={goal.id} title="Reactivate" aria-label="Reactivate goal">↩</button>
                )}
                <button type="button" class="goals-tab__action-btn goals-tab__delete-btn" data-goal-id={goal.id} title="Delete goal" aria-label="Delete goal">🗑</button>
              </div>
            </div>
          </div>
          {goal.description && (
            <p class="goals-tab__card-desc">{goal.description.slice(0, 120)}{goal.description.length > 120 ? "…" : ""}</p>
          )}
          <div class="goals-tab__card-meta">
            {goal.projectCount > 0 && (
              <ProgressRing
                percent={goal.projectCount > 0 ? Math.round((goal.completedProjectCount / goal.projectCount) * 100) : 0}
                size={32}
                strokeWidth={3}
                label={`${goal.completedProjectCount}/${goal.projectCount} projects complete`}
              />
            )}
            {goal.areaName && (
              <span class="goals-tab__meta-area">{goal.areaIcon} {goal.areaName}</span>
            )}
            <span class="goals-tab__meta-projects">📋 {goal.projectCount} project{goal.projectCount !== 1 ? "s" : ""}</span>
            {goal.target_date && (
              <span class="goals-tab__meta-date">📅 {goal.target_date}</span>
            )}
          </div>
        </div>
      ))}
    </div>
  )}
</div>

<style>
  @reference "../../styles/global.css";

  .goals-tab {
    max-width: 900px;
    margin: 0 auto;
    padding: 0.5rem 0;
  }
  .goals-tab__create-form:not([hidden]) {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem;
    margin: 0 0 1rem;
  }
  .goals-tab__create-form input {
    flex: 1 0 12rem;
    min-width: 0;
  }
  #goals-tab-create-error:empty { display: none; }
  .goals-tab__header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 1.5rem;
    gap: 1rem;
  }
  .goals-tab__header-left {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.75rem;
    min-width: 0;
  }
  .goals-tab__count {
    font-size: 0.8125rem;
    color: var(--text-muted);
    overflow-wrap: anywhere;
  }

  .goals-tab__empty {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding: 4rem 2rem;
    text-align: center;
    border: 2px dashed var(--border);
    border-radius: var(--radius-lg, 12px);
  }
  .goals-tab__empty-icon { font-size: 48px; margin-bottom: 1rem; }
  .goals-tab__empty-title {
    font-size: 1.25rem;
    font-weight: 600;
    color: var(--text-primary);
    margin-bottom: 0.5rem;
  }
  .goals-tab__empty-desc {
    color: var(--text-muted);
    font-size: 0.875rem;
    margin-bottom: 1.5rem;
    max-width: 360px;
  }

  .goals-tab__list {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .goals-tab__card {
    background: var(--bg-card);
    border: 1px solid var(--border);
    border-radius: var(--radius-md);
    padding: 1rem 1.25rem;
    transition: border-color 200ms, box-shadow 200ms;
  }
  .goals-tab__card:hover {
    border-color: var(--accent);
    box-shadow: 0 2px 8px rgba(0,0,0,0.08);
  }
  .goals-tab__card--removing {
    opacity: 0;
    transform: translateX(-20px);
    transition: opacity 200ms, transform 200ms;
  }

  .goals-tab__card-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 0.75rem;
    margin-bottom: 0.375rem;
  }
  .goals-tab__card-title {
    font-size: 1rem;
    font-weight: 600;
    color: var(--text-primary);
    line-height: 1.3;
  }
  .goals-tab__status-badge {
    font-size: 0.6875rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    padding: 0.125rem 0.5rem;
    border-radius: 999px;
    white-space: nowrap;
    flex-shrink: 0;
  }
  .status-active {
    background: rgb(var(--accent-rgb) / 0.12);
    color: var(--accent);
  }
  .status-completed {
    background: rgb(var(--success-rgb) / 0.12);
    color: var(--success);
  }
  .status-archived {
    background: rgb(var(--text-muted-rgb, 169 183 176) / 0.12);
    color: var(--text-muted);
  }

  .goals-tab__card-desc {
    font-size: 0.8125rem;
    color: var(--text-secondary);
    margin-bottom: 0.5rem;
    line-height: 1.4;
  }

  .goals-tab__card-meta {
    display: flex;
    align-items: center;
    gap: 1rem;
    font-size: 0.75rem;
    color: var(--text-muted);
  }

  .goals-tab__card-actions {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    flex-shrink: 0;
  }
  .goals-tab__actions-row {
    display: flex;
    gap: 0.25rem;
    opacity: 0;
    transition: opacity 150ms;
  }
  .goals-tab__card:hover .goals-tab__actions-row,
  .goals-tab__card:focus-within .goals-tab__actions-row {
    opacity: 1;
  }
  .goals-tab__action-btn {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 28px;
    height: 28px;
    border: 1px solid var(--border);
    border-radius: var(--radius-sm);
    background: var(--bg-primary);
    cursor: pointer;
    font-size: 13px;
    transition: background 150ms, border-color 150ms;
  }
  .goals-tab__action-btn:hover {
    background: var(--bg-hover);
    border-color: var(--accent);
  }
  .goals-tab__delete-btn:hover {
    border-color: var(--danger);
    background: rgb(var(--danger-rgb) / 0.08);
  }
  .goals-tab__complete-btn:hover {
    border-color: var(--success);
    background: rgb(var(--success-rgb) / 0.08);
  }
</style>

<script>
  import { confirmDialog } from "@lib/confirm-dialog"
  import { pageLifecycle } from "@lib/page-lifecycle"

  pageLifecycle.onPageLoad(signal => {
    const root = document.getElementById("goals-tab-root")
    if (!root || root.dataset.bound) return
    root.dataset.bound = "true"
    signal.addEventListener("abort", () => { delete root.dataset.bound }, { once: true })

    const newButton = root.querySelector<HTMLButtonElement>("#goals-tab-new-btn")
    const emptyButton = root.querySelector<HTMLButtonElement>("#goals-tab-empty-btn")
    const form = root.querySelector<HTMLFormElement>("#goals-tab-create-inline")
    const title = form?.querySelector<HTMLInputElement>("#goals-tab-create-input")
    const error = form?.querySelector<HTMLElement>("#goals-tab-create-error")
    const save = form?.querySelector<HTMLButtonElement>("button[type=submit]")
    let trigger: HTMLButtonElement | null = null

    function dismiss() {
      if (!form) return
      form.hidden = true
      form.reset()
      if (error) error.textContent = ""
      trigger?.focus()
    }

    for (const button of [newButton, emptyButton]) {
      button?.addEventListener("click", () => {
        if (!form) return
        trigger = button
        form.hidden = false
        title?.focus()
      }, { signal })
    }

    form?.querySelector("#goals-tab-create-cancel")?.addEventListener("click", dismiss, { signal })
    form?.addEventListener("keydown", event => {
      if (event.key === "Escape") dismiss()
    }, { signal })
    form?.addEventListener("submit", async event => {
      event.preventDefault()
      const value = title?.value.trim()
      if (!value || !save || save.disabled) return
      save.disabled = true
      if (error) error.textContent = ""
      try {
        const response = await fetch("/api/goals", {
          method: "POST",
          headers: { "content-type": "application/json" },
          body: JSON.stringify({ title: value, area_id: root.dataset.areaId }),
          signal,
        })
        if (!response.ok) throw new Error("Goal could not be created")
        window.location.reload()
      } catch {
        if (signal.aborted) return
        if (error) error.textContent = "Could not create the Goal. Try again."
        save.disabled = false
        title?.focus()
      }
    }, { signal })

    root.addEventListener("click", async event => {
      const button = (event.target as HTMLElement).closest<HTMLButtonElement>(".goals-tab__action-btn")
      const id = button?.dataset.goalId
      if (!button || !id || button.disabled) return
      const remove = button.classList.contains("goals-tab__delete-btn")
      if (remove && !await confirmDialog({ message: "Delete this Goal?", variant: "danger", confirmText: "Delete", signal })) return
      button.disabled = true
      try {
        const response = await fetch("/api/goals/" + encodeURIComponent(id), remove ? {
          method: "DELETE", signal,
        } : {
          method: "PUT", signal, headers: { "content-type": "application/json" },
          body: JSON.stringify({ status: button.classList.contains("goals-tab__complete-btn") ? "completed" : "active" }),
        })
        if (!response.ok) throw new Error("Goal update failed")
        window.location.reload()
      } catch {
        if (signal.aborted) return
        button.disabled = false
        window.showToast?.("Could not update the Goal. Try again.", "error")
      }
    }, { signal })
  })
</script>
