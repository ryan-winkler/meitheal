---
import { t } from "../../i18n/translations"
import type { Locale } from "../../lib/locale"
import { SETTINGS_SECTIONS } from "../../lib/settings-registry"
import SettingsActionRow from "./SettingsActionRow.astro"
import SettingsPanelCard from "./SettingsPanelCard.astro"
import SettingsSectionIntro from "./SettingsSectionIntro.astro"
import Icon from "../ui/Icon.astro"

interface Props {
  locale: Locale
}
const { locale } = Astro.props

const peopleNotificationsSection = SETTINGS_SECTIONS.find((section) => section.id === "people-notifications-settings")!
---

<section
  id="people-notifications-settings"
  class="settings-shell__section"
  data-settings-shell-section
  hidden
>
  <SettingsSectionIntro section={peopleNotificationsSection} />
  <div class="settings-grid">
    <!-- Users & Assignment -->
    <SettingsPanelCard
      title={t("settings.people_assignment_title", locale)}
      subtitle={t("settings.people_assignment_desc", locale)}
    >
      <div class="settings-stack">
        <!-- Default Assignee -->
        <div>
          <label
            for="default-assignee-select"
            class="settings-label"
            >{t("settings.default_assignee", locale)}</label
          >
          <div style="display: flex; gap: 8px; align-items: center;">
            <select
              id="default-assignee-select"
              class="form-select settings-input-narrow"
              aria-label={t("settings.people_assignee_label", locale)}
              data-unavailable-assignee={t("settings.people_unavailable_assignee", locale)}
            >
              <option value="">{t("settings.people_unassigned", locale)}</option>
            </select>
            <button
              type="button"
              class="btn btn-primary settings-text-sm"
              id="save-default-assignee"
              >{t("settings.save", locale)}</button
            >
          </div>
          <p class="settings-hint">
            {t("settings.people_assignee_hint", locale)}
          </p>
        </div>

        <!-- Discovered Users -->
        <div>
          <div style="font-weight: 600; font-size: 13px; margin-bottom: 6px;">
            {t("settings.people_discovered", locale)}
          </div>
          <div
            id="discovered-users-list"
            class="settings-stack--xs"
          >
            <span class="settings-description">{t("settings.people_loading", locale)}</span>
          </div>
        </div>

        <!-- Custom Users -->
        <div class="settings-section-divider">
          <div
            style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 8px;"
          >
            <div style="font-weight: 600; font-size: 13px;">{t("settings.custom_users", locale)}</div>
          </div>
          <div
            id="custom-users-list"
            style="display: flex; flex-direction: column; gap: 6px;"
          >
          </div>
          <SettingsActionRow style="margin-top: 10px;">
            <input
              type="text"
              id="new-custom-user-name"
              class="form-input"
              placeholder={t("settings.people_name_placeholder", locale)}
              style="flex: 1; max-width: 200px;"
              aria-label={t("settings.people_new_user_label", locale)}
            />
            <button
              type="button"
              class="btn btn-ghost settings-text-sm"
              id="add-custom-user-btn"
              >{t("settings.people_add_user", locale)}</button
            >
          </SettingsActionRow>
        </div>
      </div>
    </SettingsPanelCard>

    <!-- Notifications -->
    <SettingsPanelCard
      title={t("settings.notif_workspace_title", locale)}
      subtitle={t("settings.notif_workspace_desc", locale)}
    >
      <div class="settings-stack">
        <!-- Global toggle -->
        <div style="display: flex; align-items: center; gap: 12px;">
          <label class="toggle-switch shrink-0">
            <input type="checkbox" id="notif-global-toggle" aria-labelledby="notif-global-toggle-label" checked />
            <span class="toggle-slider"></span>
          </label>
          <div>
            <div id="notif-global-toggle-label" style="font-weight: 600; font-size: 13px;">
              {t("settings.notif_enable", locale)}
            </div>
            <div class="settings-hint--sm">
              {t("settings.notif_enable_desc", locale)}
            </div>
          </div>
        </div>

        <!-- Notification Channels -->
        <div style="border-top: 1px solid var(--border); padding-top: 12px;">
          <div style="font-weight: 600; font-size: 13px; margin-bottom: 8px;">
            {t("settings.notif_channels", locale)}
          </div>
          <div class="settings-stack--sm">
            <!-- Sidebar Bell -->
            <div class="settings-row">
              <label class="toggle-switch shrink-0">
                <input type="checkbox" id="notif-channel-sidebar" aria-labelledby="notif-channel-sidebar-label" checked />
                <span class="toggle-slider"></span>
              </label>
              <div class="flex-1">
                <div id="notif-channel-sidebar-label" class="settings-label--inline inline-flex items-center gap-1.5">
                  <Icon name="bell" size={14} /> {t("settings.notif_sidebar_bell", locale)}
                </div>
                <div class="settings-hint--sm">
                  {t("settings.notif_sidebar_bell_desc", locale)}
                </div>
              </div>
            </div>
            <!-- Mobile Push -->
            <div class="settings-row">
              <label class="toggle-switch shrink-0">
                <input type="checkbox" id="notif-channel-mobile" aria-labelledby="notif-channel-mobile-label" />
                <span class="toggle-slider"></span>
              </label>
              <div class="flex-1">
                <div id="notif-channel-mobile-label" class="settings-label--inline inline-flex items-center gap-1.5">
                  <Icon name="phone" size={14} /> {t("settings.notif_mobile_push", locale)}
                </div>
                <div class="settings-hint--sm">
                  {t("settings.notif_mobile_push_desc", locale)}
                </div>
              </div>
            </div>
            <!-- Mobile push target selector (shown when mobile push enabled) -->
            <div
              id="notif-mobile-targets"
              style="display: none; padding: 8px 12px 12px 48px;"
            >
              <div
                style="font-size: 12px; color: var(--text-secondary); margin-bottom: 6px;"
              >
                {t("settings.notif_choose_devices", locale)}
              </div>
              <div
                id="notif-mobile-target-list"
                class="settings-stack--xs"
                aria-live="polite"
                data-loading={t("settings.notif_devices_loading", locale)}
                data-error={t("settings.notif_devices_error", locale)}
              >
                <span class="settings-description">{t("settings.notif_devices_loading", locale)}</span>
              </div>
              <button type="button" id="retry-notif-mobile-targets" class="btn btn-ghost settings-text-sm" hidden>
                {t("settings.notif_devices_retry", locale)}
              </button>
            </div>
            <!-- Due-Date Reminders toggle (F12) -->
            <div class="settings-row">
              <label class="toggle-switch shrink-0">
                <input type="checkbox" id="notif-channel-reminders" aria-labelledby="notif-channel-reminders-label" checked />
                <span class="toggle-slider"></span>
              </label>
              <div class="flex-1">
                <div id="notif-channel-reminders-label" class="settings-label--inline inline-flex items-center gap-1.5">
                  <Icon name="clock" size={14} /> {t("settings.notif_due_date", locale)}
                </div>
                <div class="settings-hint--sm">
                  {t("settings.notif_due_date_desc", locale)}
                </div>
              </div>
            </div>
            <!-- Reminder window config -->
            <div id="reminder-window-config" style="padding: 4px 12px 4px 48px;">
              <label
                style="font-size: 12px; color: var(--text-secondary); display: flex; align-items: center; gap: 8px;"
              >
                {t("settings.notif_remind_before", locale)}
                <input
                  type="number"
                  id="notif-reminder-minutes"
                  min="5"
                  max="1440"
                  value="60"
                  style="width: 60px; padding: 3px 6px; border: 1px solid var(--border); border-radius: 4px; font-size: 12px; background: var(--bg-primary);"
                />
                {t("settings.notif_remind_minutes", locale)}
              </label>
            </div>
          </div>
        </div>

        <!-- Per-user toggles (populated by JS) -->
        <div
          id="notif-user-toggles"
          style="display: flex; flex-direction: column; gap: 8px; border-top: 1px solid var(--border); padding-top: 12px;"
        >
          <div style="font-weight: 600; font-size: 13px; margin-bottom: 4px;">
            {t("settings.notif_per_user", locale)}
          </div>
          <span class="settings-description">{t("settings.notif_users_loading", locale)}</span>
        </div>

        <div>
          <p
            id="notif-prefs-status"
            class="settings-description"
            role="status"
            data-loading={t("settings.notif_prefs_loading", locale)}
            data-error={t("settings.notif_prefs_error", locale)}
          ></p>
          <button type="button" id="retry-notif-prefs" class="btn btn-ghost settings-text-sm" hidden>
            {t("settings.notif_prefs_retry", locale)}
          </button>
        </div>
        <button
          type="button"
          class="btn btn-primary"
          id="save-notif-prefs"
          disabled
          style="font-size: 13px; align-self: flex-start; min-width: 200px;"
        >
          {t("settings.notif_save", locale)}
        </button>
      </div>
    </SettingsPanelCard>
  </div>
</section>
