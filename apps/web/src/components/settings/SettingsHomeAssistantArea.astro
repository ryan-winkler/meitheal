---
import SettingsPanelCard from "./SettingsPanelCard.astro"
import { verifiedIngressUser } from "@lib/verified-ingress-user"

const eligible = verifiedIngressUser(Astro.locals)?.isAdmin === true
---

{eligible && (
  <SettingsPanelCard
    title="Home Assistant Area"
    subtitle="Give eligible people a location field on their tasks. The choices come from the Home Assistant area registry."
  >
    <form id="ha-area-feature-form" class="settings-stack">
      <fieldset class="settings-stack" disabled>
        <label class="form-label">Available to
          <select name="audience" class="form-select">
            <option value="everyone">Everyone</option>
            <option value="selected">Selected people</option>
            <option value="nobody" selected>Nobody</option>
          </select>
        </label>
        <fieldset data-ha-area-roster hidden class="settings-stack--xs">
          <legend class="form-label">Home Assistant accounts</legend>
          <div data-ha-area-users></div>
        </fieldset>
        <button type="submit" class="btn btn-primary">Save availability</button>
      </fieldset>
      <p class="settings-hint" role="status" data-ha-area-policy-status>Checking current availability…</p>
    </form>
  </SettingsPanelCard>
)}
