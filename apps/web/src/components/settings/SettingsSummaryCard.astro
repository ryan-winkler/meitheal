---
import type { SettingsSectionDescriptor } from "../../lib/settings-registry"

interface Props {
  section: SettingsSectionDescriptor
}

const { section } = Astro.props
---

<a
  class="settings-summary-card"
  id={`settings-summary-${section.id}`}
  href={`#${section.id}`}
  data-settings-section-link
  data-settings-summary={section.id}
>
  <span class="settings-summary-card__header">
    <span class="settings-summary-card__eyebrow-wrap">
      <span class="settings-summary-card__icon" aria-hidden="true">{section.icon}</span>
      <span class="settings-summary-card__eyebrow">{section.label}</span>
    </span>
    <span class="settings-summary-card__status">{section.statusLabel}</span>
  </span>
  <strong class="settings-summary-card__title">{section.summaryTitle}</strong>
  <span class="settings-summary-card__detail">{section.summaryDetail}</span>
  <span class="settings-summary-card__arrow" aria-hidden="true">→</span>
</a>
