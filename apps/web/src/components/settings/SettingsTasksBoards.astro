---
import SettingsHomeAssistantArea from "./SettingsHomeAssistantArea.astro"
import { t } from "../../i18n/translations"
import type { Locale } from "../../lib/locale"
import { SETTINGS_SECTIONS } from "../../lib/settings-registry"
import { VALID_CUSTOM_FIELD_TYPES } from "../../lib/custom-field-defs"
import TaskDetailLayoutEditor from "../tasks/TaskDetailLayoutEditor.astro"
import SettingsActionRow from "./SettingsActionRow.astro"
import SettingsLabels from "./SettingsLabels.astro"
import SettingsShoppingCategories from "./SettingsShoppingCategories.astro"
import SettingsPanelCard from "./SettingsPanelCard.astro"
import SettingsSectionIntro from "./SettingsSectionIntro.astro"
import Icon from "../ui/Icon.astro"

interface Props {
  locale: Locale
}
const { locale } = Astro.props

const tasksBoardsSection = SETTINGS_SECTIONS.find((section) => section.id === "tasks-boards-settings")!
---

<section
  id="tasks-boards-settings"
  class="settings-shell__section"
  data-settings-shell-section
  hidden
>
  <SettingsSectionIntro section={tasksBoardsSection} />
  <div class="settings-grid">
    <!-- Kanban Area -->
    <SettingsPanelCard
      title={t("settings.kanban_area_title", locale)}
      subtitle={t("settings.kanban_area_subtitle", locale)}
    >
      <div class="settings-stack">
        <!-- New task capture mode (shared with Advanced Setup) -->
        <div id="task-capture-mode-section">
          <div class="settings-field-head">
            <label for="task-capture-mode-select" class="settings-label">New task opens</label>
            <button
              type="button"
              class="settings-help-btn"
              data-settings-help="taskCaptureMode"
              data-help-title="New Task Capture Mode"
              data-help-body="Choose what opens when you press New task or the N shortcut on this browser. Quick add captures a task in one line with natural-language dates; Task form opens the complete editor with projects, labels, and scheduling."
              aria-label="Help for New task opens"
            >
              <Icon name="help" size={16} sprite={true} />
            </button>
          </div>
          <SettingsActionRow>
            <select
              id="task-capture-mode-select"
              class="form-select settings-input-narrow"
              aria-label="New task opens"
            >
              <option value="form">Task form (full details)</option>
              <option value="quick">Quick add (instant one-line capture)</option>
            </select>
            <button
              type="button"
              class="btn btn-primary settings-text-sm"
              id="save-task-capture-mode"
              >{t("settings.save", locale)}</button
            >
          </SettingsActionRow>
          <p
            id="task-capture-mode-help"
            class="settings-hint"
            data-mode-form="Opens the full New Task dialog with area, labels, due date, and description."
            data-mode-quick="Opens a compact one-line Quick Add prompt with natural-language date parsing."
          >
            Opens the full New Task dialog with area, labels, due date, and description.
          </p>
        </div>

        <div class="settings-section-divider"></div>

        <!-- After creating a task (per-user browser preference) -->
        <div id="after-task-create-section">
          <div class="settings-field-head">
            <label for="after-task-create-select" class="settings-label">After creating a task</label>
            <button
              type="button"
              class="settings-help-btn"
              data-settings-help="afterTaskCreate"
              data-help-title="After Creating a Task"
              data-help-body="Choose where Meitheal takes you after saving a new task on this browser. You can also toggle this right inside the New Task modal footer."
              aria-label="Help for After creating a task"
            >
              <Icon name="help" size={16} sprite={true} />
            </button>
          </div>
          <SettingsActionRow>
            <select
              id="after-task-create-select"
              class="form-select settings-input-narrow"
              aria-label="After creating a task"
            >
              <option value="board">Go back to board</option>
              <option value="open">Open created task</option>
            </select>
            <button
              type="button"
              class="btn btn-primary settings-text-sm"
              id="save-after-task-create"
              >{t("settings.save", locale)}</button
            >
          </SettingsActionRow>
          <p
            id="after-task-create-help"
            class="settings-hint"
            data-mode-board="Closes the dialog and returns to your current board or view with a toast link to open the new task."
            data-mode-open="Immediately opens the newly created task so you can add checklists, attachments, or comments."
          >
            Closes the dialog and returns to your current board or view with a toast link to open the new task.
          </p>
        </div>

        <div class="settings-section-divider"></div>

        <!-- Backlog Mode -->
        <div>
          <label
            for="backlog-mode-select"
            class="settings-label"
            >{t("settings.kanban_backlog_lane", locale)}</label
          >
          <SettingsActionRow>
            <select
              id="backlog-mode-select"
              class="form-select settings-input-narrow"
              aria-label={t("settings.kanban_backlog_lane_mode", locale)}
            >
              <option value="visible">{t("settings.kanban_backlog_visible", locale)}</option>
              <option value="hidden">{t("settings.kanban_backlog_hidden", locale)}</option>
              <option value="disabled">{t("settings.kanban_backlog_disabled", locale)}</option>
            </select>
            <button
              type="button"
              class="btn btn-primary settings-text-sm"
              id="save-backlog-mode"
              >{t("settings.save", locale)}</button
            >
          </SettingsActionRow>
          <div
            id="backlog-mode-help"
            class="settings-hint"
            data-mode-visible={t("triage.setting_visible", locale)}
            data-mode-hidden={t("triage.setting_hidden", locale)}
            data-mode-disabled={t("triage.setting_disabled", locale)}
          >
            {t("triage.setting_visible", locale)}
          </div>
        </div>

        <div class="settings-section-divider"></div>

        <div>
          <label
            for="completed-retention-select"
            class="settings-label"
            >{t("settings.kanban_retention", locale)}</label
          >
          <SettingsActionRow>
            <select
              id="completed-retention-select"
              class="form-select settings-input-narrow"
              aria-label={t("settings.kanban_retention_period", locale)}
            >
              <option value="7">{t("inactivity.interval", locale, { days: "7" })}</option>
              <option value="14">{t("inactivity.interval", locale, { days: "14" })}</option>
              <option value="30" selected>{t("inactivity.interval", locale, { days: "30" })}</option>
              <option value="0">{t("settings.kanban_retention_never", locale)}</option>
            </select>
            <button
              type="button"
              class="btn btn-primary settings-text-sm"
              id="save-completed-retention"
              >{t("settings.save", locale)}</button
            >
          </SettingsActionRow>
          <p class="settings-hint">
            {t("settings.kanban_retention_hint", locale)}
          </p>
        </div>
      </div>
    </SettingsPanelCard>

    <!-- Custom Fields -->
    <SettingsPanelCard
      title={t("settings.custom_fields_title", locale)}
      subtitle={t("settings.custom_fields_subtitle", locale)}
      padded={false}
    >
      <button type="button" class="btn btn-ghost" id="add-custom-field" slot="actions"
        >{t("settings.add_field", locale)}</button
      >
      <div id="custom-fields-list">
        <div class="custom-field-row">
          <input
            type="text"
            class="form-input"
            placeholder={t("settings.custom_field_name_label", locale)}
            value="sprint"
            disabled
          />
          <select class="form-select" aria-label={t("settings.custom_field_sprint_type", locale)} disabled>
            {[...VALID_CUSTOM_FIELD_TYPES].map((type) => (
              <option value={type} selected={type === "text"}>{t(`settings.custom_field_type_${type}` as any, locale)}</option>
            ))}
          </select>
          <span class="settings-text-xs text-muted">{t("settings.built_in", locale)}</span>
        </div>
        <div class="custom-field-row">
          <input
            type="text"
            class="form-input"
            placeholder={t("settings.custom_field_name_label", locale)}
            value="story_points"
            disabled
          />
          <select class="form-select" aria-label={t("settings.custom_field_story_points_type", locale)} disabled>
            <option value="number" selected>{t("settings.custom_field_type_number", locale)}</option>
          </select>
          <span class="settings-text-xs text-muted">{t("settings.built_in", locale)}</span>
        </div>
      </div>
    </SettingsPanelCard>

    <!-- Labels -->
    <SettingsLabels locale={locale} />

    <!-- Shopping Categories (Grocy-compatible) -->
    <SettingsShoppingCategories />

    <!-- Optional Features -->
    <SettingsPanelCard
      title={t("settings.features_title", locale)}
      subtitle={t("settings.features_desc", locale)}
    >
      <div id="feature-toggles-container" class="settings-stack--sm" style="gap: 10px;" data-save-error={t("settings.feature_save_error", locale)}>
        <span class="settings-description">{t("settings.features_loading", locale)}</span>
      </div>
    </SettingsPanelCard>
    <SettingsHomeAssistantArea />
  </div>
  <div id="settings-task-detail-layout" class="mt-6">
    <SettingsPanelCard
      title="Task & Form Layouts"
      subtitle="Customize section and field order, visibility, and labels per task kind and for Routine, Pillar, and Goal forms."
    >
      <TaskDetailLayoutEditor locale={locale} allowServerSave={true} />
    </SettingsPanelCard>
  </div>
</section>
