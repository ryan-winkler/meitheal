---
import { t } from "../../i18n/translations"
import { APPEARANCE_PREFERENCES, type AppearancePreferenceName } from "../../lib/appearance-preferences"
import type { Locale } from "../../lib/locale"
import { SETTINGS_SECTIONS } from "../../lib/settings-registry"
import { TASK_NAV_TYPES } from "../../lib/task-nav-types"
import KeyboardShortcutList from "../layout/KeyboardShortcutList.astro"
import SettingsActionRow from "./SettingsActionRow.astro"
import SettingsOrganizationLabels from "./SettingsOrganizationLabels.astro"
import SettingsPanelCard from "./SettingsPanelCard.astro"
import SettingsSectionIntro from "./SettingsSectionIntro.astro"
import Icon from "../ui/Icon.astro"

interface Props {
  locale: Locale
}
const { locale } = Astro.props

const navigationSection = SETTINGS_SECTIONS.find((section) => section.id === "navigation-settings")!

const NAV_PREFERENCE_KEYS: readonly AppearancePreferenceName[] = [
  "navigation",
  "navTone",
  "navStyle",
  "sidebar",
]
---

<section
  id="navigation-settings"
  class="settings-shell__section"
  data-settings-shell-section
  hidden
>
  <SettingsSectionIntro section={navigationSection} />
  <div class="settings-grid">
    <SettingsOrganizationLabels locale={locale} />
    <!-- Navigation Layout & Hover Behavior -->
    <SettingsPanelCard
      title={t("settings.nav_layout_card_title", locale)}
      subtitle={t("settings.nav_layout_card_subtitle", locale)}
    >
      <form id="navigation-appearance-form" data-appearance-form="navigation" class="appearance-preferences-form" aria-describedby="navigation-appearance-scope">
        <p id="navigation-appearance-scope" class="settings-hint">{t("settings.appearance_scope", locale)}</p>
        <div class="appearance-preferences-grid">
          {NAV_PREFERENCE_KEYS.map((name) => {
            const preference = APPEARANCE_PREFERENCES[name]
            return (
              <div class="form-group">
                <label class="form-label" for={`appearance-${name}`}>{t(`settings.appearance_${name}`, locale)}</label>
                <select class="form-select" id={`appearance-${name}`} name={name} aria-describedby={`appearance-${name}-help`}>
                  {preference.options.map((value) => (
                    <option value={value} selected={value === preference.defaultValue}>
                      {t(`settings.appearance_${name}_${value.replace(".", "_")}`, locale)}
                    </option>
                  ))}
                </select>
                <p id={`appearance-${name}-help`} class="settings-hint">{t(`settings.appearance_${name}_help`, locale)}</p>
              </div>
            )
          })}
        </div>
        <div class="flex flex-wrap items-center justify-between gap-2 appearance-preferences-form__footer">
          <button type="reset" class="btn btn-secondary">{t("settings.appearance_reset", locale)}</button>
          <button type="submit" class="btn btn-primary" data-appearance-save>
            <Icon name="check" size={15} sprite={true} />
            <span>{t("settings.nav_layout_save", locale)}</span>
          </button>
        </div>
        <div class="settings-dirty-bar" data-appearance-dirty-bar role="status" aria-live="polite" hidden>
          <span class="settings-dirty-bar__info">
            <span class="settings-dirty-bar__icon" aria-hidden="true"><Icon name="alert-triangle" size={16} sprite={true} /></span>
            <span data-appearance-dirty-text>Unsaved changes — previewing live.</span>
          </span>
          <div class="settings-dirty-bar__actions">
            <button type="button" class="btn btn-secondary btn-sm" data-appearance-discard>
              <Icon name="refresh" size={14} sprite={true} />
              <span>Discard</span>
            </button>
            <button type="submit" class="btn btn-primary btn-sm" data-appearance-save>
              <Icon name="check" size={14} sprite={true} />
              <span>{t("settings.nav_layout_save", locale)}</span>
            </button>
          </div>
        </div>
        <p
          id="navigation-appearance-save-status"
          data-appearance-status
          class="settings-hint mt-2"
          role="status"
          data-saved={t("settings.appearance_saved", locale)}
          data-reset={t("settings.appearance_reset_staged", locale)}
          data-error={t("settings.appearance_save_error", locale)}
        ></p>
      </form>
    </SettingsPanelCard>

    <SettingsPanelCard
      title={t("settings.task_nav_prefs_title", locale)}
      subtitle={t("settings.task_nav_prefs_subtitle", locale)}
    >
      <div id="task-nav-prefs-card" class="settings-stack">
        <div>
          <span class="settings-label">{t("settings.task_nav_mode_label", locale)}</span>
          <div class="task-nav-mode-group" role="group" aria-label={t("settings.task_nav_mode_label", locale)}>
            <button type="button" class="btn btn-secondary settings-text-sm" data-task-nav-mode="all">
              {t("settings.task_nav_mode_all", locale)}
            </button>
            <button type="button" class="btn btn-secondary settings-text-sm" data-task-nav-mode="custom">
              {t("settings.task_nav_mode_custom", locale)}
            </button>
            <button type="button" class="btn btn-secondary settings-text-sm" data-task-nav-mode="none">
              {t("settings.task_nav_mode_none", locale)}
            </button>
          </div>
        </div>

        <div class="settings-stack--xs" id="task-nav-type-rows">
          {TASK_NAV_TYPES.map((entry) => (
            <div class="task-nav-pref-row" data-task-nav-row={entry.id}>
              <label class="task-nav-pref-row__check">
                <input
                  type="checkbox"
                  data-task-nav-visible={entry.id}
                  checked
                />
                <span>{entry.label}</span>
              </label>
              <button
                type="button"
                class="btn btn-ghost settings-text-sm task-nav-pin-btn"
                data-task-nav-pin={entry.id}
                aria-pressed="false"
                aria-label={`${t("settings.task_nav_pin", locale)} · ${entry.label}`}
              >
                {t("settings.task_nav_pin", locale)}
              </button>
            </div>
          ))}
        </div>
        <p class="settings-hint">{t("settings.task_nav_prefs_hint", locale)}</p>
      </div>
    </SettingsPanelCard>

    <!-- Sidebar Configuration -->
    <SettingsPanelCard
      title={t("settings.sidebar_config_title", locale)}
      subtitle={t("settings.sidebar_config_desc", locale)}
    >
      <div>
        <div class="mb-4">
          <button
            type="button"
            id="nav-customize-menu"
            class="btn btn-primary sidebar-customize-cta"
            data-customize-sidebar-menu
          >
            {t("sidebar.customize_menu", locale)}
          </button>
          <p class="settings-hint mt-1">{t("sidebar.customize_menu_hint", locale)}</p>
        </div>
        <div
          id="sidebar-item-list"
          class="settings-stack--sm"
        >
          <!-- Populated by JS -->
        </div>
        <div class="settings-section-divider--spaced">
          <div style="margin-bottom: 8px; font-weight: 500;">{t("settings.sidebar_custom_links", locale)}</div>
          <div
            id="custom-links-list"
            style="display: flex; flex-direction: column; gap: 8px; margin-bottom: 12px;"
          >
          </div>
          <button type="button" class="btn btn-ghost" id="add-custom-link-btn"
            >{t("settings.sidebar_add_custom_link", locale)}</button
          >
        </div>
        <SettingsActionRow class="mt-4">
          <button
            type="button"
            class="btn btn-primary settings-text-sm"
            id="save-sidebar"
            >{t("settings.sidebar_save_config", locale)}</button
          >
          <button
            type="button"
            class="btn btn-ghost settings-text-sm"
            id="reset-sidebar"
            >{t("settings.sidebar_reset_default", locale)}</button
          >
        </SettingsActionRow>
      </div>
    </SettingsPanelCard>

    <!-- Keyboard Shortcuts -->
    <SettingsPanelCard
      title={t("settings.shortcuts_title", locale)}
      subtitle={t("settings.shortcuts_subtitle", locale)}
    >
      <label class="flex items-center gap-2">
        <input id="single-key-shortcuts" type="checkbox" checked />
        {t("settings.shortcut_single_keys", locale)}
      </label>
      <KeyboardShortcutList locale={locale} variant="settings" />
    </SettingsPanelCard>
  </div>
</section>

<style>

  .task-nav-mode-group {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-top: 6px;
  }

  .task-nav-pref-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    padding: 8px 12px;
    border: 1px solid var(--border);
    border-radius: var(--radius-sm);
    background: var(--bg-secondary);
  }

  .task-nav-pref-row__check {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    min-height: 36px;
    font-size: 14px;
    font-weight: 500;
    cursor: pointer;
  }

  .task-nav-pin-btn {
    min-height: 36px;
  }

  .sidebar-customize-cta {
    width: 100%;
    min-height: 42px;
    justify-content: center;
    font-weight: 600;
  }

  :global(.sidebar-config-section) {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    padding: 0.75rem;
    border: 1px solid var(--border);
    border-radius: var(--radius-md, 8px);
    background: var(--bg-card);
  }

  :global(.sidebar-config-section--hidden) {
    opacity: 0.65;
  }

  :global(.sidebar-config-section__header) {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr) auto;
    align-items: center;
    gap: 0.5rem;
    padding-bottom: 0.5rem;
    border-bottom: 1px solid var(--border);
  }

  :global(.sidebar-config-section__items) {
    display: flex;
    flex-direction: column;
    gap: 0.375rem;
  }

  :global(.sidebar-config-row) {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr) auto;
    align-items: center;
    gap: 0.5rem;
    padding: 0.5rem;
    border: 1px solid var(--border);
    border-radius: var(--radius-sm);
    background: var(--bg-secondary);
  }

  :global(.sidebar-config-row .drag-handle) {
    grid-row: span 2;
    padding: 0.5rem;
    cursor: grab;
    color: var(--text-secondary);
    user-select: none;
  }

  :global(.sidebar-config-row__visibility) {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    min-height: 44px;
    min-width: 0;
    font-weight: 500;
    overflow-wrap: anywhere;
  }

  :global(.sidebar-config-row__moves) {
    display: flex;
    grid-column: 3;
    grid-row: 1 / span 2;
  }

  :global(.sidebar-config-row__moves .btn),
  :global(.sidebar-custom-link .btn) {
    min-width: 44px;
    min-height: 44px;
    padding-inline: 0.5rem;
  }

  :global(.sidebar-config-row .sidebar-label-input) {
    grid-column: 2;
    min-width: 0;
    width: 100%;
  }

  :global(.sidebar-custom-link) {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: 0.5rem;
    padding: 0.5rem;
    border: 1px solid var(--border);
    border-radius: var(--radius-sm);
    background: var(--bg-secondary);
  }

  :global(.sidebar-custom-link .form-input) {
    width: 100%;
    min-width: 0;
  }

  :global(.sidebar-custom-link .custom-item-href) {
    grid-column: 1;
  }

  :global(.sidebar-custom-link .remove-custom-link) {
    grid-column: 2;
    grid-row: 1 / span 2;
    align-self: center;
  }

  @media (max-width: 480px) {
    :global(.sidebar-config-row) {
      grid-template-columns: minmax(0, 1fr) auto;
    }

    :global(.sidebar-config-row .drag-handle) {
      display: none;
    }

    :global(.sidebar-config-row__moves) {
      grid-column: 2;
    }

    :global(.sidebar-config-row .sidebar-label-input) {
      grid-column: 1;
    }
  }
</style>
