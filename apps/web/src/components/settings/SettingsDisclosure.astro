---
interface Props {
  id?: string
  title: string
  subtitle?: string
  open?: boolean
}

const {
  id,
  title,
  subtitle,
  open = false,
} = Astro.props
---

<details id={id} class="settings-disclosure" open={open}>
  <summary class="settings-disclosure__summary">
    <span>
      {title}
      {subtitle && <small>{subtitle}</small>}
    </span>
  </summary>
  <div class="settings-disclosure__body">
    <slot />
  </div>
</details>

<style>
  .settings-disclosure {
    border: 1px solid var(--border);
    border-radius: 14px;
    background: color-mix(in srgb, var(--bg-secondary) 78%, transparent);
    overflow: clip;
  }

  .settings-disclosure + .settings-disclosure {
    margin-top: 12px;
  }

  .settings-disclosure__summary {
    display: flex;
    align-items: center;
    gap: 8px;
    min-block-size: 44px;
    padding: 12px 16px;
    list-style: none;
    cursor: pointer;
    color: var(--text-primary);
    font-size: 14px;
    font-weight: 600;
  }

  .settings-disclosure__summary small {
    display: block;
    margin-top: 4px;
    color: var(--text-secondary);
    font-size: 0.8125rem;
    font-weight: 400;
  }

  .settings-disclosure__summary::-webkit-details-marker {
    display: none;
  }

  .settings-disclosure__summary::after {
    content: "▾";
    margin-left: auto;
    color: var(--text-muted);
    transition: transform 150ms ease;
  }

  .settings-disclosure[open] .settings-disclosure__summary::after {
    transform: rotate(180deg);
  }

  .settings-disclosure__body {
    padding: 0 16px 16px;
    color: var(--text-secondary);
    font-size: 13px;
    line-height: 1.65;
  }

  .settings-disclosure__body :global(p:first-child) {
    margin-top: 0;
  }

  .settings-disclosure__body :global(p:last-child) {
    margin-bottom: 0;
  }
</style>
