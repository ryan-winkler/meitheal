---
import { AVAILABLE_SCOPES } from "@meitheal/domain-auth"
import SettingsPanelCard from "./SettingsPanelCard.astro"

/**
 * SettingsAgentTokens — Manage scoped agent API tokens.
 *
 * Shows existing tokens with scope badges, lets admins create
 * new tokens (show-once plaintext), revoke, and delete.
 * Client interactivity is wired via settings-agent-tokens-controller.ts.
 *
 * @domain settings
 * @bounded-context agent-authorization
 * @kcs Agent tokens enable zero-trust API access for n8n, Node-RED, and LLM agents.
 */

const canManageTokens = Astro.locals.hassIsAdmin === true && !Astro.locals.agentToken

const scopeGroups = [
  { label: "Tasks", category: "tasks" },
  { label: "Projects", category: "projects" },
  { label: "Search", category: "search" },
  { label: "Protocols", category: "protocols" },
] as const
---

<div class="settings-grid mt-4">
  <SettingsPanelCard
    id="agent-tokens-card"
    title="🔑 Agent Tokens"
    subtitle="Issue scoped API tokens for n8n, Node-RED, LLM agents, and automations. Tokens use zero-trust principles — each gets only the permissions it needs."
  >
    <button
      slot="actions"
      type="button"
      class="btn btn-primary"
      id="agent-token-create-btn"
      disabled={!canManageTokens}
      data-can-manage-tokens={canManageTokens ? "true" : "false"}
      style="font-size: 13px; white-space: nowrap;"
    >+ New Token</button>

    <!-- Token List -->
    <div id="agent-tokens-list" class="agent-tokens__list">
      <div class="agent-tokens__status" id="agent-tokens-status" role="status" aria-live="polite" hidden={canManageTokens}>
        {!canManageTokens && "Home Assistant administrator access is required to view or issue agent tokens."}
      </div>
      <div class="agent-tokens__empty" id="agent-tokens-empty" hidden>
        <span style="font-size: 24px;">🔒</span>
        <p>No agent tokens yet</p>
        <p class="agent-tokens__empty-hint">Create a token to let external tools access your API securely.</p>
      </div>
    </div>

    <!-- Create Token Form (hidden by default) -->
    <div id="agent-token-form" class="agent-tokens__form" hidden>
      <div class="agent-tokens__form-header">
        <strong>Create New Token</strong>
        <button type="button" class="btn btn-ghost btn-sm" id="agent-token-form-cancel">Cancel</button>
      </div>

      <div class="form-group">
        <label class="form-label" for="agent-token-name">Token Name</label>
        <input
          type="text"
          class="form-input"
          id="agent-token-name"
          placeholder="e.g., n8n-prod, nodered-home, claude-agent"
          maxlength="100"
          autocomplete="off"
          data-lpignore="true"
        />
      </div>

      <fieldset class="form-group" style="border: 0; padding: 0; margin: 0;">
        <legend class="form-label">Scopes</legend>
        <div class="agent-tokens__scope-grid">
          {scopeGroups.map((group) => (
            <div class="agent-tokens__scope-group">
              <div class="agent-tokens__scope-group-label">{group.label}</div>
              {AVAILABLE_SCOPES.filter(scope => scope.category === group.category).map((scope) => (
                <label class="agent-tokens__scope-item" title={scope.description}>
                  <input type="checkbox" name="agent-token-scopes" value={scope.scope} />
                  <code>{scope.scope}</code>
                </label>
              ))}
            </div>
          ))}
        </div>
      </fieldset>

      <div class="form-group">
        <label class="form-label" for="agent-token-assignee">Assigned User or Agent (required for <code>tasks:write:assigned</code>)</label>
        <select class="form-select" id="agent-token-assignee">
          <option value="">None (unassigned)</option>
        </select>
      </div>

      <div class="form-group">
        <label class="form-label" for="agent-token-expires">Expiry (optional)</label>
        <select class="form-select" id="agent-token-expires">
          <option value="">No expiry</option>
          <option value="7d">7 days</option>
          <option value="30d">30 days</option>
          <option value="90d">90 days</option>
          <option value="1y">1 year</option>
        </select>
      </div>

      <button type="button" class="btn btn-primary" id="agent-token-save">
        Create Token
      </button>
    </div>

    <!-- Show-Once Token Display (hidden by default) -->
    <div id="agent-token-reveal" class="agent-tokens__reveal" hidden>
      <div class="agent-tokens__reveal-warning">
        ⚠️ Copy this token now — it will not be shown again.
      </div>
      <div class="agent-tokens__reveal-token">
        <code id="agent-token-plaintext"></code>
        <button type="button" class="btn btn-ghost btn-sm" id="agent-token-copy">📋 Copy</button>
      </div>
      <button type="button" class="btn btn-primary" id="agent-token-reveal-done">Done</button>
    </div>
  </SettingsPanelCard>
</div>

<style is:inline>
  #agent-tokens-card [hidden] {
    display: none;
  }
  .agent-tokens__list {
    display: flex;
    flex-direction: column;
    gap: 1px;
    background: var(--border);
    border-top: 1px solid var(--border);
  }
  .agent-tokens__list:not(:has(> .agent-tokens__row, > #agent-tokens-status:not([hidden]))) {
    background: transparent;
    border-top: none;
  }
  .agent-tokens__empty:not([hidden]) {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 4px;
    padding: 32px 16px;
    color: var(--text-muted);
    font-size: 13px;
    text-align: center;
    background: var(--bg-card);
  }
  .agent-tokens__empty-hint {
    font-size: 12px;
    color: var(--text-secondary);
  }
  .agent-tokens__status {
    padding: 16px;
    text-align: center;
    color: var(--text-muted);
    font-size: 13px;
    background: var(--bg-card);
  }
  .agent-tokens__row {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 12px 16px;
    background: var(--bg-card);
    font-size: 13px;
  }
  .agent-tokens__row-info {
    flex: 1;
    min-width: 0;
  }
  .agent-tokens__row-name {
    font-weight: 600;
    color: var(--text-primary);
  }
  .agent-tokens__row-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 4px;
    margin-top: 4px;
    font-size: 11px;
    color: var(--text-muted);
  }
  .agent-tokens__scope-badge {
    display: inline-flex;
    align-items: center;
    padding: 1px 6px;
    border-radius: 4px;
    background: color-mix(in srgb, var(--accent) 12%, transparent);
    color: var(--accent-text);
    font-size: 10px;
    font-family: "JetBrains Mono", monospace;
  }
  .agent-tokens__row-prefix {
    font-family: "JetBrains Mono", monospace;
    font-size: 11px;
    color: var(--text-muted);
  }
  .agent-tokens__row-actions {
    display: flex;
    gap: 4px;
    flex-shrink: 0;
  }
  .agent-tokens__form:not([hidden]) {
    padding: 16px;
    border-top: 1px solid var(--border);
    display: flex;
    flex-direction: column;
    gap: 12px;
  }
  .agent-tokens__form-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
  }
  .agent-tokens__scope-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(160px, 1fr));
    gap: 8px;
  }
  .agent-tokens__scope-group {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }
  .agent-tokens__scope-group-label {
    font-size: 11px;
    font-weight: 600;
    color: var(--text-muted);
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }
  .agent-tokens__scope-item {
    display: flex;
    align-items: center;
    gap: 6px;
    font-size: 12px;
    cursor: pointer;
  }
  .agent-tokens__scope-item code {
    font-size: 11px;
    font-family: "JetBrains Mono", monospace;
  }
  .agent-tokens__reveal:not([hidden]) {
    padding: 16px;
    border-top: 1px solid var(--border);
    display: flex;
    flex-direction: column;
    gap: 12px;
  }
  .agent-tokens__reveal-warning {
    font-size: 13px;
    font-weight: 600;
    color: var(--warning-text, var(--warning, #f59e0b));
    padding: 8px 12px;
    border-radius: 8px;
    background: color-mix(in srgb, var(--warning, #f59e0b) 10%, var(--bg-card));
    border: 1px solid color-mix(in srgb, var(--warning, #f59e0b) 30%, transparent);
  }
  .agent-tokens__reveal-token {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 10px 12px;
    background: var(--bg-secondary);
    border: 1px solid var(--border);
    border-radius: 8px;
    font-family: "JetBrains Mono", monospace;
    font-size: 12px;
    word-break: break-all;
  }
  .agent-tokens__reveal-token code {
    flex: 1;
    min-width: 0;
    color: var(--text-primary);
  }
  .agent-tokens__revoked .agent-tokens__row-name {
    text-decoration: line-through;
    color: var(--text-muted);
  }
</style>
