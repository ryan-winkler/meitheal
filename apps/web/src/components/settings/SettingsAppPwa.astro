          target="_blank"
          rel="noopener noreferrer"
          class="btn btn-ghost btn-sm"
        >
          <span>Commercial License</span>
        </a>
      </div>
    </div>

    {aboutDocs.licenseText && (
      <SettingsDisclosure icon="file-text" title="Full AGPL-3.0-only License Text (from repository LICENSE)">
        <pre class="about-legal-pre">{aboutDocs.licenseText}</pre>
      </SettingsDisclosure>
    )}
    {aboutDocs.noticeText && (
      <SettingsDisclosure icon="info-circle" title="Third-Party Notices (from repository NOTICE)">
        <pre class="about-legal-pre">{aboutDocs.noticeText}</pre>
      </SettingsDisclosure>
