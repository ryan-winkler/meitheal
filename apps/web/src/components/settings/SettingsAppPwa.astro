---
import { verifyLicenseKey } from "@meitheal/domain-auth"
import { t } from "../../i18n/translations"
import type { Locale } from "../../lib/locale"
import { SETTINGS_SECTIONS } from "../../lib/settings-registry"
import Icon from "../ui/Icon.astro"
import SettingsActionRow from "./SettingsActionRow.astro"
import SettingsCallout from "./SettingsCallout.astro"
import SettingsDisclosure from "./SettingsDisclosure.astro"
import SettingsFeedback from "./SettingsFeedback.astro"
import SettingsPanelCard from "./SettingsPanelCard.astro"
import SettingsSectionIntro from "./SettingsSectionIntro.astro"

interface Props {
  locale: Locale
  databaseDownloadToken?: string | undefined
}
const { locale } = Astro.props

// Dynamic version — injected at build time from meitheal-hub/config.yaml via
// vite.define in astro.config.mjs. Runtime env var takes precedence (Docker).
declare const __MEITHEAL_VERSION__: string
const version =
  import.meta.env.MEITHEAL_VERSION ||
  process.env.MEITHEAL_VERSION ||
  (typeof __MEITHEAL_VERSION__ !== "undefined"
    ? __MEITHEAL_VERSION__
    : "0.0.0-dev")
const appPwaSection = SETTINGS_SECTIONS.find((section) => section.id === "app-pwa-settings")!
const license = verifyLicenseKey(process.env.MEITHEAL_LICENSE_KEY)
const licenseStatus = !license.valid ? "invalid" : "grace" in license ? "grace" : "verified"
---

<section
  id="app-pwa-settings"
  class="settings-shell__section"
  data-settings-shell-section
  hidden
>
  <SettingsSectionIntro section={appPwaSection} />
  <div class="settings-grid">
  <SettingsFeedback version={version} />
  <!-- About -->
  <SettingsPanelCard
    title={t("settings.app_readiness_title", locale)}
    subtitle={t("settings.app_readiness_subtitle", locale)}
    tone="accent"
  >
    <div
      style="font-size: 13px; color: var(--text-secondary); line-height: 1.8;"
    >
      <SettingsCallout title={t("settings.app_readiness_callout_title", locale)} icon="phone" tone="info">
        {t("settings.app_readiness_callout_desc", locale)}
      </SettingsCallout>
      <p set:html={t("settings.pwa_about_p1", locale)}></p>
      <p>{t("settings.pwa_about_p2", locale)}</p>
      <p style="margin-top: 8px;">
        {t("settings.pwa_version", locale)} <code>{version}</code>
        <span class="pwa-link-separator" aria-hidden="true">·</span>
        <span>{t("settings.app_license_label", locale)}</span>
        <span id="app-license-status" class:list={["badge", license.valid ? "badge-active" : "badge-pending"]} style="font-size: 12px; margin-left: 6px;">{t(`settings.app_license_${licenseStatus}`, locale)}</span>
      </p>
      <div
        id="pwa-status-compact"
        class="pwa-compact-row"
        style="margin-top: 8px;"
      >
        <div
          style="display: flex; align-items: center; gap: 8px; flex-wrap: wrap;"
        >
          <span
            class="pwa-compact-dot"
            id="pwa-compact-dot"
            aria-hidden="true"></span>
          <span
            style="font-size: 13px; color: var(--text-secondary);"
            id="pwa-compact-label"
            data-active-text={t("settings.pwa_active", locale)}
            data-http-text={t("settings.pwa_req_https", locale)}
            >{t("settings.pwa_checking", locale)}</span
          >
          <span
            class="badge badge-pending"
            id="pwa-compact-badge"
            data-active-text={t("settings.pwa_active_badge", locale)}
            data-http-text={t("settings.pwa_req_https_badge", locale)}
            style="font-size: 12px;">{t("settings.pwa_checking_badge", locale)}</span
          >
          <span
            id="pwa-compact-version"
            style="font-size: 12px; color: var(--text-secondary); font-family: var(--font-mono); display: none;"
          ></span>
          <a
            href="#"
            id="pwa-install-settings-btn"
            class="pwa-subtle-link"
            style="display: none;">{t("settings.pwa_install", locale)}</a
          >
          <button
            type="button"
            id="pwa-update-settings-btn"
            class="pwa-subtle-link"
            style="display: none;">{t("settings.pwa_update_available", locale)}</button
          >
          <span
            id="pwa-installed-badge"
            class="badge badge-active"
            style="font-size: 11px; display: none;"><Icon name="check" size={12} sprite={true} /> <span>{t("settings.pwa_installed", locale)}</span></span
          >
          <span class="pwa-link-separator" aria-hidden="true">·</span>
          <a
            href="#"
            id="pwa-popout-btn"
            class="pwa-subtle-link"
            title={t("settings.pwa_open_browser_title", locale)}
            >{t("settings.pwa_open_browser", locale)}<span class="sr-only"> {t("settings.pwa_new_tab_sr", locale)}</span></a
          >
          <span class="pwa-link-separator" aria-hidden="true">·</span>
          <button
            type="button"
            id="pwa-uninstall-btn"
            class="pwa-subtle-link"
            aria-expanded="false"
            aria-controls="pwa-uninstall-info"
            >{t("settings.pwa_uninstall", locale)}</button
          >
        </div>
        <!-- Uninstall instructions (hidden by default) -->
        <div
          id="pwa-uninstall-info"
          style="display: none; margin-top: 6px; font-size: 12px; color: var(--text-muted); line-height: 1.6; padding: 8px 12px; background: var(--bg-secondary); border-radius: 8px;"
        >
          <p set:html={t("settings.pwa_uninstall_how", locale)}></p>
          <small style="margin-top: 4px; display: block;"
            >{t("settings.pwa_uninstall_safe", locale)}</small
          >
        </div>
        <details
          id="pwa-compact-details"
          style="display: none; margin-top: 6px;"
        >
          <summary
            style="font-size: 12px; color: var(--accent-text); cursor: pointer; list-style: none;"
          >
            {t("settings.pwa_why_unavailable", locale)}
          </summary>
          <div
            style="margin-top: 6px; font-size: 12px; color: var(--text-muted); line-height: 1.6; padding: 8px 12px; background: var(--bg-secondary); border-radius: 8px;"
            set:html={t("settings.pwa_why_unavailable_desc", locale)}
          >
          </div>
        </details>
        <!-- PWA Troubleshooting -->
        <details id="pwa-troubleshoot" style="margin-top: 6px;">
          <summary
            class="pwa-subtle-link"
            style="list-style: none; cursor: pointer; display: inline-flex; align-items: center;"
            >{t("settings.pwa_troubleshooting", locale)}</summary
          >
          <div class="pwa-troubleshoot-panel">
            <p
              style="margin: 0 0 8px; font-size: 12px; color: var(--text-muted);"
            >
              {t("settings.pwa_troubleshoot_desc", locale)}
            </p>
            <div style="display: flex; gap: 6px; flex-wrap: wrap;">
              <button
                type="button"
                id="pwa-clear-cache-btn"
                class="btn btn-ghost pwa-troubleshoot-btn"
                ><Icon name="trash" size={13} sprite={true} /> <span>{t("settings.pwa_clear_cache", locale)}</span></button
              >
              <button
                type="button"
                id="pwa-force-update-btn"
                class="btn btn-ghost pwa-troubleshoot-btn"
                ><Icon name="refresh" size={13} sprite={true} /> <span>{t("settings.pwa_force_update", locale)}</span></button
              >
              <button
                type="button"
                id="pwa-clear-offline-btn"
                class="btn btn-ghost pwa-troubleshoot-btn"
                data-unattributed-notice={t("settings.pwa_unattributed_offline", locale)}
                ><Icon name="database" size={13} sprite={true} /> <span>{t("settings.pwa_clear_offline", locale)}</span></button
              >
            </div>
            <div
              style="display: flex; gap: 6px; flex-wrap: wrap; margin-top: 6px;"
            >
              <button
                type="button"
                id="pwa-test-notification"
                aria-describedby="pwa-notification-help"
                class="btn btn-ghost pwa-troubleshoot-btn"
                >{t("settings.pwa_test_notification", locale)}</button
              >
              <button
                type="button"
                id="pwa-reset-hints-btn"
                class="btn btn-ghost pwa-troubleshoot-btn"
                ><Icon name="refresh" size={13} sprite={true} /> <span>{t("settings.pwa_reset_hints", locale)}</span></button
              >
            </div>
            <p id="pwa-notification-help" class="settings-companion-card__hint">{t("settings.pwa_notification_help", locale)}</p>
            <p
              id="pwa-notification-result"
              class="settings-companion-card__hint"
              role="status"
              data-sending={t("settings.pwa_notification_sending", locale)}
              data-unsupported={t("settings.pwa_notification_unsupported", locale)}
              data-denied={t("settings.pwa_notification_blocked", locale)}
              data-declined={t("settings.pwa_notification_declined", locale)}
              data-body={t("settings.pwa_notification_test_body", locale)}
              data-sent={t("settings.pwa_notification_sent", locale)}
              data-unavailable={t("settings.pwa_notification_unavailable", locale)}
            ></p>
            <div
              id="pwa-troubleshoot-result"
              role="status"
              aria-live="polite"
              data-clear-cache-ok={t("settings.pwa_clear_cache_ok", locale)}
              data-clear-cache-err={t("settings.pwa_clear_cache_err", locale)}
              data-sw-unavailable={t("settings.pwa_sw_unavailable", locale)}
              data-clear-offline-ok={t("settings.pwa_clear_offline_ok", locale)}
              data-clear-offline-err={t("settings.pwa_clear_offline_err", locale)}
              data-hints-reset-ok={t("settings.pwa_hints_reset_ok", locale)}
              data-hints-reset-none={t("settings.pwa_hints_reset_none", locale)}
              style="display: none; margin-top: 6px; font-size: 11px; padding: 6px 10px; border-radius: 6px; background: var(--bg-secondary); border: 1px solid var(--border);"
            >
            </div>
          </div>
        </details>
        <div
          id="pwa-companion-open"
          class="settings-companion-card"
          data-companion-xcallback="app-pwa-settings"
        >
          <div class="settings-companion-card__copy">
            <strong>{t("settings.pwa_companion_title", locale)}</strong>
            <p set:html={t("settings.pwa_companion_desc", locale)}>
            </p>
          </div>
          <div class="settings-companion-card__actions">
            <a
              href="#"
              class="btn btn-primary"
              data-companion-link="app-pwa-settings"
              >{t("settings.pwa_companion_open", locale)}</a
            >
            <button
              type="button"
              class="btn btn-secondary"
              data-companion-xcallback-button
            >
              {t("settings.pwa_companion_copy_url", locale)}
            </button>
            <a
              href="#app-pwa-settings"
              class="btn btn-ghost"
              data-settings-section-link
              >{t("settings.pwa_companion_stay", locale)}</a
            >
          </div>
          <code
            class="settings-companion-card__preview"
            data-companion-xcallback-preview
          ></code>
          <small class="settings-companion-card__hint">
            {t("settings.pwa_companion_hint", locale)}
          </small>
        </div>
      </div>
    </div>
    <SettingsActionRow
      style="margin-top: 16px; padding-top: 12px; border-top: 1px solid var(--border);"
    >
      <a
        href="https://github.com/ryan-winkler/meitheal/issues/new/choose"
        target="_blank"
        rel="noopener noreferrer"
        class="btn btn-secondary settings-link"
        ><Icon name="bug" size={14} sprite={true} /> <span>{t("settings.pwa_report_issue", locale)}</span></a
      >
      <a
        href="https://github.com/ryan-winkler/meitheal/discussions"
        target="_blank"
        rel="noopener noreferrer"
        class="btn btn-secondary settings-link"
        ><Icon name="message-circle" size={14} sprite={true} /> <span>{t("settings.pwa_discussions", locale)}</span></a
      >
      <a
        href="https://github.com/ryan-winkler/meitheal"
        target="_blank"
        rel="noopener noreferrer"
        class="btn btn-secondary settings-link"
        ><Icon name="star" size={14} sprite={true} /> <span>{t("settings.pwa_star_github", locale)}</span></a
      >
    </SettingsActionRow>
  </SettingsPanelCard>

  <!-- Help & Support -->
  <SettingsPanelCard
    icon="book"
    title={t("settings.help_support_title", locale)}
    subtitle={t("settings.help_support_subtitle", locale)}
  >
    <div
      style="font-size: 13px; color: var(--text-secondary); line-height: 1.8;"
    >
      <SettingsDisclosure icon="book" title={t("settings.help_getting_started", locale)} open={true}>
          <p style="margin: 0 0 8px 0;" set:html={t("settings.help_started_p1", locale)}></p>
          <ul style="margin: 0; padding-left: 20px; line-height: 2;">
            <li set:html={t("settings.help_started_li1", locale)}></li>
            <li set:html={t("settings.help_started_li2", locale)}></li>
            <li set:html={t("settings.help_started_li3", locale)}></li>
            <li set:html={t("settings.help_started_li4", locale)}></li>
            <li set:html={t("settings.help_started_li5", locale)}></li>
          </ul>
      </SettingsDisclosure>
      <SettingsDisclosure icon="sliders" title={t("settings.help_architecture", locale)}>
          <p style="margin: 0 0 8px 0;" set:html={t("settings.help_arch_p1", locale)}></p>
          <ul style="margin: 0; padding-left: 20px; line-height: 2;">
            <li set:html={t("settings.help_arch_li1", locale)}></li>
            <li set:html={t("settings.help_arch_li2", locale)}></li>
            <li set:html={t("settings.help_arch_li3", locale)}></li>
            <li set:html={t("settings.help_arch_li4", locale)}></li>
            <li set:html={t("settings.help_arch_li5", locale)}></li>
          </ul>
      </SettingsDisclosure>
    </div>
    <SettingsActionRow
      style="margin-top: 16px; padding-top: 12px; border-top: 1px solid var(--border);"
    >
      <a
        href="https://github.com/ryan-winkler/meitheal#readme"
        target="_blank"
        rel="noopener noreferrer"
        class="btn btn-secondary settings-link"
        ><Icon name="file-text" size={14} sprite={true} /> <span>{t("settings.help_readme", locale)}</span></a
      >
      <a
        href="https://github.com/ryan-winkler/meitheal/blob/main/docs/index.md"
        target="_blank"
        rel="noopener noreferrer"
        class="btn btn-secondary settings-link"
        ><Icon name="book" size={14} sprite={true} /> <span>{t("settings.help_guides", locale)}</span></a
      >
      <a
        href="https://github.com/ryan-winkler/meitheal/blob/main/CHANGELOG.md"
        target="_blank"
        rel="noopener noreferrer"
        class="btn btn-secondary settings-link"
        ><Icon name="clipboard-list" size={14} sprite={true} /> <span>{t("settings.help_changelog", locale)}</span></a
      >
    </SettingsActionRow>
    <SettingsActionRow class="mt-2">
      <a
        href="#local-feedback"
        data-settings-section-link
        class="btn btn-secondary settings-link"
        >{t("settings.help_local_feedback", locale)}</a
      >
    </SettingsActionRow>
  </SettingsPanelCard>

  </div>
</section>

<style is:inline>
  .pwa-compact-row {
    padding: 8px 0;
    border-top: 1px solid var(--border);
  }
  .pwa-compact-dot {
    display: inline-block;
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--text-muted);
    transition:
      background 300ms ease,
      box-shadow 300ms ease;
  }
  .pwa-compact-dot--active {
    background: var(--accent);
    box-shadow: 0 0 6px rgb(var(--accent-rgb) / 0.4);
  }
  .pwa-compact-dot--unavailable {
    background: var(--warning);
  }
  #pwa-installed-badge {
    align-items: center;
    gap: 4px;
  }
  .pwa-subtle-link {
    font-size: 11px;
    color: var(--text-muted);
    text-decoration: underline;
    text-underline-offset: 2px;
    cursor: pointer;
    transition: color 0.15s ease;
    background: none;
    border: none;
    padding: 0;
    font-family: inherit;
  }
  .pwa-subtle-link:hover {
    color: var(--accent-text);
  }
  .pwa-subtle-link[aria-disabled="true"],
  .pwa-troubleshoot-btn[aria-disabled="true"] {
    opacity: 0.6;
    cursor: wait;
    pointer-events: none;
  }
  @media (max-width: 768px), (pointer: coarse) {
    .pwa-subtle-link {
      min-width: 44px;
      justify-content: center;
    }
    .pwa-subtle-link,
    #pwa-troubleshoot > summary,
    #pwa-compact-details > summary {
      display: inline-flex;
      align-items: center;
      min-height: 44px;
      padding-inline: 4px;
    }
  }
  .pwa-link-separator {
    font-size: 11px;
    color: var(--text-muted);
    opacity: 0.4;
    user-select: none;
  }
  .pwa-troubleshoot-panel {
    margin-top: 8px;
    padding: 10px 12px;
    background: var(--bg-secondary);
    border: 1px solid var(--border);
    border-radius: 8px;
  }
  .pwa-troubleshoot-btn {
    font-size: 12px !important;
    padding: 4px 10px !important;
  }
  .settings-companion-card {
    display: flex;
    flex-direction: column;
    gap: 12px;
    margin-top: 12px;
    padding: 14px;
    border: 1px solid color-mix(in srgb, var(--accent) 24%, var(--border));
    border-radius: 14px;
    background:
      linear-gradient(
        135deg,
        color-mix(in srgb, var(--accent) 9%, transparent),
        color-mix(in srgb, var(--bg-secondary) 94%, transparent)
      );
  }
  .settings-companion-card__copy p {
    margin: 6px 0 0;
    font-size: 12px;
    line-height: 1.65;
    color: var(--text-muted);
  }
  .settings-companion-card__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }
  .settings-companion-card__preview {
    display: block;
    overflow-wrap: anywhere;
    padding: 10px 12px;
    border-radius: 10px;
    border: 1px solid var(--border);
    background: color-mix(in srgb, var(--bg-primary) 82%, black 18%);
    color: var(--text-secondary);
    font-size: 12px;
    line-height: 1.5;
  }
  .settings-companion-card__hint {
    font-size: 12px;
    color: var(--text-secondary);
    line-height: 1.6;
  }
</style>

<script>
  import { getAppServiceWorkerRegistration, type SwUpdateEventDetail } from "@domains/offline/sw-register"
  import { clearCurrentOfflineCache, hasUnattributedOfflineData } from "@domains/offline/offline-store"
  import { activateSwWithButtonUi, consumePwaInstallPrompt } from "@lib/layout-pwa-controller"
  import { pageLifecycle } from "../../lib/page-lifecycle"

  let troubleshootTimer: number | undefined
  let troubleshootRaf: number | undefined

  function initPwaCompact(signal: AbortSignal) {
    const dot = document.getElementById("pwa-compact-dot")
    const label = document.getElementById("pwa-compact-label")
    const badge = document.getElementById("pwa-compact-badge")
    const details = document.getElementById("pwa-compact-details")
    const versionEl = document.getElementById("pwa-compact-version")
    const installBtn = document.getElementById("pwa-install-settings-btn")
    const updateBtn = document.getElementById("pwa-update-settings-btn")
    const installedBadge = document.getElementById("pwa-installed-badge")
    if (!dot || !label || !badge) return

    const isSecure = window.isSecureContext
    const hasSW = "serviceWorker" in navigator

    if (isSecure && hasSW) {
      dot.className = "pwa-compact-dot pwa-compact-dot--active"
      if (label && label.dataset.activeText) label.textContent = label.dataset.activeText
      if (badge && badge.dataset.activeText) {
        badge.textContent = badge.dataset.activeText
        badge.className = "badge badge-active"
      }
      badge.style.fontSize = "11px"

      // Query SW version — use combined abort signal for nav + HMR cleanup
      if (navigator.serviceWorker.controller && versionEl) {
        navigator.serviceWorker.addEventListener("message", (e: MessageEvent) => {
          if (e.data?.type === "VERSION") {
            versionEl.textContent = `v${e.data.version}`
            versionEl.style.display = ""
          }
        }, { signal })
        navigator.serviceWorker.controller.postMessage({ type: "GET_VERSION" })
      }

      // Check for waiting SW (update available)
      if (updateBtn) {
        let offered: ServiceWorker | null = null
        const offerUpdate = (worker: ServiceWorker) => {
          if (signal.aborted) return
          offered = worker
          updateBtn.style.display = ""
        }
        void getAppServiceWorkerRegistration().then(registration => {
          if (registration?.waiting) offerUpdate(registration.waiting)
        }).catch(() => {})
        window.addEventListener("meitheal-sw-update", (event) => {
          const { detail } = event as CustomEvent<SwUpdateEventDetail>
          if (detail?.type === "update-available") {
            offerUpdate(detail.worker)
          } else if (detail?.type === "update-activated" && updateBtn.getAttribute("aria-disabled") !== "true") {
            offered = null
            updateBtn.style.display = "none"
          }
        }, { signal })
        updateBtn.addEventListener("click", () => {
          if (!offered) return
          void activateSwWithButtonUi({ button: updateBtn, target: offered, signal })
        }, { signal })
      }
    } else {
      dot.className = "pwa-compact-dot pwa-compact-dot--unavailable"
      if (label && label.dataset.httpText) label.textContent = label.dataset.httpText
      if (badge && badge.dataset.httpText) {
        badge.textContent = badge.dataset.httpText
        badge.className = "badge badge-pending"
      }
      badge.style.fontSize = "11px"
      if (details) details.style.display = "block"
    }

    // Install button — show when install prompt available
    if (installBtn) {
      const showInstallBtn = () => {
        if ((window as any).__pwa_install_prompt) {
          installBtn.style.display = ""
        }
      }
      showInstallBtn()
      window.addEventListener("meitheal-pwa-installable", showInstallBtn, { signal })
      window.addEventListener("meitheal-pwa-prompt-consumed", () => {
        installBtn.style.display = "none"
      }, { signal })

      installBtn.addEventListener("click", async (e: Event) => {
        e.preventDefault()
        if ((await consumePwaInstallPrompt()) === "accepted") {
          installBtn.style.display = "none"
          if (installedBadge) installedBadge.style.display = "inline-flex"
        }
      }, { signal })
    }

    window.addEventListener("meitheal-pwa-installed", () => {
      const ib = document.getElementById("pwa-install-settings-btn")
      const iBadge = document.getElementById("pwa-installed-badge")
      if (ib) ib.style.display = "none"
      if (iBadge) iBadge.style.display = "inline-flex"
    }, { signal })
  }

  // ── Pop out to browser (escape HA iframe for PWA install) ──
  function initPwaPopout(signal: AbortSignal) {
    const popoutBtn = document.getElementById("pwa-popout-btn")
    const uninstallBtn = document.getElementById("pwa-uninstall-btn")
    const uninstallInfo = document.getElementById("pwa-uninstall-info")
    if (!popoutBtn) return

    popoutBtn.addEventListener("click", (e: Event) => {
      e.preventDefault()
      const ingressPath = (window as any).__ingress_path || ""
      let origin = window.location.origin
      if (ingressPath) {
        try {
          origin = window.top?.location?.origin || origin
        } catch {
          origin = document.referrer ? new URL(document.referrer).origin : ""
        }
      }
      window.open(origin + ingressPath + "/settings#app-pwa-settings", "_blank", "noopener")
    }, { signal })

    if (uninstallBtn) {
      uninstallBtn.addEventListener("click", () => {
        if (uninstallInfo) {
          const showing = uninstallInfo.style.display !== "none"
          uninstallInfo.style.display = showing ? "none" : "block"
          uninstallBtn.setAttribute("aria-expanded", String(!showing))
        }
      }, { signal })
    }
  }

  // ── PWA Troubleshooting Actions ──
  function showTroubleshootResult(msg: string, ok: boolean, signal: AbortSignal) {
    const el = document.getElementById("pwa-troubleshoot-result")
    if (!el || signal.aborted) return
    window.clearTimeout(troubleshootTimer)
    if (troubleshootRaf !== undefined) window.cancelAnimationFrame(troubleshootRaf)
    el.textContent = ""
    el.style.display = "block"
    el.style.color = ok ? "var(--success-text, var(--success))" : "var(--danger-text, var(--danger))"
    troubleshootRaf = window.requestAnimationFrame(() => {
      troubleshootRaf = undefined
      if (!signal.aborted && el.isConnected) el.textContent = msg
    })
    troubleshootTimer = window.setTimeout(() => {
      troubleshootTimer = undefined
      if (el.isConnected) el.style.display = "none"
    }, 4000)
  }

  function initPwaTroubleshooting(signal: AbortSignal) {
    const clearCacheBtn = document.getElementById("pwa-clear-cache-btn")
    const forceUpdateBtn = document.getElementById("pwa-force-update-btn")
    const clearOfflineBtn = document.getElementById("pwa-clear-offline-btn")
    const resetHintsBtn = document.getElementById("pwa-reset-hints-btn")
    const copy = document.getElementById("pwa-troubleshoot-result")?.dataset
    if (!clearCacheBtn) return

    signal.addEventListener("abort", () => {
      window.clearTimeout(troubleshootTimer)
      if (troubleshootRaf !== undefined) window.cancelAnimationFrame(troubleshootRaf)
      troubleshootTimer = undefined
      troubleshootRaf = undefined
    }, { once: true })

    clearCacheBtn.addEventListener("click", async () => {
      try {
        const names = await caches.keys()
        await Promise.all(names.map((n) => caches.delete(n)))
        showTroubleshootResult(
          (copy?.clearCacheOk ?? "✓ Cleared {count} cache(s). Reload to re-populate.").replace("{count}", String(names.length)),
          true,
          signal,
        )
      } catch {
        showTroubleshootResult(copy?.clearCacheErr ?? "✗ Failed to clear caches.", false, signal)
      }
    }, { signal })

    if (forceUpdateBtn) {
      forceUpdateBtn.addEventListener("click", () => {
        void activateSwWithButtonUi({
          button: forceUpdateBtn,
          target: () => getAppServiceWorkerRegistration().then(async registration => {
            if (!registration) return null
            await registration.update()
            return registration.installing ?? registration.waiting ?? registration.active
          }),
          signal,
          onBeforeActivate: () => {
            if ("serviceWorker" in navigator) return false
            showTroubleshootResult(copy?.swUnavailable ?? "Service workers not available.", false, signal)
            return true
          },
        })
      }, { signal })
    }

    void hasUnattributedOfflineData().then(found => {
      if (!found || signal.aborted || !clearOfflineBtn?.isConnected || document.getElementById("pwa-unattributed-notice")) return
      const notice = document.createElement("p")
      notice.id = "pwa-unattributed-notice"
      notice.setAttribute("role", "status")
      notice.textContent = clearOfflineBtn.dataset.unattributedNotice ??
        "Offline work from an older version is retained separately. It has no verified account or Board, so it cannot be shown or sent automatically. Keep this browser’s data until an administrator can recover it."
      clearOfflineBtn.parentElement?.after(notice)
    }).catch(() => {})
    if (clearOfflineBtn) {
      clearOfflineBtn.addEventListener("click", async () => {
        try {
          await clearCurrentOfflineCache()
          showTroubleshootResult(copy?.clearOfflineOk ?? "✓ Cleared this Board’s cached tasks. Pending work and other accounts remain saved.", true, signal)
        } catch (error) {
          showTroubleshootResult(
            error instanceof Error ? error.message : (copy?.clearOfflineErr ?? "Offline data was not cleared."),
            false,
            signal,
          )
        }
      }, { signal })
    }

    if (resetHintsBtn) {
      resetHintsBtn.addEventListener("click", () => {
        const keys = [
          "meitheal-pwa-dismissed",
          "meitheal_shortcut_hint_dismissed",
        ]
        let cleared = 0
        keys.forEach((k) => {
          if (localStorage.getItem(k) !== null) {
            localStorage.removeItem(k)
            cleared++
          }
        })
        try {
          if (sessionStorage.getItem("meitheal-pwa-session-hidden") !== null) {
            sessionStorage.removeItem("meitheal-pwa-session-hidden")
            cleared++
          }
        } catch { /* non-fatal */ }
        window.dispatchEvent(new Event("meitheal-pwa-hints-reset"))
        showTroubleshootResult(
          cleared > 0
            ? (copy?.hintsResetOk ?? "✓ Reset {count} hint(s). They’ll reappear on next page load.").replace("{count}", String(cleared))
            : (copy?.hintsResetNone ?? "No dismissed hints to reset."),
          true,
          signal,
        )
      }, { signal })
    }
  }

  window.__pwaSettingsHmrAc?.abort()
  const hmrAc = new AbortController()
  window.__pwaSettingsHmrAc = hmrAc
  let initializedSignal: AbortSignal | undefined
  pageLifecycle.onPageLoad((pageSignal) => {
    if (hmrAc.signal.aborted || initializedSignal === pageSignal || !document.getElementById("app-pwa-settings")) return
    initializedSignal = pageSignal
    const signal = AbortSignal.any([pageSignal, hmrAc.signal])
    initPwaCompact(signal)
    initPwaPopout(signal)
    initPwaTroubleshooting(signal)
  })
</script>

