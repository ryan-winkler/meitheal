                {groups.map((group) => (
                  <div class="about-release__group">
                    {group.category && (
                      <h4 class={`about-release__cat about-release__cat--${group.category.toLowerCase()}`}>
                        <span class="about-release__cat-dot" aria-hidden="true"></span>
                        <span>{group.category}</span>
                      </h4>
                    )}
                    <ul class="about-release__items">
                      {group.items.map((item) => (
                        <li>
                          {item.title && (
                            <strong>
                              {tokenizeInlineCode(item.title).map((tok) =>
                                tok.type === "code" ? <code class="about-inline-code">{tok.value}</code> : tok.value
                              )}
                              {": "}
                            </strong>
                          )}
                          <span>
