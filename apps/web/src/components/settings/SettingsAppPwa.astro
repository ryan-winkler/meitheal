---
import { t } from "../../i18n/translations"
import type { Locale } from "../../lib/locale"
import {
  AGPL_LICENSE_SUMMARY,
  groupChangelogItemsByCategory,
  readRepoAboutDocs,
  tokenizeInlineCode,
} from "../../lib/repo-about-docs"
import { PWA_TASK_SHORTCUT_KINDS } from "../../lib/pwa-manifest-builder"
import { SETTINGS_SECTIONS } from "../../lib/settings-registry"
import Icon from "../ui/Icon.astro"
import SettingsActionRow from "./SettingsActionRow.astro"
import SettingsCallout from "./SettingsCallout.astro"
import SettingsDisclosure from "./SettingsDisclosure.astro"
import SettingsFeedback from "./SettingsFeedback.astro"
import SettingsPanelCard from "./SettingsPanelCard.astro"
import SettingsSectionIntro from "./SettingsSectionIntro.astro"

interface Props {
  locale: Locale
  databaseDownloadToken?: string | undefined
}
const { locale } = Astro.props

// Dynamic version — injected at build time from meitheal-hub/config.yaml via
// vite.define in astro.config.mjs. Runtime env var takes precedence (Docker).
declare const __MEITHEAL_VERSION__: string
const version =
  import.meta.env.MEITHEAL_VERSION ||
  process.env.MEITHEAL_VERSION ||
  (typeof __MEITHEAL_VERSION__ !== "undefined"
    ? __MEITHEAL_VERSION__
    : "0.0.0-dev")
const appPwaSection = SETTINGS_SECTIONS.find((section) => section.id === "app-pwa-settings")!
const aboutDocs = await readRepoAboutDocs()
---

<section
  id="app-pwa-settings"
  class="settings-shell__section"
  data-settings-shell-section
  hidden
>
  <SettingsSectionIntro section={appPwaSection} />
  <div class="settings-grid">
  <!-- About Meitheal & Sponsors -->
  <SettingsPanelCard
    id="about-meitheal-card"
    icon="sparkles"
    title="About Meitheal & Sponsors"
    subtitle="Local-first household & homelab task hub for Home Assistant — independent, open source, and community-supported."
    tone="accent"
  >
    <div class="about-hero-meta">
      <div class="about-version-pill">
        <span class="about-version-pill__label">Version</span>
        <code class="about-version-pill__val">v{version}</code>
      </div>
      <div class="about-version-pill">
        <span class="about-version-pill__label">License</span>
        <a href="#about-license-card" class="about-version-pill__link">{AGPL_LICENSE_SUMMARY.spdx}</a>
      </div>
      <div class="about-version-pill">
        <span class="about-version-pill__label">Storage</span>
        <span class="about-version-pill__val">Local SQLite</span>
      </div>
    </div>

    <div class="about-sponsors-box">
      <div class="about-sponsors-box__head">
        <div>
          <h3 class="about-sponsors-box__title">Sponsors &amp; Supporters</h3>
          <p class="about-sponsors-box__desc">
            Meitheal has no subscriptions or cloud tracking. Sponsors fund Home Assistant Green &amp; Raspberry Pi test hardware, multi-arch builds, and ongoing maintenance — and can feature their <strong>logo right here on the About page</strong>.
          </p>
        </div>
        <div class="about-sponsors-box__cta">
          <a
            href="mailto:Sponsor@meitheal.io?subject=Meitheal%20Sponsorship"
            class="btn btn-primary btn-sm"
          >
            <Icon name="star" size={14} sprite={true} />
            <span>Become a Sponsor</span>
          </a>
          <a
            href="https://ko-fi.com/ryanw_eu"
            target="_blank"
            rel="noopener noreferrer"
            class="btn btn-secondary btn-sm"
          >
            <span>Ko-fi</span>
          </a>
        </div>
      </div>

      <div class="about-sponsors-slots" aria-label="Sponsor showcase">
        <a
          href="mailto:Sponsor@meitheal.io?subject=Meitheal%20Sponsor%20Slot"
          class="about-sponsor-slot"
        >
          <span class="about-sponsor-slot__badge">Open Sponsor Slot</span>
          <span class="about-sponsor-slot__label">Your logo &amp; link here</span>
          <span class="about-sponsor-slot__hint">Email Sponsor@meitheal.io to feature on Meitheal's About page &amp; README</span>
        </a>
        <a
          href="https://github.com/ryan-winkler/meitheal/blob/dev/COMMERCIAL.md"
          target="_blank"
          rel="noopener noreferrer"
          class="about-sponsor-slot"
        >
          <span class="about-sponsor-slot__badge">Commercial Partner</span>
          <span class="about-sponsor-slot__label">Commercial License &amp; Support</span>
          <span class="about-sponsor-slot__hint">Dedicated licensing for commercial deployments</span>
        </a>
      </div>
    </div>
  </SettingsPanelCard>

  <SettingsFeedback version={version} />
  <!-- App Readiness & Companion -->
  <SettingsPanelCard
    title={t("settings.app_readiness_title", locale)}
    subtitle={t("settings.app_readiness_subtitle", locale)}
    tone="accent"
  >
    <div
      style="font-size: 13px; color: var(--text-secondary); line-height: 1.8;"
    >
      <SettingsCallout title={t("settings.app_readiness_callout_title", locale)} icon="phone" tone="info">
        {t("settings.app_readiness_callout_desc", locale)}
      </SettingsCallout>
      <p set:html={t("settings.pwa_about_p1", locale)}></p>
      <p>{t("settings.pwa_about_p2", locale)}</p>
      <div
        id="pwa-status-compact"
        class="pwa-compact-row"
        style="margin-top: 8px;"
      >
        <div
          style="display: flex; align-items: center; gap: 8px; flex-wrap: wrap;"
        >
          <span
            class="pwa-compact-dot"
            id="pwa-compact-dot"
            aria-hidden="true"></span>
          <span
            style="font-size: 13px; color: var(--text-secondary);"
            id="pwa-compact-label"
            data-active-text={t("settings.pwa_active", locale)}
            data-http-text={t("settings.pwa_req_https", locale)}
            >{t("settings.pwa_checking", locale)}</span
          >
          <span
            class="badge badge-pending"
            id="pwa-compact-badge"
            data-active-text={t("settings.pwa_active_badge", locale)}
            data-http-text={t("settings.pwa_req_https_badge", locale)}
            style="font-size: 12px;">{t("settings.pwa_checking_badge", locale)}</span
          >
          <span
            id="pwa-compact-version"
            style="font-size: 12px; color: var(--text-secondary); font-family: var(--font-mono); display: none;"
          ></span>
          <a
            href="#"
            id="pwa-install-settings-btn"
            class="pwa-subtle-link"
            style="display: none;">{t("settings.pwa_install", locale)}</a
          >
          <button
            type="button"
            id="pwa-update-settings-btn"
            class="pwa-subtle-link"
            style="display: none;">{t("settings.pwa_update_available", locale)}</button
          >
          <span
            id="pwa-installed-badge"
            class="badge badge-active"
            style="font-size: 11px; display: none;"><Icon name="check" size={12} sprite={true} /> <span>{t("settings.pwa_installed", locale)}</span></span
          >
          <span class="pwa-link-separator" aria-hidden="true">·</span>
          <a
            href="#"
            id="pwa-popout-btn"
            class="pwa-subtle-link"
            title={t("settings.pwa_open_browser_title", locale)}
            >{t("settings.pwa_open_browser", locale)}<span class="sr-only"> {t("settings.pwa_new_tab_sr", locale)}</span></a
          >
          <span class="pwa-link-separator" aria-hidden="true">·</span>
          <button
            type="button"
            id="pwa-uninstall-btn"
            class="pwa-subtle-link"
            aria-expanded="false"
            aria-controls="pwa-uninstall-info"
            >{t("settings.pwa_uninstall", locale)}</button
          >
        </div>
        <!-- Uninstall instructions (hidden by default) -->
        <div
          id="pwa-uninstall-info"
          style="display: none; margin-top: 6px; font-size: 12px; color: var(--text-muted); line-height: 1.6; padding: 8px 12px; background: var(--bg-secondary); border-radius: 8px;"
        >
          <p set:html={t("settings.pwa_uninstall_how", locale)}></p>
          <small style="margin-top: 4px; display: block;"
            >{t("settings.pwa_uninstall_safe", locale)}</small
          >
        </div>
        <!-- App Permissions, Offline Sync & Share -->
        <div class="pwa-permissions-grid" aria-label="App permissions and offline sync">
          <div class="pwa-perm-row">
            <div class="pwa-perm-row__info">
              <span class="pwa-perm-row__title">
                <Icon name="bell" size={14} sprite={true} />
                <span>Notifications</span>
                <span id="pwa-notif-perm-badge" class="badge badge-pending">Checking…</span>
              </span>
              <span class="pwa-perm-row__desc">Allow browser reminders for due tasks and routines.</span>
            </div>
            <div class="pwa-perm-row__actions">
              <button type="button" id="pwa-enable-notif-btn" class="btn btn-secondary btn-sm">
                <Icon name="bell" size={13} sprite={true} />
                <span>Enable notifications</span>
              </button>
            </div>
          </div>
          <div class="pwa-perm-row">
            <div class="pwa-perm-row__info">
              <span class="pwa-perm-row__title">
                <Icon name="refresh" size={14} sprite={true} />
                <span>Offline Sync Queue</span>
                <span id="pwa-sync-queue-badge" class="badge badge-active">0 pending</span>
              </span>
              <span id="pwa-storage-estimate" class="pwa-perm-row__desc">Changes captured offline replay automatically when back online.</span>
            </div>
            <div class="pwa-perm-row__actions">
              <button type="button" id="pwa-sync-now-btn" class="btn btn-secondary btn-sm">
                <Icon name="refresh" size={13} sprite={true} />
                <span>Sync now</span>
              </button>
              <button type="button" id="pwa-share-app-btn" class="btn btn-ghost btn-sm">
                <Icon name="external-link" size={13} sprite={true} />
                <span>Share Meitheal</span>
              </button>
            </div>
          </div>
        </div>
        <details
          id="pwa-compact-details"
          style="display: none; margin-top: 6px;"
        >
          <summary
            style="font-size: 12px; color: var(--accent-text); cursor: pointer; list-style: none;"
          >
            {t("settings.pwa_why_unavailable", locale)}
          </summary>
          <div
            style="margin-top: 6px; font-size: 12px; color: var(--text-muted); line-height: 1.6; padding: 8px 12px; background: var(--bg-secondary); border-radius: 8px;"
            set:html={t("settings.pwa_why_unavailable_desc", locale)}
          >
          </div>
        </details>
        <!-- PWA Troubleshooting -->
        <details id="pwa-troubleshoot" style="margin-top: 6px;">
          <summary
            class="pwa-subtle-link"
            style="list-style: none; cursor: pointer; display: inline-flex; align-items: center;"
            >{t("settings.pwa_troubleshooting", locale)}</summary
          >
          <div class="pwa-troubleshoot-panel">
            <p
              style="margin: 0 0 8px; font-size: 12px; color: var(--text-muted);"
            >
              {t("settings.pwa_troubleshoot_desc", locale)}
            </p>
            <div style="display: flex; gap: 6px; flex-wrap: wrap;">
              <button
                type="button"
                id="pwa-clear-cache-btn"
                class="btn btn-ghost pwa-troubleshoot-btn"
                ><Icon name="trash" size={13} sprite={true} /> <span>{t("settings.pwa_clear_cache", locale)}</span></button
              >
              <button
                type="button"
                id="pwa-force-update-btn"
                class="btn btn-ghost pwa-troubleshoot-btn"
                ><Icon name="refresh" size={13} sprite={true} /> <span>{t("settings.pwa_force_update", locale)}</span></button
              >
              <button
                type="button"
                id="pwa-clear-offline-btn"
                class="btn btn-ghost pwa-troubleshoot-btn"
                data-unattributed-notice={t("settings.pwa_unattributed_offline", locale)}
                ><Icon name="database" size={13} sprite={true} /> <span>{t("settings.pwa_clear_offline", locale)}</span></button
              >
            </div>
            <div
              style="display: flex; gap: 6px; flex-wrap: wrap; margin-top: 6px;"
            >
              <button
                type="button"
                id="pwa-test-notification"
                aria-describedby="pwa-notification-help"
                class="btn btn-ghost pwa-troubleshoot-btn"
                >{t("settings.pwa_test_notification", locale)}</button
              >
              <button
                type="button"
                id="pwa-reset-hints-btn"
                class="btn btn-ghost pwa-troubleshoot-btn"
                ><Icon name="refresh" size={13} sprite={true} /> <span>{t("settings.pwa_reset_hints", locale)}</span></button
              >
            </div>
            <p id="pwa-notification-help" class="settings-companion-card__hint">{t("settings.pwa_notification_help", locale)}</p>
            <p
              id="pwa-notification-result"
              class="settings-companion-card__hint"
              role="status"
              data-sending={t("settings.pwa_notification_sending", locale)}
              data-unsupported={t("settings.pwa_notification_unsupported", locale)}
              data-denied={t("settings.pwa_notification_blocked", locale)}
              data-declined={t("settings.pwa_notification_declined", locale)}
              data-body={t("settings.pwa_notification_test_body", locale)}
              data-sent={t("settings.pwa_notification_sent", locale)}
              data-unavailable={t("settings.pwa_notification_unavailable", locale)}
            ></p>
            <div
              id="pwa-troubleshoot-result"
              role="status"
              aria-live="polite"
              data-clear-cache-ok={t("settings.pwa_clear_cache_ok", locale)}
              data-clear-cache-err={t("settings.pwa_clear_cache_err", locale)}
              data-sw-unavailable={t("settings.pwa_sw_unavailable", locale)}
              data-clear-offline-ok={t("settings.pwa_clear_offline_ok", locale)}
              data-clear-offline-err={t("settings.pwa_clear_offline_err", locale)}
              data-hints-reset-ok={t("settings.pwa_hints_reset_ok", locale)}
              data-hints-reset-none={t("settings.pwa_hints_reset_none", locale)}
              style="display: none; margin-top: 6px; font-size: 11px; padding: 6px 10px; border-radius: 6px; background: var(--bg-secondary); border: 1px solid var(--border);"
            >
            </div>
          </div>
        </details>
        <div
          id="pwa-companion-open"
          class="settings-companion-card"
          data-companion-xcallback="app-pwa-settings"
        >
          <div class="settings-companion-card__copy">
            <strong>{t("settings.pwa_companion_title", locale)}</strong>
            <p set:html={t("settings.pwa_companion_desc", locale)}>
            </p>
          </div>
          <div class="settings-companion-card__actions">
            <a
              href="#"
              class="btn btn-primary"
              data-companion-link="app-pwa-settings"
              >{t("settings.pwa_companion_open", locale)}</a
            >
            <button
              type="button"
              class="btn btn-secondary"
              data-companion-xcallback-button
            >
              {t("settings.pwa_companion_copy_url", locale)}
            </button>
            <a
              href="#app-pwa-settings"
              class="btn btn-ghost"
              data-settings-section-link
              >{t("settings.pwa_companion_stay", locale)}</a
            >
          </div>
          <code
            class="settings-companion-card__preview"
            data-companion-xcallback-preview
          ></code>
          <small class="settings-companion-card__hint">
            {t("settings.pwa_companion_hint", locale)}
          </small>
        </div>
      </div>
    </div>
    <SettingsActionRow
      style="margin-top: 16px; padding-top: 12px; border-top: 1px solid var(--border);"
    >
      <a
        href="https://github.com/ryan-winkler/meitheal/issues/new/choose"
        target="_blank"
        rel="noopener noreferrer"
        class="btn btn-secondary settings-link"
        ><Icon name="bug" size={14} sprite={true} /> <span>{t("settings.pwa_report_issue", locale)}</span></a
      >
      <a
        href="https://github.com/ryan-winkler/meitheal/discussions"
        target="_blank"
        rel="noopener noreferrer"
        class="btn btn-secondary settings-link"
        ><Icon name="message-circle" size={14} sprite={true} /> <span>{t("settings.pwa_discussions", locale)}</span></a
      >
      <a
        href="https://github.com/ryan-winkler/meitheal"
        target="_blank"
        rel="noopener noreferrer"
        class="btn btn-secondary settings-link"
        ><Icon name="star" size={14} sprite={true} /> <span>{t("settings.pwa_star_github", locale)}</span></a
      >
    </SettingsActionRow>
  </SettingsPanelCard>

  <!-- Home Screen Shortcuts & Quick-Capture PWAs (W3C Manifest Shortcuts) -->
  <SettingsPanelCard
    id="pwa-shortcuts-card"
    icon="bolt"
    title="Home Screen Shortcuts & Quick-Capture PWAs"
    subtitle="Pin Meitheal or any specific task type (Task, Shopping, Checklist, Routine, Event) directly to your home screen."
  >
    <div class="pwa-shortcuts-grid" role="list" aria-label="Installable task-type shortcuts">
      {PWA_TASK_SHORTCUT_KINDS.map((spec) => (
        <a
          href={`/new?kind=${encodeURIComponent(spec.kind)}`}
          class="pwa-shortcut-tile"
          role="listitem"
        >
          <span class="pwa-shortcut-tile__icon" aria-hidden="true">
            <Icon name={spec.icon as any} size={18} sprite={true} />
          </span>
          <span class="pwa-shortcut-tile__copy">
            <strong class="pwa-shortcut-tile__title">{spec.label}</strong>
            <span class="pwa-shortcut-tile__desc">{spec.description}</span>
          </span>
          <span class="pwa-shortcut-tile__arrow" aria-hidden="true">
            <Icon name="external-link" size={14} sprite={true} />
          </span>
        </a>
      ))}
    </div>
    <div class="pwa-ios-guide" id="pwa-ios-install-guide">
      <div class="pwa-ios-guide__head">
        <img src="/apple-touch-icon.png" alt="Meitheal app icon" width="32" height="32" loading="lazy" decoding="async" class="pwa-ios-guide__icon" />
        <div>
          <strong>Install on iPhone, iPad, or Android</strong>
          <p>
            Open any shortcut above, then tap <strong>Install</strong> (Android/Desktop Chrome &amp; Edge) or <strong>Share → Add to Home Screen</strong> (iOS Safari). Long-press the main Meitheal app icon anytime to jump straight to <em>New Task</em>, <em>Shopping</em>, <em>Routine</em>, <em>Today</em>, or <em>Calendar</em>.
          </p>
        </div>
      </div>
    </div>
  </SettingsPanelCard>

  <!-- Help & Support -->
  <SettingsPanelCard
    icon="book"
    title={t("settings.help_support_title", locale)}
    subtitle={t("settings.help_support_subtitle", locale)}
  >
    <div
      style="font-size: 13px; color: var(--text-secondary); line-height: 1.8;"
    >
      <SettingsDisclosure icon="book" title={t("settings.help_getting_started", locale)} open={true}>
          <p style="margin: 0 0 8px 0;" set:html={t("settings.help_started_p1", locale)}></p>
          <ul style="margin: 0; padding-left: 20px; line-height: 2;">
            <li set:html={t("settings.help_started_li1", locale)}></li>
            <li set:html={t("settings.help_started_li2", locale)}></li>
            <li set:html={t("settings.help_started_li3", locale)}></li>
            <li set:html={t("settings.help_started_li4", locale)}></li>
            <li set:html={t("settings.help_started_li5", locale)}></li>
          </ul>
      </SettingsDisclosure>
      <SettingsDisclosure icon="sliders" title={t("settings.help_architecture", locale)}>
          <p style="margin: 0 0 8px 0;" set:html={t("settings.help_arch_p1", locale)}></p>
          <ul style="margin: 0; padding-left: 20px; line-height: 2;">
            <li set:html={t("settings.help_arch_li1", locale)}></li>
            <li set:html={t("settings.help_arch_li2", locale)}></li>
            <li set:html={t("settings.help_arch_li3", locale)}></li>
            <li set:html={t("settings.help_arch_li4", locale)}></li>
            <li set:html={t("settings.help_arch_li5", locale)}></li>
          </ul>
      </SettingsDisclosure>
    </div>
    <SettingsActionRow
      style="margin-top: 16px; padding-top: 12px; border-top: 1px solid var(--border);"
    >
      <a
        href="https://github.com/ryan-winkler/meitheal#readme"
        target="_blank"
        rel="noopener noreferrer"
        class="btn btn-secondary settings-link"
        ><Icon name="file-text" size={14} sprite={true} /> <span>{t("settings.help_readme", locale)}</span></a
      >
      <a
        href="https://github.com/ryan-winkler/meitheal/blob/main/docs/index.md"
        target="_blank"
        rel="noopener noreferrer"
        class="btn btn-secondary settings-link"
        ><Icon name="book" size={14} sprite={true} /> <span>{t("settings.help_guides", locale)}</span></a
      >
      <a
        href="https://github.com/ryan-winkler/meitheal/blob/main/CHANGELOG.md"
        target="_blank"
        rel="noopener noreferrer"
        class="btn btn-secondary settings-link"
        ><Icon name="clipboard-list" size={14} sprite={true} /> <span>{t("settings.help_changelog", locale)}</span></a
      >
    </SettingsActionRow>
    <SettingsActionRow class="mt-2">
      <a
        href="#local-feedback"
        data-settings-section-link
        class="btn btn-secondary settings-link"
        >{t("settings.help_local_feedback", locale)}</a
      >
    </SettingsActionRow>
  </SettingsPanelCard>

  <!-- License (Tabler License Page Pattern) -->
  <SettingsPanelCard
    id="about-license-card"
    icon="shield-check"
    title={`License — ${AGPL_LICENSE_SUMMARY.spdx}`}
    subtitle={AGPL_LICENSE_SUMMARY.title}
  >
    <p class="about-license-summary">{AGPL_LICENSE_SUMMARY.summary}</p>

    <div class="about-license-grid" role="region" aria-label="License rights summary">
      <div class="about-license-col">
        <h3 class="about-license-col__title">Permissions</h3>
        <ul class="about-license-list">
          {AGPL_LICENSE_SUMMARY.permissions.map((item) => (
            <li class="about-license-list__item">
              <span class="about-license-icon about-license-icon--allow" aria-hidden="true">
                <Icon name="check" size={14} sprite={true} />
              </span>
              <span>{item}</span>
            </li>
          ))}
        </ul>
      </div>

      <div class="about-license-col">
        <h3 class="about-license-col__title">Conditions</h3>
        <ul class="about-license-list">
          {AGPL_LICENSE_SUMMARY.conditions.map((item) => (
            <li class="about-license-list__item">
              <span class="about-license-icon about-license-icon--cond" aria-hidden="true">
                <Icon name="info-circle" size={14} sprite={true} />
              </span>
              <span>{item}</span>
            </li>
          ))}
        </ul>
      </div>

      <div class="about-license-col">
        <h3 class="about-license-col__title">Limitations</h3>
        <ul class="about-license-list">
          {AGPL_LICENSE_SUMMARY.limitations.map((item) => (
            <li class="about-license-list__item">
              <span class="about-license-icon about-license-icon--limit" aria-hidden="true">
                <Icon name="x" size={14} sprite={true} />
              </span>
              <span>{item}</span>
            </li>
          ))}
        </ul>
      </div>
    </div>

    <div class="about-license-footer">
      <p class="about-license-note">
        This is a human-readable summary and not a substitute for the full legal text. A separate commercial license is available for uses outside AGPL-3.0-only terms.
      </p>
      <div class="about-license-links">
        <a
          href="https://github.com/ryan-winkler/meitheal/blob/dev/LICENSE"
          target="_blank"
          rel="noopener noreferrer"
          class="btn btn-secondary btn-sm"
        >
          <Icon name="file-text" size={14} sprite={true} />
          <span>LICENSE on GitHub</span>
