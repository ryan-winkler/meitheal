                            )}
                          </span>
                        </li>
                      ))}
                    </ul>
                  </div>
                ))}
              </div>
            </details>
          )
        })}
      </div>
    ) : (
      <p class="about-license-note">
        Release notes are published on <a href="https://github.com/ryan-winkler/meitheal/releases" target="_blank" rel="noopener noreferrer">GitHub Releases</a>.
