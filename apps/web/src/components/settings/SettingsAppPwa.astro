  </SettingsPanelCard>

  <!-- Live Repository Changelog (Keep a Changelog 1.1.0) -->
  <SettingsPanelCard
    id="about-changelog-card"
    icon="clipboard-list"
    title="Changelog"
    subtitle="Keep a Changelog 1.1.0 release history loaded directly from CHANGELOG.md — human-readable and machine-parseable."
  >
    {aboutDocs.releases.length > 0 ? (
      <div class="about-changelog-list">
        {aboutDocs.releases.map((release, idx) => {
          const groups = groupChangelogItemsByCategory(release.items)
          return (
            <details class="about-release" open={idx === 0}>
              <summary class="about-release__summary">
                <span class="about-release__ver">v{release.version}</span>
                <span class="about-release__channel">{release.channel}</span>
                {release.date && <time class="about-release__date" datetime={release.date}>{release.date}</time>}
                {idx === 0 && <span class="about-release__latest">Latest</span>}
                <span class="about-release__chevron" aria-hidden="true">
                  <Icon name="chevron-down" size={14} sprite={true} />
                </span>
              </summary>
              <div class="about-release__body">
