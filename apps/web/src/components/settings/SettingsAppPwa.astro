---
import { t } from "../../i18n/translations"
import type { Locale } from "../../lib/locale"
import { SETTINGS_SECTIONS } from "../../lib/settings-registry"
import SettingsActionRow from "./SettingsActionRow.astro"
import SettingsCallout from "./SettingsCallout.astro"
import SettingsFeedback from "./SettingsFeedback.astro"
import SettingsPanelCard from "./SettingsPanelCard.astro"
import SettingsSectionIntro from "./SettingsSectionIntro.astro"

interface Props {
  locale: Locale
  databaseDownloadToken: string | undefined
}
const { locale, databaseDownloadToken } = Astro.props

// Dynamic version — injected at build time from meitheal-hub/config.yaml via
// vite.define in astro.config.mjs. Runtime env var takes precedence (Docker).
declare const __MEITHEAL_VERSION__: string
const version =
  import.meta.env.MEITHEAL_VERSION ||
  process.env.MEITHEAL_VERSION ||
  (typeof __MEITHEAL_VERSION__ !== "undefined"
    ? __MEITHEAL_VERSION__
    : "0.0.0-dev")
const appPwaSection = SETTINGS_SECTIONS.find((section) => section.id === "app-pwa-settings")!
---

<section
  id="app-pwa-settings"
  class="settings-shell__section"
  data-settings-shell-section
  hidden
>
  <SettingsSectionIntro section={appPwaSection} />
  <div class="settings-grid">
  <SettingsFeedback version={version} />
  <!-- About -->
  <SettingsPanelCard
    title={t("settings.app_readiness_title", locale)}
    subtitle={t("settings.app_readiness_subtitle", locale)}
    tone="accent"
  >
    <div
      style="font-size: 13px; color: var(--text-secondary); line-height: 1.8;"
    >
      <SettingsCallout title={t("settings.app_readiness_callout_title", locale)} icon="📲" tone="info">
        {t("settings.app_readiness_callout_desc", locale)}
      </SettingsCallout>
      <p set:html={t("settings.pwa_about_p1", locale)}></p>
      <p>{t("settings.pwa_about_p2", locale)}</p>
      <p style="margin-top: 8px;">
        {t("settings.pwa_version", locale)} <code>{version}</code>
      </p>
      <div
        id="pwa-status-compact"
        class="pwa-compact-row"
        style="margin-top: 8px;"
      >
        <div
          style="display: flex; align-items: center; gap: 8px; flex-wrap: wrap;"
        >
          <span
            class="pwa-compact-dot"
            id="pwa-compact-dot"
            role="status"
            aria-label="PWA status indicator"></span>
          <span
            style="font-size: 13px; color: var(--text-secondary);"
            id="pwa-compact-label"
            data-active-text={t("settings.pwa_active", locale)}
            data-http-text={t("settings.pwa_req_https", locale)}
            >{t("settings.pwa_checking", locale)}</span
          >
          <span
            class="badge badge-pending"
            id="pwa-compact-badge"
            data-active-text={t("settings.pwa_active_badge", locale)}
            data-http-text={t("settings.pwa_req_https_badge", locale)}
            style="font-size: 11px;">{t("settings.pwa_checking_badge", locale)}</span
          >
          <span
            id="pwa-compact-version"
            style="font-size: 11px; color: var(--text-muted); font-family: 'JetBrains Mono', monospace; display: none;"
          ></span>
          <a
            href="#"
            id="pwa-install-settings-btn"
            class="pwa-subtle-link"
            style="display: none;">{t("settings.pwa_install", locale)}</a
          >
          <a
            href="#"
            id="pwa-update-settings-btn"
            class="pwa-subtle-link"
            style="display: none;">{t("settings.pwa_update_available", locale)}</a
          >
          <span
            id="pwa-installed-badge"
            class="badge badge-active"
            style="font-size: 11px; display: none;">{t("settings.pwa_installed", locale)}</span
          >
          <span class="pwa-link-separator" aria-hidden="true">·</span>
          <a
            href="#"
            id="pwa-popout-btn"
            class="pwa-subtle-link"
            title={t("settings.pwa_open_browser_title", locale)}
            >{t("settings.pwa_open_browser", locale)}</a
          >
          <span class="pwa-link-separator" aria-hidden="true">·</span>
          <a href="#" id="pwa-uninstall-btn" class="pwa-subtle-link"
            >{t("settings.pwa_uninstall", locale)}</a
          >
        </div>
        <!-- Uninstall instructions (hidden by default) -->
        <div
          id="pwa-uninstall-info"
          style="display: none; margin-top: 6px; font-size: 12px; color: var(--text-muted); line-height: 1.6; padding: 8px 12px; background: var(--bg-secondary); border-radius: 8px;"
        >
          <strong style="color: var(--text-secondary);"
            >How to uninstall:</strong
          ><br />
          <p set:html={t("settings.pwa_uninstall_how", locale)}></p>
          <small style="margin-top: 4px; display: block;"
            >{t("settings.pwa_uninstall_safe", locale)}</small
          >
        </div>
        <details
          id="pwa-compact-details"
          style="display: none; margin-top: 6px;"
        >
          <summary
            style="font-size: 12px; color: var(--accent); cursor: pointer; list-style: none;"
          >
            {t("settings.pwa_why_unavailable", locale)}
          </summary>
          <div
            style="margin-top: 6px; font-size: 12px; color: var(--text-muted); line-height: 1.6; padding: 8px 12px; background: var(--bg-secondary); border-radius: 8px;"
            set:html={t("settings.pwa_why_unavailable_desc", locale)}
          >
          </div>
        </details>
        <!-- PWA Troubleshooting -->
        <details id="pwa-troubleshoot" style="margin-top: 6px;">
          <summary
            class="pwa-subtle-link"
            style="list-style: none; cursor: pointer; display: inline;"
            >{t("settings.pwa_troubleshooting", locale)}</summary
          >
          <div class="pwa-troubleshoot-panel">
            <p
              style="margin: 0 0 8px; font-size: 12px; color: var(--text-muted);"
            >
              {t("settings.pwa_troubleshoot_desc", locale)}
            </p>
            <div style="display: flex; gap: 6px; flex-wrap: wrap;">
              <button
                type="button"
                id="pwa-clear-cache-btn"
                class="btn btn-ghost pwa-troubleshoot-btn"
                >{t("settings.pwa_clear_cache", locale)}</button
              >
              <button
                type="button"
                id="pwa-force-update-btn"
                class="btn btn-ghost pwa-troubleshoot-btn"
                >{t("settings.pwa_force_update", locale)}</button
              >
              <button
                type="button"
                id="pwa-clear-offline-btn"
                class="btn btn-ghost pwa-troubleshoot-btn"
                >{t("settings.pwa_clear_offline", locale)}</button
              >
            </div>
            <div
              style="display: flex; gap: 6px; flex-wrap: wrap; margin-top: 6px;"
            >
              <button
                type="button"
                id="pwa-test-notification"
                aria-describedby="pwa-notification-help"
                class="btn btn-ghost pwa-troubleshoot-btn"
                >{t("settings.pwa_test_notification", locale)}</button
              >
              <button
                type="button"
                id="pwa-reset-hints-btn"
                class="btn btn-ghost pwa-troubleshoot-btn"
                >{t("settings.pwa_reset_hints", locale)}</button
              >
            </div>
            <p id="pwa-notification-help" class="settings-companion-card__hint">{t("settings.pwa_notification_help", locale)}</p>
            <p
              id="pwa-notification-result"
              class="settings-companion-card__hint"
              role="status"
              data-sending={t("settings.pwa_notification_sending", locale)}
              data-unsupported={t("settings.pwa_notification_unsupported", locale)}
              data-denied={t("settings.pwa_notification_blocked", locale)}
              data-declined={t("settings.pwa_notification_declined", locale)}
              data-body={t("settings.pwa_notification_test_body", locale)}
              data-sent={t("settings.pwa_notification_sent", locale)}
              data-unavailable={t("settings.pwa_notification_unavailable", locale)}
            ></p>
            <div
              id="pwa-troubleshoot-result"
              style="display: none; margin-top: 6px; font-size: 11px; padding: 6px 10px; border-radius: 6px; background: var(--bg-secondary); border: 1px solid var(--border);"
            >
            </div>
          </div>
        </details>
        <div
          id="pwa-companion-open"
          class="settings-companion-card"
          data-companion-xcallback="app-pwa-settings"
        >
          <div class="settings-companion-card__copy">
            <strong>{t("settings.pwa_companion_title", locale)}</strong>
            <p set:html={t("settings.pwa_companion_desc", locale)}>
            </p>
          </div>
          <div class="settings-companion-card__actions">
            <a
              href="#"
              class="btn btn-primary"
              data-companion-link="app-pwa-settings"
              >{t("settings.pwa_companion_open", locale)}</a
            >
            <button
              type="button"
              class="btn btn-secondary"
              data-companion-xcallback-button
            >
              {t("settings.pwa_companion_copy_url", locale)}
            </button>
            <a
              href="#app-pwa-settings"
              class="btn btn-ghost"
              data-settings-section-link
              >{t("settings.pwa_companion_stay", locale)}</a
            >
          </div>
          <code
            class="settings-companion-card__preview"
            data-companion-xcallback-preview
          ></code>
          <small class="settings-companion-card__hint">
            {t("settings.pwa_companion_hint", locale)}
          </small>
        </div>
      </div>
    </div>
    <SettingsActionRow
      style="margin-top: 16px; padding-top: 12px; border-top: 1px solid var(--border);"
    >
      <a
        href="https://github.com/ryan-winkler/meitheal/issues/new/choose"
        target="_blank"
        rel="noopener noreferrer"
        class="btn btn-secondary settings-link"
        >{t("settings.pwa_report_issue", locale)}</a
      >
      <a
        href="https://github.com/ryan-winkler/meitheal/discussions"
        target="_blank"
        rel="noopener noreferrer"
        class="btn btn-secondary settings-link"
        >{t("settings.pwa_discussions", locale)}</a
      >
      <a
        href="https://github.com/ryan-winkler/meitheal"
        target="_blank"
        rel="noopener noreferrer"
        class="btn btn-secondary settings-link"
        >{t("settings.pwa_star_github", locale)}</a
      >
    </SettingsActionRow>
  </SettingsPanelCard>

  <!-- Data Portability -->
  <SettingsPanelCard
    title={t("settings.data_title", locale)}
    subtitle={t("settings.data_subtitle", locale)}
  >
    <SettingsCallout title={t("settings.callout_data_title", locale)} icon="🗂">
      {t("settings.callout_data_desc", locale)}
    </SettingsCallout>
    <div class="form-group mt-3">
      <label class="form-label mb-2"
        >{t("settings.export_tasks", locale)}</label
      >
      <SettingsActionRow>
        <a
          href="#"
          class="btn btn-primary"
          id="export-json-btn"
          style="flex: 1; text-align: center; text-decoration: none;"
          >{t("settings.download_json", locale)}</a
        >
        <a
          href="/api/export/tasks.csv"
          download
          class="btn btn-secondary"
          id="export-csv-btn"
          style="flex: 1; text-align: center; text-decoration: none;"
          >{t("settings.download_csv", locale)}</a
        >
        {databaseDownloadToken && (
          <>
            <form id="export-db-form" method="post" action="/api/export/database.sqlite" hidden>
              <input type="hidden" name="token" value={databaseDownloadToken} />
            </form>
            <button type="button" class="btn btn-secondary" id="export-db-btn"
              style="flex: 1; text-align: center;">{t("settings.raw_db", locale)}</button>
          </>
        )}
      </SettingsActionRow>
      <small class="settings-hint" style="display: block; margin-top: 6px;">
        {t(databaseDownloadToken ? "settings.export_hint_admin" : "settings.export_hint", locale)}
      </small>
    </div>

    <div
      class="form-group"
      style="margin-top: 16px; border-top: 1px solid var(--border-color); padding-top: 16px;"
    >
      <label class="form-label mb-2"
        >{t("settings.settings_config", locale)}</label
      >
      <SettingsActionRow>
        <a
          href="/api/export/settings.json"
          download
          class="btn btn-secondary flex-1 text-center no-underline"
          id="export-settings-btn"
          >{t("settings.export_config", locale)}</a
        >
        <label
          class="settings-file-picker btn btn-secondary flex-1 text-center no-underline"
          style="cursor: pointer; margin: 0; padding: 6px 16px; display: inline-flex; justify-content: center; align-items: center;"
        >
          {t("settings.import_config", locale)}
          <input
            type="file"
            id="import-settings-input"
            accept=".json"
          />
        </label>
      </SettingsActionRow>
      <small class="settings-hint" style="display: block; margin-top: 6px;">
        {t("settings.config_hint", locale)}
      </small>
    </div>
  </SettingsPanelCard>

  </div>
</section>

<style is:inline>
  .pwa-compact-row {
    padding: 8px 0;
    border-top: 1px solid var(--border);
  }
  .pwa-compact-dot {
    display: inline-block;
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--text-muted);
    transition:
      background 300ms ease,
      box-shadow 300ms ease;
  }
  .pwa-compact-dot--active {
    background: var(--accent);
    box-shadow: 0 0 6px rgba(99, 102, 241, 0.4);
  }
  .pwa-compact-dot--unavailable {
    background: #f59e0b;
  }
  .pwa-subtle-link {
    font-size: 11px;
    color: var(--text-muted);
    text-decoration: underline;
    text-underline-offset: 2px;
    cursor: pointer;
    transition: color 0.15s ease;
    background: none;
    border: none;
    padding: 0;
    font-family: inherit;
  }
  .pwa-subtle-link:hover {
    color: var(--accent);
  }
  .pwa-link-separator {
    font-size: 11px;
    color: var(--text-muted);
    opacity: 0.4;
    user-select: none;
  }
  .pwa-troubleshoot-panel {
    margin-top: 8px;
    padding: 10px 12px;
    background: var(--bg-secondary);
    border: 1px solid var(--border);
    border-radius: 8px;
  }
  .pwa-troubleshoot-btn {
    font-size: 11px !important;
    padding: 4px 10px !important;
  }
  .settings-companion-card {
    display: flex;
    flex-direction: column;
    gap: 12px;
    margin-top: 12px;
    padding: 14px;
    border: 1px solid color-mix(in srgb, var(--accent) 24%, var(--border));
    border-radius: 14px;
    background:
      linear-gradient(
        135deg,
        color-mix(in srgb, var(--accent) 9%, transparent),
        color-mix(in srgb, var(--bg-secondary) 94%, transparent)
      );
  }
  .settings-companion-card__copy p {
    margin: 6px 0 0;
    font-size: 12px;
    line-height: 1.65;
    color: var(--text-muted);
  }
  .settings-companion-card__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }
  .settings-companion-card__preview {
    display: block;
    overflow-wrap: anywhere;
    padding: 10px 12px;
    border-radius: 10px;
    border: 1px solid var(--border);
    background: color-mix(in srgb, var(--bg-primary) 82%, black 18%);
    color: var(--text-secondary);
    font-size: 11px;
    line-height: 1.5;
  }
  .settings-companion-card__hint {
    font-size: 11px;
    color: var(--text-muted);
    line-height: 1.6;
  }
</style>

<script>
  import { pageLifecycle } from "../../lib/page-lifecycle"

  function initPwaCompact() {
    const dot = document.getElementById("pwa-compact-dot")
    const label = document.getElementById("pwa-compact-label")
    const badge = document.getElementById("pwa-compact-badge")
    const details = document.getElementById("pwa-compact-details")
    const versionEl = document.getElementById("pwa-compact-version")
    const installBtn = document.getElementById("pwa-install-settings-btn")
    const updateBtn = document.getElementById("pwa-update-settings-btn")
    const installedBadge = document.getElementById("pwa-installed-badge")
    if (!dot || !label || !badge) return

    const isSecure = window.isSecureContext
    const hasSW = "serviceWorker" in navigator

    if (isSecure && hasSW) {
      dot.className = "pwa-compact-dot pwa-compact-dot--active"
      if (label && label.dataset.activeText) label.textContent = label.dataset.activeText
      if (badge && badge.dataset.activeText) {
        badge.textContent = badge.dataset.activeText
        badge.className = "badge badge-active"
      }
      badge.style.fontSize = "11px"

      // Query SW version — use abort signal for cleanup
      if (navigator.serviceWorker.controller && versionEl) {
        const swContainer = navigator.serviceWorker as EventTarget
        pageLifecycle.on(swContainer as unknown as HTMLElement, "message", ((e: MessageEvent) => {
          if (e.data?.type === "VERSION") {
            versionEl.textContent = `SW v${e.data.version}`
            versionEl.style.display = ""
          }
        }) as EventListener)
        navigator.serviceWorker.controller.postMessage({ type: "GET_VERSION" })
      }

      // Check for waiting SW (update available)
      if (updateBtn) {
        navigator.serviceWorker.ready.then((reg) => {
          if (reg.waiting) {
            updateBtn.style.display = ""
            pageLifecycle.on(updateBtn, "click", (e: Event) => {
              e.preventDefault()
              reg.waiting?.postMessage({ type: "SKIP_WAITING" })
              window.location.reload()
            })
          }
        })
      }
    } else {
      dot.className = "pwa-compact-dot pwa-compact-dot--unavailable"
      if (label && label.dataset.httpText) label.textContent = label.dataset.httpText
      if (badge && badge.dataset.httpText) {
        badge.textContent = badge.dataset.httpText
        badge.className = "badge badge-pending"
      }
      badge.style.fontSize = "11px"
      if (details) details.style.display = "block"
    }

    // Install button — show when install prompt available
    if (installBtn) {
      const showInstallBtn = () => {
        if ((window as any).__pwa_install_prompt) {
          installBtn.style.display = ""
        }
      }
      showInstallBtn()
      pageLifecycle.on(window as unknown as HTMLElement, "meitheal-pwa-installable", showInstallBtn)

      pageLifecycle.on(installBtn, "click", async (e: Event) => {
        e.preventDefault()
        const prompt = (window as any).__pwa_install_prompt
        if (!prompt) return
        try {
          await prompt.prompt()
          const result = await prompt.userChoice
          if (result.outcome === "accepted") {
            installBtn.style.display = "none"
            if (installedBadge) installedBadge.style.display = ""
          }
        } catch {
          /* prompt can only be called once */
        }
        ;(window as any).__pwa_install_prompt = null
      })
    }

    // Listen for installed event — pageLifecycle handles cleanup
    pageLifecycle.on(window as unknown as HTMLElement, "meitheal-pwa-installed", () => {
      const ib = document.getElementById("pwa-install-settings-btn")
      const iBadge = document.getElementById("pwa-installed-badge")
      if (ib) ib.style.display = "none"
      if (iBadge) iBadge.style.display = ""
    })
  }

  initPwaCompact()

  // ── Pop out to browser (escape HA iframe for PWA install) ──
  function initPwaPopout() {
    const popoutBtn = document.getElementById("pwa-popout-btn")
    const uninstallBtn = document.getElementById("pwa-uninstall-btn")
    const uninstallInfo = document.getElementById("pwa-uninstall-info")
    if (!popoutBtn) return

    pageLifecycle.on(popoutBtn, "click", (e: Event) => {
      e.preventDefault()
      const ingressPath = (window as any).__ingress_path || ""
      let targetUrl: string

      if (ingressPath) {
        try {
          const parentOrigin =
            window.top?.location?.origin || window.location.origin
          targetUrl = parentOrigin + ingressPath + "/settings#app-pwa-settings"
        } catch {
          const referrer = document.referrer
          if (referrer) {
            const refUrl = new URL(referrer)
            targetUrl =
              refUrl.origin + ingressPath + "/settings#app-pwa-settings"
          } else {
            targetUrl = ingressPath + "/settings#app-pwa-settings"
          }
        }
      } else {
        targetUrl = window.location.origin + "/settings#app-pwa-settings"
      }

      window.open(targetUrl, "_blank", "noopener")
    })

    if (uninstallBtn) {
      pageLifecycle.on(uninstallBtn, "click", (e: Event) => {
        e.preventDefault()
        if (uninstallInfo) {
          const showing = uninstallInfo.style.display !== "none"
          uninstallInfo.style.display = showing ? "none" : "block"
        }
      })
    }
  }

  initPwaPopout()

  // ── PWA Troubleshooting Actions ──
  function showTroubleshootResult(msg: string, ok = true) {
    const el = document.getElementById("pwa-troubleshoot-result")
    if (!el) return
    el.textContent = msg
    el.style.display = "block"
    el.style.color = ok ? "var(--accent)" : "var(--danger)"
    setTimeout(() => {
      el.style.display = "none"
    }, 4000)
  }

  function initPwaTroubleshooting() {
    const clearCacheBtn = document.getElementById("pwa-clear-cache-btn")
    const forceUpdateBtn = document.getElementById("pwa-force-update-btn")
    const clearOfflineBtn = document.getElementById("pwa-clear-offline-btn")
    const resetHintsBtn = document.getElementById("pwa-reset-hints-btn")
    if (!clearCacheBtn) return

    pageLifecycle.on(clearCacheBtn, "click", async () => {
      try {
        const names = await caches.keys()
        await Promise.all(names.map((n) => caches.delete(n)))
        showTroubleshootResult(
          `✓ Cleared ${names.length} cache(s). Reload to re-populate.`,
        )
      } catch {
        showTroubleshootResult("✗ Failed to clear caches.", false)
      }
    })

    if (forceUpdateBtn) {
      pageLifecycle.on(forceUpdateBtn, "click", async () => {
        try {
          if (!("serviceWorker" in navigator)) {
            showTroubleshootResult("Service workers not available.", false)
            return
          }
          const reg = await navigator.serviceWorker.getRegistration()
          if (reg) {
            await reg.update()
            if (reg.waiting) {
              reg.waiting.postMessage({ type: "SKIP_WAITING" })
            }
            showTroubleshootResult("✓ SW update triggered. Reloading...")
            setTimeout(() => window.location.reload(), 800)
          } else {
            showTroubleshootResult("No service worker registered.", false)
          }
        } catch {
          showTroubleshootResult("✗ SW update failed.", false)
        }
      })
    }

    if (clearOfflineBtn) {
      pageLifecycle.on(clearOfflineBtn, "click", async () => {
        try {
          const dbNames = [
            "meitheal-offline",
            "meitheal-tasks",
            "meitheal-sync",
            "task_attachments",
          ]
          let deleted = 0
          for (const name of dbNames) {
            try {
              const req = indexedDB.deleteDatabase(name)
              await new Promise<void>((resolve, reject) => {
                req.onsuccess = () => {
                  deleted++
                  resolve()
                }
                req.onerror = () => reject(req.error)
                req.onblocked = () => resolve()
              })
            } catch {
              /* skip individual failures */
            }
          }
          ;[
            "meitheal-sync-queue",
            "meitheal-last-sync",
            "meitheal-offline-tasks",
          ].forEach((k) => {
            try {
              localStorage.removeItem(k)
            } catch { /* non-fatal */ }
          })
          showTroubleshootResult(
            `✓ Cleared ${deleted} offline database(s) and sync state.`,
          )
        } catch {
          showTroubleshootResult("✗ Failed to clear offline data.", false)
        }
      })
    }

    if (resetHintsBtn) {
      pageLifecycle.on(resetHintsBtn, "click", () => {
        const keys = [
          "meitheal-pwa-dismissed",
          "meitheal_shortcut_hint_dismissed",
        ]
        let cleared = 0
        keys.forEach((k) => {
          if (localStorage.getItem(k) !== null) {
            localStorage.removeItem(k)
            cleared++
          }
        })
        showTroubleshootResult(
          cleared > 0
            ? `✓ Reset ${cleared} hint(s). They'll reappear on next page load.`
            : "No dismissed hints to reset.",
        )
      })
    }
  }

  initPwaTroubleshooting()
</script>

