<style is:inline>
  /* ── Unified Look & Feel Card Stack & Tabler Image-Check Tiles ── */
  .look-feel-stack {
    display: flex;
    flex-direction: column;
    gap: 20px;
  }

  .tabler-card-sections {
    display: flex;
    flex-direction: column;
    gap: 20px;
  }

  .tabler-opt-group {
    display: flex;
    flex-direction: column;
    gap: 8px;
    min-width: 0;
  }

  .tabler-opt-heading {
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--text-primary);
    line-height: 1.3;
  }

  .tabler-opt-sub {
    margin: -2px 0 4px;
  }

  .tabler-opt-row {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 280px), 1fr));
    gap: 20px;
    align-items: start;
  }

  .tabler-ha-row {
    padding: 12px 14px;
    border: 1px solid var(--border);
    border-radius: var(--radius-md, 10px);
    background: var(--bg-secondary);
  }

  .tabler-ha-row input[type="checkbox"] {
    accent-color: var(--accent);
    width: 16px;
    height: 16px;
  }

  .tabler-visual-grid {
    display: grid;
    gap: 12px;
  }

  .tabler-visual-grid--2 {
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 148px), 1fr));
  }

  .tabler-visual-grid--3 {
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 148px), 1fr));
  }

  .tabler-visual-grid--4 {
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 148px), 1fr));
  }

  .tabler-visual-grid--5 {
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 136px), 1fr));
  }

  .tabler-visual-grid--6 {
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 120px), 1fr));
  }

  /* Symmetrical 6x2 (desktop), 3x4 (tablet), 2x6 (mobile) grid for the 12 preset themes */
  .tabler-theme-group {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .tabler-visual-grid--themes {
    grid-template-columns: repeat(6, minmax(0, 1fr));
  }

  @media (max-width: 960px) {
    .tabler-visual-grid--themes {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  @media (max-width: 560px) {
    .tabler-visual-grid--themes {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  .tabler-custom-theme-row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 10px;
  }

  .tabler-custom-row__copy {
    display: flex;
    flex-direction: column;
    gap: 2px;
    min-width: 0;
  }

  .tabler-custom-row__hint {
    font-size: 0.75rem;
    color: var(--text-muted);
    line-height: 1.35;
  }

  .tabler-custom-guide-link {
    white-space: nowrap;
  }

  .tabler-visual-card {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: stretch;
    gap: 8px;
    padding: 8px 8px 10px;
    border: 1.5px solid var(--border);
    border-radius: var(--radius-md, 10px);
    background: var(--bg-secondary);
    color: var(--text-primary);
    text-align: center;
    cursor: pointer;
    transition: border-color 150ms cubic-bezier(0.23, 1, 0.32, 1), background-color 150ms ease, box-shadow 150ms ease, transform 120ms cubic-bezier(0.23, 1, 0.32, 1);
  }

  .tabler-visual-card:hover {
    border-color: rgb(var(--accent-rgb) / 0.55);
    background: var(--bg-hover);
  }

  .tabler-visual-card:active {
    transform: scale(0.98);
  }

  .tabler-visual-card:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }

  .tabler-visual-card[aria-checked="true"] {
