---
import { t } from "../../i18n/translations"
import { APPEARANCE_PREFERENCES } from "../../lib/appearance-preferences"
import { INDIGO_SWATCH } from "../../lib/design-tokens"
import type { Locale } from "../../lib/locale"
import { SETTINGS_SECTIONS } from "../../lib/settings-registry"
import { canManageSystemSettings } from "../../lib/settings-security"
import SettingsPanelCard from "./SettingsPanelCard.astro"
import SettingsSectionIntro from "./SettingsSectionIntro.astro"
import Icon from "../ui/Icon.astro"

interface Props {
  locale: Locale
}
const { locale } = Astro.props
const canManageTheme = canManageSystemSettings(Astro.request, Astro.locals)

const lookAndFeelSection = SETTINGS_SECTIONS.find((section) => section.id === "look-and-feel-settings")!

const PRESET_THEME_OPTIONS = [
  { value: "auto", label: t("settings.theme_auto", locale), short: "Auto" },
  { value: "light", label: t("settings.theme_light", locale), short: "Paper Emerald" },
  { value: "zen-paper", label: "Zen Paper (Light)", short: "Zen Paper" },
  { value: "catppuccin-latte", label: "Catppuccin Latte (Light)", short: "Catppuccin Latte" },
  { value: "nordic-frost", label: "Nordic Frost (Light)", short: "Nordic Frost" },
  { value: "solarized-dawn", label: "Solarized Dawn (Light)", short: "Solarized Dawn" },
  { value: "dark", label: t("settings.theme_dark", locale), short: "Emerald Isle" },
  { value: "knight-rider", label: t("settings.theme_knight_rider", locale), short: "Knight Rider" },
  { value: "plainspace", label: "Plainspace (Dark)", short: "Plainspace" },
  { value: "velvet", label: "Velvet (Dark)", short: "Velvet" },
  { value: "liquid-glass", label: "Liquid Glass (macOS Dark)", short: "Liquid Glass" },
  { value: "rainbow", label: "Rainbow (Dark Prism)", short: "Rainbow" },
]

const THEME_OPTIONS = [
  ...PRESET_THEME_OPTIONS,
  ...(canManageTheme ? [{ value: "custom", label: t("settings.theme_custom", locale), short: "Custom CSS" }] : []),
]

const ACCENT_SWATCHES = [
  { color: "#69E3B2", label: t("settings.accent_mint", locale) },
  { color: INDIGO_SWATCH, label: t("settings.accent_indigo", locale) },
  { color: "#14b8a6", label: t("settings.accent_teal", locale) },
  { color: "#3b82f6", label: t("settings.accent_blue", locale) },
  { color: "#6495ed", label: t("settings.accent_cornflower", locale) },
  { color: "#8b5cf6", label: t("settings.accent_violet", locale) },
  { color: "#ec4899", label: t("settings.accent_pink", locale) },
  { color: "#f59e0b", label: t("settings.accent_amber", locale) },
  { color: "#ef4444", label: t("settings.accent_red", locale) },
]

const FONT_CARDS = [
  { value: "sans", label: t("settings.appearance_font_sans", locale), stack: "'Geist Variable', -apple-system, BlinkMacSystemFont, sans-serif" },
  { value: "serif", label: t("settings.appearance_font_serif", locale), stack: "'Iowan Old Style', 'Palatino Linotype', Georgia, serif" },
  { value: "mono", label: t("settings.appearance_font_mono", locale), stack: "'JetBrains Mono', ui-monospace, monospace" },
  { value: "comic", label: t("settings.appearance_font_comic", locale), stack: "'Comic Neue', 'Comic Sans MS', cursive" },
  { value: "outfit", label: t("settings.appearance_font_outfit", locale), stack: "'Outfit', 'Geist Variable', sans-serif" },
]

const BASE_PALETTE_CARDS = [
  { value: "slate", label: t("settings.appearance_base_slate", locale), shades: ["#f1f5f9", "#cbd5e1", "#64748b", "#334155", "#0f172a"] },
  { value: "gray", label: t("settings.appearance_base_gray", locale), shades: ["#f3f4f6", "#d1d5db", "#6b7280", "#374151", "#111827"] },
  { value: "zinc", label: t("settings.appearance_base_zinc", locale), shades: ["#f4f4f5", "#d4d4d8", "#71717a", "#3f3f46", "#18181b"] },
  { value: "neutral", label: t("settings.appearance_base_neutral", locale), shades: ["#f5f5f5", "#d4d4d4", "#737373", "#404040", "#171717"] },
  { value: "stone", label: t("settings.appearance_base_stone", locale), shades: ["#f5f5f4", "#d6d3d1", "#78716c", "#44403c", "#1c1917"] },
  { value: "mist", label: t("settings.appearance_base_mist", locale), shades: ["#eff3f4", "#ced9dc", "#6d858c", "#334449", "#162023"] },
]

const RADIUS_CARDS = [
  { value: "0", label: t("settings.appearance_radius_0", locale) },
  { value: "0.5", label: t("settings.appearance_radius_0_5", locale) },
  { value: "1", label: t("settings.appearance_radius_1", locale) },
  { value: "1.5", label: t("settings.appearance_radius_1_5", locale) },
  { value: "2", label: t("settings.appearance_radius_2", locale) },
]

const NAV_LAYOUT_CARDS = [
  { value: "sidebar", label: t("settings.appearance_navigation_sidebar", locale), desc: "Collapsible left rail" },
  { value: "navbar", label: t("settings.appearance_navigation_navbar", locale), desc: "Tabler condensed bar" },
]

const NAV_TONE_CARDS = [
  { value: "match", label: t("settings.appearance_navTone_match", locale) },
  { value: "dark", label: t("settings.appearance_navTone_dark", locale) },
  { value: "accent", label: t("settings.appearance_navTone_accent", locale) },
]

const NAV_STYLE_CARDS = [
  { value: "attached", label: t("settings.appearance_navStyle_attached", locale) },
  { value: "floating", label: t("settings.appearance_navStyle_floating", locale) },
]

const SIDEBAR_BEHAVIOR_CARDS = [
  { value: "remember", label: t("settings.appearance_sidebar_remember", locale) },
  { value: "expanded", label: t("settings.appearance_sidebar_expanded", locale) },
  { value: "folded", label: t("settings.appearance_sidebar_folded", locale) },
  { value: "hover", label: t("settings.appearance_sidebar_hover", locale) },
]

const WIDTH_CARDS = [
  { value: "default", label: t("settings.appearance_width_default", locale) },
  { value: "fluid", label: t("settings.appearance_width_fluid", locale) },
  { value: "boxed", label: t("settings.appearance_width_boxed", locale) },
]

const HEADER_CARDS = [
  { value: "sticky", label: t("settings.appearance_header_sticky", locale) },
  { value: "default", label: t("settings.appearance_header_default", locale) },
]

const PANEL_STYLE_CARDS = [
  { value: "attached", label: t("settings.appearance_panelStyle_attached", locale) },
  { value: "floating", label: t("settings.appearance_panelStyle_floating", locale) },
]

const ALL_PREFERENCE_NAMES = Object.keys(APPEARANCE_PREFERENCES) as (keyof typeof APPEARANCE_PREFERENCES)[]

/**
 * Tabler ThemeSettings.astro 96×64 vector tiles adapted to Meitheal design tokens.
 * Tiles stay mode- and accent-aware via CSS custom properties.
 */
const PAGE = "var(--bg-secondary)"
const SURFACE = "var(--bg-card)"
const BORDER = "var(--border)"
const PRIMARY = "var(--accent)"
const ON_ACCENT = "rgba(255, 255, 255, 0.78)"

const wrapSvg = (inner: string) =>
  `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 96 64" class="tabler-tile-svg" aria-hidden="true" focusable="false">${inner}</svg>`
const frame = (fill: string) => `<rect x="0.5" y="0.5" width="95" height="63" rx="6" fill="${fill}" stroke="${BORDER}" />`
const outline = `<rect x="0.5" y="0.5" width="95" height="63" rx="6" fill="none" stroke="${BORDER}" />`
const topBar = (fill: string) =>
  `<path d="M6.5 0.5h83a6 6 0 0 1 6 6v13.5h-95v-13.5a6 6 0 0 1 6 -6z" fill="${fill}" /><rect x="0.5" y="19.5" width="95" height="0.5" fill="${BORDER}" />`
const rail = (w: number, fill: string) =>
  `<path d="M6.5 0.5h${w - 6}v63h-${w - 6}a6 6 0 0 1 -6 -6v-51a6 6 0 0 1 6 -6z" fill="${fill}" /><rect x="${w}" y="0.5" width="0.5" height="63" fill="${BORDER}" />`
const lines = (x: number, y: number, widths: number[], fill: string, step = 11) =>
  widths.map((w, i) => `<rect x="${x}" y="${y + i * step}" width="${w}" height="5" rx="2.5" fill="${fill}" />`).join("")
const dots = (x: number, y: number, count: number, fill: string) =>
  Array.from({ length: count }, (_, i) => `<circle cx="${x}" cy="${y + i * 11}" r="2.5" fill="${fill}" />`).join("")
const cardBox = (x: number, y: number, w: number, h: number) =>
  `<rect x="${x}" y="${y}" width="${w}" height="${h}" rx="3" fill="${SURFACE}" stroke="${BORDER}" />` +
  lines(x + 6, y + 7, [Math.round(w * 0.6), Math.round(w * 0.8), Math.round(w * 0.4)], BORDER, 9)
const thumb = (y: number) => `<rect x="90" y="${y}" width="3" height="14" rx="1.5" fill="${BORDER}" />`

function themeTileSvg(value: string): string {
  const lightBg = "#f5faf7"
  const lightBar = "#ffffff"
  const lightLine = "#c4dacd"
  const darkBg = "#131314"
  const darkBar = "#1a1a1b"
  const darkLine = "#36363a"
  if (value === "auto") {
    return wrapSvg(
      `<path d="M6.5 0.5h41.5v63h-41.5a6 6 0 0 1 -6 -6v-51a6 6 0 0 1 6 -6z" fill="${lightBg}" />` +
      `<path d="M48 0.5h41.5a6 6 0 0 1 6 6v51a6 6 0 0 1 -6 6h-41.5z" fill="${darkBg}" />` +
      `<path d="M6.5 0.5h41.5v19.5h-47.5v-13.5a6 6 0 0 1 6 -6z" fill="${lightBar}" />` +
      `<path d="M48 0.5h41.5a6 6 0 0 1 6 6v13.5h-47.5z" fill="${darkBar}" />` +
      `<rect x="10" y="8" width="22" height="4" rx="2" fill="#047857" />` +
      `<rect x="54" y="8" width="22" height="4" rx="2" fill="#6495ED" />` +
      `<rect x="0.5" y="19.5" width="95" height="0.5" fill="${BORDER}" />` +
      lines(12, 30, [30, 32, 22], lightLine) +
      lines(54, 30, [26, 30, 18], darkLine) +
      outline,
    )
  }
  if (value === "light") {
    return wrapSvg(
      frame("#f5faf7") +
      topBar("#ffffff") +
      `<rect x="10" y="8" width="26" height="4" rx="2" fill="#047857" />` +
      lines(12, 30, [46, 72, 30], "#c4dacd") +
      outline,
    )
  }
  if (value === "zen-paper") {
    return wrapSvg(
      frame("#f4ece0") +
      topBar("#faf6ee") +
      `<rect x="10" y="8" width="26" height="4" rx="2" fill="#5C6F2E" />` +
      lines(12, 30, [48, 68, 34], "#d2c3ab") +
      outline,
    )
  }
  if (value === "catppuccin-latte") {
    return wrapSvg(
      frame("#f5f0ec") +
      topBar("#fffdfb") +
      `<rect x="10" y="8" width="26" height="4" rx="2" fill="#8839EF" />` +
      lines(12, 30, [44, 70, 32], "#d9ccc2") +
      outline,
    )
  }
  if (value === "nordic-frost") {
    return wrapSvg(
      frame("#ebf3fa") +
      topBar("#f7fbff") +
      `<rect x="10" y="8" width="26" height="4" rx="2" fill="#0277B1" />` +
      lines(12, 30, [46, 68, 30], "#b6cde3") +
      outline,
    )
  }
  if (value === "solarized-dawn") {
    return wrapSvg(
      frame("#fdf6e3") +
      topBar("#fffdf6") +
      `<rect x="10" y="8" width="26" height="4" rx="2" fill="#2075C7" />` +
      lines(12, 30, [46, 72, 32], "#d5ccb4") +
      outline,
    )
  }
  if (value === "knight-rider") {
    return wrapSvg(
      frame("#131314") +
      topBar("#1a1a1b") +
      `<rect x="10" y="8" width="28" height="4" rx="2" fill="#6495ED" />` +
      lines(12, 30, [46, 72, 30], "#36363a") +
      outline,
    )
  }
  if (value === "plainspace") {
    return wrapSvg(
      frame("#1a1714") +
      `<path d="M24 20v43M48 20v43M72 20v43M1 36h94M1 50h94" stroke="rgba(255,240,220,0.08)" stroke-width="1" />` +
      topBar("#24201c") +
      `<rect x="10" y="8" width="28" height="4" rx="2" fill="#e59a66" />` +
      lines(12, 30, [46, 70, 32], "#463d34") +
      outline,
    )
  }
  if (value === "velvet") {
    return wrapSvg(
      frame("#12121d") +
      topBar("#1c1c2e") +
      `<rect x="10" y="8" width="28" height="4" rx="2" fill="#7c9cff" />` +
      lines(12, 30, [48, 68, 34], "#333352") +
      outline,
    )
  }
  if (value === "liquid-glass") {
    return wrapSvg(
      frame("#0b1220") +
      `<circle cx="24" cy="22" r="20" fill="#38bdf8" opacity="0.22" />` +
      `<circle cx="76" cy="52" r="18" fill="#818cf8" opacity="0.24" />` +
      `<rect x="8" y="25" width="80" height="30" rx="5" fill="rgba(24,37,59,0.72)" stroke="rgba(255,255,255,0.28)" />` +
      topBar("rgba(18,28,46,0.82)") +
      `<rect x="10" y="8" width="28" height="4" rx="2" fill="#60a5fa" />` +
      lines(14, 32, [42, 62], "rgba(226,232,240,0.34)", 10) +
      outline,
    )
  }
  if (value === "rainbow") {
    return wrapSvg(
      frame("#13111c") +
      topBar("#1e1a2e") +
      `<rect x="1" y="1" width="94" height="3" rx="1.5" fill="url(#mth-rainbow-grad)" />` +
      `<defs><linearGradient id="mth-rainbow-grad" x1="0" y1="0" x2="1" y2="0"><stop offset="0%" stop-color="#f43f5e"/><stop offset="25%" stop-color="#f59e0b"/><stop offset="50%" stop-color="#22c55e"/><stop offset="75%" stop-color="#38bdf8"/><stop offset="100%" stop-color="#c084fc"/></linearGradient></defs>` +
      `<rect x="10" y="9" width="28" height="4" rx="2" fill="#c084fc" />` +
      lines(12, 30, [46, 70, 32], "#3c3557") +
      outline,
    )
  }
  if (value === "custom") {
    return wrapSvg(
      frame(PAGE) +
      topBar(PRIMARY) +
      `<rect x="12" y="29" width="28" height="22" rx="3" fill="${SURFACE}" stroke="${BORDER}" stroke-dasharray="3 2" />` +
      lines(46, 31, [38, 28], BORDER, 9) +
      outline,
    )
  }
  // Emerald Isle (dark)
  return wrapSvg(
    frame(darkBg) +
    topBar(darkBar) +
    `<rect x="10" y="8" width="28" height="4" rx="2" fill="#69E3B2" />` +
    lines(12, 30, [46, 72, 30], darkLine) +
    outline,
  )
}

function tileSvg(key: string, value: string): string {
  switch (key) {
    case "navigation":
      return value === "sidebar"
        ? wrapSvg(frame(PAGE) + rail(30, PRIMARY) + lines(7, 10, [16, 16, 16, 16], ON_ACCENT, 10) + lines(40, 12, [40, 48, 28], BORDER) + outline)
        : wrapSvg(frame(PAGE) + topBar(PRIMARY) + [8, 26, 44].map((x) => `<rect x="${x}" y="8" width="14" height="4" rx="2" fill="${ON_ACCENT}" />`).join("") + lines(12, 30, [46, 72, 30], BORDER) + outline)
    case "navTone":
      if (value === "dark") {
        return wrapSvg(frame(PAGE) + topBar("#111827") + [8, 26, 44].map((x) => `<rect x="${x}" y="8" width="14" height="4" rx="2" fill="rgba(248,250,252,0.75)" />`).join("") + lines(12, 30, [46, 72, 30], BORDER) + outline)
      }
      if (value === "accent") {
        return wrapSvg(frame(PAGE) + topBar(PRIMARY) + [8, 26, 44].map((x) => `<rect x="${x}" y="8" width="14" height="4" rx="2" fill="${ON_ACCENT}" />`).join("") + lines(12, 30, [46, 72, 30], BORDER) + outline)
      }
      return wrapSvg(frame(PAGE) + topBar(SURFACE) + [8, 26, 44].map((x) => `<rect x="${x}" y="8" width="14" height="4" rx="2" fill="${BORDER}" />`).join("") + lines(12, 30, [46, 72, 30], BORDER) + outline)
    case "navStyle":
      return value === "floating"
        ? wrapSvg(frame(PAGE) + `<rect x="5" y="5" width="86" height="14" rx="4" fill="${PRIMARY}" />` + [11, 29, 47].map((x) => `<rect x="${x}" y="10" width="14" height="4" rx="2" fill="${ON_ACCENT}" />`).join("") + lines(12, 30, [46, 72, 30], BORDER) + outline)
        : wrapSvg(frame(PAGE) + topBar(PRIMARY) + [8, 26, 44].map((x) => `<rect x="${x}" y="8" width="14" height="4" rx="2" fill="${ON_ACCENT}" />`).join("") + lines(12, 30, [46, 72, 30], BORDER) + outline)
    case "sidebar":
      if (value === "folded") {
        return wrapSvg(frame(PAGE) + rail(16, PRIMARY) + dots(8, 12, 4, ON_ACCENT) + lines(26, 12, [50, 60, 34], BORDER) + outline)
      }
      if (value === "hover") {
        return wrapSvg(
          frame(PAGE) +
          rail(16, PRIMARY) +
          dots(8, 12, 4, ON_ACCENT) +
          lines(26, 12, [50, 60, 34], BORDER) +
          `<rect x="16" y="0.5" width="4" height="63" fill="#0f172a" opacity="0.14" />` +
          `<rect x="16.5" y="0.5" width="28" height="63" fill="${SURFACE}" stroke="${BORDER}" />` +
          lines(21, 9.5, [18, 18, 18, 18], BORDER, 11) +
          outline,
        )
      }
      if (value === "remember") {
        return wrapSvg(
          frame(PAGE) +
          rail(28, SURFACE) +
          lines(6, 10, [16, 12, 16], BORDER, 10) +
          `<circle cx="22" cy="50" r="4" fill="${PRIMARY}" />` +
          lines(38, 12, [42, 48, 28], BORDER) +
          outline,
        )
      }
      return wrapSvg(frame(PAGE) + rail(30, PRIMARY) + lines(7, 10, [16, 16, 16, 16], ON_ACCENT, 10) + lines(40, 12, [40, 48, 28], BORDER) + outline)
    case "width":
      if (value === "boxed") {
        return wrapSvg(`<rect x="0.5" y="0.5" width="95" height="63" rx="6" fill="var(--text-primary)" opacity="0.16" /><rect x="12" y="8" width="72" height="48" rx="4" fill="${PAGE}" />` + cardBox(18, 16, 60, 32) + outline)
      }
      return value === "fluid"
        ? wrapSvg(frame(PAGE) + cardBox(4, 8, 88, 48) + outline)
        : wrapSvg(frame(PAGE) + cardBox(22, 8, 52, 48) + outline)
    case "header":
      return value === "sticky"
        ? wrapSvg(frame(PAGE) + lines(12, 4, [46, 72, 30, 60], BORDER) + thumb(44) + `<rect x="0.5" y="19.5" width="95" height="5" fill="#0f172a" opacity="0.18" />` + topBar(PRIMARY) + outline)
        : wrapSvg(frame(PAGE) + topBar(PRIMARY) + lines(12, 30, [46, 72, 30], BORDER) + thumb(24) + outline)
    case "panelStyle":
      return value === "floating"
        ? wrapSvg(frame(PAGE) + lines(10, 12, [40, 48, 28], BORDER) + `<rect x="0.5" y="0.5" width="95" height="63" rx="6" fill="#0f172a" opacity="0.16" /><rect x="53" y="5" width="38" height="54" rx="4" fill="${SURFACE}" stroke="${BORDER}" />` + lines(59, 12, [20, 26, 14], BORDER) + outline)
        : wrapSvg(frame(PAGE) + lines(10, 12, [40, 48, 28], BORDER) + `<rect x="0.5" y="0.5" width="95" height="63" rx="6" fill="#0f172a" opacity="0.16" /><path d="M58 0.5h31.5a6 6 0 0 1 6 6v51a6 6 0 0 1 -6 6h-31.5z" fill="${SURFACE}" /><rect x="57.5" y="0.5" width="0.5" height="63" fill="${BORDER}" />` + lines(64, 12, [20, 26, 14], BORDER) + outline)
    case "radius": {
      const r = Number(value) * 10
      return wrapSvg(frame(PAGE) + `<rect x="28" y="12" width="40" height="40" rx="${r}" fill="${PRIMARY}" />` + outline)
    }
    default:
      return wrapSvg(frame(PAGE) + outline)
  }
}

function baseTileSvg(shades: readonly string[]): string {
  return wrapSvg(
    frame(SURFACE) +
    shades.map((hex, i) => `<rect x="${10 + i * 16}" y="22" width="12" height="20" rx="3" fill="${hex}" />`).join("") +
    outline,
  )
}
---

<section
  id="look-and-feel-settings"
  class="settings-shell__section"
  data-settings-shell-section
>
  <SettingsSectionIntro section={lookAndFeelSection} />

  <form
    id="appearance-preferences-form"
    data-appearance-form="look-and-feel"
    class="appearance-preferences-form look-feel-stack"
    aria-describedby="appearance-scope"
  >
    <!-- Hidden native selects kept in sync for form serialization & controller compatibility -->
    <div class="sr-only" aria-hidden="true">
      <select id="theme-select" name="theme" tabindex="-1">
        {THEME_OPTIONS.map((opt) => (
          <option value={opt.value}>{opt.label}</option>
        ))}
      </select>
      {ALL_PREFERENCE_NAMES.map((name) => {
        const pref = APPEARANCE_PREFERENCES[name]
        return (
          <select id={`appearance-${name}`} name={name} tabindex="-1">
            {pref.options.map((value) => (
              <option value={value} selected={value === pref.defaultValue}>{value}</option>
            ))}
          </select>
        )
      })}
    </div>

    <!-- Peer Card 1: Theme & Accent -->
    <SettingsPanelCard
      title={t("settings.look_feel_theme_title", locale)}
      subtitle={t("settings.look_feel_theme_subtitle", locale)}
    >
      <button slot="actions" type="reset" class="btn btn-ghost btn-sm" data-appearance-reset hidden>
        <Icon name="refresh" size={14} sprite={true} />
        <span>{t("settings.appearance_reset", locale)}</span>
      </button>
      <div class="tabler-card-sections">
        <p id="appearance-scope" class="settings-hint m-0">{t("settings.appearance_scope", locale)}</p>

        <!-- Color Scheme -->
        <div class="tabler-opt-group">
          <div class="settings-field-head">
            <span id="theme-group-label" class="tabler-opt-heading">{t("settings.theme_title", locale)}</span>
            <button type="button" class="settings-help-btn" data-settings-help="theme" aria-label="Help for Theme Mode">
              <Icon name="help" size={16} sprite={true} />
            </button>
          </div>
          <p class="settings-hint tabler-opt-sub">Choose your preferred color mode. Profile avatar and surfaces adapt automatically.</p>
          <div role="radiogroup" aria-labelledby="theme-group-label" data-visual-group="theme" class="tabler-theme-group">
            <div class="tabler-visual-grid tabler-visual-grid--themes">
              {PRESET_THEME_OPTIONS.map((opt, idx) => (
                <button
