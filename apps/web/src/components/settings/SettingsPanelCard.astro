---
import type { IconName } from "../../generated/icon-registry"
import Icon from "../ui/Icon.astro"

interface Props {
  id?: string | undefined
  title: string
  subtitle: string
  icon?: IconName | undefined
  tone?: "default" | "accent" | "danger" | undefined
  padded?: boolean | undefined
  collapsible?: boolean | undefined
  defaultOpen?: boolean | undefined
}

const {
  id,
  title,
  subtitle,
  icon,
  tone = "default",
  padded = true,
  collapsible = true,
  defaultOpen = true,
} = Astro.props

const hasActions = Astro.slots.has("actions")
const slugBase = (id || title)
  .toLowerCase()
  .replace(/[^a-z0-9]+/g, "-")
  .replace(/^-|-$/g, "") || "panel"
const bodyId = `${slugBase}-card-body`
---

<div
  id={id}
  class:list={["card", "settings-panel-card", `settings-panel-card--${tone}`]}
  data-settings-card={collapsible ? "" : undefined}
  data-card-collapsed={collapsible && !defaultOpen ? "true" : undefined}
>
  <div class="card-header settings-panel-card__header">
    {collapsible ? (
      <button
        type="button"
        class="settings-panel-card__toggle"
        data-settings-card-toggle
        aria-expanded={defaultOpen ? "true" : "false"}
        aria-controls={bodyId}
      >
        <span class="settings-panel-card__heading">
          <h3 class="card-title settings-panel-card__title">
            {icon && <Icon name={icon} size={18} sprite={true} />}
            <span>{title}</span>
          </h3>
          <span class="card-subtitle settings-panel-card__subtitle">{subtitle}</span>
        </span>
      </button>
    ) : (
      <div class="settings-panel-card__heading">
        <h3 class="card-title settings-panel-card__title">
          {icon && <Icon name={icon} size={18} sprite={true} />}
          <span>{title}</span>
        </h3>
        <div class="card-subtitle settings-panel-card__subtitle">{subtitle}</div>
      </div>
    )}

    <div class="settings-panel-card__header-end">
      {hasActions && (
        <div class="settings-panel-card__actions">
          <slot name="actions" />
        </div>
      )}
      {collapsible && (
        <button
          type="button"
          class="settings-panel-card__chevron"
          data-settings-card-toggle
          tabindex="-1"
          aria-hidden="true"
        >
          <Icon name="chevron-down" size={16} sprite={true} />
        </button>
      )}
    </div>
  </div>

  <div
    id={bodyId}
    class:list={["settings-panel-card__body", padded && "settings-panel-card__body--padded"]}
    data-settings-card-body
    hidden={collapsible && !defaultOpen ? true : undefined}
  >
    <slot />
  </div>
</div>

<style is:inline>
  .settings-panel-card {
    min-width: 0;
    padding: var(--settings-inset, 20px);
    border-radius: var(--radius-md, 12px);
  }

  .settings-panel-card__header {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 16px;
    margin: 0 0 18px;
    padding: 0 0 14px;
    border-bottom: 1px solid var(--border);
    transition: margin-bottom 160ms ease, padding-bottom 160ms ease, border-color 160ms ease;
  }

  .settings-panel-card[data-card-collapsed="true"] > .settings-panel-card__header {
    margin-bottom: 0;
    padding-bottom: 0;
    border-bottom-color: transparent;
  }

  .settings-panel-card__toggle {
    flex: 1 1 auto;
    min-width: 0;
    display: block;
    padding: 0;
    margin: 0;
    border: 0;
    background: transparent;
    color: inherit;
    text-align: left;
    font: inherit;
    cursor: pointer;
    border-radius: var(--radius-sm, 6px);
  }

  .settings-panel-card__toggle:hover .settings-panel-card__title {
    color: var(--accent-text);
  }

  .settings-panel-card__toggle:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 4px;
  }

  .settings-panel-card__heading {
    display: block;
    min-width: 0;
  }

  .settings-panel-card__title {
    display: flex;
    align-items: center;
    gap: 8px;
    margin: 0;
    font-size: 1.0625rem;
    transition: color 140ms ease;
  }

  .settings-panel-card__subtitle {
    display: block;
    max-width: 62ch;
    margin-top: 2px;
    color: var(--text-secondary);
    font-size: 0.875rem;
    line-height: 1.5;
  }

  .settings-panel-card__header-end {
    display: inline-flex;
    align-items: center;
    justify-content: flex-end;
    gap: 8px;
    flex-wrap: wrap;
    flex-shrink: 0;
  }

  .settings-panel-card__actions {
    display: inline-flex;
    align-items: center;
    justify-content: flex-end;
    gap: 8px;
    flex-wrap: wrap;
    flex-shrink: 0;
  }

  .settings-panel-card__chevron {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    inline-size: 28px;
    block-size: 28px;
    padding: 0;
    border: 1px solid transparent;
    border-radius: var(--radius-sm, 6px);
    background: transparent;
    color: var(--text-secondary);
    cursor: pointer;
    flex-shrink: 0;
    transition: transform 180ms cubic-bezier(0.23, 1, 0.32, 1), background-color 140ms ease, color 140ms ease;
  }

  .settings-panel-card__chevron:hover {
    background: var(--bg-hover);
    color: var(--text-primary);
  }

  .settings-panel-card[data-card-collapsed="true"] > .settings-panel-card__header .settings-panel-card__chevron {
    transform: rotate(-90deg);
  }

  .settings-panel-card__body[hidden] {
    display: none;
  }

  .settings-panel-card__body--padded {
    padding: 0;
  }

  .settings-panel-card--accent {
    border-color: color-mix(in srgb, var(--border) 68%, var(--accent));
    background: color-mix(in srgb, var(--bg-card) 96%, var(--accent));
  }

  .settings-panel-card--danger {
    border-width: 2px;
    border-color: color-mix(in srgb, var(--danger) 75%, var(--border));
    background: color-mix(in srgb, var(--bg-card) 96%, var(--danger));
  }

  .settings-panel-card--danger .settings-panel-card__title {
    color: var(--danger);
  }

  @media (max-width: 720px) {
    .settings-panel-card__header {
      flex-wrap: wrap;
    }

    .settings-panel-card__header-end {
      margin-inline-start: auto;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .settings-panel-card__header,
    .settings-panel-card__title,
    .settings-panel-card__chevron {
      transition: none;
    }
  }
</style>
