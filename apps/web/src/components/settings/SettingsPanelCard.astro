---
import type { IconName } from "../../generated/icon-registry"
import Icon from "../ui/Icon.astro"

interface Props {
  id?: string | undefined
  title: string
  subtitle: string
  icon?: IconName | undefined
  tone?: "default" | "accent" | "danger" | undefined
  padded?: boolean | undefined
}

const {
  id,
  title,
  subtitle,
  icon,
  tone = "default",
  padded = true,
} = Astro.props

const hasActions = Astro.slots.has("actions")
---

<div id={id} class:list={["card", "settings-panel-card", `settings-panel-card--${tone}`]}>
  <div class="card-header settings-panel-card__header">
    <div class="settings-panel-card__heading">
      <h3 class="card-title settings-panel-card__title">
        {icon && <Icon name={icon} size={18} sprite={true} />}
        <span>{title}</span>
      </h3>
      <div class="card-subtitle settings-panel-card__subtitle">{subtitle}</div>
    </div>

    {hasActions && (
      <div class="settings-panel-card__actions">
        <slot name="actions" />
      </div>
    )}
  </div>

  <div class:list={["settings-panel-card__body", padded && "settings-panel-card__body--padded"]}>
    <slot />
  </div>
</div>

<style>
  .settings-panel-card {
    min-width: 0;
    padding: var(--settings-inset, 16px);
    border-radius: 12px;
  }

  .settings-panel-card__header {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 16px;
    margin: 0 0 16px;
    padding: 0;
  }

  .settings-panel-card__heading {
    min-width: 0;
  }

  .settings-panel-card__title {
    display: flex;
    align-items: center;
    gap: 8px;
    margin: 0;
    font-size: 1.0625rem;
  }

  .settings-panel-card__subtitle {
    max-width: 62ch;
    color: var(--text-secondary);
    font-size: 0.875rem;
    line-height: 1.5;
  }

  .settings-panel-card__actions {
    display: inline-flex;
    align-items: center;
    justify-content: flex-end;
    gap: 8px;
    flex-wrap: wrap;
    flex-shrink: 0;
  }

  .settings-panel-card__body--padded {
    padding: 0;
  }

  .settings-panel-card--accent {
    border-color: color-mix(in srgb, var(--border) 68%, var(--accent));
    background: color-mix(in srgb, var(--bg-card) 96%, var(--accent));
  }

  .settings-panel-card--danger {
    border-width: 2px;
    border-color: color-mix(in srgb, var(--danger) 75%, var(--border));
    background: color-mix(in srgb, var(--bg-card) 96%, var(--danger));
  }

  .settings-panel-card--danger .settings-panel-card__title {
    color: var(--danger);
  }

  @media (max-width: 720px) {
    .settings-panel-card__header {
      flex-direction: column;
      align-items: stretch;
    }

    .settings-panel-card__actions {
      justify-content: flex-start;
    }
  }
</style>
