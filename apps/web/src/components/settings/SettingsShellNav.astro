---
import type { SettingsSectionDescriptor } from "../../lib/settings-registry"

interface Props {
  sections: SettingsSectionDescriptor[]
}

const { sections } = Astro.props
---

<nav class="settings-shell-nav" aria-label="Settings navigation">
  <div class="settings-shell-nav__list" role="list">
    {sections.map((section) => (
      <a
        href={`#${section.id}`}
        class="settings-shell-nav__link"
        data-settings-nav={section.id}
        data-settings-section-link
      >
        <span class="settings-shell-nav__icon" aria-hidden="true">{section.icon}</span>
        <span class="settings-shell-nav__content">
          <strong>{section.label}</strong>
          <small>{section.description}</small>
        </span>
        <span
          class="settings-shell-nav__status"
          id={`nav-status-${section.id}`}
          data-settings-nav-status
        >
          {section.statusLabel}
        </span>
      </a>
    ))}
  </div>
</nav>
