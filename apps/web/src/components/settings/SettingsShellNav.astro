---
import Icon from "../ui/Icon.astro"
import { t } from "../../i18n/translations"
import type { Locale } from "../../lib/locale"
import type { SettingsSectionDescriptor } from "../../lib/settings-registry"

interface Props {
  sections: SettingsSectionDescriptor[]
  locale: Locale
}
const { sections, locale } = Astro.props
---

<nav id="settings-directory" class="settings-directory" aria-label={t("settings.sections", locale)}>
  <ul>
    {sections.map((section) => (
      <li>
        <a href={`#${section.id}`} data-settings-nav={section.id} aria-current={section.id === "personal-settings" ? "location" : undefined}>
          <Icon name={section.outlineIcon} class="settings-directory__marker" size={18} sprite={true} />
          <span>{section.label}</span>
        </a>
      </li>
    ))}
  </ul>
</nav>

<style>
  .settings-directory {
    position: sticky;
    top: 78px;
    z-index: 20;
    min-width: 0;
    padding: 4px 0;
  }

  .settings-directory[hidden] {
    display: none;
  }

  ul {
    margin: 0;
    padding: 0;
    list-style: none;
    display: grid;
    gap: 4px;
  }

  li:last-child {
    margin-top: 8px;
    padding-top: 8px;
    border-top: 1px solid var(--border);
  }

  a {
    display: flex;
    align-items: center;
    gap: 10px;
    min-height: 44px;
    padding: 6px 10px;
    border-inline-start: 3px solid transparent;
    border-radius: 7px;
    color: var(--text-primary);
    font-size: 0.875rem;
    font-weight: 550;
    text-decoration: none;
  }

  a:focus-visible {
    outline: 2px solid var(--border-focus);
    outline-offset: 2px;
  }

  a:hover {
    background: var(--bg-hover);
  }

  a[aria-current="location"] {
    background: var(--bg-secondary);
    border-inline-start-color: var(--accent);
    font-weight: 700;
  }

  a[aria-current="location"] :global(.settings-directory__marker) {
    color: var(--accent-text);
  }

  :global(.settings-directory__marker) {
    flex: none;
    color: var(--text-secondary);
  }

  @media (max-width: 860px) {
    .settings-directory {
      display: none;
      top: 64px;
      max-height: calc(100dvh - 140px);
      overflow: auto;
      margin-block-end: 12px;
      padding: 8px;
      background: var(--bg-card);
      border: 1px solid var(--border);
      border-radius: 10px;
      box-shadow: var(--shadow-md);
    }

    .settings-directory:not([hidden]) {
      display: block;
    }
  }
</style>
