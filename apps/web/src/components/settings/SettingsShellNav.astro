---
import Icon from "../ui/Icon.astro"
import { t } from "../../i18n/translations"
import type { Locale } from "../../lib/locale"
import {
  getGroupedSettingsSections,
  type SettingsSectionDescriptor,
} from "../../lib/settings-registry"

interface Props {
  sections: SettingsSectionDescriptor[]
  locale: Locale
}
const { sections, locale } = Astro.props
const groupedSections = getGroupedSettingsSections(sections)
---

<nav id="settings-directory" class="settings-directory" aria-label={t("settings.sections", locale)}>
  {groupedSections.map((group) => (
    <div class="settings-directory__group" role="group" aria-labelledby={`settings-group-${group.id}`}>
      <div id={`settings-group-${group.id}`} class="settings-directory__group-label">
        {group.label}
      </div>
      <ul>
        {group.sections.map((section) => (
          <li>
            <a href={`#${section.id}`} data-settings-nav={section.id} aria-current={section.id === "look-and-feel-settings" ? "location" : undefined}>
              <Icon name={section.outlineIcon} class="settings-directory__marker" size={18} sprite={false} />
              <span>{section.label}</span>
            </a>
          </li>
        ))}
      </ul>
    </div>
  ))}
</nav>

<style is:inline>
  .settings-directory {
    position: sticky;
    top: 78px;
    z-index: 20;
    min-width: 0;
    padding: 4px 0;
    display: grid;
    gap: 14px;
  }

  .settings-directory[hidden] {
    display: none;
  }

  .settings-directory__group {
    display: grid;
    gap: 4px;
  }

  .settings-directory__group + .settings-directory__group {
    padding-top: 10px;
    border-top: 1px solid var(--border);
  }

  .settings-directory__group-label {
    padding: 0 10px 2px;
    font-size: 0.6875rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--text-secondary);
  }

  .settings-directory ul {
    margin: 0;
    padding: 0;
    list-style: none;
    display: grid;
    gap: 2px;
  }

  .settings-directory a {
    display: flex;
    align-items: center;
    gap: 10px;
    min-height: 40px;
    padding: 6px 10px;
    border-inline-start: 3px solid transparent;
    border-radius: 7px;
    color: var(--text-primary);
    font-size: 0.875rem;
    font-weight: 550;
    text-decoration: none;
  }

  .settings-directory a:focus-visible {
    outline: 2px solid var(--border-focus);
    outline-offset: 2px;
  }

  .settings-directory a:hover {
    background: var(--bg-hover);
  }

  .settings-directory a[aria-current="location"] {
    background: var(--bg-secondary);
    border-inline-start-color: var(--accent);
    font-weight: 700;
  }

  .settings-directory a[aria-current="location"] .settings-directory__marker {
    color: var(--accent-text);
  }

  .settings-directory__marker {
    flex: none;
    color: var(--text-secondary);
  }

  @media (max-width: 860px) {
    .settings-directory,
    .settings-directory[hidden] {
      position: sticky;
      top: 56px;
      z-index: 25;
      display: flex !important;
      align-items: center;
      gap: 6px;
      overflow-x: auto;
      overflow-y: hidden;
      -webkit-overflow-scrolling: touch;
      scrollbar-width: none;
      margin: 0 -12px 12px;
      padding: 8px 12px;
      background: var(--bg-primary);
      border-bottom: 1px solid var(--border);
      scroll-snap-type: x proximity;
    }

    .settings-directory::-webkit-scrollbar {
      display: none;
    }

    .settings-directory__group,
    .settings-directory ul {
      display: contents;
    }

    .settings-directory__group + .settings-directory__group {
      padding-top: 0;
      border-top: none;
    }

    .settings-directory__group-label {
      display: none;
    }

    .settings-directory li {
      flex: 0 0 auto;
      scroll-snap-align: start;
    }

    .settings-directory a {
      min-height: 36px;
      padding: 6px 12px;
      gap: 6px;
      border: 1px solid var(--border);
      border-inline-start-width: 1px;
      border-radius: 999px;
      background: var(--bg-card);
      font-size: 0.8125rem;
      font-weight: 550;
      white-space: nowrap;
      transition: background-color 140ms cubic-bezier(0.23, 1, 0.32, 1), border-color 140ms ease, transform 120ms cubic-bezier(0.23, 1, 0.32, 1);
    }

    .settings-directory a:active {
      transform: scale(0.97);
    }

    .settings-directory a[aria-current="location"] {
      background: color-mix(in srgb, var(--accent) 16%, var(--bg-card));
      border-color: color-mix(in srgb, var(--accent) 50%, var(--border));
      color: var(--accent-text, var(--accent));
      font-weight: 650;
    }

    .settings-directory__marker {
      width: 15px;
      height: 15px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .settings-directory a {
      transition: none;
    }
  }
</style>
