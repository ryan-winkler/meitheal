---
/** Shared label definitions and private-reference-safe cleanup. */
import { t } from "../../i18n/translations"
import type { Locale } from "../../lib/locale"
import SettingsPanelCard from "./SettingsPanelCard.astro"

interface Props { locale: Locale }
const { locale } = Astro.props
const cleanupKeys = ["review", "description", "selection", "remove", "confirm_title", "confirm_one", "confirm_many", "cancel", "loading", "removing", "empty", "previous", "next", "retry", "stale", "blocked", "denied", "unavailable", "offline", "removed_one", "removed_many", "untitled"]
const cleanupCopy = Object.fromEntries(cleanupKeys.map(key => [key, t(`labels.cleanup.${key}`, locale)]))
const editorKeys = ["name", "color", "save", "save_label", "delete", "delete_label", "delete_title", "delete_message", "cancel", "saving", "saved", "deleting", "deleted", "creating", "created", "exists", "empty", "loading", "load_error", "retry", "failed", "invalid", "denied", "blocked", "conflict", "missing", "unavailable", "cancelled", "tooLarge", "media", "search", "range", "page", "pages", "previous", "next", "empty_search", "unsaved", "background_saved", "background_failed"]
const editorCopy: Record<string, string> = { ...Object.fromEntries(editorKeys.map(key => [key, t(`labels.editor.${key}`, locale)])), untitled: t("labels.cleanup.untitled", locale) }
---

<div class="settings-shell-panel">
  <SettingsPanelCard title={t("labels.manage_labels", locale)} subtitle={t("labels.manage_subtitle", locale)}>
    <div data-label-editor data-locale={locale} data-copy={JSON.stringify(editorCopy)}>
      <form id="create-label-form" class="labels-create-form">
        <label class="label-name-field" for="new-label-title">
          <span>{editorCopy.name}</span>
          <input type="text" id="new-label-title" class="form-input" placeholder={t("labels.name_placeholder", locale)} maxlength="100" required />
        </label>
        <label class="label-color-field" for="new-label-color">
          <span>{editorCopy.color}</span>
          <input type="color" id="new-label-color" value="#6366f1" class="labels-color-picker" />
        </label>
        <button type="submit" class="btn btn-primary">{t("labels.create", locale)}</button>
      </form>
      <p role="status" aria-atomic="true" data-label-editor-status>{editorCopy.loading}</p>
      <button type="button" class="btn btn-outline" data-label-editor-retry hidden>{editorCopy.retry}</button>
      <label class="label-search-field" for="labels-search">
        <span>{editorCopy.search}</span>
        <input type="search" id="labels-search" class="form-input" data-label-search maxlength="100" aria-controls="labels-list" disabled />
      </label>
      <div class="label-results-toolbar">
        <p role="status" aria-atomic="true" data-label-range>{editorCopy.loading}</p>
        <nav aria-label={editorCopy.pages} data-label-pages hidden>
          <button type="button" class="btn btn-outline" data-label-previous disabled>{editorCopy.previous}</button>
          <span data-label-page></span>
          <button type="button" class="btn btn-outline" data-label-next disabled>{editorCopy.next}</button>
        </nav>
      </div>
      <p data-label-empty hidden></p>
      <ul id="labels-list" class="labels-list" aria-label={t("labels.title", locale)}></ul>
    </div>
    <section class="label-cleanup" data-label-cleanup data-copy={JSON.stringify(cleanupCopy)}>
      <button type="button" class="btn btn-outline" data-cleanup-review>{cleanupCopy.review}</button>
      <p>{cleanupCopy.description}</p>
      <p role="status" aria-atomic="true" data-cleanup-status></p>
      <div data-cleanup-results hidden>
        <h3 tabindex="-1" data-cleanup-heading>{cleanupCopy.review}</h3>
        <ul class="label-cleanup-list" data-cleanup-list></ul>
        <p data-cleanup-selection></p>
        <div class="label-cleanup-actions">
          <button type="button" class="btn btn-outline" data-cleanup-previous>{cleanupCopy.previous}</button>
          <button type="button" class="btn btn-outline" data-cleanup-next>{cleanupCopy.next}</button>
          <button type="button" class="btn btn-primary" data-cleanup-remove disabled>{cleanupCopy.remove}</button>
        </div>
      </div>
    </section>
  </SettingsPanelCard>
</div>

<style>
  .label-cleanup { border-block-start: 1px solid var(--border); margin-block-start: 1rem; padding-block-start: 1rem; min-inline-size: 0; }
  .label-cleanup p { overflow-wrap: anywhere; margin-block: .75rem; }
  .label-cleanup button { min-block-size: 44px; white-space: normal; }
  .label-cleanup-actions { display: flex; flex-wrap: wrap; gap: .5rem; }
  .label-cleanup-list { list-style: none; padding: 0; margin-block: .5rem; }
  .label-cleanup :global(.label-cleanup-choice) { display: flex; align-items: center; gap: .75rem; min-block-size: 44px; padding-block: .375rem; cursor: pointer; }
  .label-cleanup :global(.label-cleanup-choice input) { flex: 0 0 auto; inline-size: 1.25rem; block-size: 1.25rem; }
  .label-cleanup :global(.label-cleanup-swatch) { flex: 0 0 auto; inline-size: 1rem; block-size: 1rem; border-radius: 50%; border: 1px solid var(--border); }
  .label-cleanup :global(.label-cleanup-name) { min-inline-size: 0; overflow-wrap: anywhere; }
  .label-cleanup [hidden] { display: none; }
  .labels-create-form, :global(.label-row-fields), :global(.label-row-actions) { display: flex; flex-wrap: wrap; align-items: end; gap: .5rem; }
  .labels-create-form { padding-block-end: 1rem; border-block-end: 1px solid var(--border); }
  .label-name-field, :global(.label-name-field) { display: grid; gap: .25rem; flex: 1 1 12rem; min-inline-size: 0; }
  .label-color-field, :global(.label-color-field) { display: grid; gap: .25rem; min-inline-size: 0; }
  .label-name-field input, :global(.label-name-field input) { inline-size: 100%; min-inline-size: 0; }
  .labels-color-picker, :global(.labels-color-picker) { inline-size: 44px; block-size: 44px; padding: .25rem; border: 1px solid var(--border); border-radius: var(--radius-sm, 6px); background: var(--bg-card); }
  [data-label-editor] button { min-block-size: 44px; max-inline-size: 100%; white-space: normal; }
  :global(.label-row-actions button) { min-block-size: 44px; max-inline-size: 100%; white-space: normal; }
  .label-search-field { display: grid; gap: .25rem; margin-block: 1rem .5rem; min-inline-size: 0; }
  .label-search-field input { inline-size: 100%; min-inline-size: 0; }
  .label-results-toolbar, [data-label-pages] { display: flex; flex-wrap: wrap; align-items: center; gap: .5rem; min-inline-size: 0; }
  .label-results-toolbar { justify-content: space-between; }
  [data-label-range], [data-label-page] { font-variant-numeric: tabular-nums; }
  [data-label-range], [data-label-empty] { overflow-wrap: anywhere; margin-block: .5rem; }
  .labels-list { list-style: none; margin: 0; padding: 0; min-inline-size: 0; }
  :global(.label-settings-row) { padding-block: 1rem; border-block-end: 1px solid var(--border); min-inline-size: 0; }
  :global(.label-settings-form) { display: grid; gap: .75rem; min-inline-size: 0; }
  :global(.label-settings-badge) { display: flex; gap: .5rem; align-items: start; min-inline-size: 0; color: var(--text-primary); }
  :global(.label-settings-badge [data-badge-id]) { min-inline-size: 0; overflow-wrap: anywhere; white-space: normal; }
  :global(.label-settings-swatch) { inline-size: 1rem; block-size: 1rem; margin-block-start: .2em; flex: 0 0 auto; border: 1px solid var(--border); border-radius: 50%; }
  :global(.label-row-status), [data-label-editor-status] { overflow-wrap: anywhere; margin-block: .5rem; }
  [data-label-editor] [hidden] { display: none; }
</style>
