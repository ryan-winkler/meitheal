<style>
  /* ═══════ Integrations Layout ═══════ */
  .integrations-layout {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .integrations-header {
    margin-bottom: 8px;
  }

  .integrations-title {
    font-size: 18px;
    font-weight: 600;
    color: var(--text-primary);
    margin: 0;
  }

  .integrations-subtitle {
    font-size: 13px;
    color: var(--text-muted);
    margin: 4px 0 0;
  }

  /* ═══════ Integration Card ═══════ */
  .integration-card {
    border: 1px solid var(--border);
    border-radius: 10px;
    overflow: hidden;
    background: var(--bg-primary);
    transition: border-color 200ms ease;
  }

  .integration-card:hover {
    border-color: color-mix(in srgb, var(--border) 70%, var(--accent));
  }

  .integration-card__header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    width: 100%;
    padding: 14px 18px;
    background: var(--bg-secondary);
    border: none;
    cursor: pointer;
    text-align: left;
    color: inherit;
    font: inherit;
    transition: background 150ms ease;
  }

  .integration-card__header:hover {
    background: var(--bg-hover);
  }

  .integration-card__header:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: -2px;
  }

  .integration-card__title-row {
    display: flex;
    align-items: center;
    gap: 12px;
  }

  .integration-card__icon {
    font-size: 20px;
    width: 32px;
    height: 32px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: var(--bg-primary);
    border-radius: 8px;
    border: 1px solid var(--border);
    flex-shrink: 0;
  }

  .integration-card__title-info {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .integration-card__title-info strong {
    font-size: 14px;
    font-weight: 600;
    color: var(--text-primary);
  }

  .integration-card__desc {
    font-size: 12px;
    color: var(--text-muted);
  }

  .integration-card__header-right {
    display: flex;
    align-items: center;
    gap: 10px;
    flex-shrink: 0;
  }

  .integration-card__chevron {
    font-size: 12px;
    color: var(--text-muted);
    transition: transform 200ms ease;
    width: 16px;
    text-align: center;
  }

  .integration-card__header[aria-expanded="true"] .integration-card__chevron {
    transform: rotate(90deg);
  }

  /* ═══════ Card Body ═══════ */
  .integration-card__body {
    max-height: 0;
    overflow: hidden;
    transition:
      max-height 250ms ease,
      padding 250ms ease;
    padding: 0 18px;
  }

  .integration-card__body[aria-hidden="false"] {
    max-height: 1200px;
    padding: 16px 18px;
    border-top: 1px solid var(--border);
    overflow-y: auto;
  }

  .integration-card__config {
    display: flex;
    flex-direction: column;
    gap: 14px;
  }

  .integration-card__actions {
    display: flex;
    gap: 8px;
    align-items: center;
    padding-top: 4px;
  }

  .integration-card__result {
    font-size: 12px;
    color: var(--text-muted);
  }

  /* ═══════ Form Label Row (with tooltip) ═══════ */
  .form-label-row {
    display: flex;
    align-items: center;
    margin-bottom: 6px;
  }

  .form-label-row .form-label {
    margin-bottom: 0;
  }

  /* ═══════ Callouts ═══════ */
  .integration-callout {
    border-radius: 8px;
    padding: 12px 16px;
    margin-bottom: 12px;
    font-size: 13px;
  }

  .integration-callout--success {
    background: rgba(99, 102, 241, 0.08);
    border: 1px solid rgba(99, 102, 241, 0.2);
    color: var(--text-secondary);
  }

  .integration-callout strong {
    color: var(--accent);
  }

  .integration-callout__detail {
    margin-top: 4px;
    font-size: 12px;
    color: var(--text-muted);
  }

  .mono-text {
    font-family: "JetBrains Mono", monospace;
    font-size: 11px;
    color: var(--text-muted);
    margin-left: 6px;
  }

  /* ═══════ Entity List ═══════ */
  .entity-list-container {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  /* ═══════ Calendar Toggle Cards ═══════ */
  .cal-toggle-list {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .cal-toggle-card {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 10px 14px;
    background: var(--bg-secondary);
    border: 1px solid var(--border);
    border-radius: 8px;
    cursor: pointer;
    transition:
      border-color 200ms ease,
      background 200ms ease,
      box-shadow 200ms ease;
  }

  .cal-toggle-card:hover {
    border-color: color-mix(in srgb, var(--border) 50%, var(--accent));
    background: color-mix(in srgb, var(--bg-secondary) 95%, var(--accent));
  }

  .cal-toggle-card--active {
    border-color: color-mix(in srgb, var(--accent) 40%, transparent);
    background: color-mix(in srgb, var(--accent) 8%, var(--bg-secondary));
    box-shadow: 0 0 0 1px color-mix(in srgb, var(--accent) 15%, transparent);
  }

  .cal-toggle-card__info {
    display: flex;
    flex-direction: column;
    gap: 2px;
    min-width: 0;
  }

  .cal-toggle-card__name {
    font-size: 13px;
    font-weight: 600;
    color: var(--text-primary);
  }

  .cal-toggle-card__entity {
    font-size: 11px;
    font-family: "JetBrains Mono", monospace;
    color: var(--text-muted);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  /* Per-card sync direction selector */
  .cal-toggle-card__direction {
    margin-top: 4px;
  }

  .cal-direction-select {
    font-size: 11px;
    padding: 2px 6px;
    border: 1px solid var(--border);
    border-radius: 5px;
    background: var(--bg-primary);
    color: var(--text-secondary);
    font-family: inherit;
    cursor: pointer;
    transition: border-color 150ms ease;
    max-width: 200px;
  }

  .cal-direction-select:hover {
    border-color: color-mix(in srgb, var(--border) 50%, var(--accent));
  }

  .cal-direction-select:focus {
    border-color: var(--accent);
    outline: none;
    box-shadow: 0 0 0 2px color-mix(in srgb, var(--accent) 20%, transparent);
  }

  .cal-toggle-card__state {
    font-size: 10px;
    color: var(--text-muted);
    opacity: 0.8;
  }

  /* Calendar entities header — title + bulk actions */
  .cal-entities-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 4px;
  }
  .cal-count-badge {
    font-size: 10px;
    color: var(--text-muted);
    background: var(--bg-secondary);
    border: 1px solid var(--border);
    padding: 1px 8px;
    border-radius: 10px;
    margin-left: 6px;
    vertical-align: middle;
  }
  .cal-bulk-actions {
    display: flex;
    gap: 4px;
  }
  .btn-xs {
    font-size: 11px !important;
    padding: 2px 8px !important;
    min-height: unset !important;
    border-radius: 6px;
  }
  .cal-empty-state {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 14px;
    background: var(--bg-secondary);
    border: 1px dashed var(--border);
    border-radius: 8px;
    font-size: 12px;
    color: var(--text-muted);
  }
  .cal-empty-icon {
    font-size: 20px;
  }

  /* ═══════ Event Checkboxes ═══════ */
  .event-checkbox-grid {
    display: flex;
    gap: 12px;
    flex-wrap: wrap;
  }

  .event-checkbox {
    font-size: 13px;
    display: flex;
    gap: 6px;
    align-items: center;
    cursor: pointer;
    color: var(--text-secondary);
  }

  .event-checkbox input[type="checkbox"] {
    accent-color: var(--accent);
  }

  /* ═══════ Badges (standardized) ═══════ */
  .badge {
    display: inline-block;
    padding: 3px 10px;
    border-radius: 12px;
    font-size: 12px;
    font-weight: 500;
    white-space: nowrap;
  }

  .badge-active {
    background: rgba(99, 102, 241, 0.15);
    color: var(--accent);
  }

  .badge-pending {
    background: rgba(107, 114, 128, 0.15);
    color: var(--text-muted);
  }

  .badge-error {
    background: rgba(239, 68, 68, 0.15);
    color: var(--danger);
  }

  .badge-disabled {
    background: transparent;
    color: var(--text-muted);
    border: 1px dashed rgba(107, 114, 128, 0.4);
    font-style: italic;
    opacity: 0.7;
  }

  /* ═══════ Responsive ═══════ */
  @media (max-width: 768px) {
    .integration-card__header {
      padding: 12px 14px;
    }
    .integration-card__body[aria-hidden="false"] {
