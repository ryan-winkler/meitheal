              <label class="event-checkbox">
                <input
                  type="checkbox"
                  class="n8n-event"
                  value="task.updated"
                  checked
                /> Updated
              </label>
              <label class="event-checkbox">
                <input
                  type="checkbox"
                  class="n8n-event"
                  value="task.completed"
                  checked
                /> Completed
              </label>
              <label class="event-checkbox">
                <input type="checkbox" class="n8n-event" value="task.deleted" /> Deleted
              </label>
              <label class="event-checkbox">
                <input
                  type="checkbox"
                  class="n8n-event"
