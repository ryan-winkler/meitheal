---
import { t } from "../../i18n/translations";
import type { Locale } from "../../lib/locale";
import HelpTooltip from "../ui/HelpTooltip.astro";
import EntitySelector from "../ui/EntitySelector.astro";

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
---

<div class="settings-shell-panel">
  <div class="integrations-layout">
    <div class="integrations-header">
      <div>
        <h2 class="integrations-title">
          {t("settings.integrations_title", locale)}
        </h2>
        <p class="integrations-subtitle">
          {t("settings.integrations_subtitle", locale)}
        </p>
      </div>
    </div>

    <!-- ═══════ Home Assistant ═══════ -->
    <div class="integration-card" id="integration-ha">
      <button
        type="button"
        class="integration-card__header"
        aria-expanded="false"
        aria-controls="integration-ha-body"
      >
        <div class="integration-card__title-row">
          <span class="integration-card__icon">🏠</span>
          <div class="integration-card__title-info">
            <strong>Home Assistant</strong>
            <span class="integration-card__desc"
              >Connection and integration settings</span
            >
          </div>
        </div>
        <div class="integration-card__header-right">
          <button
            type="button"
            class="info-btn"
            data-explainer="ha"
            aria-label="What is Home Assistant integration?"
            onclick="event.stopPropagation()">ℹ️</button
          >
          <span class="badge badge-pending" id="ha-connection-badge"
            >Checking…</span
          >
          <span class="integration-card__chevron">▸</span>
        </div>
      </button>

      <div
        class="integration-card__body"
        id="integration-ha-body"
        aria-hidden="true"
      >
        <!-- Connection Status Display -->
        <div id="ha-connection-status" class="ha-status-row">
          <div class="ha-status-row__left">
            <div
              class="ha-status-indicator ha-status-indicator--checking"
              id="ha-indicator"
            >
              <span class="ha-status-indicator__dot"></span>
            </div>
            <div class="ha-status-row__info">
              <span class="ha-status-row__mode" id="ha-mode-label"
                >Detecting connection…</span
              >
              <span class="ha-status-row__detail" id="ha-detail-label"></span>
            </div>
          </div>
        </div>

        <!-- HA Info Panel — shown when connected -->
        <div id="ha-info-panel" class="ha-info-panel" style="display: none;">
          <div class="ha-info-grid">
            <div class="ha-info-item">
              <span class="ha-info-item__label">Version</span>
              <span class="ha-info-item__value" id="ha-info-version">—</span>
            </div>
            <div class="ha-info-item">
              <span class="ha-info-item__label">Location</span>
              <span class="ha-info-item__value" id="ha-info-location">—</span>
            </div>
            <div class="ha-info-item">
              <span class="ha-info-item__label">Timezone</span>
              <span class="ha-info-item__value" id="ha-info-timezone">—</span>
            </div>
            <div class="ha-info-item">
              <span class="ha-info-item__label">Mode</span>
              <span class="ha-info-item__value" id="ha-info-mode">—</span>
            </div>
          </div>
        </div>

        <!-- Test Connection -->
        <div class="integration-card__config" style="margin-top: 8px;">
          <div class="integration-card__actions">
            <button type="button" class="btn btn-ghost" id="test-connection">
              Test Connection
            </button>
          </div>
          <div id="ha-status" class="ha-test-result"></div>
        </div>

        <!-- Advanced / Standalone Mode -->
        <details class="ha-advanced-section" id="ha-advanced-section">
          <summary class="ha-advanced-toggle">
            <span>⚙ Advanced — Standalone Mode</span>
            <small>Only needed if running outside Home Assistant</small>
          </summary>
          <form id="ha-form" class="ha-advanced-form">
            <div class="form-group">
              <label class="form-label" for="ha-url">HA URL</label>
              <input
                type="url"
                class="form-input"
                id="ha-url"
                placeholder="http://homeassistant.local:8123"
                pattern="https?://.*"
              />
            </div>
            <div class="form-group">
              <label class="form-label" for="ha-token">
                Long-Lived Access Token
              </label>
              <input
                type="password"
                class="form-input"
                id="ha-token"
                placeholder="••••••••"
              />
              <small style="color: var(--text-muted); font-size: 12px;">
                Generate in HA → Profile → Long-Lived Access Tokens
              </small>
            </div>
            <div style="display: flex; gap: 8px;">
              <button type="submit" class="btn btn-primary" id="save-ha">
                💾 Save
              </button>
            </div>
          </form>
        </details>
      </div>
    </div>

    <!-- ═══════ Calendar Sync ═══════ -->
    <div class="integration-card" id="integration-calendar">
      <button
        type="button"
        class="integration-card__header"
        aria-expanded="false"
        aria-controls="integration-calendar-body"
      >
        <div class="integration-card__title-row">
          <span class="integration-card__icon">📅</span>
          <div class="integration-card__title-info">
            <strong>Calendar Sync</strong>
            <span class="integration-card__desc"
              >Bidirectional sync with HA calendars</span
            >
          </div>
        </div>
        <div class="integration-card__header-right">
          <button
            type="button"
            class="info-btn"
            data-explainer="calendar"
            aria-label="What is Calendar Sync?"
            onclick="event.stopPropagation()">ℹ️</button
          >
          <span class="badge badge-pending" id="cal-status">Checking…</span>
          <span class="integration-card__chevron">▸</span>
        </div>
      </button>

      <div
        class="integration-card__body"
        id="integration-calendar-body"
        aria-hidden="true"
      >
        <!-- HA auto-sync info callout -->
        <div
          id="cal-auto-info"
          class="integration-callout integration-callout--success"
          style="display: none;"
        >
          <strong>✓ Automatic sync active</strong>
          <span id="cal-auto-entity" class="mono-text"></span>
          <div class="integration-callout__detail">
            Running as an HA addon — Meitheal automatically detects your
            calendar entities and syncs events bidirectionally (past 7 days →
            next 30 days).
          </div>
        </div>

        <!-- Detected HA calendar entities — interactive toggle cards -->
        <div id="cal-entities-list" style="display: none; margin-bottom: 12px;">
          <div class="cal-entities-header">
            <div>
              <label
                class="form-label"
                style="font-size: 12px; margin-bottom: 0;">Your Calendars</label
              >
              <span id="cal-count-badge" class="cal-count-badge"
                >0 of 0 enabled</span
              >
            </div>
            <div class="cal-bulk-actions">
              <button
                type="button"
                class="btn btn-ghost btn-xs"
                id="cal-enable-all"
                title="Enable all calendars">Enable All</button
              >
              <button
                type="button"
                class="btn btn-ghost btn-xs"
                id="cal-disable-all"
                title="Disable all calendars">Disable All</button
              >
            </div>
          </div>
          <p
            style="font-size: 11px; color: var(--text-muted); margin: 4px 0 8px;"
          >
            Toggle each calendar on or off. Only enabled calendars sync events
            with Meitheal.
          </p>
          <div id="cal-entities-container" class="cal-toggle-list"></div>
          <div
            id="cal-no-entities"
            class="cal-empty-state"
            style="display: none;"
          >
            <span class="cal-empty-icon">📭</span>
            <span
              >No calendars detected. Make sure your Home Assistant integration
              is connected and has calendar entities.</span
            >
          </div>
        </div>

        <div class="integration-card__config">
          <!-- Manual entity input for advanced users -->
          <details class="caldav-section" style="margin-bottom: 10px;">
            <summary class="caldav-toggle">
              <span>⌨ Manual Entity ID</span>
              <small>For calendars not auto-detected</small>
            </summary>
            <div class="form-group" style="margin-top: 10px;">
              <div class="form-label-row">
                <label class="form-label" for="cal-entity"
                  >Calendar Entity ID</label
                >
                <HelpTooltip
                  text="Manually enter a calendar entity ID if it's not showing in the auto-detected list above. This is rarely needed."
                  id="help-cal-entity"
                />
              </div>
              <input
                type="text"
                class="form-input"
                id="cal-entity-manual"
                placeholder="calendar.my_calendar"
              />
              <button
                type="button"
                class="btn btn-ghost"
                id="cal-add-manual"
                style="margin-top: 6px; font-size: 12px;"
              >
                + Add Calendar
              </button>
            </div>
          </details>

          <!-- External CalDAV — collapsible -->
          <details class="caldav-section" id="caldav-details">
            <summary class="caldav-toggle">
              <span>📡 External Calendar (CalDAV)</span>
              <small
                >For Nextcloud, Radicale, Baikal — not needed for HA calendars</small
              >
            </summary>

            <div class="form-group" style="margin-top: 10px;">
              <div class="form-label-row">
                <label class="form-label" for="caldav-url"
                  >CalDAV Provider URL</label
                >
                <HelpTooltip
                  text="URL for your CalDAV server. Meitheal will discover calendars automatically."
                  id="help-caldav-url"
                />
              </div>
              <input
                type="url"
                class="form-input"
                id="caldav-url"
                placeholder="https://your-server.com/dav/calendars/"
              />
              <small class="form-hint" style="margin-top: 4px;">
                <strong>Nextcloud:</strong>
                <code>https://your-nc.com/remote.php/dav/</code><br />
                <strong>Radicale:</strong>
                <code>http://your-radicale:5232/user/</code>
              </small>
            </div>

            <div class="form-group" style="margin-top: 10px;">
              <label class="form-label" for="caldav-username">Username</label>
              <input
                type="text"
                class="form-input"
                id="caldav-username"
                autocomplete="username"
                placeholder="Required for private calendars"
              />
            </div>

            <div class="form-group" style="margin-top: 10px;">
              <label class="form-label" for="caldav-password"
                >Password or App Password</label
              >
              <input
                type="password"
                class="form-input"
                id="caldav-password"
                autocomplete="current-password"
                placeholder="Saved securely (AES-256-GCM encrypted)"
              />
            </div>

            <div
              style="margin-top: 12px; display: flex; gap: 8px; align-items: center;"
            >
              <button
                type="button"
                class="btn btn-secondary"
                id="caldav-test-btn"
                style="min-width: 120px;"
              >
                Test Connection
              </button>
              <span id="caldav-test-result" style="font-size: 13px;"></span>
            </div>

            <div
              id="caldav-active-indicator"
              class="integration-callout integration-callout--success"
              style="display: none; margin-top: 12px;"
            >
              <strong>✓ CalDAV Configured</strong>
              <div class="integration-callout__detail">
                Ready to sync alongside Home Assistant calendars.
              </div>
            </div>
          </details>

          <!-- Sync Direction (global default) -->
          <div class="form-group" style="margin-top: 10px;">
            <label class="form-label" for="cal-sync-direction"
              >Default Sync Direction</label
            >
            <select id="cal-sync-direction" class="form-select">
              <option value="bidirectional" selected
                >↔ Bidirectional — sync both ways</option
              >
              <option value="import">↓ Import only — HA → Meitheal</option>
              <option value="export">↑ Export only — Meitheal → HA</option>
            </select>
            <small class="form-hint"
              >Default for new calendars. Override per calendar using the
              direction selector on each card.</small
            >
          </div>

          <!-- Write-back toggle -->
          <div class="form-group" style="margin-top: 10px;">
            <label
              class="form-label"
              style="display: flex; align-items: center; gap: 8px; cursor: pointer;"
            >
              <input type="checkbox" id="cal-write-back" />
              <span>Write back — sync completed tasks to calendar</span>
            </label>
            <small class="form-hint"
              >When enabled, task completions update the corresponding calendar
              event. Only applies to Export and Bidirectional modes.</small
            >
          </div>

          <!-- Sync interval selector -->
          <div class="form-group" style="margin-top: 10px;">
            <label class="form-label" for="cal-sync-interval"
              >Sync Interval</label
            >
            <select id="cal-sync-interval" class="form-select">
              <option value="60000">Every 1 minute</option>
              <option value="300000" selected>Every 5 minutes (default)</option>
              <option value="900000">Every 15 minutes</option>
              <option value="1800000">Every 30 minutes</option>
              <option value="3600000">Every 1 hour</option>
              <option value="0">Manual only</option>
            </select>
            <small class="form-hint"
              >How often Meitheal auto-syncs events from enabled calendars.
              "Manual only" syncs only when you click Sync Now.</small
            >
          </div>

          <div class="integration-card__actions">
            <button type="button" class="btn btn-primary" id="save-cal"
              >Save Calendar Settings</button
            >
            <button type="button" class="btn btn-ghost" id="test-cal"
              >Sync Now</button
            >
            <span id="cal-sync-result" class="integration-card__result"></span>
            <span
              id="cal-last-synced"
              class="integration-card__last-synced"
              style="font-size: 11px; color: var(--text-muted); margin-left: auto;"
            ></span>
          </div>
        </div>
      </div>
    </div>

    <!-- ═══════ Todo Sync ═══════ -->
    <div class="integration-card" id="integration-todo">
      <button
        type="button"
        class="integration-card__header"
        aria-expanded="false"
        aria-controls="integration-todo-body"
      >
        <div class="integration-card__title-row">
          <span class="integration-card__icon">✅</span>
          <div class="integration-card__title-info">
            <strong>Todo Sync</strong>
            <span class="integration-card__desc"
              >Bridge HA todo lists with Meitheal</span
            >
          </div>
        </div>
        <div class="integration-card__header-right">
          <button
            type="button"
            class="info-btn"
            data-explainer="todo"
            aria-label="What is Todo Sync?"
            onclick="event.stopPropagation()">ℹ️</button
          >
          <span class="badge badge-pending" id="todo-status">Disabled</span>
          <span class="integration-card__chevron">▸</span>
        </div>
      </button>

      <div
        class="integration-card__body"
        id="integration-todo-body"
        aria-hidden="true"
      >
        <!-- Bridge purpose explainer -->
        <div
          class="integration-callout integration-callout--info"
          style="margin-bottom: 12px;"
        >
          <strong>🔗 HA Bridge</strong>
          <div class="integration-callout__detail">
            Bridges Home Assistant's built-in todo lists with Meitheal. Enable
            this so your HA dashboards and automations that use <code
              >todo.*</code
            > entities stay in sync with tasks managed here.
          </div>
        </div>
        <!-- HA auto-detect callout -->
        <div
          id="todo-auto-info"
          class="integration-callout integration-callout--success"
          style="display: none;"
        >
          <strong>✓ Todo list(s) detected</strong>
          <div id="todo-auto-entities" class="integration-callout__detail">
          </div>
        </div>

        <!-- Detected HA todo entities — interactive toggle cards -->
        <div
          id="todo-entities-list"
          style="display: none; margin-bottom: 12px;"
        >
          <div class="cal-entities-header">
            <div>
              <label
                class="form-label"
                style="font-size: 12px; margin-bottom: 0;"
                >Your Todo Lists</label
              >
              <span id="todo-count-badge" class="cal-count-badge"
                >0 of 0 enabled</span
              >
            </div>
            <div class="cal-bulk-actions">
              <button
                type="button"
                class="btn btn-ghost btn-xs"
                id="todo-enable-all"
                title="Enable all todo lists">Enable All</button
              >
              <button
                type="button"
                class="btn btn-ghost btn-xs"
                id="todo-disable-all"
                title="Disable all todo lists">Disable All</button
              >
            </div>
          </div>
          <p
            style="font-size: 11px; color: var(--text-muted); margin: 4px 0 8px;"
          >
            Toggle each todo list on or off. Only enabled lists sync tasks with
            Meitheal.
          </p>
          <div id="todo-entities-container" class="cal-toggle-list"></div>
          <div
            id="todo-no-entities"
            class="cal-empty-state"
            style="display: none;"
          >
            <span class="cal-empty-icon">📭</span>
            <span
              >No todo lists detected. Make sure Home Assistant has todo
              entities (e.g. Shopping List).</span
            >
          </div>
        </div>

        <!-- Manual entity input for advanced users -->
        <details class="caldav-section" style="margin-bottom: 10px;">
          <summary class="caldav-toggle">
            <span>⌨ Manual Entity ID</span>
            <small>For todo lists not auto-detected</small>
          </summary>
          <div class="form-group" style="margin-top: 10px;">
            <div class="form-label-row">
              <label class="form-label" for="todo-entity-manual"
                >Todo Entity ID</label
              >
              <HelpTooltip
                text="Manually enter a todo entity ID if it's not showing in the auto-detected list above."
                id="help-todo-entity-manual"
              />
            </div>
            <input
              type="text"
              class="form-input"
              id="todo-entity-manual"
              placeholder="todo.shopping_list"
            />
            <button
              type="button"
              class="btn btn-ghost"
              id="todo-add-manual"
              style="margin-top: 6px; font-size: 12px;"
            >
              + Add Todo List
            </button>
          </div>
        </details>

        <div class="integration-card__config">
          <div class="form-group">
            <div class="form-label-row">
              <label class="form-label" for="todo-enabled"
                >Enable Todo Sync</label
              >
              <HelpTooltip
                text="When enabled, Meitheal syncs tasks with your HA todo lists in real-time via WebSocket. Disabled by default to save power — enable only for lists you actively use."
                id="help-todo-enabled"
              />
            </div>
            <div style="display: flex; align-items: center; gap: 10px;">
              <label class="toggle-label">
                <input
                  type="checkbox"
                  id="todo-enabled"
                  aria-label="Enable or disable todo list sync"
                />
                <span class="toggle-slider"></span>
              </label>
              <span
                id="todo-enabled-label"
                style="font-size: 13px; color: var(--text-secondary);"
                >Off — sync disabled to save power</span
              >
            </div>
          </div>

          <div class="form-group">
            <div class="form-label-row">
              <label class="form-label" for="todo-sync-direction"
                >Sync Direction</label
              >
              <HelpTooltip
                text="Bidirectional keeps both Meitheal and HA in sync — changes in either place propagate. Inbound-only imports from HA without pushing back, which saves power and avoids write conflicts."
                id="help-todo-direction"
              />
            </div>
            <select class="form-select" id="todo-sync-direction">
              <option value="inbound">Import HA → Meitheal</option>
              <option value="outbound">Export Meitheal → HA</option>
              <option value="bidirectional" selected>Bidirectional sync</option>
            </select>
          </div>

          <div class="integration-card__actions">
            <button type="button" class="btn btn-primary" id="save-todo"
              >Save Todo Settings</button
            >
            <button type="button" class="btn btn-ghost" id="sync-todo"
              >Sync Now</button
            >
            <span id="todo-sync-result" class="integration-card__result"></span>
            <span
              id="todo-last-synced"
              class="integration-card__last-synced"
              style="font-size: 11px; color: var(--text-muted); margin-left: auto;"
            ></span>
          </div>
        </div>
      </div>
    </div>

    <!-- ═══════ Grocy ═══════ -->
    <div class="integration-card" id="integration-grocy">
      <button
        type="button"
        class="integration-card__header"
        aria-expanded="false"
        aria-controls="integration-grocy-body"
      >
        <div class="integration-card__title-row">
          <span class="integration-card__icon">🛒</span>
          <div class="integration-card__title-info">
            <strong>Grocy</strong>
            <span class="integration-card__desc"
              >Chores, tasks &amp; shopping list sync</span
            >
          </div>
        </div>
        <div class="integration-card__header-right">
          <button
            type="button"
            class="info-btn"
            data-explainer="grocy"
            aria-label="What is Grocy integration?"
            onclick="event.stopPropagation()">ℹ️</button
          >
          <span class="badge badge-disabled" id="grocy-status"
            >Not configured</span
          >
          <span class="integration-card__chevron">▸</span>
        </div>
      </button>

      <div
        class="integration-card__body"
        id="integration-grocy-body"
        aria-hidden="true"
      >
        <!-- Grocy auto-detect callout -->
        <div
          id="grocy-auto-info"
          class="integration-callout integration-callout--success"
          style="display: none;"
          aria-live="polite"
        >
          <strong>✓ Grocy detected via HA</strong>
          <div class="integration-callout__detail">
            Grocy addon found — URL auto-populated from HA ingress. No
            additional setup needed.
          </div>
        </div>

        <!-- Grocy test result callout -->
        <div
          id="grocy-test-result"
          class="integration-callout"
          style="display: none;"
          aria-live="polite"
        >
        </div>

        <div class="integration-card__config">
          <div class="form-group" id="grocy-url-group">
            <div class="form-label-row">
              <label class="form-label" for="grocy-url">Grocy URL</label>
              <HelpTooltip
                text="The URL of your Grocy instance. If running Grocy as a Home Assistant add-on, it's typically available at http://homeassistant.local:9192 or via the HA ingress proxy."
                id="help-grocy-url"
              />
            </div>
            <input
              type="url"
              class="form-input"
              id="grocy-url"
              placeholder="http://homeassistant.local:9192"
            />
          </div>
          <div class="form-group" id="grocy-key-group">
            <div class="form-label-row">
              <label class="form-label" for="grocy-key">API Key</label>
              <HelpTooltip
                text="Generate a Grocy API key in Grocy → Settings → API Keys → Add. This key allows Meitheal to read and write chores and tasks."
                id="help-grocy-key"
              />
            </div>
            <div style="display: flex; gap: 8px; align-items: center;">
              <input
                type="password"
                class="form-input"
                id="grocy-key"
                placeholder="••••••••"
                style="flex: 1;"
              />
              <button
                type="button"
                class="btn btn-ghost"
                id="grocy-auto-key"
                style="font-size: 11px; white-space: nowrap; padding: 6px 10px;"
                title="Attempt to auto-generate a Grocy API key">⚡ Auto</button
              >
            </div>
          </div>
          <!-- Custom config toggle for auto-detected installs -->
          <button
            type="button"
            class="btn btn-ghost"
            id="grocy-custom-toggle"
            style="display: none; font-size: 12px; padding: 4px 8px; align-self: flex-start;"
          >
            ⚙ Custom configuration
          </button>
          <div class="form-group">
            <div class="form-label-row">
              <label class="form-label" for="grocy-sync-mode">Sync Mode</label>
              <HelpTooltip
                text="Controls how data flows between Grocy and Meitheal. Import pulls chores/tasks into Meitheal, Export pushes completions to Grocy, Bidirectional keeps both in sync."
                id="help-grocy-sync"
              />
            </div>
