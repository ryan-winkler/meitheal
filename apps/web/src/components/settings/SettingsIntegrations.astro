                text="HMAC-SHA256 secret for signing webhook payloads. Verify the X-Meitheal-Signature header on your receiving end."
                id="help-n8n-secret"
              />
            </div>
            <input
              type="password"
              class="form-input"
              id="n8n-secret"
              placeholder="••••••••"
            />
          </div>
          <div class="form-group">
            <label class="form-label">Trigger Events</label>
            <div class="event-checkbox-grid">
              <label class="event-checkbox">
                <input
                  type="checkbox"
                  class="n8n-event-standalone"
                  value="task.created"
                  checked
                /> Created
              </label>
              <label class="event-checkbox">
                <input
                  type="checkbox"
                  class="n8n-event-standalone"
                  value="task.updated"
                  checked
                /> Updated
              </label>
              <label class="event-checkbox">
                <input
                  type="checkbox"
                  class="n8n-event-standalone"
                  value="task.completed"
                  checked
                /> Completed
              </label>
              <label class="event-checkbox">
                <input
                  type="checkbox"
                  class="n8n-event-standalone"
                  value="task.deleted"
                /> Deleted
              </label>
