---
import type { SettingsSectionDescriptor } from "../../lib/settings-registry"

interface Props {
  section: SettingsSectionDescriptor
}

const { section } = Astro.props
---

<div class="settings-section-intro">
  <div class="settings-section-intro__identity">
    <span class="settings-section-intro__icon" aria-hidden="true">{section.icon}</span>
    <div class="settings-section-intro__copy">
      <span class="settings-section-intro__eyebrow">{section.label} settings</span>
      <h2>{section.introTitle}</h2>
      <p>{section.introDescription}</p>
    </div>
  </div>

  <div class="settings-section-intro__highlights" aria-label={`${section.label} quick tasks`}>
    {section.featuredTasks.map((task) => (
      <span class="settings-section-intro__chip">{task}</span>
    ))}
  </div>
</div>

<style>
  .settings-section-intro {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: 18px;
    align-items: start;
    padding: 20px;
    border: 1px solid color-mix(in srgb, var(--border) 82%, var(--accent));
    border-radius: 22px;
    background:
      linear-gradient(
        135deg,
        color-mix(in srgb, var(--bg-card) 96%, white),
        color-mix(in srgb, var(--bg-card) 88%, var(--accent) 8%)
      );
  }

  .settings-section-intro__identity {
    display: flex;
    gap: 14px;
    min-width: 0;
  }

  .settings-section-intro__icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 46px;
    height: 46px;
    border-radius: 16px;
    background: color-mix(in srgb, var(--accent) 15%, transparent);
    font-size: 22px;
    flex-shrink: 0;
  }

  .settings-section-intro__copy {
    display: flex;
    flex-direction: column;
    gap: 6px;
    min-width: 0;
  }

  .settings-section-intro__eyebrow {
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--accent);
  }

  .settings-section-intro__copy h2 {
    margin: 0;
    font-size: clamp(1.4rem, 2vw, 1.7rem);
    line-height: 1.1;
  }

  .settings-section-intro__copy p {
    margin: 0;
    max-width: 64ch;
    color: var(--text-secondary);
    font-size: 14px;
    line-height: 1.6;
  }

  .settings-section-intro__highlights {
    display: flex;
    flex-wrap: wrap;
    justify-content: flex-end;
    gap: 8px;
    align-content: flex-start;
  }

  .settings-section-intro__chip {
    display: inline-flex;
    align-items: center;
    min-height: 32px;
    padding: 0 12px;
    border: 1px solid color-mix(in srgb, var(--border) 75%, var(--accent) 24%);
    border-radius: 999px;
    background: color-mix(in srgb, var(--bg-secondary) 86%, transparent);
    color: var(--text-secondary);
    font-size: 12px;
    line-height: 1.2;
  }

  @media (max-width: 820px) {
    .settings-section-intro {
      grid-template-columns: 1fr;
    }

    .settings-section-intro__highlights {
      justify-content: flex-start;
    }
  }
</style>
