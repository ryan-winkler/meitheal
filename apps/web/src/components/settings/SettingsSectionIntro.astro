---
import type { SettingsSectionDescriptor } from "../../lib/settings-registry"

interface Props {
  section: SettingsSectionDescriptor
}
const { section } = Astro.props
---

<header class="settings-section-intro">
  <h2 tabindex="-1">{section.label}</h2>
  <p>{section.description}</p>
</header>

<style>
  .settings-section-intro h2 {
    width: fit-content;
    margin: 0;
    font-size: clamp(1.5rem, 3vw, 2rem);
    line-height: 1.2;
    font-weight: 650;
  }

  .settings-section-intro p {
    margin: 6px 0 0;
    max-width: 62ch;
    color: var(--text-secondary);
    font-size: 0.9375rem;
    line-height: 1.5;
  }
</style>
