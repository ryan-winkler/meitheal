---
import { t } from "../../i18n/translations"
import type { Locale } from "../../lib/locale"
import { SETTINGS_SECTIONS } from "../../lib/settings-registry"
import Icon from "../ui/Icon.astro"
import SettingsActionRow from "./SettingsActionRow.astro"
import SettingsCallout from "./SettingsCallout.astro"
import SettingsPanelCard from "./SettingsPanelCard.astro"
import SettingsSectionIntro from "./SettingsSectionIntro.astro"

interface Props {
  locale: Locale
  databaseDownloadToken?: string | undefined
}
const { locale, databaseDownloadToken } = Astro.props

const backupsResetSection = SETTINGS_SECTIONS.find((section) => section.id === "backups-reset-settings")!
---

<section
  id="backups-reset-settings"
  class="settings-shell__section"
  data-settings-shell-section
  hidden
>
  <SettingsSectionIntro section={backupsResetSection} />
  <div class="settings-grid">

  <!-- Backups & Data Portability -->
  <SettingsPanelCard
    icon="database"
    title={t("settings.data_title", locale)}
    subtitle={t("settings.data_subtitle", locale)}
  >
    <SettingsCallout title={t("settings.callout_data_title", locale)} icon="database">
      {t("settings.callout_data_desc", locale)}
    </SettingsCallout>
    <div class="form-group mt-3">
      <label class="form-label mb-2"
        >{t("settings.export_tasks", locale)}</label
      >
      <SettingsActionRow>
        <a
          href="#"
          class="btn btn-primary"
          id="export-json-btn"
          style="flex: 1; text-align: center; text-decoration: none;"
          ><Icon name="download" size={14} sprite={true} /> <span>{t("settings.download_json", locale)}</span></a
        >
        <a
          href="/api/export/tasks.csv"
          download
          class="btn btn-secondary"
          id="export-csv-btn"
          style="flex: 1; text-align: center; text-decoration: none;"
          ><Icon name="chart-bar" size={14} sprite={true} /> <span>{t("settings.download_csv", locale)}</span></a
        >
        {databaseDownloadToken && (
          <>
            <form id="export-db-form" method="post" action="/api/export/database.sqlite" hidden>
              <input type="hidden" name="token" value={databaseDownloadToken} />
            </form>
            <button type="button" class="btn btn-secondary" id="export-db-btn"
              style="flex: 1; text-align: center;"><Icon name="database" size={14} sprite={true} /> <span>{t("settings.raw_db", locale)}</span></button>
          </>
        )}
      </SettingsActionRow>
      <small class="settings-hint" style="display: block; margin-top: 6px;">
        {t(databaseDownloadToken ? "settings.export_hint_admin" : "settings.export_hint", locale)}
      </small>
    </div>

    <div
      class="form-group"
      style="margin-top: 16px; border-top: 1px solid var(--border-color); padding-top: 16px;"
    >
      <label class="form-label mb-2"
        >{t("settings.settings_config", locale)}</label
      >
      <SettingsActionRow>
        <a
          href="/api/export/settings.json"
          download
          class="btn btn-secondary flex-1 text-center no-underline"
          id="export-settings-btn"
          ><Icon name="settings" size={14} sprite={true} /> <span>{t("settings.export_config", locale)}</span></a
        >
        <label
          class="settings-file-picker btn btn-secondary flex-1 text-center no-underline"
          style="cursor: pointer; margin: 0; padding: 6px 16px; display: inline-flex; justify-content: center; align-items: center; gap: 6px;"
        >
          <Icon name="refresh" size={14} sprite={true} />
          <span>{t("settings.import_config", locale)}</span>
          <input
            type="file"
            id="import-settings-input"
            accept=".json"
          />
        </label>
      </SettingsActionRow>
      <small class="settings-hint" style="display: block; margin-top: 6px;">
        {t("settings.config_hint", locale)}
      </small>
    </div>
  </SettingsPanelCard>

  <!-- Archiving & Data Retention -->
  <SettingsPanelCard
    icon="package"
    title={t("settings.danger_archive_title", locale)}
    subtitle={t("settings.danger_archive_subtitle", locale)}
    tone="default"
  >
    <SettingsCallout title={t("settings.danger_archive_callout_title", locale)} icon="info" tone="warning">
      <span set:html={t("settings.danger_archive_callout_desc", locale)}></span>
    </SettingsCallout>

    <div class="retention-controls mt-4">
      <label for="retention-months-select" class="retention-label">
        {t("settings.danger_archive_label", locale)}
      </label>
      <div class="retention-row">
        <select
          id="retention-months-select"
          class="form-select retention-select"
        >
          <option value="" selected disabled>{t("settings.danger_archive_choose", locale)}</option>
          <option value="3">{t("settings.danger_archive_months", locale, { count: "3" })}</option>
          <option value="6">{t("settings.danger_archive_months", locale, { count: "6" })}</option>
          <option value="12">{t("settings.danger_archive_months", locale, { count: "12" })}</option>
          <option value="24">{t("settings.danger_archive_months", locale, { count: "24" })}</option>
        </select>
        <button
          class="btn btn-warning-outline"
          id="retention-preview-btn"
          disabled
        ><Icon name="search" size={14} sprite={true} /> <span>{t("settings.danger_archive_preview", locale)}</span></button>
      </div>

      <div
        id="retention-preview-result"
        class="retention-preview"
        style="display: none;"
        role="status"
        aria-live="polite"
      >
        <!-- Populated by controller -->
      </div>
    </div>

    <SettingsActionRow class="mt-4">
      <button
        class="btn btn-danger-outline"
        id="retention-delete-btn"
        disabled
        aria-describedby="retention-preview-result"
      ><Icon name="trash" size={14} sprite={true} /> <span>{t("settings.danger_archive_delete", locale)}</span></button>
    </SettingsActionRow>
  </SettingsPanelCard>

  <!-- Danger Zone -->
  <SettingsPanelCard
    icon="warning"
    title={t("settings.danger_title", locale)}
    subtitle={t("settings.danger_subtitle", locale)}
    tone="danger"
  >
    <SettingsCallout title={t("settings.danger_zone_callout_title", locale)} icon="warning" tone="danger">
      {t("settings.danger_zone_callout_desc", locale)}
    </SettingsCallout>
    <SettingsActionRow class="mt-4">
      <button
        class="btn btn-danger-outline"
        id="purge-tasks"
        ><Icon name="trash" size={14} sprite={true} /> <span>{t("settings.danger_purge_tasks", locale)}</span></button
      >
      <button
        class="btn btn-danger-outline"
        id="reset-settings"
        ><Icon name="refresh" size={14} sprite={true} /> <span>{t("settings.danger_reset_settings", locale)}</span></button
      >
    </SettingsActionRow>
  </SettingsPanelCard>
  </div>
</section>

<style>
  .retention-label {
    display: block;
    font-size: 13px;
    color: var(--text-secondary);
    margin-bottom: 6px;
  }
  .retention-row {
    display: flex;
    gap: 10px;
    align-items: center;
    flex-wrap: wrap;
  }
  .retention-select {
    min-width: 160px;
  }
  .retention-preview {
    margin-top: 12px;
    padding: 12px 16px;
    border-radius: 8px;
    background: var(--bg-hover);
    border: 1px solid var(--border);
    font-size: 13px;
  }
  .btn-danger-outline {
    border-color: var(--danger);
    color: var(--danger);
  }
  .btn-danger-outline:hover {
    background: color-mix(in srgb, var(--danger) 10%, transparent);
  }
  .btn-warning-outline {
    border-color: var(--warning);
    color: var(--warning);
  }
  .btn-warning-outline:hover {
    background: color-mix(in srgb, var(--warning) 10%, transparent);
  }
</style>
