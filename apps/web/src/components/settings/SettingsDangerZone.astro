---
import { t } from "../../i18n/translations"
import type { Locale } from "../../lib/locale"
import { SETTINGS_SECTIONS } from "../../lib/settings-registry"
import SettingsActionRow from "./SettingsActionRow.astro"
import SettingsCallout from "./SettingsCallout.astro"
import SettingsPanelCard from "./SettingsPanelCard.astro"
import SettingsSectionIntro from "./SettingsSectionIntro.astro"

interface Props {
  locale: Locale
}
const { locale } = Astro.props

const dangerZoneSection = SETTINGS_SECTIONS.find((section) => section.id === "danger-zone-settings")!
---

<section
  id="danger-zone-settings"
  class="settings-shell__section"
  data-settings-shell-section
  hidden
>
  <SettingsSectionIntro section={dangerZoneSection} />
  <div class="settings-grid">

  <!-- Archiving & Data Retention -->
  <SettingsPanelCard
    title={t("settings.danger_archive_title", locale)}
    subtitle={t("settings.danger_archive_subtitle", locale)}
    tone="default"
  >
    <SettingsCallout title={t("settings.danger_archive_callout_title", locale)} icon="ℹ" tone="warning">
      <span set:html={t("settings.danger_archive_callout_desc", locale)}></span>
    </SettingsCallout>

    <div class="retention-controls mt-4">
      <label for="retention-months-select" class="retention-label">
        {t("settings.danger_archive_label", locale)}
      </label>
      <div class="retention-row">
        <select
          id="retention-months-select"
          class="form-select retention-select"
        >
          <option value="" selected disabled>{t("settings.danger_archive_choose", locale)}</option>
          <option value="3">{t("settings.danger_archive_months", locale, { count: "3" })}</option>
          <option value="6">{t("settings.danger_archive_months", locale, { count: "6" })}</option>
          <option value="12">{t("settings.danger_archive_months", locale, { count: "12" })}</option>
          <option value="24">{t("settings.danger_archive_months", locale, { count: "24" })}</option>
        </select>
        <button
          class="btn btn-warning-outline"
          id="retention-preview-btn"
          disabled
        >{t("settings.danger_archive_preview", locale)}</button>
      </div>

      <div
        id="retention-preview-result"
        class="retention-preview"
        style="display: none;"
        role="status"
        aria-live="polite"
      >
        <!-- Populated by controller -->
      </div>
    </div>

    <SettingsActionRow class="mt-4">
      <button
        class="btn btn-danger-outline"
        id="retention-delete-btn"
        disabled
        aria-describedby="retention-preview-result"
      >{t("settings.danger_archive_delete", locale)}</button>
    </SettingsActionRow>
  </SettingsPanelCard>

  <!-- Danger Zone -->
  <SettingsPanelCard
    title={t("settings.danger_title", locale)}
    subtitle={t("settings.danger_subtitle", locale)}
    tone="danger"
  >
    <SettingsCallout title={t("settings.danger_zone_callout_title", locale)} icon="⚠" tone="danger">
      {t("settings.danger_zone_callout_desc", locale)}
    </SettingsCallout>
    <SettingsActionRow class="mt-4">
      <button
        class="btn btn-danger-outline"
        id="purge-tasks"
        >{t("settings.danger_purge_tasks", locale)}</button
      >
      <button
        class="btn btn-danger-outline"
        id="reset-settings"
        >{t("settings.danger_reset_settings", locale)}</button
      >
    </SettingsActionRow>
  </SettingsPanelCard>
  </div>
</section>

<style>
  .retention-label {
    display: block;
    font-size: 13px;
    color: var(--text-secondary);
    margin-bottom: 6px;
  }
  .retention-row {
    display: flex;
    gap: 10px;
    align-items: center;
    flex-wrap: wrap;
  }
  .retention-select {
    min-width: 160px;
  }
  .retention-preview {
    margin-top: 12px;
    padding: 12px 16px;
    border-radius: 8px;
    background: var(--bg-hover);
    border: 1px solid var(--border);
    font-size: 13px;
  }
  .btn-danger-outline {
    border-color: var(--danger);
    color: var(--danger);
  }
  .btn-danger-outline:hover {
    background: color-mix(in srgb, var(--danger) 10%, transparent);
  }
  .btn-warning-outline {
    border-color: var(--warning);
    color: var(--warning);
  }
  .btn-warning-outline:hover {
    background: color-mix(in srgb, var(--warning) 10%, transparent);
  }
</style>
