---
import { t } from "../../i18n/translations"
import type { Locale } from "../../lib/locale"
import { canManageSystemSettings } from "../../lib/settings-security"
import SettingsPanelCard from "./SettingsPanelCard.astro"

/**
 * SettingsAgents — AI provider and agent protocol configuration.
 *
 * Phase 58: Added HA Conversation Agent picker at top.
 *
 * @domain settings
 * @bounded-context agents
 */

interface Props {
  locale: Locale
}
const { locale } = Astro.props
const canManageAi = canManageSystemSettings(Astro.request, Astro.locals)
---

<div class="settings-shell-panel">
  <div class="settings-grid">
    <SettingsPanelCard
      title={t("settings.agents_title", locale)}
      subtitle={t("settings.agents_subtitle", locale)}
    >

      <!-- HA Conversation Agent (PRIMARY — top of page) -->
      <div class="integration-section">
        <div class="integration-header">
          <div>
            <strong>{t("settings.ha_agent_title", locale)}</strong>
            <div class="integration-desc">
              {t("settings.ha_agent_desc", locale)}
            </div>
          </div>
          <span class="badge badge-active" id="ha-agent-status">{t("settings.default", locale)}</span>
        </div>
        <div class="integration-config">
          <div class="form-group">
            <label class="form-label" for="ha-agent-select-settings"
              >{t("settings.ha_agent_label", locale)}</label
            >
            <select class="form-select" id="ha-agent-select-settings" data-default={t("settings.ha_agent_default", locale)} disabled={!canManageAi}>
              <option value="" selected>{t("settings.ha_agent_default", locale)}</option>
            </select>
            <p id="ha-agent-discovery-status" class="settings-hint" role="status" aria-live="polite"></p>
            <small class="settings-hint" style="display: block;">
              {t("settings.ha_agent_help", locale)}
            </small>
          </div>
          <div
            class="form-group"
            style="display: flex; flex-wrap: wrap; gap: 8px; align-items: center;"
          >
            <button
              type="button"
              class="btn btn-primary settings-text-sm"
              id="save-ha-agent"
              disabled={!canManageAi}
              data-text-saved={t("settings.agent_setting_saved", locale)}
              data-text-failed={t("settings.agent_setting_failed", locale)}>{t("settings.save_ha_agent", locale)}</button>
            <button
              type="button"
              class="btn btn-ghost settings-text-sm"
              id="test-ha-agent"
              disabled={!canManageAi}
              data-text-testing={t("settings.testing", locale)}
              data-text-unavailable={t("settings.agent_unavailable", locale)}
              data-text-failed={t("settings.connection_failed", locale)}>{t("settings.test", locale)}</button>
            <button type="button" class="btn btn-ghost settings-text-sm" id="refresh-ha-agents" disabled={!canManageAi}>{t("settings.refresh_ha_agents", locale)}</button>
            <span
              id="ha-agent-test-result"
              role="status"
              aria-live="polite"
              style="font-size: 12px; color: var(--text-muted);"></span>
          </div>
        </div>
      </div>

      <hr style="border-color: var(--border); margin: 16px 0;" />

      <!-- External AI Provider (secondary) -->
      <div class="integration-section">
        <div class="integration-header">
          <div>
            <strong>{t("settings.ext_ai_title", locale)}</strong>
            <div class="integration-desc">
              {t(canManageAi ? "settings.ext_ai_desc" : "settings.ext_ai_admin_only", locale)}
            </div>
          </div>
          {canManageAi && <span class="badge badge-active" id="ext-ai-badge" hidden></span>}
        </div>
        {canManageAi && <div class="integration-config">
          <p id="ai-provider-unavailable" class="settings-hint" role="status" hidden>{t("settings.ai_provider_edit_unavailable", locale)}</p>
          <div id="ai-provider-editor" hidden>
            <div class="form-group">
              <label class="form-label" for="ai-provider">{t("settings.ext_ai_provider", locale)}</label>
              <select class="form-select" id="ai-provider" disabled>
                <option value="chatgpt" selected>{t("settings.ext_ai_chatgpt", locale)}</option>
                <option value="claude">{t("settings.ext_ai_claude", locale)}</option>
                <option value="gemini">{t("settings.ext_ai_gemini", locale)}</option>
                <option value="ollama">{t("settings.ext_ai_ollama", locale)}</option>
                <option value="ha_llm">{t("settings.ext_ai_ha_llm", locale)}</option>
                <option value="custom">{t("settings.ext_ai_custom", locale)}</option>
              </select>
            </div>
            <div
              class="form-group"
              id="ai-custom-url-group"
              style="display: none;"
            >
              <label class="form-label" for="ai-custom-url">{t("settings.ext_ai_custom_url", locale)}</label>
              <input
                type="url"
                class="form-input"
                id="ai-custom-url"
                aria-describedby="ai-custom-url-help"
                placeholder="http://localhost:11434/api/chat"
                disabled
              />
              <p class="settings-hint" id="ai-custom-url-help">{t("settings.ai_custom_url_visibility", locale)}</p>
              <label class="settings-text-sm">
                <input type="checkbox" id="ai-custom-url-share" aria-describedby="ai-custom-url-help" disabled />
                {t("settings.ai_custom_url_share", locale)}
              </label>
            </div>
            <button
              type="button"
              class="btn btn-primary settings-text-sm"
              id="save-ai" disabled>{t("settings.save_ai_settings", locale)}</button>
          </div>
        </div>}
      </div>

      <hr style="border-color: var(--border); margin: 16px 0;" />

      <!-- Agent Protocols -->
      <div class="integration-section">
        <div class="integration-header">
          <div>
            <strong>{t("settings.agent_protocols_title", locale)}</strong>
            <div class="integration-desc">
              {t("settings.agent_protocols_desc", locale)}
            </div>
          </div>
          <span class="badge badge-pending" id="agent-protocols-status" role="status" aria-live="polite"
            style="white-space: normal;"
            data-checking={t("settings.protocol_discovery_checking", locale)}
            data-count={t("settings.protocol_discovery_count", locale)}>{t("settings.protocol_discovery_not_checked", locale)}</span>
        </div>
        <div class="integration-config">
          <!-- A2A -->
          <div
            class="form-group"
            style="padding-bottom: 16px; border-bottom: 1px solid var(--border);"
          >
            <div
              class="settings-row--simple"
            >
              <label class="toggle-label">
                <input type="checkbox" id="agent-a2a-enabled" aria-labelledby="agent-a2a-enabled-label" checked={canManageAi} disabled={!canManageAi} />
                <span class="toggle-slider"></span>
              </label>
              <div>
                <strong id="agent-a2a-enabled-label" class="settings-text-sm">{t("settings.a2a_title", locale)}</strong>
                <div
                  class="settings-caption"
                >
                  <span set:html={t("settings.a2a_desc", locale)} />
                  <p id="agent-a2a-runtime-status" role="status" aria-live="polite"
                    data-checking={t("settings.protocol_discovery_checking", locale)}
                    data-disabled={t("settings.protocol_discovery_disabled", locale)}
                    data-unavailable={t("settings.protocol_discovery_unavailable", locale)}
                    data-available={t("settings.protocol_discovery_a2a", locale)}>{t("settings.protocol_discovery_not_checked", locale)}</p>
                  <a
                    href="/api/a2a/agent-card"
                    target="_blank"
                    rel="noopener noreferrer"
                    class="protocol-link"
                    data-path="/api/a2a/agent-card" data-protocol-link="a2a" hidden
                  >
                    {t("settings.view_agent_card", locale)}
                  </a>
                </div>
              </div>
            </div>
          </div>

          <!-- WebMCP -->
          <div
            class="form-group"
            style="padding-top: 16px; padding-bottom: 16px; border-bottom: 1px solid var(--border);"
          >
            <div
              class="settings-row--simple"
            >
              <label class="toggle-label">
                <input type="checkbox" id="agent-webmcp-enabled" aria-labelledby="agent-webmcp-enabled-label" disabled={!canManageAi} />
                <span class="toggle-slider"></span>
              </label>
              <div>
                <strong id="agent-webmcp-enabled-label" class="settings-text-sm">{t("settings.webmcp_title", locale)}</strong>
                <span class="badge badge-active protocol-stage">{t("settings.experimental", locale)}</span>
                <div
                  class="settings-caption"
                >
                  {t("settings.webmcp_desc", locale)}
                </div>
                <p id="webmcp-runtime-status" class="settings-hint" role="status" aria-live="polite"
                  data-state="disabled"
                  data-disabled={t("settings.webmcp_disabled", locale)}
                  data-unavailable={t("settings.webmcp_unavailable", locale)}
                  data-starting={t("settings.webmcp_starting", locale)}
                  data-registered={t("settings.webmcp_registered", locale)}
                  data-failed={t("settings.webmcp_failed", locale)}>{t("settings.webmcp_disabled", locale)}</p>
              </div>
            </div>
          </div>

          <!-- MCP Discovery -->
          <div class="form-group" style="padding-top: 16px;">
            <div
              class="settings-row--simple"
            >
              <label class="toggle-label">
                <input type="checkbox" id="agent-mcp-enabled" aria-labelledby="agent-mcp-enabled-label" checked={canManageAi} disabled={!canManageAi} />
                <span class="toggle-slider"></span>
              </label>
              <div>
                <strong id="agent-mcp-enabled-label" class="settings-text-sm">{t("settings.mcp_discovery_title", locale)}</strong>
                <div
                  class="settings-caption"
                >
                  <span set:html={t("settings.mcp_discovery_desc", locale)} />
                  <p id="agent-mcp-runtime-status" role="status" aria-live="polite"
                    data-checking={t("settings.protocol_discovery_checking", locale)}
                    data-disabled={t("settings.protocol_discovery_disabled", locale)}
                    data-unavailable={t("settings.protocol_discovery_unavailable", locale)}
                    data-available={t("settings.protocol_discovery_mcp", locale)}>{t("settings.protocol_discovery_not_checked", locale)}</p>
                  <a
                    href="/.well-known/mcp.json"
                    target="_blank"
                    rel="noopener noreferrer"
                    class="protocol-link"
                    data-path="/.well-known/mcp.json" data-protocol-link="mcp" hidden
                  >
                    {t("settings.view_mcp_manifest", locale)}
                  </a>
                </div>
              </div>
            </div>
          </div>

          {!canManageAi && <p class="settings-hint" id="agent-protocols-admin-only">{t("settings.agent_protocols_admin_only", locale)}</p>}
          <button type="button" class="btn btn-secondary settings-text-sm" id="refresh-agent-discovery"
            data-checking={t("settings.protocol_discovery_checking", locale)}>{t("settings.protocol_discovery_retry", locale)}</button>
          <button
            type="button"
            class="btn btn-primary settings-text-sm"
            id="save-agent-protocols"
            disabled={!canManageAi}>{t("settings.save_protocol_settings", locale)}</button
          >
        </div>
      </div>
    </SettingsPanelCard>
  </div>
  <!-- /settings-grid (agents) -->

  <div class="settings-grid mt-4">
    <SettingsPanelCard
      title={t("settings.bot_handoff_title", locale)}
      subtitle={t("settings.bot_handoff_subtitle", locale)}
    >
      <a id="bot-allow-proposals" class="btn btn-secondary" href="/review">{t("settings.bot_handoff_review", locale)}</a>
    </SettingsPanelCard>
  </div>
</div>

<style is:inline>
  /* ── Agents & AI — integration section styling ── */
  .integration-section {
    padding: 16px 0;
  }
  .integration-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 12px;
    margin-bottom: 12px;
  }
  .integration-header strong {
    font-size: 15px;
    color: var(--text-primary);
  }
  .integration-desc {
    color: var(--text-muted);
    font-size: 12px;
    line-height: 1.5;
    margin-top: 4px;
    max-width: 600px;
  }
  .integration-config {
    padding: 12px 16px;
    background: var(--bg-secondary);
    border: 1px solid var(--border);
    border-radius: var(--radius-sm, 8px);
  }
  .settings-caption .protocol-link {
    color: var(--accent-text);
    text-decoration: underline;
  }
  .protocol-stage {
    margin-left: 6px;
    vertical-align: middle;
  }
  .integration-config .form-group + .form-group {
    margin-top: 12px;
  }
  #ext-ai-badge[hidden] {
    display: none;
  }
  .toggle-label:has(input:disabled) {
    opacity: 0.5;
    cursor: not-allowed;
  }
</style>
