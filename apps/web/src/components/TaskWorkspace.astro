---
import { boardScopeAuthorityKey, retainBoardResponseScope } from "@lib/board-view"
import { scopePermits, type BoardScope } from "@domains/tasks/board-scope"
import { boardSessionProof } from "@lib/named-board-request"
import { boardWorkspaceHref } from "@lib/board-workspace"
import TaskRefreshShell from "./tasks/TaskRefreshShell.astro"
import BoardsStyles from "./boards/BoardsStyles.astro"
import BoardWorkspaceNav from "./boards/BoardWorkspaceNav.astro"
import { isOrganizationFeatureAvailable as available } from "@lib/organization-request-context"
import HomeAssistantAreaField from "../components/tasks/HomeAssistantAreaField.astro"
import { readHomeAssistantAreaFilter } from "@lib/home-assistant-area-access"
import { newOrganizationLabel, organizationLabelsFor } from "@lib/organization-labels"
import Layout from "../layouts/Layout.astro";

import UnifiedBar from "../components/layout/UnifiedBar.astro";
import SignalBar from "../components/layout/SignalBar.astro";
import { requestedTaskView, resolveDefaultTaskView, taskViewUrl, TASK_VIEWS, TASK_VIEW_LABELS, TASK_VIEW_ICONS, TASK_REFRESH_FRAGMENT_HEADER } from "../lib/task-view-route"
import { loadKanbanBoard } from "../lib/kanban-board-data"
import { getHouseholdProjectGroup, getHouseholdProjectLabels } from "../lib/household-project-grouping"
import { readKanbanFilters, setKanbanPage } from "../lib/kanban-query"
import LabelBadges from "../components/ui/LabelBadges.astro";
import FilterToolbar from "../components/ui/FilterToolbar.astro";
import CardCustomizer from "../components/ui/CardCustomizer.astro";
import { t } from "../i18n/translations";
import type { Locale } from "../lib/locale";
import { calendarDaysFromToday, isDueOverdue } from "../lib/date";
import { formatRegionalDate } from "../lib/regional-date";
import { formatTicketKey } from "../lib/ticket-key";
import { taskSurface } from "../lib/task-surface"
import { taskDescriptionPreview } from "../lib/task-description-preview"
import { formatCardCustomFieldValue } from "../lib/custom-field-defs"
import { frameworkPayloadObject, readRiceInputs, riceLensScore } from "../lib/rice-lens"
import { taskDetailPath } from "../lib/task-page-url"
import {
  ensureSchema,
  getPersistenceClient,
} from "@domains/tasks/persistence/store";
import { TaskInactivityRepository } from "@domains/tasks/persistence/task-inactivity-repository"
import { TaskRepository } from "@domains/tasks/persistence/task-repository";
import { TemplateRepository } from "@domains/tasks/persistence/template-repository";
import { SettingsRepository } from "@domains/tasks/persistence/settings-repository"
import { isFeatureEnabled } from "../lib/feature-flags";
import StatusBadge from "../components/ui/StatusBadge.astro";
import Icon from "../components/ui/Icon.astro";
import KanbanTaskCard from "./tasks/KanbanTaskCard.astro";
import TasksTableView from "../components/views/TasksTableView.astro";
import { readTableFilterParams, tableNeedsWorkflowColumns } from "../lib/filter-state"
import { getTasksForView, type TaskViewItem } from "../lib/task-queries"
import TasksCalendarView from "../components/views/TasksCalendarView.astro";
import TasksTimelineView from "../components/views/TasksTimelineView.astro";
import TaskTypeIcon from "../components/ui/TaskTypeIcon.astro";
import AreaSelector from "../components/layout/AreaSelector.astro";
import { HierarchyRepository } from "@domains/tasks/persistence/hierarchy-repository";


const {
  ingressPath,
  hassUserId,
  timezone,
  weekStart,
  dateFormat,
} = Astro.locals;

// i18n: resolve locale from cookie
const cookieLocale = Astro.cookies.get("meitheal-locale")?.value;
const locale: Locale = cookieLocale === "ga" ? "ga" : "en";
interface Props { workScope: BoardScope; boardId?: string; namedBoardId?: string }
const scope = Astro.props.workScope
retainBoardResponseScope(Astro.request, scope)
const boardId = scope.boardId
const session = boardSessionProof(scope.principal.id)
const authorityKey = boardScopeAuthorityKey(scope)
const canEdit = scopePermits(scope, { resource: "task", action: "edit" })
const canCreate = scopePermits(scope, { resource: "task", action: "create" })
const canComplete = scopePermits(scope, { resource: "task", action: "complete" })
const canDelete = scopePermits(scope, { resource: "task", action: "delete" })
const explicitRequestedView = requestedTaskView(Astro.url.searchParams)
const userAgent = Astro.request.headers.get("user-agent") ?? ""
const renderedView = resolveDefaultTaskView(
  Astro.url.searchParams,
  Astro.url.hash,
  userAgent,
)
const organization = await organizationLabelsFor(Astro)
const heading = renderedView === "kanban" ? organization("task", true, t("kanban.title", locale))
  : renderedView === "table" ? "Table View" : TASK_VIEW_LABELS[renderedView]
const currentUrl = new URL(Astro.url)
const homeAreaFilter = renderedView === "kanban" ? await readHomeAssistantAreaFilter(Astro, currentUrl.searchParams) : undefined
if (!homeAreaFilter) currentUrl.searchParams.delete("home_assistant_area_id")
if (homeAreaFilter) Astro.response.headers.set("cache-control", "private, no-store")
// The HTML ingress rewriter adds the mount path to these root-relative links.
currentUrl.pathname = `/boards/${encodeURIComponent(boardId)}`
// Refresh fragments use the same selected Board loader and authority as full pages.
const compactRefresh = Astro.request.method === "GET" &&
  Astro.request.headers.get(TASK_REFRESH_FRAGMENT_HEADER) === "1" &&
  ((renderedView === "kanban" && currentUrl.searchParams.has("boardRefresh")) ||
   (renderedView === "table" && currentUrl.searchParams.has("tableRefresh")))
const WorkspaceShell = compactRefresh ? TaskRefreshShell : Layout
if (currentUrl.searchParams.has("boardRefresh") ||
    (renderedView === "table" && currentUrl.searchParams.has("tableRefresh"))) {
  currentUrl.searchParams.delete("boardRefresh")
  currentUrl.searchParams.delete("tableRefresh")
  Astro.response.headers.set("cache-control", "no-store")
}


await ensureSchema();
const db = getPersistenceClient();
const repo = new TaskRepository(db, scope);
const hierarchyRepo = new HierarchyRepository(db, scope);
if (!compactRefresh && canCreate && (await isFeatureEnabled("habits").catch(() => false))) {
  await new TemplateRepository(db, scope).ensureDueRoutineTasks(timezone || "UTC").catch(() => 0)
}
const { rows: [boardMetadata] } = await db.execute({ sql: "SELECT name FROM task_boards WHERE id = ?", args: [boardId] })
const boardName = String(boardMetadata?.name ?? "Board")
const selectedProjectId = currentUrl.searchParams.get("project")
const selectedProject = selectedProjectId ? await hierarchyRepo.findProjectById(selectedProjectId).catch(() => null) : null

// Completed task auto-hide: read retention setting (default 30 days, 0 = never hide)
let completedAutoHideDays = 30;
// Backlog mode: visible (default) | hidden | disabled
let backlogMode = "visible";
try {
  const settings = renderedView === "kanban" ? await repo.getSettings([
    "completed_auto_hide_days",
    "backlog_mode",
  ]) : {};
  if (settings.completed_auto_hide_days) {
    const val = Number(JSON.parse(settings.completed_auto_hide_days));
    if (!isNaN(val) && val >= 0) completedAutoHideDays = val;
  }
  if (settings.backlog_mode) {
    const val = JSON.parse(settings.backlog_mode);
    if (val === "hidden" || val === "disabled") backlogMode = val;
  }
} catch {
  /* settings table may not exist yet — use defaults */
}

const completedCutoffMs =
  completedAutoHideDays > 0 ? Date.now() - completedAutoHideDays * 86400000 : 0; // 0 = show all

let columns: {
  key: string;
  label: string;
  icon: string;
  color?: string | null;
  includes: string[];
  builtIn: boolean;
  wipLimit: number;
  id: string;
}[] = [];
let workflowColumnsUnavailable = false
try {
  if (renderedView === "kanban" || renderedView === "table") columns = await repo.getKanbanLanes()
} catch {
  workflowColumnsUnavailable = true
}

if (renderedView === "table" && workflowColumnsUnavailable) {
  Astro.response.headers.set("Cache-Control", "no-store")
}

const tableFilters = renderedView === "table" ? readTableFilterParams(Astro.url.searchParams) : undefined
const workflowResultsUnavailable = workflowColumnsUnavailable && tableFilters && tableNeedsWorkflowColumns(tableFilters)
// Keep the last applied results when a requested workflow lookup fails during a refresh.
if (workflowResultsUnavailable && Astro.url.searchParams.has("tableRefresh")) {
  Astro.response.status = 503
  Astro.response.headers.set("Cache-Control", "no-store")
  return t("table.filter_columns_load_failed", locale)
}

let tableTasks: TaskViewItem[] = []
let tableCreationTimezone: string | undefined
let tableReadFailed = false
if (tableFilters && !workflowResultsUnavailable) {
  try {
    tableTasks = (await getTasksForView({ requireAvailable: true, slim: true, timezone, projectId: currentUrl.searchParams.get("project") || undefined }, scope)).tasks
    if (tableFilters.createdFrom || tableFilters.createdThrough) {
      const { timezone } = await new SettingsRepository(db).getByKeys(["timezone"])
      if (typeof timezone === "string") tableCreationTimezone = timezone
    }
  } catch {
    const headers = { "Cache-Control": "no-store" }
    if (Astro.url.searchParams.has("tableRefresh")) {
      Astro.response.status = 503
      Astro.response.headers.set("Cache-Control", headers["Cache-Control"])
      return t("table.refresh_failed", locale)
    }
    tableReadFailed = true
    Astro.response.status = 503
    Astro.response.headers.set("Cache-Control", headers["Cache-Control"])
  }
}

// Fallback if no lanes in DB
if (columns.length === 0) {
  columns = [
    {
      id: "lane-backlog",
      key: "backlog",
      label: "Backlog",
      icon: "📥",
      includes: ["backlog"],
      builtIn: true,
      wipLimit: 0,
    },
    {
      id: "lane-pending",
      key: "pending",
      label: "Todo",
      icon: "📋",
      includes: ["pending"],
      builtIn: true,
      wipLimit: 0,
    },
    {
      id: "lane-active",
      key: "active",
      label: "In Progress",
      icon: "⚡",
      includes: ["active"],
      builtIn: true,
      wipLimit: 0,
    },
    {
      id: "lane-complete",
      key: "complete",
      label: "Done",
      icon: "✅",
      includes: ["complete"],
      builtIn: true,
      wipLimit: 0,
    },
  ];
}

// Backlog mode: filter out backlog lane when hidden or disabled
if (backlogMode === "hidden" || backlogMode === "disabled") {
  columns = columns.filter((col) => col.key !== "backlog");
}

import {
  PRIORITY_COLORS as priorityColors,
  PRIORITY_CSS_CLASSES as priorityClasses,
} from "../lib/priority-config";

const priorityLabels: Record<number, string> = {
  1: t("priority.critical", locale),
  2: t("priority.high", locale),
  3: t("priority.medium", locale),
  4: t("priority.low", locale),
  5: t("priority.minimal", locale),
};

// Phase 20: Agile type metadata
const typeConfig: Record<string, { label: string; color: string }> = {
  epic: { label: "Epic", color: "#8b5cf6" },
  story: { label: "Story", color: "#22c55e" },
  task: { label: "Task", color: "#3b82f6" },
  bug: { label: "Bug", color: "#ef4444" },
};
const kanbanFilters = readKanbanFilters(currentUrl.searchParams)
const kanbanPages = renderedView === "kanban"
  ? await loadKanbanBoard(repo, columns, completedCutoffMs, currentUrl.searchParams, timezone, homeAreaFilter).catch(() => null)
  : null
const inactivityEnabled = renderedView === "kanban" &&
  await new TaskInactivityRepository(db, scope).hasEnabledPolicy(kanbanFilters.area || null).catch(() => false)
const deferredCount = renderedView === "kanban"
  ? await repo.findDeferredPage(1, kanbanFilters.area || "").then((result) => result.total).catch(() => 0)
  : 0
const boardAreaQuery = `?${new URLSearchParams({ board_id: boardId, ...(kanbanFilters.area ? { area: kanbanFilters.area } : {}) })}`
const kanbanTaskCount = Array.from(kanbanPages?.values() ?? []).reduce((sum, lane) => sum + lane.matches, 0)

function lanePageHref(key: string, page: number) {
  const url = taskViewUrl(currentUrl, "kanban", false, userAgent)
  setKanbanPage(url, key, page)
  return url.pathname + url.search + url.hash
}

// SSR: fetch areas for the AreaSelector
let areas: { id: string; name: string; icon: string; color: string }[] = [];
let areaCatalogReady = false
try {
  const rawAreas = available("groups") ? await hierarchyRepo.findAllAreas() : [];
  areas = rawAreas.map((a) => ({
    id: String(a.id ?? ""),
    name: String(a.name ?? ""),
    icon: String(a.icon ?? "📁"),
    color: String(a.color ?? "var(--accent)"),
  }));
  areaCatalogReady = true
} catch {
  /* areas table may not exist yet */
}
const kanbanAreas = new Map(areas.map(area => [area.id, area]))
const groupByProject = renderedView === "kanban" && kanbanFilters.groupBy === "project" && available("projects")
const projectFallbacks = { none: t("kanban.no_project", locale), unknown: t("kanban.unknown_project", locale) }
let projectLabels = getHouseholdProjectLabels([], Object.fromEntries(areas.map(area => [area.id, area.name])), undefined, projectFallbacks)
let projectCatalogUnavailable = false
if (groupByProject) {
  try {
    projectLabels = getHouseholdProjectLabels(
      (await hierarchyRepo.findProjectGroups()).map(project => ({ ...project, area_id: project.label_area_id })),
      Object.fromEntries(areas.map(area => [area.id, area.name])), undefined, projectFallbacks,
    )
  } catch {
    projectCatalogUnavailable = true
    Astro.response.headers.set("Cache-Control", "no-store")
  }
}

---

<WorkspaceShell title={`Meitheal — ${boardName} · ${heading}`} boardContext={{ boardId, session }} scopeGuard={false}>
  <BoardsStyles />

  <UnifiedBar
    title={boardName}
    newTaskLabel={newOrganizationLabel(organization("task"), locale)}
    titleIcon={TASK_VIEW_ICONS[renderedView]}
    tabs={[]}
    searchPlaceholder="Search Meitheal…"
    searchScope="all"
    barId="kanban-bar"
    slot="custom-header"
    viewTabs={TASK_VIEWS.map(view => {
      const url = taskViewUrl(currentUrl, view, true, userAgent)
      return { id: view, href: url.pathname + url.search + url.hash, label: TASK_VIEW_LABELS[view], icon: TASK_VIEW_ICONS[view], active: view === renderedView }
    })}
  >
    <Fragment slot="context">
      {available("groups") && <AreaSelector areas={areas} catalogReady={areaCatalogReady} endpoint={`/api/boards/${encodeURIComponent(boardId)}?view=groups`} initialId={selectedProjectId ? selectedProject?.area_id ?? "" : undefined} storageKey={`meitheal-selected-area:${authorityKey}`} />}
      {renderedView === "kanban" && <HomeAssistantAreaField mode="filter" initialId={homeAreaFilter?.id ?? ""} />}
    </Fragment>
  </UnifiedBar>
  <div data-task-workspace data-board-directory data-board-key={authorityKey} data-board-authority={authorityKey}
    data-board-verify={`/api/boards/${encodeURIComponent(boardId)}?view=authority`} data-board-session={session} data-board-id={boardId}
    data-can-create={String(canCreate)} data-can-edit={String(canEdit)} data-can-complete={String(canComplete)} data-can-delete={String(canDelete)}>
  <BoardWorkspaceNav {boardId} {boardName}
    area={(selectedProject?.area_id ?? kanbanFilters.area) ? { id: selectedProject?.area_id ?? kanbanFilters.area!, name: areas.find(area => area.id === (selectedProject?.area_id ?? kanbanFilters.area))?.name ?? organization("group") } : undefined}
    project={selectedProject ? { id: selectedProject.id, name: selectedProject.title } : undefined}
    fromArea={Astro.url.searchParams.get("from") ?? undefined}
    settingsHref={scopePermits(scope, { resource: "board", action: "manage" }) ? boardWorkspaceHref(boardId, { groups: true }, "settings") : undefined} />


  {renderedView === "kanban" && !explicitRequestedView && !compactRefresh && (
    <script is:inline>
      (function () {
        try {
          if (window.innerWidth <= 768 && !new URLSearchParams(location.search).has("view") && location.hash !== "#kanban") {
            var next = new URL(location.href);
            next.searchParams.set("view", "table");
            next.hash = "table";
            window.location.replace(next.pathname + next.search + next.hash);
          }
        } catch {}
      })();
    </script>
  )}
  {renderedView === "kanban" && <>
  <!-- Kanban controls and board are rendered only for the selected view. -->
  <div class="tasks-filter-row" id="tasks-filter-row">
    <FilterToolbar
      view="kanban"
      showGroupBy
      showSearch
      hideAreaSelect
      showUserFilter
      showStatusFilter
      showSortBy
      showUserPills={false}
    />
    {<button id="kanban-tools-toggle" class="btn btn-sm kanban-tools-toggle" type="button" aria-controls="kanban-toolbar-actions" aria-expanded="false">
      <Icon name="adjustments-horizontal" size={16} /> Board actions
    </button>
    <div class="kanban-toolbar-right" id="kanban-toolbar-actions" role="group" aria-label="Kanban board actions">
      <a href={`/deferred${boardAreaQuery}`} class="btn btn-outline btn-sm kanban-toolbar-btn"
        data-deferred-link data-astro-prefetch="false">
        <Icon name="clock" size={16} />
        {t("deferral.title", locale)}
        {deferredCount > 0 && <span class="kanban-toolbar-badge">{deferredCount}</span>}
      </a>
      <a href={`/inactivity${boardAreaQuery}`} class="btn btn-outline btn-sm kanban-toolbar-btn"
        data-inactivity-link data-astro-prefetch="false">
        <Icon name="alert-triangle" size={16} />
        {t("inactivity.title", locale)}
      </a>
      <button type="button" class="btn btn-outline btn-sm kanban-toolbar-btn" id="toggle-fields-btn"
        aria-label="Customize card fields" aria-controls="kanban-fields-panel" aria-expanded="false">
        <Icon name="layout-grid" size={16} /> Fields
      </button>
      <button type="button" class="btn btn-outline btn-sm kanban-toolbar-btn" id="manage-lanes-btn"
        aria-label="Lanes" aria-controls="lane-mgmt" aria-expanded="false">
        <Icon name="list-check" size={16} /> Lanes
      </button>
    </div>}
  </div>

  <div id="tasks-view-kanban" class="tasks-view-container" data-task-view="kanban">
  <div id="kanban-shell" class="page-shell">
    <!-- Stats signal bar (non-dismissable) -->
    <SignalBar id="kanban-signal-bar">
      <div class="kanban-summary" aria-live="polite">
        <span>
          <strong data-kanban-visible-count>{kanbanTaskCount}</strong>
          <span data-kanban-visible-label>{kanbanTaskCount === 1 ? t("kanban.task_singular", locale) : t("kanban.task_plural", locale)}</span>
          <strong>{columns.length}</strong> {t("kanban.lanes", locale)}
        </span>
        <span data-kanban-promoted-note hidden={!kanbanFilters.promoted}>{t("kanban.promoted_filter_explanation", locale)}</span>
      </div>
    </SignalBar>

    <div class="kanban-loading-status" data-kanban-loading role="status" hidden></div>
    <button type="button" class="btn btn-outline" data-kanban-retry hidden>{t("kanban.retry_board", locale)}</button>

    <!-- Card field customizer panel (toggled by Fields toolbar icon) -->
    <div class="kanban-fields-panel hidden" id="kanban-fields-panel">
      <CardCustomizer boardId={scope.boardId} />
    </div>

      <div class="lane-mgmt hidden" id="lane-mgmt" role="dialog" aria-modal="true" aria-labelledby="lane-mgmt-title">
        <div class="lane-mgmt-inner card">
          <div class="lane-mgmt-header card-header">
            <div class="lane-mgmt-title-group">
              <h3 id="lane-mgmt-title" class="card-title lane-mgmt-title">{t("kanban.manage_swimlanes", locale)}</h3>
              <button
                type="button"
                class="lane-mgmt-help-btn"
                id="lane-mgmt-help-btn"
                aria-expanded="false"
                aria-controls="lane-mgmt-help-popover"
                aria-label="What are swimlanes?"
                title="Swimlanes stay synced with task Statuses. Reordering, aliasing, or adding a lane updates Kanban columns and status pickers across views."
              >
                <Icon name="info-circle" size={16} sprite />
              </button>
            </div>
            <button
              type="button"
              class="btn-icon lane-mgmt-close"
              id="lane-mgmt-close"
              aria-label="Close"
              title="Close"><Icon name="x" size={16} sprite /></button
            >
          </div>
          <div class="lane-mgmt-help-popover" id="lane-mgmt-help-popover" role="note" hidden>
            <Icon name="info-circle" size={15} sprite class="lane-mgmt-help-popover__icon" />
            <p class="lane-mgmt-help-popover__text">
              <strong>Swimlanes &amp; Statuses stay in sync.</strong> Drag rows to reorder Kanban columns and status lists across every view. Renaming a built-in lane creates a display alias while keeping its system status intact for filters and automations.
            </p>
          </div>
          <div class="table-responsive lane-mgmt-table-wrap">
            <table class="table table-vcenter card-table lane-mgmt-table">
              <thead>
                <tr>
                  <th class="lane-col-drag" aria-label="Reorder"></th>
                  <th>Swimlane &amp; Status</th>
                  <th class="lane-col-color">Color</th>
                  <th class="lane-col-wip" title="Work-in-progress limit (0 = unlimited)">WIP</th>
                  <th class="lane-col-actions">Actions</th>
                </tr>
              </thead>
              <tbody id="lane-list"></tbody>
            </table>
          </div>
          <div class="lane-mgmt-footer card-footer">
            <div class="lane-mgmt-add-row">
              <input
                type="text"
                class="form-control form-input lane-mgmt-add-input"
                id="new-lane-input"
                placeholder={t("kanban.new_lane_placeholder", locale)}
              />
              <button
                type="button"
                class="btn btn-primary btn-sm lane-mgmt-add-btn"
                id="add-lane-btn"
              >
                <Icon name="plus" size={14} sprite />
                <span>{t("kanban.add_lane", locale)}</span>
              </button>
            </div>
          </div>
        </div>
      </div>

  <p class="kanban-project-notice" role="status" data-project-catalog-unavailable hidden={!projectCatalogUnavailable}>
    {t("kanban.project_catalog_failed", locale)}
  </p>
  <div class="kanban-scroll-wrap" data-kanban-scroll-wrap>
    <button
      type="button"
      class="kanban-scroll-btn kanban-scroll-btn--left"
      data-kanban-scroll="left"
      aria-label="Scroll lanes left"
      title="Scroll lanes left"
      hidden
    >
      <Icon name="chevron-down" size={18} class="kanban-scroll-icon--left" sprite />
    </button>
    <div
      id="kanban-board"
      class="kanban-board"
      data-available={String(Boolean(kanbanPages))}
      data-inactivity-enabled={String(inactivityEnabled)}
      data-inactivity-ready={t("inactivity.ready", locale)}
      data-inactivity-upcoming={t("inactivity.upcoming", locale)}
      data-inactivity-stalled={t("inactivity.stalled", locale)}
      data-group-by={kanbanFilters.groupBy}
      data-no-epic-label={t("kanban.group_no_epic", locale)}
      data-no-area-label={t("recent_activity.no_area", locale)}
      data-unavailable-area-label={t("kanban.unavailable_area", locale)}
      data-backlog-mode={backlogMode}
      data-kanban-moving={t("kanban.moving_task", locale)}
      data-reaction-count-label={t("reactions.card_count", locale)}
      style={`padding: 0 0 8px; grid-template-columns: repeat(${columns.length}, 1fr);`}
    >
    {
      columns.map((col) => {
        const lane = kanbanPages?.get(col.key)
        const colTasks = lane?.cards ?? []
        const laneTotal = lane?.total ?? 0
        const matches = lane?.matches ?? 0
        const wipExceeded = col.wipLimit > 0 && laneTotal > col.wipLimit
        return (
          <div
            class={`kanban-column${wipExceeded ? " wip-exceeded" : ""}`}
            data-status={col.key}
            data-lane-id={col.id}
            data-wip-limit={String(col.wipLimit)}
            data-total={laneTotal}
            data-page={lane?.page ?? 1}
            role="region"
            aria-label={`${col.label} Swimlane`}
          >
            <div class="kanban-column-header" data-column-key={col.key} tabindex="-1" style={col.color ? `--lane-accent: ${col.color}` : undefined}>
              <span class="kanban-column-title">
                <span class={`column-status-dot status-${col.key}`} style={col.color ? `background: ${col.color}` : undefined} />
                {col.label}
              </span>
              <span class="kanban-header-right">
                {col.wipLimit > 0 && (
                  <span
                    class={`kanban-wip${wipExceeded ? " wip-over" : ""}`}
                    title={`WIP limit: ${col.wipLimit}`}
                  >
                    {laneTotal}/{col.wipLimit}
                  </span>
                )}
                <span class="kanban-count">{matches}</span>
              </span>
              <span class="kanban-move-status" data-kanban-move-status role="status"></span>
            </div>
            <div class="kanban-cards">
              {/* Swimlane group containers (hidden by default, JS-driven grouping) */}
              {["epic", "story", "task"].map((type) => {
                const tc = typeConfig[type] ?? {
                  label: type,
                  color: "var(--text-muted)",
                };
                const count = colTasks.filter(
                  (t) => String(t.task_type ?? "task") === type,
                ).length;
                return (
                  <div
                    class={`swimlane-group swimlane-${type}`}
                    data-swimlane-type={type}
                    hidden
                  >
                    <button type="button" class="swimlane-header" aria-expanded="true">
                      <span
                        aria-hidden="true"
                        class={`swimlane-toggle inline-flex items-center ${count === 0 ? "opacity-30 pointer-events-none" : ""}`}
                      >
                        <Icon name="chevron-down" size={14} sprite />
                      </span>
                      <TaskTypeIcon type={type} size={16} />
                      <span class="swimlane-label">{tc.label}</span>
                      <span class="swimlane-count">{count}</span>
                    </button>
                    <div class="swimlane-cards">
                      {/* Cards moved here by JS when grouping is active */}
                    </div>
                    <button
                      type="button"
                      class="kanban-add-btn swimlane-add-btn"
                      data-status={col.key}
                      data-task-type={type}
                      aria-label={`Add ${type} to ${col.label}`}
                    >
                      {t("kanban.add_task", locale)}
                    </button>
                  </div>
                );
              })}
              {/* Flat (non-grouped) card rendering */}
              {colTasks.map((task) => {
                const epicGroup = lane?.epicsByCard.get(task.id)
                const p = Number(task.priority ?? 3);
                const ticketKey = String(task.ticket_key ?? task.ticket_ref ?? formatTicketKey(Number(task.ticket_number)));
                const tt = String(task.task_type ?? "task");
                const tc = (typeConfig[tt] || typeConfig.task)!;
                const areaId = String(task.area_id ?? "")
                const cardArea = kanbanAreas?.get(areaId)
                const promoted = Number(task.is_promoted) === 1
                let parsedFp: unknown = {}
                if (typeof task.framework_payload === "string" && task.framework_payload.trim()) {
                  try { parsedFp = JSON.parse(task.framework_payload) } catch { parsedFp = {} }
                } else if (task.framework_payload && typeof task.framework_payload === "object") {
                  parsedFp = task.framework_payload
                }
                const fp = frameworkPayloadObject(parsedFp)
                // Phase 20: Sub-task indicator (ADHD Optimization)
                const childCount = Number(task.child_count ?? 0);
                const projectGroup = groupByProject ? getHouseholdProjectGroup(
                  task.project_id, projectLabels, Boolean(task.project_assigned),
                ) : undefined
                const projectLabel = projectGroup ? projectLabels[projectGroup] : undefined
                const riceInputs = readRiceInputs(fp)
                const rice = riceInputs ? riceLensScore(riceInputs) : null
                const dueDate = task.due_date
                  ? new Date(String(task.due_date))
                  : null;
                const today = new Date();
                today.setHours(0, 0, 0, 0);
                // Compare date-only due dates as calendar days in the user's timezone.
                const dueDays = task.due_date
                  ? calendarDaysFromToday(String(task.due_date), timezone || "Europe/Dublin")
                  : null;
                // The card badge follows the same overdue rule as the Overdue filter and the
                // dashboard count: a timed due date earlier today is already overdue.
                const dueStatus = dueDate
                  ? dueDays !== null
                    ? dueDays < 0 || isDueOverdue(String(task.due_date), timezone || "Europe/Dublin")
                      ? "overdue"
                      : dueDays === 0 ? "today" : "upcoming"
                    : dueDate < today
                      ? "overdue"
                      : dueDate.toDateString() === new Date().toDateString()
                        ? "today"
                        : "upcoming"
                  : null;
                const description = taskDescriptionPreview(task.description)
                return (
                  <KanbanTaskCard
                    task={task as Record<string, unknown>}
                    boardId={boardId}
                    locale={locale}
                    ticketKey={ticketKey}
                    priority={p}
                    priorityLabel={priorityLabels[p] ?? "Medium"}
                    priorityClass={priorityClasses[p] ?? "priority-medium"}
                    taskType={tt}
                    typeColor={tc.color}
                    promoted={promoted}
                    canEdit={canEdit}
                    canCreate={canCreate}
                    dateFormat={dateFormat}
                    timezone={timezone}
                    dueStatus={dueStatus}
                    description={description}
                    rice={rice}
                    childCount={childCount}
                    area={cardArea ?? null}
                    epicGroup={epicGroup}
                    assigneeKey={kanbanFilters.groupBy === "assigned" ? JSON.stringify(String(task.assigned_to ?? "")) : undefined}
                    projectGroup={projectGroup}
                    projectLabel={projectLabel}
                  />
                );
              })}
              {matches === 0 && (
                <div class="kanban-empty">
                  {t(!kanbanPages ? "kanban.board_load_failed" : laneTotal ? "kanban.no_matches" : "kanban.empty_lane", locale)}
                </div>
              )}
            </div>
            {lane && lane.pageCount > 1 && (
              <nav class="kanban-pagination" aria-label={t("kanban.pages_for_lane", locale, { lane: col.label })}>
                <span data-kanban-range tabindex="-1">
                  {t("kanban.page_range", locale, { start: String(lane.offset + 1), end: String(lane.offset + colTasks.length), count: String(matches) })}
                </span>
                <div class="kanban-page-actions">
                  {lane.page > 1 && <a class="btn btn-outline" href={lanePageHref(col.key, lane.page - 1)} rel="prev" data-kanban-page-lane={col.key} data-astro-prefetch="false">{t("kanban.previous_page", locale)}</a>}
                  {lane.page < lane.pageCount && <a class="btn btn-outline" href={lanePageHref(col.key, lane.page + 1)} rel="next" data-kanban-page-lane={col.key} data-astro-prefetch="false">{t("kanban.next_page", locale)}</a>}
                </div>
              </nav>
            )}
            {col.key === "backlog" && (
              <a
                href={`/deferred${boardAreaQuery}`}
                class="kanban-backlog-deferred-link"
                data-astro-prefetch="false"
              >
                <Icon name="clock" size={14} sprite />
                <span>{deferredCount > 0 ? `${t("deferral.title", locale)} (${deferredCount} parked)` : `${t("deferral.title", locale)} & stalled`}</span>
              </a>
            )}
            <button
              class="kanban-add-btn"
              data-status={col.key}
              disabled={!canCreate || (!canComplete && col.key === "complete")}
              aria-label={`Add task to ${col.label}`}
            >
              {t("kanban.add_task", locale)}
            </button>
          </div>
        );
      })
    }
    </div>
    <button
      type="button"
      class="kanban-scroll-btn kanban-scroll-btn--right"
      data-kanban-scroll="right"
      aria-label="Scroll lanes right"
      title="Scroll lanes right"
      hidden
    >
      <Icon name="chevron-down" size={18} class="kanban-scroll-icon--right" sprite />
    </button>
  </div>

    </div>

  </div><!-- /tasks-view-kanban -->
  </>}
  {renderedView === "table" && <TasksTableView
    tasks={tableTasks}
    creationTimezone={tableCreationTimezone}
    tableReadFailed={tableReadFailed}
    workflowColumns={workflowColumnsUnavailable ? [] : columns}
    workflowColumnsUnavailable={workflowColumnsUnavailable}
    canEdit={canEdit}
    canCreate={canCreate}
    canComplete={canComplete}
    canDelete={canDelete}
  />}
  {renderedView === "calendar" && <TasksCalendarView {scope} />}
  {renderedView === "timeline" && <TasksTimelineView {scope} />}

  </div>
  <p class="boards-workspace board-expired-banner" data-board-expired role="status" hidden>Board access changed. <button type="button" class="btn btn-ghost btn-sm" data-board-refresh>Refresh Board</button></p>
  <script>
    import { bindBoardPage } from "@lib/boards-page"
    import { initTasksViewSwitcher } from "@lib/tasks-view-controller"
    import { initAreaSelector } from "@lib/area-selector-controller"
    import { parseTaskView } from "@lib/task-view-route"
    import {
      initUnifiedBarNewTaskButton,
      initUnifiedBarSearchLauncher,
    } from "@lib/unified-bar-controller"
    import { createClientLogger } from "@lib/client-logger"
    import { pageLifecycle } from "@lib/page-lifecycle"

    const log = createClientLogger("tasks", "page-init")
    let fieldsPanelAbort: AbortController | null = null

    pageLifecycle.onPageLoad((signal) => {
      bindBoardPage(signal)
      const view = parseTaskView(document.querySelector<HTMLElement>("[data-task-view]")?.dataset.taskView ?? null)
      if (!view) return

      // Each init block is isolated with try/catch to prevent cascade failures.
      // If one controller throws (import failure, missing DOM, etc.), the rest still register.

      try {
        // Phase 16.1: Unified view switcher (kanban/table/calendar/timeline)
        initTasksViewSwitcher(view, signal)
      } catch (e) { log.error("view switcher init failed", e) }

      try {
        // Phase 16.2: Area/space context selector
        initAreaSelector(signal)
      } catch (e) { log.error("area selector init failed", e) }

      try {
        // The tasks page uses the unified bar for global actions, but view
        // switching is hash-based rather than page-shell section-based.
        initUnifiedBarSearchLauncher("kanban-bar")
        initUnifiedBarNewTaskButton({ barId: "kanban-bar" })
      } catch (e) { log.error("unified bar actions init failed", e) }

      if (view !== "kanban") return
      import("../lib/controllers/kanban-page-controller").then(({ initKanbanPage }) => {
        if (!signal.aborted) initKanbanPage(signal)
      }).catch(e => log.error("kanban area init failed", e))

      // ── Fields panel toggle ──────────────────────────────────────────────
      try {
        fieldsPanelAbort?.abort()
        fieldsPanelAbort = new AbortController()
        signal.addEventListener("abort", () => fieldsPanelAbort?.abort(), { once: true })
        const fieldsSignal = fieldsPanelAbort.signal
        const fieldsBtn = document.getElementById("toggle-fields-btn")
        const fieldsPanel = document.getElementById("kanban-fields-panel")

        // Ensure panel starts hidden (guards against HMR/dep-optimization reloads)
        fieldsPanel?.classList.add("hidden")

        const hideFieldsPanel = () => {
          fieldsPanel?.classList.add("hidden")
          fieldsBtn?.setAttribute("aria-expanded", "false")
        }

        fieldsBtn?.addEventListener("click", () => {
          const isHidden = fieldsPanel?.classList.toggle("hidden")
          fieldsBtn?.setAttribute("aria-expanded", String(!isHidden))
        }, { signal: fieldsSignal })

        // Close button inside the CardCustomizer panel (event delegation — robust against timing)
        fieldsPanel?.addEventListener("click", (e) => {
          if ((e.target as HTMLElement).closest("#card-customizer-close")) {
            e.stopPropagation()
            hideFieldsPanel()
            fieldsBtn?.focus()
          }
        }, { signal: fieldsSignal })

        // Click outside closes Fields panel
        document.addEventListener("click", (e) => {
          if (
            fieldsPanel && !fieldsPanel.classList.contains("hidden") &&
            !fieldsPanel.contains(e.target as Node) &&
            !fieldsBtn?.contains(e.target as Node)
          ) {
            hideFieldsPanel()
          }
        }, { signal: fieldsSignal })

        // Escape key closes Fields panel
        document.addEventListener("keydown", (e) => {
          if (e.key === "Escape" && fieldsPanel && !fieldsPanel.classList.contains("hidden")) {
            hideFieldsPanel()
            fieldsBtn?.focus()
          }
        }, { signal: fieldsSignal })
      } catch (e) { log.error("fields panel init failed", e) }

      // Lanes panel toggle handled by kanban-controller (inside initKanbanArea)
    })
  </script>
</WorkspaceShell>

