---
/**
 * StreakBadge — Displays current completion streak in sidebar/dashboard
 *
 * @domain gamification
 * @bounded-context gamification
 *
 * Clickable by default, navigating directly to Progress & Growth (#achievements-streaks).
 * Pass interactive={false} when wrapped inside a parent anchor link.
 */
import Icon from "../ui/Icon.astro"

interface Props {
  streak: number
  compact?: boolean
  href?: string
  interactive?: boolean
}

const {
  streak,
  compact = false,
  href = "/progress#achievements-streaks",
  interactive = true,
} = Astro.props

const dayWord = streak === 1 ? "day" : "days"
const badgeTitle = interactive
  ? `${streak} ${dayWord} streak — click to view Streaks & Progress`
  : `${streak} ${dayWord} streak`
const badgeClass = `streak-badge ${compact ? "streak-badge--compact" : ""} ${interactive ? "streak-badge--interactive" : ""}`
---

{streak > 0 && (
  interactive ? (
    <a
      href={href}
      class={badgeClass}
      title={badgeTitle}
      aria-label={`${streak} day completion streak — open Streaks & Progress`}
    >
      <span class="streak-badge__icon inline-flex items-center" aria-hidden="true">
        <Icon name="flame" size={compact ? 13 : 14} sprite={true} />
      </span>
      <span class="streak-badge__count">{streak}</span>
      {!compact && <span class="streak-badge__label">day streak</span>}
    </a>
  ) : (
    <div
      class={badgeClass}
      title={badgeTitle}
      aria-label={`${streak} day completion streak`}
    >
      <span class="streak-badge__icon inline-flex items-center" aria-hidden="true">
        <Icon name="flame" size={compact ? 13 : 14} sprite={true} />
      </span>
      <span class="streak-badge__count">{streak}</span>
      {!compact && <span class="streak-badge__label">day streak</span>}
    </div>
  )
)}

<style is:inline>
  .streak-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.25rem;
    padding: 0.25rem 0.625rem;
    border-radius: 9999px;
    font-size: 0.8125rem;
    font-weight: 600;
    background: linear-gradient(135deg, hsl(38 92% 50% / 0.15), hsl(15 85% 55% / 0.15));
    color: hsl(38 92% 45%);
    border: 1px solid hsl(38 92% 50% / 0.25);
    text-decoration: none;
    transition: transform 150ms cubic-bezier(0.23, 1, 0.32, 1),
      box-shadow 150ms cubic-bezier(0.23, 1, 0.32, 1),
      border-color 150ms cubic-bezier(0.23, 1, 0.32, 1);
    cursor: default;
  }

  .streak-badge--interactive {
    cursor: pointer;
  }

  .streak-badge--interactive:hover {
    transform: translateY(-1px);
    border-color: hsl(38 92% 50% / 0.55);
    box-shadow: 0 3px 10px hsl(38 92% 50% / 0.2);
  }

  .streak-badge--interactive:active {
    transform: scale(0.97);
  }

  .streak-badge--interactive:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }

  .streak-badge--compact {
    padding: 0.175rem 0.5rem;
    font-size: 0.75rem;
    gap: 0.2rem;
  }

  .streak-badge__icon {
    font-size: 1em;
    line-height: 1;
  }

  .streak-badge__count {
    font-weight: 700;
    font-variant-numeric: tabular-nums;
  }

  .streak-badge__label {
    font-weight: 500;
    opacity: 0.88;
    font-size: 0.75em;
  }

  :is([data-theme="dark"], [data-theme="knight-rider"]) .streak-badge {
    background: linear-gradient(135deg, hsl(38 70% 30% / 0.32), hsl(15 70% 35% / 0.32));
    color: hsl(38 85% 65%);
    border-color: hsl(38 70% 50% / 0.3);
  }

  @media (prefers-reduced-motion: reduce) {
    .streak-badge {
      transition: none;
    }
    .streak-badge--interactive:hover,
    .streak-badge--interactive:active {
      transform: none;
    }
  }
</style>
