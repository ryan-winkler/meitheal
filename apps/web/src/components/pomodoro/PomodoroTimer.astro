---
/**
 * PomodoroTimer — Floating pomodoro timer widget
 *
 * @domain pomodoro
 * @bounded-context pomodoro
 *
 * Provides a compact floating timer that:
 * 1. Shows circular countdown during focus/break phases
 * 2. Start/stop/skip controls
 * 3. Session counter (focus sessions completed)
 * 4. Collapsible to a minimal floating pill
 *
 * @kcs Rendered conditionally in Layout.astro when the `pomodoro` feature flag is enabled.
 * All interactions are client-side via fetch to /api/pomodoro.
 * Timer display updates every second via setInterval polling of local countdown.
 */

import Icon from "../ui/Icon.astro"
---

<div id="pomodoro-root" style="display: contents" transition:persist="pomodoro-timer">
<button
  type="button"
  id="pomodoro-pill"
  class="pomodoro-pill pomodoro-hidden"
  aria-expanded="false"
  aria-controls="pomodoro-panel"
  title="Pomodoro Timer"
>
  <span class="sr-only">Pomodoro timer </span>
  <span id="pomodoro-pill-icon" class="inline-flex items-center" aria-hidden="true"><Icon name="today" size={16} sprite={true} /></span>
  <span id="pomodoro-pill-time" class="pomodoro-pill__time">25:00</span>
</button>

<!-- Expanded timer panel -->
<div id="pomodoro-panel" class="pomodoro-panel pomodoro-hidden" role="dialog" aria-label="Pomodoro Timer">
  <div class="pomodoro-panel__header">
    <span class="pomodoro-panel__title inline-flex items-center gap-1.5"><Icon name="today" size={16} sprite={true} /> Pomodoro</span>
    <button type="button" id="pomodoro-collapse" class="pomodoro-panel__close" aria-label="Collapse timer">—</button>
  </div>

  <!-- Timer ring -->
  <div class="pomodoro-ring-wrapper">
    <svg viewBox="0 0 120 120" class="pomodoro-ring" aria-hidden="true">
      <circle cx="60" cy="60" r="52" class="pomodoro-ring__bg" />
      <circle cx="60" cy="60" r="52" id="pomodoro-ring-fill" class="pomodoro-ring__fill" />
    </svg>
    <div class="pomodoro-ring__content">
      <span id="pomodoro-time" class="pomodoro-time">25:00</span>
      <span id="pomodoro-phase" class="pomodoro-phase">Ready</span>
    </div>
  </div>

  <!-- Controls -->
  <div class="pomodoro-controls">
    <button type="button" id="pomodoro-start" class="pomodoro-btn pomodoro-btn--primary"><span aria-hidden="true">▶</span> <span>Start Focus</span></button>
    <button type="button" id="pomodoro-skip" class="pomodoro-btn pomodoro-btn--secondary pomodoro-hidden"><span aria-hidden="true">⏭</span> <span>Skip</span></button>
    <button type="button" id="pomodoro-cancel" class="pomodoro-btn pomodoro-btn--danger pomodoro-hidden"><Icon name="x" size={14} sprite={true} /> Cancel</button>
  </div>

  <!-- Session counter -->
  <div class="pomodoro-sessions">
    <span id="pomodoro-focus-count">0</span> focus sessions
    <span class="pomodoro-sessions__sep">·</span>
    <span id="pomodoro-today-minutes">0</span> min today
  </div>
</div>
</div>

<style>
  .pomodoro-hidden {
    display: none !important;
  }

  /* Floating pill */
  .pomodoro-pill {
    position: fixed;
    bottom: 24px;
    right: 24px;
    z-index: 45;
    display: flex;
    align-items: center;
    gap: 6px;
    padding: 8px 14px;
    background: var(--bg-card, #1a1a2e);
    border: 1px solid var(--border, #334155);
    border-radius: 24px;
    color: var(--text-primary, #e0e0e0);
    font-size: 0.8125rem;
    font-weight: 600;
    cursor: pointer;
    box-shadow: 0 4px 16px rgba(0, 0, 0, 0.3);
    transition: transform 0.15s, box-shadow 0.15s;
    font-variant-numeric: tabular-nums;
  }

  .pomodoro-pill:hover {
    transform: translateY(-2px);
    box-shadow: 0 6px 20px rgba(0, 0, 0, 0.4);
  }

  .pomodoro-pill--active {
    border-color: var(--accent);
    animation: pomodoro-pulse 2s ease-in-out infinite;
  }

  .pomodoro-pill--break {
    border-color: #10b981;
  }

  @keyframes pomodoro-pulse {
    0%, 100% { box-shadow: 0 4px 16px rgba(0, 0, 0, 0.3); }
    50% { box-shadow: 0 4px 16px color-mix(in srgb, var(--accent) 30%, transparent); }
  }

  /* Panel */
  .pomodoro-panel {
    position: fixed;
    bottom: 24px;
    right: 24px;
    z-index: 46;
    width: 240px;
    background: var(--bg-card, #1a1a2e);
    border: 1px solid var(--border, #334155);
    border-radius: 16px;
    box-shadow: 0 8px 32px rgba(0, 0, 0, 0.4);
    padding: 16px;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 12px;
  }

  .pomodoro-panel__header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    width: 100%;
  }

  .pomodoro-panel__title {
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--text-primary, #e0e0e0);
  }

  .pomodoro-panel__close {
    background: none;
    border: none;
    color: var(--text-muted, #888);
    cursor: pointer;
    font-size: 1rem;
    padding: 2px 6px;
    border-radius: 4px;
    transition: background 0.1s;
  }

  .pomodoro-panel__close:hover {
    background: var(--bg-hover, #1e293b);
  }

  /* Timer ring */
  .pomodoro-ring-wrapper {
    position: relative;
    width: 140px;
    height: 140px;
  }

  .pomodoro-ring {
    width: 100%;
    height: 100%;
    transform: rotate(-90deg);
  }

  .pomodoro-ring__bg {
    fill: none;
    stroke: var(--border, #334155);
    stroke-width: 5;
  }

  .pomodoro-ring__fill {
    fill: none;
    stroke: var(--accent);
    stroke-width: 5;
    stroke-linecap: round;
    transition: stroke-dashoffset 0.5s ease;
  }

  .pomodoro-ring__content {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    text-align: center;
    line-height: 1;
  }

  .pomodoro-time {
    font-size: 2rem;
    font-weight: 700;
    color: var(--text-primary, #e0e0e0);
    font-variant-numeric: tabular-nums;
    display: block;
  }

  .pomodoro-phase {
    font-size: 0.6875rem;
    color: var(--text-muted, #888);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    margin-top: 4px;
  }

  /* Controls */
  .pomodoro-controls {
    display: flex;
    gap: 6px;
    width: 100%;
  }

  .pomodoro-btn {
    flex: 1;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 4px;
    padding: 6px 10px;
    border: 1px solid var(--border, #334155);
    border-radius: 8px;
    font-size: 0.75rem;
    font-weight: 600;
    cursor: pointer;
    transition: background 0.15s, border-color 0.15s;
    white-space: nowrap;
  }

  .pomodoro-btn--primary {
    background: var(--accent);
    color: var(--personal-accent-foreground, var(--palette-on-accent, #07140f));
    border-color: var(--accent);
  }

  .pomodoro-btn--primary:hover {
    filter: brightness(1.1);
  }

  .pomodoro-btn--secondary {
    background: var(--bg-hover, #1e293b);
    color: var(--text-primary, #e0e0e0);
  }

  .pomodoro-btn--secondary:hover {
    background: var(--bg-input, #2a2a4a);
  }

  .pomodoro-btn--danger {
    background: transparent;
    color: var(--text-muted, #888);
    border-color: transparent;
  }

  .pomodoro-btn--danger:hover {
    color: var(--danger-text);
    border-color: var(--danger);
  }

  /* Sessions */
  .pomodoro-sessions {
    font-size: 0.6875rem;
    color: var(--text-muted, #888);
    text-align: center;
  }

  .pomodoro-sessions__sep {
    margin: 0 4px;
    opacity: 0.5;
  }

  /* HA ingress: adjust positioning */
  :global(body.ha-ingress) .pomodoro-pill,
  :global(body.ha-ingress) .pomodoro-panel {
    bottom: 16px;
    right: 16px;
  }

  @media (max-width: 768px) {
    .pomodoro-pill,
    .pomodoro-panel,
    :global(body.ha-ingress) .pomodoro-pill,
    :global(body.ha-ingress) .pomodoro-panel {
      bottom: var(--floating-action-bottom);
      right: calc(12px + env(safe-area-inset-right, 0px));
    }
  }

  /* Reduced motion */
  @media (prefers-reduced-motion: reduce) {
    .pomodoro-pill--active {
      animation: none;
    }
  }

  @media (max-width: 768px), (pointer: coarse) {
    .pomodoro-panel__close {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      min-width: 44px;
      min-height: 44px;
    }
  }
</style>

<script>
  import { canRestoreFocusTarget } from "@lib/dialog-overlay"
  import { renderSpriteIconSvg } from "../../generated/icon-registry"

  const CIRCUMFERENCE = 2 * Math.PI * 52

  interface PomodoroEls {
    pill: HTMLButtonElement | null
    pillTime: HTMLElement | null
    pillIcon: HTMLElement | null
    panel: HTMLElement | null
    collapseBtn: HTMLButtonElement | null
    timeDisplay: HTMLElement | null
    phaseDisplay: HTMLElement | null
    ringFill: HTMLElement | null
    startBtn: HTMLButtonElement | null
    skipBtn: HTMLButtonElement | null
    cancelBtn: HTMLButtonElement | null
    focusCountEl: HTMLElement | null
    todayMinutesEl: HTMLElement | null
  }

  let boundRoot: HTMLElement | null = null
  let rootAc: AbortController | null = null
  let els: PomodoroEls | null = null
  let expanded = false
  let localRemaining = 0
  let localTotal = 0
  let localPhase = "idle"
  let lastPillIcon = ""
  let openerFocus: HTMLElement | null = null
  let tickInterval: ReturnType<typeof setInterval> | null = null

  function formatTime(seconds: number): string {
    return `${Math.floor(seconds / 60)}:${(seconds % 60).toString().padStart(2, "0")}`
  }

  function notifyLayoutChanged(): void {
    document.dispatchEvent(new Event("meitheal:layout-changed"))
  }

  function updateDisplay() {
    if (!els) return
    const timeStr = formatTime(localRemaining)
    if (els.timeDisplay) els.timeDisplay.textContent = timeStr
    if (els.pillTime) els.pillTime.textContent = timeStr
    const phaseLabels: Record<string, string> = {
      focus: "Focus",
      short_break: "Short Break",
      long_break: "Long Break",
      idle: "Ready",
    }
    if (els.phaseDisplay) els.phaseDisplay.textContent = phaseLabels[localPhase] || "Ready"
    if (els.ringFill && localTotal > 0) {
      els.ringFill.style.strokeDasharray = String(CIRCUMFERENCE)
      els.ringFill.style.strokeDashoffset = String(CIRCUMFERENCE * (localRemaining / localTotal))
      els.ringFill.style.stroke =
        localPhase === "short_break" || localPhase === "long_break" ? "#10b981" : ""
    }
    if (els.pill) {
      els.pill.classList.toggle("pomodoro-pill--active", localPhase === "focus")
      els.pill.classList.toggle("pomodoro-pill--break", localPhase.includes("break"))
      if (els.pillIcon) {
        const iconName = localPhase.includes("break") ? "mug" : "today"
        if (iconName !== lastPillIcon) {
          lastPillIcon = iconName
          els.pillIcon.innerHTML = renderSpriteIconSvg(iconName, { size: 16 })
        }
      }
    }
    if (els.startBtn && els.skipBtn && els.cancelBtn) {
      const idle = localPhase === "idle"
      const active = document.activeElement
      const nextFocus = !idle && active === els.startBtn
        ? els.skipBtn
        : idle && (active === els.skipBtn || active === els.cancelBtn)
          ? els.startBtn
          : null
      const setLabel = (btn: HTMLElement, text: string) => {
        if (btn.lastElementChild) btn.lastElementChild.textContent = text
      }
      els.startBtn.classList.toggle("pomodoro-hidden", !idle)
      setLabel(els.startBtn, "Start Focus")
      els.skipBtn.classList.toggle("pomodoro-hidden", idle)
      setLabel(els.skipBtn, localPhase === "focus" ? "Skip to break" : "Skip break")
      els.cancelBtn.classList.toggle("pomodoro-hidden", idle)
      if (nextFocus) {
        (nextFocus.classList.contains("pomodoro-hidden") ? els.collapseBtn : nextFocus)?.focus({ preventScroll: true })
      }
    }
  }

  function stopLocalTick() {
    if (tickInterval) {
      clearInterval(tickInterval)
      tickInterval = null
    }
  }

  function startLocalTick() {
    stopLocalTick()
    tickInterval = setInterval(() => {
      if (!boundRoot?.isConnected) {
        stopLocalTick()
        return
      }
      if (localRemaining > 0) {
        localRemaining--
        updateDisplay()
      } else {
        stopLocalTick()
        void runRequest("/api/pomodoro")
      }
    }, 1000)
  }

  async function runRequest(url: string, init?: RequestInit, includeToday = true) {
    const activeRoot = boundRoot
    if (!activeRoot?.isConnected) return
    try {
      const res = await fetch(url, init)
      if (!res.ok || boundRoot !== activeRoot || !activeRoot.isConnected || !els) return
      const data = await res.json()
      const state = data.state
      localRemaining = state.remaining || 0
      localTotal = state.total || 0
      localPhase = state.phase || "idle"
      if (includeToday) {
        if (els.focusCountEl) els.focusCountEl.textContent = String(state.focusCount || 0)
        if (els.todayMinutesEl) els.todayMinutesEl.textContent = String(data.today?.totalFocusMinutes || 0)
      }
      updateDisplay()
      if (localPhase !== "idle") startLocalTick()
      else stopLocalTick()
      if (els.pill && !expanded) els.pill.classList.toggle("pomodoro-hidden", localPhase === "idle")
      notifyLayoutChanged()
    } catch {
      // Non-critical
    }
  }

  const doAction = (action: string, taskId?: string) =>
    runRequest("/api/pomodoro", {
      method: "POST",
      headers: { "content-type": "application/json" },
      body: JSON.stringify(taskId ? { action, taskId } : { action }),
    }, false)

  function togglePanel(show: boolean) {
    const wasInsidePanel = Boolean(els?.panel?.contains(document.activeElement))
    if (show && !expanded && !wasInsidePanel) {
      openerFocus = document.activeElement instanceof HTMLElement ? document.activeElement : null
    }
    expanded = show
    els?.panel?.classList.toggle("pomodoro-hidden", !show)
    els?.pill?.classList.toggle("pomodoro-hidden", show || localPhase === "idle")
    els?.pill?.setAttribute("aria-expanded", String(show))
    if (show) {
      els?.panel?.querySelector<HTMLElement>("button:not(.pomodoro-hidden)")?.focus({ preventScroll: true })
    } else {
      if (wasInsidePanel) {
        if (els?.pill && !els.pill.classList.contains("pomodoro-hidden")) {
          els.pill.focus({ preventScroll: true })
        } else if (canRestoreFocusTarget(openerFocus)) {
          openerFocus.focus({ preventScroll: true })
        }
      }
      openerFocus = null
    }
    notifyLayoutChanged()
  }

  function teardownPomodoroMount() {
    stopLocalTick()
    rootAc?.abort()
    rootAc = null
    boundRoot = null
    els = null
    expanded = false
    openerFocus = null
    lastPillIcon = ""
    delete window.startPomodoro
  }

  function syncPomodoroMount() {
    const root = document.getElementById("pomodoro-root")
    if (!root) {
      teardownPomodoroMount()
      notifyLayoutChanged()
      return
    }
    if (root === boundRoot) return

    teardownPomodoroMount()
    boundRoot = root
    rootAc = new AbortController()
    const { signal } = rootAc
    const q = <T extends HTMLElement = HTMLElement>(id: string) => root.querySelector<T>(`#${id}`)

    els = {
      pill: q<HTMLButtonElement>("pomodoro-pill"),
      pillTime: q("pomodoro-pill-time"),
      pillIcon: q("pomodoro-pill-icon"),
      panel: q("pomodoro-panel"),
      collapseBtn: q<HTMLButtonElement>("pomodoro-collapse"),
      timeDisplay: q("pomodoro-time"),
      phaseDisplay: q("pomodoro-phase"),
      ringFill: q("pomodoro-ring-fill"),
      startBtn: q<HTMLButtonElement>("pomodoro-start"),
      skipBtn: q<HTMLButtonElement>("pomodoro-skip"),
      cancelBtn: q<HTMLButtonElement>("pomodoro-cancel"),
      focusCountEl: q("pomodoro-focus-count"),
      todayMinutesEl: q("pomodoro-today-minutes"),
    }

    els.pill?.addEventListener("click", () => togglePanel(true), { signal })
    els.collapseBtn?.addEventListener("click", () => togglePanel(false), { signal })
    els.panel?.addEventListener("keydown", (e) => {
      if (e.key === "Escape") {
        e.preventDefault()
        e.stopPropagation()
        togglePanel(false)
      }
    }, { signal })
    els.startBtn?.addEventListener("click", () => void doAction("start"), { signal })
    els.skipBtn?.addEventListener("click", () => void doAction(localPhase === "focus" ? "skip_to_break" : "skip_break"), { signal })
    els.cancelBtn?.addEventListener("click", () => void doAction("cancel"), { signal })

    document.addEventListener("keydown", (e) => {
      if (e.altKey && e.key === "p") {
        e.preventDefault()
        togglePanel(!expanded)
      }
    }, { signal })

    window.startPomodoro = (taskId?: string) => {
      togglePanel(true)
      void doAction("start", taskId)
    }

    void runRequest("/api/pomodoro")
  }

  window.__pomodoroGlobalAc?.abort()
  const globalAc = new AbortController()
  window.__pomodoroGlobalAc = globalAc
  globalAc.signal.addEventListener("abort", teardownPomodoroMount, { once: true })
  document.addEventListener("astro:page-load", syncPomodoroMount, { signal: globalAc.signal })
  syncPomodoroMount()
</script>
