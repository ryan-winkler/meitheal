---
/**
 * ErrorState — Reusable error/empty state component
 *
 * Renders a centered card with icon, title, description, and optional retry button.
 * Use for API failures, empty lists, or error boundaries.
 *
 * @domain ui
 * @phase 25 — Client-Side Resilience
 *
 * @example
 * ```astro
 * <ErrorState
 *   icon="⚠️"
 *   title="Failed to load tasks"
 *   description="Check your connection and try again."
 *   retryLabel="Retry"
 *   retryId="retry-tasks-btn"
 * />
 * ```
 */

export interface Props {
  /** Emoji or text icon to display */
  icon?: string
  /** Main heading */
  title: string
  /** Supporting description */
  description?: string
  /** Text for the retry button (omit to hide) */
  retryLabel?: string
  /** ID for the retry button (for JS handlers) */
  retryId?: string
  /** Optional docs/help link */
  helpUrl?: string
  /** Optional help link text */
  helpLabel?: string
  /** Size variant */
  size?: "sm" | "md" | "lg"
}

const {
  icon = "⚠️",
  title,
  description,
  retryLabel,
  retryId,
  helpUrl,
  helpLabel = "Learn more",
  size = "md",
} = Astro.props
---

<div class={`error-state error-state--${size}`} role="status">
  <div class="error-state__icon">{icon}</div>
  <h3 class="error-state__title">{title}</h3>
  {description && <p class="error-state__desc">{description}</p>}
  <div class="error-state__actions">
    {retryLabel && (
      <button
        type="button"
        class="error-state__retry btn btn-primary"
        id={retryId}
      >
        ↻ {retryLabel}
      </button>
    )}
    {helpUrl && (
      <a
        href={helpUrl}
        class="error-state__help"
        target="_blank"
        rel="noopener noreferrer"
      >
        {helpLabel} →
      </a>
    )}
  </div>
</div>

<style>
  @reference "../../styles/global.css";

  .error-state {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
    border: 1px dashed var(--border);
    border-radius: var(--radius-lg, 12px);
    background: var(--bg-card);
  }

  .error-state--sm {
    padding: 1.5rem 1rem;
    gap: 0.5rem;
  }
  .error-state--md {
    padding: 3rem 2rem;
    gap: 0.75rem;
  }
  .error-state--lg {
    padding: 4rem 2rem;
    gap: 1rem;
  }

  .error-state__icon {
    font-size: 2.5rem;
    line-height: 1;
    opacity: 0.8;
  }
  .error-state--sm .error-state__icon {
    font-size: 1.75rem;
  }
  .error-state--lg .error-state__icon {
    font-size: 3rem;
  }

  .error-state__title {
    font-size: 1.125rem;
    font-weight: 600;
    color: var(--text-primary);
    margin: 0;
    line-height: 1.3;
  }
  .error-state--sm .error-state__title {
    font-size: 0.875rem;
  }

  .error-state__desc {
    font-size: 0.8125rem;
    color: var(--text-muted);
    max-width: 360px;
    line-height: 1.5;
    margin: 0;
  }
  .error-state--sm .error-state__desc {
    font-size: 0.75rem;
  }

  .error-state__actions {
    display: flex;
    align-items: center;
    gap: 1rem;
    margin-top: 0.5rem;
  }

  .error-state__retry {
    padding: 0.375rem 0.875rem;
    font-size: 0.8125rem;
    font-weight: 600;
  }

  .error-state__help {
    font-size: 0.75rem;
    color: var(--accent);
    text-decoration: none;
    transition: opacity 150ms;
  }
  .error-state__help:hover {
    opacity: 0.8;
    text-decoration: underline;
  }

  /* Subtle entrance animation */
  .error-state {
    animation: error-state-in 300ms ease-out;
  }
  @keyframes error-state-in {
    from {
      opacity: 0;
      transform: translateY(8px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .error-state {
      animation: none;
    }
  }
</style>
