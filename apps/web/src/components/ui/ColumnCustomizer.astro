---
/**
 * ColumnCustomizer — Column visibility and ordering control for table view
 *
 * @domain tasks
 * @bounded-context tasks/ui
 *
 * Renders a dropdown panel with:
 * - Checkbox list of available columns
 * - Drag-to-reorder (future enhancement)
 * - Reset to defaults button
 * - Persists preferences to localStorage
 *
 * Emits `meitheal:columns-change` CustomEvent when column visibility changes.
 */
interface Props {
  class?: string
}
const { class: className } = Astro.props
---

<div class={`column-customizer ${className ?? ''}`}>
  <button
    type="button"
    class="column-customizer__toggle"
    id="column-customizer-toggle"
    title="Customize Columns"
    aria-label="Customize visible columns"
    aria-expanded="false"
    aria-controls="column-customizer-panel"
  >
    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-columns-3"><rect width="18" height="18" x="3" y="3" rx="2"/><path d="M9 3v18"/><path d="M15 3v18"/></svg>
    <span class="column-customizer__label">Columns</span>
  </button>

  <div class="column-customizer__panel hidden" id="column-customizer-panel" role="region" aria-label="Column Visibility">
    <div class="column-customizer__header">
      <h4>Visible Columns</h4>
      <button type="button" class="btn-icon" id="column-customizer-close" aria-label="Close panel">
        <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 6 6 18"/><path d="m6 6 12 12"/></svg>
      </button>
    </div>

    <ul class="column-customizer__list" id="column-customizer-list">
      <!-- Populated by JS from the actual table columns -->
    </ul>

    <div class="column-customizer__footer">
      <button type="button" class="btn text-xs" id="column-customizer-reset">
        Reset to Defaults
      </button>
    </div>
  </div>
</div>

<script>
  import { loadTableFilterState } from "@lib/filter-state"
  import { pageLifecycle } from "@lib/page-lifecycle"
  import { loadTableColumnPreferences, TABLE_COLUMNS, TABLE_COLUMN_PREFS_KEY } from "@lib/table-registry"

  pageLifecycle.onPageLoad(signal => {
    const wrapper = document.querySelector<HTMLElement>(".column-customizer")
    const toggle = wrapper?.querySelector<HTMLButtonElement>("#column-customizer-toggle")
    const panel = wrapper?.querySelector<HTMLElement>("#column-customizer-panel")
    const list = wrapper?.querySelector<HTMLUListElement>("#column-customizer-list")
    const closeBtn = wrapper?.querySelector<HTMLButtonElement>("#column-customizer-close")
    const resetBtn = wrapper?.querySelector<HTMLButtonElement>("#column-customizer-reset")
    if (!wrapper || !toggle || !panel || !list || !closeBtn || !resetBtn || wrapper.dataset.initialized) return
    wrapper.dataset.initialized = "true"
    signal.addEventListener("abort", () => { delete wrapper.dataset.initialized }, { once: true })

    function close(restoreFocus = false) {
      toggle!.setAttribute("aria-expanded", "false")
      if (typeof panel!.hidePopover === "function" && panel!.matches(":popover-open")) panel!.hidePopover()
      panel!.removeAttribute("popover")
      panel!.classList.add("hidden")
      if (restoreFocus) toggle!.focus()
    }

    function updateColumns(visible: string[]) {
      try {
        localStorage.setItem(TABLE_COLUMN_PREFS_KEY, JSON.stringify(Object.fromEntries(
          TABLE_COLUMNS.map(column => [column.id, visible.includes(column.id)]),
        )))
      } catch { /* storage unavailable */ }
      document.dispatchEvent(new CustomEvent("meitheal:columns-change", { detail: { visible } }))
    }

    function render() {
      const visible = loadTableFilterState().columns ?? loadTableColumnPreferences()
      list!.replaceChildren(...TABLE_COLUMNS.map(column => {
        const item = document.createElement("li")
        item.className = "column-customizer__item"
        const label = document.createElement("label")
        label.className = "column-customizer__label"
        const checkbox = document.createElement("input")
        checkbox.type = "checkbox"
        checkbox.dataset.colId = column.id
        checkbox.checked = visible.includes(column.id)
        checkbox.disabled = column.id === "title"
        label.append(checkbox, column.label)
        item.append(label)
        return item
      }))
    }

    toggle.addEventListener("click", () => {
      if (toggle.getAttribute("aria-expanded") === "true") {
        close()
        return
      }
      render()
      toggle.setAttribute("aria-expanded", "true")
      panel.classList.remove("hidden")
      if (matchMedia("(max-width: 540px)").matches && typeof panel.showPopover === "function") {
        panel.setAttribute("popover", "manual")
        panel.showPopover()
      }
    }, { signal })
    closeBtn.addEventListener("click", () => close(true), { signal })
    list.addEventListener("change", () => {
      const visible = [...list.querySelectorAll<HTMLInputElement>("input:checked")].map(input => input.dataset.colId ?? "")
      updateColumns(visible)
    }, { signal })
    resetBtn.addEventListener("click", () => {
      updateColumns(TABLE_COLUMNS.map(column => column.id))
      render()
    }, { signal })
    wrapper.addEventListener("keydown", event => {
      if (event.key !== "Escape" || panel.classList.contains("hidden")) return
      event.preventDefault()
      event.stopPropagation()
      close(true)
    }, { signal })
    document.addEventListener("click", event => {
      if (!wrapper.contains(event.target as Node)) close()
    }, { signal })
  })
</script>
