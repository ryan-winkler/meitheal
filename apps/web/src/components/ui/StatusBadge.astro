---
import { normalizeStatus, STATUS_LABELS } from "../../lib/status-config"

interface Props {
  status: string | null | undefined
}

const { status } = Astro.props
const normalizedStatus = normalizeStatus(status || "")
const label = STATUS_LABELS[normalizedStatus] || STATUS_LABELS.backlog
---

<span
  class="status-badge inline-flex items-center px-2 py-0.5 rounded text-[11px] font-medium transition-colors border max-w-fit w-fit"
  data-badge-status={normalizedStatus}
>
  {label}
</span>

<style>
  .status-badge {
    color: var(--text-primary);
    color: color-mix(in srgb, var(--text-primary) 60%, rgb(var(--status-badge-rgb, var(--text-primary-rgb))));
    background-color: rgb(var(--status-badge-rgb) / 0.1);
    border-color: rgb(var(--status-badge-rgb) / 0.2);
  }

  .status-badge:hover { background-color: rgb(var(--status-badge-rgb) / 0.15); }

  [data-badge-status="backlog"] { --status-badge-rgb: var(--text-muted-rgb); }
  [data-badge-status="pending"] { --status-badge-rgb: var(--info-rgb); }
  [data-badge-status="active"] { --status-badge-rgb: var(--accent-rgb); }
  [data-badge-status="complete"] { --status-badge-rgb: var(--success-rgb); }
</style>
