---
/**
 * HierarchyBreadcrumb — Shows a task's position in the hierarchy
 *
 * Renders a compact breadcrumb trail: Area → Goal → Project → Task
 * Used in task detail views and parent page sections to provide
 * navigation context within the hierarchy.
 *
 * @domain navigation
 * @phase 15 — Hierarchy Architecture Overhaul
 *
 * Usage:
 *   <HierarchyBreadcrumb
 *     areaName="Home"
 *     goalName="Health & Wellness"
 *     projectName="Morning Routine"
 *   />
 */

interface Props {
  /** Area name (top-level, optional) */
  areaName?: string | null
  /** Goal name (optional) */
  goalName?: string | null
  /** Project name (optional) */
  projectName?: string | null
  /** Compact mode — single-line with smaller text */
  compact?: boolean
}

const { areaName, goalName, projectName, compact = false } = Astro.props

// Build breadcrumb segments (only show non-null, non-empty ones)
const segments: Array<{ label: string; icon: string }> = []

if (areaName) segments.push({ label: areaName, icon: "🏠" })
if (goalName) segments.push({ label: goalName, icon: "🎯" })
if (projectName) segments.push({ label: projectName, icon: "📁" })
---

{segments.length > 0 && (
  <nav
    class={`hierarchy-breadcrumb ${compact ? "hierarchy-breadcrumb--compact" : ""}`}
    aria-label="Hierarchy location"
  >
    {segments.map((seg, i) => (
      <>
        {i > 0 && <span class="hierarchy-breadcrumb__sep" aria-hidden="true">›</span>}
        <span class="hierarchy-breadcrumb__segment">
          <span class="hierarchy-breadcrumb__icon" aria-hidden="true">{seg.icon}</span>
          <span class="hierarchy-breadcrumb__label">{seg.label}</span>
        </span>
      </>
    ))}
  </nav>
)}

<style>
  .hierarchy-breadcrumb {
    display: inline-flex;
    align-items: center;
    gap: 0.25rem;
    font-size: 0.75rem;
    color: var(--text-muted);
    line-height: 1;
    flex-wrap: wrap;
  }

  .hierarchy-breadcrumb--compact {
    font-size: 0.6875rem;
    gap: 0.125rem;
  }

  .hierarchy-breadcrumb__segment {
    display: inline-flex;
    align-items: center;
    gap: 0.125rem;
    padding: 0.125rem 0.375rem;
    background: rgb(var(--accent-rgb, 105 227 178) / 0.06);
    border-radius: 4px;
    transition: background 150ms ease;
  }

  .hierarchy-breadcrumb__segment:hover {
    background: rgb(var(--accent-rgb, 105 227 178) / 0.12);
  }

  .hierarchy-breadcrumb__icon {
    font-size: 0.625rem;
    line-height: 1;
  }

  .hierarchy-breadcrumb--compact .hierarchy-breadcrumb__icon {
    font-size: 0.5625rem;
  }

  .hierarchy-breadcrumb__label {
    max-width: 12ch;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .hierarchy-breadcrumb__sep {
    color: var(--text-muted);
    opacity: 0.4;
    font-size: 0.625rem;
  }
</style>
