---
import { getCachedHtmlSlot, setCachedHtmlSlot } from "../../lib/cached-html-slot-store"

interface Props {
  cacheKey?: string | null | undefined
}

const { cacheKey } = Astro.props
let htmlOutput: string

if (cacheKey) {
  const existing = getCachedHtmlSlot(cacheKey)
  if (existing) {
    if (existing.icons.length > 0) {
      const target = (Astro.locals.usedIcons ??= new Set())
      for (const icon of existing.icons) target.add(icon)
    }
    htmlOutput = existing.html
  } else {
    const rendered = String((await Astro.slots.render("default")) ?? "")
    const entry = setCachedHtmlSlot(cacheKey, rendered)
    if (entry.icons.length > 0) {
      const target = (Astro.locals.usedIcons ??= new Set())
      for (const icon of entry.icons) target.add(icon)
    }
    htmlOutput = rendered
  }
} else {
  htmlOutput = String((await Astro.slots.render("default")) ?? "")
}
---
<Fragment set:html={htmlOutput} />
