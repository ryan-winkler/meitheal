---
import { getCachedIconSpriteHtml } from "../../lib/cached-html-slot-store"

const locals = Astro.locals
const lazySprites = {
  [Symbol.for("astro:html-string")]: true,
  toString(): string {
    return getCachedIconSpriteHtml(locals.usedIcons)
  },
} as unknown as string
---

<Fragment set:html={lazySprites} />
