---
/*
 * Build-extracted 1.75px outline paths from @tabler/icons
 * https://github.com/tabler/tabler-icons
 *
 * MIT License — Copyright (c) 2020-2026 Paweł Kuna
 */
import {
  ICON_INNER_SVG,
  resolveCanonicalIconName,
  type IconName,
} from "../../generated/icon-registry"

export interface Props {
  name: IconName
  class?: string | undefined
  size?: number | undefined
  strokeWidth?: number | undefined
  sprite?: boolean | undefined
}

const {
  name,
  class: className = "",
  size = 20,
  strokeWidth = 1.75,
  sprite = false,
} = Astro.props

const canonical = resolveCanonicalIconName(name)
if (sprite) {
  ;(Astro.locals.usedIcons ??= new Set()).add(canonical)
}
---

<svg
  xmlns="http://www.w3.org/2000/svg"
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width={strokeWidth}
  stroke-linecap="round"
  stroke-linejoin="round"
  vector-effect="non-scaling-stroke"
  class={className || undefined}
  aria-hidden="true"
  role="img"
>
  {sprite ? (
    <use href={"#mt-icon-" + canonical} />
  ) : (
    <Fragment set:html={ICON_INNER_SVG[canonical]} />
  )}
</svg>
