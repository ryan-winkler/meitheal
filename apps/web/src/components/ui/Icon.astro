---
/*
 * Build-extracted 1.75px outline paths from @tabler/icons
 * https://github.com/tabler/tabler-icons
 *
 * MIT License — Copyright (c) 2020-2026 Paweł Kuna
 */
import {
  ICON_INNER_SVG,
  resolveCanonicalIconName,
  type IconName,
} from "../../generated/icon-registry"
import { escapeHtml } from "../../lib/escape-html"

export interface Props {
  name: IconName
  class?: string | undefined
  size?: number | undefined
  strokeWidth?: number | undefined
  sprite?: boolean | undefined
}

const {
  name,
  class: className = "",
  size = 20,
  strokeWidth = 1.75,
  sprite = false,
} = Astro.props

const canonical = resolveCanonicalIconName(name)
if (sprite) {
  ;(Astro.locals.usedIcons ??= new Set()).add(canonical)
}

const w = Number.isFinite(Number(size)) ? Number(size) : 20
const sw = Number.isFinite(Number(strokeWidth)) ? Number(strokeWidth) : 1.75
const clsAttr = className ? ` class="${escapeHtml(className)}"` : ""
const inner = sprite
  ? `<use href="#mt-icon-${escapeHtml(canonical)}"></use>`
  : ICON_INNER_SVG[canonical]
const svgHtml = `<svg xmlns="http://www.w3.org/2000/svg" width="${w}" height="${w}" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="${sw}" stroke-linecap="round" stroke-linejoin="round" vector-effect="non-scaling-stroke"${clsAttr} aria-hidden="true" role="img">${inner}</svg>`
---

<Fragment set:html={svgHtml} />
