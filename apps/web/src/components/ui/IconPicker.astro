---
/**
 * IconPicker — shared emoji grid + custom SVG/PNG upload component
 *
 * Self-contained: renders a clickable trigger/preview and its dropdown panel.
 * The dropdown uses DropdownController for viewport-safe positioning.
 *
 * Features:
 * - Clickable trigger showing current icon
 * - 5-category emoji grid with tab switching
 * - SVG/PNG upload with validation (64KB max, 128×128px max)
 * - SVG sanitization (strips scripts, event handlers)
 * - Works inside modals (z-index 10002)
 *
 * @domain shared/ui
 * @phase 17C — Shared Pickers
 */
import { EMOJI_CATEGORIES } from "../../lib/emoji-picker-data"
import { t, getClientLocale } from "../../lib/i18n"

export interface Props {
  /** Unique id for this picker instance */
  id: string
  /** Current icon value (emoji string or data URI) */
  value?: string
  /** Locale for i18n */
  locale?: "en" | "ga"
}

const { id, value = "📋", locale = "en" } = Astro.props
---

<!-- Trigger / Preview button -->
<div class="icon-picker-wrapper" id={`${id}-wrapper`}>
  <button
    type="button"
    class="icon-picker__trigger"
    id={`${id}-trigger`}
    aria-haspopup="dialog"
    aria-expanded="false"
    title={t("picker.choose_icon", locale)}
    aria-label={t("picker.choose_icon", locale)}
  >
    <span class="icon-picker__preview-icon">{value}</span>
  </button>

  <!-- Dropdown Panel (hidden, positioned via DropdownController) -->
  <div class="icon-picker" id={id} hidden>
    <div class="icon-picker__section">
      <label class="icon-picker__label">{t("picker.icon_label", locale)}</label>
      <div class="icon-picker__preview-row">
        <span data-icon-preview class="icon-picker__selected">{value}</span>
        <input type="hidden" data-icon-value value={value} />
        <button
          type="button"
          class="icon-picker__upload-btn"
          data-icon-upload-trigger
          title={t("picker.upload_icon", locale)}
          aria-label={t("picker.upload_icon", locale)}
        >
          <svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true">
            <path d="M8 1v10M4 5l4-4 4 4M2 13h12" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
          <span>{t("picker.upload_short", locale)}</span>
        </button>
        <input
          type="file"
          data-icon-upload
          accept=".svg,.png,image/svg+xml,image/png"
          hidden
          aria-hidden="true"
        />
      </div>
    </div>

    <div class="icon-picker__tabs">
      {EMOJI_CATEGORIES.map((cat, i) => (
        <button
          type="button"
          class={`icon-picker__tab ${i === 0 ? "active" : ""}`}
          data-emoji-tab={String(i)}
          title={cat.label}
          aria-label={`${cat.label} emoji`}
        >{cat.emoji[0]}</button>
      ))}
    </div>

    <div class="icon-picker__grid">
      {EMOJI_CATEGORIES.map((cat, catIdx) => (
        <div
          class={`icon-picker__panel ${catIdx === 0 ? "" : "hidden"}`}
          data-emoji-panel={String(catIdx)}
        >
          {cat.emoji.map((e) => (
            <button
              type="button"
              class={`icon-picker__emoji ${e === value ? "selected" : ""}`}
              data-emoji-value={e}
              title={e}
              aria-label={`Select ${e}`}
            >{e}</button>
          ))}
        </div>
      ))}
    </div>
  </div>
</div>

<style>
  /* Trigger button — inline preview of current icon */
  .icon-picker-wrapper {
    position: relative;
    display: inline-block;
  }

  .icon-picker__trigger {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 2.75rem;
    height: 2.75rem;
    background: var(--bg-input, rgb(var(--border-rgb) / 0.08));
    border: 1px solid var(--border);
    border-radius: var(--radius-sm, 6px);
    cursor: pointer;
    transition: border-color 150ms, transform 150ms;
    padding: 0;
  }
  .icon-picker__trigger:hover {
    border-color: var(--accent);
    transform: scale(1.05);
  }
  .icon-picker__trigger:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 1px;
  }

  .icon-picker__preview-icon {
    font-size: 1.5rem;
    line-height: 1;
  }

  /* Dropdown panel — positioned by DropdownController */
  .icon-picker {
    position: fixed;
    z-index: 10002;
    min-width: 240px;
    max-width: 300px;
    background: var(--bg-surface, #1e1e2e);
    border: 1px solid rgb(var(--border-rgb) / 0.5);
    border-radius: var(--radius-md, 8px);
    box-shadow: 0 12px 36px rgba(0, 0, 0, 0.5);
    padding: 14px;
    display: flex;
    flex-direction: column;
    gap: 10px;
    animation: icon-picker-in 120ms ease-out;
  }
  .icon-picker[hidden] { display: none; }

  @keyframes icon-picker-in {
    from { opacity: 0; transform: translateY(-4px) scale(0.97); }
    to { opacity: 1; transform: translateY(0) scale(1); }
  }

  .icon-picker__section {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .icon-picker__label {
    font-size: 10px;
    font-weight: 700;
    color: var(--text-muted);
    text-transform: uppercase;
    letter-spacing: 0.06em;
    opacity: 0.7;
  }

  .icon-picker__preview-row {
    display: flex;
    align-items: center;
    gap: 10px;
  }

  .icon-picker__selected {
    font-size: 28px;
    width: 44px;
    height: 44px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: rgb(var(--border-rgb) / 0.1);
    border-radius: var(--radius-md, 8px);
    border: 1px solid rgb(var(--border-rgb) / 0.2);
    transition: border-color 200ms;
    flex-shrink: 0;
    overflow: hidden;
  }
  .icon-picker__selected:hover { border-color: var(--accent); }

  .icon-picker__upload-btn {
    display: flex;
    align-items: center;
    gap: 4px;
    padding: 5px 10px;
    background: rgb(var(--border-rgb) / 0.1);
    border: 1px solid rgb(var(--border-rgb) / 0.2);
    border-radius: var(--radius-sm, 4px);
    color: var(--text-muted);
    font-size: 11px;
    cursor: pointer;
    transition: background 150ms, color 150ms, border-color 150ms;
  }
  .icon-picker__upload-btn:hover {
    background: rgb(var(--accent-rgb) / 0.1);
    color: var(--accent);
    border-color: rgb(var(--accent-rgb) / 0.3);
  }

  .icon-picker__tabs {
    display: flex;
    gap: 2px;
    border-bottom: 1px solid rgb(var(--border-rgb) / 0.2);
    padding-bottom: 4px;
  }

  .icon-picker__tab {
    background: none;
    border: none;
    cursor: pointer;
    font-size: 14px;
    padding: 4px 6px;
    border-radius: 4px;
    opacity: 0.45;
    transition: opacity 120ms, background 120ms;
  }
  .icon-picker__tab:hover { opacity: 0.75; background: rgb(var(--border-rgb) / 0.12); }
  .icon-picker__tab.active { opacity: 1; background: rgb(var(--accent-rgb) / 0.1); }

  .icon-picker__grid {
    max-height: 160px;
    overflow-y: auto;
    overscroll-behavior: contain;
    scrollbar-width: thin;
    scrollbar-color: rgb(var(--border-rgb) / 0.3) transparent;
  }

  .icon-picker__panel {
    display: grid;
    grid-template-columns: repeat(8, 1fr);
    gap: 2px;
  }
  .icon-picker__panel.hidden { display: none; }

  .icon-picker__emoji {
    background: none;
    border: none;
    cursor: pointer;
    font-size: 16px;
    padding: 4px;
    border-radius: 5px;
    transition: background 100ms, transform 100ms;
  }
  .icon-picker__emoji:hover {
    background: rgb(var(--border-rgb) / 0.2);
    transform: scale(1.15);
  }
  .icon-picker__emoji.selected {
    background: rgb(var(--accent-rgb) / 0.18);
  }

  /* Focus rings */
  .icon-picker__tab:focus-visible,
  .icon-picker__emoji:focus-visible,
  .icon-picker__upload-btn:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 1px;
  }

  @media (prefers-reduced-motion: reduce) {
    .icon-picker { animation: none; }
    .icon-picker__emoji:hover { transform: none; }
  }
</style>
