---
/**
 * FilterToolbar — Shared filter bar for Table, Kanban, Calendar, and Timeline
 *
 * @domain tasks
 * @bounded-context tasks/ui
 *
 * Renders a configurable filter toolbar with:
 * - Type toggle buttons (Epic/Story/Task)
 * - Area filter selector (populated client-side from /api/areas)
 * - Group-by selector
 * - Status, Priority, RICE, User select filters (opt-in per view)
 * - Label filter bar (lazy-loaded)
 * - Clear all button
 *
 * Emits `meitheal:filter-change` CustomEvent whenever any filter changes.
 * Each view's controller (table-controller.ts, kanban inline script) listens
 * for this event to apply filtering.
 *
 * Usage:
 *   <FilterToolbar view="table" showSearch showGroupBy showStatusFilter showPriorityFilter showRICEFilter showUserFilter />
 *   <FilterToolbar view="kanban" showGroupBy />
 */
import { t } from "../../i18n/translations"
import { KANBAN_SEARCH_LIMIT } from "@lib/kanban-query"
import type { Locale } from "../../lib/locale"
import LabelFilterBar from "./LabelFilterBar.astro"
import Icon from "./Icon.astro"
import { readCalendarTaskFilters } from "../../lib/calendar-task-filter"
import { STATUS_CONFIG } from "../../lib/status-config"
import { FILTER_LIST_LIMIT, readTableFilterParams, tableCreationRangeLabel } from "../../lib/filter-state"
import type { TableWorkflowColumn } from "../../lib/table-page"

interface Props {
  /** View context — controls ID prefixing and default visibility */
  view: "table" | "kanban" | "calendar" | "timeline"
  /** Show search input */
  showSearch?: boolean
  /** Show group-by selector */
  showGroupBy?: boolean
  /** Show status filter select */
  showStatusFilter?: boolean
  /** Show priority filter select */
  showPriorityFilter?: boolean
  /** Show RICE filter select */
  showRICEFilter?: boolean
  /** Show user filter select */
  showUserFilter?: boolean
  /** Show user filter pills (kanban-style) */
  showUserPills?: boolean
  /** Show Sort By selector */
  showSortBy?: boolean
  /** Group-by options override */
  groupByOptions?: { value: string; label: string }[]
  /** Hide area select (use with AreaSelector component) */
  hideAreaSelect?: boolean
  workflowColumns?: TableWorkflowColumn[]
  workflowColumnsUnavailable?: boolean
  /** Additional CSS class */
  class?: string
}

const {
  view,
  showSearch = view === "table",
  showGroupBy = true,
  showStatusFilter = view === "table",
  showPriorityFilter = view === "table",
  showRICEFilter = view === "table",
  showUserFilter = view === "table",
  showUserPills = view === "kanban",
  showSortBy = view !== "table",
  groupByOptions,
  hideAreaSelect = false,
  workflowColumns = [],
  workflowColumnsUnavailable = false,
  class: className,
} = Astro.props

// Resolve locale from cookie (same pattern as pages)
const cookieLocale = Astro.cookies.get("meitheal-locale")?.value
const locale: Locale = cookieLocale === "ga" ? "ga" : "en"

const prefix = view
const compactOnPhone = view === "calendar" || view === "timeline"
const tableState = view === "table" ? readTableFilterParams(Astro.url.searchParams) : {}
const calendarState = view === "calendar" ? readCalendarTaskFilters(Astro.url.searchParams) : {}
const calendarStatus = calendarState.status ?? ""
const statuses = [...STATUS_CONFIG.map(status => ({ value: status.canonical, label: t(status.i18nKey, locale) })),
  { value: "overdue", label: t("dashboard.overdue_label", locale) }]
if (calendarStatus && !statuses.some(status => status.value === calendarStatus)) {
  statuses.push({ value: calendarStatus, label: calendarStatus })
}
const selectedLaneIds = new Set(tableState.laneIds)
const availableLaneIds = new Set(workflowColumns.map(column => column.id))
const missingLaneIds = [...selectedLaneIds].filter(id => !availableLaneIds.has(id))
const creationRangeLabel = tableCreationRangeLabel(tableState.createdFrom, tableState.createdThrough)

const defaultGroupByOptions = view === "table"
  ? [
      { value: "none", label: "No Grouping" },
      { value: "type", label: "Type" },
      { value: "epic", label: t("table.group_epic", locale) },
      { value: "priority", label: "Priority" },
      { value: "area", label: "Area" },
      { value: "assignee", label: "Assignee" },
      { value: "status", label: "Status" },
      { value: "rice", label: "RICE" },
    ]
  : [
      { value: "none", label: t("kanban.group_none", locale) },
      { value: "type", label: t("kanban.group_type", locale) },
      ...(view === "kanban" ? [{ value: "epic", label: t("kanban.group_epic", locale) }] : []),
      { value: "area", label: t("kanban.group_area", locale) },
      { value: "project", label: t("kanban.group_project", locale) },
      { value: "priority", label: t("kanban.group_priority", locale) },
      { value: view === "kanban" ? "assigned" : "assignee", label: t("kanban.group_assignee", locale) },
      { value: "status", label: t("kanban.group_status", locale) },
      ...(view === "kanban" ? [{ value: "rice", label: t("kanban.group_rice", locale) }] : []),
    ]

const groupOptions = groupByOptions ?? defaultGroupByOptions
---

{compactOnPhone && (
  <button
    type="button"
    class="btn btn-outline filter-toolbar__disclosure"
    data-filter-disclosure
    aria-controls={`${prefix}-filter-bar`}
    aria-expanded="false"
    hidden
  >
    <Icon name="adjustments-horizontal" size={16} />
    {t("tasks.filters", locale)}
    <span data-filter-activity hidden>{t("tasks.filters_active", locale)}</span>
    <Icon name="chevron-down" class="filter-toolbar__disclosure-chevron" size={14} />
  </button>
)}
<div
  class:list={["filter-toolbar", `filter-toolbar--${view}`, className]}
  id={`${prefix}-filter-bar`}
  role="toolbar"
  aria-label="Filter tasks"
>
  {/* Search input (table only by default) */}
  {showSearch && (
    <input
      type="text"
      class="form-input filter-toolbar__search"
      id={`${prefix}-search`}
      placeholder={t("table.filter_placeholder", locale)}
      aria-label="Filter by text"
      value={calendarState.search}
      disabled={prefix === "calendar"}
      maxlength={prefix === "calendar" ? KANBAN_SEARCH_LIMIT : undefined}
    />
  )}

  {view === "timeline" && <>
    <select class="form-select" id="timeline-filter-status" aria-label="Filter by status">
      <option value="">{t("tasks.all_statuses", locale)}</option>
      {statuses.map(status => <option value={status.value}>{status.label}</option>)}
    </select>
    <select class="form-select" id="timeline-filter-priority" aria-label="Filter by priority">
      <option value="">{t("tasks.all_priorities", locale)}</option>
      {["critical", "high", "medium", "low", "minimal"].map((priority, index) => (
        <option value={index + 1}>{t(`priority.${priority}`, locale)}</option>
      ))}
    </select>
  </>}

  {view === "calendar" && <>
    <select class="form-select filter-toolbar__select" id="calendar-filter-status" aria-label="Filter by status">
      <option value="">{t("tasks.all_statuses", locale)}</option>
      {statuses.map(status => <option value={status.value} selected={status.value === calendarStatus}>{status.label}</option>)}
    </select>
    <select class="form-select filter-toolbar__select" id="calendar-filter-priority" aria-label="Filter by priority">
      <option value="">{t("tasks.all_priorities", locale)}</option>
      {["critical", "high", "medium", "low", "minimal"].map((priority, index) => (
        <option value={index + 1} selected={String(index + 1) === calendarState.priority}>{t(`priority.${priority}`, locale)}</option>
      ))}
    </select>
  </>}

  {/* Type toggle buttons — TaskKind behavioral classification */}
  <div class="filter-toolbar__type-toggles" id={`${prefix}-type-toggles`}>
    <button
      type="button"
      class="filter-toolbar__type-btn active"
      data-type="standard_action"
      aria-pressed="true"
      title="Toggle Standard Tasks"
    >
      <Icon name="checkbox" size={14} />
      Task
    </button>
    <button
      type="button"
      class="filter-toolbar__type-btn active"
      data-type="shopping_item"
      aria-pressed="true"
      title="Toggle Shopping Items"
    >
      <Icon name="shopping-cart" size={14} />
      Shopping
    </button>
    <button
      type="button"
      class="filter-toolbar__type-btn active"
      data-type="checklist"
      aria-pressed="true"
      title="Toggle Checklists"
    >
      <Icon name="list-check" size={14} />
      Checklist
    </button>
    <button
      type="button"
      class="filter-toolbar__type-btn active"
      data-type="routine_instance"
      aria-pressed="true"
      title="Toggle Routines"
    >
      <Icon name="repeat" size={14} />
      Routine
    </button>
    <button
      type="button"
      class="filter-toolbar__type-btn active"
      data-type="calendar_event"
      aria-pressed="true"
      title="Toggle Events"
    >
      <Icon name="calendar-event" size={14} />
      Events
    </button>
    <button type="button" class="filter-toolbar__type-btn active" data-type="quick_capture" aria-pressed="true">
      <Icon name="bolt" size={14} />
      Quick capture
    </button>
  </div>

  {/* Area filter — populated client-side from /api/areas (hidden when AreaSelector is used) */}
  {/* Replaced by Unified Filter Builder */}

  {/* Group-by selector */}
  {showGroupBy && (
    <details class="timeline-zoom-dropdown filter-dropdown text-xs" id={`${prefix}-group-by-dropdown`} aria-label="Group tasks by">
      <summary class="timeline-ctrl-btn timeline-zoom-trigger" id={`${prefix}-group-by-label`}>
        <span class="filter-dropdown__value">{groupOptions?.[0]?.label || "Group by"}</span>
        <svg width="10" height="6" viewBox="0 0 10 6" fill="none"><path d="M1 1l4 4 4-4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg>
      </summary>
      <div class="timeline-zoom-panel mt-1 w-max font-normal">
        <div class="timeline-zoom-panel-title">Group by</div>
        {groupOptions.map((opt, i) => (
          <button type="button" class={`timeline-zoom-option filter-dropdown__option ${i === 0 ? 'timeline-zoom-option--active' : ''}`} data-select={`${prefix}-group-by`} data-value={opt.value}>
            <span class="truncate pr-4">{opt.label}</span>
            <svg width="12" height="10" viewBox="0 0 12 10" fill="none"><path d="M1 5l3 3 7-7" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
          </button>
        ))}
      </div>
    </details>
  )}
  {showGroupBy && <input type="hidden" id={`${prefix}-group-by`} value="none" />}

  {/* Sub-group-by selector — only for table view with groupBy active */}
  {showGroupBy && view === "table" && (
    <details class="timeline-zoom-dropdown filter-dropdown text-xs" id={`${prefix}-sub-group-by-dropdown`} aria-label="Sub-group tasks by" hidden={!tableState.groupBy}>
      <summary class="timeline-ctrl-btn timeline-zoom-trigger" id={`${prefix}-sub-group-by-label`}>
        <span class="filter-dropdown__value">No sub-group</span>
        <svg width="10" height="6" viewBox="0 0 10 6" fill="none"><path d="M1 1l4 4 4-4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg>
      </summary>
      <div class="timeline-zoom-panel mt-1 w-max font-normal">
        <div class="timeline-zoom-panel-title">Then group by</div>
        {[
          { value: "none", label: "No sub-group" },
          { value: "status", label: "Then by Status" },
          { value: "priority", label: "Then by Priority" },
          { value: "type", label: "Then by Type" },
          { value: "epic", label: t("table.subgroup_epic", locale) },
          { value: "area", label: "Then by Area" },
          { value: "assignee", label: "Then by Assignee" },
          { value: "rice", label: "Then by RICE" }
        ].map((opt, i) => (
          <button type="button" class={`timeline-zoom-option filter-dropdown__option ${i === 0 ? 'timeline-zoom-option--active' : ''}`} data-select={`${prefix}-sub-group-by`} data-value={opt.value}>
            <span class="truncate pr-4">{opt.label}</span>
            <svg width="12" height="10" viewBox="0 0 12 10" fill="none"><path d="M1 5l3 3 7-7" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
          </button>
        ))}
      </div>
    </details>
  )}
  {showGroupBy && view === "table" && <input type="hidden" id={`${prefix}-sub-group-by`} value="none" />}

  {/* Sort-by selector */}
  {showSortBy && (
    <details class="timeline-zoom-dropdown filter-dropdown text-xs" id={`${prefix}-sort-by-dropdown`} aria-label="Sort tasks by">
      <summary class="timeline-ctrl-btn timeline-zoom-trigger" id={`${prefix}-sort-by-label`}>
        <span class="filter-dropdown__value">Default Sort</span>
        <svg width="10" height="6" viewBox="0 0 10 6" fill="none"><path d="M1 1l4 4 4-4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg>
      </summary>
      <div class="timeline-zoom-panel mt-1 w-max font-normal">
        <div class="timeline-zoom-panel-title">Sort by</div>
        {[
          { value: "none", label: "Default Sort" },
          { value: "due_asc", label: "Due Date (Earliest)" },
          { value: "due_desc", label: "Due Date (Latest)" },
          { value: "priority_desc", label: "Priority (High to Low)" },
          { value: "created_desc", label: "Recently Created" },
          { value: "rice_desc", label: "RICE Score (High to Low)" }
        ].map((opt, i) => (
          <button type="button" class={`timeline-zoom-option filter-dropdown__option ${i === 0 ? 'timeline-zoom-option--active' : ''}`} data-select={`${prefix}-sort-by`} data-value={opt.value}>
            <span class="truncate pr-4">{opt.label}</span>
            <svg width="12" height="10" viewBox="0 0 12 10" fill="none"><path d="M1 5l3 3 7-7" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
          </button>
        ))}
      </div>
    </details>
  )}
  {showSortBy && <input type="hidden" id={`${prefix}-sort-by`} value="none" />}

  {(view === "kanban" || view === "calendar") && (
    <button
      type="button"
      class:list={["filter-pill", { "filter-pill--active": Astro.url.searchParams.get("promoted") === "1" }]}
      data-filter-promoted
      title={t("kanban.promoted_filter_hint", locale)}
      aria-pressed={Astro.url.searchParams.get("promoted") === "1" ? "true" : "false"}
    >
      <Icon name="rocket" size={14} />
      <span class="filter-pill__label">{t("kanban.promoted_only", locale)}</span>
    </button>
  )}
  {view === "table" && <>
    <label class="filter-pill table-unassigned-filter">
      <input type="checkbox" data-table-unassigned checked={tableState.user === "__unassigned__"} />
      {t("table.filter_unassigned", locale)}
    </label>
    <details class="table-workflow-filter" data-table-workflow-filter>
      <summary class="filter-pill">
        {t("table.filter_workflow_columns", locale)}
        <span data-table-lane-count hidden={selectedLaneIds.size === 0}>{selectedLaneIds.size}</span>
        <span aria-hidden="true">▾</span>
      </summary>
      <fieldset class="table-workflow-filter__options" data-table-workflow-options={workflowColumnsUnavailable ? "unavailable" : "ready"}>
        <legend class="sr-only">{t("table.filter_workflow_columns", locale)}</legend>
        <p class="text-sm text-text-muted" data-table-lane-limit role="status" hidden={selectedLaneIds.size < FILTER_LIST_LIMIT}>
          {t("table.filter_column_limit", locale).replace("{count}", String(FILTER_LIST_LIMIT))}
        </p>
        {workflowColumns.map(column => (
          <label>
            <input type="checkbox" data-table-lane value={JSON.stringify(column.id)} checked={selectedLaneIds.has(column.id)}
              disabled={selectedLaneIds.size >= FILTER_LIST_LIMIT && !selectedLaneIds.has(column.id)} />
            <span>{column.label}</span>
          </label>
        ))}
        {missingLaneIds.map(id => (
          <label>
            <input type="checkbox" data-table-lane value={JSON.stringify(id)} checked />
            <span>{t(workflowColumnsUnavailable ? "table.filter_column_unverified" : "table.filter_column_unavailable", locale)} ({id})</span>
          </label>
        ))}
      </fieldset>
    </details>
    <details class="table-workflow-filter" data-table-created-date>
      <summary class:list={["filter-pill", { "filter-pill--active": creationRangeLabel }]} data-table-created-summary>
        {t("table.created_date_filter", locale)}
        <span aria-hidden="true">▾</span>
        <span data-table-created-active hidden={!creationRangeLabel}>{creationRangeLabel}</span>
      </summary>
      <form class="table-created-range">
        <label>
          {t("table.created_date_from", locale)}
          <input type="date" min="0001-01-01" max="9999-12-31" class="form-input" value={tableState.createdFrom} data-table-created-from />
        </label>
        <label>
          {t("table.created_date_through", locale)}
          <input type="date" min="0001-01-01" max="9999-12-31" class="form-input" value={tableState.createdThrough}
            data-table-created-through />
        </label>
        <p id="table-created-date-error" role="alert" hidden>{t("table.created_date_invalid", locale)}</p>
        <div class="flex flex-wrap gap-2">
          <button type="submit" class="btn">{t("table.created_date_apply", locale)}</button>
          <button type="button" class="btn" data-table-created-clear>{t("table.created_date_clear", locale)}</button>
        </div>
      </form>
    </details>
  </>}
  {(view === "table" || view === "calendar") &&
    <div class="flex flex-wrap gap-1 min-w-0 empty:hidden" data-filter-summary aria-label="Active saved filters"></div>}

  {/* Clear all button */}
  <button
    type="button"
    class="filter-toolbar__clear-btn hidden"
    id={`${prefix}-clear-filters`}
    title="Clear all filters"
    aria-label="Clear all active filters"
  >
    {t("tasks.clear_filters", locale)}
  </button>

  {view !== "timeline" && <>
  {/* Unified Filter Builder Toggle */}
  <button
    type="button"
    class="filter-pill filter-toolbar__advanced-toggle"
    id={`${prefix}-advanced-toggle`}
    title="Add custom filters"
    aria-label="Toggle filter builder"
    aria-expanded="false"
  >
    <Icon name="adjustments-horizontal" size={14} />
    <span class="filter-pill__label font-medium">Filter</span>
  </button>

  {/* Unified Filter Builder Dropdown (Hidden by default) */}
  <div class="filter-toolbar__advanced-panel hidden absolute left-0 top-full mt-2 z-50 w-[calc(100vw-32px)] sm:w-full max-w-[800px] rounded-lg border border-border bg-bg-card shadow-2xl" id={`${prefix}-advanced-panel`} role="region" aria-label="Custom Filter Builder">
    <div class="advanced-panel__header px-4 py-3 border-b border-border flex justify-between items-center bg-bg-secondary rounded-t-lg">
      <h4 class="text-sm font-semibold text-text-primary flex items-center gap-1.5">
        <Icon name="adjustments-horizontal" size={14} class="text-text-muted" />
        Filters
      </h4>
      <div class="flex items-center gap-2">
        <button type="button" class="btn-icon p-1 rounded-md hover:bg-bg-hover text-text-muted hover:text-text-primary transition-colors" id={`${prefix}-advanced-close`} aria-label="Close custom filters">
          <Icon name="x" size={14} />
        </button>
      </div>
    </div>
    
    <div class="advanced-panel__body p-3 max-h-[300px] overflow-y-auto custom-scrollbar" id={`${prefix}-advanced-conditions-container`}>
      <!-- Conditions rendered here by JS -->
      <div class="advanced-panel__empty-state text-sm text-text-muted italic py-4 text-center">
        No filters applied.<br/>Add a condition to filter tasks.
      </div>
    </div>

    {view === "calendar" && <p class="m-0 px-4 pb-3 text-sm text-text-primary" data-calendar-rule-error hidden></p>}
    <div class="advanced-panel__footer px-4 py-3 bg-bg-secondary border-t border-border flex justify-between items-center gap-2 rounded-b-lg">
      <div class="flex gap-2">
        <button type="button" class="btn btn-outline text-xs px-2.5 py-1 min-h-[28px] border-border hover:border-border-focus bg-bg-primary hover:bg-bg-hover text-text-primary" id={`${prefix}-advanced-add-condition`}>
          <Icon name="plus" size={12} class="mr-1 inline" />
          Condition
        </button>
      </div>
      <div class="flex gap-2">
        <button type="button" class="btn text-xs px-2.5 py-1 min-h-[28px] text-text-muted hover:text-text-primary hover:bg-bg-hover bg-transparent border-transparent transition-colors" id={`${prefix}-advanced-clear`}>
          Clear Rules
        </button>
        <button type="button" class="btn btn-primary text-xs px-3 py-1 min-h-[28px] shadow-sm" id={`${prefix}-advanced-apply`}>
          Apply Rules
        </button>
      </div>
    </div>
  </div>

  {/* Label filter bar — separate row below main toolbar */}
  <div class:list={[view === "table" && "w-full", view === "kanban" && "hidden"]} id={`${prefix}-label-filter-container`}>
    <LabelFilterBar id={`${prefix}-label-filter`} view={view} activeLabels={calendarState.labels ?? []} />
  </div>
  </>}
</div>

<script>
  // Expose global for inline views (kanban)
  import { getRememberedAreaId } from "@lib/area-selector-controller"
  import { CALENDAR_FILTER_STATE_EVENT, readCalendarTaskFilters } from "@lib/calendar-task-filter"
  import { FILTER_LIST_LIMIT, isTaskVisible, loadFilterState, loadTableFilterState, normalizeTableCreationRange, readTaskKindFilter } from "@lib/filter-state"
  import { pageLifecycle } from "@lib/page-lifecycle"
  import { createTablerSvgElement } from "@lib/tabler-svg"
  import { readKanbanFilters, storedKanbanGroup, type KanbanFilters } from "../../lib/kanban-query"
  declare global {
    interface Window {
      __isTaskVisible?: (el: HTMLElement, state?: any) => boolean
    }
  }
  ;window.__isTaskVisible = isTaskVisible as any

  /**
   * FilterToolbar client-side controller
   *
   * Binds all filter controls and emits a unified `meitheal:filter-change`
   * CustomEvent whenever any filter value changes. Views listen for this event.
   */
  function initFilterToolbar(toolbar: HTMLElement, signal: AbortSignal) {
    const prefix = toolbar.id.replace(/-filter-bar$/, "")
    const disclosure = toolbar.previousElementSibling
    const filterToggle = disclosure instanceof HTMLButtonElement && disclosure.hasAttribute("data-filter-disclosure")
      ? disclosure : null
    const filterActivity = filterToggle?.querySelector<HTMLElement>("[data-filter-activity]")

    // Gather all controls
    const search = toolbar.querySelector<HTMLInputElement>(`#${prefix}-search`)
    const statusSel = toolbar.querySelector<HTMLSelectElement>(`#${prefix}-filter-status`)
    const prioritySel = toolbar.querySelector<HTMLSelectElement>(`#${prefix}-filter-priority`)
    const riceSel = toolbar.querySelector<HTMLSelectElement>(`#${prefix}-rice-filter`)
    const userSel = toolbar.querySelector<HTMLSelectElement>(`#${prefix}-user-filter`)
    const areaSel = toolbar.querySelector<HTMLSelectElement>(`#${prefix}-area-filter`)
    const groupBySel = toolbar.querySelector<HTMLSelectElement>(`#${prefix}-group-by`)
    const subGroupBySel = toolbar.querySelector<HTMLSelectElement>(`#${prefix}-sub-group-by`)
    const subGroupMenu = toolbar.querySelector<HTMLDetailsElement>(`#${prefix}-sub-group-by-dropdown`)
    const sortBySel = toolbar.querySelector<HTMLSelectElement>(`#${prefix}-sort-by`)
    const clearBtn = toolbar.querySelector<HTMLButtonElement>(`#${prefix}-clear-filters`)
    const promotedToggle = toolbar.querySelector<HTMLButtonElement>("[data-filter-promoted]")
    const typeToggles = toolbar.querySelectorAll<HTMLButtonElement>(".filter-toolbar__type-btn")

    // Advanced Filter controls
    const advToggleBtn = toolbar.querySelector<HTMLButtonElement>(`#${prefix}-advanced-toggle`)
    const advPanel = toolbar.querySelector<HTMLElement>(`#${prefix}-advanced-panel`)
    const advCloseBtn = toolbar.querySelector<HTMLButtonElement>(`#${prefix}-advanced-close`)
    const advAddCondBtn = toolbar.querySelector<HTMLButtonElement>(`#${prefix}-advanced-add-condition`)
    const advClearBtn = toolbar.querySelector<HTMLButtonElement>(`#${prefix}-advanced-clear`)
    const advApplyBtn = toolbar.querySelector<HTMLButtonElement>(`#${prefix}-advanced-apply`)
    const advContainer = toolbar.querySelector<HTMLElement>(`#${prefix}-advanced-conditions-container`)

    const params = new URLSearchParams(location.search)
    let timelineArea = prefix === "timeline" ? params.get("area") ?? getRememberedAreaId() : ""
    const initial = prefix === "kanban" ? readKanbanFilters(params)
      : prefix === "calendar" ? readCalendarTaskFilters(params)
      : prefix === "table" ? loadTableFilterState() : loadFilterState()
    const rawUrlTypes = readTaskKindFilter(params.get("types"))
    const initialTypes = rawUrlTypes.length > 0 && (!initial.types || initial.types.length === 0)
      ? rawUrlTypes
      : (initial.types ?? [])
    if (prefix === "kanban" && !params.has("groupBy")) initial.groupBy = storedKanbanGroup()
    if (prefix === "timeline" && initial.groupBy === "assigned") initial.groupBy = "assignee"
    // Internal state for advanced filters
    let advancedFilterState = prefix === "timeline" ? null : initial.advancedFilter ?? null
    let { status = "", priority = "" } = initial
    let { rice = "", user = "", labels = [], task_type = "" } = prefix === "timeline" ? {} : initial
    let area = prefix === "table" ? initial.area ?? getRememberedAreaId() : prefix === "calendar" ? initial.area ?? "" : ""
    const summary = toolbar.querySelector<HTMLElement>("[data-filter-summary]")
    const unassigned = toolbar.querySelector<HTMLInputElement>("[data-table-unassigned]")
    const workflow = toolbar.querySelector<HTMLDetailsElement>("[data-table-workflow-filter]")
    const createdDate = toolbar.querySelector<HTMLDetailsElement>("[data-table-created-date]")
    const createdFrom = createdDate?.querySelector<HTMLInputElement>("[data-table-created-from]")
    const createdThrough = createdDate?.querySelector<HTMLInputElement>("[data-table-created-through]")
    const createdError = createdDate?.querySelector<HTMLElement>("#table-created-date-error")
    const appliedCreationDate = createdDate?.querySelector<HTMLElement>("[data-table-created-active]")
    let createdRange = { createdFrom: initial.createdFrom, createdThrough: initial.createdThrough }
    let dismissCreationDraft: (() => void) | undefined
    const laneOptions = () => Array.from(workflow?.querySelectorAll<HTMLInputElement>("[data-table-lane]") ?? [])
    const laneCount = toolbar.querySelector<HTMLElement>("[data-table-lane-count]")
    const laneId = (option: HTMLInputElement): string => JSON.parse(option.value)
    const selectedLanes = () => laneOptions().filter(option => option.checked).map(laneId)
    if (unassigned) unassigned.checked = user === "__unassigned__"
    for (const option of laneOptions()) option.checked = initial.laneIds?.includes(laneId(option)) ?? false
    function updateLaneCount() {
      if (!laneCount) return
      const count = selectedLanes().length
      laneCount.textContent = String(count)
      laneCount.hidden = count === 0
      const limit = workflow?.querySelector<HTMLElement>("[data-table-lane-limit]")
      if (limit) limit.hidden = count < FILTER_LIST_LIMIT
      for (const option of laneOptions()) option.disabled = count >= FILTER_LIST_LIMIT && !option.checked
    }
    const inheritedLabels = {
      status: "Status", priority: "Priority", rice: "RICE", user: "Assignee", task_type: "Hierarchy",
    } as const
    let readOnlyRules = (prefix === "table" || prefix === "calendar") && (advancedFilterState?.conditions.some(
      condition => "conditions" in condition || condition.operator === "between",
    ) ?? false)
    const savedRulesSummary = document.createElement("p")
    savedRulesSummary.className = "text-sm text-text-muted"
    savedRulesSummary.textContent = "This preset has saved rules that are applied as a group. Clear Rules to replace them."

    function updateRulesMode() {
      if (advAddCondBtn) advAddCondBtn.disabled = readOnlyRules
      if (advApplyBtn) advApplyBtn.disabled = readOnlyRules
      if (readOnlyRules) advContainer?.append(savedRulesSummary)
      else savedRulesSummary.remove()
    }

    function renderInheritedFilters() {
      if (!summary) return
      const values = { status, priority, rice, user, task_type }
      const focusedKey = summary.querySelector<HTMLButtonElement>("button:focus")?.dataset.inheritedFilter
      summary.replaceChildren()
      for (const key of Object.keys(inheritedLabels) as Array<keyof typeof inheritedLabels>) {
        const value = values[key]
        if (!value || (key === "user" && unassigned && value === "__unassigned__") ||
            (prefix === "calendar" && (key === "status" || key === "priority"))) continue
        const display = key === "user" && value === "__unassigned__" ? "Unassigned"
          : key === "user" && prefix === "calendar" ? "Selected user" : value
        const chip = document.createElement("button")
        chip.type = "button"
        chip.className = "filter-pill max-w-full break-all"
        chip.dataset.inheritedFilter = key
        chip.textContent = `${inheritedLabels[key]} · ${display} ×`
        chip.setAttribute("aria-label", `Remove ${inheritedLabels[key]} filter ${display}`)
        summary.append(chip)
      }
      if (focusedKey) (summary.querySelector<HTMLElement>(`[data-inherited-filter="${CSS.escape(focusedKey)}"]`) ?? search)?.focus()
    }
    summary?.addEventListener("click", event => {
      const button = (event.target as Element).closest<HTMLButtonElement>("[data-inherited-filter]")
      if (!button) return
      const key = button.dataset.inheritedFilter
      if (key === "status") status = ""
      if (key === "priority") priority = ""
      if (key === "rice") rice = ""
      if (key === "user") user = ""
      if (key === "task_type") task_type = ""
      renderInheritedFilters()
      const next = summary.querySelector("button") ?? search
      next?.focus()
      emitChange()
    }, { signal })
    let promoted = promotedToggle?.getAttribute("aria-pressed") === "true"
    if (prefix === "timeline") {
      if (statusSel) {
        if (!Array.from(statusSel.options).some(option => option.value === status)) statusSel.add(new Option(status, status))
        statusSel.value = status
      }
      if (prioritySel) prioritySel.value = priority
    }
    {
      if (search) search.value = initial.search ?? ""
      if (groupBySel) groupBySel.value = initial.groupBy ?? "none"
      if (subGroupBySel) subGroupBySel.value = initial.subGroupBy ?? "none"
      setTypeButtons(initialTypes)
    }

    function setTypeButtons(types: string[]) {
      for (const button of typeToggles) {
        const active = !types.length || types.includes(button.dataset.type ?? "")
        button.classList.toggle("active", active)
        button.setAttribute("aria-pressed", String(active))
      }
    }

    // Field definition for dropdowns
    const fields = [
      { id: "title", label: "Task Title" },
      { id: "status", label: "Status" },
      { id: "priority", label: "Priority" },
      { id: "rice", label: "RICE Score" },
      { id: "type", label: "Task Type" },
      { id: "assigned", label: "Assignee" },
      { id: "labels", label: "Labels" },
      { id: "area", label: "Area ID" },
    ]

    const operators = [
      { id: "equals", label: "Equals" },
      { id: "notEquals", label: "Does not equal" },
      { id: "contains", label: "Contains" },
      { id: "notContains", label: "Does not contain" },
      { id: "greaterThan", label: "Greater than" },
      { id: "lessThan", label: "Less than" },
      { id: "isEmpty", label: "Is empty" },
      { id: "isNotEmpty", label: "Is not empty" },
    ]

    function renderAdvancedConditionRow() {
      const row = document.createElement("div")
      row.className = "advanced-filter-row flex gap-2 items-center mb-2"
      row.dataset.type = "condition"
      row.setAttribute("role", "group")
      row.setAttribute("aria-label", "Filter condition")

      const hasRows = advContainer && advContainer.querySelectorAll(".advanced-filter-row").length > 0
      
      if (hasRows) {
        const logicBtn = document.createElement("button")
        logicBtn.type = "button"
        logicBtn.className = "adv-logic text-[10px] font-bold px-2 py-1 min-h-[30px] bg-bg-primary border border-border hover:bg-bg-hover hover:border-border-focus text-accent rounded transition-colors break-keep whitespace-nowrap"
        logicBtn.textContent = "AND"
        logicBtn.dataset.logic = "AND"
        logicBtn.addEventListener("click", () => {
          const isAnd = logicBtn.dataset.logic === "AND"
          logicBtn.dataset.logic = isAnd ? "OR" : "AND"
          logicBtn.textContent = isAnd ? "OR" : "AND"
        }, { signal })
        row.appendChild(logicBtn)
      }

      const fieldSel = document.createElement("select")
      fieldSel.setAttribute("aria-label", "Field")
      fieldSel.className = "adv-field form-select flex-1 text-xs py-1.5 min-h-[30px] bg-bg-primary border border-border focus:border-border-focus rounded"
      fields.forEach(f => {
        const opt = document.createElement("option")
        opt.value = f.id
        opt.textContent = f.label
        fieldSel.appendChild(opt)
      })

      const opSel = document.createElement("select")
      opSel.setAttribute("aria-label", "Operator")
      opSel.className = "adv-op form-select flex-1 text-xs py-1.5 min-h-[30px] bg-bg-primary border border-border focus:border-border-focus rounded"
      operators.forEach(o => {
        const opt = document.createElement("option")
        opt.value = o.id
        opt.textContent = o.label
        opSel.appendChild(opt)
      })

      const valInput = document.createElement("input")
      valInput.className = "adv-val form-input flex-1 text-xs py-1.5 min-h-[30px] px-2 bg-bg-primary border border-border focus:border-border-focus rounded"
      valInput.type = "text"
      valInput.placeholder = "Value..."
      valInput.setAttribute("aria-label", "Value")

      // Hide value input for empty/not-empty operators
      opSel.addEventListener("change", () => {
        if (opSel.value === "isEmpty" || opSel.value === "isNotEmpty") {
          valInput.style.display = "none"
        } else {
          valInput.style.display = ""
        }
      }, { signal })

      const removeBtn = document.createElement("button")
      removeBtn.type = "button"
      removeBtn.setAttribute("aria-label", "Remove condition")
      removeBtn.className = "btn-icon p-1.5 ml-1 text-text-muted hover:text-red-400 hover:bg-red-400/10 rounded"
      removeBtn.append(createTablerSvgElement("trash", 14))
      removeBtn.addEventListener("click", event => {
        event.stopPropagation()
        const sibling = row.nextElementSibling ?? row.previousElementSibling
        row.remove()
        
        // Ensure first remaining row doesn't have a logic button
        if (advContainer) {
          const firstRow = advContainer.querySelector(".advanced-filter-row")
          if (firstRow) {
            const firstLogicBtn = firstRow.querySelector(".adv-logic")
            if (firstLogicBtn) firstLogicBtn.remove()
          }
        }
        
        checkEmptyState()
        updateClearVisibility()
        const focus = sibling?.querySelector<HTMLElement>(".adv-field") ?? advAddCondBtn
        focus?.focus()
      }, { signal })

      row.append(fieldSel, opSel, valInput, removeBtn)
      return row
    }

    function checkEmptyState() {
      if (!advContainer) return
      const emptyState = advContainer.querySelector(".advanced-panel__empty-state")
      const hasRows = readOnlyRules || advContainer.querySelectorAll(".advanced-filter-row").length > 0
      if (emptyState) {
        (emptyState as HTMLElement).style.display = hasRows ? "none" : "block"
      }
    }

    // Toggle Advanced Panel
    advToggleBtn?.addEventListener("click", () => {
      const isExpanded = advToggleBtn.getAttribute("aria-expanded") === "true"
      advToggleBtn.setAttribute("aria-expanded", String(!isExpanded))
      advPanel?.classList.toggle("hidden")
    }, { signal })

    function closeAdvancedPanel(restoreFocus = false) {
      advToggleBtn?.setAttribute("aria-expanded", "false")
      advPanel?.classList.add("hidden")
      if (restoreFocus) advToggleBtn?.focus()
    }

    advCloseBtn?.addEventListener("click", () => closeAdvancedPanel(true), { signal })

    // Click outside to close advanced panel
    document.addEventListener("click", (e) => {
      if (!advPanel?.classList.contains("hidden") && advToggleBtn && advPanel) {
        if (!advPanel.contains(e.target as Node) && !advToggleBtn.contains(e.target as Node)) {
          closeAdvancedPanel()
        }
      }
    }, { signal })

    // Advanced Panel Actions
    advAddCondBtn?.addEventListener("click", () => {
      if (!advContainer) return
      const emptyState = advContainer.querySelector(".advanced-panel__empty-state")
      if (emptyState) (emptyState as HTMLElement).style.display = "none"
      
      const row = renderAdvancedConditionRow()
      advContainer.appendChild(row)
      updateClearVisibility()
    }, { signal })

    // Logic Toggle Actions (Removed from header)
    // advClearBtn logic
    advClearBtn?.addEventListener("click", () => {
      if (!advContainer) return
      advancedFilterState = null
      if (prefix === "calendar" && !emitChange(false, true)) return
      readOnlyRules = false
      updateRulesMode()
      renderSavedRules()
      if (prefix !== "calendar") emitChange()
    }, { signal })

    advApplyBtn?.addEventListener("click", () => {
      if (!advContainer) return
      const previousRules = advancedFilterState
      const rows = advContainer.querySelectorAll(".advanced-filter-row")
      if (rows.length === 0) {
        advancedFilterState = null
      } else {
        // Build the root filter group
        const conditions = Array.from(rows).map((row, index) => {
          const logic: "AND" | "OR" = index > 0 && row.querySelector<HTMLButtonElement>(".adv-logic")?.dataset.logic === "OR" ? "OR" : "AND"
          const field = row.querySelector<HTMLSelectElement>(".adv-field")?.value ?? ""
          const operator = (row.querySelector<HTMLSelectElement>(".adv-op")?.value ?? "equals") as import("../../lib/filter-engine").FilterOperator
          const value = row.querySelector<HTMLInputElement>(".adv-val")?.value ?? ""
          return { id: Math.random().toString(36).substring(7), logic, field, operator, value }
        })
        advancedFilterState = {
          id: "root",
          logic: "AND", // Master logic is AND
          conditions
        }
      }
      if (prefix === "calendar" && !emitChange(false, true)) {
        advancedFilterState = previousRules
        updateClearVisibility()
        return
      }

      // Visual feedback on toggle button
      if (advancedFilterState && advancedFilterState.conditions.length > 0) {
        advToggleBtn?.classList.add("filter-pill--active")
      } else {
        advToggleBtn?.classList.remove("filter-pill--active")
      }

      closeAdvancedPanel(true)
      if (prefix !== "calendar") emitChange()
    }, { signal })

    function gatherState() {
      // Collect active types
      const activeTypes: string[] = []
      typeToggles.forEach((btn) => {
        if (btn.classList.contains("active") && btn.dataset.type) {
          activeTypes.push(btn.dataset.type)
        }
      })

      // Collect active users
      const activeUser = userSel?.value ?? user

      return {
        search: search?.value ?? "",
        status: statusSel?.value ?? status,
        priority: prioritySel?.value ?? priority,
        ...(promotedToggle ? { promoted } : {}),
        rice,
        user: activeUser,
        ...(prefix !== "table" ? { labels } : {}),
        task_type,
        ...(prefix === "table" ? { laneIds: selectedLanes(), ...createdRange } : {}),
        area,
        groupBy: groupBySel?.value ?? "none",
        subGroupBy: subGroupBySel?.value ?? "none",
        sortBy: sortBySel?.value ?? "none",
        types: activeTypes.length === typeToggles.length ? [] : activeTypes,
        advancedFilter: advancedFilterState,
      }
    }

    function updateClearVisibility() {
      if (!clearBtn && !filterActivity) return
      const hasAdvanced = advancedFilterState && advancedFilterState.conditions && advancedFilterState.conditions.length > 0
      const hasSearch = search && search.value.trim().length > 0
      const hasTypes = toolbar.querySelector(".filter-toolbar__type-btn:not(.active)") !== null
      // Check if group/sort have non-default values
      const hasGroup = groupBySel && groupBySel.value !== "none"
      const hasSort = sortBySel && sortBySel.value !== "none"
      
      const active = Boolean(hasAdvanced || hasSearch || hasTypes || hasGroup || hasSort || promoted || (statusSel?.value ?? status) ||
          (prioritySel?.value ?? priority) || rice || user || labels.length || task_type || selectedLanes().length ||
          (appliedCreationDate && !appliedCreationDate.hidden) || ((prefix === "table" || prefix === "calendar") && area))
      clearBtn?.classList.toggle("hidden", !active)
      if (filterActivity) filterActivity.hidden = !active && !timelineArea
    }
    if (createdDate) document.addEventListener("meitheal:table-filters-applied", updateClearVisibility, { signal })

    function emitChange(clear = false, editRules = false) {
      syncSubGroupMenu()
      const state = gatherState()
      const accepted = document.dispatchEvent(
        new CustomEvent("meitheal:filter-change", {
          cancelable: prefix === "calendar",
          detail: { ...state, view: prefix, clear, editRules, ...(clear ? { labels: [] } : {}) },
        })
      )
      updateLaneCount()
      updateClearVisibility()
      return accepted
    }

    unassigned?.addEventListener("change", () => {
      user = unassigned.checked ? "__unassigned__" : ""
      renderInheritedFilters()
      emitChange()
    }, { signal })
    workflow?.addEventListener("keydown", event => {
      if (event.key !== "Escape" || !workflow.open) return
      event.preventDefault()
      event.stopPropagation()
      workflow.open = false
      workflow.querySelector("summary")?.focus()
    }, { signal })
    workflow?.addEventListener("change", event => {
      if (event.target instanceof HTMLInputElement && event.target.hasAttribute("data-table-lane")) emitChange()
    }, { signal })
    if (createdDate && createdFrom && createdThrough && createdError) {
      const clearError = () => {
        createdError.hidden = true
        createdThrough.removeAttribute("aria-invalid")
        createdThrough.removeAttribute("aria-describedby")
      }
      const restoreDraft = () => {
        createdFrom.value = createdRange.createdFrom ?? ""
        createdThrough.value = createdRange.createdThrough ?? ""
        clearError()
      }
      const close = () => {
        restoreDraft()
        createdDate.open = false
        createdDate.querySelector("summary")?.focus()
      }
      dismissCreationDraft = close
      createdDate.addEventListener("toggle", () => {
        if (!createdDate.open) {
          restoreDraft()
          return
        }
        for (const details of toolbar.querySelectorAll<HTMLDetailsElement>("details[open]")) {
          if (details !== createdDate) details.open = false
        }
      }, { signal })
      toolbar.addEventListener("toggle", event => {
        const details = event.target
        if (details instanceof HTMLDetailsElement && details !== createdDate && details.open) createdDate.open = false
      }, { capture: true, signal })
      createdDate.addEventListener("input", clearError, { signal })
      createdDate.querySelector("form")?.addEventListener("submit", event => {
        event.preventDefault()
        const range = normalizeTableCreationRange(createdFrom.value, createdThrough.value)
        if (!range) {
          createdError.hidden = false
          createdThrough.setAttribute("aria-invalid", "true")
          createdThrough.setAttribute("aria-describedby", createdError.id)
          createdThrough.focus()
          return
        }
        createdRange = { createdFrom: range.createdFrom, createdThrough: range.createdThrough }
        close()
        emitChange()
      }, { signal })
      createdDate.querySelector("[data-table-created-clear]")?.addEventListener("click", () => {
        createdRange = { createdFrom: undefined, createdThrough: undefined }
        close()
        emitChange()
      }, { signal })
    }

    // Debounce for search
    let searchTimer: ReturnType<typeof setTimeout> | undefined
    search?.addEventListener("input", () => {
      clearTimeout(searchTimer)
      searchTimer = setTimeout(() => {
        searchTimer = undefined
        emitChange()
      }, 150)
    }, { signal })

    search?.addEventListener("blur", () => {
      if (!searchTimer) return
      clearTimeout(searchTimer)
      searchTimer = undefined
      emitChange()
    }, { signal })

    // Select change listeners (for remaining native selects)
    ;[statusSel, prioritySel, riceSel, userSel, areaSel].forEach((sel) => {
      sel?.addEventListener("change", () => emitChange(), { signal })
    })

    signal.addEventListener("abort", () => clearTimeout(searchTimer), { once: true })

    function syncDropdown(details: HTMLDetailsElement, value: string) {
      const label = details.querySelector(".filter-dropdown__value")
      for (const option of details.querySelectorAll<HTMLButtonElement>(".filter-dropdown__option")) {
        const active = option.dataset.value === value
        option.classList.toggle("timeline-zoom-option--active", active)
        if (active && label) label.textContent = option.querySelector("span")?.textContent ?? option.textContent
      }
    }

    function syncSubGroupMenu() {
      if (!subGroupMenu || !subGroupBySel) return
      const primary = groupBySel?.value ?? "none"
      subGroupMenu.hidden = primary === "none"
      if (subGroupMenu.hidden) subGroupMenu.open = false
      if (subGroupMenu.hidden || subGroupBySel.value === primary) subGroupBySel.value = "none"
      for (const option of subGroupMenu.querySelectorAll<HTMLButtonElement>(".filter-dropdown__option")) {
        option.hidden = option.dataset.value === primary && primary !== "none"
      }
      syncDropdown(subGroupMenu, subGroupBySel.value)
    }

    const dropdowns = toolbar.querySelectorAll<HTMLDetailsElement>(".filter-dropdown")
    for (const details of dropdowns) {
      const summary = details.querySelector("summary")
      const close = () => {
        details.open = false
        summary?.focus()
      }
      details.addEventListener("keydown", event => {
        if (!details.open || event.key !== "Escape") return
        event.preventDefault()
        close()
      }, { signal })
      details.addEventListener("click", () => {
        for (const other of dropdowns) {
          if (other !== details) other.open = false
        }
      }, { signal })

      for (const button of details.querySelectorAll<HTMLButtonElement>(".filter-dropdown__option")) {
        button.addEventListener("click", event => {
          event.preventDefault()
          event.stopPropagation()
          if (button.hidden) return
          const value = button.dataset.value ?? ""
          const control = document.getElementById(button.dataset.select ?? "") as HTMLInputElement | null
          syncDropdown(details, value)
          if (control && control.value !== value) {
            control.value = value
            emitChange()
          }
          close()
        }, { signal })
      }
    }

    // Close dropdowns when clicking outside
    document.addEventListener("click", (e) => {
      const target = e.target as Node
      dropdowns.forEach(d => {
        if (!d.contains(target)) d.removeAttribute("open")
      })
    }, { signal })

    // Type toggle listeners
    typeToggles.forEach((btn) => {
      btn.addEventListener("click", () => {
        btn.classList.toggle("active")
        btn.setAttribute("aria-pressed", String(btn.classList.contains("active")))
        if (prefix === "calendar" && !toolbar.querySelector(".filter-toolbar__type-btn.active")) {
          for (const type of typeToggles) {
            if (type === btn) continue
            type.classList.add("active")
            type.setAttribute("aria-pressed", "true")
          }
        }
        emitChange()
      }, { signal })
    })

    if (prefix === "table" && clearBtn) {
      document.addEventListener("meitheal:table-clear-filters", () => {
        clearBtn.focus()
        clearBtn.click()
      }, { signal })
    }

    // Clear all button
    clearBtn?.addEventListener("click", () => {
      const restoreFilterFocus = (prefix === "table" || prefix === "calendar") && document.activeElement === clearBtn
      if (search) search.value = ""
      setPromoted(false)
      status = priority = rice = user = task_type = ""
      if (prefix !== "calendar") area = ""
      if (unassigned) unassigned.checked = false
      for (const option of laneOptions()) option.checked = false
      createdRange = { createdFrom: undefined, createdThrough: undefined }
      if (createdFrom) createdFrom.value = ""
      if (createdThrough) {
        createdThrough.value = ""
        createdThrough.removeAttribute("aria-invalid")
        createdThrough.removeAttribute("aria-describedby")
      }
      if (createdError) createdError.hidden = true
      labels = []
      renderInheritedFilters()
      if (prefix === "table") document.dispatchEvent(new Event("meitheal:table-labels-reset"))
      if (prefix === "calendar") document.dispatchEvent(new Event("meitheal:calendar-filters-reset"))
      ;[statusSel, prioritySel, riceSel, userSel, areaSel].forEach((sel) => {
        if (sel) sel.value = ""
      })
      if (groupBySel) groupBySel.value = "none"
      if (subGroupBySel) subGroupBySel.value = "none"
      if (sortBySel) sortBySel.value = "none"
      
      for (const details of dropdowns) {
        const option = details.querySelector<HTMLButtonElement>(".filter-dropdown__option")
        if (!option?.dataset.select) continue
        const control = document.getElementById(option.dataset.select) as HTMLInputElement | null
        syncDropdown(details, control?.value ?? "none")
      }

      typeToggles.forEach((btn) => {
        btn.classList.add("active")
        btn.setAttribute("aria-pressed", "true")
      })
      
      // Clear advanced filters too
      readOnlyRules = false
      updateRulesMode()
      if (advContainer) {
        const rows = advContainer.querySelectorAll(".advanced-filter-row")
        rows.forEach(r => r.remove())
        checkEmptyState()
      }
      advancedFilterState = null
      advToggleBtn?.classList.remove("filter-pill--active")

      emitChange(true)
      if (!appliedCreationDate || appliedCreationDate.hidden) clearBtn.classList.add("hidden")
      if (restoreFilterFocus) search?.focus()
    }, { signal })

    function setPromoted(value: boolean) {
      promoted = value
      promotedToggle?.setAttribute("aria-pressed", String(value))
      promotedToggle?.classList.toggle("filter-pill--active", value)
    }

    promotedToggle?.addEventListener("click", () => {
      setPromoted(!promoted)
      emitChange()
    }, { signal })
    
    if (filterToggle) {
      filterToggle.hidden = false
      filterToggle.addEventListener("click", () => {
        filterToggle.setAttribute("aria-expanded", String(filterToggle.getAttribute("aria-expanded") !== "true"))
      }, { signal })
    }

    // Escape acts on the filter controls that currently own keyboard focus.
    document.addEventListener("keydown", (e) => {
      const target = e.target
      if (e.key !== "Escape" || e.defaultPrevented || !(target instanceof Node) ||
          !(toolbar.contains(target) || filterToggle?.contains(target))) return
      if (advPanel?.contains(target) && !advPanel.classList.contains("hidden")) {
        e.preventDefault()
        closeAdvancedPanel(true)
        return
      }
      if (filterToggle?.getClientRects().length) {
        if (filterToggle.getAttribute("aria-expanded") === "true") {
          e.preventDefault()
          filterToggle.setAttribute("aria-expanded", "false")
          filterToggle.focus()
        }
        return
      }
      if (createdDate?.open) {
        e.preventDefault()
        dismissCreationDraft?.()
        return
      }
      if (clearBtn && !clearBtn.classList.contains("hidden") &&
          !(target instanceof Element && target.matches("input, textarea"))) {
        e.preventDefault()
        clearBtn.click()
      }
    }, { signal })

    // Load boards into board selector (idempotent via DOM attribute)
    async function loadAreas() {
      if (!areaSel || areaSel.dataset.populated) return
      areaSel.dataset.populated = "true"
      
      try {
        const res = await fetch("/api/areas", { signal })
        if (!res.ok) return
        const data = await res.json()
        const boards: { id: string; name: string; icon?: string }[] = data.areas || []
        
        boards.forEach((b) => {
          const opt = document.createElement("option")
          opt.value = b.id
          opt.textContent = b.name
          areaSel.appendChild(opt)
        })
      } catch { /* offline fallback */ }
    }

    if (prefix === "timeline") {
      document.addEventListener("meitheal:area-changed", event => {
        timelineArea = (event as CustomEvent<{ areaId: string }>).detail.areaId
        updateClearVisibility()
      }, { signal })
    }
    if (prefix === "table" || prefix === "calendar") {
      document.addEventListener("meitheal:label-filter", event => {
        const detail = (event as CustomEvent<{ view: string; labels: string[] }>).detail
        if (detail?.view !== prefix) return
        const previousLabels = labels
        labels = detail.labels
        if (prefix === "calendar" && !emitChange()) {
          labels = previousLabels
          event.preventDefault()
        }
        updateClearVisibility()
      }, { signal })
      document.addEventListener("meitheal:area-changed", event => {
        area = (event as CustomEvent<{ areaId: string }>).detail.areaId
        updateClearVisibility()
      }, { signal })
      renderInheritedFilters()
      updateRulesMode()
    }
    {
      for (const groupControl of [groupBySel, subGroupBySel]) {
        if (!groupControl || groupControl.value === "none") continue
        const groupValue = groupControl.value
        const option = Array.from(toolbar.querySelectorAll<HTMLButtonElement>(".filter-dropdown__option"))
          .find(item => item.dataset.select === groupControl.id && item.dataset.value === groupValue)
        const label = option?.closest("details")?.querySelector(".filter-dropdown__value")
        if (option && label) {
          option.closest("details")?.querySelector(".timeline-zoom-option--active")?.classList.remove("timeline-zoom-option--active")
          option.classList.add("timeline-zoom-option--active")
          label.textContent = option.textContent?.trim() ?? groupValue
        } else if (prefix === "timeline") {
          groupControl.value = "none"
        }
      }
      syncSubGroupMenu()
      renderSavedRules()
      updateLaneCount()
      updateClearVisibility()
    }

    function renderSavedRules() {
      advContainer?.querySelectorAll(".advanced-filter-row").forEach(row => row.remove())
      if (advContainer && advancedFilterState?.conditions.length) {
        for (const condition of readOnlyRules ? [] : advancedFilterState.conditions) {
          if ("conditions" in condition) continue
          const row = renderAdvancedConditionRow()
          const field = row.querySelector<HTMLSelectElement>(".adv-field")
          const op = row.querySelector<HTMLSelectElement>(".adv-op")
          const value = row.querySelector<HTMLInputElement>(".adv-val")
          const logic = row.querySelector<HTMLButtonElement>(".adv-logic")
          if (field) field.value = condition.field
          if (op) {
            op.value = condition.operator
            op.dispatchEvent(new Event("change"))
          }
          if (value) value.value = String(condition.value)
          if (logic && (condition.logic ?? advancedFilterState.logic) === "OR") logic.click()
          advContainer.append(row)
        }
      }
      advToggleBtn?.classList.toggle("filter-pill--active", Boolean(advancedFilterState?.conditions.length))
      checkEmptyState()
    }
    if (prefix === "calendar") {
      if (search) search.disabled = false
      document.addEventListener(CALENDAR_FILTER_STATE_EVENT, event => {
        const filters = (event as CustomEvent<KanbanFilters & { keepSearch: boolean; keepRulesDraft: boolean }>).detail
        ;({ status = "", priority = "", rice = "", user = "", task_type = "", labels = [] } = filters)
        if (search && !searchTimer && !filters.keepSearch) search.value = filters.search ?? ""
        if (statusSel) statusSel.value = status
        if (prioritySel) prioritySel.value = priority
        setTypeButtons(filters.types ?? [])
        setPromoted(filters.promoted ?? false)
        const restoredRules = filters.advancedFilter ?? null
        const rulesChanged = JSON.stringify(advancedFilterState) !== JSON.stringify(restoredRules)
        advancedFilterState = restoredRules
        readOnlyRules = advancedFilterState?.conditions.some(condition =>
          "conditions" in condition || condition.operator === "between") ?? false
        renderInheritedFilters()
        updateRulesMode()
        if (filters.keepRulesDraft || (!rulesChanged && advPanel && !advPanel.classList.contains("hidden"))) {
          advToggleBtn?.classList.toggle("filter-pill--active", Boolean(advancedFilterState?.conditions.length))
        } else renderSavedRules()
        updateClearVisibility()
      }, { signal })
    }
    loadAreas()
  }

  pageLifecycle.onPageLoad(signal => {
    document.querySelectorAll<HTMLElement>(".filter-toolbar").forEach(toolbar => {
      if (toolbar.dataset.initialized) return
      toolbar.dataset.initialized = "true"
      signal.addEventListener("abort", () => { delete toolbar.dataset.initialized }, { once: true })
      initFilterToolbar(toolbar, signal)
    })
  })
</script>


