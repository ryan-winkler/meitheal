---
interface Props {
  activeLabels?: string[]
  id?: string
  view?: string
}
const { activeLabels = [], id = "label-filter-bar", view = "" } = Astro.props
---

<details class="label-filter-panel" id={id} data-active={JSON.stringify(activeLabels)} data-view={view}>
  <summary class="filter-pill"><span data-label-summary>Labels</span></summary>
  <div class="label-filter" aria-label="Filter by label">
    <button type="button" class="label-filter__chip" data-clear-labels>Clear labels</button>
    <span class="text-sm text-text-muted" data-label-status role="status"></span>
  </div>
</details>

<script>
  import { loadTableFilterState } from "@lib/filter-state"
  import { pageLifecycle } from "@lib/page-lifecycle"

  type Label = { title: string; hex_color?: string }

  pageLifecycle.onPageLoad(signal => {
    document.querySelectorAll<HTMLDetailsElement>(".label-filter-panel").forEach(panel => {
      const bar = panel.querySelector<HTMLElement>(".label-filter")
      const summary = panel.querySelector<HTMLElement>("[data-label-summary]")
      const status = panel.querySelector<HTMLElement>("[data-label-status]")
      const clear = panel.querySelector<HTMLButtonElement>("[data-clear-labels]")
      if (!bar || !summary || !status || !clear || panel.dataset.ready) return
      panel.dataset.ready = "true"
      signal.addEventListener("abort", () => { delete panel.dataset.ready }, { once: true })

      const view = panel.dataset.view
      let active = new Set<string>(view === "table" ? loadTableFilterState().labels : JSON.parse(panel.dataset.active ?? "[]"))
      const labels = new Map<string, Label>()
      const buttons = new Map<string, HTMLButtonElement>()
      let loaded = false
      let loading = false

      function render() {
        const available = new Set([...labels.keys(), ...active])
        for (const [name, button] of buttons) {
          if (available.has(name)) continue
          if (document.activeElement === button) clear!.focus()
          button.remove()
          buttons.delete(name)
        }

        for (const name of available) {
          let button = buttons.get(name)
          if (!button) {
            button = document.createElement("button")
            button.type = "button"
            button.className = "label-filter__chip max-w-full break-all"
            button.dataset.label = name
            buttons.set(name, button)
            bar!.append(button)
          }
          const label = labels.get(name)
          const text = loaded && !label ? `${name} (unavailable)` : name
          if (button.textContent !== text) button.textContent = text
          button.classList.toggle("label-filter__chip--active", active.has(name))
          button.setAttribute("aria-pressed", String(active.has(name)))
        }
        clear!.classList.toggle("label-filter__chip--active", !active.size)
        summary!.textContent = active.size ? `Labels (${active.size})` : "Labels"
      }

      async function loadLabels() {
        if (loaded || loading) return
        loading = true
        status!.textContent = "Loading labels…"
        try {
          const response = await fetch("/api/labels", { signal })
          if (!response.ok) throw new Error("Labels unavailable")
          const data = await response.json()
          if (signal.aborted) return
          const entries: Label[] = Array.isArray(data) ? data : data.labels ?? []
          for (const entry of entries) if (typeof entry.title === "string") labels.set(entry.title, entry)
          loaded = true
          status!.textContent = labels.size ? "" : "No labels yet"
          render()
        } catch {
          if (!signal.aborted) status!.textContent = "Labels unavailable. Reopen to retry."
        } finally {
          loading = false
        }
      }

      panel.addEventListener("toggle", () => {
        if (panel.open) void loadLabels()
      }, { signal })
      bar.addEventListener("click", event => {
        const button = (event.target as Element).closest<HTMLButtonElement>("button")
        if (!button) return
        const name = button.dataset.label
        if (button === clear) active.clear()
        else if (name && !active.delete(name)) active.add(name)
        render()
        document.dispatchEvent(new CustomEvent("meitheal:label-filter", {
          detail: { labels: [...active], view },
        }))
      }, { signal })
      if (view === "table") {
        document.addEventListener("meitheal:table-labels-reset", () => {
          active = new Set()
          render()
        }, { signal })
      }
      render()
    })
  })
</script>
