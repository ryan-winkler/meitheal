---
import { getTypeIconConfig } from "@lib/type-icon-config"
import {
  isIconName,
  resolveCanonicalIconName,
  type CanonicalIconName,
} from "../../generated/icon-registry"

interface Props {
  type: string | null | undefined
  size?: number | undefined
  class?: string | undefined
  role?: "img" | undefined
  icon?: string | null | undefined
}

const { type, size = 16, class: className = "", role, icon } = Astro.props
const typeStr = String(type || "task").toLowerCase()
const config = getTypeIconConfig(type)

const customRaw = typeof icon === "string" ? icon.trim() : ""
const spriteIconName: CanonicalIconName | null = customRaw
  ? isIconName(customRaw)
    ? resolveCanonicalIconName(customRaw)
    : null
  : resolveCanonicalIconName(config.iconName)

if (spriteIconName) {
  ;(Astro.locals.usedIcons ??= new Set()).add(spriteIconName)
}
---

<span
  class:list={["task-type-icon", className]}
  role={role}
  style={`color: ${config.color}; width: ${size}px; height: ${size}px; display: inline-flex; align-items: center; justify-content: center;`}
  title={typeStr.charAt(0).toUpperCase() + typeStr.slice(1)}
  aria-label={role === "img" ? `Task Type: ${typeStr}` : undefined}
  aria-hidden={role === "img" ? undefined : "true"}
>
  {spriteIconName ? (
    <svg
      aria-hidden="true"
      xmlns="http://www.w3.org/2000/svg"
      width={size}
      height={size}
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="1.75"
      stroke-linecap="round"
      stroke-linejoin="round"
      vector-effect="non-scaling-stroke"
    >
      <use href={"#mt-icon-" + spriteIconName} />
    </svg>
  ) : (
    <span aria-hidden="true" style={`font-size: ${Math.max(12, size - 2)}px; line-height: 1;`}>
      {customRaw}
    </span>
  )}
</span>
