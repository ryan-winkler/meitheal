---
import Icon from "./Icon.astro"
import { isIconName } from "../../generated/icon-registry"

interface Props {
  title: string
  description: string
  icon?: string | undefined
  actionText?: string | undefined
  actionHref?: string | undefined
  /** When set, renders a <button> that dispatches this custom event instead of an <a> link */
  actionEvent?: string | undefined
}

const {
  title,
  description,
  icon = "clipboard-list",
  actionText,
  actionHref,
  actionEvent,
} = Astro.props
---

<div class="empty-state">
  <div class="empty-state-icon">
    <slot name="icon">
      {isIconName(icon) ? (
        <Icon name={icon} size={48} class="text-text-muted/40" />
      ) : (
        <span aria-hidden="true" style="font-size: 40px; line-height: 1;">{icon}</span>
      )}
    </slot>
  </div>
  <h3 class="empty-state-title">{title}</h3>
  <p class="empty-state-desc">{description}</p>
  {
    actionText && actionEvent ? (
      <div class="empty-state-actions">
        <button
          type="button"
          class="btn-primary"
          data-empty-action={actionEvent}
        >
          {actionText}
        </button>
      </div>
    ) : actionText && actionHref ? (
      <div class="empty-state-actions">
        <a href={actionHref} class="btn-primary">
          {actionText}
        </a>
      </div>
    ) : null
  }
</div>

<script>
  import { pageLifecycle } from "@lib/page-lifecycle"

  pageLifecycle.onPageLoad((signal) => {
    document
      .querySelectorAll<HTMLButtonElement>("[data-empty-action]")
      .forEach((btn) => {
        btn.addEventListener(
          "click",
          () => {
            const eventName = btn.dataset.emptyAction
            if (eventName) {
              document.dispatchEvent(new CustomEvent(eventName))
            }
          },
          { signal }
        )
      })
  })
</script>
