---
/**
 * CardCustomizer — Field visibility control for Kanban cards
 *
 * @domain tasks
 * @bounded-context tasks/ui
 *
 * Emits `meitheal:card-fields-change` CustomEvent when visibility changes.
 */
interface Props {
  class?: string
}
const { class: className } = Astro.props
---

<div class={`card-customizer ${className ?? ''}`}>
  <div class="card-customizer__panel" id="card-customizer-panel" role="region" aria-label="Card Customization">
    <div class="card-customizer__header">
      <h4>Customize Cards</h4>
      <button type="button" class="btn-icon" id="card-customizer-close" aria-label="Close panel">
        <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 6 6 18"/><path d="m6 6 12 12"/></svg>
      </button>
    </div>

    <!-- Card density selector -->
    <div class="card-customizer__density" id="card-density-selector">
      <span class="card-customizer__section-label">Card Size</span>
      <div class="card-customizer__density-group" role="radiogroup" aria-label="Card density">
        <button type="button" class="card-density-btn" data-density="compact" title="Compact cards" role="radio" aria-checked="false">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="3" y1="8" x2="21" y2="8"/><line x1="3" y1="12" x2="21" y2="12"/><line x1="3" y1="16" x2="21" y2="16"/></svg>
          Compact
        </button>
        <button type="button" class="card-density-btn active" data-density="comfortable" title="Comfortable cards" role="radio" aria-checked="true">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="18" height="7" rx="1"/><rect x="3" y="14" width="18" height="7" rx="1"/></svg>
          Comfortable
        </button>
        <button type="button" class="card-density-btn" data-density="spacious" title="Spacious cards" role="radio" aria-checked="false">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="18" height="18" rx="2"/></svg>
          Spacious
        </button>
      </div>
    </div>

    <div class="card-customizer__divider"></div>

    <span class="card-customizer__section-label" style="padding: 0.5rem 0.75rem 0;">Visible Fields</span>
    <ul class="card-customizer__list" id="card-customizer-list">
      <!-- Populated by JS -->
    </ul>

    <div class="card-customizer__footer">
      <button type="button" class="btn text-xs" id="card-customizer-reset">
        Reset Defaults
      </button>
    </div>
  </div>
</div>

<style>
/* Reusing column-customizer styles but scoped */
.card-customizer {
  display: block;
}

.card-customizer__panel {
  background: var(--surface);
  border: 1px solid var(--border);
  border-radius: var(--radius-md);
  box-shadow: var(--shadow-lg);
  width: 100%;
  display: flex;
  flex-direction: column;
}
.card-customizer__header {
  padding: 0.75rem;
  border-bottom: 1px solid var(--border);
  display: flex;
  justify-content: space-between;
  align-items: center;
}
.card-customizer__header h4 {
  margin: 0;
  font-size: 0.875rem;
  font-weight: 600;
}
.card-customizer__list {
  list-style: none;
  margin: 0;
  padding: 0.5rem;
  max-height: 300px;
  overflow-y: auto;
}
.card-customizer__item {
  padding: 0.25rem 0;
}
.card-customizer__label {
  display: flex;
  align-items: center;
  gap: 0.5rem;
  font-size: 0.875rem;
  cursor: pointer;
  user-select: none;
  color: var(--text);
  padding: 0.25rem;
  border-radius: var(--radius-sm);
}
.card-customizer__label:hover {
  background: var(--surface-hover);
}
.card-customizer__label input:disabled ~ span {
  opacity: 0.5;
}
.card-customizer__footer {
  padding: 0.5rem;
  border-top: 1px solid var(--border);
  display: flex;
  justify-content: center;
  background: var(--surface-raised);
  border-bottom-left-radius: var(--radius-md);
  border-bottom-right-radius: var(--radius-md);
}

/* Density selector */
.card-customizer__density {
  padding: 0.5rem 0.75rem;
}
.card-customizer__section-label {
  display: block;
  font-size: 0.7rem;
  font-weight: 600;
  text-transform: uppercase;
  letter-spacing: 0.05em;
  color: var(--text-muted);
  margin-bottom: 0.375rem;
}
.card-customizer__density-group {
  display: flex;
  gap: 2px;
  background: var(--bg-primary);
  border-radius: var(--radius-sm);
  padding: 2px;
}
.card-density-btn {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 0.25rem;
  padding: 0.25rem 0.5rem;
  border: none;
  border-radius: var(--radius-sm);
  background: transparent;
  color: var(--text-muted);
  font-size: 0.75rem;
  cursor: pointer;
  transition: all 150ms ease;
  white-space: nowrap;
}
.card-density-btn:hover {
  color: var(--text);
  background: var(--surface-hover);
}
.card-density-btn.active {
  background: var(--accent);
  color: var(--accent-contrast, #fff);
  font-weight: 500;
}
.card-customizer__divider {
  height: 1px;
  background: var(--border);
  margin: 0 0.75rem;
}
</style>

<script>
  const FIELD_PREFS_KEY = "meitheal-kanban-fields-preferences"
  const DENSITY_KEY = "meitheal-kanban-card-density"
  const VALID_DENSITIES = ["compact", "comfortable", "spacious"] as const
  type CardDensity = typeof VALID_DENSITIES[number]
  const DEFAULT_DENSITY: CardDensity = "comfortable"

  // [F1] AbortController for listener cleanup on soft navigation re-init
  let customizerAbort: AbortController | null = null

  function loadDensity(): CardDensity {
    try {
      const stored = localStorage.getItem(DENSITY_KEY)
      if (stored && VALID_DENSITIES.includes(stored as CardDensity)) return stored as CardDensity
    } catch { /* localStorage may throw in private browsing — use default */ }
    return DEFAULT_DENSITY
  }

  function saveDensity(density: CardDensity) {
    localStorage.setItem(DENSITY_KEY, density)
  }

  function applyDensity(density: CardDensity) {
    const board = document.querySelector(".kanban-board")
    if (!board) return
    VALID_DENSITIES.forEach(d => board.classList.remove(`density-${d}`))
    board.classList.add(`density-${density}`)
    // Update button active states + ARIA [F2]
    document.querySelectorAll<HTMLButtonElement>(".card-density-btn").forEach(btn => {
      const isSelected = btn.dataset.density === density
      btn.classList.toggle("active", isSelected)
      btn.setAttribute("aria-checked", String(isSelected))
    })
  }

  // IDs correspond to CSS classes that will be toggled on the board: hide-field-{id}
  const ALL_FIELDS = [
    { id: "key", label: "Ticket Key", alwaysVisible: false, defaultVisible: true },
    { id: "type", label: "Task Type", alwaysVisible: false, defaultVisible: true },
    { id: "priority", label: "Priority", alwaysVisible: false, defaultVisible: true },
    { id: "due-date", label: "Due Date", alwaysVisible: false, defaultVisible: true },
    { id: "rice", label: "RICE Score", alwaysVisible: false, defaultVisible: true },
    { id: "sync", label: "Sync Status", alwaysVisible: false, defaultVisible: true },
    { id: "subtasks", label: "Subtasks", alwaysVisible: false, defaultVisible: true }
  ]

  function loadFieldPrefs(): Record<string, boolean> {
    try {
      return JSON.parse(localStorage.getItem(FIELD_PREFS_KEY) ?? "{}")
    } catch {
      return {}
    }
  }

  function saveFieldPrefs(prefs: Record<string, boolean>) {
    localStorage.setItem(FIELD_PREFS_KEY, JSON.stringify(prefs))
  }

  function applyFieldVisibility() {
    const prefs = loadFieldPrefs()
    const area = document.querySelector(".kanban-board")
    if (!area) return

    ALL_FIELDS.forEach(field => {
      const isVisible = field.alwaysVisible || (prefs[field.id] !== undefined ? prefs[field.id] : field.defaultVisible)
      area.classList.toggle(`hide-field-${field.id}`, !isVisible)
    })
  }

  function renderFieldList() {
    const list = document.getElementById("card-customizer-list")
    if (!list) return
    list.replaceChildren() // [F4] Modern DOM clearing, no innerHTML

    const prefs = loadFieldPrefs()

    ALL_FIELDS.forEach(field => {
      const li = document.createElement("li")
      li.className = "card-customizer__item"

      const label = document.createElement("label")
      label.className = "card-customizer__label"

      const checkbox = document.createElement("input")
      checkbox.type = "checkbox"
      checkbox.dataset.fieldId = field.id
      checkbox.checked = field.alwaysVisible || (prefs[field.id] !== undefined ? Boolean(prefs[field.id]) : field.defaultVisible)
      checkbox.disabled = field.alwaysVisible

      const span = document.createElement("span")
      span.textContent = field.label
      if (field.alwaysVisible) {
        span.classList.add("text-text-muted")
      }

      checkbox.addEventListener("change", () => {
        const currentPrefs = loadFieldPrefs()
        currentPrefs[field.id] = checkbox.checked
        saveFieldPrefs(currentPrefs)
        applyFieldVisibility()
      })

      label.append(checkbox, span)
      li.appendChild(label)
      list.appendChild(li)
    })
  }

  document.addEventListener("astro:page-load", () => {
    // [F1] Abort previous listeners on soft navigation re-init
    customizerAbort?.abort()
    customizerAbort = new AbortController()
    const signal = customizerAbort.signal

    const resetBtn = document.getElementById("card-customizer-reset")
    const panel = document.getElementById("card-customizer-panel")

    if (!panel) return

    renderFieldList()
    applyFieldVisibility() // Apply initial state on load

    // Card density mode
    const initialDensity = loadDensity()
    applyDensity(initialDensity)
    document.querySelectorAll<HTMLButtonElement>(".card-density-btn").forEach(btn => {
      btn.addEventListener("click", () => {
        const density = btn.dataset.density as CardDensity
        if (density && VALID_DENSITIES.includes(density)) {
          saveDensity(density)
          applyDensity(density)
        }
      }, { signal })
    })

    // Close button handler moved to tasks.astro (co-located with toggle/escape/click-outside)

    if (resetBtn) {
      resetBtn.addEventListener("click", () => {
        localStorage.removeItem(FIELD_PREFS_KEY)
        localStorage.removeItem(DENSITY_KEY)
        renderFieldList()
        applyFieldVisibility()
        applyDensity(DEFAULT_DENSITY)
      }, { signal })
    }
  })
</script>
