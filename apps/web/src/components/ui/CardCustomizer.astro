---
/**
 * CardCustomizer — Field visibility control for Kanban cards
 *
 * @domain tasks
 * @bounded-context tasks/ui
 *
 * Emits `meitheal:card-fields-change` CustomEvent when visibility changes.
 */
interface Props {
  class?: string
  boardId: string
  cardFieldNames: string[]
}
const { class: className, boardId, cardFieldNames } = Astro.props
---

<div class={`card-customizer ${className ?? ''}`} data-board-id={boardId} data-card-field-names={JSON.stringify(cardFieldNames)}>
  <div class="card-customizer__panel" id="card-customizer-panel" role="region" aria-label="Card Customization">
    <div class="card-customizer__header">
      <h4>Customize Cards</h4>
      <button type="button" class="btn-icon" id="card-customizer-close" aria-label="Close panel">
        <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 6 6 18"/><path d="m6 6 12 12"/></svg>
      </button>
    </div>

    <!-- Card density selector -->
    <div class="card-customizer__density" id="card-density-selector">
      <span class="card-customizer__section-label">Card Size</span>
      <div class="card-customizer__density-group" role="radiogroup" aria-label="Card density">
        <button type="button" class="card-density-btn" data-density="compact" title="Compact cards" role="radio" aria-checked="false">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="3" y1="8" x2="21" y2="8"/><line x1="3" y1="12" x2="21" y2="12"/><line x1="3" y1="16" x2="21" y2="16"/></svg>
          Compact
        </button>
        <button type="button" class="card-density-btn active" data-density="comfortable" title="Comfortable cards" role="radio" aria-checked="true">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="18" height="7" rx="1"/><rect x="3" y="14" width="18" height="7" rx="1"/></svg>
          Comfortable
        </button>
        <button type="button" class="card-density-btn" data-density="spacious" title="Spacious cards" role="radio" aria-checked="false">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="18" height="18" rx="2"/></svg>
          Spacious
        </button>
      </div>
    </div>

    <div class="card-customizer__divider"></div>

    <div class="card-customizer__search-wrap">
      <input
        type="search"
        id="card-customizer-search"
        class="card-customizer__search"
        placeholder="Search all fields…"
        aria-label="Search card fields"
        autocomplete="off"
      />
    </div>

    <span class="card-customizer__section-label card-customizer__section-label--padded" id="card-customizer-builtin-label">Visible Fields</span>
    <ul class="card-customizer__list" id="card-customizer-list">
      <!-- Populated by JS -->
    </ul>

    <div class="card-customizer__divider" id="card-customizer-cf-divider" hidden></div>
    <span class="card-customizer__section-label card-customizer__section-label--padded" id="card-customizer-cf-label" hidden>Board Custom Fields (max 4)</span>
    <ul class="card-customizer__list" id="card-customizer-cf-list" hidden></ul>
    <p class="card-customizer__empty" id="card-customizer-empty" hidden>No matching fields</p>

    <div class="card-customizer__footer">
      <button type="button" class="btn text-xs" id="card-customizer-reset">
        Reset Defaults
      </button>
    </div>
  </div>
</div>

<style is:global>
/* Reusing column-customizer styles but scoped by .card-customizer BEM classes */
.card-customizer {
  display: block;
}

.card-customizer__panel {
  background: var(--bg-card);
  color: var(--text-primary);
  border: 1px solid var(--border);
  border-radius: var(--radius-md);
  box-shadow: var(--shadow-lg);
  width: 100%;
  display: flex;
  flex-direction: column;
}
.card-customizer__header {
  padding: 0.75rem;
  border-bottom: 1px solid var(--border);
  display: flex;
  justify-content: space-between;
  align-items: center;
}
.card-customizer__header h4 {
  margin: 0;
  font-size: 0.875rem;
  font-weight: 600;
}
.card-customizer__list {
  list-style: none;
  margin: 0;
  padding: 0.5rem;
  max-height: 300px;
  overflow-y: auto;
}
.card-customizer__item {
  padding: 0.25rem 0;
}
.card-customizer__label {
  display: flex;
  align-items: center;
  gap: 0.5rem;
  font-size: 0.875rem;
  cursor: pointer;
  user-select: none;
  color: var(--text-primary);
  padding: 0.25rem;
  border-radius: var(--radius-sm);
}
.card-customizer__label input[type="checkbox"] {
  accent-color: var(--accent);
  flex-shrink: 0;
  margin: 0;
}
.card-customizer__label:hover {
  background: var(--bg-hover);
}
.card-customizer__label input:disabled ~ span {
  opacity: 0.5;
}
.card-customizer__footer {
  padding: 0.5rem;
  border-top: 1px solid var(--border);
  display: flex;
  justify-content: center;
  background: var(--bg-secondary);
  border-bottom-left-radius: var(--radius-md);
  border-bottom-right-radius: var(--radius-md);
}

/* Density selector */
.card-customizer__density {
  padding: 0.5rem 0.75rem;
}
.card-customizer__section-label {
  display: block;
  font-size: 0.7rem;
  font-weight: 600;
  text-transform: uppercase;
  letter-spacing: 0.05em;
  color: var(--text-muted);
  margin-bottom: 0.375rem;
}
.card-customizer__section-label--padded {
  padding: 0.5rem 0.75rem 0;
}
.card-customizer__density-group {
  display: flex;
  gap: 2px;
  background: var(--bg-primary);
  border-radius: var(--radius-sm);
  padding: 2px;
}
.card-density-btn {
  flex: 1 1 0;
  min-width: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 0.25rem;
  padding: 0.25rem 0.375rem;
  border: none;
  border-radius: var(--radius-sm);
  background: transparent;
  color: var(--text-muted);
  font-size: 0.75rem;
  cursor: pointer;
  transition: color 150ms ease, background 150ms ease;
  white-space: nowrap;
}
.card-density-btn:hover {
  color: var(--text-primary);
  background: var(--bg-hover);
}
.card-density-btn.active {
  background: var(--accent);
  color: var(--personal-accent-foreground, var(--palette-on-accent, #07140f));
  font-weight: 500;
}
.card-customizer__divider {
  height: 1px;
  background: var(--border);
  margin: 0 0.75rem;
}
.card-customizer__search-wrap {
  padding: 0.5rem 0.75rem 0.25rem;
}
.card-customizer__search {
  width: 100%;
  box-sizing: border-box;
  padding: 0.375rem 0.625rem;
  font-size: 0.8125rem;
  border-radius: var(--radius-sm);
  border: 1px solid var(--border);
  background: var(--bg-input, var(--bg-primary));
  color: var(--text-primary);
}
.card-customizer__search:focus {
  outline: none;
  border-color: var(--accent);
}
.card-customizer__empty {
  margin: 0;
  padding: 0.625rem 0.75rem;
  font-size: 0.8125rem;
  color: var(--text-muted);
  text-align: center;
}
</style>

<script>
  import {
    cardCustomFieldLabel,
    KANBAN_CARD_FIELDS_PREFIX,
    MAX_KANBAN_CARD_CUSTOM_FIELDS,
    parseVisibleCardCustomFields,
  } from "@lib/custom-field-defs"
  import { applyCardPreferencesToRoot, CARD_DENSITY_KEY, CARD_FIELD_PREFS_KEY, readCardDensity, readCardFieldPrefs, type SharedCardDensity } from "@lib/card-view-sync"
  import { pageLifecycle } from "@lib/page-lifecycle"
  import { showToast } from "@lib/toast"

  // [F1] AbortController for listener cleanup on soft navigation re-init
  let customizerAbort: AbortController | null = null

  function applyDensityButtons(density: SharedCardDensity) {
    document.querySelectorAll<HTMLButtonElement>(".card-density-btn").forEach(btn => {
      const isSelected = btn.dataset.density === density
      btn.classList.toggle("active", isSelected)
      btn.setAttribute("aria-checked", String(isSelected))
    })
  }

  const FIELD_LABELS = {
    key: "Ticket Key",
    type: "Task Type",
    description: "Description",
    priority: "Priority",
    "due-date": "Due Date",
    assignee: "Assignee",
    labels: "Labels",
    rice: "RICE Score",
    sync: "Sync Status",
    subtasks: "Subtasks",
    checklist: "Checklist",
    comments: "Comments",
    progress: "Progress Bar",
  }

  function activeBoardId(): string {
    return document.querySelector<HTMLElement>(".card-customizer")?.dataset.boardId ?? "household"
  }

  function loadBoardCustomFieldSelection(): string[] | null {
    try {
      return parseVisibleCardCustomFields(localStorage.getItem(`${KANBAN_CARD_FIELDS_PREFIX}${activeBoardId()}`))
    } catch {
      return null
    }
  }

  function saveBoardCustomFieldSelection(fields: string[]): void {
    localStorage.setItem(`${KANBAN_CARD_FIELDS_PREFIX}${activeBoardId()}`, JSON.stringify(fields.slice(0, MAX_KANBAN_CARD_CUSTOM_FIELDS)))
  }

  function applyCustomFieldVisibility() {
    const area = document.querySelector(".kanban-board")
    if (!area) return
    const selected = loadBoardCustomFieldSelection()
    const selectedLower = selected ? new Set(selected.map(name => name.toLowerCase())) : null
    area.querySelectorAll<HTMLElement>("[data-card-fields]").forEach(container => {
      let shown = false
      for (const chip of container.querySelectorAll<HTMLElement>("[data-cf-name]")) {
        const visible = selectedLower ? selectedLower.has(chip.dataset.cfName!.toLowerCase()) : !chip.hasAttribute("data-cf-default-hidden")
        chip.hidden = !visible
        shown ||= visible
      }
      container.hidden = !shown
    })
  }

  function applyFieldVisibility() {
    applyCardPreferencesToRoot(document.getElementById("kanban-board"))
    applyCustomFieldVisibility()
  }

  function appendCustomizerCheckbox(
    list: HTMLElement,
    opts: { attr: "fieldId" | "customFieldName"; value: string; labelText: string; checked: boolean },
    onChange: (checkbox: HTMLInputElement) => void,
    signal: AbortSignal,
  ) {
    const li = document.createElement("li")
    li.className = "card-customizer__item"
    li.dataset.searchText = `${opts.labelText} ${opts.value}`.toLowerCase()
    const label = document.createElement("label")
    label.className = "card-customizer__label"
    const checkbox = document.createElement("input")
    checkbox.type = "checkbox"
    checkbox.dataset[opts.attr] = opts.value
    checkbox.checked = opts.checked
    const span = document.createElement("span")
    span.textContent = opts.labelText
    checkbox.addEventListener("change", () => onChange(checkbox), { signal })
    label.append(checkbox, span)
    li.appendChild(label)
    list.appendChild(li)
  }

  function applyFieldSearchFilter() {
    const searchInput = document.getElementById("card-customizer-search") as HTMLInputElement | null
    const query = (searchInput?.value ?? "").trim().toLowerCase()
    const builtinList = document.getElementById("card-customizer-list")
    const builtinLabel = document.getElementById("card-customizer-builtin-label")
    const cfList = document.getElementById("card-customizer-cf-list")
    const cfLabel = document.getElementById("card-customizer-cf-label")
    const cfDivider = document.getElementById("card-customizer-cf-divider")
    const emptyEl = document.getElementById("card-customizer-empty")

    const filterList = (ul: HTMLElement | null): number => {
      if (!ul) return 0
      let visible = 0
      ul.querySelectorAll<HTMLLIElement>(".card-customizer__item").forEach(li => {
        const match = !query || (li.dataset.searchText ?? "").includes(query)
        li.hidden = !match
        if (match) visible++
      })
      return visible
    }

    const visibleBuiltIn = filterList(builtinList)
    const visibleCf = filterList(cfList)
    if (builtinLabel) builtinLabel.hidden = visibleBuiltIn === 0
    if (builtinList) builtinList.hidden = visibleBuiltIn === 0
    if (cfLabel) cfLabel.hidden = visibleCf === 0
    if (cfList) cfList.hidden = visibleCf === 0
    if (cfDivider) cfDivider.hidden = visibleBuiltIn === 0 || visibleCf === 0
    if (emptyEl) emptyEl.hidden = visibleBuiltIn + visibleCf > 0
  }

  function renderBoardCustomFieldList(names: string[], signal: AbortSignal) {
    const list = document.getElementById("card-customizer-cf-list")
    if (!list) return
    list.replaceChildren()

    const savedSelection = loadBoardCustomFieldSelection()
    const defaultSelected = names.slice(0, MAX_KANBAN_CARD_CUSTOM_FIELDS)
    const activeLower = new Set((savedSelection ?? defaultSelected).map(name => name.toLowerCase()))

    for (const name of names) {
      appendCustomizerCheckbox(list, {
        attr: "customFieldName",
        value: name,
        labelText: cardCustomFieldLabel(name),
        checked: activeLower.has(name.toLowerCase()),
      }, checkbox => {
        const checked = Array.from(list.querySelectorAll<HTMLInputElement>("input[data-custom-field-name]"))
          .filter(el => el.checked)
          .map(el => el.dataset.customFieldName!)
        if (checked.length > MAX_KANBAN_CARD_CUSTOM_FIELDS) {
          checkbox.checked = false
          showToast(`Up to ${MAX_KANBAN_CARD_CUSTOM_FIELDS} custom fields can be shown on cards`, "info")
          return
        }
        saveBoardCustomFieldSelection(checked)
        applyCustomFieldVisibility()
      }, signal)
    }
  }

  function renderFieldList(signal: AbortSignal) {
    const list = document.getElementById("card-customizer-list")
    if (!list) return
    list.replaceChildren()

    const prefs = readCardFieldPrefs()

    for (const [id, labelText] of Object.entries(FIELD_LABELS)) {
      appendCustomizerCheckbox(list, {
        attr: "fieldId",
        value: id,
        labelText,
        checked: prefs[id] !== false,
      }, checkbox => {
        const currentPrefs = readCardFieldPrefs()
        currentPrefs[id] = checkbox.checked
        localStorage.setItem(CARD_FIELD_PREFS_KEY, JSON.stringify(currentPrefs))
        applyFieldVisibility()
      }, signal)
    }
  }

  pageLifecycle.onPageLoad(lifetime => {
    // [F1] Abort previous listeners on soft navigation re-init
    customizerAbort?.abort()
    customizerAbort = new AbortController()
    const instance = customizerAbort
    const signal = instance.signal
    lifetime.addEventListener("abort", () => instance.abort(), { once: true })

    const resetBtn = document.getElementById("card-customizer-reset")
    const root = document.querySelector<HTMLElement>(".card-customizer")
    if (!root) return
    const customFields = JSON.parse(root.dataset.cardFieldNames ?? "[]") as string[]

    renderFieldList(signal)
    applyFieldVisibility()
    renderBoardCustomFieldList(customFields, signal)
    applyFieldSearchFilter()

    const searchInput = document.getElementById("card-customizer-search") as HTMLInputElement | null
    searchInput?.addEventListener("input", () => applyFieldSearchFilter(), { signal })

    document.addEventListener("meitheal:kanban-board-replaced", applyFieldVisibility, { signal })

    applyDensityButtons(readCardDensity())
    document.querySelectorAll<HTMLButtonElement>(".card-density-btn").forEach(btn => {
      btn.addEventListener("click", () => {
        const density = btn.dataset.density as SharedCardDensity
        localStorage.setItem(CARD_DENSITY_KEY, density)
        applyCardPreferencesToRoot(document.getElementById("kanban-board"))
        applyDensityButtons(density)
      }, { signal })
    })

    // Close button handler moved to tasks.astro (co-located with toggle/escape/click-outside)

    if (resetBtn) {
      resetBtn.addEventListener("click", () => {
        localStorage.removeItem(CARD_FIELD_PREFS_KEY)
        localStorage.removeItem(`${KANBAN_CARD_FIELDS_PREFIX}${activeBoardId()}`)
        localStorage.removeItem(CARD_DENSITY_KEY)
        if (searchInput) searchInput.value = ""
        renderFieldList(signal)
        renderBoardCustomFieldList(customFields, signal)
        applyFieldSearchFilter()
        applyFieldVisibility()
        applyDensityButtons(readCardDensity())
      }, { signal })
    }
  })
</script>
