---
/**
 * BotBadge — micro-badge for bot-owned or bot-handoff task cards.
 * Shows owner type and handoff state.
 */
export interface Props {
  owner?: string;
  handoffState?: string;
  class?: string;
}
const { owner, handoffState, class: className = "" } = Astro.props;

const isBot = owner === "bot";
const showBadge = isBot || (handoffState && handoffState !== "idle");

let icon = "";
let label = "";
let variant = "";

if (handoffState === "claimed") {
  icon = "⚙️";
  label = "Bot working";
  variant = "bot-working";
} else if (handoffState === "proposed") {
  icon = "💡";
  label = "Review proposal";
  variant = "bot-proposed";
} else if (isBot) {
  icon = "🤖";
  label = "Bot owned";
  variant = "bot-owned";
}
---

{showBadge && (
  <span
    class={`bot-badge bot-badge--${variant} ${className}`}
    title={label}
    aria-label={label}
  >
    {icon}
  </span>
)}

<style>
  .bot-badge {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    font-size: 11px;
    width: 20px;
    height: 20px;
    border-radius: 50%;
    flex-shrink: 0;
    line-height: 1;
  }

  .bot-badge--bot-owned {
    background: rgba(99, 102, 241, 0.15);
  }

  .bot-badge--bot-working {
    background: rgba(245, 158, 11, 0.15);
    animation: bot-pulse 2s ease-in-out infinite;
  }

  .bot-badge--bot-proposed {
    background: rgba(34, 197, 94, 0.15);
    animation: bot-glow 1.5s ease-in-out infinite;
  }

  @keyframes bot-pulse {
    0%, 100% { opacity: 1; }
    50% { opacity: 0.6; }
  }

  @keyframes bot-glow {
    0%, 100% { box-shadow: 0 0 0 0 rgba(34, 197, 94, 0); }
    50% { box-shadow: 0 0 6px 2px rgba(34, 197, 94, 0.3); }
  }
</style>
