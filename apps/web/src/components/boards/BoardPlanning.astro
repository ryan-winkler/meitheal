---
import { isOrganizationFeatureAvailable as available } from "@lib/organization-request-context"
import { organizationLabelsFor, newOrganizationLabel, organizationLocale } from "@lib/organization-labels"
import type { readNamedBoardPlanning } from "@domains/tasks/persistence/named-board-planning-repository"

import { boardWorkspaceHref, DEFAULT_GROUP_COLOR, readBoardPlanningSection } from "@lib/board-workspace"

import RetirePlanningForm from "./RetirePlanningForm.astro"
import ProjectSettings from "./ProjectSettings.astro"
import GoalsTab from "../progress/GoalsTab.astro"
import { listSharedGoals, type SharedGoalProgress } from "@domains/tasks/persistence/shared-goal-repository"
import { getPersistenceClient } from "@domains/tasks/persistence/store"

interface Props {
  boardId: string
  areaId?: string | undefined
  projectId?: string | undefined
  planning: NonNullable<Awaited<ReturnType<typeof readNamedBoardPlanning>>>
  canManage: boolean
  canComplete: boolean
  routinesEnabled: boolean
  tickets: { id: string; title: string }[]
}
const { boardId, areaId, projectId, planning, canManage, canComplete, routinesEnabled, tickets } = Astro.props
const label = await organizationLabelsFor(Astro)
const newLabel = (name: Parameters<typeof label>[0], fallback?: string) => newOrganizationLabel(label(name, false, fallback), organizationLocale(Astro))
const section = readBoardPlanningSection(Astro.url.searchParams)
const showPlanning = section === "planning"
const showGoals = section === "planning" || section === "goals"
const showPillars = section === "planning" || section === "pillars"
const goalHref = (filter: string, id: string) => boardWorkspaceHref(boardId, {
  ...(filter === "project_id" ? { project: id } : { area: id }), groups: true, section: "goals",
}, "groups")
const showRoutines = routinesEnabled && (canManage || planning.routines.length > 0) && (section === "planning" || section === "routines")
const selectedProject = projectId ? planning.projects.find(project => project.id === projectId) : undefined
const selectedAreaId = areaId ?? selectedProject?.areaId ?? undefined
const visibleAreas = selectedAreaId ? planning.areas.filter(area => area.id === selectedAreaId) : planning.areas
let goalProgress: SharedGoalProgress[] = []
let progressUnavailable = false
if (showGoals && available("goals")) {
  try {
    goalProgress = await listSharedGoals(getPersistenceClient(), Astro.locals, Astro.request.signal, {
      ...(projectId ? { projectId } : selectedAreaId ? { areaId: selectedAreaId } : {}),
    })
  } catch { progressUnavailable = true }
}
const visibleOwnedGoals = planning.goals.filter(goal => (!selectedAreaId || goal.areaId === selectedAreaId) && (!projectId || goal.id === selectedProject?.goalId))
const ownedGoalIds = new Set(planning.goals.map(goal => goal.id))
const progressByGoal = new Map(goalProgress.map(goal => [goal.id, goal]))
const formColor = (color: string) => /^#[0-9a-f]{6}$/i.test(color) ? color : DEFAULT_GROUP_COLOR
const ownedAreaIds = new Set(planning.areas.map(area => area.id))
---

<section class="named-boards board-settings" id="groups" aria-labelledby="board-planning-title">
  <h2 id="board-planning-title">{section !== "planning" ? label(section === "goals" ? "goal" : section === "routines" ? "routine" : "pillar", true) : projectId ? `${label("project")} planning` : areaId ? `${label("group")} planning` : label("group", true)}</h2>
  {showPlanning && !areaId && planning.projects.some(project => !project.areaId) && <section aria-labelledby="unfiled-projects">
    <h3 id="unfiled-projects">Unfiled Projects</h3>
    <ul>{planning.projects.filter(project => !project.areaId && (!projectId || projectId === project.id))
      .map(project => <li><a href={boardWorkspaceHref(boardId, { project: project.id })}>{project.title}</a></li>)}</ul>
  </section>}
  {showPlanning && canManage && available("groups") && planning.areas.length === 0 && <p class="board-empty">Choose “{newLabel("group")}” to organize related work.</p>}
  {section === "goals" && projectId && <GoalsTab {projectId} />}
  <div class="board-settings-grid" hidden={section === "pillars" || (section === "goals" && Boolean(projectId))}>
    {visibleAreas.map(area => <section class="board-tile">
      <h3 class="board-name"><a href={boardWorkspaceHref(boardId, { area: area.id })}>{area.icon} {area.name}</a></h3>
      <div hidden={!showPlanning}>
      {canManage && available("groups") && <details id={areaId === area.id && !projectId ? "group-settings" : undefined}>
        <summary>{label("group")} settings</summary>
        <form data-board-form="planning" class="board-form">
          <input type="hidden" name="action" value="area" />
          <input type="hidden" name="id" value={area.id} />
          <label>Name <input name="title" value={area.name} maxlength="150" required /></label>
          <label>Icon <input name="icon" value={area.icon} maxlength="24" /></label>
          <label>Color <input name="color" type="color" value={formColor(area.color)} /></label>
          <p role="status" data-board-feedback></p>
          <button type="submit" class="btn btn-ghost">Save Area</button>
        </form>
        <RetirePlanningForm entity="area" id={area.id} />
      </details>}
      {available("goals") && <a href={goalHref("area_id", area.id)}>View {label("goal", true)}</a>}
      <div>
        {available("projects") && <strong>{label("project", true)}</strong>}
        {planning.projects.filter(project => project.areaId === area.id && (!projectId || project.id === projectId)).map(project => <article class="board-tile">
          <h4 class="board-name"><a href={boardWorkspaceHref(boardId, { project: project.id, fromArea: area.id })}>{project.title}</a></h4>
          {available("goals") && <a href={goalHref("project_id", project.id)}>View {label("project")} {label("goal", true)}</a>}
          {project.description && <p>{project.description}</p>}
          <ProjectSettings {project} selected={projectId === project.id} {canManage}
            goals={planning.linkableGoals.filter(goal => goal.sharedAreaId === null || goal.sharedAreaId === area.id)} />
        </article>)}
      </div>
      {canManage && available("projects") && <details>
        <summary>{newLabel("project")}</summary>
        <form data-board-form="planning" class="board-form">
          <input type="hidden" name="action" value="project" />
          <input type="hidden" name="areaId" value={area.id} />
          <label>Name <input name="title" maxlength="150" required /></label>
          <label>Details <textarea name="description" rows="2" maxlength="10000"></textarea></label>
          {available("goals") ? <label>Goal <select name="goalId">
            <option value="">No Goal</option>
            {planning.linkableGoals.filter(goal => goal.sharedAreaId === null || goal.sharedAreaId === area.id)
              .map(goal => <option value={goal.id}>{goal.title}</option>)}
          </select></label> : <input type="hidden" name="goalId" value="" />}
          <p role="status" data-board-feedback></p>
          <button type="submit" class="btn btn-ghost">Create Project</button>
        </form>
      </details>}
      </div>
      <div hidden={!showGoals}>
      {visibleOwnedGoals.filter(goal => goal.areaId === area.id).map(goal => <article class="board-tile">
        <h4 class="board-name">{goal.title}</h4>
        {progressUnavailable ? <p class="board-note" role="status">Progress is unavailable. Try again when access can be verified.</p> : progressByGoal.has(goal.id) && <p class="board-note">{progressByGoal.get(goal.id)!.completed_project_count} of {progressByGoal.get(goal.id)!.project_count} accessible Projects complete</p>}
        {goal.description && <p>{goal.description}</p>}
        {canManage && available("goals") && <details>
        <summary>Edit Goal</summary>
          <form data-board-form="planning" class="board-form">
            <input type="hidden" name="action" value="goal" />
            <input type="hidden" name="id" value={goal.id} />
            <input type="hidden" name="areaId" value={area.id} />
            <label>Title <input name="title" value={goal.title} maxlength="150" required /></label>
            <label>Details <textarea name="description" rows="2" maxlength="10000">{goal.description}</textarea></label>
            <p role="status" data-board-feedback></p>
            <button type="submit" class="btn btn-ghost">Save Goal</button>
          </form>
          <RetirePlanningForm entity="goal" id={goal.id} />
        </details>}
      </article>)}
      {goalProgress.filter(goal => goal.area_id === area.id && !ownedGoalIds.has(goal.id)).map(goal => <article class="board-tile">
        <h4 class="board-name">{goal.title}</h4>
        <p class="board-note">Shared Goal · {goal.completed_project_count} of {goal.project_count} accessible Projects complete</p>
      </article>)}
      {canManage && available("goals") && <details>
        <summary>{newLabel("goal")}</summary>
        <form data-board-form="planning" class="board-form">
          <input type="hidden" name="action" value="goal" />
          <input type="hidden" name="areaId" value={area.id} />
          <label>Title <input name="title" maxlength="150" required /></label>
          <label>Details <textarea name="description" rows="2" maxlength="10000"></textarea></label>
          <p role="status" data-board-feedback></p>
          <button type="submit" class="btn btn-ghost">Create Goal</button>
        </form>
      </details>}
      </div>
      {showRoutines && <div class="named-boards">
        {planning.routines.filter(routine => routine.areaId === area.id && (!projectId || routine.projectId === projectId)).map(routine => <article class="board-tile">
          <h4 class="board-name">{routine.name}</h4>
          <p class="board-note">{routine.cadence}{routine.complete ? " · Done" : ""}</p>
          {canComplete && !routine.complete && <form data-board-form="planning" class="board-form">
            <input type="hidden" name="action" value="routine-complete" />
            <input type="hidden" name="id" value={routine.id} />
            <input type="hidden" name="period" value={routine.period} />
            <p role="status" data-board-feedback></p>
            <button type="submit" class="btn btn-ghost">Mark routine done</button>
          </form>}
          {canManage && available("routines") && <details>
        <summary>Edit Routine</summary>
            <form data-board-form="planning" class="board-form">
              <input type="hidden" name="action" value="routine" />
              <input type="hidden" name="id" value={routine.id} />
              <input type="hidden" name="areaId" value={area.id} />
              <input type="hidden" name="cadence" value={routine.cadence} />
              {routine.projectId && <input type="hidden" name="projectId" value={routine.projectId} />}
              <label>Title <input name="title" value={routine.name} maxlength="150" required /></label>
              <label>Details <textarea name="description" rows="2" maxlength="10000">{routine.description}</textarea></label>
              <p role="status" data-board-feedback></p>
              <button type="submit" class="btn btn-ghost">Save Routine</button>
            </form>
            <RetirePlanningForm entity="routine" id={routine.id} />
          </details>}
        </article>)}
        {canManage && available("routines") && <details>
        <summary>{newLabel("routine")}</summary>
          <form data-board-form="planning" class="board-form">
            <input type="hidden" name="action" value="routine" />
            <input type="hidden" name="areaId" value={area.id} />
            {projectId && <input type="hidden" name="projectId" value={projectId} />}
            <label>Title <input name="title" maxlength="150" required /></label>
            <label>Details <textarea name="description" rows="2" maxlength="10000"></textarea></label>
            <label>Frequency <select name="cadence"><option value="daily">Daily</option><option value="weekly">Weekly</option></select></label>
            <p role="status" data-board-feedback></p>
            <button type="submit" class="btn btn-ghost">Create Routine</button>
          </form>
        </details>}
      </div>}
    </section>)}
    <div hidden={!showPlanning}>
    {planning.projects.filter(project => (!projectId || project.id === projectId) && (!project.areaId || !ownedAreaIds.has(project.areaId))).map(project => <article class="board-tile">
      <h3 class="board-name">{project.title}</h3>
      {project.description && <p>{project.description}</p>}
      {available("goals") && <a href={goalHref("project_id", project.id)}>View {label("project")} {label("goal", true)}</a>}
      <ProjectSettings {project} selected={projectId === project.id} {canManage}
        goals={planning.linkableGoals.filter(goal => goal.sharedAreaId === null)} />
    </article>)}
    {canManage && available("groups") && <details class="board-tile">
        <summary>{newLabel("group")}</summary>
      <form data-board-form="planning" class="board-form">
        <input type="hidden" name="action" value="area" />
        <label>Name <input name="title" maxlength="150" required /></label>
        <label>Icon <input name="icon" value="📁" maxlength="24" /></label>
          <label>Color <input name="color" type="color" value={DEFAULT_GROUP_COLOR} /></label>
          <p role="status" data-board-feedback></p>
        <button type="submit" class="btn btn-ghost">Create Area</button>
      </form>
    </details>}
    </div>
  </div>
  {showGoals && canManage && visibleOwnedGoals.length > 0 && <details class="board-tile">
    <summary>Goal sharing</summary>
    {visibleOwnedGoals.map(goal => <section class="board-form">
      <h3 class="board-name">{goal.title}</h3>
      {planning.shares.filter(share => share.goalId === goal.id).map(share => <form data-board-form="planning" class="board-move">
        <span>{share.areaName || "Unavailable Area"}</span>
        <input type="hidden" name="action" value="goal-share" />
        <input type="hidden" name="id" value={goal.id} />
        <input type="hidden" name="areaId" value={share.areaId} />
        <input type="hidden" name="enabled" value="false" />
        <button type="submit" class="btn btn-ghost">Stop sharing</button>
        <p role="status" data-board-feedback></p>
      </form>)}
      <form data-board-form="planning" class="board-form">
        <input type="hidden" name="action" value="goal-share" />
        <input type="hidden" name="id" value={goal.id} />
        <input type="hidden" name="enabled" value="true" />
        <label>Share with <select name="areaId" required>
          <option value="">Choose an Area</option>
          {planning.destinations.filter(area => !planning.shares.some(share => share.goalId === goal.id && share.areaId === area.id))
            .map(area => <option value={area.id}>{area.board} · {area.name}</option>)}
        </select></label>
        <p class="board-note">People in the selected Area can see this title and progress from Projects they can access.</p>
        <p role="status" data-board-feedback></p>
        <button type="submit" class="btn btn-ghost">Share Goal</button>
      </form>
    </section>)}
  </details>}
  <section class="named-boards" aria-labelledby="board-pillars-title" hidden={!showPillars}>
    <h2 id="board-pillars-title">{label("board")} {label("pillar", true)}</h2>
    <div class="boards-list">
      {planning.pillars.map(pillar => <article class="board-tile">
        <h3 class="board-name">{pillar.name}</h3>
        {pillar.manifesto && <p>{pillar.manifesto}</p>}
        {pillar.principles.length > 0 && <ul>
          {pillar.principles.map(principle => <li>
            {principle.statement}{principle.nonNegotiable && " (Non-negotiable)"}
            {canManage && available("principles") && <details>
        <summary>Edit Principle</summary>
              <form data-board-form="planning" class="board-form">
                <input type="hidden" name="action" value="pillar-principle" />
                <input type="hidden" name="pillarId" value={pillar.id} />
                <input type="hidden" name="id" value={principle.id} />
                <label>Statement <input name="title" value={principle.statement} required maxlength="150" /></label>
                <label class="check"><input type="checkbox" name="nonNegotiable" checked={principle.nonNegotiable} /> Non-negotiable</label>
                <p role="status" data-board-feedback></p>
                <button type="submit" class="btn btn-ghost">Save Principle</button>
              </form>
            </details>}
          </li>)}
        </ul>}
        {pillar.links.length > 0 && <ul>
          {pillar.links.map(link => <li>
            {link.label}
            {canManage && <form data-board-form="planning" class="board-preference">
              <input type="hidden" name="action" value="pillar-link" />
              <input type="hidden" name="pillarId" value={pillar.id} />
              <input type="hidden" name="id" value={link.id} />
              <input type="hidden" name="entityType" value={link.type} />
              <input type="hidden" name="enabled" value="false" />
              <button type="submit" class="btn btn-ghost">Remove link</button>
              <p role="status" data-board-feedback></p>
            </form>}
          </li>)}
        </ul>}
        {canManage && available("principles") && <details>
        <summary>Add Principle</summary>
          <form data-board-form="planning" class="board-form">
            <input type="hidden" name="action" value="pillar-principle" />
            <input type="hidden" name="pillarId" value={pillar.id} />
            <label>Statement <input name="title" required maxlength="150" /></label>
            <label class="check"><input type="checkbox" name="nonNegotiable" /> Non-negotiable</label>
            <p role="status" data-board-feedback></p>
            <button type="submit" class="btn btn-ghost">Add Principle</button>
          </form>
        </details>}
        {canManage && (planning.goals.length + planning.routines.length + tickets.length > 0) && <details>
          <summary>Link work</summary>
          <form data-board-form="planning" class="board-form">
            <input type="hidden" name="action" value="pillar-link" />
            <input type="hidden" name="pillarId" value={pillar.id} />
            <input type="hidden" name="enabled" value="true" />
            <label>Work item <select name="linkedEntity" required>
              <option value="">Choose a work item</option>
              {planning.goals.length > 0 && <optgroup label="Goals">
                {planning.goals.map(goal => <option value={`goal/${goal.id}`}>{goal.title}</option>)}
              </optgroup>}
              {planning.routines.length > 0 && <optgroup label="Routines">
                {planning.routines.map(routine => <option value={`routine/${routine.id}`}>{routine.name}</option>)}
              </optgroup>}
              {tickets.length > 0 && <optgroup label="Tickets on this page">
                {tickets.map(ticket => <option value={`task/${ticket.id}`}>{ticket.title}</option>)}
              </optgroup>}
            </select></label>
            <p role="status" data-board-feedback></p>
            <button type="submit" class="btn btn-ghost">Link to Pillar</button>
          </form>
        </details>}
        {canManage && available("pillars") && <details>
        <summary>Edit Pillar</summary>
          <form data-board-form="planning" class="board-form">
            <input type="hidden" name="action" value="pillar" />
            <input type="hidden" name="id" value={pillar.id} />
            <label>Name <input name="title" value={pillar.name} maxlength="150" required /></label>
            <label>Manifesto <textarea name="description" rows="2" maxlength="10000">{pillar.manifesto}</textarea></label>
            <p role="status" data-board-feedback></p>
            <button type="submit" class="btn btn-ghost">Save Pillar</button>
          </form>
        </details>}
      </article>)}
    </div>
    {canManage && available("pillars") && <details class="board-tile">
        <summary>{organizationLocale(Astro) === "en" ? `New ${label("board")} ${label("pillar")}` : newLabel("pillar")}</summary>
      <form data-board-form="planning" class="board-form">
        <input type="hidden" name="action" value="pillar" />
        <label>Name <input name="title" maxlength="150" required /></label>
        <label>Manifesto <textarea name="description" rows="2" maxlength="10000"></textarea></label>
        <p class="board-note">Visible to people with access to this Board.</p>
        <p role="status" data-board-feedback></p>
        <button type="submit" class="btn btn-ghost">Create Pillar</button>
      </form>
    </details>}
  </section>
</section>
