---
import { readHomeAssistantAreaFilter } from "@lib/home-assistant-area-access"
import HomeAssistantAreaField from "../tasks/HomeAssistantAreaField.astro"
import { organizationLabelsFor, newOrganizationLabel, organizationLocale } from "@lib/organization-labels"
import TaskWorkspace from "../TaskWorkspace.astro"
import BoardPlanning from "./BoardPlanning.astro"
import { isOrganizationFeatureAvailable as available } from "@lib/organization-request-context"
import Layout from "../../layouts/Layout.astro"
import "../../styles/boards.css"
import { permitsBoardTaskAction } from "@domains/tasks/persistence/named-board-repository"
import { boardWorkspaceHref, readBoardWorkspaceSelection } from "@lib/board-workspace"
import { boardAuthorityKey, boardViewKey, readBoardView } from "@lib/board-view"
import { boardSessionProof, currentBoardUser } from "@lib/named-board-request"
import { isFeatureEnabled } from "@lib/feature-flags"
import { isDoneStatus } from "@lib/status-config"

const label = await organizationLabelsFor(Astro)
const newLabel = (name: Parameters<typeof label>[0], fallback?: string) => newOrganizationLabel(label(name, false, fallback), organizationLocale(Astro))
const boardId: string = Astro.props.boardId
const selection = readBoardWorkspaceSelection(Astro.url.searchParams)
const user = await currentBoardUser(Astro.locals, Astro.request.signal)
const rawOffset = Number(Astro.url.searchParams.get("offset") ?? 0)
const offset = Number.isSafeInteger(rawOffset) && rawOffset >= 0 ? rawOffset : 0
const homeFilter = await readHomeAssistantAreaFilter(Astro, Astro.url.searchParams)
const taskWorkspace = !selection.planning && Boolean(boardId && user)
const view = !taskWorkspace && boardId && user ? await readBoardView(user.actor, boardId, offset, selection, homeFilter) : null
if (!boardId || !user || (!view && !taskWorkspace)) Astro.response.status = 404
const policy = view?.board.policy
const canEdit = view && permitsBoardTaskAction(view.board, "edit")
const canDelete = view && permitsBoardTaskAction(view.board, "delete")
const canComplete = view && permitsBoardTaskAction(view.board, "complete")
const routinesEnabled = view ? await isFeatureEnabled("habits") : false
const verify = new URLSearchParams(Astro.url.searchParams)
if (!homeFilter) verify.delete("home_assistant_area_id")
verify.set("view", "tasks")
verify.set("offset", String(offset))
if (selection.planning) verify.set("planning", "1")
const verifyPath = `/api/boards/${encodeURIComponent(boardId)}?${verify}`
const scope = view?.context
const fromArea = scope?.project && selection.fromArea === scope.area?.id ? scope.area?.id : undefined
const grouping = { area: scope?.project ? undefined : scope?.area?.id, project: scope?.project?.id, groups: selection.planning, fromArea }
const title = scope?.project?.title ?? scope?.area?.name ?? view?.board.name ?? "Board"
const nextAction = view?.summary?.next
---
{taskWorkspace ? <TaskWorkspace namedBoardId={boardId} /> : <Layout title={label("board")} suppressHouseholdTaskModals>
  <span slot="page-title">{label("board")}</span>
  <div class="boards-workspace">
    {!view || !boardId || !user ? <p>This Board is unavailable.</p> :
      <div data-board-directory data-board-verify={verifyPath} data-board-key={boardViewKey(view, user.actor.id)}
        data-board-authority={boardAuthorityKey(view, user.actor.id)}
        data-board-session={boardSessionProof(user.actor.id)} data-board-id={boardId}
        data-board-can-create={String(Boolean(canEdit) && (!scope?.project || scope.project.status === "active"))}>
        <nav class="board-back" aria-label="Board navigation">
          <a href="/boards">{label("board", true)}</a>
          <span aria-hidden="true">›</span><a href={boardWorkspaceHref(boardId)}>{view.board.name}</a>
          {scope?.area && (!scope.project || fromArea) && <><span aria-hidden="true">›</span><a href={boardWorkspaceHref(boardId, { area: scope.area.id })}>{scope.area.name}</a></>}
        </nav>
        <header class="boards-heading">
          <div>
            <h1>{title}</h1>
            {scope?.project && <p class="board-note">Project status: {scope.project.status} · {view.summary?.count ?? 0} open
              {nextAction ? <> · Next action: <a href={boardWorkspaceHref(boardId, { ticket: nextAction.id })}>{nextAction.title}</a></> : " · No next action"}
            </p>}
            {view.board.state === "archived" && <p>Archived Board</p>}
          </div>
          {canEdit && (!scope?.project || scope.project.status === "active") && !selection.ticketId && <details class="board-add">
            <summary class="btn btn-primary">{newLabel("task", organizationLocale(Astro) === "en" ? "task" : undefined)}</summary>
            <form data-board-form="task-create" class="board-form">
              <label>Title <input name="title" maxlength="500" required autocomplete="off" /></label>
              <label>Details <textarea name="description" maxlength="10000" rows="3"></textarea></label>
              <label>Column <select name="laneId">
                {view.lanes.filter(lane => canComplete || !isDoneStatus(lane.key)).map(lane => <option value={lane.id}>{lane.label}</option>)}
              </select></label>
              <label>Shared due date <input type="date" name="due_date" /></label>
              <HomeAssistantAreaField />
              {scope?.area && <input type="hidden" name="areaId" value={scope.area.id} />}
              {scope?.project && <input type="hidden" name="projectId" value={scope.project.id} />}
              <p class="board-note">{scope?.project?.title ?? scope?.area?.name ?? "Unfiled"}</p>
              <p role="status" data-board-feedback></p>
              <button type="submit" class="btn btn-primary">Create task</button>
            </form>
          </details>}
        </header>

        {!selection.ticketId && <nav class="board-context-tabs" aria-label="Board workspace">
          <a class="btn btn-ghost" aria-current={!selection.planning ? "page" : undefined} href={boardWorkspaceHref(boardId, { ...grouping, groups: false })}>{label("task", true)}</a>
          {available("organizer") && <a class="btn btn-ghost" aria-current={selection.planning ? "page" : undefined} href={boardWorkspaceHref(boardId, { ...grouping, groups: true }, scope?.project ? "project-settings" : scope?.area ? "group-settings" : "groups")}>{scope?.project ? `${label("project")} settings` : scope?.area ? `${label("group")} planning` : label("group", true)}</a>}
          {!scope?.area && !scope?.project && policy && <a class="btn btn-ghost" href="#settings">{label("board")} settings</a>}
        </nav>}
        {scope?.area && !scope.project && !selection.planning && <p>
          <a href={boardWorkspaceHref(boardId, { area: scope.area.id, groups: true }, "projects")}>{label("project", true)} in {scope.area.name}</a>
        </p>}
        {view.planning && <BoardPlanning boardId={boardId} areaId={scope?.area?.id} projectId={scope?.project?.id} planning={view.planning} canManage={Boolean(policy) && view.board.state === "active"} canComplete={Boolean(canComplete)} routinesEnabled={routinesEnabled} tickets={view.tasks} />}
        {policy && !scope?.area && !scope?.project && !selection.ticketId && <details id="settings" class="named-boards board-settings">
          <summary>{label("board")} settings</summary>
          <div class="board-settings-grid">
            <form data-board-form="policy" class="board-form">
              <h2>Ticket permissions</h2>
              <label class="check"><input type="checkbox" name="denyCompletion" checked={policy.denyCompletion} /> Block marking tickets done or reopening them</label>
              <label class="check"><input type="checkbox" name="denyDeletion" checked={policy.denyDeletion} /> Block ticket deletion</label>
              <label class="check"><input type="checkbox" name="denyAgentDeletion" checked={policy.denyAgentDeletion} /> Block deletion by agents</label>
              <p role="status" data-board-feedback></p>
              <button type="submit" class="btn btn-ghost">Save permissions</button>
            </form>
            <div>
              <h2>People with access</h2>
              {view.members.map(member => <form data-board-form="member" class="board-form board-member">
                <h3>{user.roster.get(member.id) || "Inactive Home Assistant user"}</h3>
                <input type="hidden" name="memberId" value={member.id} />
                <label>Role <select name="role">
                  <option value="viewer" selected={member.role === "viewer"}>Viewer</option>
                  <option value="member" selected={member.role === "member"}>Member</option>
                  <option value="owner" selected={member.role === "owner"}>Owner</option>
                  <option value="remove">Remove access</option>
                </select></label>
                <label class="check"><input type="checkbox" name="denyCompletion" checked={member.denyCompletion} /> Block marking done</label>
                <label class="check"><input type="checkbox" name="denyDeletion" checked={member.denyDeletion} /> Block deletion</label>
                <p role="status" data-board-feedback></p>
                <button type="submit" class="btn btn-ghost">Save access</button>
              </form>)}
              <form data-board-form="member" class="board-form board-member">
                <label>Add a person <select name="memberId" required>
                  <option value="">Choose a person</option>
                  {[...user.roster].filter(([id]) => !view.members.some(member => member.id === id)).map(([id, name]) => <option value={id}>{name}</option>)}
                </select></label>
                <label>Role <select name="role"><option value="viewer">Viewer</option><option value="member">Member</option><option value="owner">Owner</option></select></label>
                <p role="status" data-board-feedback></p>
                <button type="submit" class="btn btn-ghost">Add person</button>
              </form>
            </div>
            <section aria-labelledby="board-agent-settings">
              <h2 id="board-agent-settings">Agent access</h2>
              {view.agents.map(tokenId => <form data-board-form="agent" class="board-form board-member">
                <span class="board-note">{tokenId}</span>
                <input type="hidden" name="tokenId" value={tokenId} />
                <input type="hidden" name="enabled" value="false" />
                <p role="status" data-board-feedback></p>
                <button type="submit" class="btn btn-ghost">Remove token access</button>
              </form>)}
              <form data-board-form="agent" class="board-form">
                <label>Agent token ID <input name="tokenId" maxlength="36" autocomplete="off" required /></label>
                <p class="board-note">Use the ID from Settings → Agent Tokens. The token needs task read access.</p>
                <input type="hidden" name="enabled" value="true" />
                <p role="status" data-board-feedback></p>
                <button type="submit" class="btn btn-ghost">Grant token access</button>
              </form>
            </section>
            <section aria-labelledby="board-intake-settings">
              <h2 id="board-intake-settings">Send-only access</h2>
              {view.intakes.map(intake => <form data-board-form="intake-toggle" class="board-form board-member">
                <h3>{intake.label}</h3>
                <span class="board-note">{intake.enabled ? "Accepting tasks" : "Closed"}</span>
                <input type="hidden" name="id" value={intake.id} />
                <input type="hidden" name="enabled" value={intake.enabled ? "false" : "true"} />
                <p role="status" data-board-feedback></p>
                <button type="submit" class="btn btn-ghost">{intake.enabled ? "Close destination" : "Reopen destination"}</button>
              </form>)}
              <form data-board-form="intake-create" class="board-form">
                <label>Destination name <input name="label" maxlength="100" required /></label>
                <label>Triage column <select name="laneId" required>
                  {view.lanes.filter(lane => !isDoneStatus(lane.key)).map(lane => <option value={lane.id}>{lane.label}</option>)}
                </select></label>
                <fieldset class="board-people"><legend>Allowed senders</legend>
                  {[...user.roster].map(([id, name]) => <label class="check"><input type="checkbox" name="senderIds" value={id} /> {name}</label>)}
                </fieldset>
                <label>Allow assignment to <select name="recipientId">
                  <option value="">No one</option>
                  {view.members.filter(member => user.roster.has(member.id)).map(member => <option value={member.id}>{user.roster.get(member.id)}</option>)}
                </select></label>
                <p role="status" data-board-feedback></p>
                <button type="submit" class="btn btn-ghost">Create destination</button>
              </form>
            </section>
            {!view.board.denyDeletion && <form data-board-form="lifecycle" class="board-form">
              <h2>Delete Board</h2>
              <p>Keep its saved work in Deleted Boards. Incoming work and Routines pause until you restore it.</p>
              <input type="hidden" name="action" value="retire" />
              <input type="hidden" name="revision" value={view.board.revision} />
              <input type="hidden" name="boardName" value={view.board.name} />
              <p role="status" data-board-feedback></p>
              <button type="submit" class="btn btn-danger">Delete Board</button>
            </form>}
          </div>
        </details>}
      </div>}
    <p hidden data-board-expired role="status">Your Board view changed. <button type="button" class="btn btn-ghost" data-board-refresh>Refresh Board</button></p>
  </div>
</Layout>}

<script>
  import { pageLifecycle } from "@lib/page-lifecycle"
  import { bindNamedBoardPlanningCapture } from "@lib/named-board-kanban-controller"
  import { bindBoardPage } from "@lib/boards-page"
  pageLifecycle.onPageLoad(signal => {
    bindBoardPage(signal)
    bindNamedBoardPlanningCapture(signal)
  })
</script>
