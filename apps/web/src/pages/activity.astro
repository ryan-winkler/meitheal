---
import { getHABaseUrl } from "@domains/ha/ha-connection"
import { getCurrentHAUserRoster } from "@domains/ha/ha-users"
import { HierarchyRepository } from "@domains/tasks/persistence/hierarchy-repository"
import { readRecentActivity, recentActivityPersonKey } from "@domains/tasks/persistence/recent-activity"
import { ensureSchema, getPersistenceClient } from "@domains/tasks/persistence/store"
import { formatVerifiedAgentAuthor, resolveVerifiedProvenanceLink } from "@lib/recent-activity-actor"
import { buildTaskPath } from "@lib/task-detail-handoff"
import { formatTicketKey } from "@lib/ticket-key"
import { verifiedIngressUser } from "@lib/verified-ingress-user"
import Layout from "../layouts/Layout.astro"
import { t } from "../i18n/translations"

const headers = { "cache-control": "private, no-store" }
Astro.response.headers.set("cache-control", headers["cache-control"])
const locale = Astro.cookies.get("meitheal-locale")?.value === "ga" ? "ga" : "en"
const user = verifiedIngressUser(Astro.locals)
const roster = user ? await getCurrentHAUserRoster(user.id, Astro.request.signal) : undefined
if (!roster) {
  return new Response(t("recent_activity.denied", locale), { status: 403, headers })
}

const areaId = Astro.url.searchParams.get("area") || undefined
const personKey = Astro.url.searchParams.get("person") || undefined
const rawCursor = Astro.url.searchParams.get("before")
const parts = rawCursor?.match(/^(\d{1,16})\.(\d{1,16})$/)
const before = parts ? { at: Number(parts[1]), id: Number(parts[2]) } : undefined
let invalid = Boolean((areaId && areaId.length > 128) || (personKey && !/^[a-f0-9]{32}$/.test(personKey)) ||
  (rawCursor !== null && (!before || !Number.isSafeInteger(before.at) || !Number.isSafeInteger(before.id) || before.id < 1)))

let areas: Awaited<ReturnType<HierarchyRepository["findAllAreas"]>> = []
let people = new Map<string, string>()
let page: Awaited<ReturnType<typeof readRecentActivity>> = { items: [], next: null }
let haBaseUrl: string | null = null
let unavailable = false

if (!invalid) {
  try {
    await ensureSchema()
    const client = getPersistenceClient()
    areas = await new HierarchyRepository(client).findAllAreas()
    const names = new Map<string, number>()
    for (const name of roster.values()) names.set(name, (names.get(name) ?? 0) + 1)
    for (const [id, name] of roster) {
      const key = recentActivityPersonKey(id)
      people.set(key, (names.get(name) ?? 0) > 1 ? `${name} · ${key.slice(-6)}` : name)
    }
    invalid = Boolean((areaId && !areas.some(area => area.id === areaId)) || (personKey && !people.has(personKey)))
    if (!invalid) {
      page = await readRecentActivity(client, { areaId, personKey, before })
      if (page.items.some(item => item.kind === "agent" && item.provenance?.originTarget && !item.provenance.originTarget.startsWith("/settings"))) {
        haBaseUrl = await getHABaseUrl().catch(() => null)
      }
    }
  } catch {
    unavailable = true
  }
}
if (invalid) Astro.response.status = 400
if (unavailable) Astro.response.status = 503

function pageHref(cursor?: NonNullable<typeof page.next>): string {
  const params = new URLSearchParams()
  if (areaId) params.set("area", areaId)
  if (personKey) params.set("person", personKey)
  if (cursor) params.set("before", `${cursor.at}.${cursor.id}`)
  return params.size ? `/activity?${params}` : "/activity"
}

const timeZone = Astro.locals.timezone ?? "Europe/Dublin"
const date = new Intl.DateTimeFormat(locale === "ga" ? "ga-IE" : "en-IE", { dateStyle: "medium", timeStyle: "short", timeZone })
---

<Layout title={t("recent_activity.title", locale)} suppressTaskUrlOpen>
  <section class="recent-activity" data-recent-activity aria-labelledby="recent-activity-heading">
    <header>
      <h1 id="recent-activity-heading">{t("recent_activity.title", locale)}</h1>
      <p>{t("recent_activity.description", locale)}</p>
    </header>

    {invalid || unavailable ? (
      <div role="status">
        <p>{t(invalid ? "recent_activity.invalid" : "recent_activity.unavailable", locale)}</p>
        <a href={invalid ? "/activity" : pageHref()} class="btn btn-secondary" data-astro-prefetch="false" data-astro-reload>
          {t(invalid ? "recent_activity.clear" : "recent_activity.refresh", locale)}
        </a>
      </div>
    ) : (
      <>
        <form method="get" action="/activity" class="activity-filters" aria-label={t("recent_activity.filters", locale)} data-astro-reload>
          <label>
            {t("recent_activity.area", locale)}
            <select class="form-input" name="area">
              <option value="">{t("recent_activity.all_areas", locale)}</option>
              {areas.map(area => <option value={area.id} selected={area.id === areaId}>{area.name}</option>)}
            </select>
          </label>
          <label>
            {t("recent_activity.person", locale)}
            <select class="form-input" name="person">
              <option value="">{t("recent_activity.everyone", locale)}</option>
              {[...people].map(([key, name]) => <option value={key} selected={key === personKey}>{name}</option>)}
            </select>
          </label>
          <button type="submit" class="btn btn-primary">{t("recent_activity.apply", locale)}</button>
          {(areaId || personKey) && <a href="/activity" class="btn btn-secondary" data-astro-prefetch="false" data-astro-reload>{t("recent_activity.clear", locale)}</a>}
        </form>
        {page.items.length ? (
          <ol class="activity-list" aria-label={t("recent_activity.title", locale)}>
            {page.items.map(item => {
              const author = item.personKey
                ? people.get(item.personKey) ?? t("recent_activity.member", locale)
                : item.kind === "agent" && item.provenance
                  ? formatVerifiedAgentAuthor(item.provenance)
                  : t(item.kind === "agent" ? "recent_activity.automation" : "recent_activity.local", locale)
              const provenanceLink = item.kind === "agent" && item.provenance
                ? resolveVerifiedProvenanceLink(item.provenance, haBaseUrl, locale)
                : null
              return (
                <li class="activity-entry" data-activity-event={item.id}>
                  <div>
                    <p class="activity-action">{t(`recent_activity.${item.action}`, locale, { author })}</p>
                    <a href={buildTaskPath(item.taskId)} data-astro-prefetch="false">
                      {item.ticketNumber && <span>{formatTicketKey(item.ticketNumber)} </span>}{item.title}
                    </a>
                    {provenanceLink && (
                      <p class="activity-provenance">
                        <a
                          href={provenanceLink.href}
                          class="activity-provenance-link"
                          data-astro-prefetch={provenanceLink.isInternal ? "false" : undefined}
                          data-ha-target={provenanceLink.haTarget}
                          target={provenanceLink.isExternalHa ? "_top" : undefined}
                          rel={provenanceLink.isExternalHa ? "noopener noreferrer" : undefined}
                        >
                          {provenanceLink.label}
                        </a>
                      </p>
                    )}
                  </div>
                  <div class="activity-meta">
                    <span>{item.areaName ?? t("recent_activity.no_area", locale)}</span>
                    <time datetime={new Date(item.at).toISOString()}>{date.format(item.at)}</time>
                  </div>
                </li>
              )
            })}
          </ol>
        ) : <p role="status">{t("recent_activity.empty", locale)}</p>}
        <nav class="activity-pages" aria-label={t("recent_activity.pages", locale)}>
          <a href={pageHref()} class="btn btn-secondary" data-astro-prefetch="false" data-astro-reload>{t(before ? "recent_activity.latest" : "recent_activity.refresh", locale)}</a>
          {page.next && <a href={pageHref(page.next)} class="btn btn-secondary" data-astro-prefetch="false" data-astro-reload>{t("recent_activity.older", locale)}</a>}
        </nav>
      </>
    )}
  </section>
</Layout>

<script>
  import { pageLifecycle } from "@lib/page-lifecycle"

  pageLifecycle.onPageLoad(signal => {
    const section = document.querySelector<HTMLElement>("[data-recent-activity]")
    if (!section) return
    section.querySelectorAll<HTMLAnchorElement>("a[data-ha-target]").forEach(link => {
      const targetPath = link.dataset.haTarget
      if (targetPath && targetPath.startsWith("/") && !targetPath.startsWith("//") && !targetPath.startsWith("/\\")) {
        link.setAttribute("href", targetPath)
      }
    })
    if (section.dataset.historyGuard) return
    section.dataset.historyGuard = "true"

    window.addEventListener("pagehide", event => {
      if (!event.persisted) return
      // A browser history snapshot can outlive the verified Home Assistant session.
      section.hidden = true
      section.replaceChildren()
    }, { signal })
    window.addEventListener("pageshow", event => {
      if (event.persisted) window.location.reload()
    }, { signal })
  })
</script>

<style>
  .recent-activity {
    max-width: 62rem;
    margin-inline: auto;
    padding: clamp(1rem, 3vw, 2rem);
  }

  .recent-activity header { margin-block-end: 1.25rem; }
  .recent-activity header p, .activity-meta { color: var(--text-secondary); }

  .activity-filters, .activity-pages {
    display: flex;
    align-items: end;
    flex-wrap: wrap;
    gap: .75rem;
  }

  .activity-filters label {
    display: grid;
    gap: .25rem;
    flex: 1 1 12rem;
    min-width: 0;
  }

  .activity-filters select { width: 100%; min-width: 0; }
  .activity-filters .btn, .activity-filters select, .activity-pages .btn { min-height: 2.75rem; }

  .activity-filters .btn-primary {
    background: var(--accent-text);
    color: var(--bg-card);
  }

  .activity-filters .btn-primary:hover { background: var(--text-primary); }

  .activity-list {
    display: grid;
    gap: .5rem;
    margin-block: 1rem;
    padding: 0;
    list-style: none;
  }

  .activity-entry {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, auto);
    gap: .5rem 1rem;
    padding: .75rem 1rem;
    border: 1px solid var(--border);
    border-radius: var(--radius-md);
    background: var(--bg-card);
    overflow-wrap: anywhere;
  }

  .activity-entry a { color: var(--accent-text); font-weight: 600; text-decoration: underline; }
  .activity-entry a:hover { text-decoration-thickness: 2px; }
  .activity-action { margin-block: 0 .25rem; }
  .activity-provenance { margin-block: .25rem 0; font-size: .875rem; }
  .activity-provenance-link { font-weight: 500; }
  .activity-meta { display: grid; gap: .25rem; font-size: .875rem; text-align: end; }

  @media (max-width: 520px) {
    .activity-entry { grid-template-columns: minmax(0, 1fr); }
    .activity-meta { text-align: start; }
  }
</style>
