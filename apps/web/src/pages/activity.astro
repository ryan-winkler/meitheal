---
import { resolveBoardPageScope, boardScopeResponse } from "@lib/board-http"

import { getCurrentHAUserRoster, getHABaseUrl } from "@domains/ha"
import {
  ensureSchema,
  getPersistenceClient,
  HierarchyRepository,
  isSettingsOriginTarget,
  readRecentActivity,
  recentActivityPersonKey,
} from "@domains/tasks"
import { formatVerifiedAgentAuthor, resolveVerifiedProvenanceLink } from "@lib/recent-activity-actor"
import { taskDetailPath } from "@lib/task-page-url"
import { formatTicketKey } from "@lib/ticket-key"
import { verifiedIngressUser } from "@lib/verified-ingress-user"
import Icon from "../components/ui/Icon.astro"
import Layout from "../layouts/Layout.astro"
import { t } from "../i18n/translations"
const workScopeResult = await resolveBoardPageScope(Astro, { boardId: Astro.props.boardId })
const workScope = workScopeResult.ok ? workScopeResult.scope : null
if (!workScopeResult.ok) {
  const failure = boardScopeResponse(workScopeResult.errorCode)
  Astro.response.status = failure.status
  for (const [name, value] of failure.headers) if (name !== "content-type") Astro.response.headers.set(name, value)
}


Astro.response.headers.set("cache-control", "private, no-store")
const locale = Astro.cookies.get("meitheal-locale")?.value === "ga" ? "ga" : "en"
const user = verifiedIngressUser(Astro.locals)
const roster = workScope && user ? await getCurrentHAUserRoster(user.id, Astro.request.signal) : undefined
const denied = !workScope || !roster
if (workScope && !roster) Astro.response.status = 403

const areaId = Astro.url.searchParams.get("area") || undefined
const personKey = Astro.url.searchParams.get("person") || undefined
const rawCursor = Astro.url.searchParams.get("before")
const parts = rawCursor?.match(/^(\d{1,16})\.(\d{1,16})$/)
const before = parts ? { at: Number(parts[1]), id: Number(parts[2]) } : undefined
let invalid = Boolean((areaId && areaId.length > 128) || (personKey && !/^[a-f0-9]{32}$/.test(personKey)) ||
  (rawCursor !== null && (!before || !Number.isSafeInteger(before.at) || !Number.isSafeInteger(before.id) || before.id < 1)))

let areas: Awaited<ReturnType<HierarchyRepository["findAllAreas"]>> = []
let people = new Map<string, string>()
let page: Awaited<ReturnType<typeof readRecentActivity>> = { items: [], next: null }
let haBaseUrl: string | null = null
let unavailable = false

if (!invalid && workScope && roster) {
  try {
    await ensureSchema()
    const client = getPersistenceClient()
    areas = await new HierarchyRepository(client, workScope).findAllAreas()
    const names = new Map<string, number>()
    for (const name of roster.values()) names.set(name, (names.get(name) ?? 0) + 1)
    for (const [id, name] of roster) {
      const key = recentActivityPersonKey(id)
      people.set(key, (names.get(name) ?? 0) > 1 ? `${name} · ${key.slice(-6)}` : name)
    }
    invalid = Boolean((areaId && !areas.some(area => area.id === areaId)) || (personKey && !people.has(personKey)))
    if (!invalid) {
      page = await readRecentActivity(client, workScope, { areaId, personKey, before })
      if (page.items.some(item => item.kind === "agent" && item.provenance?.originTarget && !isSettingsOriginTarget(item.provenance.originTarget))) {
        haBaseUrl = await getHABaseUrl().catch(() => null)
      }
    }
  } catch {
    unavailable = true
  }
}
if (!denied && invalid) Astro.response.status = 400
if (!denied && unavailable) Astro.response.status = 503

const boardParams = new URLSearchParams(workScope ? { board_id: workScope.boardId } : {})
const clearHref = boardParams.size ? `/activity?${boardParams}` : "/activity"

function pageHref(cursor?: NonNullable<typeof page.next>): string {
  if (!workScope) return Astro.url.pathname + Astro.url.search
  const params = new URLSearchParams(boardParams)
  if (areaId) params.set("area", areaId)
  if (personKey) params.set("person", personKey)
  if (cursor) params.set("before", `${cursor.at}.${cursor.id}`)
  return params.size ? `/activity?${params}` : "/activity"
}

const timeZone = Astro.locals.timezone ?? "Europe/Dublin"
const date = new Intl.DateTimeFormat(locale === "ga" ? "ga-IE" : "en-IE", { dateStyle: "medium", timeStyle: "short", timeZone })
const actionIcons = { added: "plus", edited: "pencil", closed: "check", reopened: "rotate" } as const
---

<Layout title={t("recent_activity.title", locale)} suppressTaskUrlOpen privatePageShell={denied} hideSearchHub={denied}>
  <section class="recent-activity" data-recent-activity aria-labelledby="recent-activity-heading">
    <header class="activity-header">
      <div>
        <h1 id="recent-activity-heading"><Icon name="bolt" size={23} sprite />{t("recent_activity.title", locale)}</h1>
        <p>{t("recent_activity.description", locale)}</p>
      </div>
      {!denied && !invalid && !unavailable && !before && (
        <a href={pageHref()} class="btn btn-secondary" data-astro-prefetch="false" data-astro-reload>
          <Icon name="refresh" size={16} sprite />
          {t("recent_activity.refresh", locale)}
        </a>
      )}
    </header>

    {denied ? (
      <div class="card activity-status" role="alert">
        <Icon name="warning" size={24} sprite />
        <p>{t(Astro.response.status === 403 ? "recent_activity.denied" : "recent_activity.unavailable", locale)}</p>
        <a href={Astro.url.pathname + Astro.url.search} class="btn btn-secondary" data-astro-prefetch="false" data-astro-reload>
          <Icon name="refresh" size={16} sprite />
          {t("recent_activity.refresh", locale)}
        </a>
      </div>
    ) : invalid || unavailable ? (
      <div class="card activity-status" role="status">
        <Icon name="warning" size={24} sprite />
        <p>{t(invalid ? "recent_activity.invalid" : "recent_activity.unavailable", locale)}</p>
        <a href={invalid ? clearHref : pageHref()} class="btn btn-secondary" data-astro-prefetch="false" data-astro-reload>
          <Icon name={invalid ? "x" : "refresh"} size={16} sprite />
          {t(invalid ? "recent_activity.clear" : "recent_activity.refresh", locale)}
        </a>
      </div>
    ) : (
      <>
        <form method="get" action="/activity" class="card activity-filters" aria-label={t("recent_activity.filters", locale)} data-astro-reload>
          {workScope && <input type="hidden" name="board_id" value={workScope.boardId} />}
          <label>
            <span class="form-label">{t("recent_activity.area", locale)}</span>
            <select class="form-select" name="area">
              <option value="">{t("recent_activity.all_areas", locale)}</option>
              {areas.map(area => <option value={area.id} selected={area.id === areaId}>{area.name}</option>)}
            </select>
          </label>
          <label>
            <span class="form-label">{t("recent_activity.person", locale)}</span>
            <select class="form-select" name="person">
              <option value="">{t("recent_activity.everyone", locale)}</option>
              {[...people].map(([key, name]) => <option value={key} selected={key === personKey}>{name}</option>)}
            </select>
          </label>
          <div class="activity-filter-actions">
            <button type="submit" class="btn btn-primary">{t("recent_activity.apply", locale)}</button>
            {(areaId || personKey) && (
              <a href={clearHref} class="btn btn-secondary" data-astro-prefetch="false" data-astro-reload>{t("recent_activity.clear", locale)}</a>
            )}
          </div>
        </form>
        {page.items.length ? (
          <ol class="card list-group list-group-flush activity-list" aria-label={t("recent_activity.title", locale)}>
            {page.items.map(item => {
              const author = item.personKey
                ? people.get(item.personKey) ?? t("recent_activity.member", locale)
                : item.kind === "agent" && item.provenance
                  ? formatVerifiedAgentAuthor(item.provenance)
                  : t(item.kind === "agent" ? "recent_activity.automation" : "recent_activity.local", locale)
              const provenanceLink = item.kind === "agent" && item.provenance
                ? resolveVerifiedProvenanceLink(item.provenance, haBaseUrl, locale)
                : null
              return (
                <li class="list-group-item activity-entry" data-activity-event={item.id}>
                  <span class="activity-event-icon"><Icon name={actionIcons[item.action]} size={18} sprite /></span>
                  <div class="activity-content">
                    <a href={taskDetailPath({ id: item.taskId, ticket_key: item.ticketKey })} class="activity-task" data-astro-prefetch="false">
                      {item.ticketNumber && <span class="activity-ticket">{item.ticketKey ?? formatTicketKey(item.ticketNumber)}</span>} {item.title}
                    </a>
                    <p class="activity-action">{t(`recent_activity.${item.action}`, locale, { author })}</p>
                    {provenanceLink && (
                      <a
                        href={provenanceLink.href}
                        class="activity-provenance-link"
                        data-astro-prefetch={provenanceLink.isInternal ? "false" : undefined}
                        data-ha-target={provenanceLink.haTarget}
                        target={provenanceLink.isExternalHa ? "_top" : undefined}
                        rel={provenanceLink.isExternalHa ? "noopener noreferrer" : undefined}
                      >
                        <Icon name={provenanceLink.isExternalHa ? "external-link" : "chevron-right"} size={14} sprite />
                        {provenanceLink.label}
                      </a>
                    )}
                  </div>
                  <div class="activity-meta">
                    <time datetime={new Date(item.at).toISOString()}>{date.format(item.at)}</time>
                    <span>{item.areaName ?? t("recent_activity.no_area", locale)}</span>
                  </div>
                </li>
              )
            })}
          </ol>
        ) : (
          <div class="card activity-status" role="status">
            <Icon name="empty" size={24} sprite />
            <p>{t("recent_activity.empty", locale)}</p>
          </div>
        )}
        {(before || page.next) && (
          <nav class="activity-pages" aria-label={t("recent_activity.pages", locale)}>
            {before && <a href={pageHref()} class="btn btn-secondary" data-astro-prefetch="false" data-astro-reload>
              <Icon name="arrow-up" size={16} sprite />
              {t("recent_activity.latest", locale)}
            </a>}
            {page.next && <a href={pageHref(page.next)} class="btn btn-secondary" data-astro-prefetch="false" data-astro-reload>
              <Icon name="arrow-down" size={16} sprite />
              {t("recent_activity.older", locale)}
            </a>}
          </nav>
        )}
      </>
    )}
  </section>
</Layout>

<script>
  import { pageLifecycle } from "@lib/page-lifecycle"

  pageLifecycle.onPageLoad(signal => {
    const section = document.querySelector<HTMLElement>("[data-recent-activity]")
    if (!section) return
    section.querySelectorAll<HTMLAnchorElement>("a[data-ha-target]").forEach(link => {
      const targetPath = link.dataset.haTarget
      if (targetPath && targetPath.startsWith("/") && !targetPath.startsWith("//") && !targetPath.startsWith("/\\")) {
        link.setAttribute("href", targetPath)
      }
    })
    if (section.dataset.historyGuard) return
    section.dataset.historyGuard = "true"

    window.addEventListener("pagehide", event => {
      if (!event.persisted) return
      // A browser history snapshot can outlive the verified Home Assistant session.
      section.hidden = true
      section.replaceChildren()
    }, { signal })
    window.addEventListener("pageshow", event => {
      if (event.persisted) window.location.reload()
    }, { signal })
  })
</script>

<style>
  .recent-activity {
    display: grid;
    gap: 1rem;
    max-width: 62rem;
    margin-inline: auto;
    padding: clamp(.875rem, 3vw, 1.75rem);
  }

  .recent-activity .card {
    animation: none;
    border-color: var(--border);
    box-shadow: none;
    transform: none;
    transition: none;
  }

  .activity-header, .activity-filters, .activity-filter-actions, .activity-pages {
    display: flex;
    flex-wrap: wrap;
    gap: .75rem;
  }

  .activity-header { align-items: center; justify-content: space-between; }
  .activity-header h1 { display: flex; align-items: center; gap: .5rem; font-size: 1.5rem; font-weight: 650; }
  .activity-header p { margin-block-start: .25rem; }

  .activity-filters {
    align-items: end;
    padding: clamp(.75rem, 2vw, 1rem);
  }

  .activity-filters label {
    display: grid;
    flex: 1 1 10rem;
    min-width: 0;
  }

  .activity-filters select { width: 100%; min-width: 0; }
  .recent-activity .btn, .activity-filters select { min-block-size: 2.75rem; }

  .activity-filters .btn-primary {
    background: var(--accent-text);
    color: var(--bg-card);
  }

  .activity-filters .btn-primary:hover { background: var(--text-primary); }

  .activity-list { margin: 0; padding: 0; list-style: none; }

  .activity-entry {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr) minmax(0, 13rem);
    align-items: start;
    gap: .25rem .75rem;
    padding: .625rem clamp(.75rem, 2vw, 1rem);
    overflow-wrap: anywhere;
  }

  .activity-entry + .activity-entry { border-block-start: 1px solid var(--border); }
  .activity-event-icon {
    display: grid;
    place-items: center;
    inline-size: 2rem;
    block-size: 2rem;
    margin-block-start: .375rem;
    border-radius: var(--radius-md);
    background: var(--bg-input);
    color: var(--accent-text);
  }

  .activity-task, .activity-provenance-link {
    display: inline-block;
    align-content: center;
    min-block-size: 2.75rem;
    color: var(--accent-text);
    text-decoration: underline;
    text-underline-offset: .15em;
  }

  .activity-task { font-weight: 600; }
  .activity-provenance-link { font-size: .875rem; }
  .activity-provenance-link :global(svg) { display: inline; vertical-align: -.15em; }
  .activity-ticket { font-size: .8125rem; font-variant-numeric: tabular-nums; white-space: nowrap; }
  .activity-entry a:hover { text-decoration-thickness: 2px; }
  .activity-header p, .activity-action, .activity-meta { color: var(--text-secondary); }
  .activity-action { margin: 0; font-size: .875rem; }
  .activity-meta { display: grid; gap: .125rem; padding-block-start: .5rem; font-size: .8125rem; text-align: end; }
  .activity-meta time { font-variant-numeric: tabular-nums; }
  .activity-pages { justify-content: flex-end; }
  .activity-status { display: grid; gap: .625rem; justify-items: center; text-align: center; overflow-wrap: anywhere; }
  .activity-status p { margin: 0; }

  @media (max-width: 40rem) {
    .activity-entry { grid-template-columns: auto minmax(0, 1fr); }
    .activity-meta {
      display: flex;
      flex-wrap: wrap;
      grid-column: 2;
      gap: .125rem .625rem;
      padding-block-start: 0;
      text-align: start;
    }
  }

  @media (max-width: 30rem) {
    .activity-filters label { flex-basis: 7rem; }
    .activity-filter-actions { flex-basis: 100%; }
  }
</style>
