---
import { organizationLabelsFor } from "@lib/organization-labels"
/**
 * /planning — Parent page for Planning views
 *
 * Opens Eisenhower by default, with Triage and RICE alongside it.
 * Legacy Spaces bookmarks open the Boards directory.
 *
 * Uses ParentPageShell for hash-based routing between sub-views.
 *
 * @domain navigation
 * @phase 15.1 — Planning-First Navigation Redesign
 */
import Layout from "../layouts/Layout.astro"
import ParentPageShell from "../components/layout/ParentPageShell.astro"
import SectionHubCard from "../components/layout/SectionHubCard.astro"
import { t } from "../i18n/translations"
import type { Locale } from "../lib/locale"
import { getTasksForView } from "../lib/task-queries"
import TriageIntake from "../components/planning/TriageIntake.astro"
import PlanningRice from "../components/planning/PlanningRice.astro"
import { ensureSchema, getPersistenceClient } from "@domains/tasks/persistence/store"
import { TaskRepository } from "@domains/tasks/persistence/task-repository"

let taskRepo: TaskRepository | undefined
try {
  await ensureSchema()
  taskRepo = new TaskRepository(getPersistenceClient())
} catch { /* the task list renders its existing unavailable state */ }

const label = await organizationLabelsFor(Astro)
const cookieLocale = Astro.cookies.get("meitheal-locale")?.value
const locale: Locale = cookieLocale === "ga" ? "ga" : "en"

const { tasks } = await getTasksForView({
  slim: true,
  descriptionPreviewChars: 240,
  excludeStatuses: ["complete", "archived"],
  timezone: Astro.locals.timezone || "Europe/Dublin",
})

// Derive Eisenhower quadrant counts
let q1 = 0, q2 = 0, q3 = 0, q4 = 0
for (const task of tasks) {
  if (task.is_done) continue
  switch (task.eisenhower_quadrant) {
    case "do":
    case "do-first": q1++; break
    case "schedule": q2++; break
    case "delegate": q3++; break
    case "eliminate":
    case "not-now": q4++; break
  }
}


---

<Layout title={`Meitheal — ${label("planning", false, t("nav.planning", locale))}`} hideSearchHub={true} hideGlobalSearch={true}>
  {/* Suppress TopNavigation — ParentPageShell provides its own UnifiedBar */}
  <Fragment slot="custom-header" />
  <ParentPageShell pageId="planning">

    <section data-parent-section="spaces" id="planning-section-spaces">
      <a class="btn btn-primary" href="/boards">Open {label("board", true)}</a>
    </section>

    {/* ─── Eisenhower ─── */}
    <section data-parent-section="eisenhower" id="planning-section-eisenhower" hidden>
      <SectionHubCard
        href="/eisenhower"
        icon="🎯"
        title="Eisenhower Matrix"
        description="Prioritise by urgency × importance — classify tasks into Do, Schedule, Delegate, or Eliminate quadrants."
        id="planning-eisenhower-link"
      >
        <div slot="stats" class="stat-card stat-card--do"><span class="stat-value">{q1}</span><span class="stat-label">🔴 Do Now</span></div>
        <div slot="stats" class="stat-card stat-card--schedule"><span class="stat-value">{q2}</span><span class="stat-label">🔵 Schedule</span></div>
        <div slot="stats" class="stat-card stat-card--delegate"><span class="stat-value">{q3}</span><span class="stat-label">🟡 Delegate</span></div>
        <div slot="stats" class="stat-card stat-card--eliminate"><span class="stat-value">{q4}</span><span class="stat-label">⚫ Eliminate</span></div>
      </SectionHubCard>
    </section>

    {/* ─── Triage ─── */}
    <section data-parent-section="triage" id="planning-section-triage" hidden>
      <TriageIntake {locale} />
    </section>

    {/* ─── RICE ─── */}
    <section data-parent-section="rice" id="planning-section-rice" hidden>
      <PlanningRice {tasks} {locale} {taskRepo} />
    </section>

  </ParentPageShell>
</Layout>



<script>
  import { pageLifecycle } from "@lib/page-lifecycle"
  import { safeIngressHref } from "@lib/ingress-navigation"

  pageLifecycle.onPageLoad(signal => {
    const bridge = () => {
      if (location.hash === "#spaces") location.replace(safeIngressHref("/boards"))
    }
    bridge()
    window.addEventListener("hashchange", bridge, { signal })
  })

</script>
