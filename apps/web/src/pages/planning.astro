---
/**
 * /planning — Parent page for Planning views (Eisenhower, Triage, RICE)
 *
 * Uses ParentPageShell for hash-based routing between sub-views.
 * Eisenhower links to the full legacy page. Triage and RICE show
 * live data previews with future expansion points.
 *
 * @domain navigation
 * @phase 15 — Hierarchy Architecture Overhaul
 */
import Layout from "../layouts/Layout.astro"
import ParentPageShell from "../components/layout/ParentPageShell.astro"
import InlineHelper from "../components/ui/InlineHelper.astro"
import { t } from "../i18n/translations"
import type { Locale } from "../lib/locale"
import { getTasksForView } from "../lib/task-queries"

const cookieLocale = Astro.cookies.get("meitheal-locale")?.value
const locale: Locale = cookieLocale === "ga" ? "ga" : "en"

const { tasks, counts } = await getTasksForView()

// Derive Eisenhower quadrant counts
let q1 = 0, q2 = 0, q3 = 0, q4 = 0
for (const task of tasks) {
  if (task.is_done) continue
  switch (task.eisenhower_quadrant) {
    case "do": q1++; break
    case "schedule": q2++; break
    case "delegate": q3++; break
    case "eliminate": q4++; break
  }
}

// Unscored tasks (for triage)
const unscoredCount = tasks.filter(t => !t.is_done && t.rice === null).length

// RICE-scored tasks
const riceScoredCount = tasks.filter(t => !t.is_done && t.rice !== null).length
const avgRice = riceScoredCount > 0
  ? Math.round(tasks.filter(t => !t.is_done && t.rice !== null).reduce((sum, t) => sum + (t.rice ?? 0), 0) / riceScoredCount)
  : 0
---

<Layout title={`Meitheal — ${t("nav.planning", locale)}`}>
  <ParentPageShell pageId="planning">
    <section data-parent-section="eisenhower" id="planning-section-eisenhower">
      <InlineHelper helperId="planning-hub-explainer" title="Planning & Prioritisation" icon="🧭" variant="info">
        <p><strong>Planning</strong> helps you decide <em>what to work on</em> and <em>in what order</em>. Use the Eisenhower Matrix for urgency × importance, Triage for quick classification, and RICE Scoring for data-driven prioritisation.</p>
      </InlineHelper>
      <div class="parent-section-hub">
        <div class="parent-section-hub__header">
          <span class="parent-section-hub__icon">🎯</span>
          <div>
            <h2 class="parent-section-hub__title">Eisenhower Matrix</h2>
            <p class="parent-section-hub__desc">Prioritise by urgency × importance — classify tasks into Do, Schedule, Delegate, or Eliminate quadrants.</p>
          </div>
        </div>
        <div class="parent-section-hub__stats">
          <div class="stat-card stat-card--do"><span class="stat-value">{q1}</span><span class="stat-label">🔴 Do Now</span></div>
          <div class="stat-card stat-card--schedule"><span class="stat-value">{q2}</span><span class="stat-label">🔵 Schedule</span></div>
          <div class="stat-card stat-card--delegate"><span class="stat-value">{q3}</span><span class="stat-label">🟡 Delegate</span></div>
          <div class="stat-card stat-card--eliminate"><span class="stat-value">{q4}</span><span class="stat-label">⚫ Eliminate</span></div>
        </div>
        <a href="/eisenhower" class="parent-section-hub__action">Open Full Matrix →</a>
      </div>
    </section>

    <section data-parent-section="triage" id="planning-section-triage" hidden>
      <div class="parent-section-hub">
        <div class="parent-section-hub__header">
          <span class="parent-section-hub__icon">📥</span>
          <div>
            <h2 class="parent-section-hub__title">Triage</h2>
            <p class="parent-section-hub__desc">Classify incoming tasks quickly — review unscored and uncategorised work that needs attention.</p>
          </div>
        </div>
        <div class="parent-section-hub__stats">
          <div class="stat-card"><span class="stat-value">{unscoredCount}</span><span class="stat-label">Needs Scoring</span></div>
          <div class="stat-card"><span class="stat-value">{counts.pending}</span><span class="stat-label">Pending</span></div>
        </div>
        <span class="parent-section-hub__badge">Coming Soon</span>
      </div>
    </section>

    <section data-parent-section="rice" id="planning-section-rice" hidden>
      <div class="parent-section-hub">
        <div class="parent-section-hub__header">
          <span class="parent-section-hub__icon">📊</span>
          <div>
            <h2 class="parent-section-hub__title">RICE Scoring</h2>
            <p class="parent-section-hub__desc">Reach × Impact × Confidence ÷ Effort — data-driven prioritisation for your task backlog.</p>
          </div>
        </div>
        <div class="parent-section-hub__stats">
          <div class="stat-card"><span class="stat-value">{riceScoredCount}</span><span class="stat-label">Scored Tasks</span></div>
          <div class="stat-card"><span class="stat-value">{avgRice}</span><span class="stat-label">Avg RICE</span></div>
        </div>
        <span class="parent-section-hub__badge">Coming Soon</span>
      </div>
    </section>
  </ParentPageShell>
</Layout>


