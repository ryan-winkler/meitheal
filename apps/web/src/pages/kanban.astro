---
/**
 * /kanban — Legacy redirect to /tasks (canonical kanban route).
 *
 * Phase 16.1: Kanban board now lives at /tasks.
 * This redirect maintains backward compatibility for bookmarks and links.
 *
 * @domain navigation
 * @phase 16.1 — Route consolidation
 */

import { requestedTaskView } from "../lib/task-view-route"

const { ingressPath } = Astro.locals
const params = new URL(Astro.request.url).searchParams
if (requestedTaskView(params)) params.set("view", "kanban")
const qs = params.toString()
const q = qs ? `?${qs}` : ""
return Astro.redirect(`${ingressPath || ""}/tasks${q}#kanban`, 301)
---

