---
/**
 * /tasks — Parent page for task views (Kanban, Calendar, Table, Gantt)
 *
 * Uses ParentPageShell for hash-based routing between sub-views.
 * Each sub-view section uses data-parent-section for controller toggling.
 *
 * @domain navigation
 * @phase 15 — Hierarchy Architecture Overhaul
 */
import Layout from "../layouts/Layout.astro"
import ParentPageShell from "../components/layout/ParentPageShell.astro"
import { t } from "../i18n/translations"
import type { Locale } from "../lib/locale"

const cookieLocale = Astro.cookies.get("meitheal-locale")?.value
const locale: Locale = cookieLocale === "ga" ? "ga" : "en"
---

<Layout title={`Meitheal — ${t("nav.tasks", locale)}`}>
  <ParentPageShell pageId="tasks">
    <section data-parent-section="kanban" id="tasks-section-kanban">
      <div class="parent-page-placeholder">
        <h2>Kanban Board</h2>
        <p>Drag-and-drop flow board — content migrating from <code>/kanban</code></p>
        <a href="/kanban" class="placeholder-link">Open legacy Kanban →</a>
      </div>
    </section>

    <section data-parent-section="calendar" id="tasks-section-calendar" hidden>
      <div class="parent-page-placeholder">
        <h2>Calendar</h2>
        <p>Monthly calendar view — content migrating from <code>/calendar</code></p>
        <a href="/calendar" class="placeholder-link">Open legacy Calendar →</a>
      </div>
    </section>

    <section data-parent-section="table" id="tasks-section-table" hidden>
      <div class="parent-page-placeholder">
        <h2>Table</h2>
        <p>Dense field table — content migrating from <code>/table</code></p>
        <a href="/table" class="placeholder-link">Open legacy Table →</a>
      </div>
    </section>

    <section data-parent-section="gantt" id="tasks-section-gantt" hidden>
      <div class="parent-page-placeholder">
        <h2>Gantt</h2>
        <p>Timeline view — content migrating from <code>/gantt</code></p>
        <a href="/gantt" class="placeholder-link">Open legacy Gantt →</a>
      </div>
    </section>
  </ParentPageShell>
</Layout>

<style>
  .parent-page-placeholder {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 0.75rem;
    padding: 4rem 2rem;
    text-align: center;
    color: var(--text-muted);
  }

  .parent-page-placeholder h2 {
    font-size: 1.5rem;
    font-weight: 600;
    color: var(--text-primary);
  }

  .parent-page-placeholder p {
    max-width: 36ch;
    line-height: 1.5;
  }

  .parent-page-placeholder code {
    font-size: 0.8em;
    padding: 0.15em 0.4em;
    border-radius: 4px;
    background: var(--bg-primary);
    border: 1px solid var(--border);
  }

  .placeholder-link {
    display: inline-flex;
    align-items: center;
    gap: 0.25rem;
    padding: 0.5rem 1rem;
    font-size: 0.875rem;
    font-weight: 500;
    color: var(--accent);
    background: rgba(var(--accent-rgb), 0.08);
    border: 1px solid rgba(var(--accent-rgb), 0.2);
    border-radius: var(--radius-sm, 6px);
    text-decoration: none;
    transition: background 150ms ease, border-color 150ms ease;
  }

  .placeholder-link:hover {
    background: rgba(var(--accent-rgb), 0.15);
    border-color: rgba(var(--accent-rgb), 0.35);
  }
</style>
