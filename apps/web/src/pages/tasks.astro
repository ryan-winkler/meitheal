---
import Layout from "../layouts/Layout.astro";

import UnifiedBar from "../components/layout/UnifiedBar.astro";
import SignalBar from "../components/layout/SignalBar.astro";
import { parseTaskView, taskViewUrl, TASK_VIEWS } from "../lib/task-view-route"
import { loadKanbanBoard } from "../lib/kanban-board-data"
import { readKanbanFilters, setKanbanPage } from "../lib/kanban-query"
import LabelBadges from "../components/ui/LabelBadges.astro";
import FilterToolbar from "../components/ui/FilterToolbar.astro";
import CardCustomizer from "../components/ui/CardCustomizer.astro";
import { t } from "../i18n/translations";
import type { Locale } from "../lib/locale";
import { calendarDaysFromToday, formatRegionalDate } from "../lib/date";
import { formatTicketKey } from "../lib/ticket-key";
import { buildTaskPath } from "../lib/task-detail-handoff"
import {
  ensureSchema,
  getPersistenceClient,
} from "@domains/tasks/persistence/store";
import { TaskInactivityRepository } from "@domains/tasks/persistence/task-inactivity-repository"
import { TaskRepository } from "@domains/tasks/persistence/task-repository";
import { SettingsRepository } from "@domains/tasks/persistence/settings-repository"
import StatusBadge from "../components/ui/StatusBadge.astro";
import TaskTypeIcon from "../components/ui/TaskTypeIcon.astro";
import BotBadge from "../components/ui/BotBadge.astro";
import TasksTableView from "../components/views/TasksTableView.astro";
import { readTableFilterParams } from "../lib/filter-state"
import { getTasksForView, type TaskViewItem } from "../lib/task-queries"
import TasksCalendarView from "../components/views/TasksCalendarView.astro";
import TasksTimelineView from "../components/views/TasksTimelineView.astro";
import AreaSelector from "../components/layout/AreaSelector.astro";
import { HierarchyRepository } from "@domains/tasks/persistence/hierarchy-repository";


const {
  ingressPath,
  hassUserId,
  timezone,
  weekStart,
  dateFormat,
} = Astro.locals;

// i18n: resolve locale from cookie
const cookieLocale = Astro.cookies.get("meitheal-locale")?.value;
const locale: Locale = cookieLocale === "ga" ? "ga" : "en";
const renderedView = parseTaskView(Astro.url.searchParams.get("view")) ?? "kanban"
const viewLabels = { kanban: "Kanban", table: "Table", calendar: "Calendar", timeline: "Timeline" }
const viewIcons = { kanban: "▦", table: "⊞", calendar: "🗓️", timeline: "📊" }
const heading = renderedView === "kanban" ? t("kanban.title", locale)
  : renderedView === "table" ? "Table View" : viewLabels[renderedView]
const currentUrl = new URL(Astro.url)
// The HTML ingress rewriter adds the mount path to these root-relative links.
currentUrl.pathname = "/tasks"
if (currentUrl.searchParams.has("boardRefresh") ||
    (renderedView === "table" && currentUrl.searchParams.has("tableRefresh"))) {
  currentUrl.searchParams.delete("boardRefresh")
  currentUrl.searchParams.delete("tableRefresh")
  Astro.response.headers.set("cache-control", "no-store")
}


await ensureSchema();
const db = getPersistenceClient();
const repo = new TaskRepository(db);
const hierarchyRepo = new HierarchyRepository(db);

// Completed task auto-hide: read retention setting (default 30 days, 0 = never hide)
let completedAutoHideDays = 30;
// Backlog mode: visible (default) | hidden | disabled
let backlogMode = "visible";
try {
  const settings = renderedView === "kanban" ? await repo.getSettings([
    "completed_auto_hide_days",
    "backlog_mode",
  ]) : {};
  if (settings.completed_auto_hide_days) {
    const val = Number(JSON.parse(settings.completed_auto_hide_days));
    if (!isNaN(val) && val >= 0) completedAutoHideDays = val;
  }
  if (settings.backlog_mode) {
    const val = JSON.parse(settings.backlog_mode);
    if (val === "hidden" || val === "disabled") backlogMode = val;
  }
} catch {
  /* settings table may not exist yet — use defaults */
}

const completedCutoffMs =
  completedAutoHideDays > 0 ? Date.now() - completedAutoHideDays * 86400000 : 0; // 0 = show all

let columns: {
  key: string;
  label: string;
  icon: string;
  includes: string[];
  builtIn: boolean;
  wipLimit: number;
  id: string;
}[] = [];
let workflowColumnsUnavailable = false
try {
  if (renderedView === "kanban" || renderedView === "table") columns = await repo.getKanbanLanes()
} catch {
  workflowColumnsUnavailable = true
}

if (renderedView === "table" && workflowColumnsUnavailable) {
  Astro.response.headers.set("Cache-Control", "no-store")
}

// Keep the last applied results when a requested workflow lookup fails during a refresh.
if (renderedView === "table" && workflowColumnsUnavailable &&
    Astro.url.searchParams.has("tableRefresh") && readTableFilterParams(Astro.url.searchParams).laneIds?.length) {
  return new Response("Workflow columns could not load.", { status: 503, headers: { "Cache-Control": "no-store" } })
}

let tableTasks: TaskViewItem[] = []
let tableCreationTimezone: string | undefined
let tableReadFailed = false
if (renderedView === "table") {
  const filters = readTableFilterParams(Astro.url.searchParams)
  try {
    tableTasks = (await getTasksForView({ requireAvailable: true, slim: true })).tasks
    if (filters.createdFrom || filters.createdThrough) {
      const { timezone } = await new SettingsRepository(db).getByKeys(["timezone"])
      if (typeof timezone === "string") tableCreationTimezone = timezone
    }
  } catch {
    const headers = { "Cache-Control": "no-store" }
    if (Astro.url.searchParams.has("tableRefresh")) {
      return new Response(t("table.refresh_failed", locale), { status: 503, headers })
    }
    tableReadFailed = true
    Astro.response.status = 503
    Astro.response.headers.set("Cache-Control", headers["Cache-Control"])
  }
}

// Fallback if no lanes in DB
if (columns.length === 0) {
  columns = [
    {
      id: "lane-backlog",
      key: "backlog",
      label: "Backlog",
      icon: "📥",
      includes: ["backlog"],
      builtIn: true,
      wipLimit: 0,
    },
    {
      id: "lane-pending",
      key: "pending",
      label: "Todo",
      icon: "📋",
      includes: ["pending"],
      builtIn: true,
      wipLimit: 0,
    },
    {
      id: "lane-active",
      key: "active",
      label: "In Progress",
      icon: "⚡",
      includes: ["active"],
      builtIn: true,
      wipLimit: 0,
    },
    {
      id: "lane-complete",
      key: "complete",
      label: "Done",
      icon: "✅",
      includes: ["complete"],
      builtIn: true,
      wipLimit: 0,
    },
  ];
}

// Backlog mode: filter out backlog lane when hidden or disabled
if (backlogMode === "hidden" || backlogMode === "disabled") {
  columns = columns.filter((col) => col.key !== "backlog");
}

import {
  PRIORITY_COLORS as priorityColors,
  PRIORITY_CSS_CLASSES as priorityClasses,
  PRIORITY_ICONS as priorityIcons,
} from "../lib/priority-config";

const priorityLabels: Record<number, string> = {
  1: t("priority.critical", locale),
  2: t("priority.high", locale),
  3: t("priority.medium", locale),
  4: t("priority.low", locale),
  5: t("priority.minimal", locale),
};

// Phase 20: Agile type metadata
const typeConfig: Record<string, { label: string; color: string }> = {
  epic: { label: "Epic", color: "#8b5cf6" },
  story: { label: "Story", color: "#3b82f6" },
  task: { label: "Task", color: "#6366F1" },
  bug: { label: "Bug", color: "#ef4444" },
};
const kanbanFilters = readKanbanFilters(currentUrl.searchParams)
const kanbanPages = renderedView === "kanban"
  ? await loadKanbanBoard(repo, columns, completedCutoffMs, currentUrl.searchParams).catch(() => null)
  : null
const inactivityEnabled = renderedView === "kanban" &&
  await new TaskInactivityRepository(db).hasEnabledPolicy(kanbanFilters.area || null).catch(() => false)
const kanbanTaskCount = Array.from(kanbanPages?.values() ?? []).reduce((sum, lane) => sum + lane.matches, 0)

function lanePageHref(key: string, page: number) {
  const url = taskViewUrl(currentUrl, "kanban")
  setKanbanPage(url, key, page)
  return url.pathname + url.search + url.hash
}

// SSR: fetch areas for the AreaSelector
let areas: { id: string; name: string; icon: string; color: string }[] = [];
try {
  const rawAreas = await hierarchyRepo.findAllAreas();
  areas = rawAreas.map((a) => ({
    id: String(a.id ?? ""),
    name: String(a.name ?? ""),
    icon: String(a.icon ?? "📁"),
    color: String(a.color ?? "#6366F1"),
  }));
} catch {
  /* areas table may not exist yet */
}
---

<Layout title={`Meitheal — ${heading}`}>

  <UnifiedBar
    title={heading}
    titleIcon={viewIcons[renderedView]}
    tabs={[]}
    searchPlaceholder="Search Meitheal…"
    searchScope="all"
    barId="kanban-bar"
    slot="custom-header"
    viewTabs={TASK_VIEWS.map(view => {
      const url = taskViewUrl(currentUrl, view)
      return { id: view, href: url.pathname + url.search + url.hash, label: viewLabels[view], icon: viewIcons[view], active: view === renderedView }
    })}
  >
    <AreaSelector slot="context" areas={areas} />
  </UnifiedBar>

  {renderedView === "kanban" && <>
  <!-- Kanban controls and board are rendered only for the selected view. -->
  <div class="tasks-filter-row" id="tasks-filter-row">
    <FilterToolbar
      view="kanban"
      showGroupBy
      showSearch
      hideAreaSelect
      showUserFilter
      showUserPills={false}
    />
    <!-- Kanban-specific toolbar buttons (Fields, Lanes) — shown/hidden by view controller -->
    <div class="kanban-toolbar-right" id="kanban-toolbar-actions" role="toolbar" aria-label="Kanban view actions">
      <a href="/deferred" class="kanban-toolbar-btn" data-astro-prefetch="false">
        {t("deferral.title", locale)}
      </a>
      <a href={kanbanFilters.area ? `/inactivity?area=${encodeURIComponent(kanbanFilters.area)}` : "/inactivity"}
        class="kanban-toolbar-btn" data-inactivity-link data-astro-prefetch="false">
        {t("inactivity.title", locale)}
      </a>
      <button
        type="button"
        class="kanban-toolbar-btn"
        id="toggle-fields-btn"
        title="Card fields"
        aria-label="Customize card fields"
        aria-pressed="false"
      >
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <rect x="3" y="3" width="7" height="7"></rect><rect x="14" y="3" width="7" height="7"></rect><rect x="14" y="14" width="7" height="7"></rect><rect x="3" y="14" width="7" height="7"></rect>
        </svg>
        <span class="kanban-toolbar-btn__label">Fields</span>
      </button>
      <button
        type="button"
        class="kanban-toolbar-btn"
        id="manage-lanes-btn"
        title={t("kanban.manage_swimlanes", locale)}
        aria-label="Lanes"
        aria-pressed="false"
      >
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <line x1="8" y1="6" x2="21" y2="6"></line><line x1="8" y1="12" x2="21" y2="12"></line><line x1="8" y1="18" x2="21" y2="18"></line><line x1="3" y1="6" x2="3.01" y2="6"></line><line x1="3" y1="12" x2="3.01" y2="12"></line><line x1="3" y1="18" x2="3.01" y2="18"></line>
        </svg>
        <span class="kanban-toolbar-btn__label">Lanes</span>
      </button>
    </div>
  </div>

  <div id="tasks-view-kanban" class="tasks-view-container" data-task-view="kanban">
  <div id="kanban-shell" class="page-shell">
    <!-- Stats signal bar (non-dismissable) -->
    <SignalBar id="kanban-signal-bar">
      <strong data-kanban-visible-count>{kanbanTaskCount}</strong>
      <span data-kanban-visible-label>{kanbanTaskCount === 1 ? t("kanban.task_singular", locale) : t("kanban.task_plural", locale)}</span>
      <strong>{columns.length}</strong> {t("kanban.lanes", locale)}
    </SignalBar>

    <div class="kanban-loading-status" data-kanban-loading role="status" hidden></div>
    <button type="button" class="btn btn-outline" data-kanban-retry hidden>{t("kanban.retry_board", locale)}</button>

    <!-- Card field customizer panel (toggled by Fields toolbar icon) -->
    <div class="kanban-fields-panel hidden" id="kanban-fields-panel">
      <CardCustomizer />
    </div>

      <div class="lane-mgmt hidden" id="lane-mgmt">
        <div class="lane-mgmt-inner">
          <div class="lane-mgmt-header">
            <strong>{t("kanban.manage_swimlanes", locale)}</strong>
            <button
              type="button"
              class="btn-icon lane-mgmt-close"
              id="lane-mgmt-close"
              aria-label="Close">✕</button
            >
          </div>
          <div id="lane-list"></div>
          <div class="lane-mgmt-add-row">
            <input
              type="text"
              class="form-input lane-mgmt-add-input"
              id="new-lane-input"
              placeholder={t("kanban.new_lane_placeholder", locale)}
            />
            <button
              type="button"
              class="btn btn-primary lane-mgmt-add-btn"
              id="add-lane-btn">{t("kanban.add_lane", locale)}</button
            >
          </div>
        </div>
      </div>

  <!-- P5-2: SVG icon defs — shared across all cards to avoid duplication -->
  <svg xmlns="http://www.w3.org/2000/svg" style="display:none">
    <defs>
      <symbol
        id="icon-child"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
      >
        <path d="M16 3h5v5"></path><path d="M8 3H3v5"></path><path
          d="M12 22v-8.3a4 4 0 0 0-1.172-2.872L3 3"></path><path d="m15 9 6-6"
        ></path>
      </symbol>
      <symbol
        id="icon-assign"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
      >
        <path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"></path><circle
          cx="9"
          cy="7"
          r="4"></circle><line x1="19" x2="19" y1="8" y2="14"></line><line
          x1="22"
          x2="16"
          y1="11"
          y2="11"></line>
      </symbol>
      <symbol
        id="icon-palette"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
      >
        <path
          d="M12 20a7.966 7.966 0 0 1-5.002-1.756l.002.001v-.683c0-1.794 1.492-3.25 3.333-3.25h3.334c1.84 0 3.333 1.456 3.333 3.25v.683A7.966 7.966 0 0 1 12 20Z"
        ></path><path d="M2 12C2 6.477 6.477 2 12 2s10 4.477 10 10"
        ></path><circle cx="12" cy="10" r="3"></circle>
      </symbol>
    </defs>
  </svg>

  <div
    id="kanban-board"
    class="kanban-board"
    data-available={String(Boolean(kanbanPages))}
    data-inactivity-enabled={String(inactivityEnabled)}
    data-inactivity-ready={t("inactivity.ready", locale)}
    data-inactivity-upcoming={t("inactivity.upcoming", locale)}
    data-inactivity-stalled={t("inactivity.stalled", locale)}
    data-group-by={kanbanFilters.groupBy}
    data-backlog-mode={backlogMode}
    data-reaction-count-label={t("reactions.card_count", locale)}
    style={`padding: 0 0 8px; grid-template-columns: repeat(${columns.length}, 1fr);`}
  >
    {
      columns.map((col) => {
        const lane = kanbanPages?.get(col.key)
        const colTasks = lane?.cards ?? []
        const laneTotal = lane?.total ?? 0
        const matches = lane?.matches ?? 0
        const wipExceeded = col.wipLimit > 0 && laneTotal > col.wipLimit
        return (
          <div
            class={`kanban-column${wipExceeded ? " wip-exceeded" : ""}`}
            data-status={col.key}
            data-lane-id={col.id}
            data-wip-limit={String(col.wipLimit)}
            data-total={laneTotal}
            data-page={lane?.page ?? 1}
            role="region"
            aria-label={`${col.label} Swimlane`}
          >
            <div class="kanban-column-header" data-column-key={col.key} tabindex="-1">
              <span class="kanban-column-title">
                <span class={`column-status-dot status-${col.key}`} />
                {col.label}
              </span>
              <span class="kanban-header-right">
                {col.wipLimit > 0 && (
                  <span
                    class={`kanban-wip${wipExceeded ? " wip-over" : ""}`}
                    title={`WIP limit: ${col.wipLimit}`}
                  >
                    {laneTotal}/{col.wipLimit}
                  </span>
                )}
                <span class="kanban-count">{matches}</span>
              </span>
            </div>
            <div class="kanban-cards">
              {/* Swimlane group containers (hidden by default, JS-driven grouping) */}
              {["epic", "story", "task"].map((type) => {
                const tc = typeConfig[type] ?? {
                  label: type,
                  color: "var(--text-muted)",
                };
                const count = colTasks.filter(
                  (t) => String(t.task_type ?? "task") === type,
                ).length;
                return (
                  <div
                    class={`swimlane-group swimlane-${type}`}
                    data-swimlane-type={type}
                    hidden
                  >
                    <div class="swimlane-header" data-type={type}>
                      <span
                        class={`swimlane-toggle ${count === 0 ? "opacity-30 pointer-events-none" : ""}`}
                      >
                        ▼
                      </span>
                      <TaskTypeIcon type={type} size={16} />
                      <span class="swimlane-label">{tc.label}</span>
                      <span class="swimlane-count">{count}</span>
                    </div>
                    <div class="swimlane-cards">
                      {/* Cards moved here by JS when grouping is active */}
                    </div>
                    <button
                      type="button"
                      class="kanban-add-btn swimlane-add-btn"
                      data-status={col.key}
                      data-task-type={type}
                      aria-label={`Add ${type} to ${col.label}`}
                    >
                      {t("kanban.add_task", locale)}
                    </button>
                  </div>
                );
              })}
              {/* Flat (non-grouped) card rendering */}
              {colTasks.map((task) => {
                const p = Number(task.priority ?? 3);
                const ticketKey = formatTicketKey(Number(task.ticket_number));
                const tt = String(task.task_type ?? "task");
                const tc = (typeConfig[tt] || typeConfig.task)!;
                const promoted = Number(task.is_promoted) === 1
                const fp =
                  typeof task.framework_payload === "string"
                    ? JSON.parse(String(task.framework_payload))
                    : {};
                // Phase 20: Sub-task indicator (ADHD Optimization)
                const childCount = Number(task.child_count ?? 0);
                const rice =
                  fp.reach && fp.impact && fp.confidence && fp.effort
                    ? Math.round(
                        (Number(fp.reach) *
                          Number(fp.impact) *
                          Number(fp.confidence)) /
                          Number(fp.effort),
                      )
                    : null;
                const dueDate = task.due_date
                  ? new Date(String(task.due_date))
                  : null;
                const today = new Date();
                today.setHours(0, 0, 0, 0);
                // Compare date-only due dates as calendar days in the user's timezone.
                const dueDays = task.due_date
                  ? calendarDaysFromToday(String(task.due_date), timezone || "Europe/Dublin")
                  : null;
                const dueStatus = dueDate
                  ? dueDays !== null
                    ? dueDays < 0 ? "overdue" : dueDays === 0 ? "today" : "upcoming"
                    : dueDate < today
                      ? "overdue"
                      : dueDate.toDateString() === new Date().toDateString()
                        ? "today"
                        : "upcoming"
                  : null;
                return (
                  <div
                    class={`kanban-card flat-card`}
                    draggable="true"
                    data-id={String(task.id)}
                    data-title={String(task.title)}
                    data-desc={
                      task.description
                        ? String(task.description).slice(0, 200)
                        : ""
                    }
                    data-priority={String(p)}
                    data-promoted={String(promoted)}
                    data-status={String(task.status)}
                    data-deferral-version={task.task_version}
                    data-deferral-revision={task.deferral_revision ?? ""}
                    data-task-type={tt}
                    data-task-kind={String(task.task_kind ?? "standard_action")}
                    data-area={String(task.area_id ?? "default")}
                    data-assigned={String(task.assigned_to ?? "")}
                    data-labels={String(task.labels ?? "[]")}
                    data-task-id={task.id}
                    data-area-id={task.project_id}
                    style={`--card-accent: ${task.color ? String(task.color) : tc.color};`}
                  >
                    <div class="kanban-card-header">
                      <div class="kanban-card-title">
                        <a
                          href={buildTaskPath(String(task.id))}
                          data-task-detail-link={String(task.id)}
                          class="card-open-btn"
                          data-id={String(task.id)}
                          aria-label={`Task: ${String(task.title)}, Priority: ${priorityLabels[p]}${ticketKey ? `, ${ticketKey}` : ""}${promoted ? `, ${t("kanban.promoted", locale)}` : ""}`}
                        >
                          <TaskTypeIcon type={tt} size={16} class="kanban-type-icon" />
                          <span class="kanban-ticket-key">{ticketKey}</span>
                        </a>
                        <span
                          class="kanban-title-text"
                          dir="auto"
                          title={String(task.title)}
                          data-task-id={String(task.id)}
                        >
                          {String(task.title)}
                        </span>
                      </div>
                      {Number(task.is_favorite ?? 0) === 1 && (
                        <span
                          class="kanban-fav"
                          title={t("kanban.favorite", locale)}
                        >
                          ★
                        </span>
                      )}
                      <span class="kanban-reaction-count" data-kanban-reaction-count role="img" hidden></span>
                      <button
                        type="button"
                        class="card-action-btn card-more-btn"
                        data-id={String(task.id)}
                        title={t("kanban.more_actions", locale)}
                        aria-label={t("kanban.more_actions_for", locale, { title: String(task.title) })}
                        aria-expanded="false"
                        aria-controls="kanban-card-menu"
                      >
                        ⋯
                      </button>
                    </div>
                    {promoted && <span class="kanban-promoted" aria-hidden="true">↑ {t("kanban.promoted", locale)}</span>}
                    {/* Attachment Placeholder */}
                    <img
                      class="kanban-attachment hidden"
                      data-task-id={String(task.id)}
                      alt="Attachment"
                      loading="lazy"
                    />

                    {task.description && String(task.description).trim() && (
                      <div class="kanban-card-desc">
                        {String(task.description).slice(0, 80)}
                        {String(task.description).length > 80 ? "…" : ""}
                      </div>
                    )}
                    <div data-inactivity-slot></div>
                    <div class="kanban-card-meta">
                      <span
                        class={`priority-label ${priorityClasses[p] ?? "priority-medium"}`}
                      >
                        {priorityIcons[p] ?? "→"} {priorityLabels[p]}
                      </span>
                      {task.due_date ? (
                        <span
                          class={`kanban-card-due ${dueStatus ? `due-${dueStatus}` : ""}`}
                        >
                          {dueStatus === "overdue"
                            ? "🔴"
                            : dueStatus === "today"
                              ? "🟡"
                              : "📅"}{" "}
                          {formatRegionalDate(String(task.due_date), {
                            format: dateFormat,
                            timezone,
                          })}
                        </span>
                      ) : null}
                      {childCount > 0 && (
                        <span
                          class="kanban-meta-subtasks"
                          title={`${childCount} sub-tasks`}
                        >
                          ↳ {childCount}
                        </span>
                      )}
                      {rice ? (
                        <span class="kanban-rice-badge">RICE: {rice}</span>
                      ) : null}
                      {String(task.calendar_sync_state) === "confirmed" && (
                        <span
                          class="kanban-sync-badge"
