  {renderedView === "timeline" && <TasksTimelineView />}

  <script>
    import { initTasksViewSwitcher } from "@lib/tasks-view-controller"
    import { initAreaSelector } from "@lib/area-selector-controller"
    import { parseTaskView } from "@lib/task-view-route"
    import {
      initUnifiedBarNewTaskButton,
      initUnifiedBarSearchLauncher,
    } from "@lib/unified-bar-controller"
    import { createClientLogger } from "@lib/client-logger"
    import { pageLifecycle } from "@lib/page-lifecycle"

    const log = createClientLogger("tasks", "page-init")
    let fieldsPanelAbort: AbortController | null = null

    pageLifecycle.onPageLoad((signal) => {
      const view = parseTaskView(document.querySelector<HTMLElement>("[data-task-view]")?.dataset.taskView ?? null)
      if (!view) return

      // Each init block is isolated with try/catch to prevent cascade failures.
      // If one controller throws (import failure, missing DOM, etc.), the rest still register.

      try {
        // Phase 16.1: Unified view switcher (kanban/table/calendar/timeline)
        initTasksViewSwitcher(view, signal)
      } catch (e) { log.error("view switcher init failed", e) }

      try {
        // Phase 16.2: Area/space context selector
        initAreaSelector(signal)
      } catch (e) { log.error("area selector init failed", e) }

      try {
        // The tasks page uses the unified bar for global actions, but view
        // switching is hash-based rather than page-shell section-based.
        initUnifiedBarSearchLauncher("kanban-bar")
        initUnifiedBarNewTaskButton({ barId: "kanban-bar" })
      } catch (e) { log.error("unified bar actions init failed", e) }

      if (view !== "kanban") return
      import("../lib/controllers/kanban-page-controller").then(({ initKanbanPage }) => {
        if (!signal.aborted) initKanbanPage(signal)
      }).catch(e => log.error("kanban area init failed", e))

      // ── Fields panel toggle ──────────────────────────────────────────────
      try {
        fieldsPanelAbort?.abort()
        fieldsPanelAbort = new AbortController()
        signal.addEventListener("abort", () => fieldsPanelAbort?.abort(), { once: true })
        const fieldsSignal = fieldsPanelAbort.signal
        const fieldsBtn = document.getElementById("toggle-fields-btn")
        const fieldsPanel = document.getElementById("kanban-fields-panel")

        // Ensure panel starts hidden (guards against HMR/dep-optimization reloads)
        fieldsPanel?.classList.add("hidden")

        const hideFieldsPanel = () => {
          fieldsPanel?.classList.add("hidden")
          fieldsBtn?.setAttribute("aria-pressed", "false")
        }

        fieldsBtn?.addEventListener("click", () => {
          const isHidden = fieldsPanel?.classList.toggle("hidden")
          fieldsBtn?.setAttribute("aria-pressed", String(!isHidden))
        }, { signal: fieldsSignal })

        // Close button inside the CardCustomizer panel (event delegation — robust against timing)
        fieldsPanel?.addEventListener("click", (e) => {
          if ((e.target as HTMLElement).closest("#card-customizer-close")) {
            e.stopPropagation()
            hideFieldsPanel()
          }
        }, { signal: fieldsSignal })

        // Click outside closes Fields panel
        document.addEventListener("click", (e) => {
          if (
            fieldsPanel && !fieldsPanel.classList.contains("hidden") &&
            !fieldsPanel.contains(e.target as Node) &&
            !fieldsBtn?.contains(e.target as Node)
          ) {
            hideFieldsPanel()
          }
        }, { signal: fieldsSignal })

        // Escape key closes Fields panel
        document.addEventListener("keydown", (e) => {
          if (e.key === "Escape" && fieldsPanel && !fieldsPanel.classList.contains("hidden")) {
            hideFieldsPanel()
            fieldsBtn?.focus()
          }
        }, { signal: fieldsSignal })
      } catch (e) { log.error("fields panel init failed", e) }

      // Lanes panel toggle handled by kanban-controller (inside initKanbanArea)
    })
  </script>
