                        class="card-action-btn card-child-btn"
                        data-id={String(task.id)}
                        data-title={String(task.title ?? "")}
                        data-status={String(task.status ?? "pending")}
                        data-priority={String(p)}
                        title="Add child task"
                        aria-label={`Add subtask to: ${String(task.title ?? "").slice(0, 50)}`}
                      >
                        <svg aria-hidden="true" width="12" height="12">
                          <use href="#icon-child" />
                        </svg>
                      </button>
                      <button
                        class="card-action-btn card-assign-btn"
                        data-id={String(task.id)}
                        data-assigned={String(task.assigned_to ?? "")}
                        title="Assign user"
                        aria-label={`Assign user to: ${String(task.title ?? "").slice(0, 50)}`}
                        aria-haspopup="true"
                      >
                        <svg aria-hidden="true" width="12" height="12">
                          <use href="#icon-assign" />
                        </svg>
                      </button>
