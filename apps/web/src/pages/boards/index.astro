---
import { organizationLabelsFor, newOrganizationLabel, organizationLocale } from "@lib/organization-labels"
import { BoardIntakeRepository } from "@domains/tasks/persistence/board-intake-repository"
import { getPersistenceClient } from "@domains/tasks/persistence/store"
import { isOrganizationFeatureAvailable as available } from "@lib/organization-request-context"
import Layout from "../../layouts/Layout.astro"
import "../../styles/boards.css"
import { boardViewKey, readBoardDirectory } from "@lib/board-view"
import { boardNavigationLinks } from "@lib/board-workspace"
import { boardSessionProof, currentBoardContext } from "@lib/named-board-request"

const label = await organizationLabelsFor(Astro)
const newLabel = (name: Parameters<typeof label>[0], fallback?: string) => newOrganizationLabel(label(name, false, fallback), organizationLocale(Astro))
const user = await currentBoardContext(Astro)
const directory = user ? await readBoardDirectory(user.actor) : null
const submissions = user ? await new BoardIntakeRepository(getPersistenceClient(), user.principal).findSubmissions(user.actor) : []
const snapshot = user && directory ? boardViewKey(directory, user.actor.id) : undefined
const boards = directory?.boards ?? []
---
<Layout title={label("board", true)} scopeGuard={false}>
  <span slot="page-title">{label("board", true)}</span>
  <div class="boards-workspace">
    {!user && <p>Your Board access is unavailable. Reload after opening your current session.</p>}
    <div data-board-directory={user && directory ? "" : undefined} data-board-verify="/api/boards" data-board-key={snapshot}
      data-board-session={user ? boardSessionProof(user.actor.id) : undefined}>
      <section class="named-boards board-directory" aria-labelledby="private-heading">
        <header class="boards-heading">
          <div>
            <h2 id="private-heading">{organizationLocale(Astro) === "ga" ? `Do ${label("board", true)}` : `Your ${label("board", true)}`}</h2>
            <p>Choose the people and work you want to focus on.</p>
          </div>
          {user && directory && available("organizer") && <details class="board-add">
            <summary class="btn btn-primary">{newLabel("board")}</summary>
            <form data-board-form="create" class="board-form">
              <label>{label("board")} <input name="name" required maxlength="100" autocomplete="off" /></label>
              <p role="status" data-board-feedback></p>
              <button type="submit" class="btn btn-primary">{organizationLocale(Astro) === "en" ? `Create ${label("board")}` : newLabel("board")}</button>
              <button type="button" class="btn btn-ghost" data-board-form-refresh hidden>Refresh Boards</button>
            </form>
          </details>}
        </header>
        <div class="boards-list board-directory-grid">
          {boards.map(board => <article class="board-tile board-directory-card" data-board-card={board.id}>
            <div>
              <a class="board-name" href={`/boards/${encodeURIComponent(board.id)}`}>{board.name}</a>
              <p class="board-note">{board.state === "archived" ? "Archived" : board.role}</p>
            </div>
            <nav class="board-card-actions" aria-label={`${board.name} workspace`}>
              {available("organizer") && (available("groups") || available("projects")) &&
                <a href={boardNavigationLinks({ boardId: board.id }).planning}>{label("group", true)} &amp; {label("project", true)}</a>}
              {board.role === "owner" && <a href={`/boards/${encodeURIComponent(board.id)}?view=groups#settings`}>Settings</a>}
            </nav>
            {<form data-board-form="sidebar" data-board-id={board.id} class="board-preference">
              <input type="hidden" name="hidden" value={board.hidden ? "false" : "true"} />
              <button type="submit" class="btn btn-ghost">{board.hidden ? "Show in my sidebar" : "Hide from my sidebar"}</button>
              <span role="status" data-board-feedback></span>
            </form>}
          </article>)}
        </div>
        {!boards.length && <p class="board-empty">Create a Board to start a shared body of work.</p>}
      </section>

      {user && directory && <>
      {directory.deletedBoards.length > 0 && <section class="named-boards" aria-labelledby="deleted-boards-heading">
        <h2 id="deleted-boards-heading">Deleted Boards</h2>
        <p>Restore a Board to resume its saved work and destinations.</p>
        <div class="boards-list">
          {directory.deletedBoards.map(board => <article class="board-tile">
            <span class="board-name">{board.name}</span>
            <form data-board-form="lifecycle" data-board-id={board.id} class="board-form">
              <input type="hidden" name="action" value="restore" />
              <input type="hidden" name="revision" value={board.revision} />
              <p role="status" data-board-feedback></p>
              <button type="submit" class="btn btn-primary" aria-label={`Restore Board ${board.name}`}>Restore Board</button>
            </form>
          </article>)}
        </div>
      </section>}

      {directory.destinations.length > 0 && <section class="named-boards" aria-labelledby="send-heading">
        <h2 id="send-heading">Send a task</h2>
        <form data-board-form="send" class="board-form board-send">
          <label>Destination
            <select name="destination" required>
              {directory.destinations.map(destination => <option value={destination.id} data-recipient={destination.acceptsAssignment ? "true" : undefined}>{destination.label}</option>)}
            </select>
          </label>
          <label>Title <input name="title" required maxlength="500" autocomplete="off" /></label>
          <label>Details <textarea name="description" maxlength="10000" rows="3"></textarea></label>
          <label class="check" data-board-recipient><input name="assign" type="checkbox" /> Assign to the recipient</label>
          <p role="status" data-board-feedback></p>
          <div class="board-form-actions">
            <button type="submit" class="btn btn-primary">Send task</button>
          </div>
        </form>
      </section>}
      {submissions.length > 0 && <details class="named-boards board-settings">
        <summary>Recent submissions</summary>
        <ul>
          {submissions.map(submission => <li>
            <span>{submission.title}</span>
            {submission.acknowledgement ? <span class="board-note">Sent · Receipt <code>{submission.acknowledgement}</code></span> :
              <form data-board-form="retry-send" class="board-preference">
                <input type="hidden" name="resumeId" value={submission.id} />
                <button type="submit" class="btn btn-ghost">Retry sending</button>
                <span role="status" data-board-feedback></span>
              </form>}
          </li>)}
        </ul>
      </details>}
      </>}
    </div>
    <p hidden data-board-expired role="status">Your Board view changed. <button type="button" class="btn btn-ghost" data-board-refresh>Refresh Boards</button></p>
  </div>
</Layout>

<script>
  import { pageLifecycle } from "@lib/page-lifecycle"
  import { bindBoardPage } from "@lib/boards-page"
  pageLifecycle.onPageLoad(bindBoardPage)
</script>
