---
// Bare ticket keys (`/mth-4`) are short links; any other unknown top-level path stays a 404.
import { ticketAliasTarget } from "../lib/ticket-alias"

const target = ticketAliasTarget(Astro.params.ticket, Astro.url.search, Astro.locals.ingressPath || "")
if (!target) return Astro.rewrite("/404")
return Astro.redirect(target, 302)
---
