---
/**
 * Eisenhower Matrix — Schema-driven urgency × importance prioritisation view
 *
 * @domain tasks
 * @bounded-context tasks (presentation)
 *
 * Quadrant assignment is derived from schema columns:
 *   urgency (0-5), importance (0-5), threshold = 3
 *
 *   Q1 — Do First   → urgency ≥ 3 AND importance ≥ 3
 *   Q2 — Schedule    → importance ≥ 3, urgency < 3
 *   Q3 — Delegate    → urgency ≥ 3, importance < 3
 *   Q4 — Not Now     → both < 3
 *
 * Drag-and-drop between quadrants updates urgency/importance via PATCH.
 * eisenhower_override = 1 flags manually placed tasks (📌 indicator).
 *
 * @kcs Phase 06: replaces old heuristic derivation (priority + due date)
 */
import Layout from "../layouts/Layout.astro"
import TaskListItem from "../components/tasks/TaskListItem.astro"
import { getTasksForView, type TaskViewItem } from "../lib/task-queries"
import { t } from "../i18n/translations"
import type { Locale } from "../lib/locale"

const cookieLocale = Astro.cookies.get("meitheal-locale")?.value
const locale: Locale = cookieLocale === "ga" ? "ga" : "en"

const { tasks } = await getTasksForView()
const openTasks = tasks.filter((t) => !t.is_done)

// ── Schema-driven quadrant partitioning ────────────────────────
const q1: TaskViewItem[] = [] // Do First  — urgent + important
const q2: TaskViewItem[] = [] // Schedule  — important, not urgent
const q3: TaskViewItem[] = [] // Delegate  — urgent, not important
const q4: TaskViewItem[] = [] // Not Now   — neither

for (const t of openTasks) {
  switch (t.eisenhower_quadrant) {
    case "do-first": q1.push(t); break
    case "schedule": q2.push(t); break
    case "delegate": q3.push(t); break
    case "not-now": q4.push(t); break
    default: q4.push(t) // unclassified (urgency=0, importance=0)
  }
}

// Tasks with both urgency=0 and importance=0 need triage
const unclassifiedCount = openTasks.filter((t) => t.urgency === 0 && t.importance === 0).length

interface Quadrant {
  id: string
  label: string
  desc: string
  colorToken: string
  emoji: string
  tasks: TaskViewItem[]
}

const quadrants: Quadrant[] = [
  { id: "do-first",  label: t("eisenhower.do_first", locale),  desc: t("eisenhower.do_first_desc", locale),  colorToken: "var(--danger)", emoji: "🔥", tasks: q1 },
  { id: "schedule",  label: t("eisenhower.schedule", locale),   desc: t("eisenhower.schedule_desc", locale),  colorToken: "var(--info)", emoji: "📅", tasks: q2 },
  { id: "delegate",  label: t("eisenhower.delegate", locale),   desc: t("eisenhower.delegate_desc", locale),  colorToken: "var(--warning)", emoji: "👥", tasks: q3 },
  { id: "not-now",   label: t("eisenhower.not_now", locale),    desc: t("eisenhower.not_now_desc", locale),   colorToken: "var(--text-muted)", emoji: "📦", tasks: q4 },
]
---

<Layout title="Eisenhower Matrix">
  <main id="eisenhower-page" class="eisenhower">
    <header class="eisenhower__header">
      <h1 class="eisenhower__title">{t("eisenhower.title", locale)}</h1>
      <p class="eisenhower__subtitle">{t("eisenhower.subtitle", locale)}</p>
    </header>

    {/* ── Triage banner — nudge for unclassified tasks ── */}
    {unclassifiedCount > 0 && (
      <div class="eisenhower__triage-banner" role="status">
        <span class="triage-banner__icon">📋</span>
        <span class="triage-banner__text">
          <strong>{unclassifiedCount}</strong> {unclassifiedCount === 1 ? "task needs" : "tasks need"} classification
        </span>
        <span class="triage-banner__hint">Drag them to the right quadrant</span>
      </div>
    )}

    <div class="eisenhower__grid">
      {quadrants.map((q) => (
        <section
          class="eisenhower__quadrant"
          data-quadrant={q.id}
          style={`--q-color: ${q.colorToken}`}
        >
          <header class="quadrant__header">
            <span class="quadrant__badge">{q.emoji}</span>
            <div class="quadrant__heading">
              <h2 class="quadrant__title">{q.label}</h2>
              <span class="quadrant__desc">{q.desc}</span>
            </div>
            <span class="quadrant__count">{q.tasks.length}</span>
          </header>

          {/* ── Q1 "Commit to Today" bridge ── */}
          {q.id === "do-first" && q.tasks.length > 0 && (
            <div class="quadrant__action-bar">
              <button
                class="quadrant__action-btn quadrant__action-btn--primary"
                data-action="commit-q1"
                title={t("eisenhower.commit_q1_title", locale)}
              >
                🎯 {t("eisenhower.commit_q1", locale)}
              </button>
            </div>
          )}

          {/* ── Q4 action row ── */}
          {q.id === "not-now" && q.tasks.length > 0 && (
            <div class="quadrant__action-bar">
              <button
                class="quadrant__action-btn quadrant__action-btn--muted"
                data-action="defer-q4"
                title={t("eisenhower.defer_q4_title", locale)}
              >
                📥 {t("eisenhower.defer_q4", locale)}
              </button>
              <button
                class="quadrant__action-btn quadrant__action-btn--danger"
                data-action="complete-q4"
                title={t("eisenhower.complete_q4_title", locale)}
              >
                ✅ {t("eisenhower.complete_q4", locale)}
              </button>
            </div>
          )}

          <div class="quadrant__tasks" data-drop-zone={q.id} role="list">
            {q.tasks.length === 0 ? (
              <div class="quadrant__empty">
                {t("eisenhower.empty_quadrant", locale)}
              </div>
            ) : (
              q.tasks.map((task) => (
                <div class="eisenhower__task-wrapper" data-unclassified={task.urgency === 0 && task.importance === 0 ? "true" : undefined}>
                  <TaskListItem task={task} compact={true} />
                  <div class="eisenhower__task-meta">
                    {task.eisenhower_override && (
                      <span class="tli__pin" title="Manually placed">📌</span>
                    )}
                  </div>
                </div>
              ))
            )}
          </div>

          {/* ── Quick-capture input per quadrant ── */}
          <div class="quadrant__quick-capture">
            <input
              type="text"
              class="quick-capture__input"
              data-quadrant-capture={q.id}
              placeholder={t("eisenhower.quick_add_placeholder", locale)}
              autocomplete="off"
            />
          </div>
        </section>
      ))}
    </div>

    <p class="eisenhower__hint">
      {t("eisenhower.drag_hint", locale)}
    </p>
  </main>

  <script>
    import { initEisenhowerPage } from "@lib/eisenhower-controller"
    document.addEventListener("astro:page-load", () => initEisenhowerPage())
  </script>
</Layout>

<style>
  .eisenhower {
    max-width: 1400px;
    margin: 0 auto;
    padding: 24px 20px;
    min-height: 100vh;
  }

  /* ── Header ── */
  .eisenhower__header {
    margin-bottom: 24px;
    text-align: center;
  }
  .eisenhower__title {
    font-size: 1.5rem;
    font-weight: 800;
    background: linear-gradient(135deg, var(--accent), color-mix(in srgb, var(--accent) 60%, var(--warning)));
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
    margin: 0;
  }
  .eisenhower__subtitle {
    font-size: 0.8125rem;
    color: var(--text-muted);
    margin: 4px 0 0;
  }

  /* ── 2×2 Grid ── */
  .eisenhower__grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    grid-template-rows: 1fr 1fr;
    gap: 16px;
    min-height: calc(100vh - 180px);
  }

  @media (max-width: 768px) {
    .eisenhower__grid {
      grid-template-columns: 1fr;
      grid-template-rows: auto;
      min-height: unset;
    }
  }

  /* ── Quadrant ── */
  .eisenhower__quadrant {
    background: rgba(var(--bg-card-rgb, 30, 30, 46), 0.6);
    backdrop-filter: blur(12px);
    border: 1px solid var(--border);
    border-top: 3px solid var(--q-color);
    border-radius: var(--radius-md, 10px);
    display: flex;
    flex-direction: column;
    overflow: hidden;
    transition: box-shadow 200ms, border-color 200ms;
  }
  .eisenhower__quadrant.quadrant--drag-over {
    border-color: var(--q-color);
    box-shadow: 0 0 20px rgba(var(--accent-rgb), 0.15);
  }

  /* ── Quadrant header ── */
  .quadrant__header {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 14px 16px 10px;
    border-bottom: 1px solid rgba(255, 255, 255, 0.04);
  }
  .quadrant__badge {
    font-size: 1.25rem;
    flex-shrink: 0;
  }
  .quadrant__heading {
    flex: 1;
    min-width: 0;
  }
  .quadrant__title {
    font-size: 0.9375rem;
    font-weight: 700;
    color: var(--text-primary);
    margin: 0;
  }
  .quadrant__desc {
    font-size: 0.6875rem;
    color: var(--text-muted);
    display: block;
    margin-top: 1px;
  }
  .quadrant__count {
    flex-shrink: 0;
    background: rgba(var(--accent-rgb), 0.15);
    color: var(--accent);
    font-size: 0.75rem;
    font-weight: 700;
    padding: 2px 8px;
    border-radius: 20px;
    min-width: 24px;
    text-align: center;
  }

  /* ── Task list inside quadrant ── */
  .quadrant__tasks {
    flex: 1;
    overflow-y: auto;
    padding: 8px 12px 12px;
    display: flex;
    flex-direction: column;
    gap: 6px;
    min-height: 80px;
  }

  .quadrant__empty {
    display: flex;
    align-items: center;
    justify-content: center;
    height: 100%;
    min-height: 80px;
    font-size: 0.8125rem;
    color: var(--text-muted);
    font-style: italic;
    opacity: 0.7;
  }

  /* ── Task wrapper (task + pin indicator) ── */
  .eisenhower__task-wrapper {
    position: relative;
  }
  .tli__pin {
    position: absolute;
    top: 4px;
    right: 4px;
    font-size: 0.6875rem;
    opacity: 0.7;
    pointer-events: none;
  }

  /* ── WIP warning ── */
  :global(.quadrant__wip-warning) {
    background: rgba(var(--warning-rgb, 245, 158, 11), 0.1);
    color: var(--warning);
    font-size: 0.75rem;
    padding: 6px 12px;
    border-bottom: 1px solid rgba(var(--warning-rgb, 245, 158, 11), 0.15);
  }

  /* ── Drag feedback ── */
  :global(.tli--dragging) {
    opacity: 0.5;
    transform: rotate(2deg);
  }

  /* ── Triage banner ── */
  .eisenhower__triage-banner {
    display: flex;
    align-items: center;
    gap: 10px;
    background: rgba(var(--warning-rgb, 245, 158, 11), 0.08);
    border: 1px solid rgba(var(--warning-rgb, 245, 158, 11), 0.2);
    border-radius: var(--radius-md, 10px);
    padding: 10px 16px;
    margin-bottom: 16px;
  }
  .triage-banner__icon {
    font-size: 1.125rem;
    flex-shrink: 0;
  }
  .triage-banner__text {
    font-size: 0.8125rem;
    color: var(--text-primary);
  }
  .triage-banner__hint {
    font-size: 0.75rem;
    color: var(--text-muted);
    margin-left: auto;
  }

  /* ── Task meta overlay (pin, badges) ── */
  .eisenhower__task-meta {
    display: flex;
    gap: 4px;
    align-items: center;
    position: absolute;
    top: 4px;
    right: 4px;
    pointer-events: none;
  }

  /* ── Unclassified task highlight ── */
  .eisenhower__task-wrapper[data-unclassified] {
    border-left: 2px dashed rgba(var(--warning-rgb, 245, 158, 11), 0.4);
    border-radius: 4px;
    padding-left: 4px;
  }

  /* ── Quadrant action bars (Q1 Commit, Q4 Defer/Complete) ── */
  .quadrant__action-bar {
    display: flex;
    gap: 6px;
    padding: 6px 12px;
    border-bottom: 1px solid rgba(255, 255, 255, 0.04);
  }
  .quadrant__action-btn {
    flex: 1;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 4px;
    padding: 6px 10px;
    border: 1px solid var(--border);
    border-radius: var(--radius-sm, 6px);
    background: rgba(255, 255, 255, 0.03);
    color: var(--text-secondary);
    font-size: 0.75rem;
    font-weight: 600;
    cursor: pointer;
    transition: background 150ms, border-color 150ms, color 150ms;
  }
  .quadrant__action-btn:hover {
    background: rgba(255, 255, 255, 0.06);
    color: var(--text-primary);
  }
  .quadrant__action-btn--primary {
    border-color: rgba(var(--accent-rgb), 0.3);
    color: var(--accent);
  }
  .quadrant__action-btn--primary:hover {
    background: rgba(var(--accent-rgb), 0.1);
    border-color: var(--accent);
  }
  .quadrant__action-btn--muted {
    color: var(--text-muted);
  }
  .quadrant__action-btn--danger {
    border-color: rgba(var(--danger-rgb, 239, 68, 68), 0.2);
    color: var(--text-muted);
  }
  .quadrant__action-btn--danger:hover {
    background: rgba(var(--danger-rgb, 239, 68, 68), 0.08);
    color: var(--danger, #ef4444);
    border-color: rgba(var(--danger-rgb, 239, 68, 68), 0.4);
  }

  /* ── Quick-capture inputs ── */
  .quadrant__quick-capture {
    padding: 6px 12px 10px;
    border-top: 1px solid rgba(255, 255, 255, 0.04);
    margin-top: auto;
  }
  .quick-capture__input {
    width: 100%;
    padding: 6px 10px;
    border: 1px solid var(--border);
    border-radius: var(--radius-sm, 6px);
    background: rgba(255, 255, 255, 0.03);
    color: var(--text-primary);
    font-size: 0.75rem;
    outline: none;
    transition: border-color 150ms, background 150ms;
  }
  .quick-capture__input::placeholder {
    color: var(--text-muted);
    opacity: 0.6;
  }
  .quick-capture__input:focus {
    border-color: var(--q-color);
    background: rgba(255, 255, 255, 0.05);
  }

  /* ── Hint ── */
  .eisenhower__hint {
    text-align: center;
    font-size: 0.75rem;
    color: var(--text-muted);
    margin-top: 16px;
    opacity: 0.6;
  }

  /* ── Reduced Motion ── */
  @media (prefers-reduced-motion: reduce) {
    .eisenhower__quadrant {
      transition: none;
    }
    :global(.tli--dragging) {
      transform: none;
    }
  }
</style>
