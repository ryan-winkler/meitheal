---
import { readBoardPagePlacement } from "@lib/board-page-placement"
import { boardContextHref } from "@lib/board-workspace"
import { resolveBoardPageScope, boardScopeResponse } from "@lib/board-http"

/**
 * Eisenhower Matrix — Schema-driven urgency × importance prioritisation view
 *
 * @domain tasks
 * @bounded-context tasks (presentation)
 *
 * Quadrant assignment is derived from schema columns:
 *   urgency (0-5), importance (0-5), threshold = 3
 *
 *   Q1 — Do First   → urgency ≥ 3 AND importance ≥ 3
 *   Q2 — Schedule    → importance ≥ 3, urgency < 3
 *   Q3 — Delegate    → urgency ≥ 3, importance < 3
 *   Q4 — Not Now     → both < 3
 *
 * Drag-and-drop between quadrants updates urgency/importance via PATCH.
 * eisenhower_override = 1 flags manually placed tasks (📌 indicator).
 *
 * @kcs Phase 06: replaces old heuristic derivation (priority + due date)
 */
import Layout from "../layouts/Layout.astro"

import UnifiedBar from "../components/layout/UnifiedBar.astro"
import TaskListItem from "../components/tasks/TaskListItem.astro"
import ScoringTriageModal from "../components/planning/ScoringTriageModal.astro"
import Icon from "../components/ui/Icon.astro"
import type { IconName } from "../generated/icon-registry"
import { getTasksForView, type TaskViewItem } from "../lib/task-queries"
import { EISENHOWER_SECTIONS } from "../lib/eisenhower-registry"
import { t } from "../i18n/translations"
import type { Locale } from "../lib/locale"
const workScopeResult = await resolveBoardPageScope(Astro, { boardId: Astro.props.boardId })
if (!workScopeResult.ok) return boardScopeResponse(workScopeResult.errorCode)
const workScope = workScopeResult.scope
const pagePlacement = await readBoardPagePlacement(workScope, Astro.url)
if (!pagePlacement.ok) return boardScopeResponse(pagePlacement.errorCode)
const placement = pagePlacement.placement


const cookieLocale = Astro.cookies.get("meitheal-locale")?.value
const locale: Locale = cookieLocale === "ga" ? "ga" : "en"

const todayStr = new Date().toISOString().slice(0, 10)
const todayStartMs = Date.parse(`${todayStr}T00:00:00.000Z`)
const { tasks } = await getTasksForView({
  areaId: placement.areaId ?? undefined,
  projectId: placement.projectId ?? undefined,
  slim: true,
  descriptionPreviewChars: 240,
  includeDeferred: false,
  excludeCompletedBeforeMs: todayStartMs,
  timezone: Astro.locals.timezone || "Europe/Dublin",
}, workScope)
const openTasks = tasks.filter((t) => !t.is_done && t.deferred_at === null)

// ── Schema-driven quadrant partitioning ────────────────────────
const q1: TaskViewItem[] = [] // Do First  — urgent + important
const q2: TaskViewItem[] = [] // Schedule  — important, not urgent
const q3: TaskViewItem[] = [] // Delegate  — urgent, not important
const q4: TaskViewItem[] = [] // Not Now   — neither

for (const t of openTasks) {
  switch (t.eisenhower_quadrant) {
    case "do-first": q1.push(t); break
    case "schedule": q2.push(t); break
    case "delegate": q3.push(t); break
    case "not-now": q4.push(t); break
    default: q4.push(t) // unclassified (urgency=0, importance=0)
  }
}

// Tasks with both urgency=0 and importance=0 need triage
const unclassifiedCount = openTasks.filter((t) => t.urgency === 0 && t.importance === 0).length

// Completed today count (for dopamine feedback)
const completedToday = tasks.filter((t) => {
  if (!t.is_done) return false
  if (typeof t.updated_at === "number") return t.updated_at >= todayStartMs
  const raw = String(t.updated_at ?? "")
  const ms = /^\d+$/.test(raw) ? Number(raw) : Date.parse(raw)
  return Number.isFinite(ms) && ms >= todayStartMs
}).length

// WIP limit threshold for Q1 (Dan Ariely / Kelly McGonigal audit)
const Q1_WIP_LIMIT = 5

interface Quadrant {
  id: string
  label: string
  desc: string
  colorToken: string
  icon: IconName
  tasks: TaskViewItem[]
  effortLabel: string
}

function computeEffortLabel(tasks: TaskViewItem[]): string {
  const total = tasks.reduce((sum, t) => sum + (t.effort_minutes ?? 0), 0)
  if (total <= 0) return ""
  const h = Math.floor(total / 60)
  const m = total % 60
  if (h === 0) return `~${m}m`
  if (m === 0) return `~${h}h`
  return `~${h}h ${m}m`
}

const quadrants: Quadrant[] = [
  { id: "do-first",  label: t("eisenhower.do_first", locale),  desc: t("eisenhower.do_first_desc", locale),  colorToken: "var(--danger)", icon: "flame", tasks: q1, effortLabel: computeEffortLabel(q1) },
  { id: "schedule",  label: t("eisenhower.schedule", locale),   desc: t("eisenhower.schedule_desc", locale),  colorToken: "var(--info)", icon: "calendar", tasks: q2, effortLabel: computeEffortLabel(q2) },
  { id: "delegate",  label: t("eisenhower.delegate", locale),   desc: t("eisenhower.delegate_desc", locale),  colorToken: "var(--warning)", icon: "users", tasks: q3, effortLabel: computeEffortLabel(q3) },
  { id: "not-now",   label: t("eisenhower.not_now", locale),    desc: t("eisenhower.not_now_desc", locale),   colorToken: "var(--text-muted)", icon: "package", tasks: q4, effortLabel: computeEffortLabel(q4) },
]

// Badge helpers (avoid <= in JSX which esbuild parses as HTML)
function effortClass(m: number): string {
  if (m <= 15) return "effort--quick"
  if (m <= 60) return "effort--medium"
  return "effort--long"
}
function effortIconName(m: number): IconName {
  if (m <= 15) return "bolt"
  return "clock"
}
function effortLabelText(m: number): string {
  if (m <= 60) return `${m}m`
  return `${Math.round(m / 60)}h`
}
function parseFrameworkPayload(fp: unknown): Record<string, unknown> {
  if (typeof fp === "string") try { return JSON.parse(fp) } catch { return {} }
  if (typeof fp === "object" && fp !== null) return fp as Record<string, unknown>
  return {}
}

const boardContext = {
  boardId: workScope.boardId,
  area: pagePlacement.area?.id,
  project: pagePlacement.project?.id,
}
const planningHref = boardContextHref(boardContext, "/planning#eisenhower")
const riceHref = boardContextHref(boardContext, "/planning#rice")
const todayHref = boardContextHref(boardContext, "/today")
const upcomingHref = boardContextHref(boardContext, "/upcoming")
const kanbanHref = boardContextHref(boardContext, "/tasks?view=kanban#kanban")
const calendarHref = boardContextHref(boardContext, "/tasks?view=calendar#calendar")
---

<Layout title="Eisenhower Matrix">
  <h1 class="sr-only">{t("eisenhower.title", locale)}</h1>

  <UnifiedBar
    title="Eisenhower"
    titleIcon="eisenhower"
    tabs={EISENHOWER_SECTIONS.map((section) => ({
      id: section.id,
      label: section.label,
      icon: section.icon,
    }))}
    searchPlaceholder="Search Meitheal…"
    searchScope="all"
    barId="eisenhower-bar"
    slot="custom-header"
  >
    <button
      slot="actions"
      type="button"
      class="unified-bar__new-task-btn eisenhower__review-btn-bar"
      data-action="start-review"
      title={t("eisenhower.review_title", locale)}
      aria-label={t("eisenhower.review_title", locale)}
    >
      <Icon name="search" size={14} sprite />
      <span class="unified-bar__new-task-label">{t("eisenhower.review_cta", locale)}</span>
    </button>
  </UnifiedBar>

  <div id="eisenhower-shell" class="eisenhower">
    <section
      id="eisenhower-overview"
      class="eisenhower__overview-section"
      data-eisenhower-section
    >
      <div class="eisenhower__context-bar">
        <a href={planningHref} class="eisenhower__context-link">
          <Icon name="eisenhower" size={14} sprite />
          <span>Back to Planning</span>
        </a>
        <div class="eisenhower__context-links-right">
          <button type="button" class="eisenhower__context-link" data-action="start-triage" style="background:transparent;border:0;padding:0;cursor:pointer;font:inherit;">
            <Icon name="target" size={14} sprite />
            <span>Scoring Triage</span>
          </button>
          <a href={riceHref} class="eisenhower__context-link">
            <Icon name="chart-bar" size={14} sprite />
            <span>RICE Scoring</span>
          </a>
          <a href="/settings#scoring-settings" class="eisenhower__context-link">
            <Icon name="sliders" size={14} sprite />
            <span>Scoring settings</span>
          </a>
        </div>
      </div>

      <div class="eisenhower__overview-row">
        {completedToday > 0 && (
          <div class="eisenhower__completed-today" title={t("eisenhower.completed_today", locale)}>
            <Icon name="trophy" size={15} sprite class="completed-today__icon" />
            <span class="completed-today__count">{completedToday}</span>
            <span class="completed-today__label">{t("eisenhower.completed_today", locale)}</span>
          </div>
        )}
        <p class="eisenhower__subtitle">{t("eisenhower.subtitle", locale)}</p>
      </div>
    </section>

    {/* ── Triage banner — nudge for unclassified tasks ── */}
    {unclassifiedCount > 0 && (
      <div class="eisenhower__triage-banner" role="status">
        <span class="triage-banner__icon" aria-hidden="true">
          <Icon name="clipboard-list" size={18} sprite />
        </span>
        <span class="triage-banner__text">
          <strong>{unclassifiedCount}</strong> {unclassifiedCount === 1 ? t("eisenhower.triage_single", locale) : t("eisenhower.triage_plural", locale)}
        </span>
        <button
          type="button"
          class="triage-banner__btn"
          data-action="start-triage"
          title={t("eisenhower.start_triage_title", locale)}
        >
          {t("eisenhower.start_triage", locale)}
        </button>
      </div>
    )}

    {/* ── Unified Tabler Multi-Framework Scoring Triage Modal ── */}
    <ScoringTriageModal defaultFramework="eisenhower" />

    {/* ── Weekly Review overlay ── */}
    <div id="review-overlay" class="review-overlay triage-overlay--hidden" role="dialog" aria-modal="true" aria-label="Weekly review">
      <div class="review-card">
        <header class="triage-card__header">
          <h2 class="triage-card__title">{t("eisenhower.review_title", locale)}</h2>
          <span class="triage-card__progress" id="review-progress">1 / ?</span>
          <button type="button" class="triage-card__close" data-action="close-review" aria-label="Close review">
            <Icon name="x" size={14} sprite />
          </button>
        </header>

        <div class="review-card__source" id="review-source">
          {/* Shows which quadrant the task came from */}
        </div>

        <div class="triage-card__task" id="review-task-name">
          {/* Populated by JS */}
        </div>

        <footer class="review-card__actions">
          <button type="button" class="review-action review-action--promote" data-action="review-promote" title={t("eisenhower.review_promote_title", locale)}>
            <Icon name="arrow-up" size={14} sprite />
            <span>{t("eisenhower.review_promote", locale)}</span>
          </button>
          <button type="button" class="review-action review-action--archive" data-action="review-archive" title={t("eisenhower.review_archive_title", locale)}>
            <Icon name="inbox" size={14} sprite />
            <span>{t("eisenhower.review_archive", locale)}</span>
          </button>
          <button type="button" class="review-action review-action--delete" data-action="review-delete" title={t("eisenhower.review_delete_title", locale)}>
            <Icon name="trash" size={14} sprite />
            <span>{t("eisenhower.review_delete", locale)}</span>
          </button>
          <button type="button" class="review-action review-action--skip" data-action="review-skip">
            <span>{t("eisenhower.review_skip", locale)}</span>
          </button>
        </footer>
      </div>
    </div>

    <section id="eisenhower-matrix" data-eisenhower-section>
    <div class="eisenhower__mobile-tabs" role="tablist" aria-label={t("eisenhower.quadrant_tabs", locale)}>
      {quadrants.map((q, i) => (
        <button
          type="button"
          class="mobile-tab"
          id={`eisenhower-tab-${q.id}`}
          role="tab"
          aria-controls={`eisenhower-quadrant-${q.id}`}
          aria-selected={i === 0 ? "true" : "false"}
          tabindex={i === 0 ? 0 : -1}
          style={`--tab-color: ${q.colorToken}`}
        >
          <span class="mobile-tab__emoji" aria-hidden="true">
            <Icon name={q.icon} size={14} sprite />
          </span>
          {q.label}
          <span class="mobile-tab__count">{q.tasks.length}</span>
        </button>
      ))}
    </div>
    <div class="eisenhower__grid">
      {quadrants.map((q) => (
        <section
          class={`eisenhower__quadrant ${q.id === "schedule" ? "quadrant--growth-zone" : ""}`}
          id={`eisenhower-quadrant-${q.id}`}
          data-quadrant={q.id}
          style={`--q-color: ${q.colorToken}`}
        >
          <header class="quadrant__header">
            <span class="quadrant__badge" aria-hidden="true">
              <Icon name={q.icon} size={18} sprite />
            </span>
            <div class="quadrant__heading">
              <h2 class="quadrant__title">{q.label}</h2>
              <span class="quadrant__desc">{q.desc}</span>
              {q.id === "schedule" && (
                <span class="quadrant__sublabel">
                  <Icon name="sparkles" size={11} sprite />
                  <span>{t("eisenhower.growth_zone", locale)}</span>
                </span>
              )}
            </div>
            <span class="quadrant__effort-total" data-effort-quadrant={q.id}>
              {q.effortLabel}
            </span>
            <span class="quadrant__count">{q.tasks.length}</span>
            <button
              type="button"
              class="quadrant__focus-btn"
              data-focus-quadrant={q.id}
              title={t("eisenhower.focus_mode", locale)}
              aria-label={`Focus on ${q.label}`}
            >
              <Icon name="arrows-maximize" size={14} sprite />
            </button>
          </header>

          {/* ── Q1 "Commit to Today" bridge ── */}
          {q.id === "do-first" && q.tasks.length > 0 && (
            <div class="quadrant__action-bar">
              <button
                type="button"
                class="quadrant__action-btn quadrant__action-btn--primary"
                data-action="commit-q1"
                title={t("eisenhower.commit_q1_title", locale)}
              >
                <Icon name="target" size={14} sprite />
                <span>{t("eisenhower.commit_q1", locale)}</span>
              </button>
            </div>
          )}

          {/* ── Q1 WIP limit warning ── */}
          {q.id === "do-first" && q.tasks.length > Q1_WIP_LIMIT && (
            <div class="quadrant__wip-warning" role="alert">
              <Icon name="alert-triangle" size={14} sprite />
              <span>{t("eisenhower.wip_warning", locale).replace("{count}", String(q.tasks.length)).replace("{limit}", String(Q1_WIP_LIMIT))}</span>
            </div>
          )}

          {/* ── Q2 "Schedule This Week" action ── */}
          {q.id === "schedule" && q.tasks.length > 0 && (
            <div class="quadrant__action-bar">
              <button
                type="button"
                class="quadrant__action-btn quadrant__action-btn--primary"
                data-action="schedule-q2"
                title={t("eisenhower.schedule_q2_title", locale)}
              >
                <Icon name="calendar" size={14} sprite />
                <span>{t("eisenhower.schedule_q2", locale)}</span>
              </button>
            </div>
          )}

          {/* ── Q3 quick-assign action ── */}
          {q.id === "delegate" && q.tasks.length > 0 && (
            <div class="quadrant__action-bar">
              <button
                type="button"
                class="quadrant__action-btn quadrant__action-btn--muted"
                data-action="assign-q3"
                title={t("eisenhower.assign_q3_title", locale)}
              >
                <Icon name="user" size={14} sprite />
                <span>{t("eisenhower.assign_q3", locale)}</span>
              </button>
            </div>
          )}

          {/* ── Q4 action row ── */}
          {q.id === "not-now" && q.tasks.length > 0 && (
            <div class="quadrant__action-bar">
              <button
                type="button"
                class="quadrant__action-btn quadrant__action-btn--muted"
                data-action="defer-q4"
                title={t("eisenhower.defer_q4_title", locale)}
              >
                <Icon name="inbox" size={14} sprite />
                <span>{t("eisenhower.defer_q4", locale)}</span>
              </button>
              <button
                type="button"
                class="quadrant__action-btn quadrant__action-btn--danger"
                data-action="complete-q4"
                title={t("eisenhower.complete_q4_title", locale)}
              >
                <Icon name="check" size={14} sprite />
                <span>{t("eisenhower.complete_q4", locale)}</span>
              </button>
            </div>
          )}

          <div class="quadrant__tasks" data-drop-zone={q.id} role={q.tasks.length > 0 ? "list" : undefined}>
            <div class="quadrant__empty" hidden={q.tasks.length > 0}>
              {t("eisenhower.empty_quadrant", locale)}
            </div>
            {q.tasks.map((task, idx) => (
              <div
                class={`eisenhower__task-wrapper ${q.id === "do-first" && idx === 0 ? "task-wrapper--top-task" : ""}`}
                role="listitem"
                data-unclassified={task.urgency === 0 && task.importance === 0 ? "true" : undefined}
                data-top-task={q.id === "do-first" && idx === 0 ? "true" : undefined}
              >
                <TaskListItem task={task} compact={true} />
                <div class="eisenhower__task-meta">
                  {q.id === "do-first" && idx === 0 && (
                    <span class="tli__top-badge" title="Top priority focus">
                      <Icon name="star" size={11} sprite />
                    </span>
                  )}
                  {task.eisenhower_override && (
                    <span class="tli__pin" title="Manually placed">
                      <Icon name="pin" size={12} sprite />
                    </span>
                  )}
                  {task.effort_minutes != null && task.effort_minutes > 0 && (
                    <span class={`tli__effort ${effortClass(task.effort_minutes)}`}
                      title={`Estimated effort: ${task.effort_minutes}m`}>
                      <Icon name={effortIconName(task.effort_minutes)} size={11} sprite />
                      <span class="tli__effort-label">{effortLabelText(task.effort_minutes)}</span>
                    </span>
                  )}
                  {task.blocked_by && (
                    <span class="tli__blocked" title={`Blocked: ${task.blocked_by}`}>
                      <Icon name="alert-triangle" size={12} sprite />
                    </span>
                  )}
                  {parseFrameworkPayload(task.framework_payload)?.recurrence_rule && (
                    <span class="tli__recurring" title="Recurring task">
                      <Icon name="repeat" size={12} sprite />
                    </span>
                  )}
                </div>
              </div>
            ))}
          </div>

          {/* ── Quick-capture input per quadrant ── */}
          <div class="quadrant__quick-capture">
            <input
              type="text"
              class="quick-capture__input"
              data-quadrant-capture={q.id}
              placeholder={t("eisenhower.quick_add_placeholder", locale)}
              autocomplete="off"
            />
          </div>
        </section>
      ))}
    </div>

    <p class="eisenhower__hint">
      {t("eisenhower.drag_hint", locale)}
    </p>
    </section>

    <section id="eisenhower-flow" class="eisenhower__flow-section" data-eisenhower-section>
      <h2 class="eisenhower__flow-heading">Flow</h2>
      <div class="eisenhower__flow-grid">
        <a href={todayHref} class="eisenhower__flow-card">
          <span class="flow-card__icon" aria-hidden="true"><Icon name="today" size={20} sprite /></span>
          <span class="flow-card__label">Today</span>
          <span class="flow-card__desc">Committed daily work surface</span>
        </a>
        <a href={upcomingHref} class="eisenhower__flow-card">
          <span class="flow-card__icon" aria-hidden="true"><Icon name="upcoming" size={20} sprite /></span>
          <span class="flow-card__label">Upcoming</span>
          <span class="flow-card__desc">Next 7 days at a glance</span>
        </a>
        <a href={kanbanHref} class="eisenhower__flow-card">
          <span class="flow-card__icon" aria-hidden="true"><Icon name="kanban" size={20} sprite /></span>
          <span class="flow-card__label">Kanban</span>
          <span class="flow-card__desc">Workflow board by status</span>
        </a>
        <a href={calendarHref} class="eisenhower__flow-card">
          <span class="flow-card__icon" aria-hidden="true"><Icon name="calendar" size={20} sprite /></span>
          <span class="flow-card__label">Calendar</span>
          <span class="flow-card__desc">Monthly timeline view</span>
        </a>
        <a href={riceHref} class="eisenhower__flow-card">
          <span class="flow-card__icon" aria-hidden="true"><Icon name="chart-bar" size={20} sprite /></span>
          <span class="flow-card__label">RICE Scoring</span>
          <span class="flow-card__desc">Rank work by Reach, Impact, Confidence, Effort</span>
        </a>
      </div>
    </section>
  </div>

  <script>
    import { initEisenhowerPage } from "@lib/eisenhower-controller"
    import { pageLifecycle } from "@lib/page-lifecycle"

    pageLifecycle.onPageLoad((signal) => initEisenhowerPage({ signal }))
  </script>
</Layout>

<style is:inline>
  .eisenhower {
    max-width: 1400px;
    margin: 0 auto;
    padding: 18px 20px 28px;
    min-height: 100vh;
  }

  :root[data-appearance-width="fluid"] .eisenhower {
    max-width: 100%;
  }

  .eisenhower__context-bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 10px;
    flex-wrap: wrap;
    margin-bottom: 12px;
  }

  .eisenhower__context-links-right {
    display: flex;
    align-items: center;
    gap: 8px;
    flex-wrap: wrap;
  }

  .eisenhower__context-link {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 4px 10px;
    border-radius: var(--radius-sm, 6px);
    font-size: 0.8125rem;
    font-weight: 500;
    color: var(--text-muted);
    text-decoration: none;
    transition: color 150ms cubic-bezier(0.23, 1, 0.32, 1), background-color 150ms cubic-bezier(0.23, 1, 0.32, 1);
  }

  .eisenhower__context-link:hover {
    color: var(--text-primary);
    background: var(--bg-hover);
  }

  /* ── Overview section ── */
  .eisenhower__overview-section {
    scroll-margin-top: var(--unified-bar-height, 88px);
    margin-bottom: 16px;
  }
  .eisenhower__overview-row {
    display: flex;
    align-items: center;
    gap: 16px;
    flex-wrap: wrap;
  }
  .eisenhower__subtitle {
    font-size: 0.8125rem;
    color: var(--text-muted);
    margin: 0;
  }

  /* ── Completed today counter ── */
  .eisenhower__completed-today {
    display: flex;
    align-items: center;
    gap: 6px;
    padding: 6px 14px;
    background: rgb(var(--success-rgb, 105 227 178) / 0.1);
    border: 1px solid rgb(var(--success-rgb, 105 227 178) / 0.25);
    border-radius: 20px;
    white-space: nowrap;
    flex-shrink: 0;
  }
  .completed-today__icon {
    color: var(--success, #22c55e);
  }
  .completed-today__count {
    font-size: 0.875rem;
    font-weight: 800;
    font-variant-numeric: tabular-nums;
    color: var(--success, #22c55e);
  }
  .completed-today__label {
    font-size: 0.6875rem;
    color: var(--text-secondary);
  }

  /* ── Top-task spotlight (first task in Q1) ── */
  .task-wrapper--top-task {
    position: relative;
    border: 1px solid rgb(var(--accent-rgb) / 0.28);
    border-radius: var(--radius-sm, 6px);
    background: rgb(var(--accent-rgb) / 0.05);
    box-shadow: 0 0 12px rgb(var(--accent-rgb) / 0.08);
  }
  .tli__top-badge {
    display: inline-flex;
    align-items: center;
