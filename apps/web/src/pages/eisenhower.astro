---
/**
 * Eisenhower Matrix — Schema-driven urgency × importance prioritisation view
 *
 * @domain tasks
 * @bounded-context tasks (presentation)
 *
 * Quadrant assignment is derived from schema columns:
 *   urgency (0-5), importance (0-5), threshold = 3
 *
 *   Q1 — Do First   → urgency ≥ 3 AND importance ≥ 3
 *   Q2 — Schedule    → importance ≥ 3, urgency < 3
 *   Q3 — Delegate    → urgency ≥ 3, importance < 3
 *   Q4 — Not Now     → both < 3
 *
 * Drag-and-drop between quadrants updates urgency/importance via PATCH.
 * eisenhower_override = 1 flags manually placed tasks (📌 indicator).
 *
 * @kcs Phase 06: replaces old heuristic derivation (priority + due date)
 */
import Layout from "../layouts/Layout.astro"

import UnifiedBar from "../components/layout/UnifiedBar.astro"
import TaskListItem from "../components/tasks/TaskListItem.astro"
import { getTasksForView, type TaskViewItem } from "../lib/task-queries"
import { EISENHOWER_SECTIONS } from "../lib/eisenhower-registry"
import { t } from "../i18n/translations"
import type { Locale } from "../lib/locale"

const cookieLocale = Astro.cookies.get("meitheal-locale")?.value
const locale: Locale = cookieLocale === "ga" ? "ga" : "en"

const { tasks } = await getTasksForView()
const openTasks = tasks.filter((t) => !t.is_done)

// ── Schema-driven quadrant partitioning ────────────────────────
const q1: TaskViewItem[] = [] // Do First  — urgent + important
const q2: TaskViewItem[] = [] // Schedule  — important, not urgent
const q3: TaskViewItem[] = [] // Delegate  — urgent, not important
const q4: TaskViewItem[] = [] // Not Now   — neither

for (const t of openTasks) {
  switch (t.eisenhower_quadrant) {
    case "do-first": q1.push(t); break
    case "schedule": q2.push(t); break
    case "delegate": q3.push(t); break
    case "not-now": q4.push(t); break
    default: q4.push(t) // unclassified (urgency=0, importance=0)
  }
}

// Tasks with both urgency=0 and importance=0 need triage
const unclassifiedCount = openTasks.filter((t) => t.urgency === 0 && t.importance === 0).length

// Completed today count (for dopamine feedback)
const todayStr = new Date().toISOString().slice(0, 10)
const completedToday = tasks.filter((t) => t.is_done && t.updated_at?.startsWith(todayStr)).length

// WIP limit threshold for Q1 (Dan Ariely / Kelly McGonigal audit)
const Q1_WIP_LIMIT = 5

interface Quadrant {
  id: string
  label: string
  desc: string
  colorToken: string
  emoji: string
  tasks: TaskViewItem[]
  effortLabel: string
}

function computeEffortLabel(tasks: TaskViewItem[]): string {
  const total = tasks.reduce((sum, t) => sum + (t.effort_minutes ?? 0), 0)
  if (total <= 0) return ""
  const h = Math.floor(total / 60)
  const m = total % 60
  if (h === 0) return `~${m}m`
  if (m === 0) return `~${h}h`
  return `~${h}h ${m}m`
}

const quadrants: Quadrant[] = [
  { id: "do-first",  label: t("eisenhower.do_first", locale),  desc: t("eisenhower.do_first_desc", locale),  colorToken: "var(--danger)", emoji: "🔥", tasks: q1, effortLabel: computeEffortLabel(q1) },
  { id: "schedule",  label: t("eisenhower.schedule", locale),   desc: t("eisenhower.schedule_desc", locale),  colorToken: "var(--info)", emoji: "📅", tasks: q2, effortLabel: computeEffortLabel(q2) },
  { id: "delegate",  label: t("eisenhower.delegate", locale),   desc: t("eisenhower.delegate_desc", locale),  colorToken: "var(--warning)", emoji: "👥", tasks: q3, effortLabel: computeEffortLabel(q3) },
  { id: "not-now",   label: t("eisenhower.not_now", locale),    desc: t("eisenhower.not_now_desc", locale),   colorToken: "var(--text-muted)", emoji: "📦", tasks: q4, effortLabel: computeEffortLabel(q4) },
]

// Badge helpers (avoid <= in JSX which esbuild parses as HTML)
function effortClass(m: number): string {
  if (m <= 15) return "effort--quick"
  if (m <= 60) return "effort--medium"
  return "effort--long"
}
function effortEmoji(m: number): string {
  if (m <= 15) return "⚡"
  if (m <= 60) return "⏱️"
  return "🏋️"
}
function effortLabelText(m: number): string {
  if (m <= 60) return `${m}m`
  return `${Math.round(m / 60)}h`
}
function parseFrameworkPayload(fp: unknown): Record<string, unknown> {
  if (typeof fp === "string") try { return JSON.parse(fp) } catch { return {} }
  if (typeof fp === "object" && fp !== null) return fp as Record<string, unknown>
  return {}
}
---

<Layout title="Eisenhower Matrix">

  <UnifiedBar
    title="Eisenhower"
    titleIcon="🎯"
    tabs={EISENHOWER_SECTIONS.map((section) => ({
      id: section.id,
      label: section.label,
      icon: section.icon,
    }))}
    searchPlaceholder="Search Meitheal…"
    searchScope="all"
    barId="eisenhower-bar"
    slot="custom-header"
  >
    <button
      slot="actions"
      type="button"
      class="unified-bar__new-task-btn eisenhower__review-btn-bar"
      data-action="start-review"
      title={t("eisenhower.review_title", locale)}
      aria-label={t("eisenhower.review_title", locale)}
    >
      <span class="unified-bar__new-task-label">🔍 {t("eisenhower.review_cta", locale)}</span>
    </button>
  </UnifiedBar>

  <main id="eisenhower-shell" class="eisenhower">
    <section
      id="eisenhower-overview"
      class="eisenhower__overview-section"
      data-eisenhower-section
    >
      <div class="eisenhower__overview-row">
        {completedToday > 0 && (
          <div class="eisenhower__completed-today" title={t("eisenhower.completed_today", locale)}>
            <span class="completed-today__icon">🏆</span>
            <span class="completed-today__count">{completedToday}</span>
            <span class="completed-today__label">{t("eisenhower.completed_today", locale)}</span>
          </div>
        )}
        <p class="eisenhower__subtitle">{t("eisenhower.subtitle", locale)}</p>
      </div>
    </section>

    {/* ── Mobile tab bar (visible < 768px) ── */}
    <nav class="eisenhower__mobile-tabs" role="tablist" aria-label="Quadrant tabs">
      {quadrants.map((q, i) => (
        <button
          class={`mobile-tab ${i === 0 ? "mobile-tab--active" : ""}`}
          data-tab-quadrant={q.id}
          role="tab"
          aria-selected={i === 0 ? "true" : "false"}
          style={`--tab-color: ${q.colorToken}`}
        >
          <span class="mobile-tab__emoji">{q.emoji}</span>
          <span class="mobile-tab__label">{q.label}</span>
          <span class="mobile-tab__count">{q.tasks.length}</span>
        </button>
      ))}
    </nav>

    {/* ── Triage banner — nudge for unclassified tasks ── */}
    {unclassifiedCount > 0 && (
      <div class="eisenhower__triage-banner" role="status">
        <span class="triage-banner__icon">📋</span>
        <span class="triage-banner__text">
          <strong>{unclassifiedCount}</strong> {unclassifiedCount === 1 ? t("eisenhower.triage_single", locale) : t("eisenhower.triage_plural", locale)}
        </span>
        <button
          class="triage-banner__btn"
          data-action="start-triage"
          title={t("eisenhower.start_triage_title", locale)}
        >
          {t("eisenhower.start_triage", locale)}
        </button>
      </div>
    )}

    {/* ── Triage overlay (one-at-a-time classification) ── */}
    <div id="triage-overlay" class="triage-overlay triage-overlay--hidden" role="dialog" aria-modal="true" aria-label="Task triage">
      <div class="triage-card">
        <header class="triage-card__header">
          <h2 class="triage-card__title">{t("eisenhower.triage_title", locale)}</h2>
          <span class="triage-card__progress" id="triage-progress">1 / {unclassifiedCount}</span>
          <button class="triage-card__close" data-action="close-triage" aria-label="Close triage">✕</button>
        </header>

        <div class="triage-card__task" id="triage-task-name">
          {/* Populated by JS */}
        </div>

        <div class="triage-card__controls">
          <div class="triage-control">
            <label class="triage-control__label">⚡ {t("eisenhower.triage_urgency", locale)}</label>
            <div class="triage-control__slider-row">
              <input type="range" id="triage-urgency" min="0" max="5" value="0" class="triage-control__slider" />
              <span class="triage-control__value" id="triage-urgency-val">0</span>
            </div>
            <div class="triage-control__labels">
              <span>{t("eisenhower.triage_not_urgent", locale)}</span>
              <span>{t("eisenhower.triage_critical", locale)}</span>
            </div>
          </div>

          <div class="triage-control">
            <label class="triage-control__label">⭐ {t("eisenhower.triage_importance", locale)}</label>
            <div class="triage-control__slider-row">
              <input type="range" id="triage-importance" min="0" max="5" value="0" class="triage-control__slider" />
              <span class="triage-control__value" id="triage-importance-val">0</span>
            </div>
            <div class="triage-control__labels">
              <span>{t("eisenhower.triage_not_important", locale)}</span>
              <span>{t("eisenhower.triage_critical", locale)}</span>
            </div>
          </div>
        </div>

        <div class="triage-card__quadrant-preview" id="triage-quadrant-preview">
          {/* Shows which quadrant the task will land in based on slider values */}
        </div>

        {/* ── Extended details (progressive disclosure) ── */}
        <details class="triage-card__details">
          <summary class="triage-card__expand-btn">📊 {t("eisenhower.triage_add_details", locale)}</summary>
          <div class="triage-card__extended">
            <div class="triage-control">
              <label class="triage-control__label">⏱️ {t("eisenhower.triage_effort", locale)}</label>
              <select id="triage-effort" class="triage-control__select">
                <option value="">{t("eisenhower.triage_effort_none", locale)}</option>
                <option value="5">⚡ 5m</option>
                <option value="15">⚡ 15m</option>
                <option value="30">⏱️ 30m</option>
                <option value="60">⏱️ 1h</option>
                <option value="120">🏋️ 2h</option>
                <option value="240">🏋️ 4h</option>
              </select>
            </div>
            <div class="triage-control">
              <label class="triage-control__label">🧠 {t("eisenhower.triage_effort_type", locale)}</label>
              <div class="triage-control__radio-row">
                <label><input type="radio" name="triage-effort-type" value="" checked /> —</label>
                <label><input type="radio" name="triage-effort-type" value="deep" /> 🧘 {t("eisenhower.effort_deep", locale)}</label>
                <label><input type="radio" name="triage-effort-type" value="shallow" /> 💬 {t("eisenhower.effort_shallow", locale)}</label>
                <label><input type="radio" name="triage-effort-type" value="admin" /> 📋 {t("eisenhower.effort_admin", locale)}</label>
              </div>
            </div>
            <div class="triage-control">
              <label class="triage-control__label">⚠️ {t("eisenhower.triage_delay_impact", locale)}</label>
              <select id="triage-delay-impact" class="triage-control__select">
                <option value="none">{t("eisenhower.delay_none", locale)}</option>
                <option value="inconvenient">{t("eisenhower.delay_inconvenient", locale)}</option>
                <option value="costly">{t("eisenhower.delay_costly", locale)}</option>
                <option value="critical">{t("eisenhower.delay_critical", locale)}</option>
              </select>
            </div>
            <div class="triage-control">
              <label class="triage-control__label">💡 {t("eisenhower.triage_interest", locale)}</label>
              <div class="triage-control__radio-row">
                <label><input type="radio" name="triage-interest" value="" checked /> —</label>
                <label><input type="radio" name="triage-interest" value="engaging" /> 🤩 {t("eisenhower.interest_engaging", locale)}</label>
                <label><input type="radio" name="triage-interest" value="neutral" /> 😐 {t("eisenhower.interest_neutral", locale)}</label>
                <label><input type="radio" name="triage-interest" value="dreaded" /> 😬 {t("eisenhower.interest_dreaded", locale)}</label>
                <label><input type="radio" name="triage-interest" value="quick-win" /> ⚡ {t("eisenhower.interest_quickwin", locale)}</label>
              </div>
            </div>
          </div>
        </details>

        <footer class="triage-card__footer">
          <button class="triage-card__skip" data-action="triage-skip">
            {t("eisenhower.triage_skip", locale)} →
          </button>
          <button class="triage-card__save" data-action="triage-save">
            {t("eisenhower.triage_classify", locale)} ✓
          </button>
        </footer>
      </div>
    </div>

    {/* ── Weekly Review overlay ── */}
    <div id="review-overlay" class="review-overlay triage-overlay--hidden" role="dialog" aria-modal="true" aria-label="Weekly review">
      <div class="review-card">
        <header class="triage-card__header">
          <h2 class="triage-card__title">{t("eisenhower.review_title", locale)}</h2>
          <span class="triage-card__progress" id="review-progress">1 / ?</span>
          <button class="triage-card__close" data-action="close-review" aria-label="Close review">✕</button>
        </header>

        <div class="review-card__source" id="review-source">
          {/* Shows which quadrant the task came from */}
        </div>

        <div class="triage-card__task" id="review-task-name">
          {/* Populated by JS */}
        </div>

        <footer class="review-card__actions">
          <button class="review-action review-action--promote" data-action="review-promote" title={t("eisenhower.review_promote_title", locale)}>
            ⬆️ {t("eisenhower.review_promote", locale)}
          </button>
          <button class="review-action review-action--archive" data-action="review-archive" title={t("eisenhower.review_archive_title", locale)}>
            📥 {t("eisenhower.review_archive", locale)}
          </button>
          <button class="review-action review-action--delete" data-action="review-delete" title={t("eisenhower.review_delete_title", locale)}>
            🗑️ {t("eisenhower.review_delete", locale)}
          </button>
          <button class="review-action review-action--skip" data-action="review-skip">
            {t("eisenhower.review_skip", locale)} →
          </button>
        </footer>
      </div>
    </div>

    <section id="eisenhower-matrix" data-eisenhower-section>
    <div class="eisenhower__grid">
      {quadrants.map((q) => (
        <section
          class={`eisenhower__quadrant ${q.id === "schedule" ? "quadrant--growth-zone" : ""}`}
          data-quadrant={q.id}
          style={`--q-color: ${q.colorToken}`}
        >
          <header class="quadrant__header">
            <span class="quadrant__badge">{q.emoji}</span>
            <div class="quadrant__heading">
              <h2 class="quadrant__title">{q.label}</h2>
              <span class="quadrant__desc">{q.desc}</span>
              {q.id === "schedule" && (
                <span class="quadrant__sublabel">🌱 {t("eisenhower.growth_zone", locale)}</span>
              )}
            </div>
            <span class="quadrant__effort-total" data-effort-quadrant={q.id}>
              {q.effortLabel}
            </span>
            <span class="quadrant__count">{q.tasks.length}</span>
            <button
              class="quadrant__focus-btn"
              data-focus-quadrant={q.id}
              title={t("eisenhower.focus_mode", locale)}
              aria-label={`Focus on ${q.label}`}
            >
              ⛶
            </button>
          </header>

          {/* ── Q1 "Commit to Today" bridge ── */}
          {q.id === "do-first" && q.tasks.length > 0 && (
            <div class="quadrant__action-bar">
              <button
                class="quadrant__action-btn quadrant__action-btn--primary"
                data-action="commit-q1"
                title={t("eisenhower.commit_q1_title", locale)}
              >
                🎯 {t("eisenhower.commit_q1", locale)}
              </button>
            </div>
          )}

          {/* ── Q1 WIP limit warning ── */}
          {q.id === "do-first" && q.tasks.length > Q1_WIP_LIMIT && (
            <div class="quadrant__wip-warning" role="alert">
              ⚠️ {t("eisenhower.wip_warning", locale).replace("{count}", String(q.tasks.length)).replace("{limit}", String(Q1_WIP_LIMIT))}
            </div>
          )}

          {/* ── Q2 "Schedule This Week" action ── */}
          {q.id === "schedule" && q.tasks.length > 0 && (
            <div class="quadrant__action-bar">
              <button
                class="quadrant__action-btn quadrant__action-btn--primary"
                data-action="schedule-q2"
                title={t("eisenhower.schedule_q2_title", locale)}
              >
                📅 {t("eisenhower.schedule_q2", locale)}
              </button>
            </div>
          )}

          {/* ── Q3 quick-assign action ── */}
          {q.id === "delegate" && q.tasks.length > 0 && (
            <div class="quadrant__action-bar">
              <button
                class="quadrant__action-btn quadrant__action-btn--muted"
                data-action="assign-q3"
                title={t("eisenhower.assign_q3_title", locale)}
              >
                👤 {t("eisenhower.assign_q3", locale)}
              </button>
            </div>
          )}

          {/* ── Q4 action row ── */}
          {q.id === "not-now" && q.tasks.length > 0 && (
            <div class="quadrant__action-bar">
              <button
                class="quadrant__action-btn quadrant__action-btn--muted"
                data-action="defer-q4"
                title={t("eisenhower.defer_q4_title", locale)}
              >
                📥 {t("eisenhower.defer_q4", locale)}
              </button>
              <button
                class="quadrant__action-btn quadrant__action-btn--danger"
                data-action="complete-q4"
                title={t("eisenhower.complete_q4_title", locale)}
              >
                ✅ {t("eisenhower.complete_q4", locale)}
              </button>
            </div>
          )}

          <div class="quadrant__tasks" data-drop-zone={q.id} role="list">
            {q.tasks.length === 0 ? (
              <div class="quadrant__empty">
                {t("eisenhower.empty_quadrant", locale)}
              </div>
            ) : (
              q.tasks.map((task, idx) => (
                <div
                  class={`eisenhower__task-wrapper ${q.id === "do-first" && idx === 0 ? "task-wrapper--top-task" : ""}`}
                  data-unclassified={task.urgency === 0 && task.importance === 0 ? "true" : undefined}
                  data-top-task={q.id === "do-first" && idx === 0 ? "true" : undefined}
                >
                  <TaskListItem task={task} compact={true} />
                  <div class="eisenhower__task-meta">
                    {task.eisenhower_override && (
                      <span class="tli__pin" title="Manually placed">📌</span>
                    )}
                    {task.effort_minutes != null && task.effort_minutes > 0 && (
                      <span class={`tli__effort ${effortClass(task.effort_minutes)}`}
                        title={`Estimated effort: ${task.effort_minutes}m`}>
                        {effortEmoji(task.effort_minutes)}
                        <span class="tli__effort-label">{effortLabelText(task.effort_minutes)}</span>
                      </span>
                    )}
                    {task.blocked_by && (
                      <span class="tli__blocked" title={`Blocked: ${task.blocked_by}`}>🚫</span>
                    )}
                    {parseFrameworkPayload(task.framework_payload)?.recurrence_rule && (
                      <span class="tli__recurring" title="Recurring task">🔁</span>
                    )}
                  </div>
                </div>
              ))
            )}
          </div>

          {/* ── Quick-capture input per quadrant ── */}
          <div class="quadrant__quick-capture">
            <input
              type="text"
              class="quick-capture__input"
              data-quadrant-capture={q.id}
              placeholder={t("eisenhower.quick_add_placeholder", locale)}
              autocomplete="off"
            />
          </div>
        </section>
      ))}
    </div>

    <p class="eisenhower__hint">
      {t("eisenhower.drag_hint", locale)}
    </p>
    </section>

    <section id="eisenhower-flow" class="eisenhower__flow-section" data-eisenhower-section>
      <h2 class="eisenhower__flow-heading">Flow</h2>
      <div class="eisenhower__flow-grid">
        <a href="/today" class="eisenhower__flow-card">
          <span class="flow-card__icon">☀️</span>
          <span class="flow-card__label">Today</span>
          <span class="flow-card__desc">Committed daily work surface</span>
        </a>
        <a href="/upcoming" class="eisenhower__flow-card">
          <span class="flow-card__icon">📅</span>
          <span class="flow-card__label">Upcoming</span>
          <span class="flow-card__desc">Next 7 days at a glance</span>
        </a>
        <a href="/kanban" class="eisenhower__flow-card">
          <span class="flow-card__icon">📋</span>
          <span class="flow-card__label">Kanban</span>
          <span class="flow-card__desc">Workflow board by status</span>
        </a>
        <a href="/calendar" class="eisenhower__flow-card">
          <span class="flow-card__icon">🗓️</span>
          <span class="flow-card__label">Calendar</span>
          <span class="flow-card__desc">Monthly timeline view</span>
        </a>
      </div>
    </section>
  </main>

  <script>
    import { initEisenhowerPage } from "@lib/eisenhower-controller"
    document.addEventListener("astro:page-load", () => initEisenhowerPage())
  </script>
</Layout>

<style>
  .eisenhower {
    max-width: 1400px;
    margin: 0 auto;
    padding: 24px 20px;
    min-height: 100vh;
  }

  /* ── Overview section ── */
  .eisenhower__overview-section {
    scroll-margin-top: var(--unified-bar-height, 88px);
    margin-bottom: 16px;
  }
  .eisenhower__overview-row {
    display: flex;
    align-items: center;
    gap: 16px;
    flex-wrap: wrap;
  }
  .eisenhower__subtitle {
    font-size: 0.8125rem;
    color: var(--text-muted);
    margin: 0;
  }

  /* ── Completed today counter ── */
  .eisenhower__completed-today {
    display: flex;
    align-items: center;
    gap: 6px;
    padding: 6px 14px;
    background: rgba(var(--success-rgb, 34, 197, 94), 0.08);
    border: 1px solid rgba(var(--success-rgb, 34, 197, 94), 0.2);
    border-radius: 20px;
    white-space: nowrap;
    flex-shrink: 0;
  }
  .completed-today__icon {
    font-size: 1rem;
  }
  .completed-today__count {
    font-size: 0.875rem;
    font-weight: 800;
    color: var(--success, #22c55e);
  }
  .completed-today__label {
    font-size: 0.6875rem;
    color: var(--text-muted);
  }

  /* ── Top-task spotlight (first task in Q1) ── */
  .task-wrapper--top-task {
    position: relative;
    border: 1px solid rgba(var(--accent-rgb), 0.25);
    border-radius: var(--radius-sm, 6px);
    background: rgba(var(--accent-rgb), 0.04);
    box-shadow: 0 0 12px rgba(var(--accent-rgb), 0.08);
  }
  .task-wrapper--top-task::before {
    content: "👑";
    position: absolute;
    top: -8px;
    left: 8px;
    font-size: 0.75rem;
    z-index: 1;
  }

  /* ── 2×2 Grid ── */
  #eisenhower-matrix {
    scroll-margin-top: var(--unified-bar-height, 88px);
  }
  .eisenhower__grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    grid-template-rows: 1fr 1fr;
