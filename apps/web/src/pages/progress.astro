---
/**
 * /progress — Parent page for Progress & Growth (Routines, Goals, Achievements)
 *
 * Uses ParentPageShell for hash-based routing between sub-views.
 * Each sub-view section uses data-parent-section for controller toggling.
 *
 * @domain navigation
 * @phase 15 — Hierarchy Architecture Overhaul
 */
import Layout from "../layouts/Layout.astro"
import ParentPageShell from "../components/layout/ParentPageShell.astro"
import { t } from "../i18n/translations"
import type { Locale } from "../lib/locale"

const cookieLocale = Astro.cookies.get("meitheal-locale")?.value
const locale: Locale = cookieLocale === "ga" ? "ga" : "en"
---

<Layout title={`Meitheal — ${t("nav.progress", locale)}`}>
  <ParentPageShell pageId="progress">
    <section data-parent-section="routines" id="progress-section-routines">
      <div class="parent-page-placeholder">
        <h2>Routines</h2>
        <p>Daily and weekly routine templates with streak tracking and habit formation</p>
        <a href="/habits" class="placeholder-link">Open legacy Habits →</a>
      </div>
    </section>

    <section data-parent-section="goals" id="progress-section-goals" hidden>
      <div class="parent-page-placeholder">
        <h2>Goals</h2>
        <p>Long-term pillars and objectives — no deadlines, all direction</p>
        <a href="/goals" class="placeholder-link">Open legacy Goals →</a>
      </div>
    </section>

    <section data-parent-section="achievements" id="progress-section-achievements" hidden>
      <div class="parent-page-placeholder">
        <h2>Achievements</h2>
        <p>Streaks, XP, levels, and unlocked milestones — your progress dashboard</p>
        <a href="/gamification" class="placeholder-link">Open legacy Gamification →</a>
      </div>
    </section>
  </ParentPageShell>
</Layout>

<style>
  .parent-page-placeholder {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 0.75rem;
    padding: 4rem 2rem;
    text-align: center;
    color: var(--text-muted);
  }

  .parent-page-placeholder h2 {
    font-size: 1.5rem;
    font-weight: 600;
    color: var(--text-primary);
  }

  .parent-page-placeholder p {
    max-width: 36ch;
    line-height: 1.5;
  }

  .placeholder-link {
    display: inline-flex;
    align-items: center;
    gap: 0.25rem;
    padding: 0.5rem 1rem;
    font-size: 0.875rem;
    font-weight: 500;
    color: var(--accent);
    background: rgba(var(--accent-rgb), 0.08);
    border: 1px solid rgba(var(--accent-rgb), 0.2);
    border-radius: var(--radius-sm, 6px);
    text-decoration: none;
    transition: background 150ms ease, border-color 150ms ease;
  }

  .placeholder-link:hover {
    background: rgba(var(--accent-rgb), 0.15);
    border-color: rgba(var(--accent-rgb), 0.35);
  }
</style>
