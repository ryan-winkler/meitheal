---
/**
 * /progress — Parent page for Progress & Growth (Routines, Goals, Achievements)
 *
 * Uses ParentPageShell for hash-based routing between sub-views.
 * Each sub-view loads live data from repositories and provides
 * deep links to the full-featured legacy views.
 *
 * @domain navigation
 * @phase 15 — Hierarchy Architecture Overhaul
 */
import Layout from "../layouts/Layout.astro"
import ParentPageShell from "../components/layout/ParentPageShell.astro"
import InlineHelper from "../components/ui/InlineHelper.astro"
import { t } from "../i18n/translations"
import type { Locale } from "../lib/locale"
import {
  ensureSchema,
  getPersistenceClient,
} from "@domains/tasks/persistence/store"
import { TemplateRepository } from "@domains/tasks/persistence/template-repository"
import { HierarchyRepository, type GoalRow } from "@domains/tasks/persistence/hierarchy-repository"

const cookieLocale = Astro.cookies.get("meitheal-locale")?.value
const locale: Locale = cookieLocale === "ga" ? "ga" : "en"

let routineCount = 0
let activeStreaks = 0
let goalCount = 0
let completedGoals = 0
let totalPoints = 0

try {
  await ensureSchema()
  const client = getPersistenceClient()
  const templateRepo = new TemplateRepository(client)
  const hierarchyRepo = new HierarchyRepository(client)

  // Routines
  const routines = await templateRepo.getRoutinesWithStats()
  routineCount = routines.length
  activeStreaks = routines.filter(r => r.currentStreak > 0).length

  // Goals
  const goals = await hierarchyRepo.findAllGoals()
  goalCount = (goals as GoalRow[]).length
  completedGoals = (goals as GoalRow[]).filter(g => g.status === "complete").length

  // Gamification
  try {
    const { getStats } = await import("@domains/gamification")
    const stats = await getStats()
    totalPoints = stats.totalPoints ?? 0
  } catch { /* gamification may not be available */ }
} catch { /* DB not available */ }
---

<Layout title={`Meitheal — ${t("nav.progress", locale)}`}>
  <ParentPageShell pageId="progress">
    <section data-parent-section="routines" id="progress-section-routines">
      <InlineHelper helperId="progress-routines-explainer" title="What are Routines?" icon="💡">
        <p><strong>Routines</strong> are recurring templates that automatically create daily or weekly tasks. Complete them to build streaks and earn XP. Unlike one-off tasks, routines repeat on a cadence you set.</p>
        <p>Press <kbd>?</kbd> to restore this helper if dismissed.</p>
      </InlineHelper>
      <div class="parent-section-hub">
        <div class="parent-section-hub__header">
          <span class="parent-section-hub__icon">🔁</span>
          <div>
            <h2 class="parent-section-hub__title">Routines</h2>
            <p class="parent-section-hub__desc">Daily and weekly routine templates with streak tracking and habit formation. Routines create real tasks that feed into your daily workflow.</p>
          </div>
        </div>
        <div class="parent-section-hub__stats">
          <div class="stat-card"><span class="stat-value">{routineCount}</span><span class="stat-label">Active Routines</span></div>
          <div class="stat-card"><span class="stat-value">{activeStreaks}</span><span class="stat-label">Active Streaks</span></div>
        </div>
        <a href="/habits" class="parent-section-hub__action">Open Full Routines →</a>
      </div>
    </section>

    <section data-parent-section="goals" id="progress-section-goals" hidden>
      <InlineHelper helperId="progress-goals-explainer" title="How do Goals work?" icon="🎯" variant="tip">
        <p><strong>Goals</strong> are long-term pillars — they have no deadlines. Link Projects to Goals to track progress toward outcomes. Goals sit at the top of the hierarchy: <strong>Area → Goal → Project → Task</strong>.</p>
      </InlineHelper>
      <div class="parent-section-hub">
        <div class="parent-section-hub__header">
          <span class="parent-section-hub__icon">🎯</span>
          <div>
            <h2 class="parent-section-hub__title">Goals</h2>
            <p class="parent-section-hub__desc">Long-term pillars and objectives — no deadlines, all direction. Link goals to projects and track progress toward outcomes.</p>
          </div>
        </div>
        <div class="parent-section-hub__stats">
          <div class="stat-card"><span class="stat-value">{goalCount}</span><span class="stat-label">Goals</span></div>
          <div class="stat-card"><span class="stat-value">{completedGoals}</span><span class="stat-label">Completed</span></div>
        </div>
        <a href="/goals" class="parent-section-hub__action">Open Full Goals →</a>
      </div>
    </section>

    <section data-parent-section="achievements" id="progress-section-achievements" hidden>
      <InlineHelper helperId="progress-achievements-explainer" title="Achievements & Gamification" icon="🏆" variant="tip">
        <p>Complete tasks to earn <strong>XP</strong>, build <strong>streaks</strong>, and unlock achievements. Higher-priority tasks award more points. Routine streaks also contribute to your progress here.</p>
      </InlineHelper>
      <div class="parent-section-hub">
        <div class="parent-section-hub__header">
          <span class="parent-section-hub__icon">🏆</span>
          <div>
            <h2 class="parent-section-hub__title">Achievements</h2>
            <p class="parent-section-hub__desc">Streaks, XP, levels, and unlocked milestones — your progress dashboard showing real accomplishments.</p>
          </div>
        </div>
        <div class="parent-section-hub__stats">
          <div class="stat-card"><span class="stat-value">{totalPoints}</span><span class="stat-label">Total XP</span></div>
        </div>
        <a href="/gamification" class="parent-section-hub__action">Open Full Achievements →</a>
      </div>
    </section>
  </ParentPageShell>
</Layout>

<style>
  .parent-section-hub {
    max-width: 640px;
    margin: 2rem auto;
    padding: 2rem;
    background: var(--bg-card);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg, 12px);
  }

  .parent-section-hub__header {
    display: flex;
    align-items: flex-start;
    gap: 1rem;
    margin-bottom: 1.5rem;
  }

  .parent-section-hub__icon {
    font-size: 2rem;
    line-height: 1;
    flex-shrink: 0;
  }

  .parent-section-hub__title {
    margin: 0;
    font-size: 1.25rem;
    font-weight: 600;
    color: var(--text-primary);
  }

  .parent-section-hub__desc {
    margin: 0.25rem 0 0;
    font-size: 0.875rem;
    color: var(--text-muted);
    line-height: 1.4;
  }

  .parent-section-hub__stats {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(100px, 1fr));
    gap: 0.75rem;
    margin-bottom: 1.5rem;
  }

  .parent-section-hub__action {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    padding: 0.625rem 1.25rem;
    font-size: 0.875rem;
    font-weight: 600;
    color: white;
    background: var(--accent);
    border-radius: var(--radius-sm, 6px);
    text-decoration: none;
    transition: background 150ms ease, transform 100ms ease;
  }

  .parent-section-hub__action:hover {
    background: color-mix(in srgb, var(--accent) 85%, black);
    transform: translateY(-1px);
  }

  @media (max-width: 640px) {
    .parent-section-hub {
      margin: 1rem;
      padding: 1.25rem;
    }

    .parent-section-hub__stats {
      grid-template-columns: repeat(2, 1fr);
    }
  }
</style>
