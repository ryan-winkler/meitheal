---
import { readBoardPagePlacement } from "@lib/board-page-placement"
import { boardWorkspaceHref } from "@lib/board-workspace"
import { resolveBoardPageScope, boardScopeResponse } from "@lib/board-http"

import { isOrganizationFeatureAvailable as available } from "@lib/organization-request-context"
import { organizationLabelsFor, newOrganizationLabel, organizationLocale } from "@lib/organization-labels"
/**
 * /progress — Parent page for Progress & Growth (Pillars, Routines, Goals, Achievements)
 *
 * Uses ParentPageShell for hash-based routing between sub-views.
 * Each sub-view embeds the full content of its respective domain page
 * directly inline — no summary cards, no indirection.
 *
 * @domain navigation + pillars + routines
 * @phase 15 + 17 + 18 — Hierarchy Architecture + Pillars + Unification
 */
import { HierarchyRepository } from "@domains/tasks/persistence/hierarchy-repository"
import { ensureSchema, getPersistenceClient } from "@domains/tasks/persistence/store"
import { boardScopeStorage } from "@domains/tasks/board-scope"
import BoardsStyles from "../components/boards/BoardsStyles.astro"
import Layout from "../layouts/Layout.astro"
import ParentPageShell from "../components/layout/ParentPageShell.astro"
import GoalsTab from "../components/progress/GoalsTab.astro"
import AchievementsTab from "../components/progress/AchievementsTab.astro"
import RoutinesWorkspace from "../components/routines/RoutinesWorkspace.astro"
import InlineHelper from "../components/ui/InlineHelper.astro"
import Icon from "../components/ui/Icon.astro"
import PillarCard from "../components/pillars/PillarCard.astro"
import PillarFormModal from "../components/pillars/PillarFormModal.astro"
import PillarDetailModal from "../components/pillars/PillarDetailModal.astro"
import { t } from "../i18n/translations"
import type { Locale } from "../lib/locale"
import { isFeatureEnabled } from "../lib/feature-flags"
import { issuePersonalPillarForm, resolvePersonalPillarOwner } from "../lib/personal-pillar-access"
import { personalPillarOwnerId, getPillars } from "@domains/pillars"
import { getAllPrinciples } from "@domains/pillars"
import { getAssociationsForPillar } from "@domains/pillars"
const workScopeResult = await resolveBoardPageScope(Astro, { boardId: Astro.props.boardId })
if (!workScopeResult.ok) return boardScopeResponse(workScopeResult.errorCode)
const workScope = workScopeResult.scope


const boardId = workScope.boardId
const { rows: [boardRecord] } = await getPersistenceClient().execute({ sql: "SELECT name FROM task_boards WHERE id = ?", args: [boardId] })
const boardName = String(boardRecord?.name ?? "Board")
const pagePlacement = await readBoardPagePlacement(workScope, Astro.url)
if (!pagePlacement.ok) return boardScopeResponse(pagePlacement.errorCode)
const boardArea = pagePlacement.area
const boardProject = pagePlacement.project
const openNewRoutine = Astro.url.searchParams.get("new") === "1"
const label = await organizationLabelsFor(Astro)
const newLabel = (name: Parameters<typeof label>[0], fallback?: string) => newOrganizationLabel(label(name, false, fallback), organizationLocale(Astro))
const cookieLocale = Astro.cookies.get("meitheal-locale")?.value
const locale: Locale = cookieLocale === "ga" ? "ga" : "en"

// ─── Pillar data ────────────────────────────────────────────────
let enrichedPillars: Array<{
  id: string
  slug: string
  name: string
  manifesto: string | null
  icon: string
  colorHex: string
  weight: number
  principles: Array<{ id: string; pillarId: string; statement: string; isNonNegotiable: boolean; position: number; createdAt: number }>
  linkedGoalCount: number
  linkedGoals: Array<{ id: string; title: string; status: string }>
  personal: boolean
}> = []

// Progress can show personal work outside the explicitly selected Board views.
const personalProgress = boardScopeStorage(workScope) === "legacy_null_v1" &&
  !Astro.props.boardId && !Astro.request.headers.has("x-meitheal-board-id") &&
  !Astro.url.searchParams.has("board") && !Astro.url.searchParams.has("board_id") &&
  !boardArea && !boardProject
const personalOwner = personalProgress ? await resolvePersonalPillarOwner(Astro) : undefined
const personalForm = personalOwner ? issuePersonalPillarForm(personalOwner) : undefined

try {
  await ensureSchema()
  const hierarchy = new HierarchyRepository(getPersistenceClient(), workScope)
  const boardGoals = available("goals") ? await hierarchy.findAllGoals().catch(() => []) : []
  const goalsById = new Map(boardGoals.map(g => [String(g.id), { id: String(g.id), title: String(g.title), status: String(g.status || "active") }]))
  const pillarsData = available("pillars") ? [...await getPillars(workScope, { includeInactive: false }), ...(personalOwner ? await getPillars(personalOwner, { includeInactive: false }) : [])] : []
  const allPrinciplesMap = available("principles") ? new Map([...await getAllPrinciples(workScope), ...(personalOwner ? await getAllPrinciples(personalOwner) : [])]) : new Map()
  enrichedPillars = await Promise.all(
    pillarsData.map(async (p) => {
      const personal = Boolean(personalOwner && p.userId === personalPillarOwnerId(personalOwner))
      const associations = await getAssociationsForPillar(personal && personalOwner ? personalOwner : workScope, p.id, workScope)
      const goalAssociations = associations.filter((a: { entityType: string }) => a.entityType === "goal")
      const linkedGoals = goalAssociations
        .map((a: { entityId: string }) => goalsById.get(a.entityId))
        .filter((g): g is { id: string; title: string; status: string } => Boolean(g))
      return {
        ...p,
        slug: p.slug || p.id,
        personal,
        principles: allPrinciplesMap.get(p.id) || [],
        linkedGoalCount: goalAssociations.length,
        linkedGoals,
      }
    })
  )
} catch { /* pillars may not be available yet */ }

const routinesEnabled = await isFeatureEnabled("habits")
const showBoardBackLink = !personalProgress && Boolean(boardId)
const boardHref = boardWorkspaceHref(boardId, {
  area: boardProject ? undefined : boardArea?.id,
  project: boardProject?.id,
  fromArea: boardProject ? Astro.url.searchParams.get("from") ?? undefined : undefined,
}, "kanban")
---

<Layout title={`Meitheal — ${label("progress", false, t("nav.progress", locale))}`} hideSearchHub={true} hideGlobalSearch={true}
  workNavigation={{ scope: workScope, placement: pagePlacement }}>
  <BoardsStyles />
  {/* Suppress TopNavigation — ParentPageShell provides its own UnifiedBar */}
  <Fragment slot="custom-header" />
  <ParentPageShell pageId="progress">
    {showBoardBackLink && (
      <div class="progress-board-context">
        <a href={boardHref} class="progress-board-context__link">
          <Icon name="layout-kanban" size={14} sprite />
          <span>Back to {boardName}</span>
          {boardArea && <span class="progress-board-context__sep">/ {boardArea.name}</span>}
          {boardProject && <span class="progress-board-context__sep">/ {boardProject.name}</span>}
        </a>
      </div>
    )}

    {/* ─── Pillars (full inline content) ─── */}
    {available("pillars") && <section data-parent-section="pillars" id="progress-section-pillars">
      <div class="progress-inline-page" id="pillars-inline">
        <div class="progress-inline-page__header">
          {personalOwner && <a class="btn btn-ghost" href="/boards">{label("board")} {label("pillar", true)}</a>}
          <button
            type="button"
            class="pillars-page__add-btn"
            id="pillar-add-btn"
            aria-label={newLabel("pillar")}
          >
            <Icon name="plus" size={16} sprite />
            {newLabel("pillar")}
          </button>
        </div>

        <InlineHelper helperId="pillars-explainer" title="What are Pillars?" icon="🏛️">
          <p><strong>Pillars</strong> are permanent, identity-based motivational anchors. They answer the question <em>"Who am I, and what do I stand for?"</em></p>
          <p>Each Pillar can have <strong>Principles</strong> — behavioral boundaries you won't compromise on. <strong>Non-Negotiable</strong> principles from Board Pillars can guide AI recommendations.</p>
          <p>Research suggests 3-5 active Pillars is optimal for focus. Press <kbd>?</kbd> to restore this helper if dismissed.</p>
        </InlineHelper>

        {enrichedPillars.length === 0 ? (
          <div class="pillars-page__empty">
            <div class="pillars-page__empty-icon" aria-hidden="true">
              <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M3 21l18 0"/><path d="M5 21v-14l8 -4v18"/><path d="M19 21v-10l-6 -4"/><path d="M9 9l0 .01"/><path d="M9 12l0 .01"/><path d="M9 15l0 .01"/><path d="M9 18l0 .01"/></svg>
            </div>
            <h2 class="pillars-page__empty-title">No Pillars yet</h2>
            <p class="pillars-page__empty-desc">
              Start by defining the 3-5 core pillars that anchor your identity.
              Think big, permanent categories: <em>Physical Longevity</em>, <em>Financial Independence</em>, <em>Unbreakable Family</em>.
            </p>
            <button
              type="button"
              class="pillars-page__empty-action"
              id="pillar-add-btn-empty"
              aria-label="Create your first Pillar"
            >
              Create Your First Pillar
            </button>
          </div>
        ) : (
          <div class="pillars-page__grid">
            {enrichedPillars.map((pillar) => (
              <PillarCard
            id={pillar.id}
            slug={pillar.slug}
            name={pillar.name}
            manifesto={pillar.manifesto}
            icon={pillar.icon}
            colorHex={pillar.colorHex}
            weight={pillar.weight}
            principles={pillar.principles}
            linkedGoalCount={pillar.linkedGoalCount}
            linkedGoals={pillar.linkedGoals}
            personal={pillar.personal}
          />
            ))}
          </div>
        )}
      </div>
      <PillarFormModal {personalForm} />
      <PillarDetailModal />
    </section>}

    {/* ─── Routines (full inline Tabler workspace) ─── */}
    {available("routines") && <section data-parent-section="routines" id="progress-section-routines" hidden>
      <div class="progress-inline-page">
        {routinesEnabled ? (
          <RoutinesWorkspace
            {workScope}
            {locale}
            area={boardArea}
            project={boardProject}
            embedded={true}
            openNew={openNewRoutine}
          />
        ) : (
          <div class="card card-body">
            <h2 class="card-title mb-2">{label("routine", true)}</h2>
            <p class="text-text-secondary mb-3">Routines are currently disabled in your settings.</p>
            <div>
              <a class="btn btn-primary btn-sm" href="/settings#tasks-boards-settings">Enable Routines in Settings</a>
            </div>
          </div>
        )}
      </div>
    </section>}

    {/* ─── Goals (inline content — Phase 18) ─── */}
    {available("goals") && <section data-parent-section="goals" id="progress-section-goals" hidden>
      <GoalsTab />
    </section>}

    {/* ─── Achievements (inline content — Phase 18) ─── */}
    {available("achievements") && <section data-parent-section="achievements" id="progress-section-achievements" hidden>
      <InlineHelper helperId="progress-achievements-explainer" title="Achievements & Gamification" icon="🏆" variant="tip">
        <p>Complete tasks to earn <strong>XP</strong>, build <strong>streaks</strong>, and unlock achievements. Higher-priority tasks award more points. Routine streaks also contribute to your progress here.</p>
      </InlineHelper>
      <AchievementsTab />
    </section>}
  </ParentPageShell>
</Layout>

<script>
  import "@lib/pillar-card-controller"
  import "@lib/pillar-detail-controller"
  import { pageLifecycle } from "@lib/page-lifecycle"

  pageLifecycle.onPageLoad((signal) => {
    const focusAchievementsFromHash = () => {
      const hash = window.location.hash
      if (!/^#achievements(?:-|$)/.test(hash)) return
      const section = document.getElementById("progress-section-achievements")
      if (!section) return

      // Ensure Achievements section is visible even before/alongside ParentPageShell sync
      if (section.hasAttribute("hidden")) {
        const achievementsTab = document.querySelector<HTMLElement>('[data-unified-bar-section="achievements"]')
        achievementsTab?.click()
        section.hidden = false
        section.classList.add("is-active")
      }

      const targetId = hash.slice(1)
      const targetEl = targetId !== "achievements"
        ? (document.getElementById(targetId) ?? section)
        : section

      const prefersReducedMotion = window.matchMedia?.("(prefers-reduced-motion: reduce)").matches
      requestAnimationFrame(() => {
        targetEl.scrollIntoView({
          behavior: prefersReducedMotion ? "auto" : "smooth",
          block: targetEl === section ? "start" : "center",
        })
        targetEl.classList.add("is-hash-highlighted")
        const timer = window.setTimeout(() => {
          targetEl.classList.remove("is-hash-highlighted")
        }, 2200)
        signal.addEventListener("abort", () => window.clearTimeout(timer), { once: true })
      })
    }

    focusAchievementsFromHash()
    window.addEventListener("hashchange", focusAchievementsFromHash, { signal })
  })
</script>

<style is:inline>
  /* ─── Subtle board context link (replaces duplicate nav bar) ─── */
  .progress-board-context {
    max-width: 1100px;
    margin: 0 auto 0.25rem;
  }

  :root[data-appearance-width="fluid"] .progress-board-context,
  :root[data-appearance-width="fluid"] .progress-inline-page {
    max-width: none;
  }

  .progress-board-context__link {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    font-size: 0.8125rem;
    font-weight: 500;
    color: var(--text-secondary);
    text-decoration: none;
    padding: 0.25rem 0.5rem;
    margin-left: -0.5rem;
    border-radius: var(--radius-sm, 6px);
    transition: color 140ms cubic-bezier(0.23, 1, 0.32, 1), background-color 140ms cubic-bezier(0.23, 1, 0.32, 1);
  }

  .progress-board-context__link:hover {
    color: var(--text-primary);
    background: var(--bg-hover);
  }

  .progress-board-context__sep {
    color: var(--text-muted);
    font-weight: 400;
  }

  /* ─── Inline page wrapper ─── */
  .progress-inline-page {
    max-width: 1100px;
    margin: 0 auto;
    padding: 0.5rem 0;
  }

  .progress-inline-page__header {
    display: flex;
    justify-content: flex-end;
    margin-bottom: 1rem;
  }

  /* ─── Pillars inline ─── */
  .pillars-page__add-btn,
  .pillars-page__empty-action {
    background: var(--personal-accent, var(--palette-accent-hover));
    color: var(--personal-accent-foreground, var(--palette-on-accent, #07140f));
    border: none;
    border-radius: var(--radius-sm);
    font-weight: 600;
    cursor: pointer;
    transition: background 150ms ease, transform 150ms ease;
  }

  .pillars-page__add-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    padding: 0.5rem 1rem;
    font-size: 0.875rem;
    white-space: nowrap;
  }

  .pillars-page__add-btn:hover,
  .pillars-page__empty-action:hover {
    background: color-mix(in srgb, var(--accent-hover) 95%, black);
    color: var(--personal-accent-hover-foreground, var(--palette-on-accent, #07140f));
    transform: translateY(-1px);
  }

  .pillars-page__grid {
    columns: 1;
    gap: 1rem;
  }

  @media (min-width: 640px) {
    .pillars-page__grid { columns: 2; }
  }

  @media (min-width: 960px) {
    .pillars-page__grid { columns: 3; }
  }

  .pillars-page__empty {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
    padding: 4rem 2rem;
    border: 2px dashed var(--border);
    border-radius: var(--radius-lg, 12px);
    margin-top: 1rem;
  }

  .pillars-page__empty-icon {
    font-size: 3rem;
    margin-bottom: 1rem;
    opacity: 0.6;
  }

  .pillars-page__empty-title {
    margin: 0 0 0.5rem;
    font-size: 1.25rem;
    font-weight: 600;
    color: var(--text-primary);
  }

  .pillars-page__empty-desc {
    margin: 0 0 1.5rem;
    font-size: 0.9375rem;
    color: var(--text-muted);
    max-width: 400px;
    line-height: 1.5;
  }

  .pillars-page__empty-action {
    padding: 0.625rem 1.5rem;
    font-size: 0.9375rem;
  }

  #progress-section-achievements {
    scroll-margin-top: calc(var(--unified-bar-height, 56px) + 16px);
    border-radius: 16px;
    transition: box-shadow 300ms ease;
  }

  #progress-section-achievements.is-hash-highlighted {
    box-shadow: 0 0 0 2px color-mix(in srgb, var(--accent) 55%, transparent);
  }
</style>
