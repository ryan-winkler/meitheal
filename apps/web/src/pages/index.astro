---
import { scopePermits } from "@domains/tasks/board-scope"
import { projectPublicTaskFields } from "@domains/tasks/task-projection"
import { boardContextHref } from "@lib/board-workspace"
import { readBoardPagePlacement } from "@lib/board-page-placement"
import { resolveBoardPageScope, boardScopeResponse } from "@lib/board-http"

import DashboardLayoutEditor from "../components/dashboard/DashboardLayoutEditor.astro"
import DashboardWidget from "../components/dashboard/DashboardWidget.astro"
import GamificationWidget from "../components/gamification/GamificationWidget.astro"
import StreakBadge from "../components/gamification/StreakBadge.astro"
import UnifiedBar from "../components/layout/UnifiedBar.astro"
import EmptyState from "../components/ui/EmptyState.astro"
import Icon from "../components/ui/Icon.astro"
import InlineHelper from "../components/ui/InlineHelper.astro"
import TaskTypeIcon from "../components/ui/TaskTypeIcon.astro"
import KanbanTaskCard from "../components/tasks/KanbanTaskCard.astro"
import QuickAddHelpPopover from "../components/tasks/QuickAddHelpPopover.astro"
import Layout from "../layouts/Layout.astro"
import {
  getStats as getGamificationStats,
  getWeeklyData as getGamificationWeekly,
  getAllAchievements,
  getLevel,
  getProgressToNextLevel,
} from "@domains/gamification"
import { TaskRepository } from "@domains/tasks/persistence/task-repository"
import {
  ensureSchema,
  getPersistenceClient,
} from "@domains/tasks/persistence/store"
import { t } from "../i18n/translations"
import type { Locale } from "../lib/locale"
import { PRIORITY_CSS_CLASSES as priorityClasses, getPriorityColor } from "../lib/priority-config"
import { taskSurface } from "../lib/task-surface"
import { taskDescriptionPreview } from "../lib/task-description-preview"
import { frameworkPayloadObject, readRiceInputs, riceLensScore } from "../lib/rice-lens"
import { STATUS_LABELS as statusLabels } from "../lib/status-config"
import { DASHBOARD_SECTIONS } from "../lib/dashboard-registry"
import { calendarDaysFromToday, calendarToday, isDueOverdue as isDueTimeOverdue } from "../lib/date"
import dashboardStyles from "../styles/dashboard.css?url"
const workScopeResult = await resolveBoardPageScope(Astro, { boardId: Astro.props.boardId })
if (!workScopeResult.ok) return boardScopeResponse(workScopeResult.errorCode)
const workScope = workScopeResult.scope
const canEdit = scopePermits(workScope, { resource: "task", action: "edit" })
const canCreate = scopePermits(workScope, { resource: "task", action: "create" })
const pagePlacement = await readBoardPagePlacement(workScope, Astro.url)
if (!pagePlacement.ok) return boardScopeResponse(pagePlacement.errorCode)
const placement = pagePlacement.placement
const contextHref = (path: string) => boardContextHref({ boardId: workScope.boardId, area: pagePlacement.area?.id, project: pagePlacement.project?.id }, path)

const dashboardDateFormat = Astro.locals.dateFormat || "YYYY-MM-DD"
const dashboardTimeZone = Astro.locals.timezone || "Europe/Dublin"

const cookieLocale = Astro.cookies.get("meitheal-locale")?.value
const locale: Locale = cookieLocale === "ga" ? "ga" : "en"

const priorityLabels: Record<number, string> = {
  1: t("priority.critical", locale),
  2: t("priority.high", locale),
  3: t("priority.medium", locale),
  4: t("priority.low", locale),
  5: t("priority.minimal", locale),
}
const typeColors: Record<string, string> = {
  epic: "#8b5cf6",
  story: "#22c55e",
  task: "#3b82f6",
  bug: "#ef4444",
}

let tasks: Record<string, unknown>[] = []
let favorites: Record<string, unknown>[] = []
let openTasks: Record<string, unknown>[] = []
let recentLoaded = false
let favoritesLoaded = false
let openLoaded = false
let stats = { total: 0, open: 0, active: 0, completed: 0, overdue: 0 }
let statsLoaded = false
let overdueCount: number | null = null
let gamificationStats = {
  currentStreak: 0,
  todayCompleted: 0,
  totalCompleted: 0,
  longestStreak: 0,
  totalPoints: 0,
}
let gamificationWeekly: Array<{
  date: string
  completedCount: number
  streakCount: number
  points: number
}> = []
let gamificationLoaded = false
let achievementData: {
  achievements: Array<{
    id: string
    name: string
    description: string
    icon: string
    category: string
    unlockedAt: string | null
  }>
  total: number
  unlocked: number
} = { achievements: [], total: 0, unlocked: 0 }
let areaMap: Record<string, { id: string; name: string; color: string }> = {}

try {
  await ensureSchema()
  const repo = new TaskRepository(getPersistenceClient(), workScope)
  const [recentRead, favoritesRead, openRead, statsRead, overdueRead, areaRead] = await Promise.allSettled([
    repo.getRecentTasks(10, placement),
    repo.getPromotedTasks(5, placement),
    repo.getOpenTasks(15, placement),
    repo.getStatusCounts(placement),
    repo.getOverdueCount(calendarToday(dashboardTimeZone), dashboardTimeZone, placement),
    repo.getAreas(),
  ])
  if (recentRead.status === "fulfilled") {
    tasks = recentRead.value.map(projectPublicTaskFields)
    recentLoaded = true
  }
  if (favoritesRead.status === "fulfilled") {
    favorites = favoritesRead.value.map(projectPublicTaskFields)
    favoritesLoaded = true
  }
  if (openRead.status === "fulfilled") {
    openTasks = openRead.value.map(projectPublicTaskFields)
    openLoaded = true
  }
  if (statsRead.status === "fulfilled") {
    stats = statsRead.value
    statsLoaded = true
  }
  if (overdueRead.status === "fulfilled") overdueCount = overdueRead.value
  if (areaRead.status === "fulfilled") {
    areaMap = Object.fromEntries(
      Object.entries(areaRead.value)
        .filter(([key, value]) => key && key !== "default" && value?.name)
        .map(([key, value]) => [
          key,
          { id: key, name: value.name, color: value.color },
        ]),
    )
  }
} catch {
  // Keep any data already loaded and show recovery text for failed reads.
}

try {
  gamificationStats = await getGamificationStats(workScope)
  gamificationWeekly = await getGamificationWeekly(workScope)
  achievementData = await getAllAchievements(workScope)
  gamificationLoaded = true
} catch {
  // Gamification is optional - keep the dashboard available without it.
}

const gamLevel = getLevel(gamificationStats.totalPoints)
const gamProgress = getProgressToNextLevel(gamificationStats.totalPoints)

function relativeTime(dueDate: string): string {
  const calendarDays = calendarDaysFromToday(dueDate, dashboardTimeZone)
  if (calendarDays !== null) {
    if (calendarDays === 0) return "Due today"
    if (calendarDays === 1) return "Due tomorrow"
    if (calendarDays < 0) return `Overdue by ${-calendarDays} day${calendarDays === -1 ? "" : "s"}`
    return `Due in ${calendarDays} days`
  }
  const due = new Date(dueDate)
  const now = new Date()
  const diffMs = due.getTime() - now.getTime()
  const absDiffMs = Math.abs(diffMs)
  const hours = Math.round(absDiffMs / (1000 * 60 * 60))
  const days = Math.round(absDiffMs / (1000 * 60 * 60 * 24))
  const prefix = diffMs < 0 ? "Overdue by" : "Due in"

  if (hours < 1) return diffMs < 0 ? "Overdue" : "Due soon"
  if (hours < 24) return `${prefix} ${hours} hour${hours !== 1 ? "s" : ""}`
  return `${prefix} ${days} day${days !== 1 ? "s" : ""}`
}

---

<Layout title={`Meitheal — ${t("nav.dashboard", locale)}`}>
  <Fragment slot="head"><link rel="stylesheet" href={dashboardStyles} /></Fragment>
  <UnifiedBar
    title={t("nav.dashboard", locale)}
    titleIcon="dashboard"
    tabs={DASHBOARD_SECTIONS.map((section) => ({
      id: section.id,
      label: section.label,
      icon: section.icon,
    }))}
    searchPlaceholder="Search Meitheal…"
    searchScope="all"
    barId="dashboard-bar"
    slot="custom-header"
  >
    <button slot="actions" type="button" class="btn btn-ghost dashboard-edit-button"
      data-dashboard-edit aria-label="Customize dashboard" title="Customize dashboard" hidden>
      <Icon name="adjustments-horizontal" size={20} sprite />
    </button>
  </UnifiedBar>

  <div class="dashboard-layout">
  <h1 class="sr-only" id="dashboard-accessible-title" hidden>{t("nav.dashboard", locale)}</h1>
  <div id="dashboard-shell" class="dashboard-shell">
    <DashboardWidget id="dashboard-overview">
      <h1 class="m-0 text-2xl font-semibold tracking-tight">{t("nav.dashboard", locale)}</h1>
      <InlineHelper helperId="meitheal-function-tour" title="New to Meitheal? Take the quick workspace tour" icon="sparkles" variant="info">
        <div class="tour-prompt-body">
          <p>Walk through quick capture, <strong>Boards &amp; custom ticket keys</strong>, universal search, and workspace views in under a minute. Press <kbd>?</kbd> anytime to restore this tour prompt if dismissed.</p>
          <div class="tour-prompt-actions">
            <button type="button" class="btn btn-primary btn-sm" data-tour-start>
              <Icon name="rocket" size={14} sprite />
              <span>Start interactive tour</span>
            </button>
          </div>
        </div>
      </InlineHelper>
      {!statsLoaded && <p role="status" class="m-0 text-text-secondary">Task counts couldn’t load. Refresh the page to try again.</p>}
      {statsLoaded && overdueCount === null && <p role="status" class="m-0 text-text-secondary">Overdue count couldn’t load. Refresh the page to try again.</p>}
      {(statsLoaded || overdueCount !== null || gamificationStats.currentStreak > 0) && <div class="stats-grid">
        {gamificationStats.currentStreak > 0 && (
          <a
            href={contextHref("/progress#achievements-streaks")}
            class="stat-card stat-card-link"
            title={`Current streak: ${gamificationStats.currentStreak} day${gamificationStats.currentStreak === 1 ? "" : "s"} — view Streaks & Progress`}
            aria-label={`Current streak: ${gamificationStats.currentStreak} day${gamificationStats.currentStreak === 1 ? "" : "s"} — view Streaks & Progress`}
          >
            <StreakBadge streak={gamificationStats.currentStreak} interactive={false} />
            <div>
              <span class="stat-value">{gamificationStats.todayCompleted}</span>
              <span class="stat-label">today</span>
            </div>
          </a>
        )}

        {statsLoaded && <>
          <a
            href={contextHref("/tasks")}
            class="stat-card stat-card-link"
            title="Open tasks - not yet completed"
          >
            <span class="stat-icon" aria-hidden="true">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><path d="M9 5h-2a2 2 0 0 0 -2 2v12a2 2 0 0 0 2 2h10a2 2 0 0 0 2 -2v-12a2 2 0 0 0 -2 -2h-2"/><path d="M9 3m0 2a2 2 0 0 1 2 -2h2a2 2 0 0 1 2 2v0a2 2 0 0 1 -2 2h-2a2 2 0 0 1 -2 -2z"/><path d="M9 12h6"/><path d="M9 16h6"/></svg>
            </span>
            <div>
              <div class="stat-value" id="dashboard-stat-open-count">{stats.open}</div>
              <div class="stat-label">Open</div>
            </div>
          </a>

          <a
            href={contextHref("/tasks?status=active")}
            class="stat-card stat-card-link"
            id="stat-active"
            title="Tasks currently in progress or active"
          >
            <span class="stat-icon" aria-hidden="true">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><path d="M13 3l0 7l6 0l-8 11l0 -7l-6 0l8 -11"/></svg>
            </span>
            <div>
              <div class="stat-value">{stats.active}</div>
              <div class="stat-label">{t("dashboard.active", locale)}</div>
            </div>
          </a>

          <a
            href={contextHref("/tasks?status=complete")}
            class="stat-card stat-card-link"
            title="Tasks marked as done"
          >
            <span class="stat-icon" aria-hidden="true">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><path d="M9 12l2 2l4 -4"/><path d="M12 3a9 9 0 1 0 9 9a9 9 0 0 0 -9 -9"/></svg>
            </span>
            <div>
              <div class="stat-value">{stats.completed}</div>
              <div class="stat-label">{t("dashboard.completed", locale)}</div>
            </div>
          </a>
        </>}
        {overdueCount !== null && (
          <a
            href={contextHref("/tasks?status=overdue")}
            id="stat-overdue"
            class={`stat-card stat-card-link ${overdueCount > 0 ? "stat-card-danger" : ""}`}
            title="Tasks past their due date across all areas"
          >
            <span class="stat-icon" aria-hidden="true">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><path d="M12 13m-7 0a7 7 0 1 0 14 0a7 7 0 1 0 -14 0"/><path d="M12 10l0 3l2 0"/><path d="M7 4l-2.75 2"/><path d="M17 4l2.75 2"/></svg>
            </span>
            <div>
              <div
                class="stat-value"
                style={overdueCount > 0 ? "color: var(--danger)" : undefined}
              >
                {overdueCount}
              </div>
              <div class="stat-label">{t("dashboard.overdue", locale)}</div>
            </div>
          </a>
        )}
      </div>}
    </DashboardWidget>

    <DashboardWidget id="dashboard-momentum">
      <h2 class="dashboard-section__title">Momentum</h2>

      <div class="dashboard-shell__stack">
        {gamificationLoaded ? <div class="card dashboard-card dashboard-card--flush">
          <GamificationWidget
            achievementsHref={contextHref("/progress#achievements")}
            stats={gamificationStats}
            weekly={gamificationWeekly}
            level={gamLevel}
            progressToNext={gamProgress}
            achievements={achievementData.achievements}
            timezone={dashboardTimeZone}
          />
        </div> : <p class="text-text-secondary" role="status">Achievements couldn’t load. Refresh the page to try again.</p>}

            <div class="card dashboard-card" id="dashboard-favorites" data-available={String(favoritesLoaded)} hidden={favorites.length === 0}>
              <div class="card-header">
                <div>
                  <div class="card-title">{t("kanban.promoted", locale)}</div>
                  <div class="card-subtitle">
                    {favorites.length !== 1
                      ? t("dashboard.promoted_tasks_plural", locale, {
                          count: String(favorites.length),
                        })
                      : t("dashboard.promoted_tasks", locale, {
                          count: String(favorites.length),
                        })}
                  </div>
                </div>
              </div>

              <div class="task-list">
                {favorites.map((favorite) => {
                  const priority = Number(favorite.priority ?? 3)
                  const priorityColor = getPriorityColor(priority)
                  const ticketNumber = typeof favorite.ticket_key === "string" && favorite.ticket_key
                    ? favorite.ticket_key
                    : typeof favorite.ticket_ref === "string" && favorite.ticket_ref
                      ? favorite.ticket_ref
                      : favorite.ticket_number
                        ? `MTH-${String(favorite.ticket_number).padStart(3, "0")}`
                        : null
                  const statusLabel =
                    statusLabels[String(favorite.status)] ?? String(favorite.status)

                  const isDueOverdue = favorite.due_date ? relativeTime(String(favorite.due_date)).startsWith("Overdue") : false
                  return (
                    <div class="task-item cursor-pointer" data-id={String(favorite.id)} data-promoted="true" {...taskSurface(String(favorite.status), favorite.color)}>
                      <div class="task-title">
                        <span
                          class="priority-dot"
                          style={`background: ${priorityColor}`}
                        />
                        {ticketNumber && (
                          <span class="dashboard-ticket-key">{ticketNumber}</span>
                        )}
                        <TaskTypeIcon
                          type={String(favorite.task_type ?? "task")}
                          kind={typeof favorite.task_kind === "string" ? favorite.task_kind : null}
                          size={14}
                        />
                        <span class="truncate">{String(favorite.title)}</span>
                      </div>
                      <div class="dashboard-task-meta">
                        <span class="task-promoted-pill" title={t("kanban.promoted", locale)}>
                          <Icon name="star" size={11} sprite />
                          <span>{t("kanban.promoted", locale)}</span>
                        </span>
                        <span class={`task-badge badge-${String(favorite.status)}`}>
                          {statusLabel}
                        </span>
                        {favorite.due_date && (
                          <span class={`dashboard-task-due text-xs ${isDueOverdue ? "text-danger font-medium" : "text-text-muted"}`}>
                            {relativeTime(String(favorite.due_date))}
                          </span>
                        )}
                      </div>
                    </div>
                  )
                })}
              </div>
            </div>
      </div>
    </DashboardWidget>

    <DashboardWidget id="dashboard-capture">
      <div class="card dashboard-card dashboard-card--capture">
        <div class="card-header dashboard-card__header">
          <div>
            <h2 class="card-title">{t("dashboard.quick_add", locale)}</h2>
            <div class="card-subtitle">{t("dashboard.quick_add_subtitle", locale)}</div>
          </div>
        </div>

        <form id="quick-add-form" class="dashboard-quick-add-form">
          <input
            type="text"
            class="form-input dashboard-quick-add-input"
            id="quick-title"
            aria-label={t("dashboard.quick_add", locale)}
            placeholder={t("dashboard.quick_add_placeholder", locale)}
            autocomplete="off"
            required
            minlength="2"
            maxlength="200"
          />
          <QuickAddHelpPopover targetInputId="quick-title" align="right" />
          <button type="submit" class="btn btn-primary">
            {t("dashboard.add", locale)}
          </button>
        </form>
      </div>
    </DashboardWidget>

    <DashboardWidget id="dashboard-open">
      <div class="card dashboard-card" id="my-open-tasks-card">
        <div class="card-header">
          <div>
            <h2 class="card-title" id="open-tasks-title">Focus Queue</h2>
            <div class="card-subtitle" id="my-open-count" hidden={!openLoaded}>
              {openLoaded && `${openTasks.length} open task${openTasks.length !== 1 ? "s" : ""}`}
            </div>
          </div>

          <div class="dashboard-card__actions">
            <select
              class="form-select"
              id="my-open-user-filter"
              aria-label="Filter open work by assignee"
              style="font-size: 12px; padding: 4px 8px; min-width: 120px;"
            >
              <option value="all">All users</option>
            </select>
            <a href={contextHref("/tasks")} class="btn btn-ghost inline-flex items-center gap-1.5" id="kanban-link" style="font-size: 12px;">
              <Icon name="layout-kanban" size={14} sprite />
              <span>Kanban</span>
            </a>
          </div>
        </div>

        <div class="task-list" id="my-open-list" data-available={String(openLoaded)}>
          {
            openTasks.map((task) => {
              const priority = Number(task.priority ?? 3)
              const priorityColor = getPriorityColor(priority)
              const ticketNumber = typeof task.ticket_key === "string" && task.ticket_key
                ? task.ticket_key
                : typeof task.ticket_ref === "string" && task.ticket_ref
                  ? task.ticket_ref
                  : task.ticket_number
                    ? `MTH-${String(task.ticket_number).padStart(3, "0")}`
                    : null
              const statusLabel =
                statusLabels[String(task.status)] ?? String(task.status)

              const isPromoted = Boolean(task.is_promoted)
              const isDueOverdue = task.due_date ? relativeTime(String(task.due_date)).startsWith("Overdue") : false
              return (
                <div
                  class="task-item cursor-pointer"
                  {...taskSurface(String(task.status), task.color)}
                  data-id={String(task.id)}
                  data-assigned={String(task.assigned_to ?? "")}
                  data-status={String(task.status)}
                  data-promoted={isPromoted ? "true" : "false"}
                >
                  <div class="task-title">
                    <span class="priority-dot" style={`background: ${priorityColor}`} />
                    {ticketNumber && (
                      <span class="dashboard-ticket-key">{ticketNumber}</span>
                    )}
                    <TaskTypeIcon
                      type={String(task.task_type ?? "task")}
                      kind={typeof task.task_kind === "string" ? task.task_kind : null}
                      size={14}
                    />
                    <span class="truncate">{String(task.title)}</span>
                  </div>
                  <div class="dashboard-task-meta">
                    {isPromoted && (
                      <span class="task-promoted-pill" title={t("kanban.promoted", locale)}>
                        <Icon name="star" size={11} sprite />
                        <span>{t("kanban.promoted", locale)}</span>
                      </span>
                    )}
                    <span class={`task-badge badge-${String(task.status)}`}>
                      {statusLabel}
                    </span>
                    {task.due_date && (
                      <span class={`dashboard-task-due text-xs ${isDueOverdue ? "text-danger font-medium" : "text-text-muted"}`}>
                        {relativeTime(String(task.due_date))}
                      </span>
                    )}
                  </div>
                </div>
              )
            })
          }
        </div>
        <div class="dashboard-empty-note" id="my-open-empty" role="status" hidden={openLoaded && openTasks.length > 0}>
          {openLoaded ? "No open tasks for this selection." : "Couldn’t refresh open work. Reload to try again."}
        </div>
      </div>
    </DashboardWidget>

    <DashboardWidget id="dashboard-recent">
      <div class="card dashboard-card">
        <div class="card-header">
          <div>
            <h2 class="card-title">{t("dashboard.recent_tasks", locale)}</h2>
            {statsLoaded && <div class="card-subtitle">
              {recentLoaded ? t("dashboard.tasks_of_total", locale, {
                count: String(tasks.length),
                total: String(stats.total),
              }) : `${t("dashboard.total_tasks", locale)} ${stats.total}`}
            </div>}
          </div>
          <a href={contextHref("/tasks")} class="btn btn-ghost">{t("dashboard.view_all", locale)}</a>
        </div>

        <div class="bento-grid" id="task-list" data-available={String(recentLoaded)}>
          {
            !recentLoaded ? <p role="status" class="m-0 text-text-secondary">Recent tasks couldn’t load. Refresh the page to try again.</p> : tasks.length === 0 ? (
              <div class="bento-empty-state">
                <EmptyState
                  title={t("dashboard.no_tasks_yet", locale)}
                  description={t("dashboard.create_first_task", locale)}
                />
              </div>
            ) : (
              tasks.map((task) => {
                const priority = Number(task.priority ?? 3)
                const tt = String(task.task_type ?? "task")
                const rawAreaId = typeof task.area_id === "string" ? task.area_id.trim() : ""
                const realArea = rawAreaId && rawAreaId !== "default" ? areaMap[rawAreaId] ?? null : null
                const ticketKey = typeof task.ticket_key === "string" && task.ticket_key
                  ? task.ticket_key
                  : typeof task.ticket_ref === "string" && task.ticket_ref
                    ? task.ticket_ref
                    : task.ticket_number
                      ? `MTH-${String(task.ticket_number).padStart(3, "0")}`
                      : ""

                const isPromoted = Boolean(task.is_promoted)
                const dueDays = task.due_date
                  ? calendarDaysFromToday(String(task.due_date), dashboardTimeZone)
                  : null
                const dueStatus = task.due_date
                  ? (dueDays !== null
                      ? (dueDays < 0 || isDueTimeOverdue(String(task.due_date), dashboardTimeZone)
                          ? "overdue"
                          : dueDays === 0
                            ? "today"
                            : "upcoming")
                      : (relativeTime(String(task.due_date)).startsWith("Overdue") ? "overdue" : "upcoming"))
                  : null
                const dueLabel = task.due_date ? relativeTime(String(task.due_date)) : null
                let parsedFp: unknown = {}
                if (typeof task.framework_payload === "string" && task.framework_payload.trim()) {
                  try { parsedFp = JSON.parse(task.framework_payload) } catch { parsedFp = {} }
                } else if (task.framework_payload && typeof task.framework_payload === "object") {
                  parsedFp = task.framework_payload
                }
                const riceInputs = readRiceInputs(frameworkPayloadObject(parsedFp))
                const rice = riceInputs ? riceLensScore(riceInputs) : null
                return (
                  <KanbanTaskCard
                    task={task}
                    boardId={workScope.boardId}
                    locale={locale}
                    ticketKey={ticketKey}
                    priority={priority}
                    priorityLabel={priorityLabels[priority] ?? "Medium"}
                    priorityClass={priorityClasses[priority] ?? "priority-medium"}
                    taskType={tt}
                    typeColor={typeColors[tt] ?? typeColors.task!}
                    promoted={isPromoted}
                    canEdit={canEdit}
                    canCreate={canCreate}
                    dateFormat={dashboardDateFormat}
                    timezone={dashboardTimeZone}
                    dueStatus={dueStatus}
                    dueLabel={dueLabel}
                    description={taskDescriptionPreview(task.description)}
                    rice={rice}
                    childCount={Number(task.child_count ?? 0)}
                    area={realArea}
                    showAreaBadge={Boolean(realArea)}
                    showStatusBadge={true}
                    extraClass="bento-card dashboard-task-card"
                  />
                )
              })
            )
          }
        </div>
      </div>
    </DashboardWidget>
  </div>
  <div id="dashboard-empty" class="dashboard-empty tabler-surface" hidden>
    <div class="empty">
      <div class="empty-icon"><Icon name="layout-dashboard" size={32} sprite /></div>
      <h1 class="empty-title">Your dashboard is empty</h1>
      <p class="empty-subtitle">Add widgets to see tasks, capture work, and track progress here.</p>
      <div class="empty-action">
        <button type="button" class="btn btn-primary" data-dashboard-edit>Add widgets</button>
        <a href={contextHref("/tasks")} class="btn btn-ghost">Open Tasks</a>
      </div>
    </div>
  </div>
  </div>

  <DashboardLayoutEditor />

  <button
    id="dashboard-go-top"
    class="go-top-btn dashboard-go-top"
    type="button"
    aria-label="Scroll to top"
    title="Back to top"
    hidden
  >
    <Icon name="arrow-up" size={18} sprite />
  </button>

  <script>
    import "@lib/dashboard-controller"
  </script>
</Layout>
