---
import Layout from "../layouts/Layout.astro"
import Icon from "../components/ui/Icon.astro"
import { t } from "../i18n/translations"
import type { Locale } from "../lib/locale"
import { formatTicketKey } from "../lib/ticket-key"
import { TaskHandoff } from "@domains/tasks/persistence/task-handoff"
import { ensureSchema, getPersistenceClient } from "@domains/tasks/persistence/store"

const locale: Locale = Astro.cookies.get("meitheal-locale")?.value === "ga" ? "ga" : "en"
const canReview = Astro.locals.hassIsAdmin === true
Astro.response.headers.set("Cache-Control", "no-store")
if (!canReview) Astro.response.status = 403

const pageSize = 25
const requestedPage = Number(Astro.url.searchParams.get("page") ?? 1)
const page = Number.isInteger(requestedPage) && requestedPage > 0 && requestedPage <= 100_000 ? requestedPage : 1
let proposals: Awaited<ReturnType<TaskHandoff["queue"]>> = []
let loadFailed = false
if (canReview) {
  try {
    await ensureSchema()
    proposals = await new TaskHandoff(getPersistenceClient()).queue((page - 1) * pageSize, pageSize + 1)
  } catch {
    loadFailed = true
    Astro.response.status = 503
  }
}
const hasNextPage = proposals.length > pageSize
const reviewPage = page === 1 ? "/review" : `/review?page=${page}`
const expires = new Intl.DateTimeFormat(locale === "ga" ? "ga-IE" : "en-IE", {
  dateStyle: "medium", timeStyle: "short", timeZone: "UTC",
})
---

<Layout title={`Meitheal — ${t("review.title", locale)}`}>
  <span slot="page-title">{t("review.title", locale)}</span>
  <section class="review">
    <a class="review-back" href="/settings#bot-allow-proposals"><Icon name="settings" size={16} /> {t("review.back", locale)}</a>
    <header class="review-header">
      <div>
        <h1>{t("review.title", locale)}</h1>
        <p>{t("review.intro", locale)}</p>
      </div>
      {canReview && <a class="btn btn-secondary" data-astro-reload href={reviewPage}>{t("review.refresh", locale)}</a>}
    </header>

    {!canReview ? <p class="review-panel">{t("review.admin_required", locale)}</p> : (
      loadFailed ? <p class="review-panel" role="alert">{t("review.load_failed", locale)}</p> : (
        <div id="review-queue"
          data-approved={t("review.approved", locale)}
          data-rejected={t("review.rejected", locale)}
          data-conflict={t("review.conflict", locale)}
          data-failure={t("review.failure", locale)}>
          <p id="review-feedback" class="review-feedback" role="status" tabindex="-1"></p>
          <p id="review-empty" class="review-panel" hidden={proposals.length > 0}>{t("review.empty", locale)}</p>
          <ul class="review-list" aria-label={t("review.pending", locale)}>
            {proposals.slice(0, pageSize).map(proposal => (
              <li class="review-panel" data-proposal={proposal.hash} data-review-task-id={proposal.id}>
                <details>
                  <summary>
                    <span class="review-heading">
                      <small>{formatTicketKey(proposal.ticketNumber)}</small>
                      <strong>{proposal.title}</strong>
                      <span>{proposal.agent}</span>
                    </span>
                  </summary>
                  <div class="review-detail">
                    <p class="review-summary">{proposal.summary}</p>
                    <p class="review-expiry">{t("review.expires", locale)} <time datetime={new Date(proposal.expiresAt).toISOString()}>{expires.format(proposal.expiresAt)} UTC</time></p>
                    {proposal.stale && <p class="review-warning">{t("review.conflict", locale)}</p>}
                    <dl class="review-changes">
                      {proposal.fields.map(change => (
                        <div class="review-change">
                          <dt>{t(change.field === "title" ? "review.field_title" : "review.field_description", locale)}</dt>
                          <dd class="review-values">
                            <div><strong>{t("review.current", locale)}</strong><p>{change.current || "—"}</p></div>
                            <div><strong>{t("review.proposed", locale)}</strong><p>{change.to || "—"}</p></div>
                          </dd>
                        </div>
                      ))}
                    </dl>
                    <div class="review-actions">
                      <button type="button" class="btn btn-primary" data-decision="accept" disabled={proposal.stale}>{t("review.approve", locale)}</button>
                      <button type="button" class="btn btn-secondary" data-decision="reject">{t("review.reject", locale)}</button>
                    </div>
                  </div>
                </details>
              </li>
            ))}
          </ul>
          {(page > 1 || hasNextPage) && <nav class="review-actions" aria-label={t("review.pages", locale)}>
            {page > 1 && <a class="btn btn-secondary" href={page === 2 ? "/review" : `/review?page=${page - 1}`}>{t("review.previous", locale)}</a>}
            {hasNextPage && <a class="btn btn-secondary" href={`/review?page=${page + 1}`}>{t("review.next", locale)}</a>}
          </nav>}
        </div>
      )
    )}
  </section>
</Layout>

<style>
  .review { display: grid; gap: 16px; max-width: 860px; margin-inline: auto; min-width: 0; }
  .review-back { display: inline-flex; align-items: center; gap: 4px; min-height: 44px; width: fit-content; color: var(--accent-text); }
  .review-header { display: flex; flex-wrap: wrap; align-items: center; gap: 12px 24px; justify-content: space-between; }
  .review-header p, .review-expiry, .review-heading span, .review-heading small { color: var(--text-secondary); }
  .review-list, .review-changes { margin: 0; padding: 0; }
  .review-list { display: grid; gap: 12px; list-style: none; }
  .review-panel { border: 1px solid var(--border); background: var(--bg-card); border-radius: var(--radius); padding: 12px 16px; overflow-wrap: anywhere; }
  .review-panel summary { cursor: pointer; min-height: 44px; }
  .review-heading { display: inline-grid; gap: 2px; vertical-align: top; max-width: calc(100% - 28px); }
  .review-detail { display: grid; gap: 12px; border-block-start: 1px solid var(--border); margin-block-start: 12px; padding-block-start: 12px; }
  .review-detail p { margin: 0; white-space: pre-wrap; }
  .review-warning { padding: 8px 12px; border-inline-start: 3px solid var(--accent); background: var(--bg-hover); }
  .review-change { padding: 8px 0; border-block-end: 1px solid var(--border); }
  .review-change dt { font-weight: 700; margin-block-end: 6px; }
  .review-values { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 210px), 1fr)); gap: 8px; margin: 0; }
  .review-values > div { padding: 8px; background: var(--bg-hover); border-radius: var(--radius); min-width: 0; }
  .review-values strong { display: block; margin-block-end: 4px; }
  .review-actions { display: flex; flex-wrap: wrap; gap: 8px; margin-block-start: 8px; }
  .review .btn { min-height: 44px; }
  .review-feedback:empty { margin: 0; }
  .review-feedback:not(:empty) { margin-block: 0 12px; padding: 8px 12px; border: 1px solid var(--border); border-radius: var(--radius); }
</style>

<script>
  import { pageLifecycle } from "@lib/page-lifecycle"

  pageLifecycle.onPageLoad(signal => {
    const previousQueue = document.getElementById("review-queue")
    if (!previousQueue) return
    const queue = previousQueue.cloneNode(true) as HTMLElement
    previousQueue.replaceWith(queue)
    const feedback = queue.querySelector<HTMLElement>("#review-feedback")
    if (!queue || !feedback) return

    queue.addEventListener("click", async event => {
      const button = (event.target as Element).closest<HTMLButtonElement>("button[data-decision]")
      const card = button?.closest<HTMLElement>("[data-proposal]")
      if (!button || !card || button.disabled) return
      const previouslyEnabled = [...card.querySelectorAll<HTMLButtonElement>("button:not(:disabled)")]
      previouslyEnabled.forEach(action => { action.disabled = true })
      card.setAttribute("aria-busy", "true")

      try {
        const response = await fetch("/api/tasks/" + encodeURIComponent(card.dataset.reviewTaskId!) + "/accept-proposal", {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({ action: button.dataset.decision, proposal_hash: card.dataset.proposal }),
          signal,
        })
        if (response.ok) {
          card.remove()
          if (!queue.querySelector("[data-proposal]")) document.getElementById("review-empty")?.removeAttribute("hidden")
          feedback.textContent = (button.dataset.decision === "accept" ? queue.dataset.approved : queue.dataset.rejected) ?? ""
          feedback.focus()
          return
        }
        feedback.textContent = (response.status === 409 ? queue.dataset.conflict : queue.dataset.failure) ?? ""
      } catch {
        if (signal.aborted) return
        feedback.textContent = queue.dataset.failure ?? ""
      }
      card.removeAttribute("aria-busy")
      previouslyEnabled.forEach(action => { action.disabled = false })
      feedback.focus()
    }, { signal })
    queue.dataset.reviewReady = "true"
  })
</script>
