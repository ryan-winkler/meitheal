---
import { ensureSchema, getPersistenceClient, TaskHandoff } from "@domains/tasks"
import { verifyCurrentHAAdministrator } from "@domains/ha/current-admin"
import Layout from "../layouts/Layout.astro"
import EmptyState from "../components/ui/EmptyState.astro"
import { verifiedIngressUser } from "../lib/verified-ingress-user"
import { taskDetailPath } from "../lib/task-page-url"
import { formatTicketKey } from "../lib/ticket-key"

Astro.response.headers.set("Cache-Control", "private, no-store")
const user = verifiedIngressUser(Astro.locals)
const authority = user?.isAdmin ? await verifyCurrentHAAdministrator(user.id, Astro.request.signal) : "denied"
const allowed = authority === "allowed"
if (!allowed) Astro.response.status = authority === "unavailable" ? 503 : 403
const pageSize = 25
const requestedPage = Number(Astro.url.searchParams.get("page") ?? 1)
const page = Number.isSafeInteger(requestedPage) && requestedPage > 0 ? Math.min(requestedPage, 1000) : 1
const refreshPath = `/review${page > 1 ? `?page=${page}` : ""}`
let proposals: Awaited<ReturnType<TaskHandoff["queue"]>> = []
let fetchError = false
let hasMore = false
if (allowed) {
  try {
    await ensureSchema()
    const queue = await new TaskHandoff(getPersistenceClient()).queue((page - 1) * pageSize, pageSize + 1)
    hasMore = queue.length > pageSize
    proposals = queue.slice(0, pageSize)
  } catch {
    fetchError = true
    Astro.response.status = 503
  }
}
const displayValue = (value: string | null) => value === null ? "(not set)" : value || "(empty)"
---

<Layout title="Meitheal — Review Queue">
  <span slot="page-title">Review Queue</span>
  <div slot="actions">
    <a href={refreshPath} class="btn btn-secondary btn-sm" data-astro-reload>Refresh queue</a>
  </div>

  {!allowed ? (
    <div class="review-error" role="alert">
      <h2>{authority === "unavailable" ? "Administrator access could not be checked" : "Administrator access required"}</h2>
      <p>{authority === "unavailable"
        ? "Home Assistant could not confirm your current access. Refresh to try again."
        : "Open Review through Home Assistant ingress with an active administrator account."}</p>
    </div>
  ) : (
    <>
      <p class="review-note">Compare the saved proposal with the current task before deciding. Only the displayed proposal can be accepted or rejected. Refresh to read any newer proposal.</p>
      <p id="review-authority-status" role="status" aria-live="polite" class="review-note"></p>
      {fetchError && <div class="review-error" role="alert"><p>The review queue could not be loaded. Refresh to try again.</p></div>}
      {proposals.length === 0 && !fetchError && <EmptyState
        title="No pending proposals"
        description="There are no unexpired proposals on this page. Accepted, rejected and expired proposals leave the queue."
      />}
      <div class="review-queue" id="review-queue">
        {proposals.map(p => (
          <article class="review-card" data-proposal-review data-task-id={p.id} data-proposal-hash={p.hash}
            data-expires-at={p.expiresAt} data-stale={String(p.stale)} aria-labelledby={`proposal-title-${p.id}`}>
            <div class="review-card__header">
              <div class="review-card__title-row">
                <a class="review-card__ticket" href={taskDetailPath(p.id)}>{formatTicketKey(p.ticketNumber) ?? "Open task"}</a>
                <h2 class="review-card__title" id={`proposal-title-${p.id}`}>{p.title}</h2>
              </div>
              <div class="review-card__meta">
                <span class="review-card__agent">{p.agent}</span>
                <span>Review before <time datetime={new Date(p.expiresAt).toISOString()}>{new Date(p.expiresAt).toLocaleString("en-IE")}</time></span>
              </div>
            </div>
            <div class="review-card__summary"><strong>Summary:</strong> {p.summary}</div>
            {p.stale && <p class="review-stale">The task changed after this proposal was created. Acceptance is unavailable. Review the current values, then reject the proposal or refresh the queue.</p>}
            <div class="review-card__diff" role="region" aria-label={`Proposal comparison for ${p.title}`} tabindex="0">
              <table class="diff-table">
                <caption class="sr-only">Changes proposed by {p.agent} for {p.title}</caption>
                <thead><tr><th scope="col">Field</th><th scope="col">When proposed</th><th scope="col">Current</th><th scope="col">Proposed</th></tr></thead>
                <tbody>{p.fields.map(field => (
                  <tr data-proposal-field={field.field}>
                    <th scope="row" class="diff-field">{field.field === "title" ? "Title" : "Description"}</th>
                    <td class="diff-from">{displayValue(field.from)}</td>
                    <td data-current-value>{displayValue(field.current)}</td>
                    <td class="diff-to" data-proposed-value>{displayValue(field.to)}</td>
                  </tr>
                ))}</tbody>
              </table>
            </div>
            <details class="review-fingerprint"><summary>Proposal details</summary><p>Fingerprint: <code>{p.hash}</code></p></details>
            <div class="review-card__actions">
              <form data-review-decision aria-label={`Review proposal for ${p.title}`}>
                <button type="submit" name="action" value="accept" class="btn btn-primary" disabled aria-disabled={p.stale}>Accept proposal</button>
                <button type="submit" name="action" value="reject" class="btn btn-secondary" disabled>Reject proposal</button>
              </form>
              <a href={refreshPath} class="btn btn-secondary" data-review-refresh data-astro-reload>Refresh proposal</a>
            </div>
            <p class="review-card__status" data-review-status role="status" aria-live="polite" tabindex="-1"></p>
          </article>
        ))}
      </div>
      {(page > 1 || hasMore) && <nav class="review-pages" aria-label="Review queue pages">
        {page > 1 && <a class="btn btn-secondary" href={`/review?page=${page - 1}`} data-astro-reload>Previous page</a>}
        <span>Page {page}</span>
        {hasMore && <a class="btn btn-secondary" href={`/review?page=${page + 1}`} data-astro-reload>Next page</a>}
      </nav>}
      <noscript><p>JavaScript is needed to submit a review decision. The displayed proposal remains available to read.</p></noscript>
    </>
  )}
</Layout>

<script>
  import "@lib/proposal-review-controller"
</script>

<style>
  .review-note {
    color: var(--text-muted);
    margin-bottom: 16px;
  }

  .review-error {
    background: color-mix(in srgb, var(--danger, #ef4444) 12%, transparent);
    border: 1px solid var(--danger, #ef4444);
    border-radius: 8px;
    padding: 12px 16px;
    margin-bottom: 16px;
    color: var(--danger, #ef4444);
    font-size: 13px;
  }

  .review-queue {
    display: flex;
    flex-direction: column;
    gap: 14px;
  }

  .review-card {
    background: var(--bg-card);
    border: 1px solid var(--border);
    border-radius: 12px;
    overflow: hidden;
    transition: border-color 0.2s ease, box-shadow 0.2s ease;
  }
  .review-card:hover {
    border-color: color-mix(in srgb, var(--border) 60%, var(--accent, #6366f1) 40%);
    box-shadow: 0 4px 16px -4px rgba(0, 0, 0, 0.15);
  }

  .review-card__header {
    padding: 16px;
    border-bottom: 1px solid var(--border);
    background: rgba(255, 255, 255, 0.02);
  }

  .review-card__title-row {
    display: flex;
    align-items: center;
    gap: 8px;
    margin-bottom: 8px;
  }

  .review-card__ticket {
    font-size: 12px;
    font-weight: 700;
    color: var(--accent-text);
    background: color-mix(in srgb, var(--accent, #6366f1) 10%, transparent);
    padding: 2px 8px;
    border-radius: 10px;
    flex-shrink: 0;
    font-variant-numeric: tabular-nums;
  }

  .review-card__title {
    font-size: 15px;
    font-weight: 600;
    color: var(--text-primary);
    margin: 0;
    letter-spacing: -0.01em;
  }

  .review-card__meta {
    display: flex;
    gap: 12px;
    font-size: 11px;
    color: var(--text-muted);
  }

  .review-card__agent {
    font-weight: 600;
    color: var(--text-primary);
    color: color-mix(in srgb, var(--text-primary) 60%, var(--info));
  }

  .review-card__summary {
    padding: 12px 16px;
    font-size: 13px;
    color: var(--text-primary);
    border-bottom: 1px solid var(--border);
  }

  .review-card__diff {
    padding: 0;
    overflow-x: auto;
  }
  .review-card__diff:focus-visible {
    outline-color: var(--accent-text);
    outline-offset: -2px;
  }

  .diff-table {
    width: 100%;
    border-collapse: collapse;
    font-size: 12px;
  }
  .diff-table th {
    text-align: left;
    padding: 8px 16px;
    background: rgba(255, 255, 255, 0.03);
    color: var(--text-muted);
    font-weight: 600;
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: 0.06em;
  }
  .diff-table td {
    padding: 8px 16px;
    border-top: 1px solid var(--border);
    vertical-align: top;
  }
  .diff-field {
    font-weight: 600;
    color: var(--text-primary);
    white-space: normal;
  }
  .diff-from {
    color: var(--text-secondary);
  }
  .diff-to {
    color: var(--text-primary);
    color: color-mix(in srgb, var(--text-primary) 60%, var(--success));
    font-weight: 500;
  }
  .review-card__title-row { flex-wrap: wrap; }
  .review-card__meta { flex-wrap: wrap; }
  .review-card__title, .review-card__summary, .diff-table :is(td, th) { overflow-wrap: anywhere; }
  .diff-table :is(td, th) { min-width: 7rem; white-space: pre-wrap; }
  .review-stale, .review-fingerprint, .review-card__actions, .review-card__status { margin: 12px 16px; }
  .review-stale { color: var(--warning-text, var(--warning)); }
  .review-fingerprint code { overflow-wrap: anywhere; }
  .review-card__actions, [data-review-decision], .review-pages { display: flex; flex-wrap: wrap; align-items: center; gap: 8px; }
  .review-card__actions .btn { min-height: 44px; }
  .review-card__actions button[aria-disabled="true"] { opacity: 0.6; cursor: not-allowed; }
  .review-card__status { white-space: pre-wrap; }
  .review-card__status:empty { margin: 0; }
  .review-pages { margin-block: 16px; }
</style>
