---
import { resolveBoardPageScope, boardScopeResponse } from "@lib/board-http"

import Layout from "../layouts/Layout.astro"
import Icon from "../components/ui/Icon.astro"
import { AreaRepository, type AreaRow } from "@domains/tasks/persistence/area-repository"
import { ensureSchema, getPersistenceClient } from "@domains/tasks/persistence/store"
import { TaskRepository } from "@domains/tasks/persistence/task-repository"
import { formatTicketKey } from "@lib/ticket-key"
import { getStatusDef } from "@lib/status-config"
import { t } from "../i18n/translations"
import "../styles/work-queue.css"
const workScopeResult = await resolveBoardPageScope(Astro, { boardId: Astro.props.boardId })
if (!workScopeResult.ok) return boardScopeResponse(workScopeResult.errorCode)
const workScope = workScopeResult.scope


Astro.response.headers.set("cache-control", "no-store")
const locale = Astro.cookies.get("meitheal-locale")?.value === "ga" ? "ga" : "en"
const rawPage = Astro.url.searchParams.get("page") ?? ""
const area = (Astro.url.searchParams.get("area") ?? "").slice(0, 128)
let areas: AreaRow[] = []
let queue: Awaited<ReturnType<TaskRepository["findDeferredPage"]>> | undefined
try {
  await ensureSchema()
  const client = getPersistenceClient()
  const [result, availableAreas] = await Promise.all([
    new TaskRepository(client, workScope).findDeferredPage(/^[1-9]\d*$/.test(rawPage) ? Number(rawPage) : 1, area),
    new AreaRepository(client, workScope).findAll(),
  ])
  queue = result
  areas = availableAreas
} catch {
  // Keep the retry affordance available if the database is temporarily offline.
}
const page = queue?.page ?? 1
const tasks = queue?.tasks ?? []
const first = (page - 1) * 25 + 1
const last = first + tasks.length - 1
const total = queue?.total ?? 0
const boardHref = `/tasks?${new URLSearchParams({ area })}#kanban`
const dateOptions = { dateStyle: "medium", timeStyle: "short" } as const
let dateFormat: Intl.DateTimeFormat
try {
  dateFormat = new Intl.DateTimeFormat(locale, { ...dateOptions, timeZone: Astro.locals.timezone })
} catch {
  dateFormat = new Intl.DateTimeFormat(locale, { ...dateOptions, timeZone: "UTC" })
}

function pageHref(target: number, open?: string) {
  const params = new URLSearchParams()
  if (area) params.set("area", area)
  if (target > 1) params.set("page", String(target))
  if (open) params.set("open", open)
  return params.size ? `/deferred?${params}` : "/deferred"
}
---

<Layout title={t("deferral.title", locale)} suppressTaskUrlOpen>
  <section class="work-queue" data-deferred-root aria-labelledby="deferred-heading">
    <header class="work-queue-header">
      <a href={boardHref} class="btn btn-outline" data-astro-prefetch="false">
        <Icon name="layout-kanban" size={18} /> {t("deferral.back", locale)}
      </a>
      <h1 id="deferred-heading" tabindex="-1"><Icon name="clock" size={24} />{t("deferral.title", locale)}</h1>
      <p>{t("deferral.description", locale)}</p>
    </header>
    <div class="work-queue-controls">
      <p role="status" aria-atomic="true" data-deferred-status>{t("deferral.loading", locale)}</p>
      <a href={pageHref(page)} class="btn btn-outline" data-deferred-reload data-astro-prefetch="false" hidden>
        <Icon name="refresh" size={18} /> {t("deferral.reload", locale)}
      </a>
      <a class="btn btn-outline" data-deferred-permalink data-astro-prefetch="false" hidden>{t("deferral.open_task", locale)}</a>
    </div>
    <div data-deferred-content></div>
    <template data-deferred-fragment data-page={page} data-available={queue ? "true" : "false"}>
      {queue && (
        <>
          <div class="work-queue-panel work-queue-scope">
            <form method="get" action="/deferred" class="work-queue-controls">
              <label>
                <span class="form-label">{t("inactivity.area", locale)}</span>
                <select class="form-select" name="area">
                  <option value="" selected={!area}>{t("deferral.all_areas", locale)}</option>
                  {areas.map(({id, name}) => <option value={id} selected={area === id}>{name}</option>)}
                  {area && !areas.some(item => item.id === area) && (
                    <option value={area} selected>{t("deferral.area_unavailable", locale)}</option>
                  )}
                </select>
              </label>
              <button type="submit" class="btn btn-outline"><Icon name="adjustments-horizontal" size={18} />{t("deferral.apply_area", locale)}</button>
            </form>
            <p class="work-queue-subtle" data-deferred-count>{t("deferral.total", locale, { count: String(total) })}</p>
          </div>
          {tasks.length ? (
            <ul class="work-queue-list">
              {tasks.map(task => {
                const timestamp = new Date(task.deferred_at ?? 0)
                const definition = getStatusDef(task.status)
                return (
                  <li class="work-queue-row" data-deferred-card={task.id} data-version={task.updated_at}
                    data-revision={task.deferral_revision ?? ""} data-project={task.project_id ?? ""}>
                    <div>
                      <p class="work-queue-subtle">{formatTicketKey(task.ticket_number)}</p>
                      <h2>{task.title}</h2>
                      <p class="work-queue-subtle">
                        {definition ? t(definition.i18nKey, locale) : task.status}
                        {" · "}<time datetime={timestamp.toISOString()}>{dateFormat.format(timestamp)}</time>
                        {task.automatic && <>{" · "}{t("inactivity.moved", locale)}</>}
                      </p>
                    </div>
                    <div class="work-queue-controls">
                      <a href={pageHref(page, task.id)} class="btn btn-outline" data-deferred-details data-astro-prefetch="false">
                        <Icon name="file-text" size={18} />
                        {t("triage.details", locale)}
                      </a>
                      <button type="button" class="btn btn-primary" data-deferred-resume>
                        <Icon name="refresh" size={18} /> {t("deferral.resume", locale)}
                      </button>
                    </div>
                  </li>
                )
              })}
            </ul>
          ) : <p class="work-queue-empty">{t(area ? "deferral.area_empty" : "deferral.empty", locale)}</p>}
          {total > 25 && (
            <nav class="work-queue-controls" aria-label={t("deferral.pagination", locale)}>
              <span>{t("triage.range", locale, { first: String(first), last: String(last), total: String(total) })}</span>
              {page > 1 && <a href={pageHref(page - 1)} class="btn btn-outline" data-astro-prefetch="false">{t("triage.previous", locale)}</a>}
              {last < total && <a href={pageHref(page + 1)} class="btn btn-outline" data-astro-prefetch="false">{t("triage.next", locale)}</a>}
            </nav>
          )}
        </>
      )}
    </template>
  </section>
</Layout>

<script>
  import "@lib/deferred-controller"
</script>
