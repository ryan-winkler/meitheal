---
import Layout from "../layouts/Layout.astro"
import { ensureSchema, getPersistenceClient } from "@domains/tasks/persistence/store"
import { TaskRepository } from "@domains/tasks/persistence/task-repository"
import { formatTicketKey } from "@lib/ticket-key"
import { getStatusDef } from "@lib/status-config"
import { t } from "../i18n/translations"

Astro.response.headers.set("cache-control", "no-store")
const locale = Astro.cookies.get("meitheal-locale")?.value === "ga" ? "ga" : "en"
const rawPage = Astro.url.searchParams.get("page") ?? ""
let queue: Awaited<ReturnType<TaskRepository["findDeferredPage"]>> | undefined
try {
  await ensureSchema()
  queue = await new TaskRepository(getPersistenceClient()).findDeferredPage(/^[1-9]\d*$/.test(rawPage) ? Number(rawPage) : 1)
} catch {
  // Keep the retry affordance available if the database is temporarily offline.
}
const page = queue?.page ?? 1
const tasks = queue?.tasks ?? []
const first = (page - 1) * 25 + 1
const last = first + tasks.length - 1
const total = queue?.total ?? 0
const dateOptions = { dateStyle: "medium", timeStyle: "short" } as const
let dateFormat: Intl.DateTimeFormat
try {
  dateFormat = new Intl.DateTimeFormat(locale, { ...dateOptions, timeZone: Astro.locals.timezone })
} catch {
  dateFormat = new Intl.DateTimeFormat(locale, { ...dateOptions, timeZone: "UTC" })
}

function pageHref(target: number, open?: string) {
  const params = new URLSearchParams()
  if (target > 1) params.set("page", String(target))
  if (open) params.set("open", open)
  return params.size ? `/deferred?${params}` : "/deferred"
}
---

<Layout title={t("deferral.title", locale)} suppressTaskUrlOpen>
  <section class="deferred" data-deferred-root aria-labelledby="deferred-heading">
    <header>
      <a href="/tasks" data-astro-prefetch="false">{t("deferral.back", locale)}</a>
      <h1 id="deferred-heading" tabindex="-1">{t("deferral.title", locale)}</h1>
      <p>{t("deferral.description", locale)}</p>
    </header>
    <p role="status" aria-atomic="true" data-deferred-status>{t("deferral.loading", locale)}</p>
    <a href={pageHref(page)} class="btn btn-outline" data-deferred-reload data-astro-prefetch="false" hidden>
      {t("deferral.reload", locale)}
    </a>
    <a class="btn btn-outline" data-deferred-permalink data-astro-prefetch="false" hidden>{t("deferral.open_task", locale)}</a>
    <div data-deferred-content></div>
    <template data-deferred-fragment data-page={page} data-available={queue ? "true" : "false"}>
      {queue && (
        <>
          <p class="deferred-meta" data-deferred-count>{t("deferral.total", locale, { count: String(total) })}</p>
          {tasks.length ? (
            <ul class="deferred-list">
              {tasks.map(task => {
                const timestamp = new Date(task.deferred_at ?? 0)
                const definition = getStatusDef(task.status)
                return (
                  <li class="deferred-card" data-deferred-card={task.id} data-version={task.updated_at}
                    data-revision={task.deferral_revision ?? ""} data-project={task.project_id ?? ""}>
                    <div>
                      <p class="deferred-meta">{formatTicketKey(task.ticket_number)}</p>
                      <h2>{task.title}</h2>
                      <p class="deferred-meta">
                        {definition ? t(definition.i18nKey, locale) : task.status}
                        {" · "}<time datetime={timestamp.toISOString()}>{dateFormat.format(timestamp)}</time>
                        {task.automatic && <>{" · "}{t("inactivity.moved", locale)}</>}
                      </p>
                    </div>
                    <div class="deferred-actions">
                      <a href={pageHref(page, task.id)} class="btn btn-outline" data-deferred-details data-astro-prefetch="false">
                        {t("triage.details", locale)}
                      </a>
                      <button type="button" class="btn btn-primary" data-deferred-resume>{t("deferral.resume", locale)}</button>
                    </div>
                  </li>
                )
              })}
            </ul>
          ) : <p>{t("deferral.empty", locale)}</p>}
          {total > 25 && (
            <nav class="deferred-actions" aria-label={t("deferral.pagination", locale)}>
              <span>{t("triage.range", locale, { first: String(first), last: String(last), total: String(total) })}</span>
              {page > 1 && <a href={pageHref(page - 1)} class="btn btn-outline" data-astro-prefetch="false">{t("triage.previous", locale)}</a>}
              {last < total && <a href={pageHref(page + 1)} class="btn btn-outline" data-astro-prefetch="false">{t("triage.next", locale)}</a>}
            </nav>
          )}
        </>
      )}
    </template>
  </section>
</Layout>

<script>
  import "@lib/deferred-controller"
</script>

<style>
  .deferred {
    max-width: 66rem;
    margin-inline: auto;
    padding: clamp(1rem, 3vw, 2.5rem);
  }
  header { margin-bottom: 1.5rem; }
  header h1 { margin-block: .5rem; }
  .deferred-meta { color: var(--text-secondary); }
  .deferred-list {
    display: grid;
    gap: .75rem;
    list-style: none;
    padding: 0;
  }
  .deferred-card {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: center;
    gap: 1rem;
    padding: 1rem;
    background: var(--bg-card);
    border: 1px solid var(--border);
    border-radius: .75rem;
    overflow-wrap: anywhere;
  }
  .deferred-card h2 { margin: .25rem 0; font-size: 1rem; }
  .deferred-card p { margin: .25rem 0; }
  .deferred-actions { display: flex; flex-wrap: wrap; align-items: center; gap: .5rem; }
  .deferred-actions > :is(a, button) { min-height: 2.75rem; }
  @media (max-width: 680px) {
    .deferred-card { grid-template-columns: minmax(0, 1fr); }
  }
</style>
