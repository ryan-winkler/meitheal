---
import Layout from "../layouts/Layout.astro"
import Icon from "../components/ui/Icon.astro"
import { t } from "../i18n/translations"
import "../styles/work-queue.css"

const locale = Astro.cookies.get("meitheal-locale")?.value === "ga" ? "ga" : "en"
const text = (key: string) => t(`inactivity.${key}`, locale)
const area = Astro.url.searchParams.get("area") ?? ""
const boardHref = `/tasks?${new URLSearchParams({ area })}#kanban`
---

<Layout title={text("title")} hideSearchHub hideGlobalSearch privatePageShell suppressTaskUrlOpen>
  <section class="work-queue" data-inactivity-page data-locale={locale} data-timezone={Astro.locals.timezone} aria-labelledby="inactivity-heading">
    <header class="work-queue-header">
      <a href={boardHref} class="btn btn-outline" data-inactivity-back data-astro-prefetch="false">
        <Icon name="layout-kanban" size={18} /> {text("back")}
      </a>
      <h1 id="inactivity-heading"><Icon name="calendar-event" size={24} />{text("title")}</h1>
      <p>{text("description")}</p>
    </header>
    <div class="work-queue-controls">
      <p data-inactivity-status role="status" aria-atomic="true">{text("loading")}</p>
      <button type="button" class="btn btn-outline" data-inactivity-retry hidden>
        <Icon name="refresh" size={18} /> {text("retry")}
      </button>
    </div>
    <div data-inactivity-content hidden>
      <div class="work-queue-panel">
        <div class="work-queue-controls">
          <label>
            <span class="form-label">{text("area")}</span>
            <select class="form-select" data-inactivity-area><option value="">{text("all_areas")}</option></select>
          </label>
          <label>
            <span class="form-label">{text("show")}</span>
            <select class="form-select" data-inactivity-filter>
              <option value="all">{text("all")}</option>
              <option value="ready">{text("ready")}</option>
              <option value="upcoming">{text("upcoming")}</option>
              <option value="stalled">{text("stalled")}</option>
            </select>
          </label>
        </div>
        <p class="work-queue-subtle" data-inactivity-policy></p>
        <p class="work-queue-subtle" data-inactivity-readonly hidden>{text("admin")}</p>
      </div>
      <form class="work-queue-panel" data-inactivity-edit hidden>
        <div class="work-queue-controls">
          <label>
            <span class="form-label">{text("rule")}</span>
            <select class="form-select" name="mode" data-inactivity-mode>
              <option value="inherit">{text("inherit")}</option>
              <option value="off">{text("off")}</option>
              <option value="interval">{text("custom")}</option>
            </select>
          </label>
          <label data-inactivity-interval hidden>
            <span class="form-label">{text("days")}</span>
            <input class="form-input" name="days" type="number" min="1" max="365" step="1" value="30" disabled required />
          </label>
        </div>
        <p class="work-queue-subtle">{text("notice")}</p>
        <div class="work-queue-controls">
          <button type="submit" class="btn btn-outline" data-inactivity-preview>
            <Icon name="search" size={18} /> {text("preview")}
          </button>
          <button type="button" class="btn btn-primary" data-inactivity-save disabled>
            <Icon name="check" size={18} /> {text("save")}
          </button>
        </div>
      </form>
      <section class="inactivity-results" aria-labelledby="inactivity-review" data-inactivity-results>
        <h2 id="inactivity-review" tabindex="-1">{text("review")}</h2>
        <p class="work-queue-empty" data-inactivity-empty hidden></p>
        <ul data-inactivity-rows class="work-queue-list"></ul>
        <nav class="work-queue-controls" aria-label={t("deferral.pagination", locale)} data-inactivity-pages hidden>
          <span data-inactivity-range></span>
          <button type="button" class="btn btn-outline" data-inactivity-previous>{t("triage.previous", locale)}</button>
          <button type="button" class="btn btn-outline" data-inactivity-next>{t("triage.next", locale)}</button>
        </nav>
      </section>
    </div>
  </section>
</Layout>

<script>
  import "@lib/inactivity-controller"
</script>

<style>
  input { inline-size: 9rem; }
  .inactivity-results { margin-block: 1.25rem; }
  .inactivity-results h2 { margin-block: 0 .75rem; font-size: 1.125rem; }
</style>
