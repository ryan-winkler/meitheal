---
/**
 * Gamification Page — Unified Tabler wrapper around AchievementsTab (DRY)
 *
 * Respects all Look & Feel settings (theme, accent, radius, typography, fluid width).
 *
 * @domain gamification
 * @bounded-context gamification
 */
import { boardContextHref } from "@lib/board-workspace"
import { readBoardPagePlacement } from "@lib/board-page-placement"
import { resolveBoardPageScope, boardScopeResponse } from "@lib/board-http"
import { isFeatureEnabled } from "../lib/feature-flags"
import Layout from "../layouts/Layout.astro"
import Icon from "../components/ui/Icon.astro"
import AchievementsTab from "../components/progress/AchievementsTab.astro"

const scoped = await resolveBoardPageScope(Astro)
if (!scoped.ok) return boardScopeResponse(scoped.errorCode)
const workScope = scoped.scope
const pagePlacement = await readBoardPagePlacement(workScope, Astro.url)
if (!pagePlacement.ok) return boardScopeResponse(pagePlacement.errorCode)

if (!(await isFeatureEnabled("gamification"))) {
  return Astro.redirect(`${Astro.locals.ingressPath || ""}/`)
}

const progressHref = boardContextHref(
  { boardId: workScope.boardId, area: pagePlacement.area?.id, project: pagePlacement.project?.id },
  "/progress#achievements",
)
---

<Layout title="Gamification & Achievements — Meitheal" description="Track your progress, earn achievements, and level up">
  <Fragment slot="page-title">
    <span class="inline-flex items-center gap-2">
      <Icon name="trophy" size={20} sprite={true} />
      <span>Gamification &amp; Achievements</span>
    </span>
  </Fragment>

  <div class="gam-page-shell">
    <header class="gam-page-header">
      <div>
        <div class="subheader">Progress &amp; Growth</div>
        <h1 class="gam-page-header__title">Gamification &amp; Achievements</h1>
      </div>
      <a href={progressHref} class="btn btn-secondary btn-sm">
        <Icon name="sparkles" size={15} sprite={true} />
        <span>Open in Progress &amp; Growth</span>
      </a>
    </header>

    <AchievementsTab />
  </div>
</Layout>

<style>
  .gam-page-shell {
    width: 100%;
    max-width: 1200px;
    margin: 0 auto;
    padding: 0.75rem 0 2rem;
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  :global(:root[data-appearance-width="fluid"]) .gam-page-shell {
    max-width: none;
  }

  .gam-page-header {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem 1rem;
  }

  .gam-page-header__title {
    margin: 0.15rem 0 0;
    font-size: 1.375rem;
    font-weight: 700;
    color: var(--text-primary);
  }
</style>
