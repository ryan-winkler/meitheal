---
import Layout from "../../layouts/Layout.astro"

import ProgressRing from "../../components/ui/ProgressRing.astro"
import { ensureSchema, getPersistenceClient } from "@domains/tasks/persistence/store"
import { HierarchyRepository } from "@domains/tasks/persistence/hierarchy-repository"

let goals: Array<{
  id: string
  title: string
  description: string | null
  status: string
  target_date: string | null
  area_id: string | null
  areaName: string | null
  areaIcon: string | null
  projectCount: number
  completedProjectCount: number
}> = []

try {
  await ensureSchema()
  const db = getPersistenceClient()
  const repo = new HierarchyRepository(db)
  const rawGoals = await repo.findAllGoals({})
  const areas = await repo.findAllAreas()
  const projects = await repo.findAllProjects({})

  const areaMap = new Map(areas.map((a) => [a.id, a]))

  for (const g of rawGoals) {
    const area = g.area_id ? areaMap.get(g.area_id as string) : null
    const goalProjects = projects.filter((p) => String(p.goal_id) === String(g.id))
    const projectCount = goalProjects.length
    const completedProjectCount = goalProjects.filter((p) => String(p.status) === "completed").length

    goals.push({
      id: g.id as string,
      title: g.title as string,
      description: (g.description as string | null) ?? null,
      status: (g.status as string) || "active",
      target_date: (g.target_date as string | null) ?? null,
      area_id: (g.area_id as string | null) ?? null,
      areaName: area ? String(area.name) : null,
      areaIcon: area ? String(area.icon ?? "📁") : null,
      projectCount,
      completedProjectCount,
    })
  }
} catch {
  // Goals will be empty on error
}

const statusLabels: Record<string, string> = {
  active: "Active",
  completed: "Completed",
  archived: "Archived",
}
---

<Layout title="Goals">

  <div class="goals-page">
    <header class="goals-header">
      <div class="goals-header-left">
        <h1 class="goals-heading">🎯 Goals</h1>
        <span class="goals-count">{goals.length} goal{goals.length !== 1 ? "s" : ""}</span>
      </div>
      <button type="button" class="btn btn-primary" id="new-goal-btn">+ New Goal</button>
    </header>

    {goals.length === 0 ? (
      <div class="empty-state">
        <div class="empty-state-icon">🎯</div>
        <h2 class="empty-state-title">No goals yet</h2>
        <p class="empty-state-desc">Create your first goal to define strategic outcomes for your work.</p>
        <button type="button" class="btn btn-primary" id="empty-new-goal-btn">
          Create Goal
        </button>
      </div>
    ) : (
      <div class="goal-list">
        {goals.map((goal) => (
          <div class="goal-card" data-goal-id={goal.id} data-goal-status={goal.status}>
            <div class="goal-card-header">
              <h3 class="goal-card-title">{goal.title}</h3>
              <div class="goal-card-actions">
                <span class={`goal-status-badge status-${goal.status}`}>
                  {statusLabels[goal.status] ?? goal.status}
                </span>
                <div class="goal-actions-row">
                  {goal.status === "active" && (
                    <button type="button" class="goal-action-btn goal-complete-btn" data-goal-id={goal.id} title="Mark completed" aria-label="Mark goal completed">✓</button>
                  )}
                  {goal.status === "completed" && (
                    <button type="button" class="goal-action-btn goal-reactivate-btn" data-goal-id={goal.id} title="Reactivate" aria-label="Reactivate goal">↩</button>
                  )}
                  <button type="button" class="goal-action-btn goal-delete-btn" data-goal-id={goal.id} title="Delete goal" aria-label="Delete goal">🗑</button>
                </div>
              </div>
            </div>
            {goal.description && (
              <p class="goal-card-desc">{goal.description.slice(0, 120)}{goal.description.length > 120 ? "…" : ""}</p>
            )}
            <div class="goal-card-meta">
              {goal.projectCount > 0 && (
                <ProgressRing
                  percent={goal.projectCount > 0 ? Math.round((goal.completedProjectCount / goal.projectCount) * 100) : 0}
                  size={32}
                  strokeWidth={3}
                  label={`${goal.completedProjectCount}/${goal.projectCount} projects complete`}
                />
              )}
              {goal.areaName && (
                <span class="goal-meta-area">{goal.areaIcon} {goal.areaName}</span>
              )}
              <span class="goal-meta-projects">📋 {goal.projectCount} project{goal.projectCount !== 1 ? "s" : ""}</span>
              {goal.target_date && (
                <span class="goal-meta-date">📅 {goal.target_date}</span>
              )}
            </div>
          </div>
        ))}
      </div>
    )}
  </div>
</Layout>

<style>
  @reference "../../styles/global.css";

  .goals-page {
    max-width: 900px;
    margin: 0 auto;
    padding: 2rem 1.5rem;
  }
  .goals-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 1.5rem;
    gap: 1rem;
  }
  .goals-header-left {
    display: flex;
    align-items: baseline;
    gap: 0.75rem;
    min-width: 0;
  }
  .goals-heading {
    font-size: 1.5rem;
    font-weight: 700;
    color: var(--text-primary);
    white-space: nowrap;
  }
  .goals-count {
    font-size: 0.8125rem;
    color: var(--text-muted);
    white-space: nowrap;
  }

  .empty-state {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding: 4rem 2rem;
    text-align: center;
  }
  .empty-state-icon { font-size: 48px; margin-bottom: 1rem; }
  .empty-state-title {
    font-size: 1.25rem;
    font-weight: 600;
    color: var(--text-primary);
    margin-bottom: 0.5rem;
  }
  .empty-state-desc {
    color: var(--text-muted);
    font-size: 0.875rem;
    margin-bottom: 1.5rem;
    max-width: 360px;
  }

  .goal-list {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .goal-card {
    background: var(--bg-card);
    border: 1px solid var(--border);
    border-radius: var(--radius-md);
    padding: 1rem 1.25rem;
    transition: border-color 200ms, box-shadow 200ms;
  }
  .goal-card:hover {
    border-color: var(--accent);
    box-shadow: 0 2px 8px rgba(0,0,0,0.08);
  }
  .goal-card--removing {
    opacity: 0;
    transform: translateX(-20px);
    transition: opacity 200ms, transform 200ms;
  }

  .goal-card-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 0.75rem;
    margin-bottom: 0.375rem;
  }
  .goal-card-title {
    font-size: 1rem;
    font-weight: 600;
    color: var(--text-primary);
    line-height: 1.3;
  }
  .goal-status-badge {
    font-size: 0.6875rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    padding: 0.125rem 0.5rem;
    border-radius: 999px;
    white-space: nowrap;
    flex-shrink: 0;
  }
  .status-active {
    background: rgba(var(--accent-rgb), 0.12);
    color: var(--accent);
  }
  .status-completed {
    background: rgba(var(--success-rgb), 0.12);
    color: var(--success);
  }
  .status-archived {
    background: rgba(var(--text-muted-rgb, 128, 128, 128), 0.12);
    color: var(--text-muted);
  }

  .goal-card-desc {
    font-size: 0.8125rem;
    color: var(--text-secondary);
    margin-bottom: 0.5rem;
    line-height: 1.4;
  }

  .goal-card-meta {
    display: flex;
    align-items: center;
    gap: 1rem;
    font-size: 0.75rem;
    color: var(--text-muted);
  }

  .goal-card-actions {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    flex-shrink: 0;
  }
  .goal-actions-row {
    display: flex;
    gap: 0.25rem;
    opacity: 0;
    transition: opacity 150ms;
  }
  .goal-card:hover .goal-actions-row {
    opacity: 1;
  }
  .goal-action-btn {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 28px;
    height: 28px;
    border: 1px solid var(--border);
    border-radius: var(--radius-sm);
    background: var(--bg-primary);
    cursor: pointer;
    font-size: 13px;
    transition: background 150ms, border-color 150ms;
  }
  .goal-action-btn:hover {
    background: var(--bg-hover);
    border-color: var(--accent);
  }
  .goal-delete-btn:hover {
    border-color: var(--danger);
    background: rgba(var(--danger-rgb), 0.08);
  }
  .goal-complete-btn:hover {
    border-color: var(--success);
    background: rgba(var(--success-rgb), 0.08);
  }

  /* Inline create form — reuses project pattern */
  .goal-create-form {
    display: none;
    margin-bottom: 1rem;
    animation: form-slide-in 200ms ease;
  }
  @keyframes form-slide-in {
    from { opacity: 0; transform: translateY(-8px); }
    to { opacity: 1; transform: translateY(0); }
  }
  .create-form-inner {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.75rem 1rem;
    background: var(--bg-card);
    border: 1px solid var(--border);
    border-radius: var(--radius-md);
  }
  .create-form-input {
    flex: 1;
    padding: 0.5rem 0.75rem;
    font-size: 0.875rem;
    background: var(--bg-primary);
    border: 1px solid var(--border);
    border-radius: var(--radius-sm);
    color: var(--text-primary);
    outline: none;
    transition: border-color 150ms;
  }
  .create-form-input:focus {
    border-color: var(--accent);
    box-shadow: 0 0 0 2px rgba(var(--accent-rgb), 0.15);
  }
  .create-form-input::placeholder { color: var(--text-muted); }
  .create-form-select {
    padding: 0.5rem 0.75rem;
    font-size: 0.8125rem;
    background: var(--bg-primary);
    border: 1px solid var(--border);
    border-radius: var(--radius-sm);
    color: var(--text-primary);
    cursor: pointer;
    transition: border-color 150ms;
    max-width: 180px;
  }
  .create-form-select:focus {
    border-color: var(--accent);
    outline: none;
  }
  .create-form-actions {
    display: flex;
    gap: 0.375rem;
    flex-shrink: 0;
  }
  .create-form-error {
    font-size: 12px;
    color: var(--danger);
    margin-left: 0.5rem;
    flex-shrink: 0;
  }
  .btn-sm {
    padding: 0.375rem 0.75rem;
    font-size: 0.8125rem;
  }
  @media (max-width: 480px) {
    .create-form-inner {
      flex-direction: column;
      align-items: stretch;
    }
  }
</style>

<script>
  // --- Inline goal creation form ---
  const createBtn = document.getElementById("new-goal-btn");
  const emptyBtn = document.getElementById("empty-new-goal-btn");
  let formVisible = false;

  function ensureCreateForm(): HTMLElement {
    let form = document.getElementById("goal-create-inline");
    if (form) return form;

    const container = document.querySelector(".goal-list") || document.querySelector(".empty-state");
    if (!container?.parentElement) return document.createElement("div");

    form = document.createElement("div");
    form.id = "goal-create-inline";
    form.className = "goal-create-form";
    form.innerHTML = `
      <div class="create-form-inner">
        <input
          type="text"
          id="goal-create-input"
          class="create-form-input"
          placeholder="Goal title…"
          maxlength="200"
          autocomplete="off"
          aria-label="New goal title"
        />
        <select id="goal-create-area" class="create-form-select" aria-label="Area">
          <option value="">No area</option>
        </select>
        <div class="create-form-actions">
          <button type="button" id="goal-create-submit" class="btn btn-primary btn-sm">Create</button>
          <button type="button" id="goal-create-cancel" class="btn btn-ghost btn-sm">Cancel</button>
        </div>
      </div>
    `;
    container.parentElement.insertBefore(form, container);

    form.querySelector("#goal-create-submit")?.addEventListener("click", submitCreate);
    form.querySelector("#goal-create-cancel")?.addEventListener("click", hideCreate);
    form.querySelector("#goal-create-input")?.addEventListener("keydown", (e: Event) => {
      const ke = e as KeyboardEvent;
      if (ke.key === "Enter") submitCreate();
      if (ke.key === "Escape") hideCreate();
    });

    // Populate areas dropdown
    const areaSelect = form.querySelector("#goal-create-area") as HTMLSelectElement;
    fetch((window.__ingress_path || "") + "/api/areas")
      .then((r) => r.ok ? r.json() : null)
      .then((data) => {
        if (!data) return;
        const areas = data.areas ?? [];
        (areas as Array<{ id: string; name: string; icon: string }>).forEach((a) => {
          const opt = document.createElement("option");
          opt.value = a.id;
          opt.textContent = `${a.icon} ${a.name}`;
          areaSelect.appendChild(opt);
        });
      })
      .catch(() => {});

    return form;
  }

  function showCreate() {
    const form = ensureCreateForm();
    form.style.display = "block";
    formVisible = true;
    requestAnimationFrame(() => {
      (form.querySelector("#goal-create-input") as HTMLInputElement)?.focus();
    });
  }

  function hideCreate() {
    const form = document.getElementById("goal-create-inline");
    if (form) {
      form.style.display = "none";
      (form.querySelector("#goal-create-input") as HTMLInputElement).value = "";
      (form.querySelector("#goal-create-area") as HTMLSelectElement).value = "";
    }
    formVisible = false;
  }

  function submitCreate() {
    const input = document.getElementById("goal-create-input") as HTMLInputElement | null;
    const areaSelect = document.getElementById("goal-create-area") as HTMLSelectElement | null;
    const title = input?.value?.trim();
    if (!title) {
      input?.focus();
      return;
    }

    const submitBtn = document.getElementById("goal-create-submit") as HTMLButtonElement;
    submitBtn.disabled = true;
    submitBtn.textContent = "Creating…";

    const payload: Record<string, string> = { title };
    const areaId = areaSelect?.value;
    if (areaId) payload.area_id = areaId;

    fetch((window.__ingress_path || "") + "/api/goals", {
      method: "POST",
      headers: { "content-type": "application/json" },
      body: JSON.stringify(payload),
    })
      .then((r) => {
        if (r.ok) return r.json();
        throw new Error("Failed");
      })
      .then(() => {
        window.location.reload();
      })
      .catch(() => {
        submitBtn.disabled = false;
        submitBtn.textContent = "Create";
        input?.focus();
        const form = document.getElementById("goal-create-inline");
        if (form && !form.querySelector(".create-form-error")) {
          const err = document.createElement("span");
          err.className = "create-form-error";
          err.textContent = "Failed to create goal. Try again.";
          form.querySelector(".create-form-inner")?.appendChild(err);
          setTimeout(() => err.remove(), 3000);
        }
      });
  }

  createBtn?.addEventListener("click", () => formVisible ? hideCreate() : showCreate());
  emptyBtn?.addEventListener("click", () => formVisible ? hideCreate() : showCreate());

  // --- Goal card actions (delegated) ---
  document.querySelector(".goal-list")?.addEventListener("click", async (e: Event) => {
    const target = e.target as HTMLElement;
    const btn = target.closest<HTMLButtonElement>(".goal-action-btn");
    if (!btn) return;

    const goalId = btn.dataset.goalId;
    if (!goalId) return;

    const base = (window.__ingress_path || "") + `/api/goals/${goalId}`;

    // Delete
    if (btn.classList.contains("goal-delete-btn")) {
      if (!confirm("Delete this goal? This cannot be undone.")) return;
      btn.disabled = true;
      try {
        const r = await fetch(base, { method: "DELETE" });
        if (r.ok) {
          const card = btn.closest(".goal-card");
          if (card) {
            card.classList.add("goal-card--removing");
            setTimeout(() => { card.remove(); updateCount(); }, 200);
          }
        }
      } catch { btn.disabled = false; }
      return;
    }

    // Complete
    if (btn.classList.contains("goal-complete-btn")) {
      btn.disabled = true;
      try {
        const r = await fetch(base, {
          method: "PUT",
          headers: { "content-type": "application/json" },
          body: JSON.stringify({ status: "completed" }),
        });
        if (r.ok) window.location.reload();
      } catch { btn.disabled = false; }
      return;
    }

    // Reactivate
    if (btn.classList.contains("goal-reactivate-btn")) {
      btn.disabled = true;
      try {
        const r = await fetch(base, {
          method: "PUT",
          headers: { "content-type": "application/json" },
          body: JSON.stringify({ status: "active" }),
        });
        if (r.ok) window.location.reload();
      } catch { btn.disabled = false; }
    }
  });

  function updateCount() {
    const countEl = document.querySelector(".goals-count");
    const remaining = document.querySelectorAll(".goal-card").length;
    if (countEl) countEl.textContent = `${remaining} goal${remaining !== 1 ? "s" : ""}`;
    // Show empty state if none left
    if (remaining === 0) window.location.reload();
  }
</script>
