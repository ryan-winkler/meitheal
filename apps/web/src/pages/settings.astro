---
import SettingsLabels from "../components/settings/SettingsLabels.astro"
import SettingsGeneral from "../components/settings/SettingsGeneral.astro"
import SettingsIntegrations from "../components/settings/SettingsIntegrations.astro"
import SettingsAgents from "../components/settings/SettingsAgents.astro"
import SettingsRules from "../components/settings/SettingsRules.astro"
import SettingsSectionIntro from "../components/settings/SettingsSectionIntro.astro"
import SettingsSystem from "../components/settings/SettingsSystem.astro"
import Layout from "../layouts/Layout.astro"
import { t } from "../i18n/translations"
import type { Locale } from "../lib/locale"
import { SETTINGS_SECTIONS } from "../lib/settings-registry"

const cookieLocale = Astro.cookies.get("meitheal-locale")?.value
const locale: Locale = cookieLocale === "ga" ? "ga" : "en"
const workflowSection = SETTINGS_SECTIONS.find((section) => section.id === "workflow-settings")!
const rulesSection = SETTINGS_SECTIONS.find((section) => section.id === "rules-lenses-settings")!
const integrationsSection = SETTINGS_SECTIONS.find((section) => section.id === "integrations-settings")!
const automationAiSection = SETTINGS_SECTIONS.find((section) => section.id === "automation-ai-settings")!
---

<Layout title={`Meitheal — ${t("settings.title", locale)}`}>
  <span slot="page-title">{t("settings.title", locale)}</span>

  <div id="settings-shell" class="settings-shell">
    <!-- Zendesk-style unified nav bar -->
    <section class="settings-shell__surface settings-shell__summary-surface" id="quick-jumps-surface">
      <div class="settings-shell__nav">
        <!-- Left: Section switcher dropdown -->
        <div class="settings-nav__switcher" id="settings-section-switcher">
          <button
            type="button"
            class="settings-nav__switcher-btn"
            id="settings-switcher-btn"
            aria-expanded="false"
            aria-haspopup="true"
            aria-label="Switch settings section"
          >
            <span class="settings-nav__switcher-icon" id="settings-switcher-icon" aria-hidden="true">🎨</span>
            <span class="settings-nav__switcher-label" id="settings-switcher-label">Personal</span>
            <svg class="settings-nav__switcher-chevron" width="12" height="12" viewBox="0 0 12 12" fill="currentColor" aria-hidden="true">
              <path d="M2.5 4.5L6 8L9.5 4.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" fill="none"/>
            </svg>
          </button>
          <div class="settings-nav__switcher-dropdown" id="settings-switcher-dropdown" role="menu" aria-label="Settings sections">
            {SETTINGS_SECTIONS.map((section) => (
              <button
                type="button"
                class="settings-nav__switcher-item"
                role="menuitem"
                data-section-id={section.id}
                data-section-icon={section.icon}
                data-section-label={section.label}
              >
                <span class="settings-nav__switcher-item-icon" aria-hidden="true">{section.icon}</span>
                <span class="settings-nav__switcher-item-label">{section.label}</span>
                <span class="settings-nav__switcher-item-status">{section.statusLabel}</span>
              </button>
            ))}
          </div>
        </div>

        <!-- Middle: Visible tab pills -->
        <div class="settings-nav__tabs" id="settings-nav-tabs">
          {SETTINGS_SECTIONS.map((section) => (
            <a
              class="settings-tab"
              href={`#${section.id}`}
              data-settings-section-link
              data-settings-summary={section.id}
              role="tab"
            >
              <span class="settings-tab__icon" aria-hidden="true">{section.icon}</span>
              <span class="settings-tab__label">{section.label}</span>
            </a>
          ))}
        </div>

        <!-- Right: Expandable search -->
        <div class="settings-nav__search" id="settings-nav-search">
          <button
            type="button"
            class="settings-nav__search-trigger"
            id="settings-search-trigger"
            aria-label="Search settings"
            aria-expanded="false"
            title="Search settings (/)"
          >
            <svg width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
              <circle cx="7" cy="7" r="5"/>
              <path d="M11 11L14 14" stroke-linecap="round"/>
            </svg>
          </button>
          <div class="settings-nav__search-expand" id="settings-search-expand">
            <input
              id="settings-search-input"
              class="settings-nav__search-input"
              type="search"
              placeholder="Search settings…"
              autocomplete="off"
            />
            <button
              id="settings-search-clear"
              class="settings-nav__search-clear"
              type="button"
              hidden
              aria-label="Clear search"
            >×</button>
          </div>
          <div
            id="settings-search-results"
            class="settings-search-results"
            role="listbox"
            hidden
            aria-live="polite"
          >
          </div>
        </div>
      </div>
    </section>

    <div class="settings-shell__content">

      <SettingsSystem locale={locale} />

      <section
        id="workflow-settings"
        class="settings-shell__section"
        data-settings-shell-section
      >
        <SettingsSectionIntro section={workflowSection} />
        <SettingsGeneral locale={locale} />
        <SettingsLabels locale={locale} />
      </section>

      <section
        id="rules-lenses-settings"
        class="settings-shell__section"
        data-settings-shell-section
      >
        <SettingsSectionIntro section={rulesSection} />
        <SettingsRules />
      </section>

      <section
        id="integrations-settings"
        class="settings-shell__section"
        data-settings-shell-section
      >
        <SettingsSectionIntro section={integrationsSection} />
        <SettingsIntegrations locale={locale} />
      </section>

      <section
        id="automation-ai-settings"
        class="settings-shell__section"
        data-settings-shell-section
      >
        <SettingsSectionIntro section={automationAiSection} />
        <SettingsAgents locale={locale} />
      </section>
    </div>
  </div>

  <button
    id="settings-go-top"
    class="settings-go-top"
    type="button"
    aria-label="Scroll to top"
    title="Back to top (Home key)"
    aria-keyshortcuts="Home"
    hidden
  >
    ↑
  </button>

  <div
    id="toast-container"
    class="toast-container"
    aria-live="polite"
    role="status"
    data-no-scroll-lock="true"
  >
  </div>

  <script>
    import "@lib/settings-page"
  </script>
</Layout>

  <style>
  .settings-shell {
    display: flex;
    flex-direction: column;
    gap: 20px;
  }
  .settings-shell:not(.is-detail-view) .settings-shell__layout,
  .settings-shell:not(.is-detail-view) .settings-shell__mobile-nav {
    display: none;
  }
  /* — Zendesk-style nav bar — */
  .settings-shell__nav {
    display: flex;
    align-items: center;
    gap: 6px;
    padding: 0 2px 2px 2px;
    min-height: 52px;
  }
  /* — Section Switcher (left) — */
  .settings-nav__switcher {
    position: relative;
    flex-shrink: 0;
  }
  .settings-nav__switcher-btn {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 8px 12px;
    min-height: 40px;
    border: 1px solid transparent;
    border-radius: 10px;
    background: transparent;
    color: var(--text-primary);
    font-size: 14px;
    font-weight: 700;
    cursor: pointer;
    white-space: nowrap;
    transition: background 160ms ease, border-color 160ms ease;
  }
  .settings-nav__switcher-btn:hover {
    background: var(--accent-6-bg);
    border-color: var(--border);
  }
  .settings-nav__switcher-btn[aria-expanded="true"] {
    background: var(--accent-6-bg);
    border-color: var(--accent-50-border);
  }
  .settings-nav__switcher-icon {
    font-size: 16px;
    line-height: 1;
  }
  .settings-nav__switcher-label {
    font-size: 14px;
    font-weight: 700;
  }
  .settings-nav__switcher-chevron {
    transition: transform 200ms ease;
    flex-shrink: 0;
    color: var(--text-secondary);
  }
  .settings-nav__switcher-btn[aria-expanded="true"] .settings-nav__switcher-chevron {
    transform: rotate(180deg);
  }
  /* — Switcher dropdown — */
  .settings-nav__switcher-dropdown {
    display: none;
    position: absolute;
    top: 100%;
    left: 0;
    margin-top: 4px;
    min-width: 240px;
    background: color-mix(in srgb, var(--bg-card) 97%, transparent);
    backdrop-filter: blur(16px);
    -webkit-backdrop-filter: blur(16px);
    border: 1px solid var(--border);
    border-radius: 12px;
    box-shadow: 0 8px 24px rgba(0,0,0,.18);
    padding: 4px;
    z-index: 50;
    animation: settings-dropdown-in 120ms ease-out;
  }
  .settings-nav__switcher-dropdown.is-open {
    display: flex;
    flex-direction: column;
  }
  .settings-nav__switcher-item {
    display: flex;
    align-items: center;
    gap: 10px;
    width: 100%;
    padding: 10px 14px;
    border: none;
    border-radius: 8px;
    background: transparent;
    color: var(--text-secondary);
    font-size: 13px;
    font-weight: 600;
    cursor: pointer;
    text-align: left;
    white-space: nowrap;
    transition: background 120ms ease, color 120ms ease;
  }
  .settings-nav__switcher-item:hover {
    background: var(--accent-6-bg);
    color: var(--text-primary);
  }
  .settings-nav__switcher-item.is-active {
    background: var(--accent-12-bg);
    color: var(--accent);
  }
  .settings-nav__switcher-item-icon {
    font-size: 15px;
    line-height: 1;
    flex-shrink: 0;
  }
  .settings-nav__switcher-item-label {
    flex: 1 1 auto;
  }
  .settings-nav__switcher-item-status {
    font-size: 11px;
    color: var(--text-muted);
    flex-shrink: 0;
  }
  /* — Visible tab pills (middle) — */
  .settings-nav__tabs {
    display: flex;
    gap: 4px;
    flex: 1 1 auto;
    overflow: hidden;
    align-items: center;
  }
  /* — Expandable search (right) — */
  .settings-nav__search {
    position: relative;
    display: flex;
    align-items: center;
    flex-shrink: 0;
  }
  .settings-nav__search-trigger {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 40px;
    height: 40px;
    border: 1px solid transparent;
    border-radius: 10px;
    background: transparent;
    color: var(--text-secondary);
    cursor: pointer;
    transition: background 160ms ease, border-color 160ms ease, color 160ms ease;
    flex-shrink: 0;
  }
  .settings-nav__search-trigger:hover {
    background: var(--accent-6-bg);
    border-color: var(--border);
    color: var(--text-primary);
  }
  .settings-nav__search-trigger[aria-expanded="true"] {
    background: var(--accent-6-bg);
    border-color: var(--accent-50-border);
    color: var(--accent);
  }
  /* Hide search trigger icon when search is expanded */
  .settings-nav__search.is-expanded .settings-nav__search-trigger {
    display: none;
  }
  .settings-nav__search-expand {
    display: none;
    align-items: center;
    gap: 6px;
    animation: search-expand-in 200ms ease-out;
  }
  .settings-nav__search.is-expanded .settings-nav__search-expand {
    display: flex;
  }
  @keyframes search-expand-in {
    from { opacity: 0; width: 0; }
    to { opacity: 1; width: 240px; }
  }
  .settings-nav__search-input {
    width: 240px;
    height: 38px;
    padding: 0 12px;
    border: 1px solid var(--accent-50-border);
    border-radius: 10px;
    background: var(--bg-secondary);
    color: var(--text-primary);
    font-size: 13px;
    outline: none;
    transition: border-color 160ms ease, box-shadow 160ms ease;
  }
  .settings-nav__search-input:focus {
    border-color: var(--accent);
    box-shadow: 0 0 0 2px color-mix(in srgb, var(--accent) 20%, transparent);
  }
  .settings-nav__search-input::placeholder {
    color: var(--text-muted);
  }
  .settings-nav__search-clear {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 28px;
    height: 28px;
    border: 1px solid var(--border);
    border-radius: 8px;
    background: var(--bg-card);
    color: var(--text-secondary);
    font-size: 14px;
    cursor: pointer;
    flex-shrink: 0;
    transition: border-color 150ms ease, color 150ms ease;
  }
  .settings-nav__search-clear:hover {
    border-color: var(--accent-50-border);
    color: var(--text-primary);
  }
  /* — Search results dropdown — */
  .settings-search-results {
    display: none;
    flex-direction: column;
    gap: 4px;
    position: absolute;
    top: 100%;
    right: 0;
    margin-top: 4px;
    min-width: 320px;
    max-height: 340px;
    overflow-y: auto;
    background: color-mix(in srgb, var(--bg-card) 97%, transparent);
    backdrop-filter: blur(16px);
    -webkit-backdrop-filter: blur(16px);
    border: 1px solid var(--border);
    border-radius: 12px;
    box-shadow: 0 8px 24px rgba(0,0,0,.18);
    padding: 4px;
    z-index: 50;
    animation: settings-dropdown-in 120ms ease-out;
  }
  .settings-search-results:not([hidden]) {
    display: flex;
  }
  @keyframes settings-dropdown-in {
    from { opacity: 0; transform: translateY(-4px) scale(0.97); }
    to { opacity: 1; transform: translateY(0) scale(1); }
  }
  .settings-search-results__item {
    display: flex;
    flex-direction: column;
    gap: 4px;
    width: 100%;
    padding: 10px 12px;
    text-align: left;
    background: transparent;
    border: none;
    border-radius: 8px;
    color: var(--text-primary);
    cursor: pointer;
    transition: background 120ms ease, color 120ms ease;
  }
  .settings-search-results__item:hover,
  .settings-search-results__item.is-active {
    background: var(--accent-6-bg);
    color: var(--text-primary);
  }
  .settings-search-results__item.is-active {
    background: var(--accent-12-bg);
  }
  .settings-search-results__meta {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    align-items: center;
  }
  .settings-search-results__type,
  .settings-search-results__section {
    display: inline-flex;
    align-items: center;
    min-height: 20px;
    padding: 0 6px;
    border-radius: 999px;
    font-size: 10px;
    line-height: 1;
  }
  .settings-search-results__type {
    background: color-mix(in srgb, var(--accent) 12%, transparent);
    color: var(--accent);
  }
  .settings-search-results__section {
    background: var(--bg-secondary);
    color: var(--text-muted);
  }
  .settings-search-results__description,
  .settings-search-results__empty {
    font-size: 12px;
    color: var(--text-muted);
    line-height: 1.55;
  }
  .settings-search-results__empty {
    padding: 12px;
    text-align: center;
  }
  /* — Responsive: mobile — */
  @media (max-width: 640px) {
    .settings-nav__tabs {
      display: none;
    }
    .settings-nav__search-input {
      width: 180px;
    }
    .settings-nav__switcher-label {
      display: none; /* icon-only on small screens */
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .settings-nav__switcher-chevron,
    .settings-nav__search-expand,
    .settings-nav__switcher-dropdown,
    .settings-search-results {
      animation: none;
      transition: none;
    }
  }
  .settings-shell__summary-surface {
    position: sticky;
    top: 0;
    z-index: 10;
    background: var(--bg-main);
    padding: 6px 0;
    border-bottom: 1px solid var(--border);
  }
  /* JS-driven fixed mode for HA ingress where CSS sticky fails */
  .settings-shell__summary-surface.is-fixed {
    z-index: 35;
    background: color-mix(in srgb, var(--bg-main) 95%, transparent);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    padding: 6px 16px;
    box-shadow: 0 1px 4px rgba(0,0,0,.15);
  }
  /* — Color-mix CSS custom properties (pre-computed for paint perf) — */
  :root {
    --accent-6-bg: color-mix(in srgb, var(--bg-card) 80%, var(--accent) 6%);
    --accent-10: color-mix(in srgb, var(--accent) 10%, transparent);
    --accent-12-bg: color-mix(in srgb, var(--accent) 12%, var(--bg-card));
    --accent-20: color-mix(in srgb, var(--accent) 20%, transparent);
    --accent-50-border: color-mix(in srgb, var(--accent) 50%, var(--border));
    --accent-78-white: color-mix(in srgb, var(--accent) 78%, white);
  }
  /* — Tab items —
   * Uses :global() because tabs live in SettingsSummaryCard.astro
   * (child component), but styles need to be owned by the parent
   * settings.astro to maintain the unified tab bar layout. #33 */
  :global(.settings-tab) {
    display: flex;
    align-items: center;
    gap: 7px;
    padding: 10px 16px;
    min-height: 44px;
    border: 1px solid transparent;
    border-radius: 10px;
    background: transparent;
    color: var(--text-secondary);
    text-decoration: none;
    white-space: nowrap;
    font-size: 13px;
    font-weight: 600;
    cursor: pointer;
    flex-shrink: 0;
    transition:
      background 160ms ease,
      border-color 160ms ease,
      color 160ms ease,
      box-shadow 160ms ease,
      transform 160ms ease;
  }
  :global(.settings-tab:hover) {
    background: var(--accent-6-bg);
    border-color: var(--border);
    color: var(--text-primary);
    transform: translateY(-1px);
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.08);
  }
  :global(.settings-tab.is-active) {
    background: var(--accent-12-bg);
    border-color: var(--accent-50-border);
    color: var(--accent);
    box-shadow: 0 0 0 1px var(--accent-10);
  }
  :global(.settings-tab:focus-visible) {
    outline: 2px solid var(--accent-78-white);
    outline-offset: 2px;
  }
  :global(.settings-tab__icon) {
    font-size: 15px;
    line-height: 1;
    flex-shrink: 0;
  }
  :global(.settings-tab__label) {
    font-size: 13px;
    font-weight: 600;
  }
  :global(.settings-tab__status) {
    display: inline-flex;
    align-items: center;
    min-height: 18px;
    padding: 0 6px;
    border-radius: 999px;
    background: color-mix(in srgb, var(--accent) 18%, transparent); /* #23: bump from 10% for contrast */
    color: var(--accent);
    font-size: 10px;
    font-weight: 600;
    letter-spacing: 0.03em;
    white-space: nowrap;
    text-align: center;
    justify-content: center;
  }
  :global(.settings-tab.is-active .settings-tab__status) {
    background: var(--accent-20);
  }
  @media (prefers-reduced-motion: reduce) {
    :global(.settings-tab) {
      transition: none;
    }
    :global(.settings-tab:hover) {
      transform: none;
    }
  }
  /* — Icon-only tabs on narrow viewports (HA Companion phone) — */
  @media (max-width: 480px) {
    :global(.settings-tab__label) {
      display: none;
    }
    :global(.settings-tab) {
      padding: 10px 12px;
    }
    :global(.settings-tab__icon) {
      font-size: 18px;
    }
  }
  /* — Deep-link landing flash — */
  @keyframes settings-landing-pulse {
    0% { box-shadow: 0 0 0 0 color-mix(in srgb, var(--accent) 30%, transparent); }
    50% { box-shadow: 0 0 0 4px color-mix(in srgb, var(--accent) 15%, transparent); }
    100% { box-shadow: 0 0 0 0 transparent; }
  }
  :global(.settings-landing-flash) {
    animation: settings-landing-pulse 1.2s ease-out;
  }
  @media (prefers-reduced-motion: reduce) {
    :global(.settings-landing-flash) {
      animation: none;
    }
  }
  .settings-shell__content {
    display: flex;
    flex-direction: column;
    gap: 32px;
    max-width: 1200px;
    margin: 0 auto;
    width: 100%;
  }
  .settings-shell__section {
    display: flex;
    flex-direction: column;
    gap: 16px;
    scroll-margin-top: calc(var(--settings-tab-bar-h, 52px) + 16px); /* #9: dynamic, accommodates tab bar height */
    padding-bottom: 32px;
    border-bottom: 1px solid color-mix(in srgb, var(--border) 50%, transparent);
  }
  .settings-shell__section:last-child {
    border-bottom: none;
    padding-bottom: 0;
  }
  :global(.settings-shell__section--nested) {
    border-bottom: none;
    padding-bottom: 0;
  }
  .settings-shell__section--muted {
    opacity: 0.42;
    filter: saturate(0.8);
  }
  /* — Go to top FAB — */
  .settings-go-top {
    position: fixed;
    bottom: calc(28px + env(safe-area-inset-bottom, 0px));
    right: 28px;
    z-index: 50;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 42px;
    height: 42px;
    border: 1px solid var(--border);
    border-radius: 12px;
    background: var(--bg-card);
    color: var(--text-secondary);
    font-size: 18px;
    cursor: pointer;
    box-shadow:
      0 4px 16px rgba(0, 0, 0, 0.3),
      0 0 0 1px color-mix(in srgb, var(--accent) 8%, transparent);
    opacity: 0;
    transform: translateY(8px);
    will-change: transform, opacity;
    transition:
      opacity 200ms ease,
      transform 200ms ease,
      background 160ms ease,
      border-color 160ms ease;
    pointer-events: none;
  }
  .settings-go-top.is-visible {
    opacity: 1;
    transform: translateY(0);
    pointer-events: auto;
  }
  .settings-go-top:hover {
    background: var(--accent-12-bg);
    border-color: var(--accent-50-border);
    color: var(--accent);
  }
  .settings-go-top:focus-visible {
    outline: 2px solid var(--accent-78-white);
    outline-offset: 2px;
  }
  @media (prefers-reduced-motion: reduce) {
    .settings-go-top {
      transition: none;
      will-change: auto;
    }
  }
  .settings-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(360px, 100%), 1fr));
    gap: 16px;
  }
  .custom-field-row {
    display: flex;
    gap: 8px;
    align-items: center;
    padding: 10px 0;
    border-bottom: 1px solid var(--border);
  }
  .custom-field-row .form-input,
  .custom-field-row .form-select {
    padding: 6px 10px;
    font-size: 13px;
  }
  .custom-field-row:last-child {
    border-bottom: none;
  }
  .integration-section {
    border-bottom: 1px solid var(--border);
    padding: 16px 0;
  }
  .integration-section:last-child {
    border-bottom: none;
  }
  .integration-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 12px;
    margin-bottom: 12px;
  }
  .integration-desc {
    font-size: 12px;
    color: var(--text-muted);
    margin-top: 4px;
