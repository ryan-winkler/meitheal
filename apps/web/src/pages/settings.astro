---
import SettingsLabels from "../components/settings/SettingsLabels.astro"
import SettingsGeneral from "../components/settings/SettingsGeneral.astro"
import SettingsIntegrations from "../components/settings/SettingsIntegrations.astro"
import SettingsAgents from "../components/settings/SettingsAgents.astro"
import SettingsRules from "../components/settings/SettingsRules.astro"
import SettingsCallout from "../components/settings/SettingsCallout.astro"
import SettingsSectionIntro from "../components/settings/SettingsSectionIntro.astro"
import SettingsShellNav from "../components/settings/SettingsShellNav.astro"
import SettingsSummaryCard from "../components/settings/SettingsSummaryCard.astro"
import SettingsSystem from "../components/settings/SettingsSystem.astro"
import Layout from "../layouts/Layout.astro"
import { t } from "../i18n/translations"
import type { Locale } from "../lib/locale"
import { SETTINGS_SECTIONS } from "../lib/settings-registry"

const cookieLocale = Astro.cookies.get("meitheal-locale")?.value
const locale: Locale = cookieLocale === "ga" ? "ga" : "en"
const workflowSection = SETTINGS_SECTIONS.find((section) => section.id === "workflow-settings")!
const rulesSection = SETTINGS_SECTIONS.find((section) => section.id === "rules-lenses-settings")!
const integrationsSection = SETTINGS_SECTIONS.find((section) => section.id === "integrations-settings")!
const automationAiSection = SETTINGS_SECTIONS.find((section) => section.id === "automation-ai-settings")!
---

<Layout title={`Meitheal — ${t("settings.title", locale)}`}>
  <span slot="page-title">{t("settings.title", locale)}</span>

  <div id="settings-shell" class="settings-shell">
    <section class="card settings-shell__hero">
      <div class="settings-shell__hero-copy">
        <span class="settings-shell__eyebrow">Home Assistant-native settings</span>
        <h2 class="settings-shell__title">Personal, workflow, and platform controls in one place</h2>
        <p class="settings-shell__description">
          Search for a setting, jump directly to a section, and keep companion,
          PWA, and integration actions ingress-safe with hash links.
        </p>
      </div>

      <div class="settings-shell__search">
        <label class="form-label" for="settings-search-input">Find a setting</label>
        <div class="settings-shell__search-input-row">
          <input
            id="settings-search-input"
            class="form-input"
            type="search"
            placeholder="Theme, labels, calendar sync, companion links…"
            autocomplete="off"
          />
          <button
            id="settings-search-clear"
            class="settings-shell__search-clear"
            type="button"
            hidden
          >
            Clear
          </button>
        </div>
        <p class="settings-shell__search-hint">
          Search by section, setting, or integration. Press <kbd>Enter</kbd> to jump and
          <kbd>Esc</kbd> to reset.
        </p>
        <div
          id="settings-search-results"
          class="settings-search-results"
          role="listbox"
          hidden
          aria-live="polite"
        >
        </div>
      </div>
    </section>

    <section class="settings-shell__surface settings-shell__summary-surface">
      <div class="settings-shell__surface-header">
        <div>
          <span class="settings-shell__surface-eyebrow">Quick jumps</span>
          <h2>Live status and fast navigation</h2>
        </div>
        <p>Open the section you need without scanning every settings card first.</p>
      </div>
      <div class="settings-shell__summary">
        {SETTINGS_SECTIONS.map((section) => (
          <SettingsSummaryCard section={section} />
        ))}
      </div>
    </section>

    <section class="settings-shell__mobile-nav settings-shell__surface">
      <div class="settings-shell__surface-header settings-shell__surface-header--compact">
        <div>
          <span class="settings-shell__surface-eyebrow">Section picker</span>
          <h2>Move between settings on smaller screens</h2>
        </div>
      </div>
      <SettingsShellNav sections={SETTINGS_SECTIONS} variant="mobile" />
    </section>

    <div class="settings-shell__layout">
      <aside class="settings-shell__sidebar">
        <div class="settings-shell__sidebar-sticky">
          <a href="#" class="btn btn-ghost" style="margin-bottom: 8px; justify-content: flex-start; gap: 8px; width: 100%;" id="settings-home-btn">
            <span style="font-size: 16px;">←</span> Settings Home
          </a>
          <section class="settings-shell__surface settings-shell__surface--sidebar">
            <div class="settings-shell__surface-header settings-shell__surface-header--compact">
              <div>
                <span class="settings-shell__surface-eyebrow">Directory</span>
                <h2>Persistent settings rail</h2>
              </div>
            </div>
            <SettingsShellNav sections={SETTINGS_SECTIONS} />
          </section>
          <SettingsCallout title="Ingress-safe navigation" icon="🏠">
            All jumps stay hash-based so Settings remains inside the Home Assistant
            iframe, companion webview, and PWA scope.
          </SettingsCallout>
        </div>
      </aside>

      <div class="settings-shell__content">
        <section
          id="workflow-settings"
          class="settings-shell__section"
          data-settings-shell-section
        >
          <SettingsSectionIntro section={workflowSection} />
          <SettingsGeneral locale={locale} />
          <SettingsLabels locale={locale} />
        </section>

        <section
          id="rules-lenses-settings"
          class="settings-shell__section"
          data-settings-shell-section
        >
          <SettingsSectionIntro section={rulesSection} />
          <SettingsRules />
        </section>

        <section
          id="integrations-settings"
          class="settings-shell__section"
          data-settings-shell-section
        >
          <SettingsSectionIntro section={integrationsSection} />
          <SettingsIntegrations locale={locale} />
        </section>

        <section
          id="automation-ai-settings"
          class="settings-shell__section"
          data-settings-shell-section
        >
          <SettingsSectionIntro section={automationAiSection} />
          <SettingsAgents locale={locale} />
        </section>

        <SettingsSystem locale={locale} />
      </div>
    </div>
  </div>

  <div
    id="toast-container"
    class="toast-container"
    aria-live="polite"
    role="status"
    data-no-scroll-lock="true"
  >
  </div>

  <script>
    import "@lib/settings-page"
  </script>
</Layout>

  <style>
  .settings-shell {
    display: flex;
    flex-direction: column;
    gap: 20px;
  }
  .settings-shell:not(.is-detail-view) .settings-shell__layout,
  .settings-shell:not(.is-detail-view) .settings-shell__mobile-nav {
    display: none;
  }
  .settings-shell.is-detail-view .settings-shell__hero,
  .settings-shell.is-detail-view .settings-shell__search {
    display: none;
  }
  .settings-shell__hero {
    display: grid;
    grid-template-columns: minmax(0, 1.35fr) minmax(320px, 0.95fr);
    gap: 20px;
    padding: 24px;
    border-radius: 22px;
    background:
      radial-gradient(circle at top left, color-mix(in srgb, var(--accent) 18%, transparent), transparent 35%),
      linear-gradient(135deg, color-mix(in srgb, var(--bg-card) 92%, white), var(--bg-card));
  }
  .settings-shell__hero-copy {
    display: flex;
    flex-direction: column;
    gap: 10px;
  }
  .settings-shell__eyebrow {
    display: inline-flex;
    width: fit-content;
    padding: 6px 10px;
    border-radius: 999px;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--accent);
    background: color-mix(in srgb, var(--accent) 14%, transparent);
  }
  .settings-shell__title {
    margin: 0;
    font-size: clamp(1.8rem, 3vw, 2.5rem);
    line-height: 1.05;
  }
  .settings-shell__description {
    margin: 0;
    max-width: 62ch;
    color: var(--text-secondary);
    font-size: 14px;
    line-height: 1.6;
  }
  .settings-shell__search {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 10px;
    padding: 18px;
    border: 1px solid color-mix(in srgb, var(--border) 75%, var(--accent));
    border-radius: 18px;
    background: color-mix(in srgb, var(--bg-secondary) 92%, transparent);
  }
  .settings-shell__search-input-row {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: 10px;
    align-items: center;
  }
  .settings-shell__search-clear {
    min-height: 42px;
    padding: 0 14px;
    border: 1px solid var(--border);
    border-radius: 12px;
    background: var(--bg-card);
    color: var(--text-secondary);
    font-size: 12px;
    cursor: pointer;
    transition: border-color 150ms ease, color 150ms ease, background 150ms ease;
  }
  .settings-shell__search-clear:hover,
  .settings-shell__search-clear:focus-visible {
    border-color: color-mix(in srgb, var(--accent) 75%, var(--border));
    color: var(--text-primary);
  }
  .settings-shell__search-hint {
    margin: -2px 0 0;
    color: var(--text-muted);
    font-size: 12px;
    line-height: 1.5;
  }
  .settings-search-results {
    display: flex;
    flex-direction: column;
    gap: 8px;
    max-height: 280px;
    overflow-y: auto;
  }
  .settings-search-results__item {
    display: flex;
    flex-direction: column;
    gap: 4px;
    width: 100%;
    padding: 12px 14px;
    text-align: left;
    background: var(--bg-card);
    border: 1px solid var(--border);
    border-radius: 14px;
    color: var(--text-primary);
    cursor: pointer;
    transition: transform 150ms ease, border-color 150ms ease, background 150ms ease;
  }
  .settings-search-results__item.is-active {
    border-color: color-mix(in srgb, var(--accent) 78%, var(--border));
    background: color-mix(in srgb, var(--bg-card) 82%, var(--accent) 10%);
    box-shadow: 0 10px 24px rgba(5, 10, 25, 0.12);
  }
  .settings-search-results__item:hover {
    transform: translateY(-1px);
    border-color: var(--accent);
    background: color-mix(in srgb, var(--bg-card) 82%, var(--accent) 8%);
  }
  .settings-search-results__meta {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    align-items: center;
  }
  .settings-search-results__type,
  .settings-search-results__section {
    display: inline-flex;
    align-items: center;
    min-height: 22px;
    padding: 0 8px;
    border-radius: 999px;
    font-size: 11px;
    line-height: 1;
  }
  .settings-search-results__type {
    background: color-mix(in srgb, var(--accent) 12%, transparent);
    color: var(--accent);
  }
  .settings-search-results__section {
    background: var(--bg-secondary);
    color: var(--text-muted);
  }
  .settings-search-results__description,
  .settings-search-results__empty {
    font-size: 12px;
    color: var(--text-muted);
    line-height: 1.55;
  }
  .settings-search-results__empty {
    padding: 14px;
    border: 1px dashed var(--border);
    border-radius: 14px;
    background: color-mix(in srgb, var(--bg-card) 78%, transparent);
  }
  .settings-shell__surface {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }
  .settings-shell__surface--sidebar {
    gap: 10px;
  }
  .settings-shell__surface-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    gap: 16px;
  }
  .settings-shell__surface-header h2 {
    margin: 2px 0 0;
    font-size: 18px;
  }
  .settings-shell__surface-header p {
    margin: 0;
    max-width: 44ch;
    color: var(--text-muted);
    font-size: 13px;
    line-height: 1.55;
  }
  .settings-shell__surface-header--compact h2 {
    font-size: 15px;
  }
  .settings-shell__surface-eyebrow {
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--accent);
  }
  .settings-shell__summary {
    display: grid;
    grid-template-columns: repeat(6, minmax(0, 1fr));
    gap: 12px;
  }
  .settings-summary-card {
    display: flex;
    flex-direction: column;
    gap: 6px;
    min-height: 108px;
    padding: 16px;
    border: 1px solid var(--border);
    border-radius: 18px;
    background: var(--bg-card);
    color: inherit;
    text-decoration: none;
    transition:
      transform 150ms ease,
      border-color 150ms ease,
      background 150ms ease,
      box-shadow 150ms ease;
  }
  .settings-summary-card:hover,
  .settings-summary-card.is-active,
  .settings-summary-card:focus-visible {
    transform: translateY(-1px);
    border-color: color-mix(in srgb, var(--accent) 75%, var(--border));
    background: color-mix(in srgb, var(--bg-card) 90%, var(--accent) 9%);
    box-shadow: 0 12px 28px rgba(5, 10, 25, 0.16);
  }
  .settings-summary-card:focus-visible {
    outline: 2px solid color-mix(in srgb, var(--accent) 78%, white);
    outline-offset: 2px;
  }
  .settings-summary-card__meta,
  .settings-summary-card__eyebrow-wrap {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 10px;
  }
  .settings-summary-card__eyebrow-wrap {
    justify-content: flex-start;
  }
  .settings-summary-card__icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 28px;
    height: 28px;
    border-radius: 10px;
    background: color-mix(in srgb, var(--accent) 14%, transparent);
    font-size: 15px;
  }
  .settings-summary-card__eyebrow {
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--text-muted);
  }
  .settings-summary-card__title {
    font-size: 15px;
  }
  .settings-summary-card__detail {
    color: var(--text-secondary);
    font-size: 13px;
    line-height: 1.45;
  }
  .settings-summary-card__jump {
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--accent);
  }
  .settings-shell__layout {
    display: grid;
    grid-template-columns: 300px minmax(0, 1fr);
    gap: 20px;
    align-items: start;
  }
  .settings-shell__mobile-nav {
    display: none;
  }
  .settings-shell__sidebar-sticky {
    position: sticky;
    top: 88px;
    display: flex;
    flex-direction: column;
    gap: 12px;
  }
  .settings-shell-nav__list {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }
  .settings-shell-nav__link {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr) auto;
    gap: 12px;
    align-items: start;
    padding: 12px 14px;
    border: 1px solid var(--border);
    border-radius: 16px;
    background: var(--bg-card);
    color: inherit;
    text-decoration: none;
    transition: transform 150ms ease, border-color 150ms ease, background 150ms ease;
  }
  .settings-shell-nav__link:hover,
  .settings-shell-nav__link.is-active {
    transform: translateY(-1px);
    border-color: color-mix(in srgb, var(--accent) 75%, var(--border));
    background: color-mix(in srgb, var(--bg-card) 88%, var(--accent) 8%);
  }
  .settings-shell-nav__icon {
    font-size: 18px;
    line-height: 1;
    padding-top: 2px;
  }
  .settings-shell-nav__content {
    display: flex;
    flex-direction: column;
    gap: 3px;
    min-width: 0;
  }
  .settings-shell-nav__content small {
    color: var(--text-muted);
    font-size: 12px;
    line-height: 1.45;
  }
  .settings-shell-nav__meta {
    display: inline-flex;
    flex-direction: column;
    align-items: flex-end;
    gap: 6px;
  }
  .settings-shell-nav__jump {
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--accent);
  }
  .settings-shell__content {
    display: flex;
    flex-direction: column;
    gap: 20px;
  }
  .settings-shell__section {
    display: flex;
    flex-direction: column;
    gap: 16px;
    scroll-margin-top: 88px;
  }
  .settings-shell__section--muted {
    opacity: 0.42;
    filter: saturate(0.8);
  }
  .settings-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(400px, 1fr));
    gap: 16px;
  }
  .custom-field-row {
    display: flex;
    gap: 6px;
    align-items: center;
    padding: 4px 0;
    border-bottom: 1px solid var(--border);
  }
  .custom-field-row .form-input,
  .custom-field-row .form-select {
    padding: 4px 8px;
    font-size: 13px;
  }
  .custom-field-row:last-child {
    border-bottom: none;
  }
  .integration-section {
    border-bottom: 1px solid var(--border);
    padding: 16px 0;
  }
  .integration-section:last-child {
    border-bottom: none;
  }
  .integration-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 12px;
    margin-bottom: 12px;
  }
  .integration-desc {
    font-size: 12px;
    color: var(--text-muted);
    margin-top: 4px;
    line-height: 1.4;
  }
  .integration-config {
    padding-left: 8px;
    border-left: 2px solid var(--border);
    margin-left: 4px;
  }
  .shortcut-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 8px;
  }
  .shortcut-row {
    display: flex;
    gap: 12px;
    align-items: center;
    font-size: 13px;
  }
  kbd {
    background: var(--bg-hover);
    border: 1px solid var(--border);
    border-radius: 4px;
    padding: 2px 8px;
    font-family: "JetBrains Mono", monospace;
    font-size: 12px;
    color: var(--text-primary);
  }
  .badge {
    display: inline-block;
    padding: 3px 10px;
    border-radius: 12px;
    font-size: 12px;
    font-weight: 500;
  }
  .badge-active {
    background: rgba(99, 102, 241, 0.15);
    color: var(--accent);
  }
  .badge-pending {
    background: rgba(107, 114, 128, 0.15);
    color: var(--text-muted);
  }
  .framework-row {
    padding: 10px 0;
    border-bottom: 1px solid var(--border);
  }
  .framework-row:last-child {
    border-bottom: none;
  }
  .framework-info {
    display: flex;
    gap: 12px;
    align-items: center;
  }
  .framework-desc {
    font-size: 12px;
    color: var(--text-muted);
    margin-top: 2px;
  }
  .toggle-label {
    position: relative;
    display: inline-block;
    width: 40px;
    height: 22px;
    flex-shrink: 0;
    cursor: pointer;
  }
  .toggle-label input {
    opacity: 0;
    width: 0;
    height: 0;
  }
  .toggle-slider {
    position: absolute;
    inset: 0;
    background: var(--bg-hover);
    border: 1px solid var(--border);
    border-radius: 11px;
    transition: all 200ms;
  }
  .toggle-slider::before {
    content: "";
    position: absolute;
    width: 16px;
    height: 16px;
    left: 2px;
    bottom: 2px;
    background: var(--text-muted);
    border-radius: 50%;
    transition: all 200ms;
  }
  .toggle-label input:checked + .toggle-slider {
    background: var(--accent);
    border-color: var(--accent);
  }
  .toggle-label input:checked + .toggle-slider::before {
    transform: translateX(18px);
    background: white;
  }
  @media (max-width: 1120px) {
    .settings-shell__summary {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
    .settings-shell__layout {
      grid-template-columns: 1fr;
    }
    .settings-shell__sidebar {
      display: none;
    }
    .settings-shell__mobile-nav {
      display: block;
    }
    .settings-shell__mobile-nav .settings-shell-nav__list {
      flex-direction: row;
      overflow-x: auto;
      gap: 10px;
      padding-bottom: 6px;
      scroll-snap-type: x proximity;
    }
    .settings-shell__mobile-nav .settings-shell-nav__link {
      min-width: 200px;
      grid-template-columns: 1fr;
      gap: 8px;
      scroll-snap-align: start;
    }
    .settings-shell__mobile-nav .settings-shell-nav__icon {
      padding-top: 0;
      font-size: 20px;
    }
    .settings-shell__mobile-nav .settings-shell-nav__meta {
      align-items: flex-start;
      justify-content: space-between;
      flex-direction: row;
    }
  }
  @media (max-width: 768px) {
    .settings-shell__hero {
      grid-template-columns: 1fr;
      padding: 18px;
    }
    .settings-shell__surface-header {
      flex-direction: column;
      align-items: flex-start;
    }
    .settings-shell__summary {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
    .settings-grid {
      grid-template-columns: 1fr;
    }
    .shortcut-grid {
      grid-template-columns: 1fr;
    }
  }
  @media (max-width: 560px) {
    .settings-shell__summary {
      grid-template-columns: 1fr;
    }
    .settings-shell__mobile-nav .settings-shell-nav__link {
      min-width: 180px;
    }
    .settings-shell__search-input-row {
      grid-template-columns: 1fr;
    }
  }
</style>
