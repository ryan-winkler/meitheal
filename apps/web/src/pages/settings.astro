---
import SettingsLabels from "../components/settings/SettingsLabels.astro"
import SettingsGeneral from "../components/settings/SettingsGeneral.astro"
import SettingsIntegrations from "../components/settings/SettingsIntegrations.astro"
import SettingsAgents from "../components/settings/SettingsAgents.astro"
import SettingsAgentTokens from "../components/settings/SettingsAgentTokens.astro"
import SettingsRules from "../components/settings/SettingsRules.astro"
import SettingsPersonal from "../components/settings/SettingsPersonal.astro"
import SettingsAppPwa from "../components/settings/SettingsAppPwa.astro"
import SettingsDangerZone from "../components/settings/SettingsDangerZone.astro"
import SettingsSectionIntro from "../components/settings/SettingsSectionIntro.astro"
import SettingsShellNav from "../components/settings/SettingsShellNav.astro"
import Layout from "../layouts/Layout.astro"
import { t } from "../i18n/translations"
import type { Locale } from "../lib/locale"
import { issueDatabaseDownloadToken } from "../lib/database-download-token"
import { SETTINGS_SECTIONS } from "../lib/settings-registry"
import { verifiedIngressUser } from "../lib/verified-ingress-user"

const user = verifiedIngressUser(Astro.locals)
const databaseDownloadToken = user?.isAdmin ? issueDatabaseDownloadToken(user.id) : undefined
if (databaseDownloadToken) Astro.response.headers.set("Cache-Control", "private, no-store")
const cookieLocale = Astro.cookies.get("meitheal-locale")?.value
const locale: Locale = cookieLocale === "ga" ? "ga" : "en"
const workflowSection = SETTINGS_SECTIONS.find((section) => section.id === "workflow-settings")!
const rulesSection = SETTINGS_SECTIONS.find((section) => section.id === "rules-lenses-settings")!
const automationAiSection = SETTINGS_SECTIONS.find((section) => section.id === "automation-ai-settings")!
const integrationsSection = SETTINGS_SECTIONS.find((section) => section.id === "integrations-settings")!
---

<Layout title={`Meitheal — ${t("settings.title", locale)}`}>
  <header id="settings-bar" class="settings-bar" data-search-scope="settings" slot="custom-header">
    <h1 tabindex="-1">{t("settings.title", locale)}</h1>
    <div class="settings-bar__actions">
      <button type="button" id="settings-sections-toggle" aria-expanded="true" aria-controls="settings-directory">
        {t("settings.sections", locale)} <span aria-hidden="true">▾</span>
      </button>
      <button type="button" id="settings-bar-search-launcher" aria-keyshortcuts="/" data-search-scope="settings">
        <svg aria-hidden="true" width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <circle cx="10" cy="10" r="6" /><path d="m15 15 5 5" />
        </svg>
        {t("settings.search", locale)} <kbd aria-hidden="true">/</kbd>
      </button>
    </div>
  </header>

  <div id="settings-shell" class="settings-shell">
    <span id="settings-scroll-marker" aria-hidden="true"></span>
    <SettingsShellNav sections={SETTINGS_SECTIONS} locale={locale} />

    <div class="settings-shell__content">
      <div id="settings-load-status" class="settings-load-status">
        <p id="settings-loading" role="status">{t("settings.loading", locale)}</p>
        <p id="settings-load-error" role="alert" hidden>{t("settings.load_error", locale)}</p>
        <button id="settings-load-retry" type="button" class="btn btn-secondary" hidden>{t("settings.retry", locale)}</button>
      </div>
      <div id="settings-panels" inert>


      <!-- 1. Personal -->
      <SettingsPersonal locale={locale} />

      <!-- 2. Workflow -->
      <section
        id="workflow-settings"
        class="settings-shell__section"
        data-settings-shell-section
        hidden
      >
        <SettingsSectionIntro section={workflowSection} />
        <SettingsGeneral locale={locale} />
        <SettingsLabels locale={locale} />
      </section>

      <!-- 3. Rules & Lenses -->
      <section
        id="rules-lenses-settings"
        class="settings-shell__section"
        data-settings-shell-section
        hidden
      >
        <SettingsSectionIntro section={rulesSection} />
        <SettingsRules locale={locale} />
      </section>

      <!-- 4. Automation & AI -->
      <section
        id="automation-ai-settings"
        class="settings-shell__section"
        data-settings-shell-section
        hidden
      >
        <SettingsSectionIntro section={automationAiSection} />
        <SettingsAgents locale={locale} />
        <SettingsAgentTokens />
      </section>

      <!-- 5. Integrations -->
      <section
        id="integrations-settings"
        class="settings-shell__section"
        data-settings-shell-section
        hidden
      >
        <SettingsSectionIntro section={integrationsSection} />
        <SettingsIntegrations locale={locale} />
      </section>

      <!-- 6. App & PWA -->
      <SettingsAppPwa locale={locale} databaseDownloadToken={databaseDownloadToken} />

      <!-- 7. Danger Zone -->
      <SettingsDangerZone locale={locale} />
      </div>
    </div>
  </div>

  <button id="settings-go-top" type="button" aria-label={t("settings.scroll_to_top", locale)} hidden>
    <span aria-hidden="true">↑</span>
  </button>

  <div
    id="toast-container"
    class="toast-container"
    aria-live="polite"
    role="status"
    data-no-scroll-lock="true"
  >
  </div>

  <script>
    import "@lib/settings-page"
  </script>
</Layout>

<style>
  :global(body:has(#settings-bar)) {
    overflow-x: clip;
    overflow-y: visible;
  }

  :global(.main-content:has(> #settings-bar)) {
    animation: none;
  }

  :global(#main-content:has(> #settings-shell)) {
    overflow: clip;
  }

  .settings-bar {
    position: sticky;
    inset-block-start: 0;
    z-index: 30;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 8px;
    min-height: 60px;
    padding: 8px clamp(12px, 3vw, 28px);
    background: var(--bg-primary);
    border-bottom: 1px solid var(--border);
  }

  .settings-bar h1 {
    margin: 0;
    font-size: clamp(1.125rem, 2vw, 1.375rem);
    font-weight: 650;
  }

  .settings-bar__actions {
    display: flex;
    gap: 6px;
  }

  .settings-bar button {
    display: inline-flex;
    gap: 6px;
    align-items: center;
    min-height: 44px;
    padding: 4px 10px;
    background: var(--bg-card);
    color: var(--text-primary);
    border: 1px solid var(--border);
    border-radius: 8px;
    font-size: 0.875rem;
    font-weight: 600;
    cursor: pointer;
  }

  .settings-bar button:hover,
  .settings-bar button[aria-expanded="true"] {
    background: var(--bg-hover);
  }

  .settings-bar button:focus-visible,
  .settings-shell :global(:focus-visible) {
    outline: 2px solid var(--border-focus);
    outline-offset: 2px;
  }

  .settings-bar kbd {
    margin-inline-start: 6px;
    padding-inline: 5px;
    border: 1px solid var(--border);
    border-radius: 4px;
    color: var(--text-secondary);
  }

  .settings-shell {
    position: relative;
    display: grid;
    grid-template-columns: clamp(180px, 20vw, 232px) minmax(0, 1fr);
    align-items: start;
    gap: clamp(16px, 2.5vw, 36px);
    max-width: 1280px;
    margin: 0 auto;
    padding: clamp(16px, 3vw, 32px) 0;
  }

  .settings-shell[data-directory-collapsed] {
    grid-template-columns: minmax(0, 1fr);
    max-width: 1040px;
  }

  .settings-shell {
    --accent-text: color-mix(in srgb, var(--accent) 40%, var(--text-primary));
    --text-muted: var(--text-secondary);
    --text-muted-rgb: var(--text-secondary-rgb);
  }

  #settings-scroll-marker {
    position: absolute;
    inset-block-start: 0;
    width: 1px;
    height: 400px;
    pointer-events: none;
  }

  #settings-go-top:not([hidden]) {
    position: fixed;
    inset-block-end: var(--floating-action-bottom, calc(28px + env(safe-area-inset-bottom, 0px)));
    inset-inline-end: 16px;
    z-index: 50;
    width: 44px;
    height: 44px;
    border: 1px solid var(--border);
    border-radius: 12px;
    background: var(--bg-card);
    color: var(--text-primary);
    font-size: 18px;
    cursor: pointer;
  }

  #settings-go-top:focus-visible {
    outline: 2px solid var(--border-focus);
    outline-offset: 2px;
  }

  .settings-shell__content {
    min-width: 0;
  }

  .settings-shell :global([data-settings-shell-section]:not([hidden])) {
    display: grid;
    gap: 16px;
    min-width: 0;
  }

  .settings-shell :global(.settings-grid) {
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 330px), 1fr));
    align-items: start;
  }

  .settings-shell :global(.custom-field-row) {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px;
    padding-block: 8px;
  }

  .settings-shell :global(.custom-field-row :is(input, select)) {
    flex: 1 1 110px;
    min-width: 0;
  }

  .settings-shell :global(:is(.toggle-label, .toggle-switch)) {
    position: relative;
    display: inline-flex;
    align-items: center;
    flex: none;
    width: 44px;
    height: 44px;
    cursor: pointer;
  }

  .settings-shell :global(:is(.toggle-label, .toggle-switch) input) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    margin: 0;
    opacity: 0;
    cursor: inherit;
  }

  .settings-shell :global(.toggle-slider) {
    width: 40px;
    height: 24px;
    position: relative;
    border: 1px solid var(--text-secondary);
    border-radius: 12px;
    background: var(--bg-hover);
    pointer-events: none;
  }

  .settings-shell :global(.toggle-slider::before) {
    content: "";
    position: absolute;
    inset-block-start: 3px;
    inset-inline-start: 3px;
    width: 16px;
    height: 16px;
    border-radius: 50%;
    background: var(--text-secondary);
  }

  .settings-shell :global(input:checked + .toggle-slider) {
    background: var(--accent-text);
    border-color: var(--accent-text);
  }

  .settings-shell :global(input:checked + .toggle-slider::before) {
    inset-inline-start: 19px;
    background: var(--bg-primary);
  }

  .settings-shell :global(input:focus-visible + .toggle-slider) {
    outline: 2px solid var(--text-primary);
    outline-offset: 3px;
  }

  .settings-shell :global(.settings-file-picker) {
    position: relative;
    cursor: pointer;
  }

  .settings-shell :global(.settings-file-picker:focus-within) {
    outline: 2px solid var(--text-primary);
    outline-offset: 2px;
  }

  .settings-shell :global(.settings-file-picker input) {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
  }

  .settings-shell :global([id]),
  .settings-shell :global([data-settings-destination]) {
    scroll-margin-block-start: 80px;
    scroll-margin-block-end: 80px;
  }

  .settings-shell :global([data-settings-destination]:focus) {
    outline: 2px solid var(--text-primary);
    outline-offset: 3px;
  }

  .settings-load-status:not([hidden]) {
    margin-bottom: 16px;
    padding: 12px;
    border: 1px solid var(--border);
    border-radius: 8px;
    background: var(--bg-secondary);
    color: var(--text-primary);
  }

  .settings-load-status p {
    margin: 0;
  }

  .settings-load-status button {
    margin-top: 8px;
  }

  @media (max-width: 860px) {
    .settings-shell {
      display: block;
    }

    .settings-bar kbd {
      display: none;
    }
  }

  @media (max-width: 360px) {
    .settings-bar button {
      padding-inline: 7px;
    }

    .settings-bar button svg {
      display: none;
    }
  }
</style>
