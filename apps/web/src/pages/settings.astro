---
import SettingsLabels from "../components/settings/SettingsLabels.astro"
import SettingsGeneral from "../components/settings/SettingsGeneral.astro"
import SettingsIntegrations from "../components/settings/SettingsIntegrations.astro"
import SettingsAgents from "../components/settings/SettingsAgents.astro"
import SettingsRules from "../components/settings/SettingsRules.astro"
import SettingsSectionIntro from "../components/settings/SettingsSectionIntro.astro"
import SettingsSystem from "../components/settings/SettingsSystem.astro"
import Layout from "../layouts/Layout.astro"
import UnifiedBar from "../components/layout/UnifiedBar.astro"
import { t } from "../i18n/translations"
import type { Locale } from "../lib/locale"
import { SETTINGS_SECTIONS } from "../lib/settings-registry"

const cookieLocale = Astro.cookies.get("meitheal-locale")?.value
const locale: Locale = cookieLocale === "ga" ? "ga" : "en"
const workflowSection = SETTINGS_SECTIONS.find((section) => section.id === "workflow-settings")!
const rulesSection = SETTINGS_SECTIONS.find((section) => section.id === "rules-lenses-settings")!
const integrationsSection = SETTINGS_SECTIONS.find((section) => section.id === "integrations-settings")!
const automationAiSection = SETTINGS_SECTIONS.find((section) => section.id === "automation-ai-settings")!
---

<Layout title={`Meitheal — ${t("settings.title", locale)}`}>
  <UnifiedBar
    title={t("settings.title", locale)}
    tabs={SETTINGS_SECTIONS.map((s) => ({ id: s.id, label: s.label, icon: s.icon }))}
    searchPlaceholder="Search settings…"
    slot="custom-header"
  />

  <div id="settings-shell" class="settings-shell">

    <div class="settings-shell__content">

      <SettingsSystem locale={locale} />

      <section
        id="workflow-settings"
        class="settings-shell__section"
        data-settings-shell-section
      >
        <SettingsSectionIntro section={workflowSection} />
        <SettingsGeneral locale={locale} />
        <SettingsLabels locale={locale} />
      </section>

      <section
        id="rules-lenses-settings"
        class="settings-shell__section"
        data-settings-shell-section
      >
        <SettingsSectionIntro section={rulesSection} />
        <SettingsRules />
      </section>

      <section
        id="integrations-settings"
        class="settings-shell__section"
        data-settings-shell-section
      >
        <SettingsSectionIntro section={integrationsSection} />
        <SettingsIntegrations locale={locale} />
      </section>

      <section
        id="automation-ai-settings"
        class="settings-shell__section"
        data-settings-shell-section
      >
        <SettingsSectionIntro section={automationAiSection} />
        <SettingsAgents locale={locale} />
      </section>
    </div>
  </div>

  <button
    id="settings-go-top"
    class="settings-go-top"
    type="button"
    aria-label="Scroll to top"
    title="Back to top (Home key)"
    aria-keyshortcuts="Home"
    hidden
  >
    ↑
  </button>

  <div
    id="toast-container"
    class="toast-container"
    aria-live="polite"
    role="status"
    data-no-scroll-lock="true"
  >
  </div>

  <script>
    import "@lib/settings-page"
  </script>
</Layout>

  <style>
  .settings-shell {
    display: flex;
    flex-direction: column;
    gap: 20px;
  }
  .settings-shell:not(.is-detail-view) .settings-shell__layout,
  .settings-shell:not(.is-detail-view) .settings-shell__mobile-nav {
    display: none; /* Bar-specific overrides handled by UnifiedBar.astro component */
  }
  /* — Search results dropdown — */
  .settings-search-results {
    display: none;
    flex-direction: column;
    gap: 4px;
    position: absolute;
    top: 100%;
    right: 0;
    margin-top: 4px;
    min-width: 320px;
    max-width: calc(100vw - 32px);
    max-height: 340px;
    overflow-y: auto;
    background: color-mix(in srgb, var(--bg-card) 97%, transparent);
    backdrop-filter: blur(16px);
    -webkit-backdrop-filter: blur(16px);
    border: 1px solid var(--border);
    border-radius: 12px;
    box-shadow: 0 8px 24px rgba(0,0,0,.18);
    padding: 4px;
    z-index: 50;
    animation: settings-dropdown-in 120ms ease-out;
  }
  .settings-search-results:not([hidden]) {
    display: flex;
  }
  @keyframes settings-dropdown-in {
    from { opacity: 0; transform: translateY(-4px) scale(0.97); }
    to { opacity: 1; transform: translateY(0) scale(1); }
  }
  .settings-search-results__item {
    display: flex;
    flex-direction: column;
    gap: 4px;
    width: 100%;
    padding: 10px 12px;
    text-align: left;
    background: transparent;
    border: none;
    border-radius: 8px;
    color: var(--text-primary);
    cursor: pointer;
    transition: background 120ms ease, color 120ms ease;
  }
  .settings-search-results__item:hover,
  .settings-search-results__item.is-active {
    background: var(--accent-6-bg);
    color: var(--text-primary);
  }
  .settings-search-results__item.is-active {
    background: var(--accent-12-bg);
  }
  .settings-search-results__meta {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    align-items: center;
  }
  .settings-search-results__type,
  .settings-search-results__section {
    display: inline-flex;
    align-items: center;
    min-height: 20px;
    padding: 0 6px;
    border-radius: 999px;
    font-size: 10px;
    line-height: 1;
  }
  .settings-search-results__type {
    background: color-mix(in srgb, var(--accent) 12%, transparent);
    color: var(--accent);
  }
  .settings-search-results__section {
    background: var(--bg-secondary);
    color: var(--text-muted);
  }
  .settings-search-results__description,
  .settings-search-results__empty {
    font-size: 12px;
    color: var(--text-muted);
    line-height: 1.55;
  }
  .settings-search-results__empty {
    padding: 12px;
    text-align: center;
  }
  @media (prefers-reduced-motion: reduce) {
    .settings-search-results {
      animation: none;
      transition: none;
    }
  }
  /* — Color-mix CSS custom properties (pre-computed for paint perf) — */
  :root {
    --accent-6-bg: color-mix(in srgb, var(--bg-card) 80%, var(--accent) 6%);
    --accent-10: color-mix(in srgb, var(--accent) 10%, transparent);
    --accent-12-bg: color-mix(in srgb, var(--accent) 12%, var(--bg-card));
    --accent-20: color-mix(in srgb, var(--accent) 20%, transparent);
    --accent-50-border: color-mix(in srgb, var(--accent) 50%, var(--border));
    --accent-78-white: color-mix(in srgb, var(--accent) 78%, white);
  }
  /* — Tab items —
   * Uses :global() because tabs live in SettingsSummaryCard.astro
   * (child component), but styles need to be owned by the parent
   * settings.astro to maintain the unified tab bar layout. #33 */
  :global(.settings-tab) {
    display: flex;
    align-items: center;
    gap: 7px;
    padding: 10px 16px;
    min-height: 44px;
    border: 1px solid transparent;
    border-radius: 10px;
    background: transparent;
    color: var(--text-secondary);
    text-decoration: none;
    white-space: nowrap;
    font-size: 13px;
    font-weight: 600;
    cursor: pointer;
    flex-shrink: 0;
    transition:
      background 160ms ease,
      border-color 160ms ease,
      color 160ms ease,
      box-shadow 160ms ease,
      transform 160ms ease;
  }
  :global(.settings-tab:hover) {
    background: var(--accent-6-bg);
    border-color: var(--border);
    color: var(--text-primary);
    transform: translateY(-1px);
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.08);
  }
  :global(.settings-tab.is-active) {
    background: var(--accent-12-bg);
    border-color: var(--accent-50-border);
    color: var(--accent);
    box-shadow: 0 0 0 1px var(--accent-10);
  }
  :global(.settings-tab:focus-visible) {
    outline: 2px solid var(--accent-78-white);
    outline-offset: 2px;
  }
  :global(.settings-tab__icon) {
    font-size: 15px;
    line-height: 1;
    flex-shrink: 0;
  }
  :global(.settings-tab__label) {
    font-size: 13px;
    font-weight: 600;
  }
  :global(.settings-tab__status) {
    display: inline-flex;
    align-items: center;
    min-height: 18px;
    padding: 0 6px;
    border-radius: 999px;
    background: color-mix(in srgb, var(--accent) 18%, transparent); /* #23: bump from 10% for contrast */
    color: var(--accent);
    font-size: 10px;
    font-weight: 600;
    letter-spacing: 0.03em;
    white-space: nowrap;
    text-align: center;
    justify-content: center;
  }
  :global(.settings-tab.is-active .settings-tab__status) {
    background: var(--accent-20);
  }
  @media (prefers-reduced-motion: reduce) {
    :global(.settings-tab) {
      transition: none;
    }
    :global(.settings-tab:hover) {
      transform: none;
    }
  }
  /* — Icon-only tabs on narrow viewports (HA Companion phone) — */
  @media (max-width: 480px) {
    :global(.settings-tab__label) {
      display: none;
    }
    :global(.settings-tab) {
      padding: 10px 12px;
    }
    :global(.settings-tab__icon) {
      font-size: 18px;
    }
  }
  /* — Deep-link landing flash — */
  @keyframes settings-landing-pulse {
    0% { box-shadow: 0 0 0 0 color-mix(in srgb, var(--accent) 30%, transparent); }
    50% { box-shadow: 0 0 0 4px color-mix(in srgb, var(--accent) 15%, transparent); }
    100% { box-shadow: 0 0 0 0 transparent; }
  }
  :global(.settings-landing-flash) {
    animation: settings-landing-pulse 1.2s ease-out;
  }
  @media (prefers-reduced-motion: reduce) {
    :global(.settings-landing-flash) {
      animation: none;
    }
  }
  .settings-shell__content {
    display: flex;
    flex-direction: column;
    gap: 32px;
    max-width: 1200px;
    margin: 0 auto;
    width: 100%;
  }
  .settings-shell__section {
    display: flex;
    flex-direction: column;
    gap: 16px;
    scroll-margin-top: calc(var(--settings-tab-bar-h, 52px) + 16px); /* #9: dynamic, accommodates tab bar height */
    padding-bottom: 32px;
    border-bottom: 1px solid color-mix(in srgb, var(--border) 50%, transparent);
  }
  .settings-shell__section:last-child {
    border-bottom: none;
    padding-bottom: 0;
  }
  :global(.settings-shell__section--nested) {
    border-bottom: none;
    padding-bottom: 0;
  }
  .settings-shell__section--muted {
    opacity: 0.42;
    filter: saturate(0.8);
  }
  /* — Go to top FAB — */
  .settings-go-top {
    position: fixed;
    bottom: calc(28px + env(safe-area-inset-bottom, 0px));
    right: 28px;
    z-index: 50;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 42px;
    height: 42px;
    border: 1px solid var(--border);
    border-radius: 12px;
    background: var(--bg-card);
    color: var(--text-secondary);
    font-size: 18px;
    cursor: pointer;
    box-shadow:
      0 4px 16px rgba(0, 0, 0, 0.3),
      0 0 0 1px color-mix(in srgb, var(--accent) 8%, transparent);
    opacity: 0;
    transform: translateY(8px);
    will-change: transform, opacity;
    transition:
      opacity 200ms ease,
      transform 200ms ease,
      background 160ms ease,
      border-color 160ms ease;
    pointer-events: none;
  }
  .settings-go-top.is-visible {
    opacity: 1;
    transform: translateY(0);
    pointer-events: auto;
  }
  .settings-go-top:hover {
    background: var(--accent-12-bg);
    border-color: var(--accent-50-border);
    color: var(--accent);
  }
  .settings-go-top:focus-visible {
    outline: 2px solid var(--accent-78-white);
    outline-offset: 2px;
  }
  @media (prefers-reduced-motion: reduce) {
    .settings-go-top {
      transition: none;
      will-change: auto;
    }
  }
  .settings-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(360px, 100%), 1fr));
    gap: 16px;
  }
  .custom-field-row {
    display: flex;
    gap: 8px;
    align-items: center;
    padding: 10px 0;
    border-bottom: 1px solid var(--border);
  }
  .custom-field-row .form-input,
  .custom-field-row .form-select {
    padding: 6px 10px;
    font-size: 13px;
  }
  .custom-field-row:last-child {
    border-bottom: none;
  }
  .integration-section {
    border-bottom: 1px solid var(--border);
    padding: 16px 0;
  }
  .integration-section:last-child {
    border-bottom: none;
  }
  .integration-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 12px;
    margin-bottom: 12px;
  }
  .integration-desc {
    font-size: 12px;
    color: var(--text-muted);
    margin-top: 4px;
    line-height: 1.4;
  }
  .integration-config {
    padding-left: 8px;
    border-left: 2px solid var(--border);
    margin-left: 4px;
  }
  .shortcut-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 8px;
  }
  .shortcut-row {
    display: flex;
    gap: 12px;
    align-items: center;
    font-size: 13px;
  }
  kbd {
    background: var(--bg-hover);
    border: 1px solid var(--border);
    border-radius: 4px;
    padding: 2px 8px;
    font-family: "JetBrains Mono", monospace;
    font-size: 12px;
    color: var(--text-primary);
  }
  .badge {
    display: inline-block;
    padding: 3px 10px;
    border-radius: 12px;
    font-size: 12px;
    font-weight: 500;
  }
  .badge-active {
    background: rgba(99, 102, 241, 0.15);
    color: var(--accent);
  }
  .badge-pending {
    background: rgba(107, 114, 128, 0.15);
    color: var(--text-muted);
  }
  .framework-row {
    padding: 10px 0;
    border-bottom: 1px solid var(--border);
  }
  .framework-row:last-child {
    border-bottom: none;
  }
  .framework-info {
    display: flex;
    gap: 12px;
    align-items: center;
  }
  .framework-desc {
    font-size: 12px;
    color: var(--text-muted);
    margin-top: 2px;
  }
  .toggle-label {
    position: relative;
    display: inline-block;
    width: 40px;
    height: 22px;
    flex-shrink: 0;
    cursor: pointer;
  }
  .toggle-label input {
    opacity: 0;
    width: 0;
    height: 0;
  }
  .toggle-slider {
    position: absolute;
    inset: 0;
    background: var(--bg-hover);
    border: 1px solid var(--border);
    border-radius: 11px;
    transition: all 200ms;
  }
  .toggle-slider::before {
    content: "";
    position: absolute;
    width: 16px;
    height: 16px;
    left: 2px;
    bottom: 2px;
    background: var(--text-muted);
    border-radius: 50%;
    transition: all 200ms;
  }
  .toggle-label input:checked + .toggle-slider {
    background: var(--accent);
    border-color: var(--accent);
  }
  .toggle-label input:checked + .toggle-slider::before {
    transform: translateX(18px);
    background: white;
  }
  @media (max-width: 768px) {
    .settings-shell__hero {
      grid-template-columns: 1fr;
      padding: 18px;
    }
    .settings-shell__surface-header {
      flex-direction: column;
      align-items: flex-start;
    }
    .settings-grid {
      grid-template-columns: 1fr;
    }
    .shortcut-grid {
      grid-template-columns: 1fr;
    }
    .settings-go-top {
      bottom: 16px;
      right: 16px;
      width: 38px;
      height: 38px;
      font-size: 16px;
    }
  }
  @media (max-width: 560px) {
    .settings-shell__search-input-row {
      grid-template-columns: 1fr;
    }
  }
</style>
