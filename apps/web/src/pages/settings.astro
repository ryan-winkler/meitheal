---
import SettingsLabels from "../components/settings/SettingsLabels.astro"
import SettingsGeneral from "../components/settings/SettingsGeneral.astro"
import SettingsIntegrations from "../components/settings/SettingsIntegrations.astro"
import SettingsAgents from "../components/settings/SettingsAgents.astro"
import SettingsShellNav from "../components/settings/SettingsShellNav.astro"
import SettingsSummaryCard from "../components/settings/SettingsSummaryCard.astro"
import SettingsSystem from "../components/settings/SettingsSystem.astro"
import Layout from "../layouts/Layout.astro"
import { t } from "../i18n/translations"
import type { Locale } from "../lib/locale"
import { SETTINGS_SECTIONS } from "../lib/settings-registry"

const cookieLocale = Astro.cookies.get("meitheal-locale")?.value
const locale: Locale = cookieLocale === "ga" ? "ga" : "en"
---

<Layout title={`Meitheal — ${t("settings.title", locale)}`}>
  <span slot="page-title">{t("settings.title", locale)}</span>

  <div id="settings-shell" class="settings-shell">
    <section class="card settings-shell__hero">
      <div class="settings-shell__hero-copy">
        <span class="settings-shell__eyebrow">Home Assistant-native settings</span>
        <h2 class="settings-shell__title">Personal, workflow, and platform controls in one place</h2>
        <p class="settings-shell__description">
          Search for a setting, jump directly to a section, and keep companion,
          PWA, and integration actions ingress-safe with hash links.
        </p>
      </div>

      <div class="settings-shell__search">
        <label class="form-label" for="settings-search-input">Find a setting</label>
        <input
          id="settings-search-input"
          class="form-input"
          type="search"
          placeholder="Theme, labels, calendar sync, companion links…"
          autocomplete="off"
        />
        <div
          id="settings-search-results"
          class="settings-search-results"
          hidden
          aria-live="polite"
        >
        </div>
      </div>
    </section>

    <div class="settings-shell__summary">
      <SettingsSummaryCard
        id="settings-summary-personal"
        eyebrow="Personal"
        title="Appearance"
        detail="Theme"
      />
      <SettingsSummaryCard
        id="settings-summary-workflow"
        eyebrow="Workflow"
        title="Task model"
        detail="Ready to customize"
      />
      <SettingsSummaryCard
        id="settings-summary-integrations"
        eyebrow="Integrations"
        title="Home Assistant"
        detail="Checking"
      />
      <SettingsSummaryCard
        id="settings-summary-ai"
        eyebrow="Automation & AI"
        title="Agents"
        detail="Available"
      />
      <SettingsSummaryCard
        id="settings-summary-pwa"
        eyebrow="App & PWA"
        title="Offline readiness"
        detail="Checking"
      />
      <SettingsSummaryCard
        id="settings-summary-danger"
        eyebrow="Danger Zone"
        title="Protected"
        detail="Protected actions"
      />
    </div>

    <div class="settings-shell__mobile-nav">
      <SettingsShellNav sections={SETTINGS_SECTIONS} />
    </div>

    <div class="settings-shell__layout">
      <aside class="settings-shell__sidebar">
        <div class="settings-shell__sidebar-sticky">
          <SettingsShellNav sections={SETTINGS_SECTIONS} />
          <div class="card settings-shell__sidebar-note">
            <strong>Ingress-safe navigation</strong>
            <p>
              All jumps use hashes so Settings stays inside the Home Assistant
              iframe, companion webview, and PWA scope.
            </p>
          </div>
        </div>
      </aside>

      <div class="settings-shell__content">
        <section
          id="workflow-settings"
          class="settings-shell__section"
          data-settings-shell-section
        >
          <div class="settings-shell__section-intro">
            <span class="settings-shell__section-icon">🧭</span>
            <div>
              <h2>Workflow</h2>
              <p>
                Tune how tasks behave day to day: sidebar structure, custom
                fields, labels, frameworks, notifications, and defaults.
              </p>
            </div>
          </div>
          <SettingsGeneral locale={locale} />
          <SettingsLabels locale={locale} />
        </section>

        <section
          id="integrations-settings"
          class="settings-shell__section"
          data-settings-shell-section
        >
          <div class="settings-shell__section-intro">
            <span class="settings-shell__section-icon">🔌</span>
            <div>
              <h2>Integrations</h2>
              <p>
                Connect Home Assistant, calendars, todo lists, Grocy, n8n, and
                outgoing automations without leaving Meitheal.
              </p>
            </div>
          </div>
          <SettingsIntegrations locale={locale} />
        </section>

        <section
          id="automation-ai-settings"
          class="settings-shell__section"
          data-settings-shell-section
        >
          <div class="settings-shell__section-intro">
            <span class="settings-shell__section-icon">🤖</span>
            <div>
              <h2>Automation &amp; AI</h2>
              <p>
                Choose conversation agents, configure external AI providers, and
                expose protocols like A2A, MCP, and WebMCP.
              </p>
            </div>
          </div>
          <SettingsAgents locale={locale} />
        </section>

        <SettingsSystem locale={locale} />
      </div>
    </div>
  </div>

  <div
    id="toast-container"
    class="toast-container"
    aria-live="polite"
    role="status"
    data-no-scroll-lock="true"
  >
  </div>

  <script>
    import "@lib/settings-page"
  </script>
</Layout>

<style>
  .settings-shell {
    display: flex;
    flex-direction: column;
    gap: 20px;
  }
  .settings-shell__hero {
    display: grid;
    grid-template-columns: minmax(0, 1.35fr) minmax(320px, 0.95fr);
    gap: 20px;
    padding: 24px;
    border-radius: 22px;
    background:
      radial-gradient(circle at top left, color-mix(in srgb, var(--accent) 18%, transparent), transparent 35%),
      linear-gradient(135deg, color-mix(in srgb, var(--bg-card) 92%, white), var(--bg-card));
  }
  .settings-shell__hero-copy {
    display: flex;
    flex-direction: column;
    gap: 10px;
  }
  .settings-shell__eyebrow {
    display: inline-flex;
    width: fit-content;
    padding: 6px 10px;
    border-radius: 999px;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--accent);
    background: color-mix(in srgb, var(--accent) 14%, transparent);
  }
  .settings-shell__title {
    margin: 0;
    font-size: clamp(1.8rem, 3vw, 2.5rem);
    line-height: 1.05;
  }
  .settings-shell__description {
    margin: 0;
    max-width: 62ch;
    color: var(--text-secondary);
    font-size: 14px;
    line-height: 1.6;
  }
  .settings-shell__search {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 10px;
    padding: 18px;
    border: 1px solid color-mix(in srgb, var(--border) 75%, var(--accent));
    border-radius: 18px;
    background: color-mix(in srgb, var(--bg-secondary) 92%, transparent);
  }
  .settings-search-results {
    display: flex;
    flex-direction: column;
    gap: 8px;
    max-height: 280px;
    overflow-y: auto;
  }
  .settings-search-results__item {
    display: flex;
    flex-direction: column;
    gap: 4px;
    width: 100%;
    padding: 12px 14px;
    text-align: left;
    background: var(--bg-card);
    border: 1px solid var(--border);
    border-radius: 14px;
    color: var(--text-primary);
    cursor: pointer;
    transition: transform 150ms ease, border-color 150ms ease, background 150ms ease;
  }
  .settings-search-results__item:hover {
    transform: translateY(-1px);
    border-color: var(--accent);
    background: color-mix(in srgb, var(--bg-card) 82%, var(--accent) 8%);
  }
  .settings-search-results__item span,
  .settings-search-results__empty {
    font-size: 12px;
    color: var(--text-muted);
  }
  .settings-shell__summary {
    display: grid;
    grid-template-columns: repeat(6, minmax(0, 1fr));
    gap: 12px;
  }
  .settings-summary-card {
    display: flex;
    flex-direction: column;
    gap: 6px;
    min-height: 108px;
    padding: 16px;
    border: 1px solid var(--border);
    border-radius: 18px;
    background: var(--bg-card);
  }
  .settings-summary-card__eyebrow {
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--text-muted);
  }
  .settings-summary-card__title {
    font-size: 15px;
  }
  .settings-summary-card__detail {
    color: var(--text-secondary);
    font-size: 13px;
    line-height: 1.45;
  }
  .settings-shell__layout {
    display: grid;
    grid-template-columns: 300px minmax(0, 1fr);
    gap: 20px;
    align-items: start;
  }
  .settings-shell__mobile-nav {
    display: none;
  }
  .settings-shell__sidebar-sticky {
    position: sticky;
    top: 88px;
    display: flex;
    flex-direction: column;
    gap: 12px;
  }
  .settings-shell-nav__list {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }
  .settings-shell-nav__link {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr) auto;
    gap: 12px;
    align-items: start;
    padding: 12px 14px;
    border: 1px solid var(--border);
    border-radius: 16px;
    background: var(--bg-card);
    color: inherit;
    text-decoration: none;
    transition: transform 150ms ease, border-color 150ms ease, background 150ms ease;
  }
  .settings-shell-nav__link:hover,
  .settings-shell-nav__link.is-active {
    transform: translateY(-1px);
    border-color: color-mix(in srgb, var(--accent) 75%, var(--border));
    background: color-mix(in srgb, var(--bg-card) 88%, var(--accent) 8%);
  }
  .settings-shell-nav__icon {
    font-size: 18px;
    line-height: 1;
    padding-top: 2px;
  }
  .settings-shell-nav__content {
    display: flex;
    flex-direction: column;
    gap: 3px;
    min-width: 0;
  }
  .settings-shell-nav__content small {
    color: var(--text-muted);
    font-size: 12px;
    line-height: 1.45;
  }
  .settings-shell-nav__status {
    display: inline-flex;
    align-items: center;
    padding: 4px 8px;
    border-radius: 999px;
    font-size: 11px;
    color: var(--text-secondary);
    background: var(--bg-secondary);
    white-space: nowrap;
  }
  .settings-shell__sidebar-note {
    padding: 16px;
    border-radius: 18px;
  }
  .settings-shell__sidebar-note p {
    margin: 8px 0 0;
    font-size: 13px;
    color: var(--text-muted);
    line-height: 1.55;
  }
  .settings-shell__content {
    display: flex;
    flex-direction: column;
    gap: 20px;
  }
  .settings-shell__section {
    display: flex;
    flex-direction: column;
    gap: 16px;
    scroll-margin-top: 88px;
  }
  .settings-shell__section--muted {
    opacity: 0.42;
    filter: saturate(0.8);
  }
  .settings-shell__section-intro {
    display: flex;
    gap: 14px;
    align-items: flex-start;
    padding: 18px 20px;
    border: 1px solid var(--border);
    border-radius: 20px;
    background: linear-gradient(135deg, var(--bg-card), color-mix(in srgb, var(--bg-card) 86%, var(--accent) 8%));
  }
  .settings-shell__section-intro h2 {
    margin: 0 0 4px;
    font-size: 22px;
  }
  .settings-shell__section-intro p {
    margin: 0;
    color: var(--text-secondary);
    font-size: 14px;
    line-height: 1.55;
  }
  .settings-shell__section-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 42px;
    height: 42px;
    border-radius: 14px;
    background: color-mix(in srgb, var(--accent) 14%, transparent);
    font-size: 20px;
  }
  .settings-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(400px, 1fr));
    gap: 16px;
  }
  .custom-field-row {
    display: flex;
    gap: 6px;
    align-items: center;
    padding: 4px 0;
    border-bottom: 1px solid var(--border);
  }
  .custom-field-row .form-input,
  .custom-field-row .form-select {
    padding: 4px 8px;
    font-size: 13px;
  }
  .custom-field-row:last-child {
    border-bottom: none;
  }
  .integration-section {
    border-bottom: 1px solid var(--border);
    padding: 16px 0;
  }
  .integration-section:last-child {
    border-bottom: none;
  }
  .integration-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 12px;
    margin-bottom: 12px;
  }
  .integration-desc {
    font-size: 12px;
    color: var(--text-muted);
    margin-top: 4px;
    line-height: 1.4;
  }
  .integration-config {
    padding-left: 8px;
    border-left: 2px solid var(--border);
    margin-left: 4px;
  }
  .shortcut-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 8px;
  }
  .shortcut-row {
    display: flex;
    gap: 12px;
    align-items: center;
    font-size: 13px;
  }
  kbd {
    background: var(--bg-hover);
    border: 1px solid var(--border);
    border-radius: 4px;
    padding: 2px 8px;
    font-family: "JetBrains Mono", monospace;
    font-size: 12px;
    color: var(--text-primary);
  }
  .badge {
    display: inline-block;
    padding: 3px 10px;
    border-radius: 12px;
    font-size: 12px;
    font-weight: 500;
  }
  .badge-active {
    background: rgba(99, 102, 241, 0.15);
    color: var(--accent);
  }
  .badge-pending {
    background: rgba(107, 114, 128, 0.15);
    color: var(--text-muted);
  }
  .framework-row {
    padding: 10px 0;
    border-bottom: 1px solid var(--border);
  }
  .framework-row:last-child {
    border-bottom: none;
  }
  .framework-info {
    display: flex;
    gap: 12px;
    align-items: center;
  }
  .framework-desc {
    font-size: 12px;
    color: var(--text-muted);
    margin-top: 2px;
  }
  .toggle-label {
    position: relative;
    display: inline-block;
    width: 40px;
    height: 22px;
    flex-shrink: 0;
    cursor: pointer;
  }
  .toggle-label input {
    opacity: 0;
    width: 0;
    height: 0;
  }
  .toggle-slider {
    position: absolute;
    inset: 0;
    background: var(--bg-hover);
    border: 1px solid var(--border);
    border-radius: 11px;
    transition: all 200ms;
  }
  .toggle-slider::before {
    content: "";
    position: absolute;
    width: 16px;
    height: 16px;
    left: 2px;
    bottom: 2px;
    background: var(--text-muted);
    border-radius: 50%;
    transition: all 200ms;
  }
  .toggle-label input:checked + .toggle-slider {
    background: var(--accent);
    border-color: var(--accent);
  }
  .toggle-label input:checked + .toggle-slider::before {
    transform: translateX(18px);
    background: white;
  }
  @media (max-width: 1120px) {
    .settings-shell__summary {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
    .settings-shell__layout {
      grid-template-columns: 1fr;
    }
    .settings-shell__sidebar {
      display: none;
    }
    .settings-shell__mobile-nav {
      display: block;
    }
    .settings-shell__mobile-nav .settings-shell-nav__list {
      flex-direction: row;
      overflow-x: auto;
      padding-bottom: 4px;
    }
    .settings-shell__mobile-nav .settings-shell-nav__link {
      min-width: 220px;
    }
  }
  @media (max-width: 768px) {
    .settings-shell__hero {
      grid-template-columns: 1fr;
      padding: 18px;
    }
    .settings-shell__summary {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
    .settings-grid {
      grid-template-columns: 1fr;
    }
    .shortcut-grid {
      grid-template-columns: 1fr;
    }
  }
  @media (max-width: 560px) {
    .settings-shell__summary {
      grid-template-columns: 1fr;
    }
    .settings-shell__mobile-nav .settings-shell-nav__link {
      min-width: 180px;
    }
  }
</style>
