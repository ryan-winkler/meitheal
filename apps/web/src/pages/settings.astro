---
import { resolveBoardPageScope } from "@lib/board-http"
import { scopeBoardAccess, scopePermits } from "@domains/tasks"
import { boardScopeAuthorityKey } from "@lib/board-view"
import { boardSessionProof } from "@lib/named-board-request"
import SettingsAgents from "../components/settings/SettingsAgents.astro"
import SettingsAgentTokens from "../components/settings/SettingsAgentTokens.astro"
import SettingsAppPwa from "../components/settings/SettingsAppPwa.astro"
import SettingsDangerZone from "../components/settings/SettingsDangerZone.astro"
import SettingsIntegrations from "../components/settings/SettingsIntegrations.astro"
import SettingsLanguageTime from "../components/settings/SettingsLanguageTime.astro"
import SettingsLookAndFeel from "../components/settings/SettingsLookAndFeel.astro"
import SettingsNavigation from "../components/settings/SettingsNavigation.astro"
import SettingsPeopleNotifications from "../components/settings/SettingsPeopleNotifications.astro"
import SettingsRules from "../components/settings/SettingsRules.astro"
import SettingsSectionIntro from "../components/settings/SettingsSectionIntro.astro"
import SettingsShellNav from "../components/settings/SettingsShellNav.astro"
import SettingsTasksBoards from "../components/settings/SettingsTasksBoards.astro"
import SettingsPlugins from "../components/settings/SettingsPlugins.astro"
import SettingsWebserver from "../components/settings/SettingsWebserver.astro"
import Icon from "../components/ui/Icon.astro"
import TablerModal from "../components/ui/TablerModal.astro"
import Layout from "../layouts/Layout.astro"
import { t } from "../i18n/translations"
import type { Locale } from "../lib/locale"
import { issueDatabaseDownloadToken } from "../lib/database-download-token"
import { SETTINGS_SECTIONS } from "../lib/settings-registry"
import { safeJsonForScript, SETTINGS_HELP_TOPICS } from "@domains/navigation/settings-help-topics"
import { ensureSchema, getPersistenceClient } from "@domains/tasks"
import { verifyCurrentHAOwner } from "@domains/ha/current-admin"
import { verifiedIngressUser } from "../lib/verified-ingress-user"
import settingsUtilitiesCss from "../styles/settings-utilities.css?raw"

const selectedBoard = await resolveBoardPageScope(Astro).catch(() => null)
const settingsBoard = selectedBoard?.ok ? {
  id: selectedBoard.scope.boardId, name: scopeBoardAccess(selectedBoard.scope).name,
  canManage: scopePermits(selectedBoard.scope, { resource: "board", action: "manage" }),
  session: boardSessionProof(selectedBoard.scope.principal.id), authority: boardScopeAuthorityKey(selectedBoard.scope),
} : undefined
const user = verifiedIngressUser(Astro.locals)
const mayDownloadDatabase = user?.isAdmin && await verifyCurrentHAOwner(user.id, Astro.request.signal) === "allowed"
const protectedBackup = mayDownloadDatabase && await ensureSchema().then(async () =>
  (await getPersistenceClient().execute("SELECT 1 FROM task_boards WHERE visibility = 'restricted' OR (SELECT COUNT(*) FROM task_boards) > 1 UNION ALL SELECT 1 FROM app_settings WHERE key = 'private_organization_data' UNION ALL SELECT 1 FROM organization_access_policies WHERE audience = 'selected' OR scope <> 'feature' UNION ALL SELECT 1 FROM home_assistant_task_areas UNION ALL SELECT 1 FROM pillars WHERE user_id <> 'default' LIMIT 1")).rows.length > 0
).catch(() => true)
const databaseDownloadToken = mayDownloadDatabase && !protectedBackup ? issueDatabaseDownloadToken(user.id) : undefined
if (user) Astro.response.headers.set("Cache-Control", "private, no-store")
const cookieLocale = Astro.cookies.get("meitheal-locale")?.value
const locale: Locale = cookieLocale === "ga" ? "ga" : "en"
const scoringSection = SETTINGS_SECTIONS.find((section) => section.id === "scoring-settings")!
const aiAgentsSection = SETTINGS_SECTIONS.find((section) => section.id === "ai-agents-settings")!
const connectionsSection = SETTINGS_SECTIONS.find((section) => section.id === "connections-settings")!
---

<Layout title={`Meitheal — ${t("settings.title", locale)}`} {...(settingsBoard ? { boardContext: { boardId: settingsBoard.id, session: settingsBoard.session, boardName: settingsBoard.name } } : {})}>
  <header id="settings-bar" class="settings-bar" data-search-scope="settings" slot="custom-header">
    <h1 tabindex="-1">{t("settings.title", locale)}</h1>
    <div class="settings-bar__actions">
      <a id="run-setup-again" class="btn btn-secondary" href="/setup">{t("setup.rerun", locale)}</a>
      <button type="button" id="settings-sections-toggle" aria-expanded="true" aria-controls="settings-directory">
        {t("settings.sections", locale)} <span aria-hidden="true">▾</span>
      </button>
      <button type="button" id="settings-bar-search-launcher" aria-keyshortcuts="/" data-search-scope="settings">
        <svg aria-hidden="true" width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <circle cx="10" cy="10" r="6" /><path d="m15 15 5 5" />
        </svg>
        {t("settings.search", locale)} <kbd aria-hidden="true">/</kbd>
      </button>
    </div>
  </header>

  <div id="settings-shell" class="settings-shell">
    <span id="settings-scroll-marker" aria-hidden="true"></span>
    <SettingsShellNav sections={SETTINGS_SECTIONS} locale={locale} />

    <div class="settings-shell__content">
      <div id="settings-load-status" class="settings-load-status">
        <p id="settings-loading" role="status">{t("settings.loading", locale)}</p>
        <p id="settings-load-error" role="alert" hidden>{t("settings.load_error", locale)}</p>
        <button id="settings-load-retry" type="button" class="btn btn-secondary" hidden>{t("settings.retry", locale)}</button>
      </div>
      <div id="settings-panels" inert>


      <!-- 1. Look & Feel -->
      <SettingsLookAndFeel locale={locale} />

      <!-- 2. Language & Time -->
      <SettingsLanguageTime locale={locale} />

      <!-- 3. Navigation & Shortcuts -->
      <SettingsNavigation locale={locale} />

      <!-- 4. Tasks & Boards -->
      <SettingsTasksBoards locale={locale} />

      <!-- 5. People & Notifications -->
      <SettingsPeopleNotifications locale={locale} board={settingsBoard} />

      <!-- 6. Scoring & Rules -->
      <section
        id="scoring-settings"
        class="settings-shell__section"
        data-settings-shell-section
        hidden
      >
        <SettingsSectionIntro section={scoringSection} />
        <div id="rules-lenses-settings">
          <SettingsRules locale={locale} />
        </div>
      </section>

      <!-- 7. AI & Agent Access -->
      <section
        id="ai-agents-settings"
        class="settings-shell__section"
        data-settings-shell-section
        hidden
      >
        <SettingsSectionIntro section={aiAgentsSection} />
        <div id="automation-ai-settings">
          <SettingsAgents locale={locale} />
          <SettingsAgentTokens locale={locale} />
        </div>
      </section>

      <!-- 8. Connected Services -->
      <section
        id="connections-settings"
        class="settings-shell__section"
        data-settings-shell-section
        hidden
      >
        <SettingsSectionIntro section={connectionsSection} />
        <div id="integrations-settings">
          <SettingsIntegrations locale={locale} />
        </div>
      </section>

      <!-- 8b. Plugins -->
      <SettingsPlugins locale={locale} />

      <!-- 8c. Webserver -->
      <SettingsWebserver locale={locale} />

      <!-- 9. App & Companion -->
      <SettingsAppPwa locale={locale} />

      <!-- 10. Backups & Reset -->
      <SettingsDangerZone locale={locale} databaseDownloadToken={databaseDownloadToken} />
      </div>
    </div>
  </div>

  <TablerModal
    id="settings-help-modal"
    title="Help"
    descriptionId="settings-help-body"
    size="sm"
    statusTone="primary"
  >
    <div id="settings-help-body" class="settings-help-modal__body" data-help-body></div>
    <p class="settings-help-modal__tip" data-help-tip hidden></p>
    <p class="settings-help-modal__env" data-help-env hidden></p>
    <Fragment slot="footer">
      <button type="button" class="btn btn-primary btn-sm" data-tabler-modal-close data-tabler-initial-focus>Got it</button>
    </Fragment>
  </TablerModal>
  <script type="application/json" id="settings-help-topics" set:html={safeJsonForScript(SETTINGS_HELP_TOPICS)}></script>

  <button
    id="settings-go-top"
    class="go-top-btn"
    type="button"
    aria-label={t("settings.scroll_to_top", locale)}
    title="Back to top"
    hidden
  >
    <Icon name="arrow-up" size={18} sprite />
  </button>

  <script>
    import "@lib/settings-page"
  </script>
</Layout>

<style is:inline set:html={settingsUtilitiesCss} />
<style is:inline>
  body:has(#settings-bar) {
    overflow-x: clip;
    overflow-y: visible;
  }

  .main-content:has(> #settings-bar) {
    animation: none;
  }

  #main-content:has(> #settings-shell) {
    overflow: clip;
  }

  .settings-bar {
    position: sticky;
    inset-block-start: 0;
    z-index: 30;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 8px;
    min-height: 60px;
    padding: 8px clamp(12px, 3vw, 28px);
    background: var(--bg-primary);
    border-bottom: 1px solid var(--border);
  }

  .settings-bar h1 {
    margin: 0;
    font-size: clamp(1.125rem, 2vw, 1.375rem);
    font-weight: 650;
  }

  .settings-bar__actions {
    display: flex;
    flex-wrap: nowrap;
    align-items: center;
    justify-content: flex-end;
    gap: 8px;
    min-width: 0;
  }

  .settings-bar__actions > :is(button, a.btn) {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 6px;
    min-height: 34px;
    height: 34px;
    padding: 0 11px;
    background: var(--bg-secondary);
    color: var(--text-primary);
    border: 1px solid var(--border);
    border-radius: var(--radius-sm, 8px);
    font-size: 0.8125rem;
    font-weight: 550;
    line-height: 1;
    white-space: nowrap;
    text-decoration: none;
    cursor: pointer;
    transition:
      background-color 150ms cubic-bezier(0.23, 1, 0.32, 1),
      border-color 150ms cubic-bezier(0.23, 1, 0.32, 1),
      color 150ms cubic-bezier(0.23, 1, 0.32, 1),
      transform 120ms cubic-bezier(0.23, 1, 0.32, 1);
  }

  .settings-bar__actions > :is(button, a.btn):hover,
  .settings-bar button[aria-expanded="true"] {
    background: var(--bg-hover);
    border-color: color-mix(in srgb, var(--accent) 45%, var(--border));
    color: var(--text-primary);
  }

  .settings-bar__actions > :is(button, a.btn):active {
    transform: scale(0.97);
  }

  .settings-bar button:focus-visible,
  .settings-bar a:focus-visible,
  .settings-shell :focus-visible {
    outline: 2px solid var(--border-focus);
    outline-offset: 2px;
  }

  .settings-bar kbd {
    margin-inline-start: 4px;
    padding: 1px 5px;
    border: 1px solid var(--border);
    border-radius: 4px;
    background: var(--bg-card);
    color: var(--text-secondary);
    font-size: 0.7rem;
    line-height: 1.3;
  }

  .settings-shell {
    position: relative;
    display: grid;
    grid-template-columns: clamp(180px, 20vw, 232px) minmax(0, 1fr);
    align-items: start;
    gap: clamp(16px, 2.5vw, 36px);
    max-width: 1280px;
    margin: 0 auto;
    padding: clamp(16px, 3vw, 32px) 0;
  }

  .settings-shell[data-directory-collapsed] {
    grid-template-columns: minmax(0, 1fr);
    max-width: 1040px;
  }

  .settings-shell {
    --accent-text: color-mix(in srgb, var(--accent) 40%, var(--text-primary));
    --text-muted: var(--text-secondary);
    --text-muted-rgb: var(--text-secondary-rgb);
  }

  #settings-scroll-marker {
    position: absolute;
    inset-block-start: 0;
    width: 1px;
    height: 160px;
    pointer-events: none;
  }

  .settings-shell__content {
    min-width: 0;
  }

  .settings-shell [data-settings-shell-section]:not([hidden]) {
    display: grid;
    gap: 16px;
    min-width: 0;
  }

  .settings-shell .settings-grid {
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 330px), 1fr));
    align-items: start;
  }

  .settings-shell .custom-field-row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px;
    padding-block: 8px;
  }

  .settings-shell .custom-field-row :is(input, select) {
    flex: 1 1 110px;
    min-width: 0;
  }

  .settings-shell :is(.toggle-label, .toggle-switch) {
    position: relative;
    display: inline-flex;
    align-items: center;
    flex: none;
    width: 44px;
    height: 44px;
    cursor: pointer;
  }

  .settings-shell :is(.toggle-label, .toggle-switch) input {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    margin: 0;
    opacity: 0;
    cursor: inherit;
  }

  .settings-shell .toggle-slider {
    width: 40px;
    height: 24px;
    position: relative;
    border: 1px solid var(--text-secondary);
    border-radius: 12px;
    background: var(--bg-hover);
    pointer-events: none;
  }

  .settings-shell .toggle-slider::before {
    content: "";
    position: absolute;
    inset-block-start: 3px;
    inset-inline-start: 3px;
    width: 16px;
    height: 16px;
    border-radius: 50%;
    background: var(--text-secondary);
  }

  .settings-shell input:checked + .toggle-slider {
    background: var(--accent-text);
    border-color: var(--accent-text);
  }

  .settings-shell input:checked + .toggle-slider::before {
    inset-inline-start: 19px;
    background: var(--bg-primary);
  }

  .settings-shell input:focus-visible + .toggle-slider {
    outline: 2px solid var(--text-primary);
    outline-offset: 3px;
  }

  .settings-shell .settings-file-picker {
    position: relative;
    cursor: pointer;
  }

  .settings-shell .settings-file-picker:focus-within {
    outline: 2px solid var(--text-primary);
    outline-offset: 2px;
  }

  .settings-shell .settings-file-picker input {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
  }

  .settings-shell [id],
  .settings-shell [data-settings-destination] {
    scroll-margin-block-start: 88px;
    scroll-margin-block-end: 80px;
  }

  .settings-shell [data-settings-destination]:focus-visible {
    outline: 2px solid var(--text-primary);
    outline-offset: 3px;
  }

  .settings-load-status:not([hidden]) {
    margin-bottom: 16px;
    padding: 12px;
    border: 1px solid var(--border);
    border-radius: 8px;
    background: var(--bg-secondary);
    color: var(--text-primary);
  }

  .settings-load-status p {
    margin: 0;
  }

  .settings-load-status button {
    margin-top: 8px;
  }

  @media (max-width: 860px) {
    .settings-bar {
      min-height: 48px;
      padding: 6px 12px;
      gap: 8px;
    }

    .settings-bar h1 {
      font-size: 1.05rem;
      white-space: nowrap;
      flex-shrink: 0;
    }

    .settings-bar__actions {
      flex-wrap: nowrap;
      gap: 6px;
      overflow-x: auto;
      scrollbar-width: none;
    }

    .settings-bar__actions::-webkit-scrollbar {
      display: none;
    }

    .settings-bar__actions > :is(button, a.btn) {
      min-height: 32px;
      height: 32px;
      padding: 0 9px;
      font-size: 0.75rem;
      white-space: nowrap;
      flex-shrink: 0;
    }

    .settings-bar__actions > :is(button, a.btn) svg {
      width: 14px;
      height: 14px;
    }

    #settings-sections-toggle {
      display: none;
    }

    .settings-shell {
      display: block;
      padding: 0 12px 24px;
    }

    .settings-shell [id],
    .settings-shell [data-settings-destination] {
      scroll-margin-block-start: 118px;
    }

    .settings-bar kbd {
      display: none;
    }
  }

  @media (max-width: 360px) {
    .settings-bar__actions > :is(button, a.btn) {
      padding-inline: 7px;
      font-size: 0.72rem;
    }

    .settings-bar button svg {
      display: none;
    }
  }
</style>

<style is:inline>
  .settings-field-head {
    display: flex;
    align-items: center;
    justify-content: flex-start;
    gap: 6px;
    flex-wrap: nowrap;
    min-width: 0;
  }

  .settings-field-head > label {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    width: auto;
    margin: 0;
  }

  .settings-help-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    inline-size: 26px;
    block-size: 26px;
    padding: 0;
    border: 1px solid transparent;
    border-radius: 9999px;
    background: transparent;
    color: var(--text-secondary);
    cursor: pointer;
    flex-shrink: 0;
    transition: background-color 140ms ease, color 140ms ease, border-color 140ms ease;
  }

  .settings-help-btn:hover,
  .settings-help-btn:focus-visible {
    color: var(--accent-text);
    background: color-mix(in srgb, var(--accent) 14%, transparent);
    border-color: color-mix(in srgb, var(--accent) 35%, transparent);
  }

  .settings-help-modal__body {
    display: grid;
    gap: 10px;
    color: var(--text-secondary);
    font-size: 0.9rem;
    line-height: 1.55;
  }

  .settings-help-modal__body p {
    margin: 0;
  }

  .settings-help-modal__tip {
    margin: 12px 0 0;
    padding: 10px 12px;
    border-radius: var(--radius-sm, 8px);
    border: 1px solid color-mix(in srgb, var(--accent) 32%, var(--border));
    background: color-mix(in srgb, var(--accent) 8%, var(--bg-secondary));
    color: var(--text-primary);
    font-size: 0.84rem;
    line-height: 1.45;
  }

  .settings-help-modal__env {
    margin: 12px 0 0;
    padding: 8px 10px;
    border-radius: var(--radius-sm, 8px);
    border: 1px solid var(--border);
    background: var(--bg-secondary);
    color: var(--text-primary);
    font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
    font-size: 0.8rem;
  }
</style>
