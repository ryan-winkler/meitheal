---
import Layout from "../layouts/Layout.astro";
import UnifiedBar from "../components/layout/UnifiedBar.astro";
import EmptyState from "../components/ui/EmptyState.astro";
import LabelBadges from "../components/ui/LabelBadges.astro";
import {
  ensureSchema,
  getPersistenceClient,
} from "@domains/tasks/persistence/store";
import { TaskRepository } from "@domains/tasks/persistence/task-repository";

interface DayGroup {
  date: string;
  label: string;
  isToday: boolean;
  isTomorrow: boolean;
  tasks: Record<string, unknown>[];
}

const days: DayGroup[] = [];

try {
  await ensureSchema();
  const repo = new TaskRepository(getPersistenceClient());
  const today = new Date();
  const todayStr = today.toISOString().split("T")[0] ?? "";

  // Persona 9: Single query for all 7 days instead of 7 sequential queries
  const endDate = new Date(today);
  endDate.setDate(endDate.getDate() + 6);
  const endStr = endDate.toISOString().split("T")[0] ?? "";

  const allTasks = await repo.getTasksInRange(todayStr, endStr);

  const tasksByDate = new Map<string, Record<string, unknown>[]>();
  for (const row of allTasks) {
    const d = String(row.due_date);
    if (!tasksByDate.has(d)) tasksByDate.set(d, []);
    tasksByDate.get(d)!.push(row);
  }

  for (let i = 0; i < 7; i++) {
    const d = new Date(today);
    d.setDate(d.getDate() + i);
    const dateStr = d.toISOString().split("T")[0] ?? "";

    const weekday = d.toLocaleDateString("en-US", { weekday: "long" });
    const monthDay = d.toLocaleDateString("en-US", {
      month: "short",
      day: "numeric",
    });

    let label = `${weekday}, ${monthDay}`;
    if (i === 0) label = `Today — ${monthDay}`;
    if (i === 1) label = `Tomorrow — ${monthDay}`;

    days.push({
      date: dateStr,
      label,
      isToday: i === 0,
      isTomorrow: i === 1,
      tasks: tasksByDate.get(dateStr) ?? [],
    });
  }
} catch {
  /* DB not available */
}

import {
  PRIORITY_LABELS as priorityLabels,
  PRIORITY_COLORS as priorityColors,
} from "../lib/priority-config";
import StatusBadge from "../components/ui/StatusBadge.astro";
import { STATUS_LABELS, normalizeStatus } from "../lib/status-config";
import { UPCOMING_SECTIONS } from "../lib/upcoming-registry";

const typeIcons: Record<string, string> = {
  epic: "🎯",
  story: "📖",
  task: "📌",
};

const totalTasks = days.reduce((sum, d) => sum + d.tasks.length, 0);
const nextDays = days.slice(0, 2)
const weekDays = days.slice(2)
const nextWindowCount = nextDays.reduce((sum, day) => sum + day.tasks.length, 0)
const weekAheadCount = weekDays.reduce((sum, day) => sum + day.tasks.length, 0)
const upcomingSignal =
  totalTasks === 0
    ? "No tasks scheduled in the next 7 days"
    : `${nextWindowCount} tasks due in the next 48 hours`
---

<Layout title="Meitheal — Upcoming">
  <UnifiedBar
    title="Upcoming"
    titleIcon="📅"
    tabs={UPCOMING_SECTIONS.map((section) => ({
      id: section.id,
      label: section.label,
      icon: section.icon,
    }))}
    searchPlaceholder="Search Meitheal…"
    searchScope="all"
    barId="upcoming-bar"
    slot="custom-header"
  />

  <div id="upcoming-shell" class="page-shell">
    <section
      id="upcoming-overview"
      class="page-shell__section page-shell__section--overview"
      data-upcoming-section
    >
      <div class="page-hero">
        <div class="page-hero__eyebrow">Home Assistant Native Planning Horizon</div>
        <div class="page-hero__title-row">
          <div class="page-hero__copy">
            <h1 class="page-hero__title">See the next week without losing today</h1>
            <p class="page-hero__description">
              Upcoming keeps the next 48 hours separate from the rest of the week so
              you can scan, complete, and hand work back to Today or Calendar without
              rebuilding context.
            </p>
          </div>

          <div class="page-hero__chips" aria-label="Upcoming quick jumps">
            <a href="#upcoming-next" class="page-hero__chip" data-upcoming-section-link>
              Next 48h
            </a>
            <a href="#upcoming-week" class="page-hero__chip" data-upcoming-section-link>
              Week Ahead
            </a>
            <a href="#upcoming-flow" class="page-hero__chip" data-upcoming-section-link>
              Flow
            </a>
          </div>
        </div>

        <div class="page-hero__status">
          <span class="page-hero__status-label">Current signal</span>
          <strong id="upcoming-signal-summary">{upcomingSignal}</strong>
        </div>
      </div>

      <div class="page-summary-grid">
        <div class="stat-card">
          <span class="stat-value">{totalTasks}</span>
          <span class="stat-label">Next 7 Days</span>
        </div>
        <div class="stat-card">
          <span class="stat-value">{nextWindowCount}</span>
          <span class="stat-label">Next 48h</span>
        </div>
        <div class="stat-card">
          <span class="stat-value">{weekAheadCount}</span>
          <span class="stat-label">Week Ahead</span>
        </div>
      </div>

      {
        totalTasks === 0 && (
          <EmptyState
            title="No upcoming tasks"
            description="Your schedule is clear for the next 7 days."
            actionText="Plan something"
            actionHref="/table"
          />
        )
      }
    </section>

    <section id="upcoming-next" class="page-shell__section" data-upcoming-section>
      <div class="page-shell__intro">
        <div>
          <div class="page-shell__eyebrow">Next 48h</div>
          <h2 class="page-shell__title">Prioritize the immediate commitment window</h2>
          <p class="page-shell__description">
            Today and tomorrow stay grouped here for fast completion and fast task-detail handoff.
          </p>
        </div>
      </div>

      <div class="upcoming-grid">
        {
          nextDays.map((day) => (
            <div
              class={`card ${day.tasks.length === 0 ? "day-empty" : ""}`}
              style={`margin-bottom: ${day.tasks.length > 0 ? "12px" : "4px"}; ${day.isToday ? "border-left: 3px solid var(--accent);" : ""}`}
            >
              <div
                class="day-header"
                style={`padding: ${day.tasks.length > 0 ? "10px 16px" : "8px 16px"}; display: flex; align-items: center; justify-content: space-between; user-select: none;`}
                role="button"
                tabindex="0"
                aria-expanded="true"
              >
                <div style="display: flex; align-items: center; gap: 8px;">
                  <svg class="chevron-icon" xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="transition: transform 0.2s;"><path d="m6 9 6 6 6-6"/></svg>
                  <span
                    style={`font-size: 13px; font-weight: ${day.isToday || day.isTomorrow ? "600" : "500"}; color: ${day.isToday ? "var(--accent)" : "var(--text-primary)"};`}
                  >
                    {day.label}
                  </span>
                </div>
                {day.tasks.length > 0 && (
                  <span style="font-size: 11px; background: var(--accent); color: white; padding: 1px 6px; border-radius: 8px; font-weight: 600;">
                    {day.tasks.length}
                  </span>
                )}
                {day.tasks.length === 0 && (
                  <span style="font-size: 11px; color: var(--text-muted); font-style: italic;">
                    —
                  </span>
                )}
              </div>
              {day.tasks.length > 0 && (
                <div class="task-list">
                  {day.tasks.map((task) => {
                    const p = Number(task.priority ?? 3);
                    const tt = String(task.task_type ?? "task");
                    return (
                      <div
                        class="task-item"
                        data-id={String(task.id)}
                        style="cursor:pointer; padding: 8px 16px; display: flex; align-items: center; gap: 10px; border-top: 1px solid var(--border); transition: background 0.15s;"
                        role="button"
                        tabindex="0"
                        aria-label={`${String(task.title)}, priority ${priorityLabels[p] ?? "Medium"}, due ${day.label}`}
                      >
                        <input
                          type="checkbox"
                          class="task-checkbox"
                          data-id={String(task.id)}
                          aria-label={`Complete ${String(task.title)}`}
                        />
                        <span
                          style={`color: ${priorityColors[p] ?? "#3b82f6"}; font-size: 10px; flex-shrink: 0;`}
                          title={`Priority: ${priorityLabels[p] ?? "Medium"}`}
                        >
                          ●
                        </span>
                        <div style="flex: 1; min-width: 0;">
                          <div style="font-size: 13px; font-weight: 500; white-space: nowrap; overflow: hidden; text-overflow: ellipsis;">
                            <span style="margin-right: 3px; font-size: 11px;">
                              {typeIcons[tt] ?? ""}
                            </span>
                            {String(task.title)}
                          </div>
                          <div class="flex items-center gap-2 mt-2">
                            <LabelBadges labels={task.labels as string} compact max={3} />
                          </div>
                        </div>
                        <StatusBadge status={String(task.status)} />
                        {task.color && (
                          <span
                            style={`width: 4px; height: 20px; border-radius: 2px; background: ${String(task.color)}; flex-shrink: 0;`}
                          />
                        )}
                        {task.recurrence_rule && (
                          <span
                            style="font-size: 10px; color: var(--text-muted);"
                            title="Recurring"
                          >
                            🔁
                          </span>
                        )}
                        {(() => {
                          try {
                            const cl = task.checklists ? (typeof task.checklists === "string" ? JSON.parse(String(task.checklists)) : task.checklists) : [];
                            if (Array.isArray(cl) && cl.length > 0) {
                              const done = cl.filter((i: {done: boolean}) => i.done).length;
                              return (
                                <span
                                  style={`font-size: 10px; color: ${done === cl.length ? 'var(--success)' : 'var(--text-muted)'};`}
                                  title={`Checklist: ${done}/${cl.length}`}
                                >
                                  ✓ {done}/{cl.length}
                                </span>
                              );
                            }
                          } catch { /* skip */ }
                          return null;
                        })()}
                        {task.assigned_to && (
                          <span
                            class="avatar avatar--sm"
                            title={`Assigned to ${String(task.assigned_to)}`}
                            aria-label={`Assigned to ${String(task.assigned_to)}`}
                          >
                            {String(task.assigned_to)
                              .replace(/^(ha_|custom_)/, "")
                              .slice(0, 2)
                              .toUpperCase()}
                          </span>
                        )}
                      </div>
                    );
                  })}
                </div>
              )}
            </div>
          ))
        }
      </div>
    </section>

    <section id="upcoming-week" class="page-shell__section" data-upcoming-section>
      <div class="page-shell__intro">
        <div>
          <div class="page-shell__eyebrow">Week Ahead</div>
          <h2 class="page-shell__title">Keep the rest of the week visible but lightweight</h2>
          <p class="page-shell__description">
            The remaining grouped days stay collapsible so future work feels scannable, not overwhelming.
          </p>
        </div>
      </div>

      <div class="upcoming-grid">
        {
          weekDays.map((day) => (
            <div
              class={`card ${day.tasks.length === 0 ? "day-empty" : ""}`}
              style={`margin-bottom: ${day.tasks.length > 0 ? "12px" : "4px"}; ${day.isToday ? "border-left: 3px solid var(--accent);" : ""}`}
            >
              <div
                class="day-header"
                style={`padding: ${day.tasks.length > 0 ? "10px 16px" : "8px 16px"}; display: flex; align-items: center; justify-content: space-between; user-select: none;`}
                role="button"
                tabindex="0"
                aria-expanded="true"
              >
                <div style="display: flex; align-items: center; gap: 8px;">
                  <svg class="chevron-icon" xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="transition: transform 0.2s;"><path d="m6 9 6 6 6-6"/></svg>
                  <span style="font-size: 13px; font-weight: 500; color: var(--text-primary);">
                    {day.label}
                  </span>
                </div>
                {day.tasks.length > 0 && (
                  <span style="font-size: 11px; background: var(--accent); color: white; padding: 1px 6px; border-radius: 8px; font-weight: 600;">
                    {day.tasks.length}
                  </span>
                )}
                {day.tasks.length === 0 && (
                  <span style="font-size: 11px; color: var(--text-muted); font-style: italic;">
                    —
                  </span>
                )}
              </div>
              {day.tasks.length > 0 && (
                <div class="task-list">
                  {day.tasks.map((task) => {
                    const p = Number(task.priority ?? 3);
                    const tt = String(task.task_type ?? "task");
                    return (
                      <div
                        class="task-item"
                        data-id={String(task.id)}
                        style="cursor:pointer; padding: 8px 16px; display: flex; align-items: center; gap: 10px; border-top: 1px solid var(--border); transition: background 0.15s;"
                        role="button"
                        tabindex="0"
                        aria-label={`${String(task.title)}, priority ${priorityLabels[p] ?? "Medium"}, due ${day.label}`}
                      >
                        <input
                          type="checkbox"
                          class="task-checkbox"
                          data-id={String(task.id)}
                          aria-label={`Complete ${String(task.title)}`}
                        />
                        <span
                          style={`color: ${priorityColors[p] ?? "#3b82f6"}; font-size: 10px; flex-shrink: 0;`}
                          title={`Priority: ${priorityLabels[p] ?? "Medium"}`}
                        >
                          ●
                        </span>
                        <div style="flex: 1; min-width: 0;">
                          <div style="font-size: 13px; font-weight: 500; white-space: nowrap; overflow: hidden; text-overflow: ellipsis;">
                            <span style="margin-right: 3px; font-size: 11px;">
                              {typeIcons[tt] ?? ""}
                            </span>
                            {String(task.title)}
                          </div>
                          <div class="flex items-center gap-2 mt-2">
                            <LabelBadges labels={task.labels as string} compact max={3} />
                          </div>
                        </div>
                        <StatusBadge status={String(task.status)} />
                        {task.color && (
                          <span
                            style={`width: 4px; height: 20px; border-radius: 2px; background: ${String(task.color)}; flex-shrink: 0;`}
                          />
                        )}
                        {task.recurrence_rule && (
                          <span
                            style="font-size: 10px; color: var(--text-muted);"
                            title="Recurring"
                          >
                            🔁
                          </span>
                        )}
                        {(() => {
                          try {
                            const cl = task.checklists ? (typeof task.checklists === "string" ? JSON.parse(String(task.checklists)) : task.checklists) : [];
                            if (Array.isArray(cl) && cl.length > 0) {
                              const done = cl.filter((i: {done: boolean}) => i.done).length;
                              return (
                                <span
                                  style={`font-size: 10px; color: ${done === cl.length ? 'var(--success)' : 'var(--text-muted)'};`}
                                  title={`Checklist: ${done}/${cl.length}`}
                                >
                                  ✓ {done}/{cl.length}
                                </span>
                              );
                            }
                          } catch { /* skip */ }
                          return null;
                        })()}
                        {task.assigned_to && (
                          <span
                            class="avatar avatar--sm"
                            title={`Assigned to ${String(task.assigned_to)}`}
                            aria-label={`Assigned to ${String(task.assigned_to)}`}
                          >
                            {String(task.assigned_to)
                              .replace(/^(ha_|custom_)/, "")
                              .slice(0, 2)
                              .toUpperCase()}
                          </span>
                        )}
                      </div>
                    );
                  })}
                </div>
              )}
            </div>
          ))
        }
      </div>
    </section>

    <section id="upcoming-flow" class="page-shell__section" data-upcoming-section>
      <div class="page-shell__intro">
        <div>
          <div class="page-shell__eyebrow">Flow</div>
          <h2 class="page-shell__title">Move back to execution or into planning without reorienting</h2>
          <p class="page-shell__description">
            Upcoming is the bridge between the daily cockpit and the calendar horizon.
          </p>
        </div>
      </div>

      <div class="page-flow-grid">
        <a class="card page-flow-card" href="/today">
          <strong>☀️ Back to Today</strong>
          <p>Return to the focused execution surface when a scheduled task becomes immediate.</p>
        </a>
        <a class="card page-flow-card" href="/calendar">
          <strong>🗓️ Open Calendar</strong>
          <p>Move into month planning and connected event context when the week needs reshaping.</p>
        </a>
      </div>
    </section>
  </div>
</Layout>

<style>
  .day-header {
    transition: background 0.15s;
    cursor: pointer;
  }
  .day-header:hover {
    background: var(--bg-hover);
  }
  .day-header[aria-expanded="false"] .chevron-icon {
    transform: rotate(-90deg);
  }
  .task-list {
    transition: max-height 0.3s cubic-bezier(0.4, 0, 0.2, 1), opacity 0.3s cubic-bezier(0.4, 0, 0.2, 1);
    max-height: 2000px;
    opacity: 1;
    overflow: hidden;
  }
  .task-list.collapsed {
    max-height: 0;
    opacity: 0;
    pointer-events: none;
  }

  .day-empty {
    opacity: 0.6;
  }
  .day-empty:hover {
    opacity: 0.8;
  }
  .task-item:hover {
    background: var(--bg-hover);
  }
  .task-item:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: -2px;
  }
  .status-badge {
    display: inline-block;
    font-size: 10px;
    font-weight: 600;
    padding: 2px 8px;
    border-radius: 8px;
    text-transform: uppercase;
    letter-spacing: 0.3px;
    white-space: nowrap;
    flex-shrink: 0;
  }
  .status-badge--pending {
    background: rgba(var(--info-rgb), 0.12);
    color: var(--info);
  }
  .status-badge--active {
    background: rgba(var(--success-rgb), 0.12);
    color: var(--success);
  }
  .status-badge--backlog {
    background: rgba(var(--text-muted-rgb), 0.12);
    color: var(--text-muted);
  }
  .status-badge--complete {
    background: rgba(var(--success-rgb), 0.15);
    color: var(--success);
  }

  /* Responsive overrides for shell/hero classes are in _page-shell.css */
</style>

<script>
  import { initUpcomingPage } from "../lib/upcoming-controller"
  import { pageLifecycle } from "../lib/page-lifecycle"

  pageLifecycle.onPageLoad(() => {
    initUpcomingPage()
  })
</script>
