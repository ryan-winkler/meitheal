---
import Layout from "../layouts/Layout.astro";
import UnifiedBar from "../components/layout/UnifiedBar.astro";
import EmptyState from "../components/ui/EmptyState.astro";
import LabelBadges from "../components/ui/LabelBadges.astro";
import {
  ensureSchema,
  getPersistenceClient,
} from "@domains/tasks/persistence/store";
import { TaskRepository } from "@domains/tasks/persistence/task-repository";

interface DayGroup {
  date: string;
  label: string;
  isToday: boolean;
  isTomorrow: boolean;
  tasks: Record<string, unknown>[];
}

const days: DayGroup[] = [];

try {
  await ensureSchema();
  const repo = new TaskRepository(getPersistenceClient());
  const today = new Date();
  const todayStr = today.toISOString().split("T")[0] ?? "";

  // Persona 9: Single query for all 7 days instead of 7 sequential queries
  const endDate = new Date(today);
  endDate.setDate(endDate.getDate() + 6);
  const endStr = endDate.toISOString().split("T")[0] ?? "";

  const allTasks = await repo.getTasksInRange(todayStr, endStr);

  const tasksByDate = new Map<string, Record<string, unknown>[]>();
  for (const row of allTasks) {
    const d = String(row.due_date);
    if (!tasksByDate.has(d)) tasksByDate.set(d, []);
    tasksByDate.get(d)!.push(row);
  }

  for (let i = 0; i < 7; i++) {
    const d = new Date(today);
    d.setDate(d.getDate() + i);
    const dateStr = d.toISOString().split("T")[0] ?? "";

    const weekday = d.toLocaleDateString("en-US", { weekday: "long" });
    const monthDay = d.toLocaleDateString("en-US", {
      month: "short",
      day: "numeric",
    });

    let label = `${weekday}, ${monthDay}`;
    if (i === 0) label = `Today — ${monthDay}`;
    if (i === 1) label = `Tomorrow — ${monthDay}`;

    days.push({
      date: dateStr,
      label,
      isToday: i === 0,
      isTomorrow: i === 1,
      tasks: tasksByDate.get(dateStr) ?? [],
    });
  }
} catch {
  /* DB not available */
}

import {
  PRIORITY_LABELS as priorityLabels,
  PRIORITY_COLORS as priorityColors,
} from "../lib/priority-config";
import StatusBadge from "../components/ui/StatusBadge.astro";
import { STATUS_LABELS, normalizeStatus } from "../lib/status-config";
import { UPCOMING_SECTIONS } from "../lib/upcoming-registry";
import { buildTaskPath } from "../lib/task-detail-handoff"

const typeIcons: Record<string, string> = {
  epic: "🎯",
  story: "📖",
  task: "📌",
};

const totalTasks = days.reduce((sum, d) => sum + d.tasks.length, 0);
const nextDays = days.slice(0, 2)
const weekDays = days.slice(2)
const daySections = [
  {
    id: "upcoming-next",
    eyebrow: "Next 48h",
    title: "Prioritize the immediate commitment window",
    description: "Today and tomorrow stay grouped here for fast completion and fast task-detail handoff.",
    days: nextDays,
  },
  {
    id: "upcoming-week",
    eyebrow: "Week Ahead",
    title: "Keep the rest of the week visible but lightweight",
    description: "The remaining grouped days stay collapsible so future work feels scannable, not overwhelming.",
    days: weekDays,
  },
]
const nextWindowCount = nextDays.reduce((sum, day) => sum + day.tasks.length, 0)
const weekAheadCount = weekDays.reduce((sum, day) => sum + day.tasks.length, 0)
const upcomingSignal =
  totalTasks === 0
    ? "No tasks scheduled in the next 7 days"
    : `${nextWindowCount} tasks due in the next 48 hours`

function renderDayClass(day: DayGroup): string {
  const classes = ["card"]
  if (day.tasks.length === 0) classes.push("day-empty")
  if (day.tasks.length > 0) classes.push("day-card--populated")
  if (day.isToday) classes.push("day-card--today")
  return classes.join(" ")
}

function dayLabelClass(day: DayGroup): string {
  const classes = ["day-label"]
  if (day.isToday || day.isTomorrow) classes.push("day-label--highlight")
  if (day.isToday) classes.push("day-label--today")
  return classes.join(" ")
}
---

<Layout title="Meitheal — Upcoming">
  <UnifiedBar
    title="Upcoming"
    titleIcon="📅"
    tabs={UPCOMING_SECTIONS.map((section) => ({
      id: section.id,
      label: section.label,
      icon: section.icon,
    }))}
    searchPlaceholder="Search Meitheal…"
    searchScope="all"
    barId="upcoming-bar"
    slot="custom-header"
  />

  <div id="upcoming-shell" class="page-shell">
    <section
      id="upcoming-overview"
      class="page-shell__section page-shell__section--overview"
      data-upcoming-section
    >
      <div class="page-hero">
        <div class="page-hero__eyebrow">Home Assistant Native Planning Horizon</div>
        <div class="page-hero__title-row">
          <div class="page-hero__copy">
            <h1 class="page-hero__title">See the next week without losing today</h1>
            <p class="page-hero__description">
              Upcoming keeps the next 48 hours separate from the rest of the week so
              you can scan, complete, and hand work back to Today or Calendar without
              rebuilding context.
            </p>
          </div>

          <div class="page-hero__chips" aria-label="Upcoming quick jumps">
            <a href="#upcoming-next" class="page-hero__chip" data-upcoming-section-link>
              Next 48h
            </a>
            <a href="#upcoming-week" class="page-hero__chip" data-upcoming-section-link>
              Week Ahead
            </a>
            <a href="#upcoming-flow" class="page-hero__chip" data-upcoming-section-link>
              Flow
            </a>
          </div>
        </div>

        <div class="page-hero__status">
          <span class="page-hero__status-label">Current signal</span>
          <strong id="upcoming-signal-summary">{upcomingSignal}</strong>
        </div>
      </div>

      <div class="page-summary-grid">
        <div class="stat-card">
          <span class="stat-value">{totalTasks}</span>
          <span class="stat-label">Next 7 Days</span>
        </div>
        <div class="stat-card">
          <span class="stat-value">{nextWindowCount}</span>
          <span class="stat-label">Next 48h</span>
        </div>
        <div class="stat-card">
          <span class="stat-value">{weekAheadCount}</span>
          <span class="stat-label">Week Ahead</span>
        </div>
      </div>

      {
        totalTasks === 0 && (
          <EmptyState
            title="No upcoming tasks"
            description="Your schedule is clear for the next 7 days."
            actionText="Plan something"
            actionHref="/table"
          />
        )
      }
    </section>

    {daySections.map((section) => (
      <section id={section.id} class="page-shell__section" data-upcoming-section>
        <div class="page-shell__intro">
          <div>
            <div class="page-shell__eyebrow">{section.eyebrow}</div>
            <h2 class="page-shell__title">{section.title}</h2>
            <p class="page-shell__description">{section.description}</p>
          </div>
        </div>

        <div class="upcoming-grid">
          {
            section.days.map((day) => (
              <div class={renderDayClass(day)}>
                <div
                  class={`day-header ${day.tasks.length > 0 ? "day-header--populated" : ""}`}
                  role="button"
                  tabindex="0"
                  aria-expanded="true"
                >
                  <div class="day-header__left">
                    <svg class="chevron-icon" xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m6 9 6 6 6-6"/></svg>
                    <span class={dayLabelClass(day)}>
                      {day.label}
                    </span>
                  </div>
                  {day.tasks.length > 0 && (
                    <span class="day-count-badge">{day.tasks.length}</span>
                  )}
                  {day.tasks.length === 0 && (
                    <span class="day-count-empty">—</span>
                  )}
                </div>
                {day.tasks.length > 0 && (
                  <div class="task-list">
                    {day.tasks.map((task) => {
                      const id = String(task.id)
                      const title = String(task.title)
                      const p = Number(task.priority ?? 3)
                      const tt = String(task.task_type ?? "task")
                      const descriptionId = `upcoming-task-description-${id}`
                      return (
                        <div class="task-item" data-id={id}>
                          <input
                            type="checkbox"
                            class="task-checkbox"
                            data-id={id}
                            aria-label={`Complete ${title}`}
                          />
                          <span
                            class="priority-dot"
                            style={`color: ${priorityColors[p] ?? "#3b82f6"};`}
                            title={`Priority: ${priorityLabels[p] ?? "Medium"}`}
                          >
                            ●
                          </span>
                          <div class="task-content">
                            <div class="task-title">
                              <a
                                class="task-detail-link"
                                href={buildTaskPath(id)}
                                data-task-detail-link={id}
                                aria-describedby={descriptionId}
                              >
                                <span class="task-type-icon" aria-hidden="true">
                                  {typeIcons[tt] ?? ""}
                                </span>
                                {title}
                              </a>
                              <span class="sr-only" id={descriptionId}>
                                Priority {priorityLabels[p] ?? "Medium"}, due {day.label}
                              </span>
                            </div>
                            <div class="task-labels">
                              <LabelBadges labels={task.labels as string} compact max={3} />
                            </div>
                          </div>
                          <StatusBadge status={String(task.status)} />
                          {task.color && (
                            <span
                              class="task-color-swatch"
                              style={`background: ${String(task.color)};`}
                            />
                          )}
                          {task.recurrence_rule && (
                            <span class="task-meta-icon" title="Recurring">🔁</span>
                          )}
                          {(() => {
                            try {
                              const cl = task.checklists ? (typeof task.checklists === "string" ? JSON.parse(String(task.checklists)) : task.checklists) : [];
                              if (Array.isArray(cl) && cl.length > 0) {
                                const done = cl.filter((i: {done: boolean}) => i.done).length;
                                return (
                                  <span
                                    class={`task-checklist-count ${done === cl.length ? "task-checklist-count--complete" : ""}`}
                                    title={`Checklist: ${done}/${cl.length}`}
                                  >
                                    ✓ {done}/{cl.length}
                                  </span>
                                );
                              }
                            } catch { /* skip */ }
                            return null;
                          })()}
                          {task.assigned_to && (
                            <span
                              class="avatar avatar--sm"
                              role="img"
                              title={`Assigned to ${String(task.assigned_to)}`}
                              aria-label={`Assigned to ${String(task.assigned_to)}`}
                            >
                              {String(task.assigned_to)
                                .replace(/^(ha_|custom_)/, "")
                                .slice(0, 2)
                                .toUpperCase()}
                            </span>
                          )}
                        </div>
                      );
                    })}
                  </div>
                )}
              </div>
            ))
          }
        </div>
      </section>
    ))}

    <section id="upcoming-flow" class="page-shell__section" data-upcoming-section>
      <div class="page-shell__intro">
        <div>
          <div class="page-shell__eyebrow">Flow</div>
          <h2 class="page-shell__title">Move back to execution or into planning without reorienting</h2>
          <p class="page-shell__description">
            Upcoming is the bridge between the daily cockpit and the calendar horizon.
          </p>
        </div>
      </div>

      <div class="page-flow-grid">
        <a class="card page-flow-card" href="/today">
          <strong>☀️ Back to Today</strong>
          <p>Return to the focused execution surface when a scheduled task becomes immediate.</p>
        </a>
        <a class="card page-flow-card" href="/calendar">
          <strong>🗓️ Open Calendar</strong>
          <p>Move into month planning and connected event context when the week needs reshaping.</p>
        </a>
      </div>
    </section>
  </div>
</Layout>

<style>
  #upcoming-shell,
  [data-upcoming-section] {
    grid-template-columns: minmax(0, 1fr);
  }

  /* ── Day card ── */
  .day-card--populated {
    margin-bottom: 12px;
  }
  .day-card--today {
    border-left: 3px solid var(--accent);
  }

  /* ── Day header ── */
  .day-header {
    padding: 8px 16px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    user-select: none;
    cursor: pointer;
    transition: background 0.15s;
  }
  .day-header--populated {
    padding: 10px 16px;
  }
  .day-header:hover {
    background: var(--bg-hover);
  }
  .day-header[aria-expanded="false"] .chevron-icon {
    transform: rotate(-90deg);
  }
  .day-header__left {
    display: flex;
    align-items: center;
    gap: 8px;
  }

  /* ── Chevron ── */
  .chevron-icon {
    transition: transform 0.2s;
  }

  /* ── Day label ── */
  .day-label {
    font-size: 13px;
    font-weight: 500;
    color: var(--text-primary);
  }
  .day-label--highlight {
    font-weight: 600;
  }
  .day-label--today {
    color: var(--accent-text);
  }

  /* ── Count badges ── */
  .day-count-badge {
    font-size: 11px;
    background: var(--personal-accent, var(--palette-accent-hover));
    color: var(--personal-accent-foreground, #fff);
    padding: 1px 6px;
    border-radius: 8px;
    font-weight: 600;
  }
  .day-count-empty {
    font-size: 11px;
    color: var(--text-muted);
    font-style: italic;
  }

  /* ── Task list collapse ── */
  .task-list {
    transition: max-height 0.3s cubic-bezier(0.4, 0, 0.2, 1), opacity 0.3s cubic-bezier(0.4, 0, 0.2, 1);
    max-height: 2000px;
    opacity: 1;
    overflow: hidden;
  }
  .task-list.collapsed {
    max-height: 0;
    opacity: 0;
    pointer-events: none;
  }

  /* ── Day empty state ── */
  .day-empty {
    opacity: 0.6;
    margin-bottom: 4px;
  }
  .day-empty:hover {
    opacity: 0.8;
  }

  /* ── Task item ── */
  .task-item {
    cursor: pointer;
    padding: 8px 16px;
    display: flex;
    align-items: center;
    gap: 10px;
    border-top: 1px solid var(--border);
    transition: background 0.15s;
  }
  .task-item:hover {
    background: var(--bg-hover);
  }
  .task-checkbox {
    width: 44px;
    height: 44px;
    appearance: auto;
    accent-color: var(--accent);
  }

  /* ── Priority dot ── */
  .priority-dot {
    font-size: 10px;
    flex-shrink: 0;
  }

  /* ── Task content ── */
  .task-content {
    flex: 1;
    min-width: 44px;
  }
  .task-title {
    font-size: 13px;
    font-weight: 500;
  }
  .task-detail-link {
    display: block;
    line-height: 44px;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    color: inherit;
    text-decoration: underline;
    text-underline-offset: 2px;
  }
  .task-detail-link:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: -2px;
  }
  .task-type-icon {
    font-size: 11px;
  }
  .task-labels {
    display: flex;
    align-items: center;
    gap: 4px;
    margin-top: 4px;
  }

  /* ── Task color swatch ── */
  .task-color-swatch {
    width: 4px;
    height: 20px;
    border-radius: 2px;
    flex-shrink: 0;
  }

  /* ── Task meta icons ── */
  .task-meta-icon {
    font-size: 10px;
    color: var(--text-muted);
  }

  /* ── Checklist count ── */
  .task-checklist-count {
    font-size: 10px;
    color: var(--text-muted);
  }
  .task-checklist-count--complete {
    color: var(--success);
  }

  /* ── Status badge (also used by StatusBadge component fallback) ── */
  .status-badge {
    display: inline-block;
    font-size: 10px;
    font-weight: 600;
    padding: 2px 8px;
    border-radius: 8px;
    text-transform: uppercase;
    letter-spacing: 0.3px;
    white-space: nowrap;
    flex-shrink: 0;
  }
  .status-badge--pending {
    background: rgba(var(--info-rgb), 0.12);
    color: var(--info);
  }
  .status-badge--active {
    background: rgba(var(--success-rgb), 0.12);
    color: var(--success);
  }
  .status-badge--backlog {
    background: rgba(var(--text-muted-rgb), 0.12);
    color: var(--text-muted);
  }
  .status-badge--complete {
    background: rgba(var(--success-rgb), 0.15);
    color: var(--success);
  }

  /* ── Accessibility: reduced motion ── */
  @media (prefers-reduced-motion: reduce) {
    .task-list { transition: none; }
    .task-item { transition: none; }
    .day-header { transition: none; }
    .chevron-icon { transition: none; }
  }

  /* Responsive overrides for shell/hero classes are in _page-shell.css */
</style>

<script>
  import { initUpcomingPage } from "../lib/upcoming-controller"
  import { pageLifecycle } from "../lib/page-lifecycle"

  pageLifecycle.onPageLoad(() => {
    initUpcomingPage()
  })
</script>
