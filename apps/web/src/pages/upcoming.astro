---
import { boardContextHref } from "@lib/board-workspace"
import { readBoardPagePlacement } from "@lib/board-page-placement"
import { resolveBoardPageScope, boardScopeResponse } from "@lib/board-http"

import Layout from "../layouts/Layout.astro";
import UnifiedBar from "../components/layout/UnifiedBar.astro";
import EmptyState from "../components/ui/EmptyState.astro";
import Icon from "../components/ui/Icon.astro"
import TaskTypeIcon from "../components/ui/TaskTypeIcon.astro";
import LabelBadges from "../components/ui/LabelBadges.astro";
import { effectiveTaskScheduledDate } from "@meitheal/domain-tasks";
import {
  ensureSchema,
  getPersistenceClient,
} from "@domains/tasks/persistence/store";
import { TaskRepository } from "@domains/tasks/persistence/task-repository";
import { calendarEventSpanDays, calendarToday, shiftCalendarDay } from "../lib/date";

interface DayGroup {
  date: string;
  label: string;
  isToday: boolean;
  isTomorrow: boolean;
  tasks: Record<string, unknown>[];
}

const workScopeResult = await resolveBoardPageScope(Astro, { boardId: Astro.props.boardId })
if (!workScopeResult.ok) return boardScopeResponse(workScopeResult.errorCode)
const workScope = workScopeResult.scope
const pagePlacement = await readBoardPagePlacement(workScope, Astro.url)
if (!pagePlacement.ok) return boardScopeResponse(pagePlacement.errorCode)
const placement = pagePlacement.placement
const contextHref = (path: string) => boardContextHref({ boardId: workScope.boardId, area: pagePlacement.area?.id, project: pagePlacement.project?.id }, path)

const days: DayGroup[] = [];
const upcomingTimeZone = Astro.locals.timezone || "Europe/Dublin";

try {
  await ensureSchema();
  const repo = new TaskRepository(getPersistenceClient(), workScope);
  const todayStr = calendarToday(upcomingTimeZone);

  // Persona 9: Single query for all 7 days instead of 7 sequential queries
  const endStr = shiftCalendarDay(todayStr, 6);

  const allTasks = await repo.getTasksInRange(todayStr, endStr, upcomingTimeZone, placement);

  const tasksByDate = new Map<string, Record<string, unknown>[]>();
  for (const row of allTasks) {
    const span = calendarEventSpanDays({
      task_kind: typeof row.task_kind === "string" ? row.task_kind : null,
      due_date: row.due_date == null ? null : String(row.due_date),
      start_date: row.start_date == null ? null : String(row.start_date),
      end_date: row.end_date == null ? null : String(row.end_date),
      calendar_sync_state: row.calendar_sync_state == null ? null : String(row.calendar_sync_state),
    }, upcomingTimeZone);
    if (!span) continue;
    const { startDay, endDay } = span;
    const d = row.task_kind === "calendar_event" && startDay < todayStr && endDay >= todayStr ? todayStr : startDay;
    if (!tasksByDate.has(d)) tasksByDate.set(d, []);
    tasksByDate.get(d)!.push(row);
  }

  for (let i = 0; i < 7; i++) {
    const dateStr = shiftCalendarDay(todayStr, i);
    const d = new Date(`${dateStr}T12:00:00Z`);

    const weekday = d.toLocaleDateString("en-US", { weekday: "long", timeZone: "UTC" });
    const monthDay = d.toLocaleDateString("en-US", {
      month: "short",
      day: "numeric",
      timeZone: "UTC",
    });

    let label = `${weekday}, ${monthDay}`;
    if (i === 0) label = `Today — ${monthDay}`;
    if (i === 1) label = `Tomorrow — ${monthDay}`;

    days.push({
      date: dateStr,
      label,
      isToday: i === 0,
      isTomorrow: i === 1,
      tasks: tasksByDate.get(dateStr) ?? [],
    });
  }
} catch {
  /* DB not available */
}

import {
  PRIORITY_LABELS as priorityLabels,
  PRIORITY_COLORS as priorityColors,
} from "../lib/priority-config";
import StatusBadge from "../components/ui/StatusBadge.astro";
import { STATUS_LABELS, normalizeStatus } from "../lib/status-config";
import { UPCOMING_SECTIONS } from "../lib/upcoming-registry";
import { taskDetailPath } from "../lib/task-page-url"
import { taskSurface } from "../lib/task-surface"
import { formatTicketKey } from "../lib/ticket-key"

const daysLoaded = days.length === 7
const unavailableMessage = "Upcoming tasks couldn’t load. Refresh the page to try again."
const totalTasks = days.reduce((sum, d) => sum + d.tasks.length, 0);
const nextDays = days.slice(0, 2)
const weekDays = days.slice(2)
const daySections = [
  {
    id: "upcoming-next",
    title: "Today and tomorrow",
    days: nextDays,
  },
  {
    id: "upcoming-week",
    title: "Following five days",
    days: weekDays,
  },
]
const nextWindowCount = nextDays.reduce((sum, day) => sum + day.tasks.length, 0)
const weekAheadCount = weekDays.reduce((sum, day) => sum + day.tasks.length, 0)
function renderDayClass(day: DayGroup): string {
  const classes = ["card"]
  if (day.tasks.length === 0) classes.push("day-empty")
  if (day.tasks.length > 0) classes.push("day-card--populated")
  if (day.isToday) classes.push("day-card--today")
  return classes.join(" ")
}

function dayLabelClass(day: DayGroup): string {
  const classes = ["day-label"]
  if (day.isToday || day.isTomorrow) classes.push("day-label--highlight")
  if (day.isToday) classes.push("day-label--today")
  return classes.join(" ")
}
---

<Layout title="Meitheal — Upcoming">
  <UnifiedBar
    title="Upcoming"
    titleIcon="calendar"
    tabs={UPCOMING_SECTIONS.map((section) => ({
      id: section.id,
      label: section.label,
      icon: section.icon,
    }))}
    searchPlaceholder="Search Meitheal…"
    searchScope="all"
    barId="upcoming-bar"
    slot="custom-header"
  />

  <div id="upcoming-shell" class="page-shell">
    <section
      id="upcoming-overview"
      class="page-shell__section page-shell__section--overview"
      data-upcoming-section
    >
      <h1 class="m-0 text-2xl font-semibold tracking-tight">Upcoming</h1>
      {daysLoaded ? <div class="page-summary-grid">
        <div class="stat-card">
          <span class="stat-value">{totalTasks}</span>
          <span class="stat-label">Next 7 Days</span>
        </div>
        <div class="stat-card">
          <span class="stat-value">{nextWindowCount}</span>
          <span class="stat-label">Today and tomorrow</span>
        </div>
        <div class="stat-card">
          <span class="stat-value">{weekAheadCount}</span>
          <span class="stat-label">Following five days</span>
        </div>
      </div> : <p role="status" class="m-0 text-text-secondary">{unavailableMessage}</p>}

      {
        daysLoaded && totalTasks === 0 && (
          <EmptyState
            title="No upcoming tasks"
            description="Your schedule is clear for the next 7 days."
            actionText="Plan something"
            actionHref={contextHref("/tasks?view=table#table")}
          />
        )
      }
    </section>

    {daySections.map((section) => (
      <section id={section.id} class="page-shell__section" data-upcoming-section>
        <h2 class="m-0 text-lg font-semibold">{section.title}</h2>

        {daysLoaded ? <div class="upcoming-grid">
          {
            section.days.map((day) => (
              <div class={renderDayClass(day)}>
                <div
                  class={`day-header ${day.tasks.length > 0 ? "day-header--populated" : ""}`}
                  role="button"
                  tabindex="0"
                  aria-expanded="true"
                >
                  <div class="day-header__left">
                    <Icon name="chevron-down" size={16} class="chevron-icon" sprite />
                    <span class={dayLabelClass(day)}>
                      {day.label}
                    </span>
                  </div>
                  {day.tasks.length > 0 && (
                    <span class="day-count-badge">{day.tasks.length}</span>
                  )}
                  {day.tasks.length === 0 && (
                    <span class="day-count-empty">—</span>
                  )}
                </div>
                {day.tasks.length > 0 && (
                  <div class="task-list">
                    {day.tasks.map((task) => {
                      const id = String(task.id)
                      const title = String(task.title)
                      const p = Number(task.priority ?? 3)
                      const tt = String(task.task_type ?? "task")
                      const isPromoted = Boolean(task.is_promoted)
                      const ticketKey = (typeof task.ticket_key === "string" && task.ticket_key)
                        || (task.ticket_number ? formatTicketKey(Number(task.ticket_number)) : "")
                      const descriptionId = `upcoming-task-description-${id}`
                      return (
                        <div
                          class="task-item"
                          data-id={id}
                          data-promoted={isPromoted ? "true" : "false"}
                          {...taskSurface(String(task.status), typeof task.color === "string" ? task.color : null)}
                        >
                          <button
                            type="button"
                            class:list={["upcoming-promote-btn", { "is-promoted": isPromoted }]}
                            data-id={id}
                            aria-pressed={isPromoted ? "true" : "false"}
                            aria-label={isPromoted ? "Remove promotion" : "Promote to top"}
                            title={isPromoted ? "Remove promotion" : "Promote to top"}
                          >
                            <Icon name="star" size={15} sprite />
                          </button>
                          <label class="upcoming-completion">
                            <input
                              type="checkbox"
                              class="task-checkbox"
                              data-id={id}
                              aria-label={`Complete ${title}`}
                            />
                          </label>
                          <span
                            class="priority-dot"
                            style={`color: ${priorityColors[p] ?? "#3b82f6"};`}
                            title={`Priority: ${priorityLabels[p] ?? "Medium"}`}
                          >
                            ●
                          </span>
                          <div class="task-content">
                            <div class="task-title">
                              {ticketKey && (
                                <span class="upcoming-ticket-key">{ticketKey}</span>
                              )}
                              <a
                                class="task-detail-link"
                                href={taskDetailPath({ ...task, id })}
                                data-task-detail-link={id}
                                aria-describedby={descriptionId}
                              >
                                <TaskTypeIcon
                                  type={tt}
                                  kind={typeof task.task_kind === "string" ? task.task_kind : null}
                                  size={14}
                                />
                                <span class="task-detail-link__text">{title}</span>
                              </a>
                              <span class="sr-only" id={descriptionId}>
                                Priority {priorityLabels[p] ?? "Medium"}, due {day.label}
                              </span>
                            </div>
                            <div class="task-labels">
                              {isPromoted && (
                                <span class="task-promoted-pill">
                                  <Icon name="star" size={11} sprite /> Promoted
                                </span>
                              )}
                              <LabelBadges labels={task.labels as string} compact max={3} />
                            </div>
                          </div>
                          <div class="upcoming-task-meta">
                            <StatusBadge status={String(task.status)} />
                            {task.color && (
                              <span
                                class="task-color-swatch"
                                style={`background: ${String(task.color)};`}
                              />
                            )}
                            {task.recurrence_rule && (
                              <span class="task-meta-icon" title="Recurring"><Icon name="repeat" size={14} sprite /></span>
                            )}
                            {(() => {
                              try {
                                const cl = task.checklists ? (typeof task.checklists === "string" ? JSON.parse(String(task.checklists)) : task.checklists) : [];
                                if (Array.isArray(cl) && cl.length > 0) {
                                  const done = cl.filter((i: {done: boolean}) => i.done).length;
                                  return (
                                    <span
                                      class={`task-checklist-count ${done === cl.length ? "task-checklist-count--complete" : ""}`}
                                      title={`Checklist: ${done}/${cl.length}`}
                                    >
                                      <Icon name="check" size={12} sprite /> {done}/{cl.length}
                                    </span>
                                  );
                                }
                              } catch { /* skip */ }
                              return null;
                            })()}
                            {task.assigned_to && (
                              <span
                                class="avatar avatar--sm upcoming-assignee"
                                role="img"
                                title={`Assigned to ${String(task.assigned_to)}`}
                                aria-label={`Assigned to ${String(task.assigned_to)}`}
                              >
                                {String(task.assigned_to)
                                  .replace(/^(ha_|custom_)/, "")
                                  .slice(0, 2)
                                  .toUpperCase()}
                              </span>
                            )}
                          </div>
                        </div>
                      );
                    })}
                  </div>
                )}
              </div>
            ))
          }
        </div> : <p role="status" class="m-0 text-text-secondary">{unavailableMessage}</p>}
      </section>
    ))}

    <section id="upcoming-flow" class="page-shell__section" data-upcoming-section>
      <h2 class="m-0 text-lg font-semibold">Related views</h2>
      <div class="page-flow-grid">
        <a class="card page-flow-card" href={contextHref("/today")}>
          <strong class="inline-flex items-center gap-2"><Icon name="sun" size={16} sprite /> Today</strong>
        </a>
        <a class="card page-flow-card" href={contextHref("/tasks?view=calendar#calendar")}>
          <strong class="inline-flex items-center gap-2"><Icon name="calendar" size={16} sprite /> Calendar</strong>
        </a>
      </div>
    </section>
  </div>
</Layout>

<style is:inline>
  #upcoming-shell,
  [data-upcoming-section] {
    grid-template-columns: minmax(0, 1fr);
  }

  #upcoming-shell {
    padding: 24px clamp(16px, 2vw, 24px) 52px;
  }

  /* ── Day card ── */
  .day-card--populated {
    margin-bottom: 12px;
  }
  .day-card--today {
    border-left: 3px solid var(--accent);
  }

  /* ── Day header ── */
  .day-header {
    padding: 8px 16px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    user-select: none;
    cursor: pointer;
    transition: background 0.15s;
  }
  .day-header--populated {
    padding: 10px 16px;
  }
  .day-header:hover {
    background: var(--bg-hover);
  }
  .day-header[aria-expanded="false"] .chevron-icon {
    transform: rotate(-90deg);
  }
  .day-header__left {
    display: flex;
    align-items: center;
    gap: 8px;
  }

  /* ── Chevron ── */
  .chevron-icon {
    transition: transform 0.2s;
  }

  /* ── Day label ── */
  .day-label {
    font-size: 13px;
    font-weight: 500;
    color: var(--text-primary);
  }
  .day-label--highlight {
    font-weight: 600;
  }
  .day-label--today {
    color: var(--accent-text);
  }

  /* ── Count badges ── */
  .day-count-badge {
    font-size: 11px;
    background: var(--personal-accent, var(--palette-accent-hover));
    color: var(--personal-accent-foreground, var(--palette-on-accent, #07140f));
    padding: 1px 6px;
    border-radius: 8px;
    font-weight: 600;
  }
  .day-count-empty {
    font-size: 11px;
    color: var(--text-muted);
    font-style: italic;
  }

  /* ── Task list collapse ── */
  .task-list.collapsed {
    display: none;
  }

  /* ── Day empty state ── */
  /* Quiet empty days with a muted colour, not opacity, so their labels keep AA contrast. */
  .day-empty {
    margin-bottom: 4px;
  }
  .day-empty .day-label:not(.day-label--today),
  .day-empty .day-count-empty,
  .day-empty .chevron-icon {
    color: var(--text-muted);
  }
  /* The hover background is lighter than the card in dark, so muted text drops below AA there. */
  .day-empty .day-header:hover .day-label:not(.day-label--today),
  .day-empty .day-header:hover .day-count-empty {
    color: var(--text-primary);
  }

  /* ── Task item ── */
  .task-item {
    cursor: pointer;
    padding: 10px 14px;
    display: flex;
    align-items: center;
    gap: 10px;
    border-top: 1px solid var(--border);
    transition: background-color 150ms cubic-bezier(0.23, 1, 0.32, 1), opacity 240ms ease;
  }
  .task-item:hover {
    background: var(--bg-hover);
  }
  .task-item[data-promoted="true"]:not([data-task-color]) {
    box-shadow: inset 3px 0 0 var(--tblr-yellow, #f59f00);
  }

  .upcoming-promote-btn {
    background: none;
    border: none;
    cursor: pointer;
    padding: 4px;
    min-width: 28px;
    min-height: 28px;
    border-radius: 6px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    color: var(--text-muted);
    flex-shrink: 0;
    transition: color 150ms cubic-bezier(0.23, 1, 0.32, 1), transform 140ms cubic-bezier(0.23, 1, 0.32, 1), background-color 150ms ease;
  }
  .upcoming-promote-btn:hover {
    color: var(--tblr-yellow, #f59f00);
    background: color-mix(in srgb, var(--tblr-yellow, #f59f00) 12%, transparent);
  }
  .upcoming-promote-btn:active {
    transform: scale(0.92);
  }
  .upcoming-promote-btn.is-promoted {
    color: var(--tblr-yellow, #f59f00);
  }
  .upcoming-promote-btn.is-promoted svg {
    fill: currentColor;
  }

  .upcoming-completion {
    display: inline-grid;
    place-items: center;
    min-width: 44px;
    min-height: 44px;
    flex-shrink: 0;
    cursor: pointer;
  }
  .task-checkbox {
    width: 18px;
    height: 18px;
    margin: 0;
    appearance: auto;
    accent-color: var(--accent);
    cursor: pointer;
  }

  /* ── Priority dot ── */
  .priority-dot {
    font-size: 10px;
    flex-shrink: 0;
  }

  /* ── Task content ── */
  .task-content {
    flex: 1;
    min-width: 0;
  }
  .task-title {
    display: flex;
    align-items: center;
    gap: 6px;
    font-size: 14px;
    font-weight: 550;
    min-width: 0;
  }
  .upcoming-ticket-key {
    font-size: 11px;
    font-family: "JetBrains Mono", monospace;
    color: var(--text-muted);
    font-weight: 500;
    background: color-mix(in srgb, var(--text-muted) 10%, transparent);
    padding: 1px 6px;
    border-radius: 4px;
    flex-shrink: 0;
  }
  .task-detail-link {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    min-width: 44px;
    min-height: 44px;
    line-height: 1.35;
    color: var(--text-primary);
    text-decoration: none;
  }
  .task-detail-link__text {
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .task-detail-link:hover .task-detail-link__text,
  .task-detail-link:focus-visible .task-detail-link__text {
    text-decoration: underline;
    text-underline-offset: 2px;
  }
  .task-detail-link:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
    border-radius: 4px;
  }
  .task-type-icon {
    font-size: 11px;
    flex-shrink: 0;
  }
  .task-labels {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 6px;
    margin-top: 4px;
  }
  .task-labels:empty {
    display: none;
  }

  .upcoming-task-meta {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    flex-shrink: 0;
    margin-inline-start: auto;
  }

  /* ── Task color swatch ── */
  .task-color-swatch {
    width: 4px;
    height: 18px;
    border-radius: 2px;
    flex-shrink: 0;
  }

  /* ── Task meta icons ── */
  .task-meta-icon {
    display: inline-flex;
    align-items: center;
    font-size: 11px;
    color: var(--text-muted);
  }

  /* ── Checklist count ── */
  .task-checklist-count {
    display: inline-flex;
    align-items: center;
    gap: 3px;
    font-size: 11px;
    font-variant-numeric: tabular-nums;
    color: var(--text-muted);
    white-space: nowrap;
  }
  .task-checklist-count--complete {
    color: var(--success-text, var(--success));
  }

  @media (max-width: 768px), (pointer: coarse) {
    .task-item {
      flex-wrap: wrap;
      padding: 10px 12px;
      gap: 8px;
    }
    .upcoming-promote-btn {
      min-width: 44px;
      min-height: 44px;
    }
    .task-content {
      flex: 1 1 12rem;
    }
    .task-detail-link__text {
      white-space: normal;
      overflow-wrap: anywhere;
    }
    .upcoming-task-meta {
      width: 100%;
      margin-inline-start: 0;
      padding-inline-start: 2px;
      flex-wrap: wrap;
      justify-content: flex-start;
    }
  }

  /* ── Status badge (also used by StatusBadge component fallback) ── */
  .status-badge {
    display: inline-block;
    font-size: 10px;
    font-weight: 600;
    padding: 2px 8px;
    border-radius: 8px;
    text-transform: uppercase;
    letter-spacing: 0.3px;
    white-space: nowrap;
    flex-shrink: 0;
  }
  .status-badge--pending {
    background: rgb(var(--info-rgb) / 0.12);
    color: var(--info);
  }
  .status-badge--active {
    background: rgb(var(--success-rgb) / 0.12);
    color: var(--success);
  }
  .status-badge--backlog {
    background: rgb(var(--text-muted-rgb) / 0.12);
    color: var(--text-muted);
  }
  .status-badge--complete {
    background: rgb(var(--success-rgb) / 0.15);
    color: var(--success);
  }

  /* ── Accessibility: reduced motion ── */
  @media (prefers-reduced-motion: reduce) {
    .task-item { transition: none; }
    .day-header { transition: none; }
    .chevron-icon { transition: none; }
  }

</style>

<script>
  import { initUpcomingPage } from "../lib/upcoming-controller"
  import { pageLifecycle } from "../lib/page-lifecycle"

  pageLifecycle.onPageLoad(() => {
    initUpcomingPage()
  })
</script>
