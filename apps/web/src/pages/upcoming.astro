---
import Layout from "../layouts/Layout.astro";
import EmptyState from "../components/ui/EmptyState.astro";
import LabelBadges from "../components/ui/LabelBadges.astro";
import {
  ensureSchema,
  getPersistenceClient,
} from "@domains/tasks/persistence/store";
import { TaskRepository } from "@domains/tasks/persistence/task-repository";

interface DayGroup {
  date: string;
  label: string;
  isToday: boolean;
  isTomorrow: boolean;
  tasks: Record<string, unknown>[];
}

const days: DayGroup[] = [];

try {
  await ensureSchema();
  const repo = new TaskRepository(getPersistenceClient());
  const today = new Date();
  const todayStr = today.toISOString().split("T")[0] ?? "";

  // Persona 9: Single query for all 7 days instead of 7 sequential queries
  const endDate = new Date(today);
  endDate.setDate(endDate.getDate() + 6);
  const endStr = endDate.toISOString().split("T")[0] ?? "";

  const allTasks = await repo.getTasksInRange(todayStr, endStr);

  const tasksByDate = new Map<string, Record<string, unknown>[]>();
  for (const row of allTasks) {
    const d = String(row.due_date);
    if (!tasksByDate.has(d)) tasksByDate.set(d, []);
    tasksByDate.get(d)!.push(row);
  }

  for (let i = 0; i < 7; i++) {
    const d = new Date(today);
    d.setDate(d.getDate() + i);
    const dateStr = d.toISOString().split("T")[0] ?? "";

    const weekday = d.toLocaleDateString("en-US", { weekday: "long" });
    const monthDay = d.toLocaleDateString("en-US", {
      month: "short",
      day: "numeric",
    });

    let label = `${weekday}, ${monthDay}`;
    if (i === 0) label = `Today — ${monthDay}`;
    if (i === 1) label = `Tomorrow — ${monthDay}`;

    days.push({
      date: dateStr,
      label,
      isToday: i === 0,
      isTomorrow: i === 1,
      tasks: tasksByDate.get(dateStr) ?? [],
    });
  }
} catch {
  /* DB not available */
}

import {
  PRIORITY_LABELS as priorityLabels,
  PRIORITY_COLORS as priorityColors,
} from "../lib/priority-config";
import StatusBadge from "../components/ui/StatusBadge.astro";
import { STATUS_LABELS, normalizeStatus } from "../lib/status-config";

const typeIcons: Record<string, string> = {
  epic: "🎯",
  story: "📖",
  task: "📌",
};

const totalTasks = days.reduce((sum, d) => sum + d.tasks.length, 0);
---

<Layout title="Meitheal — Upcoming">
  <span slot="page-title">📅 Upcoming</span>
  <div slot="actions">
    <a href="/today" class="btn btn-ghost" style="font-size: 13px;">☀️ Today</a>
    <a href="/calendar" class="btn btn-ghost" style="font-size: 13px;"
      >🗓️ Calendar</a
    >
    <button
      type="button"
      class="btn btn-primary"
      id="create-task-btn"
      style="font-size: 13px;">+ New Task</button
    >
  </div>

  <div style="font-size: 12px; color: var(--text-muted); margin-bottom: 12px;">
    {totalTasks}
    {totalTasks === 1 ? "task" : "tasks"} in the next 7 days
  </div>

  {
    totalTasks === 0 && (
      <EmptyState
        title="No upcoming tasks"
        description="Your schedule is clear for the next 7 days."
        actionText="Plan something"
        actionHref="/table"
      />
    )
  }

  <div class="upcoming-grid">
    {
      days.map((day) => (
        <div
          class={`card ${day.tasks.length === 0 ? "day-empty" : ""}`}
          style={`margin-bottom: ${day.tasks.length > 0 ? "12px" : "4px"}; ${day.isToday ? "border-left: 3px solid var(--accent);" : ""}`}
        >
          <div
            class="day-header"
            style={`padding: ${day.tasks.length > 0 ? "10px 16px" : "8px 16px"}; display: flex; align-items: center; justify-content: space-between; user-select: none;`}
            role="button"
            tabindex="0"
            aria-expanded="true"
          >
            <div style="display: flex; align-items: center; gap: 8px;">
              <svg class="chevron-icon" xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="transition: transform 0.2s;"><path d="m6 9 6 6 6-6"/></svg>
              <span
                style={`font-size: 13px; font-weight: ${day.isToday || day.isTomorrow ? "600" : "500"}; color: ${day.isToday ? "var(--accent)" : "var(--text-primary)"};`}
              >
                {day.label}
              </span>
            </div>
            {day.tasks.length > 0 && (
              <span style="font-size: 11px; background: var(--accent); color: white; padding: 1px 6px; border-radius: 8px; font-weight: 600;">
                {day.tasks.length}
              </span>
            )}
            {day.tasks.length === 0 && (
              <span style="font-size: 11px; color: var(--text-muted); font-style: italic;">
                —
              </span>
            )}
          </div>
          {day.tasks.length > 0 && (
            <div class="task-list">
              {day.tasks.map((task) => {
                const p = Number(task.priority ?? 3);
                const tt = String(task.task_type ?? "task");
                const status = normalizeStatus(String(task.status ?? "pending"));
                return (
                  <div
                    class="task-item"
                    data-id={String(task.id)}
                    style="cursor:pointer; padding: 8px 16px; display: flex; align-items: center; gap: 10px; border-top: 1px solid var(--border); transition: background 0.15s;"
                    role="button"
                    tabindex="0"
                    aria-label={`${String(task.title)}, priority ${priorityLabels[p] ?? "Medium"}, due ${day.label}`}
                  >
                    <input
                      type="checkbox"
                      class="task-checkbox"
                      data-id={String(task.id)}
                      aria-label={`Complete ${String(task.title)}`}
                    />
                    <span
                      style={`color: ${priorityColors[p] ?? "#3b82f6"}; font-size: 10px; flex-shrink: 0;`}
                      title={`Priority: ${priorityLabels[p] ?? "Medium"}`}
                    >
                      ●
                    </span>
                    <div style="flex: 1; min-width: 0;">
                      <div style="font-size: 13px; font-weight: 500; white-space: nowrap; overflow: hidden; text-overflow: ellipsis;">
                        <span style="margin-right: 3px; font-size: 11px;">
                          {typeIcons[tt] ?? ""}
                        </span>
                        {String(task.title)}
                      </div>
                      <div class="flex items-center gap-2 mt-2">
                        <LabelBadges labels={task.labels as string} compact max={3} />
                      </div>
                    </div>
                    <StatusBadge status={String(task.status)} />
                    {task.color && (
                      <span
                        style={`width: 4px; height: 20px; border-radius: 2px; background: ${String(task.color)}; flex-shrink: 0;`}
                      />
                    )}
                    {task.recurrence_rule && (
                      <span
                        style="font-size: 10px; color: var(--text-muted);"
                        title="Recurring"
                      >
                        🔁
                      </span>
                    )}
                    {(() => {
                      try {
                        const cl = task.checklists ? (typeof task.checklists === "string" ? JSON.parse(String(task.checklists)) : task.checklists) : [];
                        if (Array.isArray(cl) && cl.length > 0) {
                          const done = cl.filter((i: {done: boolean}) => i.done).length;
                          return (
                            <span
                              style={`font-size: 10px; color: ${done === cl.length ? 'var(--color-green-500, #22c55e)' : 'var(--text-muted)'};`}
                              title={`Checklist: ${done}/${cl.length}`}
                            >
                              ✓ {done}/{cl.length}
                            </span>
                          );
                        }
                      } catch { /* skip */ }
                      return null;
                    })()}
                    {task.assigned_to && (
                      <span
                        class="avatar avatar--sm"
                        title={`Assigned to ${String(task.assigned_to)}`}
                        aria-label={`Assigned to ${String(task.assigned_to)}`}
                      >
                        {String(task.assigned_to)
                          .replace(/^(ha_|custom_)/, "")
                          .slice(0, 2)
                          .toUpperCase()}
                      </span>
                    )}
                  </div>
                );
              })}
            </div>
          )}
        </div>
      ))
    }
  </div>
</Layout>

<style>
  .day-header {
    transition: background 0.15s;
    cursor: pointer;
  }
  .day-header:hover {
    background: var(--bg-hover);
  }
  .day-header[aria-expanded="false"] .chevron-icon {
    transform: rotate(-90deg);
  }
  .task-list {
    transition: max-height 0.3s cubic-bezier(0.4, 0, 0.2, 1), opacity 0.3s cubic-bezier(0.4, 0, 0.2, 1);
    max-height: 2000px;
    opacity: 1;
    overflow: hidden;
  }
  .task-list.collapsed {
    max-height: 0;
    opacity: 0;
    pointer-events: none;
  }

  .day-empty {
    opacity: 0.6;
  }
  .day-empty:hover {
    opacity: 0.8;
  }
  .task-item:hover {
    background: var(--bg-hover);
  }
  .task-item:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: -2px;
  }
  .status-badge {
    display: inline-block;
    font-size: 10px;
    font-weight: 600;
    padding: 2px 8px;
    border-radius: 8px;
    text-transform: uppercase;
    letter-spacing: 0.3px;
    white-space: nowrap;
    flex-shrink: 0;
  }
  .status-badge--pending {
    background: rgba(59, 130, 246, 0.12);
    color: #3b82f6;
  }
  .status-badge--active {
    background: rgba(34, 197, 94, 0.12);
    color: #22c55e;
  }
  .status-badge--backlog {
    background: rgba(148, 163, 184, 0.12);
    color: #94a3b8;
  }
  .status-badge--complete {
    background: rgba(34, 197, 94, 0.15);
    color: var(--color-green-500, #22c55e);
  }
</style>

<script>
  import { taskApi } from "../lib/task-api-client"
  import { onTaskCompleted } from "../lib/gamification-hook"

  function setupUpcomingPage() {
    // Task checkbox completion
    document
      .querySelectorAll<HTMLInputElement>(".task-checkbox:not([data-initialized])")
      .forEach((cb) => {
        cb.dataset.initialized = 'true';
        cb.addEventListener("change", async () => {
          const id = cb.dataset.id;
          if (!id) return;
          try {
            await taskApi.updateTask(id, {
              status: cb.checked ? "complete" : "pending",
            });
            const item = cb.closest(".task-item") as HTMLElement | null;
            if (cb.checked && item) {
              onTaskCompleted();
              item.style.opacity = "0.4";
              item.style.transition = "opacity 0.3s";
              setTimeout(() => item.remove(), 800);
            }
          } catch {
            /* retry silently */
          }
        });
      });

    // Click to open task detail
    document.querySelectorAll<HTMLElement>(".task-item:not([data-initialized])").forEach((item) => {
      item.dataset.initialized = 'true';
      item.addEventListener("click", (e) => {
        if ((e.target as HTMLElement).tagName === "INPUT") return;
        const id = item.dataset.id;
        if (id)
          window.location.href =
            (window.__ingress_path || "") + `/tasks#task-${id}`;
      });
      item.addEventListener("keydown", (e) => {
        if (e.key === "Enter" || e.key === " ") {
          e.preventDefault();
          const id = (e.target as HTMLElement).dataset?.id;
          if (id)
            window.location.href =
              (window.__ingress_path || "") + `/tasks#task-${id}`;
        }
      });
    });
  }

  // Initialize on full page load
  setupUpcomingPage();

  // Re-initialize on Astro View Transition navigation
  document.addEventListener('astro:page-load', setupUpcomingPage);
</script>

<script is:inline>
  function initUpcomingAccordions() {
    document.querySelectorAll('.day-header:not([data-accordion-init])').forEach(header => {
      header.setAttribute('data-accordion-init', 'true');
      header.addEventListener('click', () => {
        const isExpanded = header.getAttribute('aria-expanded') === 'true';
        header.setAttribute('aria-expanded', String(!isExpanded));
        const list = header.nextElementSibling;
        if (list && list.classList.contains('task-list')) {
          if (isExpanded) {
             list.classList.add('collapsed');
          } else {
             list.classList.remove('collapsed');
          }
        }
      });

      header.addEventListener('keydown', (e) => {
         if (e.key === 'Enter' || e.key === ' ') {
            e.preventDefault();
            header.click();
         }
      });
    });
  }

  // Run on first load and on astro navigation
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initUpcomingAccordions);
  } else {
    initUpcomingAccordions();
  }
  document.addEventListener('astro:page-load', initUpcomingAccordions);
</script>
