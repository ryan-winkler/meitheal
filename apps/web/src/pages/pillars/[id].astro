---
/**
 * /pillars/:id — Pillar Detail (Blueprint View)
 *
 * Full view of a single Pillar: manifesto, principles, linked goals,
 * weight adjustment, and inline editing.
 *
 * @domain pillars
 * @phase 17 — Sub-Phase 17B
 */
import Layout from "../../layouts/Layout.astro"
import PrincipleList from "../../components/pillars/PrincipleList.astro"
import { getPillarById } from "@domains/pillars/pillar-service"
import { getPrinciplesForPillar } from "@domains/pillars/principle-service"
import { getAssociationsForPillar } from "@domains/pillars/pillar-association-service"

const { id } = Astro.params
if (!id) return Astro.redirect("/pillars")

const pillar = await getPillarById(id)
if (!pillar) return Astro.redirect("/pillars")

const principles = await getPrinciplesForPillar(id)
const associations = await getAssociationsForPillar(id)
const linkedGoals = associations.filter(a => a.entityType === "goal")

const accentColor = pillar.colorHex || "var(--accent)"
const weightDots = Math.min(pillar.weight, 10)
---

<Layout title={`Meitheal — ${pillar.name}`}>
  <main class="pillar-detail" style={`--pillar-accent: ${accentColor}`}>
    <div class="pillar-detail__nav">
      <a href="/pillars" class="pillar-detail__back">
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m15 18-6-6 6-6"/></svg>
        All Pillars
      </a>
    </div>

    <header class="pillar-detail__header">
      <div class="pillar-detail__accent-bar"></div>
      <div class="pillar-detail__hero">
        <span class="pillar-detail__icon" aria-hidden="true">{pillar.icon || "🏛️"}</span>
        <div>
          <h1 class="pillar-detail__name">{pillar.name}</h1>
          <div class="pillar-detail__weight" title={`Weight: ${pillar.weight}/10`}>
            {Array.from({ length: weightDots }).map(() => (
              <span class="pillar-detail__weight-dot pillar-detail__weight-dot--filled"></span>
            ))}
            {Array.from({ length: 10 - weightDots }).map(() => (
              <span class="pillar-detail__weight-dot"></span>
            ))}
            <span class="pillar-detail__weight-label">{pillar.weight}/10</span>
          </div>
        </div>
      </div>

      <div class="pillar-detail__manifesto-section">
        {pillar.manifesto ? (
          <blockquote class="pillar-detail__manifesto">{pillar.manifesto}</blockquote>
        ) : (
          <div class="pillar-detail__manifesto-empty">
            <p>This Pillar doesn't have a manifesto yet.</p>
            <p class="text-sm">A manifesto is your identity statement — <em>"I am someone who..."</em></p>
          </div>
        )}
      </div>
    </header>

    <div class="pillar-detail__body">
      <section class="pillar-detail__section">
        <PrincipleList
          principles={principles}
          pillarId={id}
          accentColor={accentColor}
        />
      </section>

      {linkedGoals.length > 0 && (
        <section class="pillar-detail__section">
          <h4 class="pillar-detail__section-title">
            <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><path d="M12 6v6l4 2"/></svg>
            Linked Goals
          </h4>
          <ul class="pillar-detail__goals">
            {linkedGoals.map((g) => (
              <li class="pillar-detail__goal-item">
                <a href={`/goals/${g.entityId}`}>{g.entityId}</a>
              </li>
            ))}
          </ul>
        </section>
      )}
    </div>
  </main>
</Layout>

<style>
.pillar-detail {
  max-width: 720px;
  margin: 0 auto;
  padding: 1.5rem 1rem;
}

.pillar-detail__nav {
  margin-bottom: 1rem;
}

.pillar-detail__back {
  display: inline-flex;
  align-items: center;
  gap: 0.25rem;
  font-size: 0.875rem;
  color: var(--text-muted);
  text-decoration: none;
  transition: color 150ms ease;
}

.pillar-detail__back:hover {
  color: var(--text);
}

.pillar-detail__header {
  background: var(--surface);
  border: 1px solid var(--border);
  border-radius: var(--radius-lg, 12px);
  overflow: hidden;
  margin-bottom: 1.5rem;
}

.pillar-detail__accent-bar {
  height: 6px;
  background: var(--pillar-accent);
}

.pillar-detail__hero {
  display: flex;
  align-items: flex-start;
  gap: 1rem;
  padding: 1.25rem 1.5rem 0.75rem;
}

.pillar-detail__icon {
  font-size: 2.5rem;
  line-height: 1;
}

.pillar-detail__name {
  margin: 0;
  font-size: 1.5rem;
  font-weight: 700;
  color: var(--text);
}

.pillar-detail__weight {
  display: flex;
  align-items: center;
  gap: 3px;
  margin-top: 0.375rem;
}

.pillar-detail__weight-dot {
  width: 8px;
  height: 8px;
  border-radius: 50%;
  background: var(--border);
}

.pillar-detail__weight-dot--filled {
  background: var(--pillar-accent);
}

.pillar-detail__weight-label {
  margin-left: 0.5rem;
  font-size: 0.75rem;
  color: var(--text-muted);
}

.pillar-detail__manifesto-section {
  padding: 0 1.5rem 1.25rem;
}

.pillar-detail__manifesto {
  margin: 0;
  padding: 1rem 1.25rem;
  border-left: 4px solid var(--pillar-accent);
  background: color-mix(in srgb, var(--pillar-accent) 6%, transparent);
  border-radius: 0 var(--radius-sm) var(--radius-sm) 0;
  font-size: 1.0625rem;
  line-height: 1.6;
  color: var(--text);
  font-style: italic;
}

.pillar-detail__manifesto-empty {
  padding: 1rem;
  border: 2px dashed var(--border);
  border-radius: var(--radius-sm);
  text-align: center;
  color: var(--text-muted);
}

.pillar-detail__manifesto-empty p {
  margin: 0;
}

.pillar-detail__body {
  display: flex;
  flex-direction: column;
  gap: 1.5rem;
}

.pillar-detail__section {
  background: var(--surface);
  border: 1px solid var(--border);
  border-radius: var(--radius-lg, 12px);
  padding: 1.25rem;
}

.pillar-detail__section-title {
  margin: 0 0 0.75rem;
  font-size: 0.8125rem;
  font-weight: 600;
  color: var(--text-muted);
  text-transform: uppercase;
  letter-spacing: 0.04em;
  display: flex;
  align-items: center;
  gap: 0.375rem;
}

.pillar-detail__goals {
  list-style: none;
  margin: 0;
  padding: 0;
  display: flex;
  flex-direction: column;
  gap: 0.375rem;
}

.pillar-detail__goal-item {
  padding: 0.5rem 0.625rem;
  background: var(--surface-raised, var(--surface));
  border: 1px solid var(--border);
  border-radius: var(--radius-sm);
}

.pillar-detail__goal-item a {
  color: var(--text);
  text-decoration: none;
  font-size: 0.875rem;
}

.pillar-detail__goal-item a:hover {
  color: var(--pillar-accent);
}

.text-sm {
  font-size: 0.8125rem;
}
</style>
