---
/**
 * /pillars/:id — Pillar Detail (Blueprint View)
 *
 * Full view of a single Pillar: manifesto, principles, linked goals,
 * weight adjustment, and inline editing.
 *
 * @domain pillars
 * @phase 17 — Sub-Phase 17B
 */
import Layout from "../../layouts/Layout.astro"
import PrincipleList from "../../components/pillars/PrincipleList.astro"
import { getPillarById } from "@domains/pillars/pillar-service"
import { getPrinciplesForPillar } from "@domains/pillars/principle-service"
import { getAssociationsForPillar } from "@domains/pillars/pillar-association-service"

const { id } = Astro.params
if (!id) return Astro.redirect("/pillars")

const pillar = await getPillarById(id)
if (!pillar) return Astro.redirect("/pillars")

const principles = await getPrinciplesForPillar(id)
const associations = await getAssociationsForPillar(id)
const linkedGoals = associations.filter(a => a.entityType === "goal")

const accentColor = pillar.colorHex || "var(--accent)"
const weightDots = Math.min(pillar.weight, 10)
const pillarJson = JSON.stringify({ id: pillar.id, name: pillar.name, manifesto: pillar.manifesto, icon: pillar.icon, colorHex: pillar.colorHex, weight: pillar.weight })
---

<Layout title={`Meitheal — ${pillar.name}`}>
  <main class="pillar-detail" style={`--pillar-accent: ${accentColor}`}>
    <div class="pillar-detail__nav">
      <a href="/pillars" class="pillar-detail__back">
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m15 18-6-6 6-6"/></svg>
        All Pillars
      </a>
    </div>

    <header class="pillar-detail__header" data-pillar={pillarJson}>
      <div class="pillar-detail__accent-bar"></div>
      <div class="pillar-detail__hero">
        <span class="pillar-detail__icon" aria-hidden="true">{pillar.icon || "🏛️"}</span>
        <div>
          <h1 class="pillar-detail__name">{pillar.name}</h1>
          <div class="pillar-detail__weight" title={`Weight: ${pillar.weight}/10`}>
            {Array.from({ length: weightDots }).map(() => (
              <span class="pillar-detail__weight-dot pillar-detail__weight-dot--filled"></span>
            ))}
            {Array.from({ length: 10 - weightDots }).map(() => (
              <span class="pillar-detail__weight-dot"></span>
            ))}
            <span class="pillar-detail__weight-label">{pillar.weight}/10</span>
          </div>
        </div>
        <div class="pillar-detail__actions">
          <button type="button" class="pillar-detail__action-btn" id="edit-pillar-btn" aria-label="Edit Pillar" title="Edit Pillar">
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M17 3a2.828 2.828 0 1 1 4 4L7.5 20.5 2 22l1.5-5.5L17 3z"/></svg>
          </button>
          <button type="button" class="pillar-detail__action-btn pillar-detail__action-btn--danger" id="delete-pillar-btn" aria-label="Delete Pillar" title="Delete Pillar">
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="3 6 5 6 21 6"/><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"/></svg>
          </button>
        </div>
      </div>

      <div class="pillar-detail__manifesto-section">
        {pillar.manifesto ? (
          <blockquote class="pillar-detail__manifesto">{pillar.manifesto}</blockquote>
        ) : (
          <div class="pillar-detail__manifesto-empty">
            <p>This Pillar doesn't have a manifesto yet.</p>
            <p class="text-sm">A manifesto is your identity statement — <em>"I am someone who..."</em></p>
          </div>
        )}
      </div>
    </header>

    <div class="pillar-detail__body">
      <section class="pillar-detail__section">
        <PrincipleList
          principles={principles}
          pillarId={id}
          accentColor={accentColor}
        />
      </section>

      {linkedGoals.length > 0 && (
        <section class="pillar-detail__section">
          <h4 class="pillar-detail__section-title">
            <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><path d="M12 6v6l4 2"/></svg>
            Linked Goals
          </h4>
          <ul class="pillar-detail__goals">
            {linkedGoals.map((g) => (
              <li class="pillar-detail__goal-item">
                <a href={`/goals/${g.entityId}`}>Goal: {g.entityId.substring(0, 8)}…</a>
              </li>
            ))}
          </ul>
        </section>
      )}
    </div>
  </main>
</Layout>

<script>
  import { showToast } from "@lib/toast"
  import { createClientLogger } from "@lib/client-logger"
  import { pageLifecycle } from "@lib/page-lifecycle"

  const log = createClientLogger("pillars", "pillar-detail")

  pageLifecycle.onPageLoad(() => {
    const header = document.querySelector(".pillar-detail__header") as HTMLElement | null
    const editBtn = document.getElementById("edit-pillar-btn")
    const deleteBtn = document.getElementById("delete-pillar-btn")
    const addPrincipleBtn = document.querySelector("[data-action='add-principle']")

    if (!header) return

    let pillarData: Record<string, unknown> = {}
    try {
      pillarData = JSON.parse(header.dataset.pillar || "{}")
    } catch { /* ignore */ }

    // --- Edit: Navigate to pillars page (reuse PillarFormModal in future, for now navigate back) ---
    editBtn?.addEventListener("click", () => {
      // For now, show toast — edit-in-place is a P2 follow-up
      showToast("Edit Pillar: use the Pillars page (edit-in-place coming soon)", "success")
    })

    // --- Delete: Confirm + soft-delete ---
    deleteBtn?.addEventListener("click", async () => {
      const name = pillarData.name || "this Pillar"
      if (!confirm(`Delete "${name}"? This will deactivate the Pillar. You can restore it later.`)) return

      try {
        const res = await fetch(`/api/pillars/${pillarData.id}`, { method: "DELETE" })
        if (res.ok) {
          showToast(`"${name}" deleted`, "success")
          window.location.href = "/pillars"
        } else {
          const err = await res.json().catch(() => ({ error: "Unknown error" }))
          showToast(err.error || "Failed to delete", "error")
        }
      } catch (err) {
        log.error("Delete pillar error", err)
        showToast("Network error", "error")
      }
    })

    // --- Add Principle: Inline form ---
    addPrincipleBtn?.addEventListener("click", () => {
      const list = document.querySelector(".principle-list")
      if (!list || list.querySelector(".principle-inline-form")) return

      const pillarId = list.getAttribute("data-pillar-id") || pillarData.id
      const form = document.createElement("div")
      form.className = "principle-inline-form"
      form.innerHTML = `
        <input type="text" class="form-input bg-bg-input principle-inline-form__input" placeholder="e.g. No screens after 9 PM" maxlength="500" autofocus />
        <label class="principle-inline-form__nn-label">
          <input type="checkbox" class="principle-inline-form__nn-check" /> Non-Negotiable
        </label>
        <div class="principle-inline-form__actions">
          <button type="button" class="btn btn-primary btn-sm principle-inline-form__save">Add</button>
          <button type="button" class="btn btn-ghost btn-sm principle-inline-form__cancel">Cancel</button>
        </div>
      `
      list.appendChild(form)

      const input = form.querySelector("input[type='text']") as HTMLInputElement
      const nnCheck = form.querySelector(".principle-inline-form__nn-check") as HTMLInputElement
      const saveBtn = form.querySelector(".principle-inline-form__save") as HTMLButtonElement
      const cancelBtn = form.querySelector(".principle-inline-form__cancel") as HTMLButtonElement

      input?.focus()

      cancelBtn.addEventListener("click", () => form.remove())
      input.addEventListener("keydown", (e) => {
        if (e.key === "Escape") form.remove()
        if (e.key === "Enter") saveBtn.click()
      })

      saveBtn.addEventListener("click", async () => {
        const statement = input.value.trim()
        if (!statement) { input.focus(); return }

        saveBtn.disabled = true
        saveBtn.textContent = "Saving…"

        try {
          const res = await fetch(`/api/pillars/${pillarId}/principles`, {
            method: "POST",
            headers: { "content-type": "application/json" },
            body: JSON.stringify({
              action: "create",
              statement,
              isNonNegotiable: nnCheck?.checked || false,
            }),
          })

          if (res.ok) {
            showToast("Principle added", "success")
            window.location.reload()
          } else {
            const err = await res.json().catch(() => ({ error: "Failed" }))
            showToast(err.error || "Failed to add principle", "error")
          }
        } catch (err) {
          log.error("Add principle error", err)
          showToast("Network error", "error")
        } finally {
          saveBtn.disabled = false
          saveBtn.textContent = "Add"
        }
      })
    })
  })
</script>

<style>
.pillar-detail {
  max-width: 720px;
  margin: 0 auto;
  padding: 1.5rem 1rem;
}

.pillar-detail__nav {
  margin-bottom: 1rem;
}

.pillar-detail__back {
  display: inline-flex;
  align-items: center;
  gap: 0.25rem;
  font-size: 0.875rem;
  color: var(--text-muted);
  text-decoration: none;
  transition: color 150ms ease;
}

.pillar-detail__back:hover {
  color: var(--text);
}

.pillar-detail__header {
  background: var(--surface);
  border: 1px solid var(--border);
  border-radius: var(--radius-lg, 12px);
  overflow: hidden;
  margin-bottom: 1.5rem;
}

.pillar-detail__accent-bar {
  height: 6px;
  background: var(--pillar-accent);
}

.pillar-detail__hero {
  display: flex;
  align-items: flex-start;
  gap: 1rem;
  padding: 1.25rem 1.5rem 0.75rem;
}

.pillar-detail__icon {
  font-size: 2.5rem;
  line-height: 1;
}

.pillar-detail__name {
  margin: 0;
  font-size: 1.5rem;
  font-weight: 700;
  color: var(--text);
}

.pillar-detail__weight {
  display: flex;
  align-items: center;
  gap: 3px;
  margin-top: 0.375rem;
}

.pillar-detail__weight-dot {
  width: 8px;
  height: 8px;
  border-radius: 50%;
  background: var(--border);
}

.pillar-detail__weight-dot--filled {
  background: var(--pillar-accent);
}

.pillar-detail__weight-label {
  margin-left: 0.5rem;
  font-size: 0.75rem;
  color: var(--text-muted);
}

.pillar-detail__manifesto-section {
  padding: 0 1.5rem 1.25rem;
}

.pillar-detail__manifesto {
  margin: 0;
  padding: 1rem 1.25rem;
  border-left: 4px solid var(--pillar-accent);
  background: color-mix(in srgb, var(--pillar-accent) 6%, transparent);
  border-radius: 0 var(--radius-sm) var(--radius-sm) 0;
  font-size: 1.0625rem;
  line-height: 1.6;
  color: var(--text);
  font-style: italic;
}

.pillar-detail__manifesto-empty {
  padding: 1rem;
  border: 2px dashed var(--border);
  border-radius: var(--radius-sm);
  text-align: center;
  color: var(--text-muted);
}

.pillar-detail__manifesto-empty p {
  margin: 0;
}

.pillar-detail__body {
  display: flex;
  flex-direction: column;
  gap: 1.5rem;
}

.pillar-detail__section {
  background: var(--surface);
  border: 1px solid var(--border);
  border-radius: var(--radius-lg, 12px);
  padding: 1.25rem;
}

.pillar-detail__section-title {
  margin: 0 0 0.75rem;
  font-size: 0.8125rem;
  font-weight: 600;
  color: var(--text-muted);
  text-transform: uppercase;
  letter-spacing: 0.04em;
  display: flex;
  align-items: center;
  gap: 0.375rem;
}

.pillar-detail__goals {
  list-style: none;
  margin: 0;
  padding: 0;
  display: flex;
  flex-direction: column;
  gap: 0.375rem;
}

.pillar-detail__goal-item {
  padding: 0.5rem 0.625rem;
  background: var(--surface-raised, var(--surface));
  border: 1px solid var(--border);
  border-radius: var(--radius-sm);
}

.pillar-detail__goal-item a {
  color: var(--text);
  text-decoration: none;
  font-size: 0.875rem;
}

.pillar-detail__goal-item a:hover {
  color: var(--pillar-accent);
}

.text-sm {
  font-size: 0.8125rem;
}

/* --- Action Buttons (edit/delete) --- */
.pillar-detail__actions {
  display: flex;
  gap: 0.375rem;
  margin-left: auto;
  flex-shrink: 0;
}

.pillar-detail__action-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 32px;
  height: 32px;
  border: 1px solid var(--border);
  border-radius: var(--radius-sm, 6px);
  background: transparent;
  color: var(--text-muted);
  cursor: pointer;
  transition: all 150ms ease;
}

.pillar-detail__action-btn:hover {
  color: var(--text);
  border-color: var(--pillar-accent);
  background: color-mix(in srgb, var(--pillar-accent) 10%, transparent);
}

.pillar-detail__action-btn--danger:hover {
  color: var(--danger, #ef4444);
  border-color: var(--danger, #ef4444);
  background: color-mix(in srgb, var(--danger, #ef4444) 10%, transparent);
}

/* --- Inline Principle Form --- */
.principle-inline-form {
  margin-top: 0.75rem;
  padding: 0.75rem;
  border: 1px solid var(--pillar-accent);
  border-radius: var(--radius-sm, 6px);
  background: color-mix(in srgb, var(--pillar-accent) 4%, var(--surface));
  display: flex;
  flex-direction: column;
  gap: 0.5rem;
}

.principle-inline-form__input {
  width: 100%;
  font-size: 0.875rem;
}

.principle-inline-form__nn-label {
  display: flex;
  align-items: center;
  gap: 0.375rem;
  font-size: 0.8125rem;
  color: var(--text-muted);
  cursor: pointer;
}

.principle-inline-form__nn-check {
  accent-color: var(--pillar-accent);
}

.principle-inline-form__actions {
  display: flex;
  gap: 0.5rem;
  justify-content: flex-end;
}
</style>
