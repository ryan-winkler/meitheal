---
import { boardContextHref } from "@lib/board-workspace"
import { readBoardPagePlacement } from "@lib/board-page-placement"
import { resolveBoardPageScope, boardScopeResponse } from "@lib/board-http"

import BoardRoutineCheckins from "../components/boards/BoardRoutineCheckins.astro"
/**
 * Today Page — Smart Daily Cockpit
 *
 * @domain tasks
 * @bounded-context tasks (presentation)
 *
 * Single-pane-of-glass daily view with sections:
 * 1. Daily Stats
 * 2. Quick Add (NL-aware + defaults due_date = today)
 * 3. Filter Bar (search, status, priority, RICE, sort)
 * 4. Carried Forward (overdue tasks with triage / snooze)
 * 5. Shared favorites
 * 6. Due Today (hard landscape)
 * 7. Unscheduled (no due date)
 * 8. Suggested (smart picks)
 *
 * @kcs This page uses the shared TaskListItem component for all task rendering.
 * The inline script is replaced by today-controller.ts module.
 */
import Icon from "../components/ui/Icon.astro"
import Layout from "../layouts/Layout.astro"
import CachedHtmlSlot from "../components/ui/CachedHtmlSlot.astro"
import UnifiedBar from "../components/layout/UnifiedBar.astro"
import { readRequestOrganizationLabels } from "@lib/organization-labels"
import EmptyState from "../components/ui/EmptyState.astro"
import InlineHelper from "../components/ui/InlineHelper.astro"
import TaskListItem from "../components/tasks/TaskListItem.astro"
import StatusBadge from "../components/ui/StatusBadge.astro"
import { taskSurface } from "../lib/task-surface"
import { taskDetailPath } from "../lib/task-page-url"
import { effectiveTaskScheduledDate } from "@meitheal/domain-tasks"
import { scopePermits } from "@domains/tasks/board-scope"
import { mapEntityEmojiToTabler } from "@lib/tabler-svg"
import { getPersistenceClient } from "@domains/tasks/persistence/store"
import { TemplateRepository } from "@domains/tasks/persistence/template-repository"
import type { HabitWithStats } from "@domains/tasks/persistence/template-repository"
import { getTodayTaskRows, todayCompletionPercent, todayDueSection, type TaskViewItem } from "../lib/task-queries"
import { calendarDayFromInput, calendarEventSpanDays, calendarToday, formatDayHeading, formatRelativeDue, shiftCalendarDay } from "../lib/date"
import { db503Response } from "../lib/db-fallback"
import { isFeatureEnabled } from "../lib/feature-flags"
import { isOrganizationFeatureAvailable } from "../lib/organization-request-context"
import { TODAY_SECTIONS } from "../lib/today-registry"
import { verifiedIngressUser } from "../lib/verified-ingress-user"
import { getUnscheduledPage, requestedUnscheduledPage, setUnscheduledPage } from "../lib/today-list"
const workScopeResult = await resolveBoardPageScope(Astro, { boardId: Astro.props.boardId })
if (!workScopeResult.ok) return boardScopeResponse(workScopeResult.errorCode)
const workScope = workScopeResult.scope
const pagePlacement = await readBoardPagePlacement(workScope, Astro.url)
if (!pagePlacement.ok) return boardScopeResponse(pagePlacement.errorCode)
const placement = pagePlacement.placement
const contextHref = (path: string) => boardContextHref({ boardId: workScope.boardId, area: pagePlacement.area?.id, project: pagePlacement.project?.id }, path)
let todayBoardName = workScope.boardId === "household" ? "Household Board" : "Board"
try {
  const { rows: [boardRow] } = await getPersistenceClient().execute({
    sql: "SELECT name FROM task_boards WHERE id = ?",
    args: [workScope.boardId],
  })
  if (boardRow?.name) todayBoardName = String(boardRow.name)
} catch { /* fallback to default label */ }


let carriedForwardTasks: TaskViewItem[] = []
let pinnedTasks: TaskViewItem[] = []
let todayTasks: TaskViewItem[] = []
let noDueTasks: TaskViewItem[] = []
let suggestedTasks: TaskViewItem[] = []
let focusStackTasks: TaskViewItem[] = []
let focusCandidateIds = new Set<string>()
let completedTodayCount = 0
let completedTaskSummaries: Awaited<ReturnType<typeof getTodayTaskRows>>["completedTasks"] = []
let unscheduledCount = 0
let totalOpenCount = 0
let currentStreak = 0
let dailyStreak: number | undefined
let todayXP = 0
let habits: HabitWithStats[] = []
let habitsEnabled = false
const todayTimeZone = Astro.locals.timezone || "Europe/Dublin"
const todayDate = new Date()
const todayIsoDate = calendarToday(todayTimeZone, todayDate)
const reopening = Astro.url.searchParams.has("todayRefresh")
const canCompleteRoutine = scopePermits(workScope, { resource: "routine", action: "read" }) && scopePermits(workScope, { resource: "task", action: "complete" }) && scopePermits(workScope, { resource: "task", action: "create" })

function focusDueLabel(task: TaskViewItem): string | undefined {
  const scheduled = effectiveTaskScheduledDate(task)
  if (!scheduled) return
  return task.is_overdue ? "Overdue" : formatRelativeDue(scheduled, todayTimeZone, todayDate)
}

try {
  const todayStr = todayIsoDate
  const includeUnscheduled = requestedUnscheduledPage(Astro.url.searchParams) !== null
  const { tasks, completedTodayCount: completed, openUnscheduledCount, completedTasks } = await getTodayTaskRows(todayStr, includeUnscheduled, todayTimeZone, todayDate, workScope, placement)
  completedTodayCount = completed
  completedTaskSummaries = completedTasks

  // Partition tasks into sections
  for (const task of tasks) {
    // Promoted tasks
    if (task.is_promoted) {
      pinnedTasks.push(task)
    }

    const span = calendarEventSpanDays(task, todayTimeZone)
    if (span) {
      const { startDay, endDay } = span
      const ongoingEventToday = task.task_kind === "calendar_event" && startDay <= todayStr && endDay >= todayStr
      const section = ongoingEventToday ? "due" : todayDueSection(startDay, todayStr, todayTimeZone)

      if (section === "carried") {
        // Carried forward (overdue)
        carriedForwardTasks.push(task)
      } else if (section === "due") {
        // Due today
        todayTasks.push(task)
      }
      // Future dates go to suggested if high priority
    } else if (includeUnscheduled) {
      // No scheduled date → unscheduled
      noDueTasks.push(task)
    }
  }

  // Suggested: high-priority tasks due within 3 days + top-RICE unscheduled
  const threeDaysStr = shiftCalendarDay(todayStr, 3)
  const todayTaskIds = new Set(todayTasks.map(task => task.id))

  suggestedTasks = tasks.filter(t => {
    if (t.is_done || todayTaskIds.has(t.id)) return false
    const scheduled = effectiveTaskScheduledDate(t)
    const dueDay = scheduled ? calendarDayFromInput(scheduled, todayTimeZone) : null
    // Already in today or carried forward
    if (dueDay === todayStr) return false
    if (t.is_overdue) return false
    // High priority due within 3 days
    if (dueDay && dueDay <= threeDaysStr && t.priority <= 2) return true
    // Top RICE unscheduled (not already in unscheduled section to avoid double)
    if (!scheduled && t.rice !== null && t.rice >= 15) return true
    return false
  }).slice(0, 8)

  // Remove suggested from noDueTasks to avoid double-showing
  const suggestedIds = new Set(suggestedTasks.filter(task => !effectiveTaskScheduledDate(task)).map(task => task.id))
  noDueTasks = noDueTasks.filter(t => !suggestedIds.has(t.id))

  // Focus Stack — top 3 actionable tasks ranked by urgency for ADHD decision support
  // Ranking: overdue first → highest priority → nearest due date
  const focusCandidates = tasks
    .filter(t => {
      if (t.is_done) return false
      const scheduled = effectiveTaskScheduledDate(t)
      if (!scheduled) return false
      const dueDay = calendarDayFromInput(scheduled, todayTimeZone)
      return dueDay !== null && dueDay <= todayStr
    })
    .sort((a, b) => {
      const overdueOrder = Number(b.is_overdue) - Number(a.is_overdue)
      if (overdueOrder) return overdueOrder
      const aPri = Number(a.priority ?? 3)
      const bPri = Number(b.priority ?? 3)
      if (aPri !== bPri) return aPri - bPri
      const aDate = effectiveTaskScheduledDate(a)
      const bDate = effectiveTaskScheduledDate(b)
      if (aDate && bDate) return aDate.localeCompare(bDate)
      return 0
    })
  focusStackTasks = focusCandidates.slice(0, 3)
  if (reopening) focusCandidateIds = new Set(focusCandidates.map(task => task.id))

  const unscheduledAfterSuggestions = openUnscheduledCount - suggestedIds.size
  totalOpenCount = carriedForwardTasks.length + todayTasks.length + unscheduledAfterSuggestions
  unscheduledCount = unscheduledAfterSuggestions - pinnedTasks.filter(task => !effectiveTaskScheduledDate(task) && !suggestedIds.has(task.id)).length
} catch (error) {
  if (reopening || Astro.request.headers.get("x-meitheal-refresh") === "1") {
    return db503Response("today-refresh", error)
  }
}

// G36: Fetch gamification stats for streak/XP display.
if (isOrganizationFeatureAvailable("achievements")) try {
  const { getDailyProgress } = await import("@domains/gamification")
  const progress = await getDailyProgress(workScope, todayDate, todayTimeZone)
  dailyStreak = currentStreak = progress.currentStreak
  todayXP = progress.points
} catch { /* gamification may not be initialized */ }

// G38: Fetch habits for Today section
try {
  habitsEnabled = await isFeatureEnabled("habits")
  if (habitsEnabled) {
    const repo = new TemplateRepository(getPersistenceClient(), workScope)
    habits = await repo.getRoutinesWithStats(placement.areaId ?? undefined, placement.projectId ?? undefined, todayTimeZone)
  }
} catch { /* habits may not be available */ }

// Remove pinned duplicates from other sections (keep in Pinned section)
const pinnedIds = new Set(pinnedTasks.map(t => t.id))
carriedForwardTasks = carriedForwardTasks.filter(t => !pinnedIds.has(t.id))
todayTasks = todayTasks.filter(t => !pinnedIds.has(t.id))
noDueTasks = noDueTasks.filter(t => !pinnedIds.has(t.id))

const unscheduled = getUnscheduledPage(noDueTasks, Astro.url.searchParams)
if (unscheduled) Astro.response.headers.set("Cache-Control", "private, no-store")
function unscheduledLink(page: number): string {
  const url = setUnscheduledPage(new URL(Astro.url), page)
  return `${url.pathname}${url.search}#today-work`
}

const remainingCount = carriedForwardTasks.length + todayTasks.length + pinnedTasks.length
const todayHeroSignal = `${todayTasks.length} due today · ${carriedForwardTasks.length} carried forward`
const locale = Astro.cookies.get("meitheal-locale")?.value === "ga" ? "ga-IE" : "en-IE"
const todayDateLabel = formatDayHeading(todayDate, locale, todayTimeZone)
const completionPercent = todayCompletionPercent(completedTodayCount, remainingCount)
const orgState = await readRequestOrganizationLabels(Astro).catch(() => null)
const orgLabelsKey = orgState ? `${orgState.revision}:${JSON.stringify(orgState.forms)}` : ""
const todayBarCacheKey = JSON.stringify([
  "today-bar-v1",
  locale === "ga-IE" ? "ga" : "en",
  todayIsoDate,
  todayBoardName,
  orgLabelsKey,
])
const todayFlowCacheKey = JSON.stringify([
  "today-flow-v1",
  workScope.boardId,
  pagePlacement.area?.id ?? null,
  pagePlacement.project?.id ?? null,
])
---

<Layout title="Meitheal — Today" workNavigation={{ scope: workScope, placement: pagePlacement,
  ...(dailyStreak !== undefined ? { dailyStreak } : {}),
}}>
  <CachedHtmlSlot slot="custom-header" cacheKey={todayBarCacheKey}>
    <UnifiedBar
      title="Today"
      titleIcon="today"
      tabs={TODAY_SECTIONS.map((section) => ({
        id: section.id,
        label: section.label,
        icon: section.icon,
      }))}
      searchPlaceholder="Search Meitheal…"
      searchScope="all"
      barId="today-bar"
    >
      <button
        slot="actions"
        type="button"
        class="unified-bar__new-task-btn today-shell__clear-btn"
        id="clear-completed-btn"
        data-today-archive={todayIsoDate}
        title={`Archive Complete ${todayBoardName} tasks last updated today`}
        aria-label="Archive completed"
      >
        <span class="unified-bar__new-task-label">Archive completed</span>
      </button>
    </UnifiedBar>
  </CachedHtmlSlot>

  <div id="page-shell" class="page-shell" data-today-day={todayIsoDate} data-today-timezone={todayTimeZone} data-today-board={workScope.boardId} data-today-area={placement.areaId ?? undefined} data-today-project={placement.projectId ?? undefined}>
    <div id="today-rollover" class="alert alert-warning" role="status" hidden>
      Today has changed. <button type="button" class="btn btn-sm" data-today-refresh>Refresh Today</button>
    </div>
    <section
      id="today-overview"
      class="page-shell__section page-shell__section--overview"
      data-today-section
    >
      <header class="today-summary">
        <div>
          <h1>Today</h1>
          <p class="today-summary__date"><time datetime={todayIsoDate}>{todayDateLabel}</time></p>
        </div>
        <p class="today-summary__signal" id="today-signal-summary">{todayHeroSignal}</p>
      </header>

      <div class="daily-stats-container" id="daily-stats-container">
        <div class="daily-stats" id="daily-stats">
          <a href="#today-work" class="stat-item" data-today-section-link>
            <span class="stat-value" data-today-count="dueToday">{todayTasks.length}</span>
            <span class="stat-label">Due Today</span>
          </a>
          <div class="stat-item">
            <span class="stat-value" data-today-count="completedToday">{completedTodayCount}</span>
            <span class="stat-label">Completed</span>
          </div>
          <a href="#today-triage" class="stat-item" data-today-section-link>
            <span class="stat-value" data-today-count="carriedForward">{carriedForwardTasks.length}</span>
            <span class="stat-label stat-danger">Carried forward</span>
          </a>
          <div class="stat-item">
            <span class="stat-value" data-today-count="remaining">{remainingCount}</span>
            <span class="stat-label">Remaining</span>
          </div>
          {currentStreak > 0 && (
            <div class="stat-item stat-streak">
              <span class="stat-value"><Icon name="flame" size={16} sprite={true} />{currentStreak}</span>
              <span class="stat-label">Streak</span>
            </div>
          )}
          {todayXP > 0 && (
            <div class="stat-item stat-xp">
              <span class="stat-value" style="color: var(--accent);">+{todayXP}</span>
              <span class="stat-label">XP Today</span>
            </div>
          )}
        </div>
        <div class="daily-stats-progress-bar" role="progressbar" aria-label="Today's tasks completed" aria-valuenow={completionPercent} aria-valuemin="0" aria-valuemax="100">
          <div
            class="daily-stats-progress-fill"
            style={`width: ${completionPercent}%`}
          ></div>
        </div>
      </div>

      <div class="card today-shell__capture-card">
        <form id="quick-add-form" class="quick-add-form">
          <label class="sr-only" for="quick-add-input">Add a task for today</label>
          <input
            type="text"
            id="quick-add-input"
            class="form-input flex-1 quick-add-input"
            placeholder="Add a task for today…"
            autocomplete="off"
          />
          <button type="submit" class="btn btn-primary quick-add-submit">
            Add
          </button>
        </form>
        <p class="quick-add-hint">Dates and lists work here too. Try “call dentist tomorrow” or “shopping: milk, eggs”.</p>
        <div
          id="quick-add-feedback"
          style="display: none; font-size: 11px; color: var(--text-muted); margin-top: 4px; padding-left: 2px;"
        ></div>
      </div>
    </section>

    <CachedHtmlSlot cacheKey={focusStackTasks.length === 0 ? "today-focus-empty-v1" : null}>
      <section id="today-focus" class="page-shell__section" data-today-section>
        <div class="page-shell__intro">
          <div>
            <div class="page-shell__eyebrow">Focus</div>
            <h2 class="page-shell__title">Priority tasks</h2>
          </div>
        </div>

        {focusStackTasks.length > 0 ? (
          <div class="focus-stack" id="section-focus-stack">
            <div class="focus-stack__header">
              <span class="focus-stack__title">Next tasks</span>
              <span class="focus-stack__subtitle">
                {focusStackTasks.length} to focus on
              </span>
            </div>
            <div class="focus-stack__cards">
              {focusStackTasks.map((task, i) => (
                <div
                  class={`focus-card ${task.is_overdue ? "focus-card--overdue" : ""}`}
                  data-id={task.id}
                  {...taskSurface(task.status, task.color)}
                  data-focus-index={i}
                >
                  <span class="focus-card__step">{i + 1}</span>
                  <a class="focus-card__body" href={taskDetailPath(task)} data-task-detail-link={task.id}>
                    <span class="focus-card__title">{task.title}</span>
                    <div class="focus-card__meta">
                      {task.priority && task.priority <= 2 && (
                        <span class="focus-card__priority" data-pri={task.priority}>
                          {task.priority === 1 ? "▲ Critical" : "↑ High"}
                        </span>
                      )}
                      <span class="focus-card__work-status"><StatusBadge status={task.status} /></span>
                      {effectiveTaskScheduledDate(task) && (
                        <span class="focus-card__due">
                          <Icon name={task.is_overdue ? "alert-triangle" : "calendar-event"} size={12} sprite={true} />
                          {focusDueLabel(task)}
                        </span>
                      )}
                    </div>
                  </a>
                  <button
                    type="button"
                    class="focus-card__complete btn btn-sm"
                    data-id={task.id}
                    title="Complete this task"
                    aria-label={`Complete ${task.title}`}
                  >
                    <Icon name="check" size={14} sprite />
                  </button>
                </div>
              ))}
            </div>
          </div>
        ) : (
          <div class="today-shell__empty card">
            No urgent focus items are competing for attention right now.
          </div>
        )}

        <div class="today-filter-bar" id="today-filter-bar">
          <input
            type="text"
            id="today-search"
            class="form-input"
            placeholder="Search tasks..."
            autocomplete="off"
          />
          <select id="today-filter-status" class="form-select" aria-label="Filter by status">
            <option value="">All Status</option>
            <option value="pending">Todo</option>
            <option value="active">Active</option>
            <option value="complete">Done</option>
            <option value="overdue">Overdue</option>
          </select>
          <select id="today-filter-priority" class="form-select" aria-label="Filter by priority">
            <option value="">All Priority</option>
            <option value="1">▲ Critical</option>
            <option value="2">↑ High</option>
            <option value="3">→ Medium</option>
            <option value="4">↓ Low</option>
            <option value="5">· Minimal</option>
          </select>
          <select id="today-filter-rice" class="form-select" aria-label="Filter by RICE score">
            <option value="">All RICE</option>
            <option value="high">High (≥15)</option>
            <option value="medium">Medium (8-14)</option>
            <option value="low">Low (&lt;8)</option>
          </select>
          <select id="today-sort" class="form-select" aria-label="Sort tasks">
            <option value="priority-asc">Priority ↑</option>
            <option value="priority-desc">Priority ↓</option>
            <option value="rice-desc">RICE ↓</option>
            <option value="rice-asc">RICE ↑</option>
            <option value="due_date-asc">Due Soonest</option>
            <option value="due_date-desc">Due Latest</option>
            <option value="title-asc">Title A-Z</option>
            <option value="title-desc">Title Z-A</option>
          </select>
          <button type="button" id="today-clear-filters" class="btn btn-sm" title="Clear filters" aria-label="Clear filters">
            <Icon name="x" size={16} sprite={true} />
          </button>
          <button type="button" id="batch-mode-toggle" class="btn btn-sm" title="Toggle multi-select mode" aria-pressed="false" hidden><Icon name="checkbox" size={16} sprite={true} /></button>
        </div>
      </section>
    </CachedHtmlSlot>

    <CachedHtmlSlot cacheKey={carriedForwardTasks.length === 0 && suggestedTasks.length === 0 ? "today-triage-empty-v1" : null}>
      <section id="today-triage" class="page-shell__section" data-today-section>
        <div class="page-shell__intro">
          <div>
            <div class="page-shell__eyebrow">Triage</div>
            <h2 class="page-shell__title">Overdue and suggested tasks</h2>
          </div>
        </div>

        <div id="migration-prompt" class="today-section" style="display: none;"></div>

        <div class="today-section" id="section-carried" hidden={carriedForwardTasks.length === 0}>
          <button type="button" class="today-section__header today-section__toggle"
            aria-controls="today-carried-list" aria-expanded="true">
            <Icon name="chevron-down" size={14} class="today-section__icon" sprite={true} />
            <span class="today-section__title" style="color: var(--warning-text, var(--warning));">
              <Icon name="refresh" size={16} sprite={true} /> Carried Forward
            </span>
            <span class="today-section__count" id="today-carried-list-count">{carriedForwardTasks.length}</span>
          </button>
          <div class="today-section__list" id="today-carried-list" data-today-task-list>
            {carriedForwardTasks.map(task => (
              <TaskListItem task={task} showSnooze showActions focusDueLabel={reopening ? focusDueLabel(task) : undefined} section="Carried Forward" />
            ))}
          </div>
        </div>
        <div class="today-shell__empty card" data-today-carried-empty hidden={carriedForwardTasks.length > 0}>No carried-forward work is waiting on you.</div>

        <div class="today-section" id="section-suggested" hidden={suggestedTasks.length === 0}>
          <button type="button" class="today-section__header today-section__toggle"
            aria-controls="today-suggested-list" aria-expanded="true">
            <Icon name="chevron-down" size={14} class="today-section__icon" sprite={true} />
            <span class="today-section__title" style="color: var(--accent-text);">
              <Icon name="sparkles" size={16} sprite={true} /> Suggested
            </span>
            <span class="today-section__count" id="today-suggested-list-count">{suggestedTasks.length}</span>
          </button>
          <div class="today-section__list" id="today-suggested-list" data-today-task-list>
            {suggestedTasks.map(task => (
              <TaskListItem task={task} showFocusToday showActions section="Suggested" />
            ))}
          </div>
        </div>
      </section>
    </CachedHtmlSlot>

    <section id="today-work" class="page-shell__section" data-today-section>
      <div class="page-shell__intro">
        <div>
          <div class="page-shell__eyebrow">Work</div>
          <h2 class="page-shell__title">Your task list</h2>
          <p class="page-shell__description">
            Open Unscheduled to find tasks without a due date, including ones added by Home Assistant automations.
          </p>
        </div>
      </div>

      <div class="today-section" id="section-calendar-events" style="display: none;">
        <button type="button" class="today-section__header today-section__toggle"
          aria-controls="calendar-events-list" aria-expanded="true">
          <Icon name="chevron-down" size={14} class="today-section__icon" sprite={true} />
          <span class="today-section__title" style="color: var(--info, #60a5fa);">
            <Icon name="calendar-event" size={16} sprite={true} /> Calendar Events
          </span>
          <span class="today-section__count" id="calendar-events-count">0</span>
        </button>
        <div class="today-section__list" id="calendar-events-list">
          <div class="skeleton-line" style="width: 70%;"></div>
          <div class="skeleton-line" style="width: 55%;"></div>
          <div class="skeleton-line" style="width: 65%;"></div>
        </div>
      </div>

      <div class="today-section" id="section-pinned" hidden={pinnedTasks.length === 0}>
        <button type="button" class="today-section__header today-section__toggle"
          aria-controls="today-pinned-list" aria-expanded="true">
          <Icon name="chevron-down" size={14} class="today-section__icon" sprite={true} />
          <span class="today-section__title">
            <Icon name="star" size={16} sprite={true} /> Promoted
          </span>
          <span class="today-section__count" id="today-pinned-list-count">{pinnedTasks.length}</span>
        </button>
        <div class="today-section__list" id="today-pinned-list" data-today-task-list>
          {pinnedTasks.map(task => (
            <TaskListItem task={task} showSnooze showActions focusDueLabel={focusCandidateIds.has(task.id) ? focusDueLabel(task) : undefined} section="Promoted" />
          ))}
        </div>
      </div>

      <div class="today-section" id="section-today">
        <button type="button" class="today-section__header today-section__toggle"
          aria-controls="today-due-list" aria-expanded="true">
          <Icon name="chevron-down" size={14} class="today-section__icon" sprite={true} />
          <span class="today-section__title">
            <Icon name="sun" size={16} sprite={true} /> Due Today
          </span>
          <span class="today-section__count" id="today-due-list-count">{todayTasks.length}</span>
        </button>
        <div class="today-section__list" id="today-due-list" data-today-task-list>
          <div data-today-due-empty hidden={todayTasks.length > 0}>
            <EmptyState
              title={remainingCount === 0 && completedTodayCount > 0 ? "Today’s tasks are complete" : "Nothing due today"}
              icon="check"
              actionText="Add a task"
              actionEvent="meitheal:new-task"
            />
          </div>
          {todayTasks.map(task => (
            <TaskListItem task={task} showSnooze showActions focusDueLabel={reopening ? focusDueLabel(task) : undefined} section="Due Today" />
          ))}
        </div>
      </div>

      <BoardRoutineCheckins scope={workScope} placement={placement} contextName={pagePlacement.project?.name ?? pagePlacement.area?.name} />


      <details class="today-completed-tasks" hidden={completedTaskSummaries.length === 0}>
        <summary>Completed today ({completedTodayCount})</summary>
        <p hidden={completedTaskSummaries.length >= completedTodayCount}>
          Showing {completedTaskSummaries.length} of {completedTodayCount} completions. Archive applies to all {completedTodayCount}.
        </p>
        <ul>
          {completedTaskSummaries.map(task => (
            <li>
              <a href={taskDetailPath(task)} data-task-detail-link={task.id} data-today-completion>
                <Icon name="checkbox" size={17} sprite={true} />
                <span>{task.title}</span>
              </a>
            </li>
          ))}
        </ul>
        <div class="today-completed-tasks__actions">
          <button type="button" class="btn btn-outline" data-today-archive={todayIsoDate}>
            <Icon name="check" size={16} sprite={true} /> Archive completed
          </button>
        </div>
      </details>

      <div class:list={["today-section", { "today-section--collapsed": !unscheduled }]} id="section-unscheduled" hidden={!unscheduled && unscheduledCount <= 0}>
        <button type="button" class="today-section__header today-section__toggle"
          aria-controls="today-unscheduled-list" aria-expanded={Boolean(unscheduled)}>
          <Icon name="chevron-down" size={14} class="today-section__icon" sprite={true} />
          <span class="today-section__title">
            <Icon name="pin" size={16} sprite={true} /> Unscheduled
          </span>
          <span class="today-section__count" id="today-unscheduled-list-count">{unscheduledCount}</span>
        </button>
        <div class="today-section__list" id="today-unscheduled-list" hidden={!unscheduled}>
          <div id="today-unscheduled-page" data-page={unscheduled?.number ?? 0}>
            {unscheduled && (
              <>
                <p class="today-unscheduled-pagination" role="status" tabindex="-1" data-unscheduled-range>
                  {unscheduled.total ? `Showing ${unscheduled.first}–${unscheduled.last} of ${unscheduled.total}` : "No unscheduled tasks match these filters"}
                </p>
                {unscheduled.items.map(task => (
                  <TaskListItem task={task} showActions section="Unscheduled" />
                ))}
                {unscheduled.pages > 1 && <nav class="today-unscheduled-pagination" aria-label="Unscheduled tasks pages">
                  {unscheduled.number > 1 && (
                    <a class="btn btn-sm" href={unscheduledLink(unscheduled.number - 1)} data-unscheduled-page={unscheduled.number - 1}>Previous</a>
                  )}
                  {unscheduled.number < unscheduled.pages && (
                    <a class="btn btn-sm" href={unscheduledLink(unscheduled.number + 1)} data-unscheduled-page={unscheduled.number + 1}>Next</a>
                  )}
                </nav>}
              </>
            )}
          </div>
          <p role="status" id="today-unscheduled-status" hidden></p>
          <button type="button" class="btn btn-sm" id="today-unscheduled-retry" hidden>Retry</button>
        </div>
      </div>
    </section>

    <CachedHtmlSlot cacheKey={habits.length === 0 ? `today-habits-empty-v1:${habitsEnabled}` : null}>
      <section id="today-habits" class="page-shell__section" data-today-section>
        <div class="page-shell__intro">
          <div>
            <div class="page-shell__eyebrow">Habits</div>
            <h2 class="page-shell__title">Your routines</h2>
          </div>
        </div>

        <div class="today-section" id="section-habits">
          <button type="button" class="today-section__header today-section__toggle"
            aria-controls="today-habits-list" aria-expanded="true">
            <Icon name="chevron-down" size={14} class="today-section__icon" sprite={true} />
            <span class="today-section__title" style="color: var(--accent-text);">
              <Icon name="repeat" size={16} sprite={true} /> Habits / Routines
            </span>
            <span class="today-section__count" id="today-habits-list-count">{habits.length}</span>
          </button>
          <div class="today-section__list" id="today-habits-list">
            {habitsEnabled && habits.length > 0 ? (
              habits.map(habit => {
                const routineIcon = mapEntityEmojiToTabler(habit.icon)
                return (
                <div
                  class={`habit-card ${habit.todayCompleted ? "habit-card--done" : ""}`}
                  data-habit-id={habit.id}
                  data-today-task-id={habit.todayTaskId ?? ""}
                >
                  <span class="habit-card__icon" aria-hidden="true">
                    {routineIcon ? <Icon name={routineIcon} size={18} sprite /> : habit.icon}
                  </span>
                  <div class="habit-card__info">
                    <span class="habit-card__name">{habit.name}</span>
                    <span class="habit-card__meta">
                      {habit.currentStreak > 0 && <span class="habit-card__streak"><Icon name="flame" size={14} sprite />{habit.currentStreak}</span>}
                      <span class="habit-card__total">{habit.totalCompletions} total</span>
                      {!habit.projectActive && <span class="habit-card__inactive">Paused project</span>}
                      {habit.todayTaskId && <a class="habit-card__task-link" href={taskDetailPath(habit.todayTaskId)}>View task</a>}
                    </span>
                  </div>
                  <button
                    type="button"
                    class="habit-card__complete btn btn-sm"
                    disabled={habit.todayCompleted || !canCompleteRoutine || !habit.projectActive}
                    aria-pressed={habit.todayCompleted ? "true" : "false"}
                  >
                    {habit.todayCompleted ? <><Icon name="check" size={14} sprite /> Done</> : "Complete"}
                  </button>
                </div>
                )
              })
            ) : (
              <div class="today-shell__empty card">
                {habitsEnabled
                  ? "No active routines are feeding into Today yet."
                  : "Routines are currently disabled for this workspace."}
              </div>
            )}
          </div>
        </div>
      </section>
    </CachedHtmlSlot>

    <CachedHtmlSlot cacheKey={todayFlowCacheKey}>
      <section id="today-flow" class="page-shell__section" data-today-section>
        <div class="page-shell__intro">
          <div>
            <div class="page-shell__eyebrow">Flow</div>
            <h2 class="page-shell__title">Other views</h2>
          </div>
        </div>

        <InlineHelper helperId="today-flow-explainer" title="Navigation & Context" icon="inbox" variant="tip">
          <p>Open <strong>Tasks Hub</strong> for Kanban, Calendar, Table or Timeline. Use <strong>Planning</strong> to prioritise and <strong>Progress</strong> to review routines and goals.</p>
        </InlineHelper>

        <div class="page-flow-grid">
          <a class="card page-flow-card" href={contextHref("/upcoming")}>
            <strong><Icon name="calendar-event" size={14} sprite={true} /> Upcoming</strong>
            <p>See what’s due in the next seven days.</p>
          </a>
          <a class="card page-flow-card" href={contextHref("/tasks?view=calendar#calendar")}>
            <strong><Icon name="calendar" size={14} sprite={true} /> Calendar</strong>
            <p>See tasks and events by date.</p>
          </a>
          <a class="card page-flow-card" href={contextHref("/planning#eisenhower")}>
            <strong><Icon name="eisenhower" size={14} sprite={true} /> Eisenhower</strong>
            <p>Sort tasks by urgency and importance.</p>
          </a>
          <a class="card page-flow-card" href={contextHref("/tasks#kanban")}>
            <strong><Icon name="kanban" size={14} sprite={true} /> Kanban</strong>
            <p>Move tasks between status columns.</p>
          </a>
          <a class="card page-flow-card" href={contextHref("/progress#routines")}>
            <strong><Icon name="trophy" size={14} sprite={true} /> Progress</strong>
            <p>Track routines, goals, and achievements in one place.</p>
          </a>
        </div>
      </section>
    </CachedHtmlSlot>
  </div>
  <div id="batch-action-bar" hidden>
    <span></span>
    <button type="button" class="btn btn-sm" value="complete"><Icon name="check" size={14} sprite /> Complete</button>
    <button type="button" class="btn btn-sm" value="snooze" title="Snooze selected +1 day"><Icon name="clock" size={14} sprite={true} /> Snooze</button>
    <button type="button" class="btn btn-sm" value="delete"><Icon name="trash" size={14} sprite={true} /> Delete</button>
    <button type="button" class="btn btn-sm" value="deselect">Deselect all</button>
  </div>
</Layout>

<style>
  /* Shared section and flow styles are in _page-shell.css. */
  #page-shell {
    gap: 1.5rem;
    padding-block-start: 12px;
  }

  :global([data-theme="knight-rider"][data-appearance-width="default"]) #page-shell {
    max-width: 960px;
    margin-inline: auto;
  }

  .today-summary {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    flex-wrap: wrap;
    gap: 0.5rem 1rem;
  }

  .today-summary h1 {
    margin: 0;
    font-size: 1.5rem;
    line-height: 1.2;
  }

  .today-summary__date,
  .today-summary__signal,
  .quick-add-hint {
    margin: 0.25rem 0 0;
    color: var(--text-secondary);
    font-size: 0.8125rem;
  }

  .page-shell__title {
    font-size: 1.125rem;
  }

  .page-shell__description {
    margin-top: 0.25rem;
    font-size: 0.875rem;
  }


  .today-shell__capture-card {
    margin-bottom: 0;
    padding: 0.75rem 1rem;
    box-shadow: none;
    transition: none;
  }
  .today-shell__capture-card:hover {
    transform: none;
    border-color: var(--border);
  }
  #quick-add-feedback {
    flex-wrap: wrap;
    gap: 4px 12px;
  }
  :global(.quick-add-feedback-part) {
    display: inline-flex;
    align-items: center;
    gap: 4px;
  }
  .quick-add-form {
    display: flex;
    gap: 8px;
    align-items: center;
  }
  .quick-add-input {
    min-width: 0;
    min-height: 44px;
    font-size: 14px;
  }
  .quick-add-submit {
    padding: 8px 16px;
    min-height: 44px;
    white-space: nowrap;
  }

  .today-shell__clear-btn {
    min-height: 40px;
    padding: 0 14px;
    border-radius: 10px;
    border: 1px solid color-mix(in srgb, var(--warning) 35%, var(--border));
    background: color-mix(in srgb, var(--warning) 10%, transparent);
    color: var(--text-primary);
  }

  [data-today-archive][aria-disabled="true"] {
    opacity: 0.55;
    cursor: not-allowed;
  }
  .today-shell__clear-btn:hover {
    background: color-mix(in srgb, var(--warning) 18%, transparent);
    border-color: color-mix(in srgb, var(--warning) 50%, var(--border));
  }

  .today-shell__empty {
    padding: 16px 18px;
    color: var(--text-muted);
  }

  .page-shell__eyebrow {
    color: var(--accent-text);
  }


  /* ── Filter Bar ──────────────────────────────────────────────── */
  .today-filter-bar {
    display: flex;
    gap: 8px;
    margin-bottom: 16px;
    flex-wrap: nowrap;
    align-items: center;
  }
  .today-filter-bar .form-input {
    flex: 1;
    min-width: 120px;
    font-size: 13px;
    padding: 6px 10px;
    transition: border-color 0.2s, box-shadow 0.2s;
  }
  .today-filter-bar .form-input:focus {
    border-color: var(--accent);
    box-shadow: 0 0 0 3px color-mix(in srgb, var(--accent) 15%, transparent);
  }
  .today-filter-bar .form-select {
    font-size: 12px;
    padding: 6px 6px;
    background: var(--bg-card, #1e1e2e);
    color: var(--text);
    border: 1px solid var(--border);
    border-radius: var(--radius-sm, 4px);
    cursor: pointer;
    flex-shrink: 0;
    max-width: 130px;
    transition: border-color 0.2s ease;
  }
  .today-filter-bar .form-select:focus {
    outline: 2px solid var(--border-focus);
    outline-offset: -1px;
  }

  /* Responsive overrides for shell/hero classes are in _page-shell.css */
  .today-filter-bar .btn-sm {
    padding: 5px 8px;
    font-size: 13px;
    flex-shrink: 0;
  }
  @media (max-width: 640px) {
    .today-filter-bar {
      flex-wrap: wrap;
    }
    .today-filter-bar .form-select {
      max-width: none;
      flex: 1;
      min-width: 100px;
    }
  }

  /* ── Sections ────────────────────────────────────────────────── */
  .today-section {
    background: var(--bg-card);
    border: 1px solid var(--border);
    border-radius: 12px;
    margin-bottom: 14px;
    overflow: hidden;
    transition: border-color 0.2s ease, box-shadow 0.2s ease;
  }
  .today-section:hover {
    border-color: color-mix(in srgb, var(--border) 70%, var(--accent) 30%);
  }

  .today-section__header {
    display: flex;
    align-items: center;
    width: 100%;
    min-height: 44px;
    gap: 10px;
    padding: 12px 16px;
    color: var(--text-primary);
    text-align: start;
    cursor: pointer;
    user-select: none;
    border: 0;
    border-bottom: 1px solid var(--border);
    background: rgba(255, 255, 255, 0.02);
    transition: background 0.15s ease;
  }
  .today-section__header:hover {
    background: rgba(255, 255, 255, 0.05);
  }

  :global([data-theme="knight-rider"]) .today-section {
    background: transparent;
    border: 0;
    border-block-start: 1px solid var(--border);
    border-radius: 0;
  }
  :global([data-theme="knight-rider"]) .today-section__header:not(:hover) {
    background: transparent;
  }

  :global([data-theme="knight-rider"]) #today-due-list :global(.empty-state) {
    border: 0;
    background: transparent;
    margin-block: 12px;
    padding-block: 24px;
  }
  :global([data-theme="knight-rider"]) #today-due-list :global(.empty-state-icon) {
    margin-block-end: 10px;
  }
  :global([data-theme="knight-rider"]) #today-due-list :global(.empty-state-actions .btn-primary:not(:hover)) {
    background: transparent;
    border-color: var(--control-border);
    color: var(--text-primary);
  }

  .today-completed-tasks {
    display: none;
  }
  :global([data-theme="knight-rider"]) .today-completed-tasks:not([hidden]) {
    display: block;
    color: var(--text-muted);
  }
  .today-completed-tasks summary {
    cursor: pointer;
    padding: 12px 0;
    min-block-size: 44px;
    font-weight: 600;
  }
  .today-completed-tasks ul {
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .today-completed-tasks :global(li) {
    border-block-start: 1px solid var(--border);
  }
  :global([data-theme="knight-rider"]:has(.today-completed-tasks[open]:not([hidden]))) .today-shell__clear-btn {
    display: none;
  }
  .today-completed-tasks__actions {
    display: flex;
    justify-content: center;
    padding-block: 16px 8px;
    border-block-start: 1px solid var(--border);
  }
  .today-completed-tasks__actions button {
    min-block-size: 44px;
  }
  .today-completed-tasks :global(a) {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 10px 12px;
    min-block-size: 44px;
    color: var(--text-muted);
    text-decoration: line-through;
    overflow-wrap: anywhere;
  }
  .today-completed-tasks :global(a > svg) { flex: none; }

  .today-section__header:focus-visible {
    outline-offset: -3px;
  }
  .today-section__icon {
    color: var(--text-muted);
    font-size: 10px;
    flex: 0 0 auto;
    display: inline-block;
    transition: transform 0.25s cubic-bezier(0.175, 0.885, 0.32, 1.275);
  }
  .today-section--collapsed .today-section__icon {
    transform: rotate(-90deg);
  }

  .today-section__title {
    font-size: 14px;
    font-weight: 600;
    flex: 1;
    letter-spacing: -0.01em;
    display: flex;
    align-items: center;
    gap: 6px;
  }

  .today-section__count {
    font-size: 12px;
    padding: 2px 8px;
    border-radius: 10px;
    background: color-mix(in srgb, var(--accent) 12%, transparent);
    color: var(--accent-text);
    font-weight: 600;
    flex-shrink: 0;
  }

  .today-section__list {
    transition: max-height 0.3s cubic-bezier(0.16, 1, 0.3, 1), opacity 0.25s ease;
    overflow: hidden;
  }
  .today-section--collapsed .today-section__list {
    max-height: 0;
    opacity: 0;
  }
  .today-section--collapsed .today-section__header {
    border-bottom: none;
  }

  .today-unscheduled-pagination {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 8px;
    padding: 10px 16px;
  }

  /* ── Filtered-out items ──────────────────────────────────────── */
  .filtered-out {
    display: none !important;
  }

  .daily-stats-container {
    border: 1px solid var(--border);
    border-radius: var(--radius-md);
    background: var(--bg-card);
    overflow: hidden;
  }

  .daily-stats {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 9rem), 1fr));
    gap: 1px;
    background: var(--border);
  }

  .daily-stats-progress-bar {
    height: 3px;
    background: var(--bg-hover);
  }

  .daily-stats-progress-fill {
    height: 100%;
    background: var(--accent);
  }

  .stat-item {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    justify-content: center;
    min-height: 72px;
    padding: 0.75rem 1rem;
    gap: 0.25rem;
    background: var(--bg-card);
    text-decoration: none;
  }

  a.stat-item:hover,
  a.stat-item:focus-visible {
    background: var(--bg-hover);
  }

  .stat-value {
    font-size: 1.25rem;
    font-weight: 650;
    color: var(--text-primary);
    font-variant-numeric: tabular-nums;
    line-height: 1.2;
  }

  .stat-label {
    color: var(--text-secondary);
    font-size: 0.75rem;
  }

  .stat-danger {
    color: var(--danger-text, var(--danger));
  }

  /* ── Snooze popover ──────────────────────────────────────────── */
  :global(.snooze-option) {
    padding: 6px 12px;
    font-size: 13px;
    text-align: left;
    background: none;
    border: none;
    color: var(--text-primary);
    cursor: pointer;
    border-radius: var(--radius-sm, 4px);
    transition: background 0.15s;
  }
  :global(.snooze-option:hover),
  :global(.snooze-option:focus-visible) {
    background: var(--bg-hover);
  }

  /* ── G30: Batch mode ────────────────────────────────── */
  :global(#batch-mode-toggle) {
    flex-shrink: 0;
    font-size: 14px;
  }
  :global(#batch-mode-toggle[aria-pressed="true"]) {
    background: var(--accent);
    color: var(--bg);
  }
  :global(.batch-mode .tli) {
    padding-left: 8px;
  }
  :global(.tli__batch-cb) {
    margin-right: 6px;
    accent-color: var(--accent);
  }
  :global(#batch-action-bar:not([hidden])) {
    display: flex;
    position: fixed;
    bottom: 20px;
    left: 50%;
    transform: translateX(-50%);
    z-index: 100;
    align-items: center;
    gap: 10px;
    padding: 10px 16px;
    background: var(--bg-card);
    border: 1px solid var(--border);
    border-radius: var(--radius-md);
    box-shadow: 0 8px 32px rgb(0 0 0 / 0.4);
  }
  :global(#batch-action-bar span) {
    font-size: 13px;
    color: var(--text-muted);
    white-space: nowrap;
  }
  :global(#batch-action-bar [value="delete"]) {
    color: var(--danger);
  }

  /* ── G31: Drag reorder — premium drag feedback ──────── */
  :global(.tli[draggable="true"]) {
    cursor: grab;
  }
  :global(.tli--dragging) {
    opacity: 0.4;
    cursor: grabbing;
    transform: scale(0.98);
  }
  :global(.tli--drag-over) {
    border-top: 2px solid var(--accent);
    box-shadow: 0 -4px 12px -2px color-mix(in srgb, var(--accent) 30%, transparent);
    transition: box-shadow 0.15s ease;
  }

  /* ── G36: Gamification stat items ───────────────────── */
  .stat-streak .stat-value,
  .stat-xp .stat-value {
    font-size: 1rem;
  }
  .stat-streak .stat-value {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    color: var(--warning, #f59e0b);
  }

  /* ── G38: Habit Cards — Premium (match habits.astro) ── */
  :global(.habit-card) {
    display: flex;
    align-items: center;
    gap: 14px;
    padding: 12px 16px;
    border-bottom: 1px solid var(--border);
    transition: background 0.15s ease, transform 0.15s ease;
    position: relative;
  }
  :global(.habit-card::after) {
    content: "";
    position: absolute;
    left: 0;
    top: 8px;
    bottom: 8px;
    width: 3px;
    border-radius: 0 2px 2px 0;
    background: var(--accent);
    opacity: 0;
    transition: opacity 0.2s ease;
  }
  :global(.habit-card:hover) {
    background: rgba(255, 255, 255, 0.03);
  }
  :global(.habit-card:hover::after) {
    opacity: 1;
  }
  :global(.habit-card--done) {
    opacity: 0.6;
  }
  :global(.habit-card--done::after) {
    background: var(--success, #22c55e);
    opacity: 1;
  }
  :global(.habit-card__icon) {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    color: var(--accent);
    font-size: 1.3rem;
    flex-shrink: 0;
  }
  :global(.habit-card__info) {
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: 4px;
  }
  :global(.habit-card__name) {
    font-size: 14px;
    font-weight: 600;
    color: var(--text);
    letter-spacing: -0.01em;
  }
  :global(.habit-card__meta) {
    font-size: 11px;
    color: var(--text-muted);
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    align-items: center;
  }
  :global(.habit-card__streak) {
    display: inline-flex;
    align-items: center;
    gap: 3px;
    color: #92400e;
    font-weight: 700;
    background: rgba(245, 158, 11, 0.14);
    padding: 1px 7px;
    border-radius: 10px;
    font-size: 0.7rem;
  }
  :global(:is([data-theme="dark"], [data-theme="knight-rider"])) :global(.habit-card__streak) {
    color: #fbbf24;
  }
  :global(.habit-card__task-link) {
    color: var(--accent);
    font-weight: 600;
    text-decoration: none;
  }
  :global(.habit-card__task-link:hover) {
