---
/**
 * Today Page — Smart Daily Cockpit
 *
 * @domain tasks
 * @bounded-context tasks (presentation)
 *
 * Single-pane-of-glass daily view with sections:
 * 1. Daily Stats
 * 2. Quick Add (NL-aware + defaults due_date = today)
 * 3. Filter Bar (search, status, priority, RICE, sort)
 * 4. Carried Forward (overdue tasks with triage / snooze)
 * 5. Pinned / MITs (favorited tasks)
 * 6. Due Today (hard landscape)
 * 7. Unscheduled (no due date)
 * 8. Suggested (smart picks)
 *
 * @kcs This page uses the shared TaskListItem component for all task rendering.
 * The inline script is replaced by today-controller.ts module.
 */
import Layout from "../layouts/Layout.astro"
import UnifiedBar from "../components/layout/UnifiedBar.astro"
import EmptyState from "../components/ui/EmptyState.astro"
import TaskListItem from "../components/tasks/TaskListItem.astro"
import {
  ensureSchema,
  getPersistenceClient,
} from "@domains/tasks/persistence/store"
import { TaskRepository } from "@domains/tasks/persistence/task-repository"
import { TemplateRepository } from "@domains/tasks/persistence/template-repository"
import type { HabitWithStats } from "@domains/tasks/persistence/template-repository"
import { getTasksForView, type TaskViewItem } from "../lib/task-queries"
import { isFeatureEnabled } from "../lib/feature-flags"
import { TODAY_SECTIONS } from "../lib/today-registry"

let carriedForwardTasks: TaskViewItem[] = []
let pinnedTasks: TaskViewItem[] = []
let todayTasks: TaskViewItem[] = []
let noDueTasks: TaskViewItem[] = []
let suggestedTasks: TaskViewItem[] = []
let focusStackTasks: TaskViewItem[] = []
let completedTodayCount = 0
let totalOpenCount = 0
let currentStreak = 0
let todayXP = 0
let habits: HabitWithStats[] = []
let habitsEnabled = false

try {
  const { tasks } = await getTasksForView()
  const todayStr = new Date().toISOString().split("T")[0] ?? ""
  const today = new Date()
  today.setHours(0, 0, 0, 0)

  // Partition tasks into sections
  for (const task of tasks) {
    if (task.is_done) {
      // Count completed today
      if (task.updated_at?.startsWith(todayStr)) {
        completedTodayCount++
      }
      continue
    }

    // Pinned / MITs (favorited and not in another section)
    if (task.is_favorite) {
      pinnedTasks.push(task)
    }

    if (task.due_date) {
      const dueDate = new Date(task.due_date)
      dueDate.setHours(0, 0, 0, 0)

      if (dueDate < today) {
        // Carried forward (overdue)
        carriedForwardTasks.push(task)
      } else if (task.due_date === todayStr) {
        // Due today
        todayTasks.push(task)
      }
      // Future dates go to suggested if high priority
    } else {
      // No due date → unscheduled
      noDueTasks.push(task)
    }
  }

  // Suggested: high-priority tasks due within 3 days + top-RICE unscheduled
  const threeDaysOut = new Date(today)
  threeDaysOut.setDate(threeDaysOut.getDate() + 3)
  const threeDaysStr = threeDaysOut.toISOString().split("T")[0]!

  suggestedTasks = tasks.filter(t => {
    if (t.is_done) return false
    // Already in today or carried forward
    if (t.due_date === todayStr) return false
    if (t.is_overdue) return false
    // High priority due within 3 days
    if (t.due_date && t.due_date <= threeDaysStr && t.priority <= 2) return true
    // Top RICE unscheduled (not already in unscheduled section to avoid double)
    if (!t.due_date && t.rice !== null && t.rice >= 15) return true
    return false
  }).slice(0, 8)

  // Remove suggested from noDueTasks to avoid double-showing
  const suggestedIds = new Set(suggestedTasks.map(t => t.id))
  noDueTasks = noDueTasks.filter(t => !suggestedIds.has(t.id))

  // Focus Stack — top 3 actionable tasks ranked by urgency for ADHD decision support
  // Ranking: overdue first → highest priority → nearest due date
  const focusCandidates = tasks
    .filter(t => !t.is_done && (t.due_date === todayStr || (t.due_date && new Date(t.due_date) < today)))
    .sort((a, b) => {
      const aOverdue = a.due_date && a.due_date < todayStr ? 1 : 0
      const bOverdue = b.due_date && b.due_date < todayStr ? 1 : 0
      if (aOverdue !== bOverdue) return bOverdue - aOverdue
      const aPri = Number(a.priority ?? 3)
      const bPri = Number(b.priority ?? 3)
      if (aPri !== bPri) return aPri - bPri
      if (a.due_date && b.due_date) return a.due_date.localeCompare(b.due_date)
      return 0
    })
  focusStackTasks = focusCandidates.slice(0, 3)

  totalOpenCount = carriedForwardTasks.length + todayTasks.length + noDueTasks.length

  // G36: Fetch gamification stats for streak/XP display
  try {
    const { getStats, getWeeklyData } = await import("@domains/gamification")
    const stats = await getStats()
    currentStreak = stats.currentStreak ?? 0
    // Get today's points from weekly data
    const weekly = await getWeeklyData()
    const todayRecord = weekly[weekly.length - 1]
    todayXP = todayRecord?.points ?? 0
  } catch { /* gamification may not be initialized */ }

  // G38: Fetch habits for Today section
  try {
    habitsEnabled = await isFeatureEnabled("habits")
    if (habitsEnabled) {
      const repo = new TemplateRepository(getPersistenceClient())
      habits = await repo.getHabitsWithStats()
    }
  } catch { /* habits may not be available */ }
} catch {
  /* DB not available */
}

// Remove pinned duplicates from other sections (keep in Pinned section)
const pinnedIds = new Set(pinnedTasks.map(t => t.id))
carriedForwardTasks = carriedForwardTasks.filter(t => !pinnedIds.has(t.id))
todayTasks = todayTasks.filter(t => !pinnedIds.has(t.id))
noDueTasks = noDueTasks.filter(t => !pinnedIds.has(t.id))

const remainingCount = carriedForwardTasks.length + todayTasks.length + pinnedTasks.length
const todayHeroSignal =
  carriedForwardTasks.length > 0
    ? `${carriedForwardTasks.length} carried forward needs triage`
    : todayTasks.length > 0
      ? `${todayTasks.length} tasks due today`
      : "Today is under control"
const todayCompletionPercent = Math.round(
  (completedTodayCount / Math.max(1, completedTodayCount + remainingCount)) * 100,
)
---

<Layout title="Meitheal — Today">
  <UnifiedBar
    title="Today"
    titleIcon="☀️"
    tabs={TODAY_SECTIONS.map((section) => ({
      id: section.id,
      label: section.label,
      icon: section.icon,
    }))}
    searchPlaceholder="Search Meitheal…"
    searchScope="all"
    barId="today-bar"
    slot="custom-header"
  >
    <button
      slot="actions"
      type="button"
      class="unified-bar__new-task-btn today-shell__clear-btn"
      id="clear-completed-btn"
      title="Clear completed tasks"
      aria-label="Clear completed tasks"
    >
      <span class="unified-bar__new-task-label">Clear Done</span>
    </button>
  </UnifiedBar>

  <div id="page-shell" class="page-shell">
    <section
      id="today-overview"
      class="page-shell__section page-shell__section--overview"
      data-today-section
    >
      <div class="page-hero">
        <div class="page-hero__eyebrow">Home Assistant Native Daily Cockpit</div>
        <div class="page-hero__title-row">
          <div class="page-hero__copy">
            <h1 class="page-hero__title">A calmer command surface for today</h1>
            <p class="page-hero__description">
              Capture quickly, see what is truly due, and keep habits, calendar context,
              and task flow aligned inside the same local-first execution surface.
            </p>
          </div>

          <div class="page-hero__chips" aria-label="Today quick jumps">
            <a href="#today-focus" class="page-hero__chip" data-today-section-link>
              Focus
            </a>
            <a href="#today-triage" class="page-hero__chip" data-today-section-link>
              Triage
            </a>
            <a href="#today-work" class="page-hero__chip" data-today-section-link>
              Work
            </a>
            <a href="#today-habits" class="page-hero__chip" data-today-section-link>
              Habits
            </a>
          </div>
        </div>

        <div class="page-hero__status">
          <span class="page-hero__status-label">Current signal</span>
          <strong id="today-signal-summary">{todayHeroSignal}</strong>
        </div>
      </div>

      <div class="daily-stats-container" id="daily-stats-container">
        <div class="daily-stats" id="daily-stats">
          <a href="#today-work" class="stat-item" data-today-section-link>
            <span class="stat-value">{todayTasks.length}</span>
            <span class="stat-label">Due Today</span>
          </a>
          <div class="stat-item">
            <span class="stat-value">{completedTodayCount}</span>
            <span class="stat-label">Completed</span>
          </div>
          <a href="#today-triage" class="stat-item" data-today-section-link>
            <span class="stat-value">{carriedForwardTasks.length}</span>
            <span class="stat-label stat-danger">Carried Fwd</span>
          </a>
          <div class="stat-item">
            <span class="stat-value">{remainingCount}</span>
            <span class="stat-label">Remaining</span>
          </div>
          {currentStreak > 0 && (
            <div class="stat-item stat-streak">
              <span class="stat-value">🔥{currentStreak}</span>
              <span class="stat-label">Streak</span>
            </div>
          )}
          {todayXP > 0 && (
            <div class="stat-item stat-xp">
              <span class="stat-value" style="color: var(--accent);">+{todayXP}</span>
              <span class="stat-label">XP Today</span>
            </div>
          )}
        </div>
        <div class="daily-stats-progress-bar">
          <div
            class="daily-stats-progress-fill"
            style={`width: ${todayCompletionPercent}%`}
          ></div>
        </div>
      </div>

      <div class="card today-shell__capture-card">
        <form id="quick-add-form" style="display: flex; gap: 8px; align-items: center;">
          <input
            type="text"
            id="quick-add-input"
            class="form-input flex-1"
            placeholder="Add a task... (try 'shopping: milk, eggs' or 'call dentist tomorrow')"
            autocomplete="off"
            style="font-size: 14px;"
          />
          <button type="submit" class="btn btn-primary" style="padding: 8px 16px; white-space: nowrap;">
            Add
          </button>
        </form>
        <div
          id="quick-add-feedback"
          style="display: none; font-size: 11px; color: var(--text-muted); margin-top: 4px; padding-left: 2px;"
        ></div>
      </div>
    </section>

    <section id="today-focus" class="page-shell__section" data-today-section>
      <div class="page-shell__intro">
        <div>
          <div class="page-shell__eyebrow">Focus</div>
          <h2 class="page-shell__title">See the next best move before the long list</h2>
          <p class="page-shell__description">
            The focus stack and filters work together here so triage feels deliberate
            instead of reactive.
          </p>
        </div>
      </div>

      {focusStackTasks.length > 0 ? (
        <div class="focus-stack" id="section-focus-stack">
          <div class="focus-stack__header">
            <span class="focus-stack__title">🧠 Focus Stack</span>
            <span class="focus-stack__subtitle">
              Your top {focusStackTasks.length} — just do these
            </span>
          </div>
          <div class="focus-stack__cards">
            {focusStackTasks.map((task, i) => (
              <div
                class={`focus-card ${task.is_overdue ? "focus-card--overdue" : ""}`}
                data-id={task.id}
                data-focus-index={i}
              >
                <span class="focus-card__step">{i + 1}</span>
                <div class="focus-card__body">
                  <span class="focus-card__title">{task.title}</span>
                  <div class="focus-card__meta">
                    {task.priority && task.priority <= 2 && (
                      <span class="focus-card__priority" data-pri={task.priority}>
                        {task.priority === 1 ? "▲ Critical" : "↑ High"}
                      </span>
                    )}
                    {task.due_date && (
                      <span
                        class={`focus-card__due ${task.is_overdue ? "focus-card__due--overdue" : ""}`}
                      >
                        {task.is_overdue ? `⚠ Overdue` : `📅 ${task.due_date}`}
                      </span>
                    )}
                  </div>
                </div>
                <button
                  type="button"
                  class="focus-card__complete btn btn-sm"
                  data-id={task.id}
                  title="Complete this task"
                >
                  ✓
                </button>
              </div>
            ))}
          </div>
        </div>
      ) : (
        <div class="today-shell__empty card">
          No urgent focus items are competing for attention right now.
        </div>
      )}

      <div class="today-filter-bar" id="today-filter-bar">
        <input
          type="text"
          id="today-search"
          class="form-input"
          placeholder="Search tasks..."
          autocomplete="off"
        />
        <select id="today-filter-status" class="form-select">
          <option value="">All Status</option>
          <option value="pending">Todo</option>
          <option value="active">Active</option>
          <option value="complete">Done</option>
          <option value="overdue">Overdue</option>
        </select>
        <select id="today-filter-priority" class="form-select">
          <option value="">All Priority</option>
          <option value="1">▲ Critical</option>
          <option value="2">↑ High</option>
          <option value="3">→ Medium</option>
          <option value="4">↓ Low</option>
          <option value="5">· Minimal</option>
        </select>
        <select id="today-filter-rice" class="form-select">
          <option value="">All RICE</option>
          <option value="high">High (≥15)</option>
          <option value="medium">Medium (8-14)</option>
          <option value="low">Low (&lt;8)</option>
        </select>
        <select id="today-sort" class="form-select">
          <option value="priority-asc">Priority ↑</option>
          <option value="priority-desc">Priority ↓</option>
          <option value="rice-desc">RICE ↓</option>
          <option value="rice-asc">RICE ↑</option>
          <option value="due_date-asc">Due Soonest</option>
          <option value="due_date-desc">Due Latest</option>
          <option value="title-asc">Title A-Z</option>
          <option value="title-desc">Title Z-A</option>
        </select>
        <button type="button" id="today-clear-filters" class="btn btn-sm" title="Clear filters">
          ✕
        </button>
      </div>
    </section>

    <section id="today-triage" class="page-shell__section" data-today-section>
      <div class="page-shell__intro">
        <div>
          <div class="page-shell__eyebrow">Triage</div>
          <h2 class="page-shell__title">Reduce carry-over before it crowds out today</h2>
          <p class="page-shell__description">
            Overdue work and suggestions belong together so the page helps you make
            cleanup choices first.
          </p>
        </div>
      </div>

      <div id="migration-prompt" class="today-section" style="display: none;"></div>

      {carriedForwardTasks.length > 0 ? (
        <div class="today-section" id="section-carried">
          <div class="today-section__header">
            <button type="button" class="today-section__toggle" aria-label="Toggle Carried Forward section">
              <span class="today-section__icon">▶</span>
            </button>
            <span class="today-section__title" style="color: var(--warning);">
              🔄 Carried Forward
            </span>
            <span class="today-section__count">{carriedForwardTasks.length}</span>
          </div>
          <div class="today-section__list">
            {carriedForwardTasks.map(task => (
              <TaskListItem task={task} showSnooze showActions section="Carried Forward" />
            ))}
          </div>
        </div>
      ) : (
        <div class="today-shell__empty card">No carried-forward work is waiting on you.</div>
      )}

      {suggestedTasks.length > 0 && (
        <div class="today-section" id="section-suggested">
          <div class="today-section__header">
            <button type="button" class="today-section__toggle" aria-label="Toggle Suggested section">
              <span class="today-section__icon">▶</span>
            </button>
            <span class="today-section__title" style="color: var(--accent);">
              💡 Suggested
            </span>
            <span class="today-section__count">{suggestedTasks.length}</span>
          </div>
          <div class="today-section__list">
            {suggestedTasks.map(task => (
              <TaskListItem task={task} showFocusToday showActions section="Suggested" />
            ))}
          </div>
        </div>
      )}
    </section>

    <section id="today-work" class="page-shell__section" data-today-section>
      <div class="page-shell__intro">
        <div>
          <div class="page-shell__eyebrow">Work</div>
          <h2 class="page-shell__title">Run the actual queue without losing context</h2>
          <p class="page-shell__description">
            Pinned work, today’s commitments, calendar context, and unscheduled tasks
            stay together as the main operating surface.
          </p>
        </div>
      </div>

      <div class="today-section" id="section-calendar-events" style="display: none;">
        <div class="today-section__header">
          <button type="button" class="today-section__toggle" aria-label="Toggle Calendar Events section">
            <span class="today-section__icon">▶</span>
          </button>
          <span class="today-section__title" style="color: var(--info, #60a5fa);">
            📅 Calendar Events
          </span>
          <span class="today-section__count" id="calendar-events-count">0</span>
        </div>
        <div class="today-section__list" id="calendar-events-list">
          <div class="skeleton-line" style="width: 70%;"></div>
          <div class="skeleton-line" style="width: 55%;"></div>
          <div class="skeleton-line" style="width: 65%;"></div>
        </div>
      </div>

      {pinnedTasks.length > 0 && (
        <div class="today-section" id="section-pinned">
          <div class="today-section__header">
            <button type="button" class="today-section__toggle" aria-label="Toggle Pinned section">
              <span class="today-section__icon">▶</span>
            </button>
            <span class="today-section__title">
              ⭐ Pinned / MITs
            </span>
            <span class="today-section__count">{pinnedTasks.length}</span>
          </div>
          <div class="today-section__list">
            {pinnedTasks.map(task => (
              <TaskListItem task={task} showSnooze showActions section="Pinned" />
            ))}
          </div>
        </div>
      )}

      <div class="today-section" id="section-today">
        <div class="today-section__header">
          <button type="button" class="today-section__toggle" aria-label="Toggle Due Today section">
            <span class="today-section__icon">▶</span>
          </button>
          <span class="today-section__title">
            ☀️ Due Today
          </span>
          <span class="today-section__count">{todayTasks.length}</span>
        </div>
        <div class="today-section__list">
          {todayTasks.length === 0 ? (
            <EmptyState
              title="Nothing due today"
              description="You're on top of things! 🎉"
            />
          ) : (
            todayTasks.map(task => (
              <TaskListItem task={task} showSnooze showActions section="Due Today" />
            ))
          )}
        </div>
      </div>

      {noDueTasks.length > 0 && (
        <div class="today-section today-section--collapsed" id="section-unscheduled">
          <div class="today-section__header">
            <button type="button" class="today-section__toggle" aria-label="Toggle Unscheduled section">
              <span class="today-section__icon">▶</span>
            </button>
            <span class="today-section__title">
              📌 Unscheduled
            </span>
            <span class="today-section__count">{noDueTasks.length}</span>
          </div>
          <div class="today-section__list">
            {noDueTasks.map(task => (
              <TaskListItem task={task} showActions section="Unscheduled" />
            ))}
          </div>
        </div>
      )}
    </section>

    <section id="today-habits" class="page-shell__section" data-today-section>
      <div class="page-shell__intro">
        <div>
          <div class="page-shell__eyebrow">Habits</div>
          <h2 class="page-shell__title">Keep routines attached to real work</h2>
          <p class="page-shell__description">
            Habits stay visible here as execution support, not as a separate tracking
            world detached from the rest of Meitheal.
          </p>
        </div>
      </div>

      <div class="today-section" id="section-habits">
        <div class="today-section__header">
          <button type="button" class="today-section__toggle" aria-label="Toggle Habits section">
            <span class="today-section__icon">▶</span>
          </button>
          <span class="today-section__title" style="color: var(--accent);">
            🔄 Habits / Routines
          </span>
          <span class="today-section__count">{habits.length}</span>
        </div>
        <div class="today-section__list">
          {habitsEnabled && habits.length > 0 ? (
            habits.map(habit => (
              <div
                class={`habit-card ${habit.todayCompleted ? "habit-card--done" : ""}`}
                data-habit-id={habit.id}
                data-today-task-id={habit.todayTaskId ?? ""}
              >
                <span class="habit-card__icon">{habit.icon}</span>
                <div class="habit-card__info">
                  <span class="habit-card__name">{habit.name}</span>
                  <span class="habit-card__meta">
                    {habit.currentStreak > 0 && <span class="habit-card__streak">🔥{habit.currentStreak}</span>}
                    <span class="habit-card__total">{habit.totalCompletions} total</span>
                  </span>
                </div>
                <button
                  type="button"
                  class="habit-card__complete btn btn-sm"
                  disabled={habit.todayCompleted}
                >
                  {habit.todayCompleted ? "✅ Done" : "Complete"}
                </button>
              </div>
            ))
          ) : (
            <div class="today-shell__empty card">
              {habitsEnabled
                ? "No active habits are feeding into Today yet."
                : "Habits are currently disabled for this workspace."}
            </div>
          )}
        </div>
      </div>
    </section>

    <section id="today-flow" class="page-shell__section" data-today-section>
      <div class="page-shell__intro">
        <div>
          <div class="page-shell__eyebrow">Flow</div>
          <h2 class="page-shell__title">Shift context when today narrows or broadens</h2>
          <p class="page-shell__description">
            Today is the execution cockpit. When work needs a wider horizon or a different lens, these handoffs keep context intact.
          </p>
        </div>
      </div>

      <div class="page-flow-grid">
        <a class="card page-flow-card" href="/upcoming">
          <strong>📅 Upcoming</strong>
          <p>Move into the next-week view when today's queue dries up.</p>
        </a>
        <a class="card page-flow-card" href="/tasks#calendar">
          <strong>🗓️ Calendar</strong>
          <p>See the full month horizon and plan around events.</p>
        </a>
        <a class="card page-flow-card" href="/planning#eisenhower">
          <strong>⚡ Eisenhower</strong>
          <p>Sort by urgency × importance when the queue feels overwhelming.</p>
        </a>
        <a class="card page-flow-card" href="/tasks#kanban">
          <strong>📊 Kanban</strong>
          <p>Track status across lanes when work moves in stages.</p>
        </a>
      </div>
    </section>
  </div>
</Layout>

<style>
  /* Shared shell/hero/flow CSS is in _page-shell.css */

  .today-shell__capture-card {
    margin-bottom: 0;
    padding: 12px 16px;
  }

  .today-shell__clear-btn {
    min-height: 40px;
    padding: 0 14px;
    border-radius: 10px;
    border: 1px solid color-mix(in srgb, var(--warning) 35%, var(--border));
    background: color-mix(in srgb, var(--warning) 10%, transparent);
    color: var(--text-primary);
  }

  .today-shell__clear-btn:hover {
    background: color-mix(in srgb, var(--warning) 18%, transparent);
    border-color: color-mix(in srgb, var(--warning) 50%, var(--border));
  }

  .today-shell__empty {
    padding: 16px 18px;
    color: var(--text-muted);
  }


  /* ── Filter Bar ──────────────────────────────────────────────── */
  .today-filter-bar {
    display: flex;
    gap: 8px;
    margin-bottom: 16px;
    flex-wrap: nowrap;
    align-items: center;
  }
  .today-filter-bar .form-input {
    flex: 1;
    min-width: 120px;
    font-size: 13px;
    padding: 6px 10px;
    transition: border-color 0.2s, box-shadow 0.2s;
  }
  .today-filter-bar .form-input:focus {
