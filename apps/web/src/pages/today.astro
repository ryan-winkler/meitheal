---
import Layout from "../layouts/Layout.astro";
import EmptyState from "../components/ui/EmptyState.astro";
import LabelBadges from "../components/ui/LabelBadges.astro";
import {
  ensureSchema,
  getPersistenceClient,
} from "@domains/tasks/persistence/store";
import { TaskRepository } from "@domains/tasks/persistence/task-repository";

let overdueTasks: Record<string, unknown>[] = [];
let todayTasks: Record<string, unknown>[] = [];
let noDueTasks: Record<string, unknown>[] = [];
let suggestedTasks: Record<string, unknown>[] = [];
let completedTodayCount = 0;

try {
  await ensureSchema();
  const repo = new TaskRepository(getPersistenceClient());
  const today = new Date().toISOString().split("T")[0] ?? "";

  overdueTasks = await repo.getOverdueTasks(today);
  todayTasks = await repo.getTasksDueOn(today);
  noDueTasks = await repo.getUnscheduledTasks(10);
  suggestedTasks = await repo.getSuggestedTasks(today, 8);
  completedTodayCount = await repo.getCompletedTodayCount(today);
} catch {
  /* DB not available */
}

import {
  PRIORITY_LABELS as priorityLabels,
  PRIORITY_COLORS as priorityColors,
} from "../lib/priority-config";

const typeIcons: Record<string, string> = {
  epic: "🎯",
  story: "📖",
  task: "📌",
};
---

<Layout title="Meitheal — Today">
  <span slot="page-title">☀️ Today</span>
  <div slot="actions">
    <button type="button" class="btn btn-primary" id="create-task-btn"
      >+ New Task</button
    >
  </div>

  <!-- SMT-03: Daily Summary Stats -->
  <div class="daily-stats" id="daily-stats">
    <div class="stat-item">
      <span class="stat-value">{todayTasks.length}</span>
      <span class="stat-label">Due Today</span>
    </div>
    <div class="stat-item">
      <span class="stat-value">{completedTodayCount}</span>
      <span class="stat-label">Completed</span>
    </div>
    <div class="stat-item">
      <span class="stat-value">{overdueTasks.length}</span>
      <span class="stat-label stat-danger">Overdue</span>
    </div>
    <div class="stat-item">
      <span class="stat-value">{todayTasks.length + overdueTasks.length - completedTodayCount}</span>
      <span class="stat-label">Remaining</span>
    </div>
  </div>

  <!-- Persona 10: Quick-add inline -->
  <div class="card" style="margin-bottom: 16px; padding: 12px 16px;">
    <form
      id="quick-add-form"
      style="display: flex; gap: 8px; align-items: center;"
    >
      <input
        type="text"
        id="quick-add-input"
        class="form-input flex-1"
        placeholder="Add a task... (try 'Buy groceries tomorrow' or 'Review docs every monday')"
        autocomplete="off"
        style="font-size: 14px;"
      />
      <button
        type="submit"
        class="btn btn-primary"
        style="padding: 8px 16px; white-space: nowrap;">Add</button
      >
    </form>
    <div
      id="quick-add-feedback"
      style="display: none; font-size: 11px; color: var(--text-muted); margin-top: 4px; padding-left: 2px;"
    >
    </div>
  </div>

  {
    overdueTasks.length > 0 && (
      <div
        class="card"
        style="margin-bottom: 16px; border-left: 3px solid var(--danger);"
      >
        <div class="card-header" style="padding: 12px 16px;">
          <div>
            <div
              class="card-title"
              style="color: var(--danger); font-size: 14px;"
            >
              ⚠️ Overdue ({overdueTasks.length})
            </div>
          </div>
        </div>
        <div class="task-list">
          {overdueTasks.map((task) => {
            const p = Number(task.priority ?? 3);
            const tt = String(task.task_type ?? "task");
            const status = String(task.status ?? "pending");
            return (
              <div
                class="task-item"
                data-id={String(task.id)}
                style="cursor:pointer; padding: 10px 16px; display: flex; align-items: center; gap: 10px; border-bottom: 1px solid var(--border); transition: background 0.15s;"
                role="button"
                tabindex="0"
                aria-label={`${String(task.title)}, priority ${priorityLabels[p] ?? "Medium"}, overdue since ${String(task.due_date)}`}
              >
                <input
                  type="checkbox"
                  class="task-checkbox"
                  data-id={String(task.id)}
                  aria-label={`Complete ${String(task.title)}`}
                />
                <span
                  style={`color: ${priorityColors[p] ?? "#3b82f6"}; font-size: 10px; flex-shrink: 0;`}
                  title={`Priority: ${priorityLabels[p] ?? "Medium"}`}
                >
                  ●
                </span>
                <div style="flex: 1; min-width: 0;">
                  <div style="font-size: 14px; font-weight: 500; white-space: nowrap; overflow: hidden; text-overflow: ellipsis;">
                    <span style="margin-right: 4px; font-size: 12px;">
                      {typeIcons[tt] ?? ""}
                    </span>
                    {String(task.title)}
                  </div>
                  <div style="font-size: 11px; color: var(--danger); margin-top: 2px;">
                    {String(task.due_date)}
                  </div>
                  <LabelBadges labels={task.labels as string} compact max={3} />
                </div>
                <span class={`status-badge status-badge--${status}`}>
                  {status === "active"
                    ? "Active"
                    : status === "backlog"
                      ? "Backlog"
                      : "Pending"}
                </span>
                {task.recurrence_rule && (
                  <span
                    style="font-size: 11px; color: var(--text-muted);"
                    title="Recurring task"
                  >
                    🔁
                  </span>
                )}
                {(() => {
                  try {
                    const cl = task.checklists ? (typeof task.checklists === "string" ? JSON.parse(String(task.checklists)) : task.checklists) : [];
                    if (Array.isArray(cl) && cl.length > 0) {
                      const done = cl.filter((i: {done: boolean}) => i.done).length;
                      return (
                        <span
                          style={`font-size: 11px; color: ${done === cl.length ? 'var(--color-green-500, #22c55e)' : 'var(--text-muted)'};`}
                          title={`Checklist: ${done}/${cl.length}`}
                        >
                          ✓ {done}/{cl.length}
                        </span>
                      );
                    }
                  } catch { /* skip */ }
                  return null;
                })()}
                {task.assigned_to && (
                  <span
                    class="avatar avatar--sm"
                    title={`Assigned to ${String(task.assigned_to)}`}
                    aria-label={`Assigned to ${String(task.assigned_to)}`}
                  >
                    {String(task.assigned_to)
                      .replace(/^(ha_|custom_)/, "")
                      .slice(0, 2)
                      .toUpperCase()}
                  </span>
                )}
              </div>
            );
          })}
        </div>
      </div>
    )
  }

  <div class="card" style="margin-bottom: 16px;">
    <div class="card-header" style="padding: 12px 16px;">
      <div>
        <div class="card-title" style="font-size: 14px;">
          {
            todayTasks.length > 0
              ? `☀️ Due Today (${todayTasks.length})`
              : "☀️ Today"
          }
        </div>
        {
          todayTasks.length > 0 && (
            <div class="card-subtitle" style="font-size: 12px;">
              Focus on these tasks
            </div>
          )
        }
      </div>
    </div>
    <div class="task-list" id="today-tasks">
      {
        todayTasks.length === 0 ? (
          <EmptyState
            title="No tasks due today"
            description="You're on top of things! 🎉"
          />
        ) : (
          todayTasks.map((task) => {
            const p = Number(task.priority ?? 3);
            const tt = String(task.task_type ?? "task");
            const progress = Number(task.progress ?? 0);
            const status = String(task.status ?? "pending");
            return (
              <div
                class="task-item"
                data-id={String(task.id)}
                style="cursor:pointer; padding: 10px 16px; display: flex; align-items: center; gap: 10px; border-bottom: 1px solid var(--border); transition: background 0.15s;"
                role="button"
                tabindex="0"
                aria-label={`${String(task.title)}, priority ${priorityLabels[p] ?? "Medium"}`}
              >
                <input
                  type="checkbox"
                  class="task-checkbox"
                  data-id={String(task.id)}
                  aria-label={`Complete ${String(task.title)}`}
                />
                <span
                  style={`color: ${priorityColors[p] ?? "#3b82f6"}; font-size: 10px; flex-shrink: 0;`}
                  title={`Priority: ${priorityLabels[p] ?? "Medium"}`}
                >
                  ●
                </span>
                <div style="flex: 1; min-width: 0;">
                  <div style="font-size: 14px; font-weight: 500; white-space: nowrap; overflow: hidden; text-overflow: ellipsis;">
                    <span style="margin-right: 4px; font-size: 12px;">
                      {typeIcons[tt] ?? ""}
                    </span>
                    {String(task.title)}
                  </div>
                  <LabelBadges labels={task.labels as string} compact max={3} />
                  {progress > 0 && (
                    <div style="margin-top: 4px; display: flex; align-items: center; gap: 6px;">
                      <div style="flex: 1; height: 3px; background: var(--border); border-radius: 2px; overflow: hidden;">
                        <div
                          style={`width: ${progress}%; height: 100%; background: var(--accent); border-radius: 2px; transition: width 0.3s;`}
                        />
                      </div>
                      <span style="font-size: 10px; color: var(--text-muted);">
                        {progress}%
                      </span>
                    </div>
                  )}
                  <LabelBadges labels={String(task.labels ?? "[]")} compact max={2} />
                </div>
                {task.color && (
                  <span
                    style={`width: 4px; height: 24px; border-radius: 2px; background: ${String(task.color)}; flex-shrink: 0;`}
                  />
                )}
                <span class={`status-badge status-badge--${status}`}>
                  {status === "active"
                    ? "Active"
                    : status === "backlog"
                      ? "Backlog"
                      : "Pending"}
                </span>
                {task.recurrence_rule && (
                  <span
                    style="font-size: 11px; color: var(--text-muted);"
                    title="Recurring task"
                  >
                    🔁
                  </span>
                )}
                {(() => {
                  try {
                    const cl = task.checklists ? (typeof task.checklists === "string" ? JSON.parse(String(task.checklists)) : task.checklists) : [];
                    if (Array.isArray(cl) && cl.length > 0) {
                      const done = cl.filter((i: {done: boolean}) => i.done).length;
                      return (
                        <span
                          style={`font-size: 11px; color: ${done === cl.length ? 'var(--color-green-500, #22c55e)' : 'var(--text-muted)'};`}
                          title={`Checklist: ${done}/${cl.length}`}
                        >
                          ✓ {done}/{cl.length}
                        </span>
                      );
                    }
                  } catch { /* skip */ }
                  return null;
                })()}
                {task.assigned_to && (
                  <span
                    class="assignee-badge"
                    title={`Assigned to ${String(task.assigned_to)}`}
                    aria-label={`Assigned to ${String(task.assigned_to)}`}
                  >
                    {String(task.assigned_to)
                      .replace(/^(ha_|custom_)/, "")
                      .slice(0, 2)
                      .toUpperCase()}
                  </span>
                )}
              </div>
            );
          })
        )
      }
    </div>
  </div>

  {
    noDueTasks.length > 0 && (
      <div class="card">
        <div class="card-header" style="padding: 12px 16px;">
          <div>
            <div class="card-title" style="font-size: 14px;">
              📌 Unscheduled ({noDueTasks.length})
            </div>
            <div class="card-subtitle" style="font-size: 12px;">
              Consider scheduling these
            </div>
          </div>
        </div>
        <div class="task-list">
          {noDueTasks.map((task) => {
            const p = Number(task.priority ?? 3);
            const tt = String(task.task_type ?? "task");
            const status = String(task.status ?? "pending");
            return (
              <div
                class="task-item"
                data-id={String(task.id)}
                style="cursor:pointer; padding: 10px 16px; display: flex; align-items: center; gap: 10px; border-bottom: 1px solid var(--border); transition: background 0.15s;"
                role="button"
                tabindex="0"
                aria-label={`${String(task.title)}, priority ${priorityLabels[p] ?? "Medium"}, no due date`}
              >
                <input
                  type="checkbox"
                  class="task-checkbox"
                  data-id={String(task.id)}
                  aria-label={`Complete ${String(task.title)}`}
                />
                <span
                  style={`color: ${priorityColors[p] ?? "#3b82f6"}; font-size: 10px; flex-shrink: 0;`}
                  title={`Priority: ${priorityLabels[p] ?? "Medium"}`}
                >
                  ●
                </span>
                <div style="flex: 1; min-width: 0;">
                  <div style="font-size: 14px; font-weight: 500; white-space: nowrap; overflow: hidden; text-overflow: ellipsis;">
                    <span style="margin-right: 4px; font-size: 12px;">
                      {typeIcons[tt] ?? ""}
                    </span>
                    {String(task.title)}
                  </div>
                  <LabelBadges labels={task.labels as string} compact max={3} />
                </div>
                <span class={`status-badge status-badge--${status}`}>
                  {status === "active"
                    ? "Active"
                    : status === "backlog"
                      ? "Backlog"
                      : "Pending"}
                </span>
                {task.assigned_to && (
                  <span
                    class="assignee-badge"
                    title={`Assigned to ${String(task.assigned_to)}`}
                    aria-label={`Assigned to ${String(task.assigned_to)}`}
                  >
                    {String(task.assigned_to)
                      .replace(/^(ha_|custom_)/, "")
                      .slice(0, 2)
                      .toUpperCase()}
                  </span>
                )}
              </div>
            );
          })}
        </div>
      </div>
    )
  }

  {/* SMT-01: Suggested Tasks — high-priority due within 3 days */}
  {
    suggestedTasks.length > 0 && (
      <div
        class="card"
        style="margin-bottom: 16px; border-left: 3px solid var(--accent);"
      >
        <div class="card-header" style="padding: 12px 16px;">
          <div>
            <div class="card-title" style="font-size: 14px; color: var(--accent);">
              💡 Suggested ({suggestedTasks.length})
            </div>
            <div class="card-subtitle" style="font-size: 12px;">
              High-priority tasks due soon or unscheduled
            </div>
          </div>
        </div>
        <div class="task-list">
          {suggestedTasks.map((task) => {
            const p = Number(task.priority ?? 3);
            const tt = String(task.task_type ?? "task");
            const status = String(task.status ?? "pending");
            const dueDate = task.due_date ? String(task.due_date) : null;
            return (
              <div
                class="task-item"
                data-id={String(task.id)}
                style="cursor:pointer; padding: 10px 16px; display: flex; align-items: center; gap: 10px; border-bottom: 1px solid var(--border); transition: background 0.15s;"
                role="button"
                tabindex="0"
                aria-label={`${String(task.title)}, priority ${priorityLabels[p] ?? "Medium"}${dueDate ? `, due ${dueDate}` : ', no due date'}`}
              >
                <input
                  type="checkbox"
                  class="task-checkbox"
                  data-id={String(task.id)}
                  aria-label={`Complete ${String(task.title)}`}
                />
                <span
                  style={`color: ${priorityColors[p] ?? "#3b82f6"}; font-size: 10px; flex-shrink: 0;`}
                  title={`Priority: ${priorityLabels[p] ?? "Medium"}`}
                >
                  ●
                </span>
                <div style="flex: 1; min-width: 0;">
                  <div style="font-size: 14px; font-weight: 500; white-space: nowrap; overflow: hidden; text-overflow: ellipsis;">
                    <span style="margin-right: 4px; font-size: 12px;">
                      {typeIcons[tt] ?? ""}
                    </span>
                    {String(task.title)}
                  </div>
                  <div style="font-size: 11px; color: var(--text-muted); margin-top: 2px;">
                    {dueDate ? `Due: ${dueDate}` : "No due date"}
                  </div>
                  <LabelBadges labels={task.labels as string} compact max={3} />
                </div>
                {/* SMT-02: Focus Today button */}
                <button
                  class="btn btn-sm focus-today-btn"
                  data-id={String(task.id)}
                  title="Set due date to today"
                  aria-label={`Focus today: ${String(task.title)}`}
                >
                  ➕ Today
                </button>
                <span class={`status-badge status-badge--${status}`}>
                  {status === "active"
                    ? "Active"
                    : status === "backlog"
                      ? "Backlog"
                      : "Pending"}
                </span>
                {task.assigned_to && (
                  <span
                    class="assignee-badge"
                    title={`Assigned to ${String(task.assigned_to)}`}
                  >
                    {String(task.assigned_to)
                      .replace(/^(ha_|custom_)/, "")
                      .slice(0, 2)
                      .toUpperCase()}
                  </span>
                )}
              </div>
            );
          })}
        </div>
      </div>
    )
  }
</Layout>

<style>
  .task-item:hover {
    background: var(--bg-hover);
  }
  .task-item:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: -2px;
  }
  .task-done .task-item {
    opacity: 0.5;
  }
  .status-badge {
    display: inline-block;
    font-size: 10px;
    font-weight: 600;
    padding: 2px 8px;
    border-radius: 8px;
    text-transform: uppercase;
    letter-spacing: 0.3px;
    white-space: nowrap;
    flex-shrink: 0;
  }
  .status-badge--pending {
    background: rgba(59, 130, 246, 0.12);
    color: #3b82f6;
  }
  .status-badge--active {
    background: rgba(34, 197, 94, 0.12);
    color: #22c55e;
  }
  .status-badge--backlog {
    background: rgba(148, 163, 184, 0.12);
    color: #94a3b8;
  }

  /* SMT-03: Daily Summary Stats */
  .daily-stats {
    display: flex;
    gap: 2px;
    margin-bottom: 16px;
    background: var(--bg-card);
    border: 1px solid var(--border);
    border-radius: var(--radius-md, 8px);
    overflow: hidden;
  }
  .stat-item {
    flex: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    padding: 12px 8px;
    gap: 2px;
  }
  .stat-item:not(:last-child) {
    border-right: 1px solid var(--border);
  }
  .stat-value {
    font-size: 20px;
    font-weight: 700;
    color: var(--text);
    line-height: 1;
  }
  .stat-label {
    font-size: 11px;
    color: var(--text-muted);
    text-transform: uppercase;
    letter-spacing: 0.5px;
  }
  .stat-danger {
    color: var(--danger);
  }

  /* SMT-02: Focus Today button */
  .focus-today-btn {
    font-size: 11px;
    padding: 3px 8px;
    border-radius: var(--radius-sm, 4px);
    background: rgba(59, 130, 246, 0.1);
    color: var(--accent);
    border: 1px solid rgba(59, 130, 246, 0.2);
    cursor: pointer;
    white-space: nowrap;
    flex-shrink: 0;
    transition: background 0.15s, border-color 0.15s;
  }
  .focus-today-btn:hover {
    background: rgba(59, 130, 246, 0.2);
    border-color: var(--accent);
  }
</style>

<script>
  import { taskApi } from "../lib/task-api-client";
  import { onTaskCompleted } from "../lib/gamification-hook";

  // Task checkbox completion
  document
    .querySelectorAll<HTMLInputElement>(".task-checkbox")
    .forEach((cb) => {
      cb.addEventListener("change", async () => {
        const id = cb.dataset.id;
        if (!id) return;
        try {
          await taskApi.updateTask(id, {
            status: cb.checked ? "complete" : "pending",
          });
          const item = cb.closest(".task-item") as HTMLElement | null;
          if (cb.checked && item) {
            item.style.opacity = "0.4";
            item.style.transition = "opacity 0.3s";
            setTimeout(() => item.remove(), 800);
            onTaskCompleted();
          }
        } catch {
          /* retry silently */
        }
      });
    });

  // Click to open task detail
  document.querySelectorAll<HTMLElement>(".task-item").forEach((item) => {
    item.addEventListener("click", (e) => {
      if ((e.target as HTMLElement).tagName === "INPUT") return;
      const id = item.dataset.id;
      if (id)
        window.location.href =
          (window.__ingress_path || "") + `/tasks#task-${id}`;
    });
    // Keyboard: Enter/Space to activate
    item.addEventListener("keydown", (e) => {
      if (e.key === "Enter" || e.key === " ") {
        e.preventDefault();
        const id = (e.target as HTMLElement).dataset?.id;
        if (id)
          window.location.href =
            (window.__ingress_path || "") + `/tasks#task-${id}`;
      }
    });
  });

  // Quick-add with NL date parsing
  const quickForm = document.getElementById(
    "quick-add-form",
  ) as HTMLFormElement;
  const quickInput = document.getElementById(
    "quick-add-input",
  ) as HTMLInputElement;
  const quickFeedback = document.getElementById(
    "quick-add-feedback",
  ) as HTMLElement;

  quickForm?.addEventListener("submit", async (e) => {
    e.preventDefault();
    const text = quickInput?.value.trim();
    if (!text) return;

    try {
      const result = await taskApi.createTask({ title: text });
      if (result) {
        if (quickInput) quickInput.value = "";
        if (quickFeedback) quickFeedback.style.display = "none";
        window.location.reload();
      }
    } catch {
      /* silently retry */
    }
  });

  // Live NL date feedback as user types
  let feedbackTimer: ReturnType<typeof setTimeout> | null = null;
  quickInput?.addEventListener("input", () => {
    if (feedbackTimer) clearTimeout(feedbackTimer);
    const val = quickInput.value.trim().toLowerCase();
    const nlPatterns = [
      { pattern: /\btomorrow\b/i, label: "📅 Due: Tomorrow" },
      { pattern: /\btoday\b/i, label: "📅 Due: Today" },
      { pattern: /\bnext\s+\w+/i, label: "📅 Due: Next week" },
      { pattern: /\bin\s+\d+\s+\w+/i, label: "📅 Due: Relative date" },
      { pattern: /\bevery\s+\w+/i, label: "🔁 Recurring task" },
    ];
    const match = nlPatterns.find((p) => p.pattern.test(val));
    if (match) {
      quickFeedback.textContent = match.label;
      quickFeedback.style.display = "block";
    } else {
      quickFeedback.style.display = "none";
    }
  });

  // SMT-02: Focus Today — set due_date to today and reload
  document.querySelectorAll<HTMLButtonElement>(".focus-today-btn").forEach((btn) => {
    btn.addEventListener("click", async (e) => {
      e.stopPropagation();
      const id = btn.dataset.id;
      if (!id) return;
      btn.disabled = true;
      btn.textContent = "...";
      try {
        const todayStr = new Date().toISOString().split("T")[0]!;
        await taskApi.updateTask(id, { due_date: todayStr });
        window.location.reload();
      } catch {
        btn.disabled = false;
        btn.textContent = "➕ Today";
      }
    });
  });
</script>
