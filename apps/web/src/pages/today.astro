---
/**
 * Today Page — Smart Daily Cockpit
 *
 * @domain tasks
 * @bounded-context tasks (presentation)
 *
 * Single-pane-of-glass daily view with sections:
 * 1. Daily Stats
 * 2. Quick Add (NL-aware + defaults due_date = today)
 * 3. Filter Bar (search, status, priority, RICE, sort)
 * 4. Carried Forward (overdue tasks with triage / snooze)
 * 5. Shared favorites
 * 6. Due Today (hard landscape)
 * 7. Unscheduled (no due date)
 * 8. Suggested (smart picks)
 *
 * @kcs This page uses the shared TaskListItem component for all task rendering.
 * The inline script is replaced by today-controller.ts module.
 */
import Layout from "../layouts/Layout.astro"
import UnifiedBar from "../components/layout/UnifiedBar.astro"
import EmptyState from "../components/ui/EmptyState.astro"
import InlineHelper from "../components/ui/InlineHelper.astro"
import TaskListItem from "../components/tasks/TaskListItem.astro"
import { buildTaskPath } from "../lib/task-detail-handoff"
import { getPersistenceClient } from "@domains/tasks/persistence/store"
import { TemplateRepository } from "@domains/tasks/persistence/template-repository"
import type { HabitWithStats } from "@domains/tasks/persistence/template-repository"
import { getTodayTaskRows, todayCompletionPercent, todayDueSection, type TaskViewItem } from "../lib/task-queries"
import { calendarDayFromInput, calendarToday, formatRelativeDue, shiftCalendarDay } from "../lib/date"
import { isFeatureEnabled } from "../lib/feature-flags"
import { TODAY_SECTIONS } from "../lib/today-registry"
import { getUnscheduledPage, requestedUnscheduledPage, setUnscheduledPage } from "../lib/today-list"

let carriedForwardTasks: TaskViewItem[] = []
let pinnedTasks: TaskViewItem[] = []
let todayTasks: TaskViewItem[] = []
let noDueTasks: TaskViewItem[] = []
let suggestedTasks: TaskViewItem[] = []
let focusStackTasks: TaskViewItem[] = []
let completedTodayCount = 0
let unscheduledCount = 0
let totalOpenCount = 0
let currentStreak = 0
let todayXP = 0
let habits: HabitWithStats[] = []
let habitsEnabled = false
const todayTimeZone = Astro.locals.timezone || "Europe/Dublin"

try {
  const todayStr = calendarToday(todayTimeZone)
  const includeUnscheduled = requestedUnscheduledPage(Astro.url.searchParams) !== null
  const { tasks, completedTodayCount: completed, openUnscheduledCount } = await getTodayTaskRows(todayStr, includeUnscheduled, todayTimeZone)
  completedTodayCount = completed

  // Partition tasks into sections
  for (const task of tasks) {
    // Shared favorites
    if (task.is_favorite) {
      pinnedTasks.push(task)
    }

    if (task.due_date) {
      const section = todayDueSection(task.due_date, todayStr, todayTimeZone)

      if (section === "carried") {
        // Carried forward (overdue)
        carriedForwardTasks.push(task)
      } else if (section === "due") {
        // Due today
        todayTasks.push(task)
      }
      // Future dates go to suggested if high priority
    } else if (includeUnscheduled) {
      // No due date → unscheduled
      noDueTasks.push(task)
    }
  }

  // Suggested: high-priority tasks due within 3 days + top-RICE unscheduled
  const threeDaysStr = shiftCalendarDay(todayStr, 3)

  suggestedTasks = tasks.filter(t => {
    if (t.is_done) return false
    const dueDay = t.due_date ? calendarDayFromInput(t.due_date, todayTimeZone) : null
    // Already in today or carried forward
    if (dueDay === todayStr) return false
    if (t.is_overdue) return false
    // High priority due within 3 days
    if (dueDay && dueDay <= threeDaysStr && t.priority <= 2) return true
    // Top RICE unscheduled (not already in unscheduled section to avoid double)
    if (!t.due_date && t.rice !== null && t.rice >= 15) return true
    return false
  }).slice(0, 8)

  // Remove suggested from noDueTasks to avoid double-showing
  const suggestedIds = new Set(suggestedTasks.filter(task => !task.due_date).map(task => task.id))
  noDueTasks = noDueTasks.filter(t => !suggestedIds.has(t.id))

  // Focus Stack — top 3 actionable tasks ranked by urgency for ADHD decision support
  // Ranking: overdue first → highest priority → nearest due date
  const focusCandidates = tasks
    .filter(t => {
      if (t.is_done || !t.due_date) return false
      const dueDay = calendarDayFromInput(t.due_date, todayTimeZone)
      return dueDay !== null && dueDay <= todayStr
    })
    .sort((a, b) => {
      const aDay = a.due_date ? calendarDayFromInput(a.due_date, todayTimeZone) : null
      const bDay = b.due_date ? calendarDayFromInput(b.due_date, todayTimeZone) : null
      const aOverdue = aDay && aDay < todayStr ? 1 : 0
      const bOverdue = bDay && bDay < todayStr ? 1 : 0
      if (aOverdue !== bOverdue) return bOverdue - aOverdue
      const aPri = Number(a.priority ?? 3)
      const bPri = Number(b.priority ?? 3)
      if (aPri !== bPri) return aPri - bPri
      if (a.due_date && b.due_date) return a.due_date.localeCompare(b.due_date)
      return 0
    })
  focusStackTasks = focusCandidates.slice(0, 3)

  const unscheduledAfterSuggestions = openUnscheduledCount - suggestedIds.size
  totalOpenCount = carriedForwardTasks.length + todayTasks.length + unscheduledAfterSuggestions
  unscheduledCount = unscheduledAfterSuggestions - pinnedTasks.filter(task => !task.due_date && !suggestedIds.has(task.id)).length

  // G36: Fetch gamification stats for streak/XP display
  try {
    const { getStats, getWeeklyData } = await import("@domains/gamification")
    const stats = await getStats()
    currentStreak = stats.currentStreak ?? 0
    // Get today's points from weekly data
    const weekly = await getWeeklyData()
    const todayRecord = weekly[weekly.length - 1]
    todayXP = todayRecord?.points ?? 0
  } catch { /* gamification may not be initialized */ }

  // G38: Fetch habits for Today section
  try {
    habitsEnabled = await isFeatureEnabled("habits")
    if (habitsEnabled) {
      const repo = new TemplateRepository(getPersistenceClient())
      habits = await repo.getHabitsWithStats()
    }
  } catch { /* habits may not be available */ }
} catch {
  /* DB not available */
}

// Remove pinned duplicates from other sections (keep in Pinned section)
const pinnedIds = new Set(pinnedTasks.map(t => t.id))
carriedForwardTasks = carriedForwardTasks.filter(t => !pinnedIds.has(t.id))
todayTasks = todayTasks.filter(t => !pinnedIds.has(t.id))
noDueTasks = noDueTasks.filter(t => !pinnedIds.has(t.id))

const unscheduled = getUnscheduledPage(noDueTasks, Astro.url.searchParams)
if (unscheduled) Astro.response.headers.set("Cache-Control", "private, no-store")
function unscheduledLink(page: number): string {
  const url = setUnscheduledPage(new URL(Astro.url), page)
  return `${url.pathname}${url.search}#today-work`
}

const remainingCount = carriedForwardTasks.length + todayTasks.length + pinnedTasks.length
const todayHeroSignal = `${todayTasks.length} due today · ${carriedForwardTasks.length} carried forward`
const todayDate = new Date()
const locale = Astro.cookies.get("meitheal-locale")?.value === "ga" ? "ga-IE" : "en-IE"
const todayDateLabel = new Intl.DateTimeFormat(locale, {
  weekday: "long", day: "numeric", month: "long",
  timeZone: todayTimeZone,
}).format(todayDate)
const todayIsoDate = calendarToday(todayTimeZone, todayDate)
const completionPercent = todayCompletionPercent(completedTodayCount, remainingCount)
---

<Layout title="Meitheal — Today">
  <UnifiedBar
    title="Today"
    titleIcon="☀️"
    tabs={TODAY_SECTIONS.map((section) => ({
      id: section.id,
      label: section.label,
      icon: section.icon,
    }))}
    searchPlaceholder="Search Meitheal…"
    searchScope="all"
    barId="today-bar"
    slot="custom-header"
  >
    <button
      slot="actions"
      type="button"
      class="unified-bar__new-task-btn today-shell__clear-btn"
      id="clear-completed-btn"
      title="Clear completed tasks"
      aria-label="Clear Done"
    >
      <span class="unified-bar__new-task-label">Clear Done</span>
    </button>
  </UnifiedBar>

  <div id="page-shell" class="page-shell">
    <section
      id="today-overview"
      class="page-shell__section page-shell__section--overview"
      data-today-section
    >
      <header class="today-summary">
        <div>
          <h1>Today</h1>
          <p class="today-summary__date"><time datetime={todayIsoDate}>{todayDateLabel}</time></p>
        </div>
        <p class="today-summary__signal" id="today-signal-summary">{todayHeroSignal}</p>
      </header>

      <div class="daily-stats-container" id="daily-stats-container">
        <div class="daily-stats" id="daily-stats">
          <a href="#today-work" class="stat-item" data-today-section-link>
            <span class="stat-value" data-today-count="dueToday">{todayTasks.length}</span>
            <span class="stat-label">Due Today</span>
          </a>
          <div class="stat-item">
            <span class="stat-value" data-today-count="completedToday">{completedTodayCount}</span>
            <span class="stat-label">Completed</span>
          </div>
          <a href="#today-triage" class="stat-item" data-today-section-link>
            <span class="stat-value" data-today-count="carriedForward">{carriedForwardTasks.length}</span>
            <span class="stat-label stat-danger">Carried Fwd</span>
          </a>
          <div class="stat-item">
            <span class="stat-value" data-today-count="remaining">{remainingCount}</span>
            <span class="stat-label">Remaining</span>
          </div>
          {currentStreak > 0 && (
            <div class="stat-item stat-streak">
              <span class="stat-value">🔥{currentStreak}</span>
              <span class="stat-label">Streak</span>
            </div>
          )}
          {todayXP > 0 && (
            <div class="stat-item stat-xp">
              <span class="stat-value" style="color: var(--accent);">+{todayXP}</span>
              <span class="stat-label">XP Today</span>
            </div>
          )}
        </div>
        <div class="daily-stats-progress-bar" role="progressbar" aria-label="Today's tasks completed" aria-valuenow={completionPercent} aria-valuemin="0" aria-valuemax="100">
          <div
            class="daily-stats-progress-fill"
            style={`width: ${completionPercent}%`}
          ></div>
        </div>
      </div>

      <div class="card today-shell__capture-card">
        <form id="quick-add-form" class="quick-add-form">
          <label class="sr-only" for="quick-add-input">Add a task for today</label>
          <input
            type="text"
            id="quick-add-input"
            class="form-input flex-1 quick-add-input"
            placeholder="Add a task for today…"
            autocomplete="off"
          />
          <button type="submit" class="btn btn-primary quick-add-submit">
            Add
          </button>
        </form>
        <p class="quick-add-hint">Dates and lists work here too. Try “call dentist tomorrow” or “shopping: milk, eggs”.</p>
        <div
          id="quick-add-feedback"
          style="display: none; font-size: 11px; color: var(--text-muted); margin-top: 4px; padding-left: 2px;"
        ></div>
      </div>
    </section>

    <section id="today-focus" class="page-shell__section" data-today-section>
      <div class="page-shell__intro">
        <div>
          <div class="page-shell__eyebrow">Focus</div>
          <h2 class="page-shell__title">Priority tasks</h2>
        </div>
      </div>

      {focusStackTasks.length > 0 ? (
        <div class="focus-stack" id="section-focus-stack">
          <div class="focus-stack__header">
            <span class="focus-stack__title">Next tasks</span>
            <span class="focus-stack__subtitle">
              {focusStackTasks.length} to focus on
            </span>
          </div>
          <div class="focus-stack__cards">
            {focusStackTasks.map((task, i) => (
              <div
                class={`focus-card ${task.is_overdue ? "focus-card--overdue" : ""}`}
                data-id={task.id}
                data-focus-index={i}
              >
                <span class="focus-card__step">{i + 1}</span>
                <a class="focus-card__body" href={buildTaskPath(task.id)} data-task-detail-link={task.id}>
                  <span class="focus-card__title">{task.title}</span>
                  <div class="focus-card__meta">
                    {task.priority && task.priority <= 2 && (
                      <span class="focus-card__priority" data-pri={task.priority}>
                        {task.priority === 1 ? "▲ Critical" : "↑ High"}
                      </span>
                    )}
                    {task.due_date && (
                      <span
                        class={`focus-card__due ${task.is_overdue ? "focus-card__due--overdue" : ""}`}
                      >
                        {task.is_overdue ? "⚠ Overdue" : `📅 ${formatRelativeDue(task.due_date, todayTimeZone)}`}
                      </span>
                    )}
                  </div>
                </a>
                <button
                  type="button"
                  class="focus-card__complete btn btn-sm"
                  data-id={task.id}
                  title="Complete this task"
                  aria-label={`Complete ${task.title}`}
                >
                  ✓
                </button>
              </div>
            ))}
          </div>
        </div>
      ) : (
        <div class="today-shell__empty card">
          No urgent focus items are competing for attention right now.
        </div>
      )}

      <div class="today-filter-bar" id="today-filter-bar">
        <input
          type="text"
          id="today-search"
          class="form-input"
          placeholder="Search tasks..."
          autocomplete="off"
        />
        <select id="today-filter-status" class="form-select" aria-label="Filter by status">
          <option value="">All Status</option>
          <option value="pending">Todo</option>
          <option value="active">Active</option>
          <option value="complete">Done</option>
          <option value="overdue">Overdue</option>
        </select>
        <select id="today-filter-priority" class="form-select" aria-label="Filter by priority">
          <option value="">All Priority</option>
          <option value="1">▲ Critical</option>
          <option value="2">↑ High</option>
          <option value="3">→ Medium</option>
          <option value="4">↓ Low</option>
          <option value="5">· Minimal</option>
        </select>
        <select id="today-filter-rice" class="form-select" aria-label="Filter by RICE score">
          <option value="">All RICE</option>
          <option value="high">High (≥15)</option>
          <option value="medium">Medium (8-14)</option>
          <option value="low">Low (&lt;8)</option>
        </select>
        <select id="today-sort" class="form-select" aria-label="Sort tasks">
          <option value="priority-asc">Priority ↑</option>
          <option value="priority-desc">Priority ↓</option>
          <option value="rice-desc">RICE ↓</option>
          <option value="rice-asc">RICE ↑</option>
          <option value="due_date-asc">Due Soonest</option>
          <option value="due_date-desc">Due Latest</option>
          <option value="title-asc">Title A-Z</option>
          <option value="title-desc">Title Z-A</option>
        </select>
        <button type="button" id="today-clear-filters" class="btn btn-sm" title="Clear filters">
          ✕
        </button>
        <button type="button" id="batch-mode-toggle" class="btn btn-sm" title="Toggle multi-select mode" aria-pressed="false" hidden>☑</button>
      </div>
    </section>

    <section id="today-triage" class="page-shell__section" data-today-section>
      <div class="page-shell__intro">
        <div>
          <div class="page-shell__eyebrow">Triage</div>
          <h2 class="page-shell__title">Overdue and suggested tasks</h2>
        </div>
      </div>

      <div id="migration-prompt" class="today-section" style="display: none;"></div>

      {carriedForwardTasks.length > 0 ? (
        <div class="today-section" id="section-carried">
          <button type="button" class="today-section__header today-section__toggle"
            aria-controls="today-carried-list" aria-expanded="true">
            <span class="today-section__icon" aria-hidden="true">▶</span>
            <span class="today-section__title" style="color: var(--warning-text, var(--warning));">
              <span aria-hidden="true">🔄</span> Carried Forward
            </span>
            <span class="today-section__count" id="today-carried-list-count">{carriedForwardTasks.length}</span>
          </button>
          <div class="today-section__list" id="today-carried-list">
            {carriedForwardTasks.map(task => (
              <TaskListItem task={task} showSnooze showActions section="Carried Forward" />
            ))}
          </div>
        </div>
      ) : (
        <div class="today-shell__empty card">No carried-forward work is waiting on you.</div>
      )}

      {suggestedTasks.length > 0 && (
        <div class="today-section" id="section-suggested">
          <button type="button" class="today-section__header today-section__toggle"
            aria-controls="today-suggested-list" aria-expanded="true">
            <span class="today-section__icon" aria-hidden="true">▶</span>
            <span class="today-section__title" style="color: var(--accent-text);">
              <span aria-hidden="true">💡</span> Suggested
            </span>
            <span class="today-section__count" id="today-suggested-list-count">{suggestedTasks.length}</span>
          </button>
          <div class="today-section__list" id="today-suggested-list">
            {suggestedTasks.map(task => (
              <TaskListItem task={task} showFocusToday showActions section="Suggested" />
            ))}
          </div>
        </div>
      )}
    </section>

    <section id="today-work" class="page-shell__section" data-today-section>
      <div class="page-shell__intro">
        <div>
          <div class="page-shell__eyebrow">Work</div>
          <h2 class="page-shell__title">Your task list</h2>
          <p class="page-shell__description">
            Open Unscheduled to find tasks without a due date, including ones added by Home Assistant automations.
          </p>
        </div>
      </div>

      <div class="today-section" id="section-calendar-events" style="display: none;">
        <button type="button" class="today-section__header today-section__toggle"
          aria-controls="calendar-events-list" aria-expanded="true">
          <span class="today-section__icon" aria-hidden="true">▶</span>
          <span class="today-section__title" style="color: var(--info, #60a5fa);">
            <span aria-hidden="true">📅</span> Calendar Events
          </span>
          <span class="today-section__count" id="calendar-events-count">0</span>
        </button>
        <div class="today-section__list" id="calendar-events-list">
          <div class="skeleton-line" style="width: 70%;"></div>
          <div class="skeleton-line" style="width: 55%;"></div>
          <div class="skeleton-line" style="width: 65%;"></div>
        </div>
      </div>

      {pinnedTasks.length > 0 && (
        <div class="today-section" id="section-pinned">
          <button type="button" class="today-section__header today-section__toggle"
            aria-controls="today-pinned-list" aria-expanded="true">
            <span class="today-section__icon" aria-hidden="true">▶</span>
            <span class="today-section__title">
              <span aria-hidden="true">⭐</span> Shared favorites
            </span>
            <span class="today-section__count" id="today-pinned-list-count">{pinnedTasks.length}</span>
          </button>
          <div class="today-section__list" id="today-pinned-list">
            {pinnedTasks.map(task => (
              <TaskListItem task={task} showSnooze showActions section="Shared favorites" />
            ))}
          </div>
        </div>
      )}

      <div class="today-section" id="section-today">
        <button type="button" class="today-section__header today-section__toggle"
          aria-controls="today-due-list" aria-expanded="true">
          <span class="today-section__icon" aria-hidden="true">▶</span>
          <span class="today-section__title">
            <span aria-hidden="true">☀️</span> Due Today
          </span>
          <span class="today-section__count" id="today-due-list-count">{todayTasks.length}</span>
        </button>
        <div class="today-section__list" id="today-due-list">
          {todayTasks.length === 0 ? (
            <EmptyState
              title="Nothing due today"
              description="You're on top of things! 🎉"
            />
          ) : (
            todayTasks.map(task => (
              <TaskListItem task={task} showSnooze showActions section="Due Today" />
            ))
          )}
        </div>
      </div>

      {(unscheduledCount > 0 || unscheduled) && (
        <div class:list={["today-section", { "today-section--collapsed": !unscheduled }]} id="section-unscheduled">
          <button type="button" class="today-section__header today-section__toggle"
            aria-controls="today-unscheduled-list" aria-expanded={Boolean(unscheduled)}>
            <span class="today-section__icon" aria-hidden="true">▶</span>
            <span class="today-section__title">
              <span aria-hidden="true">📌</span> Unscheduled
            </span>
            <span class="today-section__count" id="today-unscheduled-list-count">{unscheduledCount}</span>
          </button>
          <div class="today-section__list" id="today-unscheduled-list" hidden={!unscheduled}>
            <div id="today-unscheduled-page" data-page={unscheduled?.number ?? 0}>
              {unscheduled && (
                <>
                  <p class="today-unscheduled-pagination" role="status" tabindex="-1" data-unscheduled-range>
                    {unscheduled.total ? `Showing ${unscheduled.first}–${unscheduled.last} of ${unscheduled.total}` : "No unscheduled tasks match these filters"}
                  </p>
                  {unscheduled.items.map(task => (
                    <TaskListItem task={task} showActions section="Unscheduled" />
                  ))}
                  {unscheduled.pages > 1 && <nav class="today-unscheduled-pagination" aria-label="Unscheduled tasks pages">
                    {unscheduled.number > 1 && (
                      <a class="btn btn-sm" href={unscheduledLink(unscheduled.number - 1)} data-unscheduled-page={unscheduled.number - 1}>Previous</a>
                    )}
                    {unscheduled.number < unscheduled.pages && (
                      <a class="btn btn-sm" href={unscheduledLink(unscheduled.number + 1)} data-unscheduled-page={unscheduled.number + 1}>Next</a>
                    )}
                  </nav>}
                </>
              )}
            </div>
            <p role="status" id="today-unscheduled-status" hidden></p>
            <button type="button" class="btn btn-sm" id="today-unscheduled-retry" hidden>Retry</button>
          </div>
        </div>
      )}
    </section>

    <section id="today-habits" class="page-shell__section" data-today-section>
      <div class="page-shell__intro">
        <div>
          <div class="page-shell__eyebrow">Habits</div>
          <h2 class="page-shell__title">Your routines</h2>
        </div>
      </div>

      <div class="today-section" id="section-habits">
        <button type="button" class="today-section__header today-section__toggle"
          aria-controls="today-habits-list" aria-expanded="true">
          <span class="today-section__icon" aria-hidden="true">▶</span>
          <span class="today-section__title" style="color: var(--accent-text);">
            <span aria-hidden="true">🔄</span> Habits / Routines
          </span>
          <span class="today-section__count" id="today-habits-list-count">{habits.length}</span>
        </button>
        <div class="today-section__list" id="today-habits-list">
          {habitsEnabled && habits.length > 0 ? (
            habits.map(habit => (
              <div
                class={`habit-card ${habit.todayCompleted ? "habit-card--done" : ""}`}
                data-habit-id={habit.id}
                data-today-task-id={habit.todayTaskId ?? ""}
              >
                <span class="habit-card__icon">{habit.icon}</span>
                <div class="habit-card__info">
                  <span class="habit-card__name">{habit.name}</span>
                  <span class="habit-card__meta">
                    {habit.currentStreak > 0 && <span class="habit-card__streak">🔥{habit.currentStreak}</span>}
                    <span class="habit-card__total">{habit.totalCompletions} total</span>
                  </span>
                </div>
                <button
                  type="button"
                  class="habit-card__complete btn btn-sm"
                  disabled={habit.todayCompleted}
                >
                  {habit.todayCompleted ? "✅ Done" : "Complete"}
                </button>
              </div>
            ))
          ) : (
            <div class="today-shell__empty card">
              {habitsEnabled
                ? "No active habits are feeding into Today yet."
                : "Habits are currently disabled for this workspace."}
            </div>
          )}
        </div>
      </div>
    </section>

    <section id="today-flow" class="page-shell__section" data-today-section>
      <div class="page-shell__intro">
        <div>
          <div class="page-shell__eyebrow">Flow</div>
          <h2 class="page-shell__title">Other views</h2>
        </div>
      </div>

      <InlineHelper helperId="today-flow-explainer" title="Navigation & Context" icon="🧭" variant="tip">
