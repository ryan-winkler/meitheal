---
import { resolveBoardPageScope, boardScopeResponse } from "@lib/board-http"

import BoardWorkspaceNav from "../components/boards/BoardWorkspaceNav.astro"
import "../styles/boards.css"
import { newOrganizationLabel, organizationLabelsFor } from "@lib/organization-labels"
/**
 * Habits Page — Routine Template Control Surface
 *
 * @domain domain-tasks (routines bounded context)
 * @bounded-context routines
 *
 * Routines (formerly "habits") are task templates (`is_routine = 1`) that
 * spawn real tasks. This page keeps the user-facing "Habits" label while the
 * underlying persistence and DDD terminology stay aligned with routines.
 *
 * @kcs Habits are not an isolated tracker. Completing a habit creates or
 * completes a real task that appears in Today, Kanban, Table, and Upcoming.
 * @see docs/decisions/ADR-007-hierarchy-model.md
 */
import UnifiedBar from "../components/layout/UnifiedBar.astro"
import Icon from "../components/ui/Icon.astro"
import Layout from "../layouts/Layout.astro"

import { scopeBoardAccess, scopePermits } from "@domains/tasks/board-scope"
import { TemplateRepository, type RoutineWithStats } from "@domains/tasks/persistence/template-repository"
import { HierarchyRepository, type AreaRow, type ProjectRow } from "@domains/tasks/persistence/hierarchy-repository"
import {
  ensureSchema,
  getPersistenceClient,
} from "@domains/tasks/persistence/store"
import { t } from "../i18n/translations"
import { formatCalendarDay } from "@lib/calendar-day"
import { isFeatureEnabled } from "../lib/feature-flags"
import { HABITS_SECTIONS } from "../lib/habits-registry"
import { isValidTimezone } from "@lib/date"
import { readStoredHouseholdTimezone } from "@lib/task-queries"
import { serializeForScript } from "../lib/safe-html"
import { mapEntityEmojiToTabler } from "@lib/tabler-svg"
import { taskDetailPath } from "@lib/task-page-url"
const ROUTINE_ICON_OPTIONS = [
  "check",
  "repeat",
  "flame",
  "sparkles",
  "sun",
  "moon",
  "droplet",
  "walk",
  "heart",
  "pill",
  "book",
  "wash",
  "coffee",
  "apple",
  "star",
  "target",
] as const
const workScopeResult = await resolveBoardPageScope(Astro, { boardId: Astro.props.boardId })
if (!workScopeResult.ok) return boardScopeResponse(workScopeResult.errorCode)
const workScope = workScopeResult.scope


interface HabitViewModel extends RoutineWithStats {
  description: string
  priority: number
}

const locale = Astro.cookies.get("meitheal-locale")?.value === "ga" ? "ga" : "en"

const isEnabled = await isFeatureEnabled("habits")
if (!isEnabled) {
  return Astro.redirect(`${Astro.locals.ingressPath || ""}/`)
}

let habits: HabitViewModel[] = []
let loadFailed = false
const boardActive = scopeBoardAccess(workScope).state === "active"
const boardName = scopeBoardAccess(workScope).name
let areas: AreaRow[] = []
let projects: ProjectRow[] = []
let project: ProjectRow | undefined
const canCreateRoutine = scopePermits(workScope, { resource: "routine", action: "create" })
const canEditRoutine = scopePermits(workScope, { resource: "routine", action: "edit" })
const canDeleteRoutine = scopePermits(workScope, { resource: "routine", action: "delete" })
const canCompleteRoutine = canEditRoutine && scopePermits(workScope, { resource: "task", action: "complete" }) && scopePermits(workScope, { resource: "task", action: "create" })
const areaId = Astro.url.searchParams.get("area_id")
const projectId = Astro.url.searchParams.get("project_id")
const openNew = Astro.url.searchParams.get("new") === "1"
let area: AreaRow | undefined

function parseTemplateDetails(routine: RoutineWithStats): {
  description: string
  priority: number
} {
  try {
    const parsed = JSON.parse(routine.template_json) as Record<string, unknown>
    return {
      description: String(parsed.description ?? "").trim(),
      priority: Number(parsed.priority ?? 3) || 3,
    }
  } catch {
    return {
      description: "",
      priority: 3,
    }
  }
}

function cadenceLabel(cadence: string): string {
  return cadence === "weekly" ? "Weekly" : "Daily"
}

function priorityLabel(priority: number): string {
  switch (priority) {
    case 1:
      return "P1"
    case 2:
      return "P2"
    case 4:
      return "P4"
    case 5:
      return "P5"
    default:
      return "P3"
  }
}

function formatLastCompletedDate(value: string | null): string {
  if (!value) return t("habits.never_completed", locale)
  return t("habits.last_done", locale, { date: formatCalendarDay(value, locale) ?? value })
}

try {
  await ensureSchema()
  const client = getPersistenceClient()
  const hierarchy = new HierarchyRepository(client, workScope)
  ;[areas, projects] = await Promise.all([hierarchy.findAllAreas(), hierarchy.findAllProjects()])
  project = projectId ? projects.find(candidate => candidate.id === projectId) : undefined
  if (projectId && !project) return boardScopeResponse("unavailable")
  area = areaId ? areas.find(candidate => candidate.id === areaId) : undefined
  if (areaId !== null && !area) return Astro.redirect(`${Astro.locals.ingressPath || ""}/boards/${encodeURIComponent(workScope.boardId)}?view=groups`)
  const rawTz = Astro.locals.timezone?.trim() ?? ""
  const timezone = isValidTimezone(rawTz) ? rawTz : await readStoredHouseholdTimezone()
  const routines = await new TemplateRepository(client, workScope).getRoutinesWithStats(area?.id, projectId ?? undefined, timezone)
  habits = routines.map((routine) => ({
    ...routine,
    ...parseTemplateDetails(routine),
  }))
} catch {
  loadFailed = true
}

const activeCount = habits.length
const completedTodayCount = habits.filter((habit) => habit.todayCompleted).length
const longestStreak = Math.max(0, ...habits.map((habit) => habit.longestStreak))
const totalCompletions = habits.reduce((sum, habit) => sum + habit.totalCompletions, 0)
const dailyCount = habits.filter((habit) => habit.cadence === "daily").length
const weeklyCount = habits.filter((habit) => habit.cadence === "weekly").length
const cadenceSummary = !boardActive ? "This Board is unavailable. Return to Boards to choose another." :
  activeCount === 0
    ? "Create your first routine to begin a consistent cadence."
    : `${dailyCount} daily · ${weeklyCount} weekly routines`
const organization = await organizationLabelsFor(Astro)
const newRoutine = newOrganizationLabel(organization("routine"), locale)
const habitsBootstrap = serializeForScript({ habits })
---

<Layout title={`${organization("routine", true)} — Meitheal`}>

  <UnifiedBar
    title={organization("routine", true)}
    titleIcon="repeat"
    tabs={HABITS_SECTIONS.map((section) => ({
      id: section.id,
      label: section.label,
      icon: section.icon,
    }))}
    searchPlaceholder="Search Meitheal…"
    searchScope="all"
    showNewTask={false}
    barId="habits-bar"
    slot="custom-header"
  >
    <button
      slot="actions"
      type="button"
      class="btn btn-ghost habits-shell__create-bar-btn"
      id="habits-bar-new-habit"
      data-open-habit-modal={loadFailed || !boardActive || !canCreateRoutine ? undefined : "true"}
      disabled={loadFailed || !boardActive || !canCreateRoutine}
      title={loadFailed ? "Refresh the page to retry loading Routines" : boardActive ? newRoutine : "This Board is unavailable"}
      aria-label={newRoutine}
    >
      <Icon name="plus" size={18} class="unified-bar__new-task-icon" sprite />
      <span class="unified-bar__new-task-label">{newRoutine}</span>
    </button>
  </UnifiedBar>
  {<BoardWorkspaceNav boardId={workScope.boardId} {boardName}
    area={area ? { id: area.id, name: area.name } : undefined} project={project ? { id: project.id, name: project.title } : undefined} active="routines" />}


  <div id="habits-shell" class="habits-shell" data-area-id={area?.id} data-project-id={project?.id} data-can-edit={String(canEditRoutine)} data-can-delete={String(canDeleteRoutine)} data-can-complete={String(canCompleteRoutine)} data-board-id={workScope.boardId} data-board-active={String(boardActive)} data-open-new={openNew && !loadFailed && boardActive ? "true" : undefined}>
    {area && <div class="flex flex-wrap gap-2">
      <a class="btn btn-ghost" href={`/areas/${encodeURIComponent(area.id)}#routines`}>{area.name}</a>
      <a class="btn btn-ghost" href={`/habits?board_id=${encodeURIComponent(workScope.boardId)}`}>All Routines</a>
    </div>}
    <section
      id="habits-overview"
      class="habits-shell__section habits-shell__section--overview"
      data-habits-section
    >
      <h1 class="habits-heading m-0 text-2xl font-semibold tracking-tight">{organization("routine", true)}</h1>
    </section>

    <section id="habits-rhythm" class="habits-shell__section" data-habits-section>
      <h2 class="habits-section__title">Rhythm</h2>
      {loadFailed ? <p role="status" class="m-0 text-text-secondary">Routine counts couldn’t load. Refresh the page to try again.</p> : <>
      <div class="habits-stats" id="habits-stats">
        <div class="stat-card">
          <span class="stat-value" id="stat-active">{activeCount}</span>
          <span class="stat-label">Active Routines</span>
        </div>
        <div class="stat-card">
          <span class="stat-value" id="stat-completed-today">{completedTodayCount}</span>
          <span class="stat-label">Done Today</span>
        </div>
        <div class="stat-card">
          <span class="stat-value" id="stat-longest-streak">{longestStreak}</span>
          <span class="stat-label">Best Streak</span>
        </div>
        <div class="stat-card">
          <span class="stat-value" id="stat-total">{totalCompletions}</span>
          <span class="stat-label">Total Completions</span>
        </div>
      </div>

      <div class="habits-rhythm__summary card">
        <div class="card-header habits-rhythm__summary-header">
          <div>
            <div class="card-title">Cadence mix</div>
            <div class="card-subtitle" id="habits-cadence-summary">{cadenceSummary}</div>
          </div>
        </div>
      </div>
      </>}
    </section>

    {!boardActive && !loadFailed && <p class="card card-body" role="status">
      This Board is unavailable. Its Routines remain saved.
      <a href="/boards">Open Boards</a>
    </p>}

    <section id="habits-library" class="habits-shell__section" data-habits-section>
      <div class="habits-section__intro">
        <h2 class="habits-section__title">Library</h2>
        <div class="habits-section__actions">
          <button type="button" class="btn btn-primary" data-open-habit-modal={loadFailed || !boardActive || !canCreateRoutine ? undefined : "true"} disabled={loadFailed || !boardActive || !canCreateRoutine}>
            {newRoutine}
          </button>
        </div>
      </div>

      <div class="card habits-library-card">
        <div class="card-header">
          <div>
            <div class="card-title">Active routines</div>
            {!loadFailed && <div class="card-subtitle" id="habits-library-count" hidden={activeCount === 0}>
              {activeCount} active routine{activeCount !== 1 ? "s" : ""}
            </div>}
          </div>
        </div>

        <div class="habits-list" id="habits-list">
          {
            loadFailed ? (
              <div class="habits-empty">
                <p class="habits-empty__title">Routines couldn’t load right now</p>
                <p class="habits-empty__detail">
                  Refresh the page or inspect `/api/habits` if the add-on database is still
                  warming up.
                </p>
              </div>
            ) : !boardActive ? (
              <div class="habits-empty"><p class="habits-empty__title">Board Routines are paused</p>
                <p class="habits-empty__detail">Restore this Board from Boards to return to its saved Routines.</p></div>
            ) : habits.length === 0 ? (
              <div class="habits-empty">
                <p class="habits-empty__title">No routines yet.</p>
              </div>
            ) : (
              habits.map((habit) => {
                const routineIcon = mapEntityEmojiToTabler(habit.icon)
                return (
                <article
                  class={`habit-card ${habit.todayCompleted ? "completed" : ""}`}
                  data-habit-id={habit.id}
                >
                  <div class="habit-card__top">
                    <button
                      type="button"
                      class="habit-card__check"
                      disabled={!canCompleteRoutine || habit.todayCompleted || !habit.projectActive}
                      aria-pressed={habit.todayCompleted ? "true" : "false"}
                      data-action="complete"
                      data-id={habit.id}
                      aria-label={habit.todayCompleted ? `${habit.name} completed for this period` : `Complete ${habit.name} today`}
                    >
                      {habit.todayCompleted && <Icon name="check" size={16} sprite />}
                    </button>

                    <span class="habit-card__icon" aria-hidden="true">
                      {routineIcon ? <Icon name={routineIcon} size={20} sprite /> : habit.icon}
                    </span>

                    <div class="habit-card__info">
                      <div class="habit-card__name">{habit.name}</div>
                      <div class="habit-card__meta">
                        {
                          habit.currentStreak > 0 && (
                            <span class="habit-card__meta-item habit-card__streak">
                              <Icon name="flame" size={14} sprite />
                              <span>{habit.currentStreak} {habit.cadence === "weekly" ? "week" : "day"} streak</span>
                            </span>
                          )
                        }
                        <span class="habit-card__meta-item">
                          {cadenceLabel(habit.cadence)}
                        </span>
                        <span class="habit-card__meta-item">
                          {priorityLabel(habit.priority)}
                        </span>
                        <span class="habit-card__meta-item">
                          {habit.totalCompletions} total
                        </span>
                        <span class="habit-card__meta-item">
                          {formatLastCompletedDate(habit.lastCompletedDate)}
                        </span>
                        {!habit.projectActive && (
                          <span class="habit-card__meta-item habit-card__inactive">
                            Paused project
                          </span>
                        )}
                        {habit.todayTaskId && (
                          <a class="habit-card__meta-item habit-card__task-link" href={taskDetailPath(habit.todayTaskId)}>
                            View task
                          </a>
                        )}
                        {
                          habit.checklists.length > 0 && (
                            <span class="habit-card__meta-item">
                              {habit.checklists.length} checklist items
                            </span>
                          )
                        }
                      </div>
                    </div>

                    <div class="habit-card__actions">
                      <button
                        type="button"
                        class="btn-icon"
                        disabled={!canEditRoutine} data-action="edit"
                        data-id={habit.id}
                        aria-label={`Edit ${habit.name}`}
                        title={`Edit ${habit.name}`}
                      >
                        <Icon name="pencil" size={16} sprite />
                      </button>
                      <button
                        type="button"
                        class="btn-icon"
                        disabled={!canDeleteRoutine} data-action="delete"
                        data-id={habit.id}
                        aria-label={`Delete ${habit.name}`}
                        title={`Delete ${habit.name}`}
                      >
                        <Icon name="trash" size={16} sprite />
                      </button>
                    </div>
                  </div>

                  {
                    habit.description && (
                      <p class="habit-card__description">{habit.description}</p>
                    )
                  }

                  {
                    habit.checklists.length > 0 && (
                      <ul class="habit-card__checklist" aria-label={`${habit.name} template checklist`}>
                        {habit.checklists.map((item) => (
                          <li class="habit-card__checklist-item">
                            <span class="habit-card__checklist-marker" aria-hidden="true">
                              {item.done ? <Icon name="check" size={14} sprite /> : "•"}
                            </span>
                            <span>{item.text}</span>
                          </li>
                        ))}
                      </ul>
                    )
                  }
                </article>
                )
              })
            )
          }
        </div>
      </div>
    </section>

    <section id="habits-flow" class="habits-shell__section" data-habits-section>
      <h2 class="habits-section__title">Related views</h2>
      <p class="m-0 text-text-secondary">Completing a routine creates or updates a task in these views.</p>
      <div class="habits-flow-links">
        <a href={`/today?board_id=${encodeURIComponent(workScope.boardId)}`} class="habits-flow-link">Today</a>
        <a href={`/boards/${encodeURIComponent(workScope.boardId)}?view=kanban`} class="habits-flow-link">Kanban</a>
        <a href={`/boards/${encodeURIComponent(workScope.boardId)}?view=table`} class="habits-flow-link">Table</a>
        <a href={`/upcoming?board_id=${encodeURIComponent(workScope.boardId)}`} class="habits-flow-link">Upcoming</a>
      </div>
    </section>

    <div class="habit-modal-overlay hidden" id="habit-modal-overlay">
      <div class="habit-modal" role="dialog" aria-modal="true" aria-labelledby="habit-modal-title">
        <div class="habit-modal__header">
          <h2 id="habit-modal-title" data-create-title={boardActive ? newRoutine : "This Board is unavailable"} data-edit-title={`Edit ${organization("routine")}`}>{newRoutine}</h2>
          <button type="button" class="btn-icon" id="habit-modal-close" aria-label="Close">
            <Icon name="x" size={18} sprite />
          </button>
        </div>

        <form id="habit-form" class="habit-modal__body">
          <input type="hidden" id="habit-edit-id" value="" />

          <div class="form-group">
            <label for="habit-name">Routine Name</label>
            <input
              type="text"
              id="habit-name"
              placeholder="e.g. Morning Walk"
              maxlength="100"
              required
            />
          </div>

          <div class="form-group">
            <label id="habit-icon-label" for="habit-icon">Icon</label>
            <input type="hidden" id="habit-icon" value="check" />
            <div class="habit-icon-picker" id="habit-icon-picker" role="group" aria-labelledby="habit-icon-label">
              {ROUTINE_ICON_OPTIONS.map((iconName) => (
                <button
                  type="button"
                  class={`habit-icon-picker__btn${iconName === "check" ? " is-selected" : ""}`}
                  data-habit-icon-option={iconName}
                  aria-pressed={iconName === "check" ? "true" : "false"}
                  aria-label={iconName}
                  title={iconName}
                >
                  <Icon name={iconName} size={18} sprite />
                </button>
              ))}
            </div>
          </div>

          <div class="form-group form-row">
            <div class="form-group">
              <label for="habit-cadence">Cadence</label>
              <select id="habit-cadence">
                <option value="daily">Daily</option>
                <option value="weekly">Weekly</option>
              </select>
            </div>

            <div class="form-group">
              <label for="habit-priority">Priority</label>
              <select id="habit-priority">
                <option value="1">Urgent</option>
                <option value="2">High</option>
                <option value="3" selected>Medium</option>
                <option value="4">Low</option>
                <option value="5">None</option>
              </select>
            </div>
          </div>

          <div class="form-group">
            <label for="habit-area">Area</label>
            <select id="habit-area">
              <option value="" selected={!area}>Without an Area</option>
              {areas.map(option => <option value={option.id} selected={area?.id === option.id}>{option.name}</option>)}
            </select>
          </div>
          <div class="form-group">
            <label for="habit-project">Project (optional)</label>
            <select id="habit-project">
              <option value="" selected={!project}>Without a Project</option>
              {projects.map(option => <option value={option.id} data-area-id={option.area_id ?? ""} selected={project?.id === option.id}>{option.title}</option>)}
            </select>
          </div>

          <div class="form-group">
            <label for="habit-description">Description (optional)</label>
            <textarea
              id="habit-description"
              rows="2"
              placeholder="What does this routine involve?"
            ></textarea>
          </div>

          <div class="form-group">
            <label>Checklist (optional)</label>
            <div id="checklist-items" class="checklist-builder"></div>
            <button type="button" class="btn btn-ghost btn-sm" id="add-checklist-item">
              <Icon name="plus" size={14} sprite /> Add item
            </button>
          </div>

          <div class="habit-modal__footer">
            <button type="button" class="btn btn-ghost" id="habit-cancel">Cancel</button>
            <button type="submit" class="btn btn-primary">Save Routine</button>
          </div>
        </form>
      </div>
    </div>
  </div>

  <button
    id="habits-go-top"
    class="go-top-btn habits-go-top"
    type="button"
    aria-label="Scroll to top"
    title="Back to top"
    hidden
  >
    <Icon name="arrow-up" size={18} sprite />
  </button>

  <script id="habits-bootstrap" type="application/json" set:html={habitsBootstrap}></script>

  <script>
    import "@lib/habits-controller"
  </script>
</Layout>

<style>
  .habits-shell {
    display: flex;
    flex-direction: column;
    gap: 28px;
    padding: 24px clamp(16px, 2vw, 24px) 52px;
  }

  .habits-shell__section {
    display: flex;
    flex-direction: column;
    gap: 16px;
    scroll-margin-top: calc(var(--unified-bar-height, 56px) + 20px);
  }

  .habits-shell__create-bar-btn {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    min-width: 44px;
    min-height: 44px;
    white-space: nowrap;
  }

  .habits-shell__create-bar-btn .unified-bar__new-task-label {
    max-width: 14ch;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  @media (max-width: 1359px) {
    .habits-shell__create-bar-btn .unified-bar__new-task-label {
      display: none;
    }
  }

  .habits-section__intro {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 12px;
  }

  .habits-section__title {
    margin: 0;
    font-size: 1.125rem;
    font-weight: 600;
  }

  .habits-flow-links {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
  }

  .habits-flow-link {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 38px;
    padding: 0 14px;
    border-radius: 999px;
    border: 1px solid color-mix(in srgb, var(--accent) 20%, var(--border));
    background: color-mix(in srgb, var(--bg-card) 88%, transparent);
    color: var(--text-primary);
    text-decoration: none;
    font-size: 0.85rem;
    font-weight: 600;
    transition: transform 160ms ease, border-color 160ms ease, background 160ms ease;
  }

  .habits-flow-link:hover {
    transform: translateY(-1px);
    border-color: color-mix(in srgb, var(--accent) 42%, var(--border));
    background: color-mix(in srgb, var(--accent) 8%, var(--bg-card));
  }

  .habits-stats {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(170px, 1fr));
    gap: 14px;
  }

  .stat-card {
    display: flex;
    flex-direction: column;
    gap: 8px;
    padding: 18px 16px;
    border-radius: 18px;
    border: 1px solid color-mix(in srgb, var(--accent) 12%, var(--border));
    background:
      linear-gradient(180deg, rgba(255, 255, 255, 0.03) 0%, transparent 100%),
      color-mix(in srgb, var(--bg-card) 94%, transparent);
    box-shadow: 0 14px 36px -30px rgba(0, 0, 0, 0.42);
  }

  .stat-value {
    font-size: clamp(1.5rem, 2.2vw, 1.9rem);
    font-weight: 800;
    letter-spacing: -0.03em;
    color: var(--accent);
  }

  .stat-label {
    font-size: 0.72rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--text-muted);
  }

  .habits-rhythm__summary {
    padding: 0;
    overflow: hidden;
  }

  .habits-rhythm__summary-header {
    padding-bottom: 0;
  }


  .habits-section__actions {
    display: flex;
    align-items: center;
    gap: 12px;
    min-width: 0;
    max-width: 100%;
  }

  .habits-heading,
  .habits-section__actions .btn {
    overflow-wrap: anywhere;
  }

