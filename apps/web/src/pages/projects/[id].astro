---
import BoardWorkspaceNav from "../../components/boards/BoardWorkspaceNav.astro"
import { scopeBoardAccess, type BoardScope } from "@domains/tasks/board-scope"
import { resolveBoardPageScope, boardScopeResponse } from "@lib/board-http"

import { isOrganizationFeatureAvailable as available } from "@lib/organization-request-context"
import { organizationLabelsFor } from "@lib/organization-labels"
/**
 * Project Detail — shows project metadata + tabbed sections for Tasks, Fields, Settings.
 * Uses hash-based sub-menu tabs matching the parent page shell pattern.
 * @page /projects/[id]
 * @phase 15 — Wave 4.5
 */
import LegacyBoardBridge from "../../components/boards/LegacyBoardBridge.astro"
import Layout from "../../layouts/Layout.astro";
import { logApiError } from "../../lib/api-logger"
import Icon from "../../components/ui/Icon.astro"
import { t } from "../../i18n/translations";
import type { Locale } from "../../lib/locale";
import {
  ensureSchema,
  getPersistenceClient,
} from "@domains/tasks/persistence/store";
import { HierarchyRepository, type AreaRow, type GoalRow } from "@domains/tasks/persistence/hierarchy-repository"
import { TaskRepository } from "@domains/tasks/persistence/task-repository";
import { PRIORITY_COLORS } from "../../lib/priority-config";
import { boardWorkspaceHref } from "@lib/board-workspace"
import { taskDetailPath } from "@lib/task-page-url"
import { isClosedStatus, STATUS_LABELS } from "../../lib/status-config";
import { mapEntityEmojiToTabler } from "../../lib/tabler-svg"
import { isIconName, type IconName } from "../../generated/icon-registry"
const workspaceProjectId = Astro.props.workspaceProjectId as string | undefined
const admittedScope = Astro.props.workScope as BoardScope | undefined
const workScopeResult = admittedScope ? { ok: true as const, scope: admittedScope }
  : await resolveBoardPageScope(Astro, { boardId: Astro.props.boardId, record: { resource: "project", id: workspaceProjectId ?? Astro.params.id! } })
if (!workScopeResult.ok && !workspaceProjectId) return boardScopeResponse(workScopeResult.errorCode)
const workScope = workScopeResult.ok ? workScopeResult.scope : null
let unavailable = !workScope


const cookieLocale = Astro.cookies.get("meitheal-locale")?.value;
const locale: Locale = cookieLocale === "ga" ? "ga" : "en";

const projectId = workspaceProjectId ?? Astro.params.id ?? "";
const projectsPath = `${Astro.locals.ingressPath || ""}/planning#spaces`
if (!projectId && !workspaceProjectId) {
  return Astro.redirect(projectsPath);
}

let project: Record<string, unknown> | null = null;
let goal: Record<string, unknown> | null = null;
let area: Record<string, unknown> | null = null;
let tasks: Record<string, unknown>[] = [];
let goals: GoalRow[] = []
let areas: AreaRow[] = []

try {
  if (!workScope || !projectId) throw new Error("Work unavailable")
  await ensureSchema();
  const client = getPersistenceClient();
  const repo = new HierarchyRepository(client, workScope);
  const taskRepo = new TaskRepository(client, workScope);

  project = await repo.findProjectById(projectId) as Record<string, unknown> | null;

  if (!project) {
    if (!workspaceProjectId) return Astro.redirect(projectsPath)
    throw new Error("Work unavailable")
  }

  if (project.goal_id && available("goals")) {
    goal = await repo.findGoalById(project.goal_id as string) as Record<string, unknown> | null;
  }
  const areaId = project.area_id ?? goal?.area_id
  if (typeof areaId === "string" && available("groups")) {
    area = await repo.findAreaById(areaId) as Record<string, unknown> | null
  }

  tasks = await taskRepo.findByProjectId(projectId);
  goals = available("goals") ? await repo.findAllGoals({}) : [];
  areas = available("groups") ? await repo.findAllAreas() : []
} catch (error) {
  logApiError("projects", "Could not load Project details", error)
  unavailable = true
  if (!workspaceProjectId) return new Response("Could not load this Project. Reload to try again.", {
    status: 503, headers: { "content-type": "text/plain; charset=utf-8", "cache-control": "private, no-store" },
  })
}

const projTitle = String(project?.title ?? "Project");
const projDesc = project?.description ? String(project.description) : null;
const projIcon = String(project?.icon ?? "📋");
const mappedIcon = mapEntityEmojiToTabler(projIcon)
const projectIconName = mappedIcon && isIconName(mappedIcon) ? mappedIcon : null
const projColor = String(project?.color ?? "#146C4E");
const projStatus = String(project?.status ?? "active");
const openTasks = workspaceProjectId ? tasks.filter(task => !isClosedStatus(String(task.status))) : []
const nextAction = openTasks.find(task => !task.blocked_by && task.status !== "stalled")
const fromArea = workspaceProjectId && area && Astro.url.searchParams.get("from") === area.id ? String(area.id) : undefined
const settingsTab = workspaceProjectId ? "project-settings" : "settings"


const completedCount = tasks.filter((t) => String(t.status) === "complete").length;
const progress = tasks.length > 0 ? Math.round((completedCount / tasks.length) * 100) : 0;

const { timezone, dateFormat } = Astro.locals;

const organization = await organizationLabelsFor(Astro)
const tasksHref = boardWorkspaceHref((workScope?.boardId ?? ""), { project: projectId, fromArea })
const tasksPath = `${Astro.locals.ingressPath || ""}${tasksHref}#kanban`
const tabs: { id: string; label: string; icon: IconName }[] = [
  { id: "overview", label: "Overview", icon: "chart-bar" },
  { id: "fields", label: "Fields", icon: "tag" },
  { id: settingsTab, label: "Settings", icon: "settings" },
]
---

{(!workScope || !project || unavailable) ? <p role="status">This Project is unavailable. Reload to try again.</p> : !workspaceProjectId ? <LegacyBoardBridge href={boardWorkspaceHref((workScope?.boardId ?? ""), { project: projectId })} kind="project"
  fragments={{ overview: "overview", tasks: "tasks", settings: "project-settings", fields: "fields" }} /> : <Layout title={`Meitheal — ${projTitle}`}>
  <span slot="page-title" class="inline-flex max-w-full items-center gap-1.5 align-middle">
    <span class="shrink-0" aria-hidden="true" style={`color: ${projColor}`}>
      {projectIconName ? <Icon name={projectIconName} size={18} sprite /> : projIcon}
    </span>
    <span class="truncate">{projTitle}</span>
  </span>
  <div slot="actions" class="flex gap-2">
    <a href={workspaceProjectId ? boardWorkspaceHref((workScope?.boardId ?? ""), fromArea ? { area: fromArea } : {}) : "/projects"} class="btn btn-ghost">
      <Icon name="arrow-down" size={16} class="rotate-90 shrink-0" sprite />
      {workspaceProjectId ? (fromArea ? String(area?.name) : scopeBoardAccess(workScope).name) : "Projects"}
    </a>
    <a href={tasksHref + "&capture=1#kanban"} class="btn btn-primary" id="add-task-to-project-btn">
      <Icon name="plus" size={16} class="shrink-0" sprite />
      Add Task
    </a>
  </div>

  {/* Sub-menu tab bar */}
  <BoardWorkspaceNav boardId={(workScope?.boardId ?? "")} boardName={scopeBoardAccess(workScope).name} project={{ id: String(project.id), name: String(project.title) }} active="planning" />
  <nav class="project-tabs" aria-label="Project sections">
    <a href={tasksHref + "#kanban"} class="project-tab" data-astro-reload>
      <Icon name="checkbox" size={14} class="shrink-0" sprite />
      <span>{organization("task", true)}</span>
    </a>
    <div class="project-panel-tabs" role="tablist" aria-label="Project sections">
    {tabs.map((tab) => (
      <a
        href={`#${tab.id}`}
        class={`project-tab ${tab.id === "overview" ? "active" : ""}`}
        role="tab"
        id={`project-tab-${tab.id}`}
        aria-controls={`section-${tab.id}`}
        data-tab={tab.id}
        data-astro-reload
        aria-selected={tab.id === "overview" ? "true" : "false"}
      >
        <Icon name={tab.icon} size={14} class="shrink-0" sprite />
        <span>{tab.label}</span>
      </a>
    ))}
    </div>
  </nav>

  {/* ── Overview Section ── */}
  <section id="section-overview" class="project-section active" data-section="overview" role="tabpanel" aria-labelledby="project-tab-overview">
    {/* Breadcrumb */}
    <nav class="project-breadcrumb" aria-label="Project breadcrumb">
      <a href={workspaceProjectId ? boardWorkspaceHref((workScope?.boardId ?? "")) : "/projects"}>{"Board"}</a>
      {area && <>
        <Icon name="chevron-down" size={12} class="bc-sep -rotate-90 shrink-0" sprite />
        <a href={workspaceProjectId ? boardWorkspaceHref((workScope?.boardId ?? ""), { area: String(area.id) }) : `/areas/${String(area.id)}`}>{String(area.name)}</a>
      </>}
      {goal && <>
        <Icon name="chevron-down" size={12} class="bc-sep -rotate-90 shrink-0" sprite />
        <a class="inline-flex items-center gap-1" href={`/progress?board_id=${encodeURIComponent((workScope?.boardId ?? ""))}&project_id=${encodeURIComponent(projectId)}#goals`}>
          <Icon name="target" size={12} class="shrink-0" sprite />
          {String(goal.title)}
        </a>
      </>}
      <Icon name="chevron-down" size={12} class="bc-sep -rotate-90 shrink-0" sprite />
      <span class="bc-current inline-flex min-w-0 items-center gap-1">
        <span class="shrink-0" aria-hidden="true">
          {projectIconName ? <Icon name={projectIconName} size={12} sprite /> : projIcon}
        </span>
        <span class="truncate">{projTitle}</span>
      </span>
    </nav>

    {/* Project header card */}
    <div class="project-header-card" style={`--project-accent: ${projColor};`}>
      <div class="project-header-top">
        <div class="project-header-info">
          <span class={`project-status-badge status-${projStatus}`}>{projStatus}</span>
          {workspaceProjectId && <p>{openTasks.length} open · {nextAction
            ? <a href={taskDetailPath({ id: String(nextAction.id), ticket_key: nextAction.ticket_key })}>Next action: {String(nextAction.title)}</a>
            : "No next action"}</p>}

          {projDesc && <p class="project-desc">{projDesc}</p>}
        </div>
        <div class="project-header-stats">
          <div class="stat-block">
            <div class="stat-value">{tasks.length}</div>
            <div class="stat-label">Tasks</div>
          </div>
          <div class="stat-block">
            <div class="stat-value">{completedCount}</div>
            <div class="stat-label">Done</div>
          </div>
          <div class="stat-block">
            <div class={`stat-value ${progress === 100 ? "stat-complete" : ""}`}>{progress}%</div>
            <div class="stat-label">Progress</div>
          </div>
        </div>
      </div>
      <div class="project-progress-full">
        <div class="project-progress-bar" style={`width: ${progress}%`} />
      </div>
    </div>
  </section>

  {/* ── Fields Section ── */}
  <section id="section-fields" class="project-section" data-section="fields" role="tabpanel" aria-labelledby="project-tab-fields">
    <div class="section-header">
      <h2 class="section-title">Custom Fields</h2>
    </div>

    <div class="fields-placeholder">
      <Icon name="tag" size={40} class="mx-auto mb-3" sprite />
      <h3 class="fields-placeholder-title">Custom Fields</h3>
      <p class="fields-placeholder-desc">
        Project-specific custom field configuration is unavailable. You can add supported custom field values when creating a task.
      </p>
    </div>
  </section>

  {/* ── Settings Section ── */}
  <section id={`section-${settingsTab}`} class="project-section" data-section={settingsTab} role="tabpanel" aria-labelledby={`project-tab-${settingsTab}`}>
    <div class="section-header">
      <h2 class="section-title">{organization("project")} Settings</h2>
    </div>

    <div class="settings-card">
      <div class="form-group">
        <label for="edit-proj-title">Title</label>
        <input type="text" id="edit-proj-title" value={projTitle} maxlength="200" />
      </div>
      <div class="form-group">
        <label for="edit-proj-desc">Description</label>
        <textarea id="edit-proj-desc" rows="3" maxlength="500">{projDesc ?? ""}</textarea>
      </div>
      <div class="form-row">
        <div class="form-group form-group-sm">
          <label for="edit-proj-icon">Icon</label>
          <input type="text" id="edit-proj-icon" value={projIcon} maxlength="4" class="icon-input" />
        </div>
        <div class="form-group form-group-sm">
          <label for="edit-proj-color">Color</label>
          <input type="color" id="edit-proj-color" value={projColor} class="color-input" />
        </div>
      </div>
      <div class="form-group">
        <label for="edit-proj-status">Status</label>
        <select id="edit-proj-status" class="form-select">
          <option value="active" selected={projStatus === "active"}>Active</option>
          <option value="paused" selected={projStatus === "paused"}>Paused</option>
          <option value="completed" selected={projStatus === "completed"}>Completed</option>
          <option value="archived" selected={projStatus === "archived"}>Archived</option>
        </select>
      </div>
      {available("groups") && <div class="form-group">
        <label for="edit-proj-area">{organization("group")}</label>
        <select id="edit-proj-area" class="form-select">
          <option value="">{`Use the Goal’s ${organization("group")}, if set`}</option>
          {areas.map(option => (
            <option value={option.id} selected={project?.area_id === option.id}>{option.name}</option>
          ))}
        </select>
      </div>}
      {available("goals") && <div class="form-group">
        <label for="edit-proj-goal">Goal</label>
        <select id="edit-proj-goal" class="form-select">
          <option value="">No goal</option>
          {goals.map((g) => (
            <option
              value={String(g.id)}
              selected={String(project?.goal_id ?? "") === g.id}
            >
              {String(g.title)}
            </option>
          ))}
        </select>
      </div>}
      <div class="settings-actions">
        <button type="button" class="btn btn-primary" id="save-proj-btn">Save Changes</button>
      </div>
    </div>

    <div class="danger-zone">
      <h3 class="danger-title">Danger Zone</h3>
      <p class="danger-desc">Deleting this project will unlink all associated tasks. Tasks will remain but become unassigned.</p>
      <button type="button" class="btn btn-danger" id="delete-proj-btn">Delete Project</button>
    </div>
  </section>
</Layout>}

<style is:inline>
  @reference "../../styles/global.css";

  /* Tab bar */
  .project-tabs {
    display: flex;
    gap: 2px;
    border-bottom: 1px solid var(--border);
    margin-bottom: 1.5rem;
    flex-wrap: wrap;
  }
  .project-panel-tabs { display: contents; }

  .project-tab {
    display: flex;
    align-items: center;
    gap: 6px;
    padding: 0.625rem 1rem;
    font-size: 0.8125rem;
    font-weight: 500;
    color: var(--text-muted);
    text-decoration: none;
    border-bottom: 2px solid transparent;
    min-width: 0;
    max-width: 100%;
    min-height: 44px;
    overflow-wrap: anywhere;
    transition: color 150ms, border-color 150ms;
  }
  .project-tab > span { min-width: 0; }
  .project-tab:hover { color: var(--text-primary); }
  .project-tab.active {
    color: var(--accent);
    border-bottom-color: var(--accent);
  }

  /* Sections */
  .project-section { display: none; }
  .project-section.active { display: block; }

  /* Section header */
  .section-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 1rem;
  }
  .section-title {
    margin: 0;
    font-size: 1.125rem;
    font-weight: 600;
  }

  /* Breadcrumb */
  .project-breadcrumb {
    display: flex;
    align-items: center;
    gap: 6px;
    font-size: 12px;
    color: var(--text-muted);
    margin-bottom: 1rem;
  }
  .project-breadcrumb a {
    color: var(--text-muted);
    text-decoration: none;
    transition: color 150ms;
  }
  .project-breadcrumb a:hover { color: var(--accent); }
  .bc-sep { opacity: 0.5; }
  .bc-current { color: var(--text-primary); font-weight: 500; }

  /* Project header card */
  .project-header-card {
    background: var(--bg-card);
    border: 1px solid var(--border);
    border-radius: var(--radius-md);
    padding: 1.5rem;
    margin-bottom: 1.5rem;
    position: relative;
    overflow: hidden;
  }
  .project-header-card::before {
    content: '';
    position: absolute;
    top: 0; left: 0; right: 0;
    height: 3px;
    background: var(--project-accent);
  }
  .project-header-top {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 1.5rem;
    margin-bottom: 1rem;
  }
  .project-header-info { flex: 1; }
  .project-desc {
    margin: 0.75rem 0 0;
    color: var(--text-secondary);
    font-size: 0.875rem;
    line-height: 1.5;
  }
  .project-status-badge {
    font-size: 11px;
    font-weight: 600;
    padding: 3px 10px;
    border-radius: 9999px;
    text-transform: capitalize;
  }
  .status-active { background: rgb(var(--success-rgb) / 0.1); color: var(--success); }
  .status-completed { background: rgb(var(--accent-rgb) / 0.1); color: var(--accent); }
  .status-paused { background: rgb(var(--warning-rgb) / 0.1); color: var(--warning); }
  .status-archived { background: rgb(var(--text-muted-rgb) / 0.1); color: var(--text-muted); }

  .project-header-stats { display: flex; gap: 1.5rem; }
  .stat-block { text-align: center; }
  .stat-block .stat-value { font-size: 1.5rem; font-weight: 700; color: var(--text-primary); }
  .stat-block .stat-label { font-size: 11px; color: var(--text-muted); text-transform: uppercase; letter-spacing: 0.05em; }
  .stat-complete { color: var(--success) !important; }

  .project-progress-full {
    height: 6px;
    background: var(--bg-hover);
    border-radius: 3px;
    overflow: hidden;
  }
  .project-progress-bar {
    height: 100%;
    background: var(--project-accent, var(--accent));
    border-radius: 3px;
    transition: width 300ms ease;
  }

  /* Fields placeholder */
  .fields-placeholder {
    text-align: center;
    padding: 3rem 2rem;
    background: var(--bg-card);
    border: 1px solid var(--border);
    border-radius: var(--radius-md);
  }
  .fields-placeholder-title {
    margin: 0 0 0.5rem;
    font-size: 1.125rem;
    font-weight: 600;
    color: var(--text-primary);
  }
  .fields-placeholder-desc {
    margin: 0 0 0.75rem;
    font-size: 0.875rem;
    color: var(--text-secondary);
    max-width: 480px;
    margin-inline: auto;
    line-height: 1.5;
  }

  /* Settings */
  .settings-card {
    background: var(--bg-card);
    border: 1px solid var(--border);
    border-radius: var(--radius-md);
    padding: 1.5rem;
    margin-bottom: 1.5rem;
  }
  .form-group { margin-bottom: 1rem; }
  .form-group label {
    display: block;
    font-size: 0.8125rem;
    font-weight: 500;
    color: var(--text-secondary);
    margin-bottom: 6px;
  }
  .form-group input[type="text"],
  .form-group textarea {
    width: 100%;
    padding: 0.5rem 0.75rem;
    font-size: 0.875rem;
    background: var(--bg-primary);
    border: 1px solid var(--border);
    border-radius: var(--radius-sm);
    color: var(--text-primary);
    outline: none;
    font-family: inherit;
    transition: border-color 150ms;
  }
  .form-group input:focus,
  .form-group textarea:focus {
    border-color: var(--accent);
    box-shadow: 0 0 0 2px rgb(var(--accent-rgb) / 0.15);
  }
  .form-select {
    width: 100%;
    padding: 0.5rem 0.75rem;
    font-size: 0.875rem;
    background: var(--bg-primary);
    border: 1px solid var(--border);
    border-radius: var(--radius-sm);
    color: var(--text-primary);
    outline: none;
    cursor: pointer;
    appearance: auto;
    transition: border-color 150ms;
  }
  .form-select:focus {
    border-color: var(--accent);
    box-shadow: 0 0 0 2px rgb(var(--accent-rgb) / 0.15);
  }
  .form-row { display: flex; gap: 1rem; }
  .form-group-sm { flex: 0 0 80px; }
  .icon-input { text-align: center; font-size: 1.25rem !important; padding: 0.25rem !important; }
  .color-input {
    width: 100%;
    height: 36px;
    border: 1px solid var(--border);
    border-radius: var(--radius-sm);
    cursor: pointer;
    padding: 2px;
    background: var(--bg-primary);
  }
  .settings-actions {
    margin-top: 1rem;
    display: flex;
    justify-content: flex-end;
  }
  .danger-zone {
    background: var(--bg-card);
    border: 1px solid var(--danger, #ef4444);
    border-radius: var(--radius-md);
    padding: 1.25rem 1.5rem;
  }
  .danger-title { margin: 0 0 0.5rem; font-size: 0.9375rem; font-weight: 600; color: var(--danger, #ef4444); }
  .danger-desc { margin: 0 0 1rem; font-size: 0.8125rem; color: var(--text-secondary); line-height: 1.5; }
  .btn-danger {
    background: var(--danger, #ef4444);
    color: white;
    border: none;
    padding: 0.5rem 1rem;
    border-radius: var(--radius-sm);
    font-weight: 500;
    cursor: pointer;
    font-size: 0.8125rem;
    transition: opacity 150ms;
  }
  .btn-danger:hover { opacity: 0.9; }

  @media (max-width: 640px) {
    .project-header-top { flex-direction: column; }
    .project-header-stats { justify-content: space-around; }
  }
</style>

<script define:vars={{ projectId, projectsPath, tasksPath }}>
  // --- Tab switching ---
  const projTabEls = Array.from(document.querySelectorAll('.project-tab[role="tab"]'));
  const projSectionEls = Array.from(document.querySelectorAll(".project-section"));

  function switchTab(hash) {
    const tabId = hash.replace("#", "") || "overview";
    if (tabId === "tasks") { location.replace(tasksPath); return }
    projTabEls.forEach((t) => {
      const isActive = t.dataset.tab === tabId;
      t.classList.toggle("active", isActive);
      t.setAttribute("aria-selected", isActive ? "true" : "false");
    });
    projSectionEls.forEach((s) => {
      s.classList.toggle("active", s.dataset.section === tabId);
    });
  }

  if (window.location.hash) switchTab(window.location.hash);
  window.addEventListener("hashchange", () => switchTab(window.location.hash));

  // --- Settings: Save ---
  const goalSelect = document.getElementById("edit-proj-goal")
  const areaSelect = document.getElementById("edit-proj-area")
  const initialGoal = goalSelect?.value
  const initialArea = areaSelect?.value
  const saveProjectBtn = document.getElementById("save-proj-btn");
  saveProjectBtn?.addEventListener("click", async () => {
    const titleInput = document.getElementById("edit-proj-title");
    const descInput = document.getElementById("edit-proj-desc");
    const iconInput = document.getElementById("edit-proj-icon");
    const colorInput = document.getElementById("edit-proj-color");
    const statusSelect = document.getElementById("edit-proj-status");

    const title = titleInput?.value?.trim();
    if (!title) {
      titleInput?.focus();
      return;
    }

    saveProjectBtn.textContent = "Saving…";
    saveProjectBtn.disabled = true;

    try {
      const res = await fetch(`/api/projects/${projectId}`, {
        method: "PUT",
        headers: { "content-type": "application/json" },
        body: JSON.stringify({
          title,
          description: descInput?.value?.trim() || null,
          icon: iconInput?.value?.trim() || "📋",
          color: colorInput?.value || "#146C4E",
          status: statusSelect?.value || "active",
          ...(goalSelect?.value !== initialGoal ? { goal_id: goalSelect?.value || null } : {}),
          ...(areaSelect?.value !== initialArea ? { area_id: areaSelect?.value || null } : {}),
        }),
      });

      if (res.ok) {
        window.location.reload();
      } else {
        const data = await res.json().catch(() => ({}));
        window.showToast?.(data.error || "Failed to save", "error");
        saveProjectBtn.textContent = "Save Changes";
        saveProjectBtn.disabled = false;
      }
    } catch {
      window.showToast?.("Could not save the Project. Your changes are still here. Try again.", "error")
      saveProjectBtn.textContent = "Save Changes";
      saveProjectBtn.disabled = false;
    }
  });

  // --- Settings: Delete ---
  const deleteProjectBtn = document.getElementById("delete-proj-btn");
  deleteProjectBtn?.addEventListener("click", async () => {
    const confirmed = await window.confirmDialog?.({ message: `Delete "${document.getElementById("edit-proj-title")?.value || "this project"}"? Tasks will become unassigned.` });
    if (!confirmed) return;

    deleteProjectBtn.disabled = true;
    deleteProjectBtn.textContent = "Deleting…";

    try {
      const res = await fetch(`/api/projects/${projectId}`, { method: "DELETE", headers: { "content-type": "application/json" } });
      if (res.ok) {
        window.location.href = projectsPath;
      } else {
        const data = await res.json().catch(() => ({}));
        window.showToast?.(data.error || "Failed to delete", "error");
        deleteProjectBtn.textContent = "Delete Project";
        deleteProjectBtn.disabled = false;
      }
    } catch {
      window.showToast?.("Could not delete the Project. Try again.", "error")
      deleteProjectBtn.textContent = "Delete Project";
      deleteProjectBtn.disabled = false;
    }
  });
</script>
