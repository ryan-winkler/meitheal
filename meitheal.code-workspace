    {
      "path": "meitheal-hub",
      "name": "🏠 HA Add-on"
    },
    {
      "path": "apps/web",
      "name": "🌐 Web App"
    },
    {
      "path": "apps/api",
      "name": "🔌 API"
    },
    {
      "path": "packages/domain-tasks",
      "name": "📋 Domain: Tasks"
    },
    {
      "path": "packages/domain-strategy",
      "name": "🎯 Domain: Strategy"
    },
    {
      "path": "packages/domain-auth",
      "name": "🔐 Domain: Auth"
    },
    {
      "path": "packages/domain-observability",
      "name": "📊 Domain: Observability"
    },
    {
      "path": "packages/integration-core",
      "name": "🔗 Integration Core"
    },
    {
      "path": "integrations/home-assistant",
      "name": "🏡 HA Integration"
    },
    {
      "path": "docs",
      "name": "📖 Docs"
    }
  ],
  "settings": {
    // Workspace-specific: hide noise in multi-root explorer
    "files.exclude": {
      "**/.git": true,
      "**/node_modules": true,
      "**/.astro": true,
      "**/.next": true,
    },
    // Workspace-specific: formatter overrides per language
    "editor.defaultFormatter": "esbenp.prettier-vscode",
    "[astro]": {
      "editor.defaultFormatter": "astro-build.astro-vscode",
    },
    "[typescript]": {
      "editor.defaultFormatter": "esbenp.prettier-vscode",
    },
    "typescript.disableAutomaticTypeAcquisition": false,
    // Extension: project-specific config
    "piny.project_settings": {
      "open-pages": ["pinyfakepage.html"],
    },
    "liveServer.settings.multiRootWorkspaceName": "📦 Meitheal Root",
    "files.autoSave": "onFocusChange",
    "notebook.formatOnSave.enabled": true,
    "git.promptToSaveFilesBeforeCommit": "never",
    "git.promptToSaveFilesBeforeStash": "staged",
    "editor.codeActions.triggerOnFocusChange": true,
    "workbench.editor.highlightModifiedTabs": true,
    "java.typeHierarchy.lazyLoad": false,
    "workbench.commandPalette.history": 100,
  },
  "extensions": {
    "recommendations": [
      "astro-build.astro-vscode",
      "esbenp.prettier-vscode",
      "dbaeumer.vscode-eslint",
      "bradlc.vscode-tailwindcss",
      "golang.go",
    ],
  },
}
