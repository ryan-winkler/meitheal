{
  "name": "Meitheal",
  "description": "Home Assistant-native, Astro-first task and life management engine with cooperative task orchestration.",
  "mcp_version": "1.0",
  "provider": {
    "name": "Coolock Village",
    "url": "https://github.com/Coolock-Village/meitheal"
  },
  "capabilities": ["tasks", "frameworks", "integrations", "observability", "calendar-sync", "calendar", "grocy", "habits"],
  "endpoints": {
    "api": "/api",
    "health": "/api/health",
    "tasks": "/api/tasks",
    "areas": "/api/areas",
    "review_weekly": "/api/review/weekly",
    "review_velocity": "/api/review/velocity",
    "grocy_stock": "/api/grocy/stock",
    "grocy_sync": "/api/grocy/sync",
    "a2a_agent_card": "/api/a2a/agent-card",
    "a2a_message": "/api/a2a/message",
    "export_json": "/api/export/tasks.json",
    "export_csv": "/api/export/tasks.csv"
  },
  "tools": [
    {
      "name": "createTask",
      "description": "Create a new task with title, description, priority, labels, and due date",
      "inputSchema": {
        "type": "object",
        "required": ["title"],
        "properties": {
          "title": { "type": "string", "description": "Task title" },
          "description": { "type": "string", "description": "Task description (HTML supported)" },
          "priority": { "type": "integer", "minimum": 1, "maximum": 5, "description": "Priority 1-5 (1=highest)" },
          "status": { "type": "string", "enum": ["todo", "in_progress", "done", "cancelled"] },
          "labels": { "type": "array", "items": { "type": "string" }, "description": "Label names" },
          "due_date": { "type": "string", "format": "date", "description": "Due date (YYYY-MM-DD)" }
        }
      }
    },
    {
      "name": "searchTasks",
      "description": "Search and filter tasks by status, priority, labels, or free text query",
      "inputSchema": {
        "type": "object",
        "properties": {
          "query": { "type": "string", "description": "Free text search" },
          "status": { "type": "string", "enum": ["todo", "in_progress", "done", "cancelled"] },
          "priority_gte": { "type": "integer", "minimum": 1, "maximum": 5 },
          "labels": { "type": "array", "items": { "type": "string" } }
        }
      }
    },
    {
      "name": "updateTaskStatus",
      "description": "Change the status of an existing task",
      "inputSchema": {
        "type": "object",
        "required": ["taskId", "status"],
        "properties": {
          "taskId": { "type": "integer", "description": "Task ID" },
          "status": { "type": "string", "enum": ["todo", "in_progress", "done", "cancelled"] }
        }
      }
    },
    {
      "name": "scoreTask",
      "description": "Apply a product management framework (RICE, DRICE, HEART, KCS, DDD) to score a task",
      "inputSchema": {
        "type": "object",
        "required": ["taskId", "framework"],
        "properties": {
          "taskId": { "type": "integer" },
          "framework": { "type": "string", "enum": ["rice", "drice", "heart", "kcs", "ddd", "custom"] }
        }
      }
    },
    {
      "name": "exportTasks",
      "description": "Export all tasks in JSON or CSV format",
      "inputSchema": {
        "type": "object",
        "properties": {
          "format": { "type": "string", "enum": ["json", "csv"], "default": "json" }
        }
      }
    },
    {
      "name": "checkGrocyStock",
      "description": "Check current Grocy stock levels. Optionally filter by product name or find items expiring soon.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "query": { "type": "string", "description": "Product name to search for (optional)" },
          "expiring_days": { "type": "integer", "minimum": 1, "maximum": 365, "description": "Show items expiring within N days" }
        }
      }
    },
    {
      "name": "getGrocyChores",
      "description": "Get current Grocy chores with due dates and overdue status. Returns chore names, last done time, next expected execution, and assigned user.",
      "inputSchema": {
        "type": "object",
        "properties": {}
      }
    },
    {
      "name": "getGrocyShoppingList",
      "description": "Get the Grocy shopping list with product names and quantities.",
      "inputSchema": {
        "type": "object",
        "properties": {}
      }
    },
    {
      "name": "getCalendarEvents",
      "description": "Get events from an HA calendar entity within a date range. Returns event list and supported features (create/update/delete).",
      "inputSchema": {
        "type": "object",
        "required": ["entity_id", "start", "end"],
        "properties": {
          "entity_id": { "type": "string", "description": "Calendar entity ID (e.g., calendar.home)" },
          "start": { "type": "string", "format": "date-time", "description": "Range start (ISO date/datetime)" },
          "end": { "type": "string", "format": "date-time", "description": "Range end (ISO date/datetime)" }
        }
      }
    },
    {
      "name": "createCalendarEvent",
      "description": "Create a new event on an HA calendar. Supports both timed and all-day events.",
      "inputSchema": {
        "type": "object",
        "required": ["entity_id", "summary", "start", "end"],
        "properties": {
          "entity_id": { "type": "string", "description": "Target calendar entity ID" },
          "summary": { "type": "string", "description": "Event title" },
          "start": { "type": "string", "description": "Start date (YYYY-MM-DD) or datetime (ISO)" },
          "end": { "type": "string", "description": "End date (YYYY-MM-DD) or datetime (ISO)" },
          "description": { "type": "string", "description": "Event description" },
          "location": { "type": "string", "description": "Event location" }
        }
      }
    },
    {
      "name": "syncCalendar",
      "description": "Trigger calendar sync for all configured entities or a specific entity.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "entity_id": { "type": "string", "description": "Specific entity to sync (optional, syncs all if omitted)" }
        }
      }
    },
    {
      "name": "updateTask",
      "description": "Update an existing task's fields (title, description, status, priority, labels, due_date, etc.)",
      "inputSchema": {
        "type": "object",
        "required": ["taskId"],
        "properties": {
          "taskId": { "type": "integer", "description": "Task ID to update" },
          "title": { "type": "string", "description": "New title" },
          "description": { "type": "string", "description": "New description (HTML supported)" },
          "status": { "type": "string", "enum": ["todo", "in_progress", "done", "cancelled", "backlog"] },
          "priority": { "type": "integer", "minimum": 1, "maximum": 5 },
          "labels": { "type": "array", "items": { "type": "string" } },
          "due_date": { "type": "string", "format": "date" },
          "assigned_to": { "type": "string", "description": "User ID to assign to" }
        }
      }
    },
    {
      "name": "deleteTask",
      "description": "Permanently delete a task by its ID",
      "inputSchema": {
        "type": "object",
        "required": ["taskId"],
        "properties": {
          "taskId": { "type": "integer", "description": "Task ID to delete" }
        }
      }
    },
    {
      "name": "getAreas",
      "description": "List all areas with their configurations and WIP limits",
      "inputSchema": {
        "type": "object",
        "properties": {}
      }
    },
    {
      "name": "getLabels",
      "description": "List all available labels with their colors and usage counts",
      "inputSchema": {
        "type": "object",
        "properties": {}
      }
    },
    {
      "name": "getTodaySummary",
      "description": "Get today's task summary - tasks due today, overdue tasks, recently completed, and daily stats",
      "inputSchema": {
        "type": "object",
        "properties": {
          "include_overdue": { "type": "boolean", "default": true, "description": "Include overdue tasks" },
          "include_completed": { "type": "boolean", "default": true, "description": "Include completed-today tasks" }
        }
      }
    },
    {
      "name": "getHabits",
      "description": "Get habit tracker data including streaks, completion rates, and today's habits",
      "inputSchema": {
        "type": "object",
        "properties": {
          "active_only": { "type": "boolean", "default": true, "description": "Only return active habits" }
        }
      }
    },
    {
      "name": "getHealth",
      "description": "Get system health status including DB, HA connection, and addon version",
      "inputSchema": {
        "type": "object",
        "properties": {}
      }
    },
    {
      "name": "getWeeklyReview",
      "description": "Get 7-day GTD review data: velocity, priority distribution, carried-forward, overdue",
      "inputSchema": {
        "type": "object",
        "properties": {}
      }
    },
    {
      "name": "getVelocity",
      "description": "Get task completion velocity over configurable window (1-90 days) with trend detection",
      "inputSchema": {
        "type": "object",
        "properties": {
          "days": { "type": "integer", "minimum": 1, "maximum": 90, "default": 14 }
        }
      }
    }
  ],
  "agent_protocols": {
    "a2a": {
      "version": "1.0",
      "agent_card": "/.well-known/agent-card.json",
      "endpoint": "/api/a2a"
    },
    "webmcp": {
      "status": "experimental",
      "description": "Browser-side tool registration via navigator.ai.createModelContextProvider"
    }
  }
}
